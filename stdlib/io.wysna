import "std/buffer"
from "std/buffer" use { DecodeErrorKind }

extern "C" fn wysna_host_stdin_read_line(output: opaque) -> int
extern "C" fn wysna_host_stdin_read_all(output: opaque) -> int
extern "C" fn wysna_host_stdout_flush() -> int

# std/io: standard streams plus the convenience file helpers that used to live here.

fn collect(data: buffer.Bytes) -> str ! IoError {
    let decoded = buffer.decode_utf8(data) else error {
        data.close()
        if error.kind == DecodeErrorKind.Unavailable { return Err(IoError { message: "stdin buffer became invalid" }) }
        return Err(IoError { message: "stdin is not valid UTF-8" })
    }
    data.close()
    return decoded
}

pub struct Line { text: str, eof: bool }

# Reads one line without its terminator; `eof` is true when stdin is exhausted.
pub fn read_line() -> Line ! IoError {
    let data = buffer.Bytes()
    let status = wysna_host_stdin_read_line(data.borrow())
    if status < 0 {
        data.close()
        return Err(IoError { message: "stdin read failed" })
    }
    if status == 0 {
        data.close()
        return Line { text: "", eof: true }
    }
    let line = collect(data)?
    return Line { text: line, eof: false }
}

# Reads the remainder of stdin.
pub fn read_all() -> str ! IoError {
    let data = buffer.Bytes()
    if wysna_host_stdin_read_all(data.borrow()) < 0 {
        data.close()
        return Err(IoError { message: "stdin read failed" })
    }
    return collect(data)
}

pub fn flush() -> unit ! IoError {
    if wysna_host_stdout_flush() != 0 {
        return Err(IoError { message: "stdout flush failed" })
    }
}

pub fn read_text(path: str) -> str ! IoError {
    return read_file(path)
}

pub fn write_text(path: str, content: str) -> unit ! IoError {
    return write_file(path, content)
}
