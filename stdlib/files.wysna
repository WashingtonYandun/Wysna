import "std/buffer"
extern "C" fn wysna_host_file_open(path: opaque, mode: int) -> opaque
extern "C" fn wysna_host_file_read(file: opaque, data: opaque, count: int) -> int
extern "C" fn wysna_host_file_write(file: opaque, data: opaque) -> int
extern "C" fn wysna_host_is_open(file: opaque) -> int
extern "C" fn wysna_host_close(handle: opaque) -> int
extern "C" fn wysna_host_last_error() -> int
extern "C" fn wysna_host_last_error_domain() -> int

pub struct FileError { operation: str, path: str, code: int, domain: int }

pub class File {
    priv handle: opaque
    priv path: str
    pub fn init(path: str, mode: int) {
        let encoded = buffer.from_text(path)
        this.handle = wysna_host_file_open(encoded.borrow(), mode)
        encoded.close()
        this.path = path
    }
    pub fn is_open() -> bool { return wysna_host_is_open(this.handle) == 1 }
    pub fn read(count: int) -> buffer.Bytes ! FileError {
        let data = buffer.Bytes()
        if wysna_host_file_read(this.handle, data.borrow(), count) < 0 {
            let code = wysna_host_last_error()
            let domain = wysna_host_last_error_domain()
            data.close()
            return Err(FileError { operation: "read", path: this.path, code: code, domain: domain })
        }
        return data
    }
    pub fn write(data: buffer.Bytes) -> unit ! FileError {
        if wysna_host_file_write(this.handle, data.borrow()) != 0 {
            return Err(FileError { operation: "write", path: this.path, code: wysna_host_last_error(), domain: wysna_host_last_error_domain() })
        }
    }
    pub fn close() -> int { return wysna_host_close(this.handle) }
}

# Modes: 0 read, 1 truncate/write, 2 append, 3 create exclusively (fail if present). EOF is an empty Bytes buffer.
pub fn open(path: str, mode: int) -> File ! FileError {
    let file = File(path, mode)
    if not file.is_open() { return Err(FileError { operation: "open", path: path, code: wysna_host_last_error(), domain: wysna_host_last_error_domain() }) }
    return file
}

pub fn create_exclusive(path: str) -> File ! FileError {
    return open(path, 3)
}

pub fn scope[T, E](file: File, body: fn(File) -> T ! E) -> tuple[T ! E, int] {
    let result: T ! E = body(file)
    let status = file.close()
    return (result, status)
}
