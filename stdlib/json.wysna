}

pub fn get_optional_bool(value: Value, key: str) -> bool? ! JsonError {
    let empty: bool? = None
    let item = get(value, key)
    match item {
        None => {
            return Ok(empty)
        },
        Some(inner) => {
            if is_null(inner) {
                return Ok(empty)
            }
            let parsed: bool? = Some(convert_field(inner, key, to_bool)?)
