extern "C" fn wysna_host_claim(handle: opaque) -> opaque
extern "C" fn wysna_host_claim_valid(token: opaque) -> int
extern "C" fn wysna_host_close(token: opaque) -> int

pub struct ResourceError { message: str }

pub fn error(message: str) -> ResourceError {
    return ResourceError { message: message }
}

pub class Resource {
    priv handle: opaque
    priv dispose: fn(opaque) -> int
    priv closed: bool
    priv claim: opaque

    pub fn init(handle: opaque, dispose: fn(opaque) -> int) {
        this.handle = handle
        this.dispose = dispose
        this.closed = false
        this.claim = wysna_host_claim(handle)
    }

    pub fn borrow() -> opaque ! ResourceError {
        if this.closed { return Err(ResourceError { message: "resource is closed" }) }
        if wysna_host_claim_valid(this.claim) == 0 { return Err(ResourceError { message: "resource already owned or released" }) }
        return this.handle
    }

    pub fn close() -> int {
        if this.closed { return 0 }
        if wysna_host_claim_valid(this.claim) == 0 { return -1 }
        let status = this.dispose(this.handle)
        if status == 0 { this.closed = true wysna_host_close(this.claim) }
        return status
    }
}

pub fn scope[T, E](resource: Resource, body: fn(Resource) -> T ! E) -> tuple[T ! E, int] {
    let result: T ! E = body(resource)
    let close_status = resource.close()
    return (result, close_status)
}

pub fn acquire(handle: opaque, dispose: fn(opaque) -> int) -> Resource ! ResourceError {
    let owner = Resource(handle, dispose)
    owner.borrow() else error { return Err(error) }
    return owner
}
