pub fn expect(condition: bool, message: str) -> unit {
    if not condition {
        eprint("assertion failed:", message)
        exit(1)
    }
}

pub fn expect_equal_int(actual: int, expected: int, message: str) -> unit {
    if actual != expected {
        eprint("assertion failed:", message, "expected", expected, "received", actual)
        exit(1)
    }
}

pub fn expect_equal_text(actual: str, expected: str, message: str) -> unit {
    if actual != expected {
        eprint("assertion failed:", message, "expected", expected, "received", actual)
        exit(1)
    }
}
