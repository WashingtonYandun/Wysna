import "std/bytes" as utf8

extern "C" fn wysna_host_buffer_new() -> opaque
extern "C" fn wysna_host_buffer_size(handle: opaque) -> int
extern "C" fn wysna_host_buffer_get(handle: opaque, index: int) -> int
extern "C" fn wysna_host_buffer_append(handle: opaque, value: int) -> int
extern "C" fn wysna_host_close(handle: opaque) -> int
extern "C" fn wysna_host_borrow(handle: opaque) -> opaque

pub struct BufferError { message: str }

# Compact mutable bytes have reference identity. Clone explicitly for a snapshot.
pub class Bytes {
    priv handle: opaque
    pub fn init() { this.handle = wysna_host_buffer_new() }
    pub fn size() -> int { return wysna_host_buffer_size(this.handle) }
    pub fn get(index: int) -> int ! BufferError {
        let value = wysna_host_buffer_get(this.handle, index)
        if value < 0 { return Err(BufferError { message: "closed buffer or invalid index" }) }
        return value
    }
    pub fn append(value: int) -> unit ! BufferError {
        if wysna_host_buffer_append(this.handle, value) != 0 {
            return Err(BufferError { message: "closed buffer or byte outside 0..255" })
        }
    }
    pub fn close() -> int { return wysna_host_close(this.handle) }
    # Internal interoperability boundary; retaining the ID does not extend its lifetime.
    pub fn borrow() -> opaque { return wysna_host_borrow(this.handle) }
}

pub fn from_text(text: str) -> Bytes {
    let result = Bytes()
    for codepoint in 0..len(text) {
        for byte in bytes(text[codepoint]) {
            result.append(byte) else error { exit(1) }
        }
    }
    return result
}

pub fn clone(source: Bytes) -> Bytes ! BufferError {
    if source.size() < 0 { return Err(BufferError { message: "closed buffer" }) }
    let result = Bytes()
    for index in 0..source.size() {
        let value = source.get(index) else error { result.close() return Err(error) }
        result.append(value) else error { result.close() return Err(error) }
    }
    return result
}

pub enum DecodeErrorKind { Unavailable, InvalidUtf8 }
# InvalidUtf8 carries the failing byte offset. Unavailable has no offset (-1).
pub struct DecodeError { kind: DecodeErrorKind, offset: int }

# Decoding borrows the buffer. The caller retains ownership on success and failure.
pub fn decode_utf8(source: Bytes) -> str ! DecodeError {
    let size = source.size()
    if size < 0 { return Err(DecodeError { kind: DecodeErrorKind.Unavailable, offset: -1 }) }
    let mut octets: list[int] = []
    for index in 0..size {
        let value = source.get(index) else {
            return Err(DecodeError { kind: DecodeErrorKind.Unavailable, offset: -1 })
        }
        octets.append(value)
    }
    return utf8.decode(octets) else error {
        return Err(DecodeError { kind: DecodeErrorKind.InvalidUtf8, offset: error.offset })
    }
}
