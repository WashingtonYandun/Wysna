pub fn map[T, R](values: list[T], transform: fn(T) -> R) -> list[R] {
    let mut result: list[R] = []
    for value in values {
        result.append(transform(value))
    }
    return result
}

pub fn fold[T, R](values: list[T], initial: R, combine: fn(R, T) -> R) -> R {
    let mut result = initial
    for value in values {
        result = combine(result, value)
    }
    return result
}

pub fn sort[T](values: list[T], before: fn(T, T) -> bool) -> list[T] {
    let count = len(values)
    if count < 2 {
        return values
    }
    let mut src = slice(values, 0, count)
    let run_size = 16
    let mut start = 0
    while start < count {
        let mut end = start + run_size
        if end > count { end = count }
        let mut i = start + 1
        while i < end {
            let key = src[i]
            let mut j = i
            while j > start and before(key, src[j - 1]) {
                src[j] = src[j - 1]
                j = j - 1
            }
            src[j] = key
            i = i + 1
        }
        start = start + run_size
    }
    if count <= run_size {
        return src
    }
    let mut dst = slice(values, 0, count)
    let mut width = run_size
    while true {
        let mut left = 0
        while left < count {
            let mut mid = left + width
            if mid > count { mid = count }
            let mut right = left + width * 2
            if right > count { right = count }
            let mut i = left
            let mut j = mid
            let mut k = left
            while i < mid and j < right {
                if before(src[j], src[i]) {
                    dst[k] = src[j]
                    j = j + 1
                } else {
                    dst[k] = src[i]
                    i = i + 1
                }
                k = k + 1
            }
            while i < mid {
                dst[k] = src[i]
                i = i + 1
                k = k + 1
            }
            while j < right {
                dst[k] = src[j]
                j = j + 1
                k = k + 1
            }
            left = left + width * 2
        }
        let next_width = width * 2
        if next_width >= count {
            return dst
        }
        left = 0
        while left < count {
            let mut mid = left + next_width
            if mid > count { mid = count }
            let mut right = left + next_width * 2
            if right > count { right = count }
            let mut i = left
            let mut j = mid
            let mut k = left
            while i < mid and j < right {
                if before(dst[j], dst[i]) {
                    src[k] = dst[j]
                    j = j + 1
                } else {
                    src[k] = dst[i]
                    i = i + 1
                }
                k = k + 1
            }
            while i < mid {
                src[k] = dst[i]
                i = i + 1
                k = k + 1
            }
            while j < right {
                src[k] = dst[j]
                j = j + 1
                k = k + 1
            }
            left = left + next_width * 2
        }
        width = next_width * 2
        if width >= count {
            return src
        }
    }
    return src
}

pub fn filter[T](values: list[T], predicate: fn(T) -> bool) -> list[T] {
    let mut result: list[T] = []
    for value in values {
        if predicate(value) {
            result.append(value)
        }
    }
    return result
}

pub fn reverse[T](values: list[T]) -> list[T] {
    let mut result: list[T] = []
    let n = len(values)
    let mut i = n - 1
    while i >= 0 {
        result.append(values[i])
        i = i - 1
    }
    return result
}

pub fn any[T](values: list[T], predicate: fn(T) -> bool) -> bool {
    for value in values {
        if predicate(value) {
            return true
        }
    }
    return false
}

pub fn all[T](values: list[T], predicate: fn(T) -> bool) -> bool {
    for value in values {
        if not predicate(value) {
            return false
        }
    }
    return true
}

pub fn find_first[T](values: list[T], predicate: fn(T) -> bool) -> T? {
    for value in values {
        if predicate(value) {
            return value
        }
    }
    return None
}

pub fn contains[T](values: list[T], target: T) -> bool {
    for value in values {
        if value == target {
            return true
        }
    }
    return false
}

pub fn parallel_map[T, R](values: list[T], transform: fn(T) -> R) -> list[R] {
    let mut result: list[R] = []
    for index in 0..len(values) {
        let item_snapshot = values[index]
        result.append(transform(item_snapshot))
    }
    return result
}

pub fn filter_map[T, R](values: list[T], transform: fn(T) -> R?) -> list[R] {
    let mut result: list[R] = []
    for value in values {
        let mapped = transform(value)
        match mapped {
            Some(item) => result.append(item),
            None => {},
        }
    }
    return result
}

pub fn partition[T](values: list[T], predicate: fn(T) -> bool) -> tuple[list[T], list[T]] {
    let mut matching: list[T] = []
    let mut rejected: list[T] = []
    for value in values {
        if predicate(value) {
            matching.append(value)
        } else {
            rejected.append(value)
        }
    }
    return (matching, rejected)
}

pub fn flat_map[T, R](values: list[T], transform: fn(T) -> list[R]) -> list[R] {
    let mut result: list[R] = []
    for value in values {
        let group = transform(value)
        for item in group {
            result.append(item)
        }
    }
    return result
}

pub fn parallel_batch[T, R](values: list[T], batch_size: int, transform: fn(T) -> R) -> list[R] {
    let step = if batch_size > 0 { batch_size } else { 1 }
    let total = len(values)
    let mut result: list[R] = []
    let mut offset = 0
    while offset < total {
        let limit = if offset + step < total { offset + step } else { total }
        for index in offset..limit {
            let item_snapshot = values[index]
            result.append(transform(item_snapshot))
        }
        offset = limit
    }
    return result
}

pub fn parallel_filter[T](values: list[T], predicate: fn(T) -> bool) -> list[T] {
    let mut result: list[T] = []
    for index in 0..len(values) {
        let item_snapshot = values[index]
        if predicate(item_snapshot) {
            result.append(item_snapshot)
        }
    }
    return result
}

pub fn parallel_reduce[T, R](values: list[T], initial: R, mapper: fn(T) -> R, combiner: fn(R, R) -> R) -> R {
    let mapped = parallel_map[T, R](values, mapper)
    let mut acc = initial
    for item in mapped {
        acc = combiner(acc, item)
    }
    return acc
}
