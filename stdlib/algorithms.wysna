pub fn map[T, R](values: list[T], transform: fn(T) -> R) -> list[R] {
    let mut result: list[R] = []
    for value in values {
        result.append(transform(value))
    }
    return result
}

pub fn fold[T, R](values: list[T], initial: R, combine: fn(R, T) -> R) -> R {
    let mut result = initial
    for value in values {
        result = combine(result, value)
    }
    return result
}

pub fn sort[T](values: list[T], before: fn(T, T) -> bool) -> list[T] {
    let count = len(values)
    if count < 2 {
        return values
    }
    return sort_range[T](values, before, 0, count)
}

fn sort_range[T](values: list[T], before: fn(T, T) -> bool, first: int, end: int) -> list[T] {
    let count = end - first
    if count == 1 {
        return [values[first]]
    }
    if count == 2 {
        let left = values[first]
        let right = values[first + 1]
        return if before(right, left) { [right, left] } else { [left, right] }
    }
    let middle = first + count / 2
    let left = sort_range[T](values, before, first, middle)
    let right = sort_range[T](values, before, middle, end)
    let left_count = len(left)
    let right_count = len(right)
    let mut result: list[T] = []
    let mut i = 0
    let mut j = 0
    while i < left_count and j < right_count {
        if before(right[j], left[i]) {
            result.append(right[j])
            j = j + 1
        } else {
            result.append(left[i])
            i = i + 1
        }
    }
    while i < left_count {
        result.append(left[i])
        i = i + 1
    }
    while j < right_count {
        result.append(right[j])
        j = j + 1
    }
    return result
}

pub fn filter[T](values: list[T], predicate: fn(T) -> bool) -> list[T] {
    let mut result: list[T] = []
    for value in values {
        if predicate(value) {
            result.append(value)
        }
    }
    return result
}

pub fn reverse[T](values: list[T]) -> list[T] {
    let mut result: list[T] = []
    let n = len(values)
    let mut i = n - 1
    while i >= 0 {
        result.append(values[i])
        i = i - 1
    }
    return result
}

pub fn any[T](values: list[T], predicate: fn(T) -> bool) -> bool {
    for value in values {
        if predicate(value) {
            return true
        }
    }
    return false
}

pub fn all[T](values: list[T], predicate: fn(T) -> bool) -> bool {
    for value in values {
        if not predicate(value) {
            return false
        }
    }
    return true
}

pub fn find_first[T](values: list[T], predicate: fn(T) -> bool) -> T? {
    for value in values {
        if predicate(value) {
            return value
        }
    }
    return None
}

pub fn contains[T](values: list[T], target: T) -> bool {
    for value in values {
        if value == target {
            return true
        }
    }
    return false
}

pub fn parallel_map[T, R](values: list[T], transform: fn(T) -> R) -> list[R] {
    let mut result: list[R] = []
    for index in 0..len(values) {
        let item_snapshot = values[index]
        result.append(transform(item_snapshot))
    }
    return result
}

pub fn filter_map[T, R](values: list[T], transform: fn(T) -> R?) -> list[R] {
    let mut result: list[R] = []
    for value in values {
        let mapped = transform(value)
        match mapped {
            Some(item) => result.append(item),
            None => {},
        }
    }
    return result
}

pub fn partition[T](values: list[T], predicate: fn(T) -> bool) -> tuple[list[T], list[T]] {
    let mut matching: list[T] = []
    let mut rejected: list[T] = []
    for value in values {
        if predicate(value) {
            matching.append(value)
        } else {
            rejected.append(value)
        }
    }
    return (matching, rejected)
}

pub fn flat_map[T, R](values: list[T], transform: fn(T) -> list[R]) -> list[R] {
    let mut result: list[R] = []
    for value in values {
        let group = transform(value)
        for item in group {
            result.append(item)
        }
    }
    return result
}

pub fn parallel_batch[T, R](values: list[T], batch_size: int, transform: fn(T) -> R) -> list[R] {
    let step = if batch_size > 0 { batch_size } else { 1 }
    let total = len(values)
    let mut result: list[R] = []
    let mut offset = 0
    while offset < total {
        let limit = if offset + step < total { offset + step } else { total }
        for index in offset..limit {
            let item_snapshot = values[index]
            result.append(transform(item_snapshot))
        }
        offset = limit
    }
    return result
}

pub fn parallel_filter[T](values: list[T], predicate: fn(T) -> bool) -> list[T] {
    let mut result: list[T] = []
    for index in 0..len(values) {
        let item_snapshot = values[index]
        if predicate(item_snapshot) {
            result.append(item_snapshot)
        }
    }
    return result
}

pub fn parallel_reduce[T, R](values: list[T], initial: R, mapper: fn(T) -> R, combiner: fn(R, R) -> R) -> R {
    let mapped = parallel_map[T, R](values, mapper)
    let mut acc = initial
    for item in mapped {
        acc = combiner(acc, item)
    }
    return acc
}
