class Node {
    pub next: Node?
    fn init() { this.next = None }
}
fn exercise() -> unit {
    let node = Node()
    node.next = node
    print(node)
    print(str(node))
    print([node], (node, node))
    node.next = None
    print([node, node])
    let other = Node()
    node.next = other
    other.next = node
    print(node)
    node.next = None
    other.next = None
}
exercise()
