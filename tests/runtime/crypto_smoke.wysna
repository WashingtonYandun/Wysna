import "std/crypto"

fn main() {
    # 1. NIST Test Vector: SHA-256("abc")
    let h1 = crypto.sha256("abc") else err {
        eprint("crypto.sha256 failed:", err.message)
        exit(1)
        ""
    }
    if h1 != "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad" {
        eprint("SHA-256 vector 1 failed, got:", h1)
        exit(1)
    }

    # 2. NIST Test Vector: SHA-256("")
    let h2 = crypto.sha256("") else err {
        eprint("crypto.sha256 empty failed:", err.message)
        exit(1)
        ""
    }
    if h2 != "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855" {
        eprint("SHA-256 vector 2 failed, got:", h2)
        exit(1)
    }

    # 3. HMAC-SHA256 Test Vector
    let hmac1 = crypto.hmac_sha256("key", "The quick brown fox jumps over the lazy dog") else err {
        eprint("crypto.hmac_sha256 failed:", err.message)
        exit(1)
        ""
    }
    if hmac1 != "f7bc83f430538424b13298e6aa6fb143ef4d59a14946175997479dbc2d1a3cd8" {
        eprint("HMAC-SHA256 vector failed, got:", hmac1)
        exit(1)
    }

    # 4. NIST Test Vector: SHA-512("abc")
    let s512_1 = crypto.sha512("abc") else err {
        eprint("crypto.sha512 failed:", err.message)
        exit(1)
        ""
    }
    if s512_1 != "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f" {
        eprint("SHA-512 vector 1 failed, got:", s512_1)
        exit(1)
    }

    # 5. NIST Test Vector: SHA-512("")
    let s512_2 = crypto.sha512("") else err {
        eprint("crypto.sha512 empty failed:", err.message)
        exit(1)
        ""
    }
    if s512_2 != "cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e" {
        eprint("SHA-512 vector 2 failed, got:", s512_2)
        exit(1)
    }

    # 6. HMAC-SHA512 Test Vector
    let hmac512 = crypto.hmac_sha512("key", "The quick brown fox jumps over the lazy dog") else err {
        eprint("crypto.hmac_sha512 failed:", err.message)
        exit(1)
        ""
    }
    if hmac512 != "b42af09057bac1e2d41708e48a902e09b5ff7f12ab428a4fe86653c73dd248fb82f948a549f7b791a5b41915ee4d1ec3935357e4e2317250d0372afa2ebeeb3a" {
        eprint("HMAC-SHA512 vector failed, got:", hmac512)
        exit(1)
    }

    # 7. RFC 1321 Test Vectors: MD5
    let m1 = crypto.md5("abc") else err {
        eprint("crypto.md5 failed:", err.message)
        exit(1)
        ""
    }
    if m1 != "900150983cd24fb0d6963f7d28e17f72" {
        eprint("MD5 vector 1 failed, got:", m1)
        exit(1)
    }
    let m2 = crypto.md5("") else err {
        eprint("crypto.md5 empty failed:", err.message)
        exit(1)
        ""
    }
    if m2 != "d41d8cd98f00b204e9800998ecf8427e" {
        eprint("MD5 vector 2 failed, got:", m2)
        exit(1)
    }

    # 8. CSPRNG random_hex
    let r1 = crypto.random_hex(16) else err {
        eprint("crypto.random_hex failed:", err.message)
        exit(1)
        ""
    }
    let r2 = crypto.random_hex(16) else err {
        eprint("crypto.random_hex failed:", err.message)
        exit(1)
        ""
    }
    if len(r1) != 32 or len(r2) != 32 {
        eprint("random_hex length mismatch, got:", len(r1), len(r2))
        exit(1)
    }
    if r1 == r2 {
        eprint("CSPRNG produced identical 128-bit blocks:", r1)
        exit(1)
    }

    # 9. Constant-time comparison
    if not crypto.constant_time_eq("super_secret_auth_token", "super_secret_auth_token") {
        eprint("constant_time_eq failed for identical tokens")
        exit(1)
    }
    if crypto.constant_time_eq("super_secret_auth_token", "wrong_token_guess") {
        eprint("constant_time_eq returned true for different tokens")
        exit(1)
    }

    print("CRYPTO_OK")
}
