let mut shared = "old"

fn replace_shared() -> int {
    shared = "new"
    7
}

fn preserve(text: str) -> str {
    print(len(text), replace_shared(), text[0])
    return text
}

fn remember(text: str) -> list[str] { [text, text] }
fn capture(text: str) -> fn() -> str { || => text }
fn success(text: str) -> str ! str { Ok(text) }
fn failure(text: str) -> int ! str { Err(text) }

let retained = preserve(shared + "-é")
print(retained, shared)
shared = "before"
print(shared, replace_shared())
let values = remember("saved-" + str(3))
print(values[0], values[1])
let callback = capture("captured-" + str(4))
print(callback())
print(success("result-" + str(5)) else error { error })
print(failure("error-" + str(6)) else error { len(error) })

struct Snapshot { items: list[str] }

fn snapshot(source: Snapshot) -> list[str] { source.items }

fn escaping_field() -> list[str] {
    let source = Snapshot { items: ["local-" + str(7)] }
    return source.items
}

class Store {
    priv items: list[str]
    fn init(items: list[str]) { this.items = items }
    pub fn view() -> list[str] { this.items }
    pub fn replace() { this.items = ["changed"] }
}

let mut source = Snapshot { items: ["record-" + str(8)] }
let retained_items = snapshot(source)
source.items[0] = "updated"
print(escaping_field()[0], retained_items[0], source.items[0])
let store = Store(["object-" + str(9)])
let retained_view = store.view()
store.replace()
print(retained_view[0], store.view()[0])
