class AndInit {
    pub ready: bool

    fn init() {
        true and (this.ready = true)
    }
}

class OrInit {
    pub ready: bool

    fn init() {
        false or (this.ready = true)
    }
}

class BranchInit {
    pub ready: bool

    fn init(flag: bool) {
        if flag {
            this.ready = true
        } else {
            this.ready = false
        }
    }
}

print(AndInit().ready, OrInit().ready, BranchInit(true).ready, BranchInit(false).ready)
