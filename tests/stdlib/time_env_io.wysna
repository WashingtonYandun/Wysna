import "std/time" as time
import "std/environment" as environment
import "std/io" as io

let epoch = time.from_unix_ms(0)
print(time.format_iso8601(epoch))
let leap = time.from_unix_ms(951782400000)
print(time.format_iso8601(leap))
let before = time.from_unix_ms(-1)
print(time.format_iso8601(before))
let modern = time.from_unix_ms(1700000000123)
print(time.format_iso8601(modern))

let parsed = time.parse_iso8601("2023-11-14T22:13:20.123Z") else err { epoch }
print(time.to_unix_ms(parsed) else err { -1 })
let short = time.parse_iso8601("2024-02-29T00:00:00.5Z") else err { epoch }
print(short.millisecond, short.day)
let bad = time.parse_iso8601("2023-02-29T00:00:00Z") else err { epoch }
print(bad.year)
print(time.is_leap_year(1900), time.is_leap_year(2000), time.is_leap_year(2024))
print(time.days_from_civil(1970, 1, 1), time.days_from_civil(2000, 3, 1))
print(time.weekday_from_days(0), time.weekday_from_days(-1))

let start = time.monotonic_ms()
time.sleep(5) else err { print("sleep failed") }
print(time.elapsed_ms(start) >= 4)
print(time.now_ms() > 1700000000000)
time.sleep(-1) else err { print(err.message) }

print(environment.get_or("WYSNA_DEFINITELY_UNSET_VARIABLE", "fallback"))
print(environment.has("WYSNA_DEFINITELY_UNSET_VARIABLE"))
let cwd = environment.current_directory() else err { "" }
print(len(cwd) > 0)
io.flush() else err { print("flush failed") }
