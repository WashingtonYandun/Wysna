class Base {
    priv secret: int

    fn init(s: int) {
        this.secret = s
    }

    priv fn pin() -> int {
        return this.secret
    }
}

class Derived extends Base {
    fn init(s: int) {
        super.init(s)
    }

    pub fn leak_field() -> int {
        return this.secret
    }
}

fn main() {
    let d = Derived(42)
}
