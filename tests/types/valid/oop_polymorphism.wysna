interface Speakable {
    fn speak() -> str
}

class Animal implements Speakable {
    pub name: str

    fn init(name: str) {
        this.name = name
    }

    pub fn speak() -> str {
        return "..."
    }
}

class Dog extends Animal {
    priv breed: str

    fn init(name: str, breed: str) {
        super.init(name)
        this.breed = breed
    }

    pub fn speak() -> str {
        return this.name + " (" + this.breed + ") says Woof"
    }
}

class Cat extends Animal {
    fn init(name: str) {
        super.init(name)
    }

    pub fn speak() -> str {
        return this.name + " says Meow"
    }
}

fn announce(s: Speakable) -> str {
    return s.speak()
}

fn main() {
    let d: Animal = Dog("Rex", "Husky")
    let c: Speakable = Cat("Luna")
    let pets: list[Animal] = [Dog("Max", "Pug"), Cat("Milo")]
    for p in pets {
        print(announce(p))
    }
    print(d.speak())
    print(c.speak())
}
