interface Describable {
    fn describe() -> str
}

class Animal {
    pub name: str
    priv energy: int

    fn init(name: str, energy: int) {
        this.name = name
        this.energy = energy
    }

    pub fn speak() -> str {
        return this.name
    }
}

class Dog extends Animal implements Describable {
    pub breed: str

    fn init(name: str, breed: str) {
        super.init(name, 100)
        this.breed = breed
    }

    pub fn describe() -> str {
        return this.speak() + ":" + this.breed
    }
}

let d = Dog("Rex", "Husky")
