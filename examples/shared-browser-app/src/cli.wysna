import "std/environment" as environment
import "std/parse" as parse
import "pricing.wysna" as pricing

fn main() -> unit {
    let arguments = environment.arguments()
    if len(arguments) != 3 {
        eprint("usage: quote <quantity> <unit-price-cents>")
        exit(2)
        return
    }

    let quantity = parse.parse_int(arguments[1]) else error {
        eprint("quantity must be an integer")
        exit(2)
        return
    }
    let unit_price_cents = parse.parse_int(arguments[2]) else error {
        eprint("unit price must be an integer number of cents")
        exit(2)
        return
    }
    if quantity < 1 or quantity > 1000 {
        eprint("quantity must be between 1 and 1000")
        exit(2)
        return
    }
    if unit_price_cents < 0 or unit_price_cents > 100000000 {
        eprint("unit price must be between 0 and 100000000 cents")
        exit(2)
        return
    }

    print(pricing.calculate_total_cents(quantity, unit_price_cents))
}

main()
