{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wysna.dev/schemas/wysna-tool-result.v1.schema.json",
  "title": "Wysna Agent Tool Result Protocol v1",
  "type": "object",
  "required": [
    "schema_version",
    "command",
    "status",
    "invocation_id",
    "tool_exit_code",
    "process_exit_code",
    "toolchain",
    "target",
    "diagnostics",
    "artifacts"
  ],
  "properties": {
    "schema_version": { "const": "wysna.tool-result/1" },
    "command": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["ok", "diagnostic_error", "usage_error", "toolchain_error", "runtime_error", "failed"]
    },
    "invocation_id": { "type": "string", "minLength": 1 },
    "tool_exit_code": { "type": "integer", "minimum": 0 },
    "process_exit_code": { "type": ["integer", "null"] },
    "execution": { "type": ["object", "null"] },
    "toolchain": {
      "type": "object",
      "required": ["compiler"],
      "properties": {
        "compiler": { "type": "string", "minLength": 1 }
      }
    },
    "target": {
      "type": "object",
      "required": ["profile"],
      "properties": {
        "profile": { "type": "string" },
        "triple": { "type": ["string", "null"] }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "#/$defs/Diagnostic" }
    },
    "artifacts": {
      "type": "array",
      "items": { "type": "object" }
    },
    "telemetry": { "type": ["object", "null"] },
    "result": {
      "properties": {
        "architecture": { "$ref": "#/$defs/ArchitectureReport" }
      },
      "anyOf": [
        { "$ref": "#/$defs/GraphResult" },
        { "$ref": "#/$defs/InspectResult" },
        { "$ref": "#/$defs/SinglePatchResult" },
        { "$ref": "#/$defs/WorkspacePatchResult" },
        { "type": "object" }
      ]
    }
  },
  "$defs": {
    "SourceSpan": {
      "type": "object",
      "required": ["source_id", "source_sha256", "start_byte", "end_byte"],
      "properties": {
        "source_id": { "type": "string", "minLength": 1 },
        "source_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "start_byte": { "type": "integer", "minimum": 0 },
        "end_byte": { "type": "integer", "minimum": 0 }
      }
    },
    "RelatedLocation": {
      "type": "object",
      "required": ["message", "line", "col", "span"],
      "properties": {
        "message": { "type": "string" },
        "line": { "type": ["integer", "null"] },
        "col": { "type": ["integer", "null"] },
        "span": { "oneOf": [{ "$ref": "#/$defs/SourceSpan" }, { "type": "null" }] }
      }
    },
    "ByteEdit": {
      "type": "object",
      "required": ["source_id", "source_sha256", "start_byte", "end_byte", "replacement"],
      "properties": {
        "source_id": { "type": "string" },
        "source_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "start_byte": { "type": "integer", "minimum": 0 },
        "end_byte": { "type": "integer", "minimum": 0 },
        "replacement": { "type": "string" }
      }
    },
    "Fix": {
      "type": "object",
      "required": ["description", "applicability", "edits"],
      "properties": {
        "description": { "type": "string" },
        "applicability": { "type": "string", "enum": ["machine", "maybe", "manual"] },
        "edits": {
          "type": "array",
          "items": { "$ref": "#/$defs/ByteEdit" }
        }
      }
    },
    "TypeMismatchData": {
      "type": "object",
      "required": ["kind", "expected", "found"],
      "properties": {
        "kind": { "const": "type_mismatch" },
        "context": { "type": "string" },
        "expected": { "type": "string", "minLength": 1 },
        "found": { "type": "string", "minLength": 1 },
        "argument_index": { "type": "integer", "minimum": 1 },
        "parameter_name": { "type": "string", "minLength": 1 },
        "callee": { "type": "string", "minLength": 1 },
        "conversion_hint": { "type": "string" },
        "unwrap_hint": { "type": "string" },
        "help": { "type": "string" }
      }
    },
    "ArityMismatchData": {
      "type": "object",
      "required": ["kind", "expected_arity", "found_arity"],
      "properties": {
        "kind": { "const": "arity_mismatch" },
        "expected_arity": { "type": "integer", "minimum": 0 },
        "found_arity": { "type": "integer", "minimum": 0 },
        "callee": { "type": "string", "minLength": 1 }
      }
    },
    "NotCallableData": {
      "type": "object",
      "required": ["kind", "found"],
      "properties": {
        "kind": { "const": "not_callable" },
        "found": { "type": "string", "minLength": 1 }
      }
    },
    "InvalidAssignmentTargetData": {
      "type": "object",
      "required": ["kind", "target_kind", "help"],
      "properties": {
        "kind": { "const": "invalid_assignment_target" },
        "target_kind": { "type": "string", "minLength": 1 },
        "help": { "type": "string", "minLength": 1 }
      }
    },
    "NonExhaustiveMatchData": {
      "type": "object",
      "required": ["kind", "subject_type", "open_domain", "uncovered_pattern_families", "missing_variants"],
      "properties": {
        "kind": { "const": "non_exhaustive_match" },
        "subject_type": { "type": "string", "minLength": 1 },
        "open_domain": { "type": "boolean" },
        "uncovered_pattern_families": { "type": "array", "items": { "type": "string" } },
        "missing_variants": { "type": "array", "items": { "type": "string" } }
      }
    },
    "ReturnMismatchData": {
      "type": "object",
      "required": ["kind", "expected", "found", "function"],
      "properties": {
        "kind": { "enum": ["return_type_mismatch", "incompatible_error_channel"] },
        "expected": { "type": "string", "minLength": 1 },
        "found": { "type": "string", "minLength": 1 },
        "function": { "type": "string", "minLength": 1 }
      }
    },
    "MissingReturnData": {
      "type": "object",
      "required": ["kind", "expected", "function"],
      "properties": {
        "kind": { "const": "missing_return" },
        "expected": { "type": "string", "minLength": 1 },
        "function": { "type": "string", "minLength": 1 }
      }
    },
    "ImmutableMutationData": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["immutable_mutation", "captured_snapshot_mutation"] },
        "binding": { "type": "string" },
        "symbol": { "type": "string" },
        "binding_kind": { "type": "string" },
        "declared_line": { "type": ["integer", "null"] },
        "declared_col": { "type": ["integer", "null"] },
        "help": { "type": "string" }
      }
    },
    "DuplicateDeclarationData": {
      "type": "object",
      "required": ["kind", "name"],
      "properties": {
        "kind": { "enum": ["duplicate_declaration", "reserved_namespace"] },
        "name": { "type": "string", "minLength": 1 },
        "symbol": { "type": "string" },
        "symbol_kind": { "type": "string" },
        "previous_line": { "type": "integer" },
        "previous_col": { "type": "integer" }
      }
    },
    "AmbiguousSymbolData": {
      "type": "object",
      "required": ["kind", "symbol", "graph_hash", "candidates"],
      "properties": {
        "kind": { "const": "ambiguous_symbol" },
        "symbol": { "type": "string" },
        "graph_hash": { "type": "string", "pattern": "^graph:[0-9a-f]{16}$" },
        "candidates": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["id", "qualified_name", "kind", "file", "line", "col", "signature"],
            "properties": {
              "id": { "type": "string" },
              "qualified_name": { "type": "string" },
              "kind": { "type": "string" },
              "file": { "type": "string" },
              "line": { "type": "integer" },
              "col": { "type": "integer" },
              "signature": { "type": "string" }
            }
          }
        }
      }
    },
    "ArchitectureDiagnosticData": {
      "type": "object",
      "required": ["kind", "status", "rule_id", "relation", "from_symbol", "from_role",
                   "to_symbol", "to_role", "boundary", "graph_hash", "revision"],
      "properties": {
        "kind": { "enum": ["architecture_violation", "architecture_incomplete"] },
        "status": { "enum": ["violation", "incomplete"] },
        "rule_id": { "type": "string", "minLength": 1 },
        "relation": { "enum": ["calls", "uses_type"] },
        "from_symbol": { "type": "string", "minLength": 1 },
        "from_role": { "type": "string", "minLength": 1 },
        "to_symbol": { "type": ["string", "null"] },
        "to_role": { "type": ["string", "null"] },
        "boundary": { "enum": [null, "missing_role_schema", "unknown_role", "unclassified_target",
                                "indirect_call", "virtual_dispatch", "unresolved_call"] },
        "graph_hash": { "type": "string", "pattern": "^graph:[0-9a-f]{16}$" },
        "revision": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "ArchitectureReport": {
      "type": "object",
      "required": ["schema_version", "graph_hash", "revision", "status", "rules"],
      "properties": {
        "schema_version": { "const": "wysna.architecture/1" },
        "graph_hash": { "type": "string", "pattern": "^graph:[0-9a-f]{16}$" },
        "revision": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "status": { "enum": ["verified", "violation", "incomplete"] },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "status"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "status": { "enum": ["verified", "violation", "incomplete"] }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "Diagnostic": {
      "type": "object",
      "if": { "properties": { "code": { "enum": ["W6101", "W6102"] } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/ArchitectureDiagnosticData" } } },
      "required": ["code", "severity", "stage", "message", "primary_span", "related", "data", "fixes"],
      "properties": {
        "code": { "type": "string", "pattern": "^W[0-9]{4}$" },
        "severity": { "type": "string", "enum": ["error", "warning"] },
        "stage": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "primary_span": { "oneOf": [{ "$ref": "#/$defs/SourceSpan" }, { "type": "null" }] },
        "related": {
          "type": "array",
          "items": { "$ref": "#/$defs/RelatedLocation" }
        },
        "data": { "type": "object" },
        "fixes": {
          "type": "array",
          "items": { "$ref": "#/$defs/Fix" }
        }
      }
    },
    "UncertainCall": {
      "type": "object",
      "required": ["kind", "callee", "file", "line", "reason"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["indirect_call", "virtual_dispatch", "extern_ffi", "unresolved_call"]
        },
        "callee": { "type": "string" },
        "candidate_owners": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "file": { "type": "string" },
        "line": { "type": "integer", "minimum": 0 },
        "reason": { "type": "string" }
      }
    },
    "CallResolution": {
      "type": "object",
      "required": ["resolved_calls", "uncertain_calls", "complete"],
      "properties": {
        "resolved_calls": { "type": "array", "items": { "type": "string" } },
        "uncertain_calls": {
          "type": "array",
          "items": { "$ref": "#/$defs/UncertainCall" }
        },
        "complete": { "type": "boolean" }
      }
    },
    "GraphResult": {
      "type": "object",
      "required": ["schema_version", "graph_hash"],
      "properties": {
        "schema_version": { "const": "wysna.graph/1" },
        "graph_hash": { "type": "string", "pattern": "^graph:[0-9a-f]{16}$" },
        "analysis_boundaries": { "type": "array", "items": { "type": "string" } }
      }
    },
    "InspectBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_bytes", "used_bytes", "truncated", "omitted_count"],
      "properties": {
        "max_bytes": { "type": ["integer", "null"], "minimum": 1 },
        "used_bytes": { "type": "integer", "minimum": 0 },
        "truncated": { "type": "boolean" },
        "omitted_count": { "type": "integer", "minimum": 0 },
        "source_offset": { "type": "integer", "minimum": 0 },
        "source_total_bytes": { "type": "integer", "minimum": 0 },
        "offset": { "type": "integer", "minimum": 0 },
        "total_symbols": { "type": "integer", "minimum": 0 },
        "requested_count": { "type": "integer", "minimum": 1 },
        "returned_count": { "type": "integer", "minimum": 0 }
      }
    },
    "InspectBatchItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "source", "dependencies", "impact", "call_resolution", "budget", "omitted"],
      "properties": {
        "node": { "type": "object" },
        "source": { "type": "string" },
        "dependencies": { "type": "array", "items": { "type": "object" } },
        "impact": { "type": "object" },
        "call_resolution": { "$ref": "#/$defs/CallResolution" },
        "budget": { "$ref": "#/$defs/InspectBudget" },
        "omitted": { "type": "array", "items": { "type": "object" } }
      }
    },
    "InspectIndexResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "file", "graph_hash", "summary", "symbols", "budget", "omitted", "analysis_boundaries"],
      "properties": {
        "schema_version": { "const": "wysna.inspect/1" },
        "file": { "type": "string" },
        "graph_hash": { "type": "string", "pattern": "^graph:[0-9a-f]{16}$" },
        "summary": { "type": "object" },
        "symbols": { "type": "array", "items": { "type": "object" } },
        "budget": { "$ref": "#/$defs/InspectBudget" },
        "omitted": { "type": "array", "items": { "type": "object" } },
        "analysis_boundaries": { "type": "array", "items": { "type": "string" } },
        "project": { "type": "object" }
      }
    },
    "InspectSymbolResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "file", "graph_hash", "node", "source", "dependencies", "impact", "call_resolution", "budget", "omitted", "analysis_boundaries"],
      "properties": {
        "schema_version": { "const": "wysna.inspect/1" },
        "file": { "type": "string" },
        "graph_hash": { "type": "string", "pattern": "^graph:[0-9a-f]{16}$" },
        "node": { "type": "object" },
        "source": { "type": "string" },
        "dependencies": { "type": "array", "items": { "type": "object" } },
        "impact": { "type": "object" },
        "call_resolution": { "$ref": "#/$defs/CallResolution" },
        "budget": { "$ref": "#/$defs/InspectBudget" },
        "omitted": { "type": "array", "items": { "type": "object" } },
        "analysis_boundaries": { "type": "array", "items": { "type": "string" } },
        "project": { "type": "object" }
      }
    },
    "InspectBatchResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "mode", "file", "graph_hash", "items", "budget", "omitted", "analysis_boundaries"],
      "properties": {
        "schema_version": { "const": "wysna.inspect/1" },
        "mode": { "const": "batch" },
        "file": { "type": "string" },
        "graph_hash": { "type": "string", "pattern": "^graph:[0-9a-f]{16}$" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/InspectBatchItem" } },
        "budget": { "$ref": "#/$defs/InspectBudget" },
        "omitted": { "type": "array", "items": { "type": "object" } },
        "analysis_boundaries": { "type": "array", "items": { "type": "string" } },
        "project": { "type": "object" }
      }
    },
    "InspectResult": {
      "oneOf": [
        { "$ref": "#/$defs/InspectIndexResult" },
        { "$ref": "#/$defs/InspectSymbolResult" },
        { "$ref": "#/$defs/InspectBatchResult" }
      ]
    },
    "SinglePatchResult": {
      "type": "object",
      "required": ["schema_version", "symbol", "written", "graph_hash_before", "graph_hash_after"],
      "properties": {
        "schema_version": { "const": "wysna.patch/1" },
        "symbol": { "type": "string" },
        "written": { "type": "boolean" },
        "graph_hash_before": { "type": "string" },
        "graph_hash_after": { "type": "string" }
      }
    },
    "WorkspacePatchChange": {
      "type": "object",
      "required": ["path", "action", "before_sha256", "after_sha256", "diff"],
      "properties": {
        "path": { "type": "string" },
        "action": { "enum": ["modify", "create", "delete"] },
        "before_sha256": { "type": ["string", "null"] },
        "after_sha256": { "type": ["string", "null"] },
        "diff": { "type": "string" }
      }
    },
    "WorkspacePatchResult": {
      "type": "object",
      "required": [
        "schema_version",
        "workspace_revision_before",
        "workspace_revision_after",
        "changes",
        "checked",
        "tests",
        "selected_test_ids",
        "plan_hash",
        "written"
      ],
      "properties": {
        "schema_version": { "const": "wysna.workspace-patch/1" },
        "workspace_revision_before": { "type": "string" },
        "workspace_revision_after": { "type": "string" },
        "changes": { "type": "array", "items": { "$ref": "#/$defs/WorkspacePatchChange" } },
        "checked": { "type": "array", "items": { "type": "string" } },
        "tests": { "type": "array", "items": { "type": "object" } },
        "selected_test_ids": { "type": "array", "items": { "type": "string" } },
        "plan_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "written": { "type": "boolean" }
      }
    }
  }
}
