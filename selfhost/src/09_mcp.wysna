# Native Model Context Protocol (MCP) server over newline-delimited stdio JSON-RPC 2.0.

class McpServerState {
    root: str
    inline_path: str
    self_exe: str
    stdlib_root: str
    tmp_dir: str
    seq: int

    fn init(root: str, self_exe: str, stdlib_root: str, tmp_dir: str) {
        this.root = root
        let sep = if root == "/" { "" } else { "/" }
        this.inline_path = root + sep + "__mcp_inline__.wysna"
        this.self_exe = self_exe
        this.stdlib_root = stdlib_root
        this.tmp_dir = tmp_dir
        this.seq = 0
    }
}

fn mcp_getcwd() -> str {
    let buf = wysna_host_buffer_new()
    let sz = wysna_host_getcwd(buf)
    let raw = if sz > 0 { lsp_buf_to_str(buf, sz) } else { "" }
    wysna_host_close(buf)
    return raw
}

fn mcp_is_abs_path(p: str) -> bool {
    if len(p) == 0 { return false }
    if p[0] == "/" or p[0] == "\\" { return true }
    if len(p) >= 2 and p[1] == ":" { return true }
    return false
}

fn mcp_norm_cmp_prefix(p: str, is_win_drive: bool) -> str {
    if is_win_drive { return lsp_ascii_lower(p) }
    return p
}

fn mcp_is_within_root(cand: str, root: str) -> bool {
    if cand == "" or root == "" { return false }
    let win_drive = len(cand) >= 2 and cand[1] == ":" and len(root) >= 2 and root[1] == ":"
    let c_cmp = mcp_norm_cmp_prefix(cand, win_drive)
    let r_cmp = mcp_norm_cmp_prefix(root, win_drive)
    if c_cmp == r_cmp { return true }
    if r_cmp == "/" { return len(c_cmp) > 0 and c_cmp[0] == "/" }
    if len(c_cmp) > len(r_cmp) and slice(c_cmp, 0, len(r_cmp)) == r_cmp and c_cmp[len(r_cmp)] == "/" {
        return true
    }
    return false
}

fn mcp_resolve_with_ancestors(joined: str) -> str {
    let direct = module_canonical_resolved(joined)
    if direct != "" { return direct }
    let norm = module_normalize(joined)
    if norm == "" { return "" }
    let mut cur = norm
    let mut tail_segs: list[str] = []
    while cur != "" {
        let can = module_canonical_resolved(cur)
        if can != "" {
            let mut out = can
            let mut k = len(tail_segs) - 1
            while k >= 0 {
                if out == "/" { out = "/" + tail_segs[k] }
                else { out = out + "/" + tail_segs[k] }
                k = k - 1
            }
            return out
        }
        let mut sep = -1
        for i in 0..len(cur) {
            if cur[i] == "/" { sep = i }
        }
        if sep < 0 { break }
        if sep == 0 {
            if len(cur) > 1 { tail_segs.append(slice(cur, 1, len(cur))) }
            let can_root = module_canonical_resolved("/")
            if can_root != "" {
                let mut out = can_root
                let mut k = len(tail_segs) - 1
                while k >= 0 {
                    if out == "/" { out = "/" + tail_segs[k] }
                    else { out = out + "/" + tail_segs[k] }
                    k = k - 1
                }
                return out
            }
            break
        }
        tail_segs.append(slice(cur, sep + 1, len(cur)))
        cur = slice(cur, 0, sep)
    }
    return norm
}

fn mcp_confine_path(root: str, raw_path: str) -> list[str] {
    if lsp_trim(raw_path) == "" { return ["0", "path must be non-empty"] }
    let joined = if mcp_is_abs_path(raw_path) { raw_path } else {
        if root == "/" { "/" + raw_path } else { root + "/" + raw_path }
    }
    let resolved = mcp_resolve_with_ancestors(joined)
    if not mcp_is_within_root(resolved, root) {
        return ["0", "path is outside the server root: " + raw_path]
    }
    return ["1", resolved]
}

fn mcp_json_error() -> LspJson {
    return new LspJson("error")
}

fn mcp_hex_digit(code: int) -> int {
    if code >= 48 and code <= 57 { return code - 48 }
    if code >= 65 and code <= 70 { return code - 55 }
    if code >= 97 and code <= 102 { return code - 87 }
    return -1
}

fn mcp_strict_hex4(c: LspJsonCursor) -> int {
    if c.pos + 4 > len(c.src) { return -1 }
    let mut acc = 0
    for k in 0..4 {
        let d = mcp_hex_digit(ord(c.src[c.pos + k]))
        if d < 0 { return -1 }
        acc = acc * 16 + d
    }
    c.pos = c.pos + 4
    return acc
}

fn mcp_strict_parse_str_wrap(c: LspJsonCursor) -> list[str] {
    let n = len(c.src)
    if c.pos >= n or c.src[c.pos] != "\"" { return ["0", ""] }
    c.pos = c.pos + 1
    let mut parts: list[str] = []
    while c.pos < n {
        let ch = c.src[c.pos]
        let code = ord(ch)
        if code < 32 { return ["0", ""] }
        c.pos = c.pos + 1
        if ch == "\"" { return ["1", join_strings(parts, "")] }
        if ch == "\\" {
            if c.pos >= n { return ["0", ""] }
            let esc = c.src[c.pos]
            c.pos = c.pos + 1
            if esc == "\"" { parts.append("\"") }
            elif esc == "\\" { parts.append("\\") }
            elif esc == "/" { parts.append("/") }
            elif esc == "b" { parts.append(chr(8)) }
            elif esc == "f" { parts.append(chr(12)) }
            elif esc == "n" { parts.append("\n") }
            elif esc == "r" { parts.append("\r") }
            elif esc == "t" { parts.append("\t") }
            elif esc == "u" {
                let cp_hi = mcp_strict_hex4(c)
                if cp_hi < 0 { return ["0", ""] }
                if cp_hi >= 55296 and cp_hi <= 56319 and c.pos + 2 <= n and c.src[c.pos] == "\\" and c.src[c.pos + 1] == "u" {
                    c.pos = c.pos + 2
                    let cp_lo = mcp_strict_hex4(c)
                    if cp_lo < 56320 or cp_lo > 57343 { return ["0", ""] }
                    parts.append(chr(65536 + ((cp_hi - 55296) * 1024) + (cp_lo - 56320)))
                } else {
                    parts.append(chr(cp_hi))
                }
            } else {
                return ["0", ""]
            }
        } else {
            parts.append(ch)
        }
    }
    return ["0", ""]
}

fn mcp_strict_parse_val(c: LspJsonCursor) -> LspJson {
    lsp_jc_skip_ws(c)
    let n = len(c.src)
    if c.pos >= n { return mcp_json_error() }
    let ch = c.src[c.pos]
    if ch == "\"" {
        let sres = mcp_strict_parse_str_wrap(c)
        if sres[0] != "1" { return mcp_json_error() }
        let out = new LspJson("str")
        out.str_val = sres[1]
        return out
    }
    if ch == "{" {
        c.pos = c.pos + 1
        let obj = new LspJson("object")
        lsp_jc_skip_ws(c)
        if c.pos < n and c.src[c.pos] == "}" {
            c.pos = c.pos + 1
            return obj
        }
        while true {
            lsp_jc_skip_ws(c)
            if c.pos >= n or c.src[c.pos] != "\"" { return mcp_json_error() }
            let kres = mcp_strict_parse_str_wrap(c)
            if kres[0] != "1" { return mcp_json_error() }
            lsp_jc_skip_ws(c)
            if c.pos >= n or c.src[c.pos] != ":" { return mcp_json_error() }
            c.pos = c.pos + 1
            let val = mcp_strict_parse_val(c)
            if val.kind == "error" { return mcp_json_error() }
            obj.keys.append(kres[1])
            obj.vals.append(val)
            lsp_jc_skip_ws(c)
            if c.pos >= n { return mcp_json_error() }
            if c.src[c.pos] == "," {
                c.pos = c.pos + 1
                continue
            }
            if c.src[c.pos] == "}" {
                c.pos = c.pos + 1
                return obj
            }
            return mcp_json_error()
        }
        return mcp_json_error()
    }
    if ch == "[" {
        c.pos = c.pos + 1
        let arr = new LspJson("array")
        lsp_jc_skip_ws(c)
        if c.pos < n and c.src[c.pos] == "]" {
            c.pos = c.pos + 1
            return arr
        }
        while true {
            let item = mcp_strict_parse_val(c)
            if item.kind == "error" { return mcp_json_error() }
            arr.items.append(item)
            lsp_jc_skip_ws(c)
            if c.pos >= n { return mcp_json_error() }
            if c.src[c.pos] == "," {
                c.pos = c.pos + 1
                continue
            }
            if c.src[c.pos] == "]" {
                c.pos = c.pos + 1
                return arr
            }
            return mcp_json_error()
        }
        return mcp_json_error()
    }
    if ch == "t" and c.pos + 4 <= n and slice(c.src, c.pos, c.pos + 4) == "true" {
        c.pos = c.pos + 4
        let out = new LspJson("bool")
        out.bool_val = true
        return out
    }
    if ch == "f" and c.pos + 5 <= n and slice(c.src, c.pos, c.pos + 5) == "false" {
        c.pos = c.pos + 5
        let out = new LspJson("bool")
        out.bool_val = false
        return out
    }
    if ch == "n" and c.pos + 4 <= n and slice(c.src, c.pos, c.pos + 4) == "null" {
        c.pos = c.pos + 4
        return lsp_json_null()
    }
    let start = c.pos
    if c.src[c.pos] == "-" { c.pos = c.pos + 1 }
    if c.pos >= n or not is_digit(ord(c.src[c.pos])) { return mcp_json_error() }
    let int_start = c.pos
    while c.pos < n and is_digit(ord(c.src[c.pos])) { c.pos = c.pos + 1 }
    let int_str = slice(c.src, start, c.pos)
    if c.pos < n and c.src[c.pos] == "." {
        c.pos = c.pos + 1
        if c.pos >= n or not is_digit(ord(c.src[c.pos])) { return mcp_json_error() }
        while c.pos < n and is_digit(ord(c.src[c.pos])) { c.pos = c.pos + 1 }
    }
    if c.pos < n and (c.src[c.pos] == "e" or c.src[c.pos] == "E") {
        c.pos = c.pos + 1
        if c.pos < n and (c.src[c.pos] == "+" or c.src[c.pos] == "-") { c.pos = c.pos + 1 }
        if c.pos >= n or not is_digit(ord(c.src[c.pos])) { return mcp_json_error() }
        while c.pos < n and is_digit(ord(c.src[c.pos])) { c.pos = c.pos + 1 }
    }
    if int_start == c.pos { return mcp_json_error() }
    let num = new LspJson("int")
    num.int_val = lsp_parse_int(int_str, 0)
    num.str_val = slice(c.src, int_start, c.pos)
    return num
}

fn mcp_parse_json_strict(src: str) -> LspJson {
    let cursor = new LspJsonCursor(src)
    let val = mcp_strict_parse_val(cursor)
    if val.kind == "error" { return val }
    lsp_jc_skip_ws(cursor)
    if cursor.pos != len(cursor.src) { return mcp_json_error() }
    return val
}

fn mcp_write_line(json_body: str) -> unit {
    let out = lsp_buf_from_str(json_body + "\n")
    let _w = wysna_host_stdout_write_raw(out)
    wysna_host_close(out)
}

fn mcp_rpc_result(id_raw: str, result_json: str) -> str {
    return "{\"jsonrpc\":\"2.0\",\"id\":" + id_raw + ",\"result\":" + result_json + "}"
}

fn mcp_rpc_error(id_raw: str, code: int, message: str) -> str {
    return "{\"jsonrpc\":\"2.0\",\"id\":" + id_raw + ",\"error\":{\"code\":" + str(code) + ",\"message\":" + diag_json_quote(message) + "}}"
}

fn mcp_tool_err(msg: str) -> list[str] {
    return ["1", "{\"error\":" + diag_json_quote(msg) + "}"]
}

fn mcp_next_tmp(state: McpServerState, prefix: str, ext: str) -> str {
    state.seq = state.seq + 1
    return state.tmp_dir + "/" + prefix + "_" + str(unix_time()) + "_" + str(state.seq) + ext
}

fn mcp_run_subcommand(state: McpServerState, tool_argv: list[str]) -> list[str] {
    let diag_tmp = mcp_next_tmp(state, "wysna_mcp_diag", ".json")
    let mut argv: list[str] = []
    if state.stdlib_root != "" {
        argv.append("--stdlib-root")
        argv.append(state.stdlib_root)
    }
    for item in tool_argv { argv.append(item) }
    argv.append("--diag-out")
    argv.append(diag_tmp)
    let exe_buf = lsp_buf_from_str(state.self_exe)
    let args_buf = lsp_pack_argv_buf(argv)
    let rc = wysna_host_process_run(exe_buf, args_buf, 30000)
    wysna_host_close(exe_buf)
    wysna_host_close(args_buf)
    let raw = read_file(diag_tmp) else err { "" }
    lsp_remove_file(diag_tmp)
    return [str(rc), raw]
}

fn mcp_resolve_source(state: McpServerState, arguments: LspJson) -> list[str] {
    let has_path = lsp_json_has(arguments, "path") and lsp_json_get(arguments, "path").kind != "null"
    let has_source = lsp_json_has(arguments, "source") and lsp_json_get(arguments, "source").kind != "null"
    if has_path == has_source {
        return ["0", "provide exactly one of 'path' or 'source'", "", "", ""]
    }
    if has_path {
        let pv = lsp_json_get(arguments, "path")
        if pv.kind != "str" { return ["0", "'path' must be a string", "", "", ""] }
        let confined = mcp_confine_path(state.root, pv.str_val)
        if confined[0] != "1" { return ["0", confined[1], "", "", ""] }
        let resolved = confined[1]
        let txt = read_file(resolved) else err {
            return ["0", "cannot read file: " + resolved, "", "", ""]
        }
        return ["1", resolved, txt, "", ""]
    }
    let sv = lsp_json_get(arguments, "source")
    if sv.kind != "str" { return ["0", "'source' must be a string", "", "", ""] }
    let tmp_ov = mcp_next_tmp(state, "wysna_mcp_ov", ".wysna")
    write_file(tmp_ov, sv.str_val) else _err {
        return ["0", "failed writing temporary MCP overlay", "", "", ""]
    }
    return ["1", state.inline_path, sv.str_val, state.inline_path, tmp_ov]
}

fn mcp_cleanup_source(resolved_src: list[str]) -> unit {
    if len(resolved_src) >= 5 and resolved_src[4] != "" {
        lsp_remove_file(resolved_src[4])
    }
}

fn mcp_with_overlay_flags(base_argv: list[str], resolved_src: list[str]) -> list[str] {
    let mut out: list[str] = []
    for item in base_argv { out.append(item) }
    if len(resolved_src) >= 5 and resolved_src[4] != "" {
        out.append("--overlay")
        out.append(resolved_src[3])
        out.append(resolved_src[4])
    }
    return out
}

fn mcp_exec_simple_source_tool(state: McpServerState, cmd: str, arguments: LspJson, extra_flags: list[str]) -> list[str] {
    let rs = mcp_resolve_source(state, arguments)
    if rs[0] != "1" { return mcp_tool_err(rs[1]) }
    let mut argv: list[str] = [cmd, rs[1], "--output-format=json-v1"]
    for fl in extra_flags { argv.append(fl) }
    argv = mcp_with_overlay_flags(argv, rs)
    let sub = mcp_run_subcommand(state, argv)
    mcp_cleanup_source(rs)
    if sub[1] == "" { return mcp_tool_err("tool produced no JSON (exit " + sub[0] + ")") }
    return ["0", sub[1]]
}

fn mcp_tool_fmt(state: McpServerState, arguments: LspJson) -> list[str] {
    let rs = mcp_resolve_source(state, arguments)
    if rs[0] != "1" { return mcp_tool_err(rs[1]) }
    let target = rs[1]
    let orig_src = rs[2]
    let argv = mcp_with_overlay_flags(["fmt", target, "--output-format=json-v1"], rs)
    let sub = mcp_run_subcommand(state, argv)
    mcp_cleanup_source(rs)
    if sub[1] == "" { return mcp_tool_err("tool produced no JSON (exit " + sub[0] + ")") }
    let parsed = lsp_parse_json(sub[1])
    if lsp_json_str(parsed, "status", "") != "ok" {
        return ["0", sub[1]]
    }
    let arts = lsp_json_get(parsed, "artifacts")
    let mut formatted = orig_src
    if arts.kind == "array" and len(arts.items) > 0 {
        formatted = lsp_json_str(arts.items[0], "content", orig_src)
    }
    let changed = formatted != orig_src
    let res_obj = "{\"path\":" + diag_json_quote(target) + ",\"changed\":" + (if changed { "true" } else { "false" }) + ",\"written\":false,\"formatted_source\":" + diag_json_quote(formatted) + "}"
    return ["0", diag_tool_envelope_json("fmt", "ok", 0, "[]", "result", res_obj, "[]")]
}

fn mcp_tool_schema(state: McpServerState, arguments: LspJson) -> list[str] {
    let mut extra: list[str] = []
    if lsp_json_bool(arguments, "all", false) { extra.append("--all") }
    let fn_v = lsp_json_get(arguments, "function")
    if fn_v.kind == "str" and fn_v.str_val != "" {
        extra.append("--function")
        extra.append(fn_v.str_val)
    }
    if lsp_json_bool(arguments, "emit_codecs", false) { extra.append("--emit-codecs") }
    let res = mcp_exec_simple_source_tool(state, "schema", arguments, extra)
    if res[0] != "0" { return res }
    let parsed = lsp_parse_json(res[1])
    if lsp_json_str(parsed, "status", "") == "usage_error" {
        let ds = lsp_json_get(parsed, "diagnostics")
        let mut msg = "schema usage error"
        if ds.kind == "array" and len(ds.items) > 0 {
            msg = lsp_json_str(ds.items[0], "message", msg)
        }
        return mcp_tool_err(msg)
    }
    return res
}

fn mcp_tool_graph(state: McpServerState, arguments: LspJson) -> list[str] {
    let rs = mcp_resolve_source(state, arguments)
    if rs[0] != "1" { return mcp_tool_err(rs[1]) }
    let target = rs[1]
    let src_text = rs[2]
    let mut argv: list[str] = ["graph", target, "--output-format=json-v1"]
    let sym_v = lsp_json_get(arguments, "symbol")
    let sym = if sym_v.kind == "str" { sym_v.str_val } else { "" }
    if sym != "" {
        argv.append("--symbol")
        argv.append(sym)
    }
    let rel_v = lsp_json_get(arguments, "relation")
    if rel_v.kind == "str" and rel_v.str_val != "" {
        argv.append("--rel")
        argv.append(rel_v.str_val)
    }
    argv = mcp_with_overlay_flags(argv, rs)
    let sub = mcp_run_subcommand(state, argv)
    mcp_cleanup_source(rs)
    if sub[1] == "" { return mcp_tool_err("tool produced no JSON (exit " + sub[0] + ")") }
    if sym != "" {
        let parsed = lsp_parse_json(sub[1])
        let res_obj = lsp_json_get(parsed, "result")
        if res_obj.kind == "object" and lsp_json_has(res_obj, "found") and not lsp_json_bool(res_obj, "found", true) {
            let diag = diag_record_json("W1001", "graph", "error", "Symbol '" + sym + "' not found in semantic graph", target, 1, 1, src_text)
            return ["0", diag_tool_envelope_json("graph", "diagnostic_error", 1, "[" + diag + "]", "", "", "[]")]
        }
    }
    return ["0", sub[1]]
}

fn mcp_tool_inspect(state: McpServerState, arguments: LspJson) -> list[str] {
    let mut extra: list[str] = []
    let sym_v = lsp_json_get(arguments, "symbol")
    if sym_v.kind == "str" and sym_v.str_val != "" {
        extra.append("--symbol")
        extra.append(sym_v.str_val)
    }
    if lsp_json_bool(arguments, "with_deps", false) { extra.append("--with-deps") }
    return mcp_exec_simple_source_tool(state, "inspect", arguments, extra)
}

fn mcp_tool_patch(state: McpServerState, arguments: LspJson) -> list[str] {
    let path_v = lsp_json_get(arguments, "path")
    let sym_v = lsp_json_get(arguments, "symbol")
    let rep_v = lsp_json_get(arguments, "replacement")
    if path_v.kind != "str" or path_v.str_val == "" or sym_v.kind != "str" or sym_v.str_val == "" or rep_v.kind != "str" or rep_v.str_val == "" {
        return mcp_tool_err("'wysna_patch' requires 'path', 'symbol', and 'replacement'")
    }
    let confined = mcp_confine_path(state.root, path_v.str_val)
    if confined[0] != "1" { return mcp_tool_err(confined[1]) }
    let resolved = confined[1]
    let _chk = read_file(resolved) else err {
        return mcp_tool_err("cannot read file: " + resolved)
    }
    let tmp_rep = mcp_next_tmp(state, "wysna_mcp_rep", ".wysna")
    write_file(tmp_rep, rep_v.str_val) else _err {
        return mcp_tool_err("failed writing patch replacement temp file")
    }
    let mut argv: list[str] = ["patch", resolved, "--symbol", sym_v.str_val, "--with-file", tmp_rep, "--output-format=json-v1"]
    let hash_v = lsp_json_get(arguments, "expect_graph_hash")
    if hash_v.kind == "str" and hash_v.str_val != "" {
        argv.append("--expect-graph-hash")
        argv.append(hash_v.str_val)
    }
    if lsp_json_bool(arguments, "apply", false) { argv.append("--apply") }
    let sub = mcp_run_subcommand(state, argv)
    lsp_remove_file(tmp_rep)
    if sub[1] == "" { return mcp_tool_err("tool produced no JSON (exit " + sub[0] + ")") }
    return ["0", sub[1]]
}

fn mcp_tool_fix(state: McpServerState, arguments: LspJson) -> list[str] {
    let apply = lsp_json_bool(arguments, "apply", false)
    let has_path = lsp_json_has(arguments, "path") and lsp_json_get(arguments, "path").kind != "null"
    if apply and not has_path {
        return mcp_tool_err("'apply' requires 'path'")
    }
    let rs = mcp_resolve_source(state, arguments)
    if rs[0] != "1" { return mcp_tool_err(rs[1]) }
    let mut argv: list[str] = ["fix", rs[1], "--output-format=json-v1"]
    if apply { argv.append("--apply") }
    if lsp_json_bool(arguments, "include_maybe", false) { argv.append("--include-maybe") }
    argv = mcp_with_overlay_flags(argv, rs)
    let sub = mcp_run_subcommand(state, argv)
    mcp_cleanup_source(rs)
    if sub[1] == "" { return mcp_tool_err("tool produced no JSON (exit " + sub[0] + ")") }
    let res_obj = fix_extract_json_object_field(sub[1], "result")
    if res_obj != "" { return ["0", res_obj] }
    return ["0", sub[1]]
}

fn mcp_tool_skills(arguments: LspJson) -> list[str] {
    let tv = lsp_json_get(arguments, "topic")
    let topic = if tv.kind == "str" and tv.str_val != "" { tv.str_val } else { "overview" }
    let payload = tool_skills_payload_json(topic)
    if payload == "" {
        return mcp_tool_err("Unknown skill topic '" + topic + "'. Available topics: agent-loop, contracts, graph, overview, patch, stdlib, syntax")
    }
    return ["0", diag_tool_envelope_json("skills", "ok", 0, "[]", "result", payload, "[]")]
}

fn mcp_tool_api(state: McpServerState, arguments: LspJson) -> list[str] {
    let mod_v = lsp_json_get(arguments, "module")
    let man_v = lsp_json_get(arguments, "manifest")
    let has_mod = lsp_json_has(arguments, "module") and mod_v.kind != "null"
    let has_man = lsp_json_has(arguments, "manifest") and man_v.kind != "null"
    if has_mod and mod_v.kind != "str" { return mcp_tool_err("'module' must be a string") }
    if has_man and man_v.kind != "str" { return mcp_tool_err("'manifest' must be a string") }
    let mut argv: list[str] = ["api", "--output-format=json-v1"]
    if has_mod and lsp_trim(mod_v.str_val) != "" {
        argv.append(mod_v.str_val)
    }
    if has_man and lsp_trim(man_v.str_val) != "" {
        let confined = mcp_confine_path(state.root, man_v.str_val)
        if confined[0] != "1" { return mcp_tool_err(confined[1]) }
        argv.append("--manifest")
        argv.append(confined[1])
    }
    let sub = mcp_run_subcommand(state, argv)
    if sub[1] == "" { return mcp_tool_err("tool produced no JSON (exit " + sub[0] + ")") }
    return ["0", sub[1]]
}

fn mcp_tools_list_json() -> str {
    let src_or_path = "\"path\":{\"type\":\"string\",\"description\":\"Path to a .wysna file inside the server root.\"},\"source\":{\"type\":\"string\",\"description\":\"Inline Wysna source text (alternative to path).\"}"
    let mut ts: list[str] = []
    ts.append("{\"name\":\"wysna_check\",\"description\":\"Type-check Wysna code. Returns every independent error with byte spans, expected/found facts and candidate fixes (wysna.tool-result/1).\",\"inputSchema\":{\"type\":\"object\",\"properties\":{" + src_or_path + "}}}")
    ts.append("{\"name\":\"wysna_fix\",\"description\":\"Compute (and optionally apply) machine-applicable fixes for diagnostics. Returns the corrected source and the diagnostics that remain.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{" + src_or_path + ",\"apply\":{\"type\":\"boolean\",\"description\":\"Write the fix to 'path' (default false).\"},\"include_maybe\":{\"type\":\"boolean\",\"description\":\"Also use heuristic 'maybe' fixes.\"}}}}")
    ts.append("{\"name\":\"wysna_fmt\",\"description\":\"Return the canonical formatting of Wysna code.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{" + src_or_path + "}}}")
    ts.append("{\"name\":\"wysna_explain\",\"description\":\"Static effect and capability report for a program.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{" + src_or_path + "}}}")
    ts.append("{\"name\":\"wysna_schema\",\"description\":\"Emit JSON Schema (Draft 2020-12) for structs/enums and LLM tool definitions with static effect/idempotency metadata for functions.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{" + src_or_path + ",\"all\":{\"type\":\"boolean\",\"description\":\"Include private top-level functions.\"},\"function\":{\"type\":\"string\",\"description\":\"Emit tool schema for a single function.\"},\"emit_codecs\":{\"type\":\"boolean\",\"description\":\"Generate Wysna JSON encoder/decoder functions.\"}}}}")
    ts.append("{\"name\":\"wysna_api\",\"description\":\"Discover standard-library modules and public symbols.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"module\":{\"type\":\"string\",\"description\":\"Optional module such as std/json.\"},\"manifest\":{\"type\":\"string\",\"description\":\"Optional path to a wysna.toml manifest inside the server root.\"}}}}")
    ts.append("{\"name\":\"wysna_capabilities\",\"description\":\"Installed commands, targets and their capability contracts.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{}}}")
    ts.append("{\"name\":\"wysna_graph\",\"description\":\"Compile-time semantic relationship graph (interfaces, classes, usages, calls, blast radius).\",\"inputSchema\":{\"type\":\"object\",\"properties\":{" + src_or_path + ",\"symbol\":{\"type\":\"string\",\"description\":\"Optional symbol name or node ID filter.\"},\"relation\":{\"type\":\"string\",\"description\":\"Optional relation filter: implements|hierarchy|usages|callers|callees|impact.\"}}}}")
    ts.append("{\"name\":\"wysna_inspect\",\"description\":\"Surgical, token-efficient symbol source slice, contract, effects, and dependency signatures.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{" + src_or_path + ",\"symbol\":{\"type\":\"string\",\"description\":\"Symbol name to extract (omit for compact index).\"},\"with_deps\":{\"type\":\"boolean\",\"description\":\"Include signatures of referenced types and callees.\"}}}}")
    ts.append("{\"name\":\"wysna_patch\",\"description\":\"Checked declaration-level patch guarded by graph hash and in-memory typecheck.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\",\"description\":\"Path to a .wysna file inside the server root.\"},\"symbol\":{\"type\":\"string\",\"description\":\"Target declaration name or Class.method.\"},\"replacement\":{\"type\":\"string\",\"description\":\"Replacement declaration Wysna code.\"},\"expect_graph_hash\":{\"type\":\"string\",\"description\":\"Optional optimistic lock graph hash.\"},\"apply\":{\"type\":\"boolean\",\"description\":\"Write patch to disk after verification (default false).\"}},\"required\":[\"path\",\"symbol\",\"replacement\"]}}")
    ts.append("{\"name\":\"wysna_skills\",\"description\":\"Version-matched concise coding and workflow guides embedded in Wysna.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"topic\":{\"type\":\"string\",\"description\":\"overview, agent-loop, syntax, graph, patch, contracts, stdlib.\"}}}}")
    return "{\"tools\":[" + join_strings(ts, ",") + "]}"
}

fn mcp_handle_tool_call(state: McpServerState, id_raw: str, params: LspJson) -> str {
    let name = lsp_json_str(params, "name", "")
    let known = name == "wysna_check" or name == "wysna_fix" or name == "wysna_fmt" or name == "wysna_explain" or name == "wysna_schema" or name == "wysna_api" or name == "wysna_capabilities" or name == "wysna_graph" or name == "wysna_inspect" or name == "wysna_patch" or name == "wysna_skills"
    if not known {
        return mcp_rpc_error(id_raw, -32602, "unknown tool: " + name)
    }
    let mut arguments = new LspJson("object")
    if lsp_json_has(params, "arguments") {
        let raw_args = lsp_json_get(params, "arguments")
        if raw_args.kind != "null" {
            if raw_args.kind != "object" {
                return mcp_rpc_error(id_raw, -32602, "arguments must be an object")
            }
            arguments = raw_args
        }
    }
    let mut res: list[str] = ["1", "{}"]
    if name == "wysna_check" {
        res = mcp_exec_simple_source_tool(state, "check", arguments, [])
    } elif name == "wysna_fmt" {
        res = mcp_tool_fmt(state, arguments)
    } elif name == "wysna_explain" {
        res = mcp_exec_simple_source_tool(state, "explain", arguments, [])
    } elif name == "wysna_schema" {
        res = mcp_tool_schema(state, arguments)
    } elif name == "wysna_api" {
        res = mcp_tool_api(state, arguments)
    } elif name == "wysna_capabilities" {
        res = ["0", diag_tool_envelope_json("capabilities", "ok", 0, "[]", "result", tool_capabilities_payload_json(), "[]")]
    } elif name == "wysna_graph" {
        res = mcp_tool_graph(state, arguments)
    } elif name == "wysna_inspect" {
        res = mcp_tool_inspect(state, arguments)
    } elif name == "wysna_patch" {
        res = mcp_tool_patch(state, arguments)
    } elif name == "wysna_fix" {
        res = mcp_tool_fix(state, arguments)
    } elif name == "wysna_skills" {
        res = mcp_tool_skills(arguments)
    }
    let failed_flag = if res[0] == "1" { "true" } else { "false" }
    let call_res = "{\"content\":[{\"type\":\"text\",\"text\":" + diag_json_quote(res[1]) + "}],\"isError\":" + failed_flag + "}"
    return mcp_rpc_result(id_raw, call_res)
}

fn mcp_handle_message(state: McpServerState, msg: LspJson) -> str {
    if msg.kind != "object" or lsp_json_str(msg, "jsonrpc", "") != "2.0" {
        return mcp_rpc_error("null", -32600, "invalid request")
    }
    let has_id = lsp_json_has(msg, "id")
    let id_val = lsp_json_get(msg, "id")
    if not has_id or id_val.kind == "null" {
        return ""
    }
    let id_raw = lsp_json_raw_literal(id_val)
    let method = lsp_json_str(msg, "method", "")
    let params = lsp_json_get(msg, "params")
    if method == "initialize" {
        let pv = lsp_json_str(params, "protocolVersion", "2025-06-18")
        return mcp_rpc_result(id_raw, "{\"protocolVersion\":" + diag_json_quote(pv) + ",\"capabilities\":{\"tools\":{}},\"serverInfo\":{\"name\":\"wysna\",\"version\":\"0.8.0\"}}")
    }
    if method == "ping" {
        return mcp_rpc_result(id_raw, "{}")
    }
    if method == "tools/list" {
        return mcp_rpc_result(id_raw, mcp_tools_list_json())
    }
    if method == "tools/call" {
        return mcp_handle_tool_call(state, id_raw, params)
    }
    return mcp_rpc_error(id_raw, -32601, "method not found: " + method)
}

fn mcp_serve(args: list[str]) -> unit {
    let mut root_arg = ""
    if len(args) == 1 {
        root_arg = ""
    } elif len(args) == 3 and args[1] == "--root" {
        root_arg = args[2]
    } else {
        eprint("usage: wysna mcp [--root <dir>]")
        exit(2)
    }
    let raw_root = if root_arg != "" { root_arg } else { mcp_getcwd() }
    let root = module_canonical_resolved(raw_root)
    if root == "" {
        eprint("wysna mcp: invalid root directory: " + raw_root)
        exit(2)
    }
    let state = new McpServerState(root, lsp_self_exe_path(), lsp_stdlib_root_arg(), lsp_tmp_dir())
    while true {
        let buf = wysna_host_buffer_new()
        let st = wysna_host_stdin_read_line(buf)
        if st <= 0 {
            wysna_host_close(buf)
            break
        }
        let line_len = lsp_buf_read_line_len(buf)
        let line = lsp_trim(lsp_buf_to_str(buf, line_len))
        wysna_host_close(buf)
        if line == "" { continue }
        let msg = mcp_parse_json_strict(line)
        if msg.kind == "error" {
            mcp_write_line(mcp_rpc_error("null", -32700, "parse error"))
            continue
        }
        let resp = mcp_handle_message(state, msg)
        if resp != "" { mcp_write_line(resp) }
    }
    exit(0)
}
