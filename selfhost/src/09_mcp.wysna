# Native Model Context Protocol (MCP) server over newline-delimited stdio JSON-RPC 2.0.

class McpServerState {
    root: str
    inline_path: str
    self_exe: str
    stdlib_root: str
    tmp_dir: str
    tmp_nonce: str
    allow_exec: bool
    sdk_driver: str
    seq: int

    fn init(root: str, self_exe: str, stdlib_root: str, tmp_dir: str, allow_exec: bool, sdk_driver: str) {
        this.root = root
        let sep = if root == "/" { "" } else { "/" }
        this.inline_path = root + sep + "__mcp_inline__.wysna"
        this.self_exe = self_exe
        this.stdlib_root = stdlib_root
        this.tmp_dir = tmp_dir
        this.tmp_nonce = diag_uuid4()
        if this.tmp_nonce == "native" {
            eprint("wysna mcp: cannot allocate an isolated session")
            exit(2)
        }
        this.allow_exec = allow_exec
        this.sdk_driver = sdk_driver
        this.seq = 0
    }
}

# mcp_getcwd, mcp_is_abs_path, mcp_is_within_root live in 01_tool_common.wysna.

fn mcp_resolve_with_ancestors(joined: str) -> str {
    let direct = module_canonical_resolved(joined)
    if direct != "" { return direct }
    let norm = module_normalize(joined)
    if norm == "" { return "" }
    let mut cur = norm
    let mut tail_segs: list[str] = []
    while cur != "" {
        let can = module_canonical_resolved(cur)
        if can != "" {
            let mut out = can
            let mut k = len(tail_segs) - 1
            while k >= 0 {
                if out == "/" { out = "/" + tail_segs[k] }
                else { out = out + "/" + tail_segs[k] }
                k = k - 1
            }
            return out
        }
        let mut sep = -1
        for i in 0..len(cur) {
            if cur[i] == "/" { sep = i }
        }
        if sep < 0 { break }
        if sep == 0 {
            if len(cur) > 1 { tail_segs.append(slice(cur, 1, len(cur))) }
            let can_root = module_canonical_resolved("/")
            if can_root != "" {
                let mut out = can_root
                let mut k = len(tail_segs) - 1
                while k >= 0 {
                    if out == "/" { out = "/" + tail_segs[k] }
                    else { out = out + "/" + tail_segs[k] }
                    k = k - 1
                }
                return out
            }
            break
        }
        tail_segs.append(slice(cur, sep + 1, len(cur)))
        cur = slice(cur, 0, sep)
    }
    return norm
}

fn mcp_confine_path(root: str, raw_path: str) -> list[str] {
    if lsp_trim(raw_path) == "" { return ["0", "path must be non-empty"] }
    let joined = if mcp_is_abs_path(raw_path) { raw_path } else {
        if root == "/" { "/" + raw_path } else { root + "/" + raw_path }
    }
    let resolved = mcp_resolve_with_ancestors(joined)
    if not mcp_is_within_root(resolved, root) {
        return ["0", "path is outside the server root: " + raw_path]
    }
    return ["1", resolved]
}

# Strict JSON parser (mcp_parse_json_strict) lives in 01_tool_common.wysna.

fn mcp_write_line(json_body: str) -> unit {
    let out = lsp_buf_from_str(json_body + "\n")
    let _w = wysna_host_stdout_write_raw(out)
    wysna_host_close(out)
}

fn mcp_rpc_result(id_raw: str, result_json: str) -> str {
    return "{\"jsonrpc\":\"2.0\",\"id\":" + id_raw + ",\"result\":" + result_json + "}"
}

fn mcp_rpc_error(id_raw: str, code: int, message: str) -> str {
    return "{\"jsonrpc\":\"2.0\",\"id\":" + id_raw + ",\"error\":{\"code\":" + str(code) + ",\"message\":" + diag_json_quote(message) + "}}"
}

fn mcp_tool_err(msg: str) -> list[str] {
    return ["1", "{\"error\":" + diag_json_quote(msg) + "}"]
}

fn mcp_next_tmp(state: McpServerState, prefix: str, ext: str) -> str {
    state.seq = state.seq + 1
    return state.tmp_dir + "/" + prefix + "_" + state.tmp_nonce + "_" + str(state.seq) + ext
}

fn mcp_run_subcommand(state: McpServerState, tool_argv: list[str]) -> list[str] {
    let diag_tmp = mcp_next_tmp(state, "wysna_mcp_diag", ".json")
    let mut argv: list[str] = []
    if state.stdlib_root != "" {
        argv.append("--stdlib-root")
        argv.append(state.stdlib_root)
    }
    for item in tool_argv { argv.append(item) }
    argv.append("--diag-out")
    argv.append(diag_tmp)
    let exe_buf = lsp_buf_from_str(state.self_exe)
    let args_buf = lsp_pack_argv_buf(argv)
    let rc = wysna_host_process_run(exe_buf, args_buf, 30000)
    wysna_host_close(exe_buf)
    wysna_host_close(args_buf)
    let raw = read_file(diag_tmp) else err { "" }
    lsp_remove_file(diag_tmp)
    return [str(rc), raw]
}

fn mcp_run_sdk_subcommand(state: McpServerState, tool_argv: list[str]) -> list[str] {
    let output = mcp_next_tmp(state, "wysna_mcp_sdk", ".json")
    let mut argv = tool_argv
    argv.append("--diag-out")
    argv.append(output)
    let exe_buf = lsp_buf_from_str(state.sdk_driver)
    let args_buf = lsp_pack_argv_buf(argv)
    let rc = wysna_host_process_run(exe_buf, args_buf, 300000)
    wysna_host_close(exe_buf)
    wysna_host_close(args_buf)
    let raw = read_file(output) else err { "" }
    lsp_remove_file(output)
    return [str(rc), raw]
}

fn mcp_resolve_source(state: McpServerState, arguments: LspJson) -> list[str] {
    let has_path = lsp_json_has(arguments, "path") and lsp_json_get(arguments, "path").kind != "null"
    let has_source = lsp_json_has(arguments, "source") and lsp_json_get(arguments, "source").kind != "null"
    if has_path == has_source {
        return ["0", "provide exactly one of 'path' or 'source'", "", "", ""]
    }
    if has_path {
        let pv = lsp_json_get(arguments, "path")
        if pv.kind != "str" { return ["0", "'path' must be a string", "", "", ""] }
        let confined = mcp_confine_path(state.root, pv.str_val)
        if confined[0] != "1" { return ["0", confined[1], "", "", ""] }
        let resolved = confined[1]
        let txt = read_file(resolved) else err {
            return ["0", "cannot read file: " + resolved, "", "", ""]
        }
        return ["1", resolved, txt, "", ""]
    }
    let sv = lsp_json_get(arguments, "source")
    if sv.kind != "str" { return ["0", "'source' must be a string", "", "", ""] }
    let tmp_ov = mcp_next_tmp(state, "wysna_mcp_ov", ".wysna")
    write_file(tmp_ov, sv.str_val) else _err {
        return ["0", "failed writing temporary MCP overlay", "", "", ""]
    }
    return ["1", state.inline_path, sv.str_val, state.inline_path, tmp_ov]
}

fn mcp_cleanup_source(resolved_src: list[str]) -> unit {
    if len(resolved_src) >= 5 and resolved_src[4] != "" {
        lsp_remove_file(resolved_src[4])
    }
}

fn mcp_with_overlay_flags(base_argv: list[str], resolved_src: list[str]) -> list[str] {
    let mut out: list[str] = []
    for item in base_argv { out.append(item) }
    if len(resolved_src) >= 5 and resolved_src[4] != "" {
        out.append("--overlay")
        out.append(resolved_src[3])
        out.append(resolved_src[4])
    }
    return out
}

fn mcp_exec_simple_source_tool(state: McpServerState, cmd: str, arguments: LspJson, extra_flags: list[str]) -> list[str] {
    let rs = mcp_resolve_source(state, arguments)
    if rs[0] != "1" { return mcp_tool_err(rs[1]) }
    let mut argv: list[str] = [cmd, rs[1], "--output-format=json-v1"]
    for fl in extra_flags { argv.append(fl) }
    argv = mcp_with_overlay_flags(argv, rs)
    let sub = mcp_run_subcommand(state, argv)
    mcp_cleanup_source(rs)
    if sub[1] == "" { return mcp_tool_err("tool produced no JSON (exit " + sub[0] + ")") }
    return ["0", sub[1]]
}

fn mcp_tool_fmt(state: McpServerState, arguments: LspJson) -> list[str] {
    let rs = mcp_resolve_source(state, arguments)
    if rs[0] != "1" { return mcp_tool_err(rs[1]) }
    let target = rs[1]
    let orig_src = rs[2]
    let argv = mcp_with_overlay_flags(["fmt", target, "--output-format=json-v1"], rs)
    let sub = mcp_run_subcommand(state, argv)
    mcp_cleanup_source(rs)
    if sub[1] == "" { return mcp_tool_err("tool produced no JSON (exit " + sub[0] + ")") }
    let parsed = lsp_parse_json(sub[1])
    if lsp_json_str(parsed, "status", "") != "ok" {
        return ["0", sub[1]]
    }
    let arts = lsp_json_get(parsed, "artifacts")
    let mut formatted = orig_src
    if arts.kind == "array" and len(arts.items) > 0 {
        formatted = lsp_json_str(arts.items[0], "content", orig_src)
    }
    let changed = formatted != orig_src
    let res_obj = "{\"path\":" + diag_json_quote(target) + ",\"changed\":" + (if changed { "true" } else { "false" }) + ",\"written\":false,\"formatted_source\":" + diag_json_quote(formatted) + "}"
    return ["0", diag_tool_envelope_json("fmt", "ok", 0, "[]", "result", res_obj, "[]")]
}

fn mcp_tool_schema(state: McpServerState, arguments: LspJson) -> list[str] {
    let mut extra: list[str] = []
    if lsp_json_bool(arguments, "all", false) { extra.append("--all") }
    let fn_v = lsp_json_get(arguments, "function")
    if fn_v.kind == "str" and fn_v.str_val != "" {
        extra.append("--function")
        extra.append(fn_v.str_val)
    }
    if lsp_json_bool(arguments, "emit_codecs", false) { extra.append("--emit-codecs") }
    let res = mcp_exec_simple_source_tool(state, "schema", arguments, extra)
    if res[0] != "0" { return res }
    let parsed = lsp_parse_json(res[1])
    if lsp_json_str(parsed, "status", "") == "usage_error" {
        let ds = lsp_json_get(parsed, "diagnostics")
        let mut msg = "schema usage error"
        if ds.kind == "array" and len(ds.items) > 0 {
            msg = lsp_json_str(ds.items[0], "message", msg)
        }
        return mcp_tool_err(msg)
    }
    return res
}

fn mcp_tool_graph(state: McpServerState, arguments: LspJson) -> list[str] {
    if lsp_json_has(arguments, "role") {
        let manifest = lsp_json_get(arguments, "manifest")
        let role = lsp_json_str(arguments, "role", "")
        let target = lsp_json_get(arguments, "target")
        if manifest.kind != "str" or role == "" or (lsp_json_has(arguments, "target") and (target.kind != "str" or target.str_val == "")) or lsp_json_has(arguments, "path") or lsp_json_has(arguments, "source") or lsp_json_has(arguments, "symbol") or lsp_json_has(arguments, "relation") {
            return mcp_tool_err("provide manifest, role and optionally target for a role query")
        }
        let confined = mcp_confine_path(state.root, manifest.str_val)
        if confined[0] != "1" { return mcp_tool_err(confined[1]) }
        let mut argv: list[str] = ["graph", "--manifest", confined[1], "--role", role, "--output-format=json-v1"]
        if target.kind == "str" { argv.append("--target") argv.append(target.str_val) }
        let result = mcp_run_subcommand(state, argv)
        if result[1] == "" { return mcp_tool_err("tool produced no JSON (exit " + result[0] + ")") }
        return ["0", result[1]]
    }
    if lsp_json_has(arguments, "manifest") {
        let manifest = lsp_json_get(arguments, "manifest")
        let symbol = lsp_json_str(arguments, "symbol", "")
        if manifest.kind != "str" or symbol == "" or lsp_json_str(arguments, "relation", "") != "impact" or lsp_json_has(arguments, "path") or lsp_json_has(arguments, "source") {
            return mcp_tool_err("provide manifest, symbol and relation=impact for a project query")
        }
        let confined = mcp_confine_path(state.root, manifest.str_val)
        if confined[0] != "1" { return mcp_tool_err(confined[1]) }
        let result = mcp_run_subcommand(state, ["graph", "--manifest", confined[1], "--symbol", symbol, "--rel", "impact", "--output-format=json-v1"])
        if result[1] == "" { return mcp_tool_err("tool produced no JSON (exit " + result[0] + ")") }
        return ["0", result[1]]
    }

    let rs = mcp_resolve_source(state, arguments)
    if rs[0] != "1" { return mcp_tool_err(rs[1]) }
    let target = rs[1]
    let mut argv: list[str] = ["graph", target, "--output-format=json-v1"]
    let sym_v = lsp_json_get(arguments, "symbol")
    let sym = if sym_v.kind == "str" { sym_v.str_val } else { "" }
    if sym != "" {
        argv.append("--symbol")
        argv.append(sym)
    }
    let rel_v = lsp_json_get(arguments, "relation")
    if rel_v.kind == "str" and rel_v.str_val != "" {
        argv.append("--rel")
        argv.append(rel_v.str_val)
    }
    argv = mcp_with_overlay_flags(argv, rs)
    let sub = mcp_run_subcommand(state, argv)
    mcp_cleanup_source(rs)
    if sub[1] == "" { return mcp_tool_err("tool produced no JSON (exit " + sub[0] + ")") }
    return ["0", sub[1]]
}

fn mcp_tool_inspect(state: McpServerState, arguments: LspJson) -> list[str] {
    let mut extra: list[str] = []
    let sym_v = lsp_json_get(arguments, "symbol")
    if sym_v.kind == "str" and sym_v.str_val != "" {
        extra.append("--symbol")
        extra.append(sym_v.str_val)
    }
    if lsp_json_has(arguments, "symbols") and lsp_json_get(arguments, "symbols").kind != "null" {
        let syms_v = lsp_json_get(arguments, "symbols")
        if syms_v.kind != "array" or len(syms_v.items) == 0 {
            return mcp_tool_err("'symbols' must be a non-empty array of strings")
        }
        if sym_v.kind == "str" and sym_v.str_val != "" {
            return mcp_tool_err("provide either 'symbol' or 'symbols', not both")
        }
        for si in 0..len(syms_v.items) {
            let item = syms_v.items[si]
            if item.kind != "str" or lsp_trim(item.str_val) == "" {
                return mcp_tool_err("'symbols' entries must be non-empty strings")
            }
            extra.append("--symbol")
            extra.append(item.str_val)
        }
    }
    if lsp_json_bool(arguments, "with_deps", false) { extra.append("--with-deps") }
    if lsp_json_has(arguments, "max_bytes") and lsp_json_get(arguments, "max_bytes").kind != "null" {
        let mb = lsp_json_get(arguments, "max_bytes")
        if mb.kind != "int" or mb.int_val < 1 { return mcp_tool_err("'max_bytes' must be a positive integer") }
        extra.append("--max-bytes")
        extra.append(str(mb.int_val))
    }
    if lsp_json_has(arguments, "source_offset") and lsp_json_get(arguments, "source_offset").kind != "null" {
        let so = lsp_json_get(arguments, "source_offset")
        if so.kind != "int" or so.int_val < 0 { return mcp_tool_err("'source_offset' must be a non-negative integer") }
        extra.append("--source-offset")
        extra.append(str(so.int_val))
    }
    if lsp_json_has(arguments, "offset") and lsp_json_get(arguments, "offset").kind != "null" {
        let off = lsp_json_get(arguments, "offset")
        if off.kind != "int" or off.int_val < 0 { return mcp_tool_err("'offset' must be a non-negative integer") }
        extra.append("--offset")
        extra.append(str(off.int_val))
    }
    let span = lsp_json_get(arguments, "span")
    if span.kind != "null" {
        if span.kind != "object" or lsp_json_get(arguments, "path").kind != "str" or
           lsp_json_get(arguments, "source").kind != "null" {
            return mcp_tool_err("'span' requires a file path and a diagnostic span object")
        }
        extra.append("--span")
        extra.append(mcp_serialize_json_val(span))
    }
    return mcp_exec_simple_source_tool(state, "inspect", arguments, extra)
}

fn mcp_tool_project_check(state: McpServerState, arguments: LspJson) -> list[str] {
    let man_v = lsp_json_get(arguments, "manifest")
    if man_v.kind != "str" or lsp_trim(man_v.str_val) == "" {
        return mcp_tool_err("'wysna_project_check' requires 'manifest'")
    }
    let confined = mcp_confine_path(state.root, man_v.str_val)
    if confined[0] != "1" { return mcp_tool_err(confined[1]) }
    let mut argv: list[str] = ["project", "check", "--manifest", confined[1], "--output-format=json-v1"]
    let tgt_v = lsp_json_get(arguments, "target")
    if tgt_v.kind == "str" and lsp_trim(tgt_v.str_val) != "" {
        argv.append("--target")
        argv.append(tgt_v.str_val)
    }
    if lsp_json_bool(arguments, "frozen", false) { argv.append("--frozen") }
    let sub = mcp_run_subcommand(state, argv)
    if sub[1] == "" { return mcp_tool_err("project check produced no JSON (exit " + sub[0] + ")") }
    return ["0", sub[1]]
}

fn mcp_tool_project_test(state: McpServerState, arguments: LspJson) -> list[str] {
    let man_v = lsp_json_get(arguments, "manifest")
    if man_v.kind != "str" or lsp_trim(man_v.str_val) == "" {
        return mcp_tool_err("'wysna_project_test' requires 'manifest'")
    }
    let confined = mcp_confine_path(state.root, man_v.str_val)
    if confined[0] != "1" { return mcp_tool_err(confined[1]) }
    let list_only = lsp_json_bool(arguments, "list", false)
    if not list_only and not state.allow_exec {
        let d_json = diag_record_json("W5002", "usage", "error", "wysna_project_test execution requires starting MCP server with --allow-exec (pass list=true for static test discovery)", "<mcp>", 1, 1, "")
        return ["0", diag_tool_envelope_json("project.test", "usage_error", 2, "[" + d_json + "]", "", "", "[]")]
    }
    let mut base_argv: list[str] = ["project", "test", "--manifest", confined[1], "--output-format=json-v1"]
    if list_only { base_argv.append("--list") }
    if lsp_json_bool(arguments, "discover", false) { base_argv.append("--discover") }
    if lsp_json_bool(arguments, "frozen", false) { base_argv.append("--frozen") }
    let filt_v = lsp_json_get(arguments, "filter")
    if filt_v.kind == "str" and lsp_trim(filt_v.str_val) != "" {
        base_argv.append("--filter")
        base_argv.append(filt_v.str_val)
    }
    let case_v = lsp_json_get(arguments, "case")
    if case_v.kind == "str" and lsp_trim(case_v.str_val) != "" {
        base_argv.append("--case")
        base_argv.append(case_v.str_val)
    }
    let plan_v = lsp_json_get(arguments, "expect_plan_hash")
    if plan_v.kind == "str" and lsp_trim(plan_v.str_val) != "" {
        base_argv.append("--expect-plan-hash")
        base_argv.append(plan_v.str_val)
    }
    if list_only {
        let sub = mcp_run_subcommand(state, base_argv)
        if sub[1] == "" { return mcp_tool_err("project test --list produced no JSON (exit " + sub[0] + ")") }
        return ["0", sub[1]]
    }
    if state.sdk_driver == "" {
        let d_json = diag_record_json("W5002", "usage", "error", "project test requires the wysna native SDK driver", "<mcp>", 1, 1, "")
        return ["0", diag_tool_envelope_json("project.test", "usage_error", 2, "[" + d_json + "]", "", "", "[]")]
    }
    let sub = mcp_run_sdk_subcommand(state, base_argv)
    if sub[1] == "" { return mcp_tool_err("project test produced no JSON report (exit " + sub[0] + ")") }
    return ["0", sub[1]]
}

fn mcp_serialize_json_val(v: LspJson) -> str {
    if v.kind == "null" { return "null" }
    if v.kind == "bool" { return if v.bool_val { "true" } else { "false" } }
    if v.kind == "int" { return str(v.int_val) }
    if v.kind == "str" { return diag_json_quote(v.str_val) }
    if v.kind == "array" {
        let mut parts: list[str] = ["["]
        for i in 0..len(v.items) {
            if i > 0 { parts.append(",") }
            parts.append(mcp_serialize_json_val(v.items[i]))
        }
        parts.append("]")
        return join_strings(parts, "")
    }
    if v.kind == "object" {
        let mut parts: list[str] = ["{"]
        for i in 0..len(v.keys) {
            if i > 0 { parts.append(",") }
            parts.append(diag_json_quote(v.keys[i]) + ":" + mcp_serialize_json_val(v.vals[i]))
        }
        parts.append("}")
        return join_strings(parts, "")
    }
    return "null"
}

fn mcp_tool_patch(state: McpServerState, arguments: LspJson) -> list[str] {
    if lsp_json_has(arguments, "test") and lsp_json_get(arguments, "test").kind != "bool" {
        return mcp_tool_err("'test' must be a boolean")
    }
    let test = lsp_json_bool(arguments, "test", false)
    if test and (not state.allow_exec or state.sdk_driver == "") {
        let msg = if not state.allow_exec { "Tested patches require starting the MCP server with --allow-exec" }
            else { "Tested patches require the wysna native SDK driver" }
        let diagnostic = diag_record_json("W5002", "usage", "error", msg, "<mcp>", 1, 1, "")
        return ["0", diag_tool_envelope_json("patch", "usage_error", 2, "[" + diagnostic + "]", "", "", "[]")]
    }
    if lsp_json_has(arguments, "edits") or lsp_json_has(arguments, "manifest") {
        let man_v = lsp_json_get(arguments, "manifest")
        let edits_v = lsp_json_get(arguments, "edits")
        if man_v.kind != "str" or man_v.str_val == "" or edits_v.kind != "array" {
            return mcp_tool_err("workspace 'wysna_patch' requires 'manifest' and 'edits'")
        }
        if (lsp_json_has(arguments, "path") and lsp_json_get(arguments, "path").kind != "null") or
           (lsp_json_has(arguments, "symbol") and lsp_json_get(arguments, "symbol").kind != "null") or
           (lsp_json_has(arguments, "replacement") and lsp_json_get(arguments, "replacement").kind != "null") or
           (lsp_json_has(arguments, "expect_graph_hash") and lsp_json_get(arguments, "expect_graph_hash").kind != "null") {
            return mcp_tool_err("workspace 'wysna_patch' cannot combine single-symbol options with 'manifest'/'edits'")
        }
        let confined = mcp_confine_path(state.root, man_v.str_val)
        if confined[0] != "1" { return mcp_tool_err(confined[1]) }
        let tmp_edits = mcp_next_tmp(state, "wysna_mcp_edits", ".json")
        write_file(tmp_edits, mcp_serialize_json_val(edits_v)) else _err {
            return mcp_tool_err("failed writing workspace edits temp file")
        }
        let mut argv: list[str] = ["patch", "--manifest", confined[1], "--edits", tmp_edits, "--output-format=json-v1"]
        let plan_v = lsp_json_get(arguments, "expect_plan_hash")
        if plan_v.kind == "str" and plan_v.str_val != "" {
            argv.append("--expect-plan-hash")
            argv.append(plan_v.str_val)
        }
        if lsp_json_bool(arguments, "discover", false) { argv.append("--discover") }
        if lsp_json_bool(arguments, "frozen", false) { argv.append("--frozen") }
        if lsp_json_bool(arguments, "apply", false) { argv.append("--apply") }
        if test { argv.append("--test") }
        let sub = if test { mcp_run_sdk_subcommand(state, argv) } else { mcp_run_subcommand(state, argv) }
        lsp_remove_file(tmp_edits)
        if sub[1] == "" { return mcp_tool_err("tool produced no JSON (exit " + sub[0] + ")") }
        return ["0", sub[1]]
    }

    if test { return mcp_tool_err("'test' requires workspace 'manifest' and 'edits'") }
    let path_v = lsp_json_get(arguments, "path")
    let sym_v = lsp_json_get(arguments, "symbol")
    let rep_v = lsp_json_get(arguments, "replacement")
    if path_v.kind != "str" or path_v.str_val == "" or sym_v.kind != "str" or sym_v.str_val == "" or rep_v.kind != "str" or rep_v.str_val == "" {
        return mcp_tool_err("'wysna_patch' requires 'path', 'symbol', and 'replacement'")
    }
    let confined = mcp_confine_path(state.root, path_v.str_val)
    if confined[0] != "1" { return mcp_tool_err(confined[1]) }
    let resolved = confined[1]
    let _chk = read_file(resolved) else err {
        return mcp_tool_err("cannot read file: " + resolved)
    }
    let tmp_rep = mcp_next_tmp(state, "wysna_mcp_rep", ".wysna")
    write_file(tmp_rep, rep_v.str_val) else _err {
        return mcp_tool_err("failed writing patch replacement temp file")
    }
    let mut argv: list[str] = ["patch", resolved, "--symbol", sym_v.str_val, "--with-file", tmp_rep, "--output-format=json-v1"]
    let hash_v = lsp_json_get(arguments, "expect_graph_hash")
    if hash_v.kind == "str" and hash_v.str_val != "" {
        argv.append("--expect-graph-hash")
        argv.append(hash_v.str_val)
    }
    if lsp_json_bool(arguments, "apply", false) { argv.append("--apply") }
    let sub = mcp_run_subcommand(state, argv)
    lsp_remove_file(tmp_rep)
    if sub[1] == "" { return mcp_tool_err("tool produced no JSON (exit " + sub[0] + ")") }
    return ["0", sub[1]]
}

fn mcp_tool_fix(state: McpServerState, arguments: LspJson) -> list[str] {
    let apply = lsp_json_bool(arguments, "apply", false)
    let has_path = lsp_json_has(arguments, "path") and lsp_json_get(arguments, "path").kind != "null"
    if apply and not has_path {
        return mcp_tool_err("'apply' requires 'path'")
    }
    let rs = mcp_resolve_source(state, arguments)
    if rs[0] != "1" { return mcp_tool_err(rs[1]) }
    let mut argv: list[str] = ["fix", rs[1], "--output-format=json-v1"]
    if apply { argv.append("--apply") }
    if lsp_json_bool(arguments, "include_maybe", false) { argv.append("--include-maybe") }
    argv = mcp_with_overlay_flags(argv, rs)
    let sub = mcp_run_subcommand(state, argv)
    mcp_cleanup_source(rs)
    if sub[1] == "" { return mcp_tool_err("tool produced no JSON (exit " + sub[0] + ")") }
    let res_obj = fix_extract_json_object_field(sub[1], "result")
    if res_obj != "" { return ["0", res_obj] }
    return ["0", sub[1]]
}

fn mcp_tool_skills(arguments: LspJson) -> list[str] {
    let tv = lsp_json_get(arguments, "topic")
    let topic = if tv.kind == "str" and tv.str_val != "" { tv.str_val } else { "overview" }
    let payload = tool_skills_payload_json(topic)
    if payload == "" {
        return mcp_tool_err("Unknown skill topic '" + topic + "'. Available topics: agent-loop, contracts, graph, overview, patch, stdlib, syntax")
    }
    return ["0", diag_tool_envelope_json("skills", "ok", 0, "[]", "result", payload, "[]")]
}

fn mcp_tool_api(state: McpServerState, arguments: LspJson) -> list[str] {
    let mod_v = lsp_json_get(arguments, "module")
    let man_v = lsp_json_get(arguments, "manifest")
    let has_mod = lsp_json_has(arguments, "module") and mod_v.kind != "null"
    let has_man = lsp_json_has(arguments, "manifest") and man_v.kind != "null"
    if has_mod and mod_v.kind != "str" { return mcp_tool_err("'module' must be a string") }
    if has_man and man_v.kind != "str" { return mcp_tool_err("'manifest' must be a string") }
    let mut argv: list[str] = ["api", "--output-format=json-v1"]
    if has_mod and lsp_trim(mod_v.str_val) != "" {
        argv.append(mod_v.str_val)
    }
    if has_man and lsp_trim(man_v.str_val) != "" {
        let confined = mcp_confine_path(state.root, man_v.str_val)
        if confined[0] != "1" { return mcp_tool_err(confined[1]) }
        argv.append("--manifest")
        argv.append(confined[1])
    }
    let sub = mcp_run_subcommand(state, argv)
    if sub[1] == "" { return mcp_tool_err("tool produced no JSON (exit " + sub[0] + ")") }
    return ["0", sub[1]]
}

fn mcp_tools_list_json() -> str {
    let src_or_path = "\"path\":{\"type\":\"string\",\"description\":\"Path to a .wysna file inside the server root.\"},\"source\":{\"type\":\"string\",\"description\":\"Inline Wysna source text (alternative to path).\"}"
    let mut ts: list[str] = []
    ts.append("{\"name\":\"wysna_check\",\"description\":\"Type-check Wysna code. Returns every independent error with byte spans, expected/found facts and candidate fixes (wysna.tool-result/1).\",\"inputSchema\":{\"type\":\"object\",\"properties\":{" + src_or_path + "}}}")
    ts.append("{\"name\":\"wysna_fix\",\"description\":\"Compute (and optionally apply) machine-applicable fixes for diagnostics. Returns the corrected source and the diagnostics that remain.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{" + src_or_path + ",\"apply\":{\"type\":\"boolean\",\"description\":\"Write the fix to 'path' (default false).\"},\"include_maybe\":{\"type\":\"boolean\",\"description\":\"Also use heuristic 'maybe' fixes.\"}}}}")
    ts.append("{\"name\":\"wysna_fmt\",\"description\":\"Return the canonical formatting of Wysna code.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{" + src_or_path + "}}}")
    ts.append("{\"name\":\"wysna_explain\",\"description\":\"Static effect and capability report for a program.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{" + src_or_path + "}}}")
    ts.append("{\"name\":\"wysna_schema\",\"description\":\"Emit JSON Schema (Draft 2020-12) for structs/enums and LLM tool definitions with static effect/idempotency metadata for functions.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{" + src_or_path + ",\"all\":{\"type\":\"boolean\",\"description\":\"Include private top-level functions.\"},\"function\":{\"type\":\"string\",\"description\":\"Emit tool schema for a single function.\"},\"emit_codecs\":{\"type\":\"boolean\",\"description\":\"Generate Wysna JSON encoder/decoder functions.\"}}}}")
    ts.append("{\"name\":\"wysna_api\",\"description\":\"Discover standard-library modules and public symbols.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"module\":{\"type\":\"string\",\"description\":\"Optional module such as std/json.\"},\"manifest\":{\"type\":\"string\",\"description\":\"Optional path to a wysna.toml manifest inside the server root.\"}}}}")
    ts.append("{\"name\":\"wysna_capabilities\",\"description\":\"Installed commands, targets and their capability contracts.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{}}}")
    ts.append("{\"name\":\"wysna_graph\",\"description\":\"Compile-time semantic relationship graph (interfaces, classes, usages, calls, blast radius).\",\"inputSchema\":{\"type\":\"object\",\"properties\":{" + src_or_path + ",\"manifest\":{\"type\":\"string\",\"description\":\"Project manifest for an impact or architecture role query.\"},\"role\":{\"type\":\"string\",\"description\":\"Configured architecture role.\"},\"target\":{\"type\":\"string\",\"description\":\"Optional project target for the role query.\"},\"symbol\":{\"type\":\"string\",\"description\":\"Optional symbol name or node ID filter.\"},\"relation\":{\"type\":\"string\",\"description\":\"Optional relation filter: implements|hierarchy|usages|callers|callees|impact.\"}}}}")
    ts.append("{\"name\":\"wysna_inspect\",\"description\":\"Surgical, token-efficient symbol source slice (single or batch), contract, effects, call resolution, and dependency signatures.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{" + src_or_path + ",\"symbol\":{\"type\":\"string\",\"description\":\"Symbol name to extract (omit for compact index).\"},\"span\":{\"type\":\"object\",\"description\":\"Read bounded context at a diagnostic span. Requires path and the original source hash.\",\"required\":[\"source_id\",\"source_sha256\",\"start_byte\",\"end_byte\"],\"properties\":{\"source_id\":{\"type\":\"string\"},\"source_sha256\":{\"type\":\"string\"},\"start_byte\":{\"type\":\"integer\",\"minimum\":0},\"end_byte\":{\"type\":\"integer\",\"minimum\":0}}},\"symbols\":{\"type\":\"array\",\"items\":{\"type\":\"string\"},\"description\":\"Batch list of symbols to extract under one shared max_bytes budget.\"},\"with_deps\":{\"type\":\"boolean\",\"description\":\"Include signatures of referenced types and callees.\"},\"max_bytes\":{\"type\":\"integer\",\"minimum\":1,\"description\":\"Maximum UTF-8 byte budget for returned source/context.\"},\"source_offset\":{\"type\":\"integer\",\"minimum\":0,\"description\":\"UTF-8 byte offset within target symbol source.\"},\"offset\":{\"type\":\"integer\",\"minimum\":0,\"description\":\"Starting index offset when listing symbols.\"}}}}")
    ts.append("{\"name\":\"wysna_patch\",\"description\":\"Checked declaration-level or multi-file workspace patch (source, symbol, hunks, create, delete) guarded by graph/plan hash and in-memory typecheck.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\",\"description\":\"Path to a .wysna file inside the server root (single-symbol mode).\"},\"symbol\":{\"type\":\"string\",\"description\":\"Target declaration name or Class.method (single-symbol mode).\"},\"replacement\":{\"type\":\"string\",\"description\":\"Replacement declaration Wysna code (single-symbol mode).\"},\"expect_graph_hash\":{\"type\":\"string\",\"description\":\"Optional optimistic lock graph hash (single-symbol mode).\"},\"manifest\":{\"type\":\"string\",\"description\":\"Path to wysna.toml inside server root (workspace mode).\"},\"edits\":{\"type\":\"array\",\"description\":\"Array of workspace edit objects ({path, source|symbol+replacement|hunks|create+source|delete}) to check and apply together.\"},\"expect_plan_hash\":{\"type\":\"string\",\"description\":\"Plan hash from preview (required with apply=true in workspace mode).\"},\"discover\":{\"type\":\"boolean\",\"description\":\"Discover tests under tests/ (workspace mode).\"},\"frozen\":{\"type\":\"boolean\",\"description\":\"Verify wysna.lock before planning/applying (workspace mode).\"},\"test\":{\"type\":\"boolean\",\"description\":\"Run tests on the staged workspace. Requires --allow-exec.\"},\"apply\":{\"type\":\"boolean\",\"description\":\"Write verified patch to disk (default false).\"}}}}")
    ts.append("{\"name\":\"wysna_project_check\",\"description\":\"Static project-wide typecheck across wysna.toml targets and lockfile verification.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"manifest\":{\"type\":\"string\",\"description\":\"Path to wysna.toml inside server root.\"},\"target\":{\"type\":\"string\",\"description\":\"Optional target name from wysna.toml.\"},\"frozen\":{\"type\":\"boolean\",\"description\":\"Verify wysna.lock before checking.\"}},\"required\":[\"manifest\"]}}")
    ts.append("{\"name\":\"wysna_project_test\",\"description\":\"List test plans deterministically (list=true) or execute project tests when MCP server was started with --allow-exec.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"manifest\":{\"type\":\"string\",\"description\":\"Path to wysna.toml inside server root.\"},\"list\":{\"type\":\"boolean\",\"description\":\"Return static test plan and plan_hash without executing code.\"},\"discover\":{\"type\":\"boolean\",\"description\":\"Discover test files under tests/.\"},\"frozen\":{\"type\":\"boolean\",\"description\":\"Verify wysna.lock before listing or running tests.\"},\"filter\":{\"type\":\"string\",\"description\":\"Substring filter on test ID/name.\"},\"case\":{\"type\":\"string\",\"description\":\"Run only the specified test case ID.\"},\"expect_plan_hash\":{\"type\":\"string\",\"description\":\"Verify test selection against a previously listed plan_hash.\"}},\"required\":[\"manifest\"]}}")
    ts.append("{\"name\":\"wysna_skills\",\"description\":\"Version-matched concise coding and workflow guides embedded in Wysna.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"topic\":{\"type\":\"string\",\"description\":\"overview, agent-loop, syntax, graph, patch, contracts, stdlib.\"}}}}")
    return "{\"tools\":[" + join_strings(ts, ",") + "]}"
}

fn mcp_handle_tool_call(state: McpServerState, id_raw: str, params: LspJson) -> str {
    let name = lsp_json_str(params, "name", "")
    let known = name == "wysna_check" or name == "wysna_fix" or name == "wysna_fmt" or name == "wysna_explain" or name == "wysna_schema" or name == "wysna_api" or name == "wysna_capabilities" or name == "wysna_graph" or name == "wysna_inspect" or name == "wysna_patch" or name == "wysna_project_check" or name == "wysna_project_test" or name == "wysna_skills"
    if not known {
        return mcp_rpc_error(id_raw, -32602, "unknown tool: " + name)
    }
    let mut arguments = LspJson("object")
    if lsp_json_has(params, "arguments") {
        let raw_args = lsp_json_get(params, "arguments")
        if raw_args.kind != "null" {
            if raw_args.kind != "object" {
                return mcp_rpc_error(id_raw, -32602, "arguments must be an object")
            }
            arguments = raw_args
        }
    }
    let mut res: list[str] = ["1", "{}"]
    if name == "wysna_check" {
        res = mcp_exec_simple_source_tool(state, "check", arguments, [])
    } elif name == "wysna_fmt" {
        res = mcp_tool_fmt(state, arguments)
    } elif name == "wysna_explain" {
        res = mcp_exec_simple_source_tool(state, "explain", arguments, [])
    } elif name == "wysna_schema" {
        res = mcp_tool_schema(state, arguments)
    } elif name == "wysna_api" {
        res = mcp_tool_api(state, arguments)
    } elif name == "wysna_capabilities" {
        res = ["0", diag_tool_envelope_json("capabilities", "ok", 0, "[]", "result", tool_capabilities_payload_json(), "[]")]
    } elif name == "wysna_graph" {
        res = mcp_tool_graph(state, arguments)
    } elif name == "wysna_inspect" {
        res = mcp_tool_inspect(state, arguments)
    } elif name == "wysna_patch" {
        res = mcp_tool_patch(state, arguments)
    } elif name == "wysna_project_check" {
        res = mcp_tool_project_check(state, arguments)
    } elif name == "wysna_project_test" {
        res = mcp_tool_project_test(state, arguments)
    } elif name == "wysna_fix" {
        res = mcp_tool_fix(state, arguments)
    } elif name == "wysna_skills" {
        res = mcp_tool_skills(arguments)
    }
    let failed_flag = if res[0] == "1" { "true" } else { "false" }
    let call_res = "{\"content\":[{\"type\":\"text\",\"text\":" + diag_json_quote(res[1]) + "}],\"isError\":" + failed_flag + "}"
    return mcp_rpc_result(id_raw, call_res)
}

fn mcp_handle_message(state: McpServerState, msg: LspJson) -> str {
    if msg.kind != "object" or lsp_json_str(msg, "jsonrpc", "") != "2.0" {
        return mcp_rpc_error("null", -32600, "invalid request")
    }
    let has_id = lsp_json_has(msg, "id")
    let id_val = lsp_json_get(msg, "id")
    if not has_id or id_val.kind == "null" {
        return ""
    }
    let id_raw = lsp_json_raw_literal(id_val)
    let method = lsp_json_str(msg, "method", "")
    let params = lsp_json_get(msg, "params")
    if method == "initialize" {
        let pv = lsp_json_str(params, "protocolVersion", "2025-06-18")
        return mcp_rpc_result(id_raw, "{\"protocolVersion\":" + diag_json_quote(pv) + (",\"capabilities\":{\"tools\":{}},\"serverInfo\":{\"name\":\"wysna\",\"version\":\"" + tool_compiler_version() + "\"}}"))
    }
    if method == "ping" {
        return mcp_rpc_result(id_raw, "{}")
    }
    if method == "tools/list" {
        return mcp_rpc_result(id_raw, mcp_tools_list_json())
    }
    if method == "tools/call" {
        return mcp_handle_tool_call(state, id_raw, params)
    }
    return mcp_rpc_error(id_raw, -32601, "method not found: " + method)
}

fn mcp_serve(args: list[str]) -> unit {
    let mut root_arg = ""
    let mut allow_exec = false
    let mut i = 1
    while i < len(args) {
        let a = args[i]
        if a == "--root" and i + 1 < len(args) and root_arg == "" {
            root_arg = args[i + 1]
            i = i + 2
        } elif a == "--allow-exec" {
            allow_exec = true
            i = i + 1
        } else {
            eprint("usage: wysna mcp [--root <dir>] [--allow-exec]")
            exit(2)
        }
    }
    let raw_root = if root_arg != "" { root_arg } else { mcp_getcwd() }
    let root = module_canonical_resolved(raw_root)
    if root == "" {
        eprint("wysna mcp: invalid root directory: " + raw_root)
        exit(2)
    }
    let driver_opt = env("WYSNA_SDK_DRIVER")
    let sdk_driver = match driver_opt { Some(d) => d, None => "" }
    let state = McpServerState(root, lsp_compiler_exe_path(), lsp_stdlib_root_arg(), lsp_tmp_dir(), allow_exec, sdk_driver)
    while true {
        let buf = wysna_host_buffer_new()
        let st = wysna_host_stdin_read_line(buf)
        if st <= 0 {
            wysna_host_close(buf)
            break
        }
        let line_len = lsp_buf_read_line_len(buf)
        let line = lsp_trim(lsp_buf_to_str(buf, line_len))
        wysna_host_close(buf)
        if line == "" { continue }
        let msg = mcp_parse_json_strict(line)
        if msg.kind == "error" {
            mcp_write_line(mcp_rpc_error("null", -32700, "parse error"))
            continue
        }
        let resp = mcp_handle_message(state, msg)
        if resp != "" { mcp_write_line(resp) }
    }
    exit(0)
}
