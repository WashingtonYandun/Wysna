# Generated by tools/generate_agent_contract.py; edit src/common/agent_contract.json.
fn tool_compiler_version() -> str { return "0.9.5" }
fn tool_language_version() -> str { return "0.9" }
fn tool_skills_available_topics() -> str { return "agent-loop, contracts, graph, overview, patch, project-tests, stdlib, syntax, workers" }
fn tool_skills_topic_content(topic: str) -> str {
    if topic == "agent-loop" { return "# Agent Coding Loop (Token-Efficient, Hash-Guarded)\n1. Discover relationships: `wysna graph <file.wysna> --output-format=json-v1`\n2. Inspect symbols within a byte budget: `wysna inspect <file.wysna> --symbols a,b --with-deps --max-bytes 2048 --output-format=json-v1` (follow `omitted[].ref` for truncated context)\n3. Submit checked single-symbol or multi-file edits (`source`, `symbol`, `hunks`, `create`, `delete`): `wysna patch --manifest wysna.toml --edits changes.json --expect-plan-hash <hash> --apply`\n4. Auto-repair mechanical diagnostics: `wysna fix --apply --output-format=json-v1 <file.wysna>`\n5. Decode any Wxxxx error: `wysna explain --code W2001 --output-format=json-v1`\n6. Verify via project check & tests (`wysna_project_check`, `wysna_project_test` in MCP or `wysna project test`)" }
    if topic == "contracts" { return "# Contracts, Schemas, Quotas & Trace Replay\n- Pre/postconditions: `fn f(x: int) -> int requires x > 0 ensures result >= 0 { ... }` (runtime `[W4005]`).\n- Tool Schema export: `wysna schema --emit-codecs --output-format=json-v1 <file.wysna>`.\n- Invoke a typed `@AgentTool(id: \"ops.lookup\", version: 1)`: `wysna schema <file.wysna> --function NAME --emit-tool -o adapter.wysna`.\n- Deterministic quotas: `--max-steps=<N>`, `--max-heap-mb=<N>` (fail-stop `[W4004]`).\n- Offline effect cassettes: `--record-trace <path>`, `--replay-trace <path>`.\n- Solo los errores recuperables usan `T ! E`; W4001–W4005 son traps, sin recuperación mediante `else err`.\n- JSON Schema exporta solo restricciones representables; los contratos generales requieren validación ejecutable.\n- Cuotas y replay cubren el runtime y efectos instrumentados; FFI y binarios nativos necesitan aislamiento del sistema operativo." }
    if topic == "graph" { return "# Semantic Relationship Graph (`wysna graph`)\n- `wysna graph <file> --output-format=json-v1`: full nodes, edges, `graph_hash`, `call_resolution`, and `analysis_boundaries`.\n- `--symbol <name> --rel implements`: find all classes implementing an interface (or vice-versa).\n- `--symbol <name> --rel usages`: find every class, function, field, and param using the type.\n- `--symbol <name> --rel callers|callees`: traverse the resolved call graph and inspect `uncertain_calls` (`indirect_call`, `virtual_dispatch`, `extern_ffi`).\n- `--symbol <name> --rel impact`: compute transitive blast radius before refactoring.\n- `wysna graph --manifest wysna.toml --role Controller --output-format=json-v1`: list typed architecture roles in the selected target." }
    if topic == "overview" { return "# Wysna v0.9.5 — Agent-First Native Language & Toolchain\n- Default workflow uses checked static inspection before execution.\n- Memory model: Atomic ARC + Copy-on-Write (`Weak[C]` breaks strong cycles); workers require closed callbacks and privately owned value graphs; classes and opaque handles cannot cross worker boundaries.\n- Error channel: Recoverable typed values `T ! E`; runtime traps terminate execution. Unwrap with `?` or `else err { fallback }`.\n- Core agent loop: `wysna skills` -> `wysna graph` -> `wysna inspect` -> `wysna patch` -> `wysna fix` -> `wysna check`.\n- Topics available: overview, agent-loop, syntax, graph, patch, project-tests, contracts, stdlib." }
    if topic == "patch" { return "# Checked Semantic Patching (`wysna patch`)\n- Dry-run check in memory (default): validates syntax, types, interface contracts, and configured project architecture rules before disk writes.\n- Optimistic locking: pass `--expect-graph-hash graph:...`; stale hashes fail with `[W5005]`.\n- Target classes, interfaces, structs, enums, functions, or `ClassName.method`.\n- Coordinated workspace edits (Seed & Native SDK): preview with `wysna patch --manifest wysna.toml --edits changes.json --output-format=json-v1`. Apply using `--apply --expect-plan-hash HASH`.\n- Para probar el candidato aislado, agrega `--test --output-format=json-v1`. Lee `result.test_verification` y `result.tests`. Aplica con `--test --apply --expect-plan-hash HASH`; las pruebas se ejecutan de nuevo antes de escribir. En MCP usa `test: true` con el servidor iniciado mediante `--allow-exec`." }
    if topic == "project-tests" { return "# Pruebas de proyecto para agentes\n1. Lista sin ejecutar: `wysna project test --discover --list --frozen --output-format=json-v1`.\n2. Usa los IDs exactos de result.cases: `--case test:example`; --filter conserva selección por subcadena.\n3. Ejecuta con `--expect-plan-hash <result.plan_hash> --output-format=json-v1 --report-json tests.json --report-junit tests.xml`.\n4. Lee result.cases[].failure_kind, diagnostics y los hashes de stdout/stderr; no interpretes texto de terminal.\n5. W5005 indica plan obsoleto: vuelve a listar. Una suite vacía devuelve 2; una cancelación devuelve 130.\n6. std/test ofrece igualdad genérica, tolerancia flotante, opcionales y fixture_directory(); los fixtures se eliminan después del caso.\nEl hash cubre manifiesto, lock, versión y entradas seleccionadas, no todos los imports. El SDK native-core-v1 ejecuta estos comandos sin Python.\n7. Dependencias: `wysna packages pack --manifest dependency/wysna.toml -o dependency.tar`; adquiere con `packages fetch --manifest wysna.toml --archive dependency.tar --sha256 <pin> --cache <cache>`, agrega con `packages add alias --path vendor/<pin>` y ejecuta `project lock`.\n8. Restaura con `packages restore --cache <cache>` y verifica con `project test --frozen`; todas las operaciones admiten `--output-format=json-v1`, sin hooks ni registro remoto.\n" }
    if topic == "stdlib" { return "# Standard Library (18 Modules)\n- Data & Text: `std/math`, `std/text`, `std/bytes`, `std/regex`, `std/collections`, `std/json`, `std/csv` (`parse`, `parse_records`, `stringify`), `std/parse`.\n- Systems & I/O: `std/fs`, `std/files`, `std/buffer`, `std/env`, `std/path`, `std/process`, `std/time`.\n- Network, Concurrency & Security: `std/http`, `std/async`, `std/algorithms` (`parallel_map`), `std/crypto`." }
    if topic == "syntax" { return "# Wysna Canonical Syntax Quick Reference\n- Bindings: `let x = 1` (immutable), `let mut y = 2` (mutable).\n- Functions: `fn add(a: int, b: int) -> int { return a + b }` (`pub` and `priv` at module scope and inside classes).\n- Control flow & logic: `if c { ... } elif d { ... } else { ... }` (`else if` also accepted); boolean operators are `and`, `or`, `not` (never `&&`, `||`, `!`).\n- Cooperative Async: `async fn fetch_id() -> int { ... }`, `let v = await task`.\n- Optionals & Errors: `T?`, `T ! E`, unwrap `?`, recover `expr else err { fallback }`.\n- OOP & Contracts: `interface Drawable { fn draw() -> str }`, `class Rect implements Drawable { pub fn draw() -> str { ... } }`.\n- Lambdas: `|n: int| => n * n` (capture outer variables by immutable snapshot by design; return updated values for mutable state; classes cannot cross worker boundaries).\n- Canonical forms: `Class(...)`, `None`, `_ =>`, parenthesized tuple patterns.\n- Match patterns: alternatives `1 | 2`, Int64 ranges `0..=10`, nested `Point { x, .. }`; W6003 reports unreachable arms.\n- Static attributes on top-level functions: `@deprecated(\"message\")` (W6004), `@must_use` (W6005); custom typed metadata: `struct ReviewTag { name: str }`, `@ReviewTag(name: \"lookup\")`; literal str/bool/int fields, no macros or evaluation.\n- Ranges & Loops: `for i in 0..10 { ... }`, inclusive `0..=10`.\n- Non-exhaustive match W2003 includes data.uncovered_pattern_families for checked repairs." }
    if topic == "workers" { return "# Workers con propiedad aislada\n- `std/algorithms.parallel_map`, `parallel_filter`, `parallel_batch` y el mapper de `parallel_reduce`, además de `std/async.spawn` y `run_group`, exigen callbacks comprobables.\n- Usa funciones nombradas o lambdas y alias inmutables. Solo escalares, strings y compuestos de valores transferibles; W2014 rechaza clases, interfaces, Weak, handles y datos función.\n- W2015 rechaza globals no capturados, efectos transitivos, FFI, scheduler, callbacks sin resolver y workers anidados. Captura valores explícitamente o pásalos como parámetros.\n- Entradas, capturas y resultados se copian como grafos privados. CoW dentro de cada worker; profundidad máxima de snapshot 256.\n- `parallel_reduce` mapea en paralelo y combina mediante fold izquierdo secuencial. El orden de resultados no promete orden de efectos.\n- `run_group` acota trabajo de CPU y devuelve resultados por índice. Usa `group_cancelled()` en callbacks largos. I/O cooperativo permanece en el scheduler." }
    return ""
}
fn tool_skills_payload_json(topic: str) -> str {
    return "{\"schema_version\":\"wysna.skills/1\",\"compiler_version\":\"0.9.5\",\"available_topics\":[\"agent-loop\",\"contracts\",\"graph\",\"overview\",\"patch\",\"project-tests\",\"stdlib\",\"syntax\",\"workers\"],\"topic\":" + diag_json_quote(topic) + ",\"content\":" + diag_json_quote(tool_skills_topic_content(topic)) + "}"
}
fn tool_capabilities_payload_json() -> str {
    return "{\"schema_version\":\"wysna.capabilities/1\",\"compiler_version\":\"0.9.5\",\"commands\":[\"run\",\"check\",\"fmt\",\"ast\",\"mir\",\"tokens\",\"emit-c\",\"emit-mir\",\"build\",\"test\",\"project.new\",\"project.lock\",\"project.check\",\"project.build\",\"project.run\",\"project.test\",\"packages.pack\",\"packages.fetch\",\"packages.add\",\"packages.remove\",\"packages.restore\",\"api\",\"capabilities\",\"explain\",\"graph\",\"inspect\",\"patch\",\"skills\",\"fix\",\"schema\",\"mcp\",\"lsp\"],\"machine_output\":{\"format\":\"json-v1\",\"commands\":[\"check\",\"fmt\",\"project.new\",\"project.lock\",\"project.check\",\"project.test\",\"packages.pack\",\"packages.fetch\",\"packages.add\",\"packages.remove\",\"packages.restore\",\"api\",\"capabilities\",\"explain\",\"graph\",\"inspect\",\"patch\",\"skills\",\"fix\",\"schema\"]},\"profiles\":[\"native-cli\",\"wasi-command\",\"browser-library\",\"c99-source\"],\"targets\":[\"native\",\"wasm32-wasip1\",\"wasm32-unknown-emscripten\"],\"runtimes\":{\"wasi-command\":\"wasmtime-python==50.0.1\",\"browser-library\":\"browser or Node.js\"},\"capabilities\":{\"native-cli\":[\"stdio\",\"filesystem\",\"environment\",\"processes\",\"network\",\"native-ffi\"],\"wasi-command\":[\"stdio\",\"arguments\",\"clock\",\"random\",\"manifest-declared-preopens\"],\"browser-library\":[\"linear-memory\",\"generated-utf8-abi\",\"bigint-int64\"]},\"target_profiles\":[{\"profile\":\"native-cli\",\"engine\":\"wysna-selfhost\",\"backend\":\"c99\",\"triple\":null,\"artifact_kind\":\"native_executable\",\"capabilities\":[\"stdio\",\"filesystem\",\"environment\",\"processes\",\"network\",\"native-ffi\"],\"build_requirements\":[{\"name\":\"c99-compiler\",\"version\":null,\"provided_by\":\"Host C99 toolchain\"}],\"run_requirements\":[{\"name\":\"host-operating-system\",\"version\":null,\"provided_by\":null}]},{\"profile\":\"wasi-command\",\"engine\":\"wysna-selfhost\",\"backend\":\"c99\",\"triple\":\"wasm32-wasip1\",\"artifact_kind\":\"wasm_module\",\"capabilities\":[\"stdio\",\"arguments\",\"clock\",\"random\",\"runner-declared-preopens\"],\"build_requirements\":[{\"name\":\"zig\",\"version\":\"0.15.2\",\"provided_by\":\"Native SDK\"}],\"run_requirements\":[{\"name\":\"wasmtime-python\",\"version\":\"50.0.1\",\"provided_by\":null}]},{\"profile\":\"browser-library\",\"engine\":\"wysna-seed\",\"backend\":\"c99\",\"triple\":\"wasm32-unknown-emscripten\",\"artifact_kind\":\"wasm_module\",\"capabilities\":[\"linear-memory\",\"generated-utf8-abi\",\"bigint-int64\"],\"build_requirements\":[{\"name\":\"emscripten\",\"version\":\"5.0.1\",\"provided_by\":null}],\"run_requirements\":[{\"name\":\"browser-or-nodejs\",\"version\":null,\"provided_by\":null}]}],\"requirements\":{\"std/http\":{\"interpreter\":\"install wysna[http] with libcurl 8.3.0 or newer\",\"native\":\"install libcurl 8.3.0 or newer development files and expose curl-config on PATH\",\"wasi-command\":\"unavailable\",\"browser-library\":\"unavailable\"}},\"limitations\":[\"native-cli capabilities describe host access and are not a sandbox\",\"WASI Preview 1 does not provide networking, child processes, or native FFI\",\"The Native SDK builds standalone WASI commands; use Seed for WASI projects and execution\",\"browser-library exposes only generated scalar and UTF-8 exports; WVal and pointers remain internal\",\"dependencies use local paths or SHA-256-pinned offline USTAR archives; no remote version resolution or public registry\",\"project lockfiles do not claim bit-for-bit binary reproducibility\",\"CPU workers reject host effects, uncaptured globals, classes, Weak and opaque handles\",\"worker snapshots copy full value graphs; boundary transfer is not constant-time\"],\"worker_safety\":{\"contract\":\"closed-callback-v1\",\"ownership\":\"private-value-graphs\",\"diagnostics\":[\"W2014\",\"W2015\"],\"snapshots\":[\"inputs\",\"captures\",\"results\"],\"maximum_snapshot_depth\":256,\"nested_workers\":false,\"shared_mutable_objects\":false,\"unknown_callbacks\":\"rejected\",\"parallel_reduce\":\"parallel-map-sequential-left-fold\",\"task_groups\":true,\"public_cancellation\":true}}"
}
