fn snapshot_callee(emitter: CEmitter, callee: ExprRes, collection: bool) -> ExprRes {
    if is_bound_variable(emitter, callee.val) { return ExprRes { val: snapshot_value(emitter, callee.val), lref: "" } }
    let raw = callee.lref
    let mut separators: list[int] = []
    let mut skip = -1
    for i in 0..len(raw) - 1 {
        if i > skip and slice(raw, i, i + 2) == "::" {
            separators.append(i)
            skip = i + 1
        }
    }
    if len(separators) < 3 { return callee }
    let method = slice(raw, separators[0] + 2, separators[1])
    let receiver = slice(raw, separators[2] + 2, len(raw))
    if (collection and (method == "append" or method == "pop" or method == "clear")) or receiver == "v_super" { return callee }
    let held = snapshot_value(emitter, receiver)
    return ExprRes { val: callee.val, lref: slice(raw, 0, separators[2] + 2) + held }
}

fn projection_is_mutated(emitter: CEmitter) -> bool {
    let mut offset = 0
    while true {
        let kind = peek_tok(emitter, offset).kind
        if kind == "ASSIGN" { return true }
        if kind == "DOT" {
            let method = peek_tok(emitter, offset + 1).val
            if peek_tok(emitter, offset + 2).kind == "LPAREN" {
                return method == "append" or method == "pop" or method == "clear"
            }
            offset = offset + 2
        } elif kind == "LBRACKET" {
            let mut depth = 1
            offset = offset + 1
            while depth > 0 and peek_tok(emitter, offset).kind != "EOF" {
                if peek_tok(emitter, offset).kind == "LBRACKET" { depth = depth + 1 }
                if peek_tok(emitter, offset).kind == "RBRACKET" { depth = depth - 1 }
                offset = offset + 1
            }
        } else { return false }
    }
    return false
}


fn emit_call(emitter: CEmitter, callee: ExprRes, args_c: list[str], collection: bool, file: str, line: int, col: int) -> ExprRes {
    if len(callee.val) >= 6 and slice(callee.val, 0, 6) == "enum::" {
        let marker = slice(callee.val, 6, len(callee.val))
        let mut separator = -1
        for i in 0..len(marker) - 1 { if slice(marker, i, i + 2) == "::" { separator = i } }
        if separator < 0 { report_error(at_tok(emitter).file, "W9999", at_tok(emitter).line, at_tok(emitter).col, "invalid enum constructor marker") }
        let owner = slice(marker, 0, separator)
        let variant = slice(marker, separator + 2, len(marker))
        if owner == "Option" and variant == "Some" {
            if len(args_c) != 1 { report_error(at_tok(emitter).file, "W2005", at_tok(emitter).line, at_tok(emitter).col, "Option.Some arity") }
            return bind_call(emitter, "wysna_enum_payload(\"Option\", \"Some\", " + own_expr(args_c[0]) + ")")
        }
        if owner == "Result" and variant == "Ok" {
            if len(args_c) != 1 { report_error(at_tok(emitter).file, "W2005", at_tok(emitter).line, at_tok(emitter).col, "Result.Ok arity") }
            return bind_call(emitter, "wysna_ok(" + own_expr(args_c[0]) + ")")
        }
        if owner == "Result" and variant == "Err" {
            if len(args_c) != 1 { report_error(at_tok(emitter).file, "W2005", at_tok(emitter).line, at_tok(emitter).col, "Result.Err arity") }
            return bind_call(emitter, "wysna_err(" + own_expr(args_c[0]) + ")")
        }
        let mut arity = -1
        for i in 0..len(emitter.enum_variant_names) {
            if emitter.enum_variant_names[i] == variant and emitter.enum_variant_owners[i] == owner { arity = emitter.enum_variant_arities[i] }
        }
        if arity != len(args_c) { report_error(at_tok(emitter).file, "W2005", at_tok(emitter).line, at_tok(emitter).col, "enum constructor arity: " + owner + "." + variant) }
        if arity == 0 { return bind_call(emitter, "wysna_enum(\"" + owner + "\", \"" + variant + "\")") }
        if arity == 1 { return bind_call(emitter, "wysna_enum_payload(\"" + owner + "\", \"" + variant + "\", " + own_expr(args_c[0]) + ")") }
        let payload_values = new_aux(emitter, "_enum_values")
        let mut values = ""
        for i in 0..len(args_c) {
            if i > 0 { values = values + ", " }
            values = values + args_c[i]
        }
        emit_line(emitter, "WVal " + payload_values + "[" + str(len(args_c)) + "] = { " + values + " };")
        let payload = "wysna_make_tuple(" + str(len(args_c)) + ", " + payload_values + ")"
        return bind_call(emitter, "wysna_enum_payload(\"" + owner + "\", \"" + variant + "\", " + payload + ")")
    }
    if is_bound_variable(emitter, callee.val) or (callee.lref == "" and not (len(callee.val) >= 2 and slice(callee.val, 0, 2) == "v_")) {
        return emit_indirect_call(emitter, callee.val, args_c)
    }
    let raw = callee.lref
    let n = len(raw)
    let mut s1 = -1
    let mut s2 = -1
    let mut s3 = -1
    let mut skip = -1
    if n >= 2 {
        for i in 0..n - 1 {
            if i > skip and slice(raw, i, i + 2) == "::" {
                skip = i + 1
                if s1 == -1 {
                    s1 = i
                } elif s2 == -1 {
                    s2 = i
                } else {
                    s3 = i
                    break
                }
            }
        }
    }
    if s1 != -1 and s2 != -1 and s3 != -1 {
        let method = slice(raw, s1 + 2, s2)
        let recv_lref = clean_lref(slice(raw, s2 + 2, s3))
        let recv_val = slice(raw, s3 + 2, n)
        if recv_val == "v_super" {
            let def_cls = find_class_method_owner(emitter, emitter.cur_super, method)
            if def_cls != "" {
                let mut joined = "v_self"
                for idx in 0..len(args_c) {
                    joined = joined + ", " + args_c[idx]
                }
                return bind_call(emitter, "wysna_method_" + def_cls + "__" + method + "(" + joined + ")")
            }
            report_error_at("W9999", at_tok(emitter), "missing checked superclass method")
            return ExprRes { val: "wysna_unit()", lref: "" }
        }
        if collection and method == "append" {
            return bind_call(emitter, "wysna_list_append(" + recv_lref + ", " + args_c[0] + ")")
        }
        if collection and method == "pop" {
            return bind_call(emitter, "wysna_list_pop_at(" + recv_lref + ", " + escape_c_str(file) + ", " + str(line) + ", " + str(col) + ")")
        }
        if collection and method == "clear" {
            return bind_call(emitter, "wysna_list_clear(" + recv_lref + ")")
        }
        if collection and method == "get" {
            return bind_call(emitter, "wysna_dict_get(" + recv_val + ", " + args_c[0] + ")")
        }
        if collection and method == "keys" {
            return bind_call(emitter, "wysna_dict_keys(" + recv_val + ")")
        }
        if collection and method == "values" {
            return bind_call(emitter, "wysna_dict_values(" + recv_val + ")")
        }
        let mut d_args = recv_val
        for idx in 0..len(args_c) {
            d_args = d_args + ", " + args_c[idx]
        }
        return bind_call(emitter, "wysna_dispatch__" + method + "__" + str(len(args_c)) + "(" + d_args + ")")
    }
    if len(callee.val) >= 2 and slice(callee.val, 0, 2) == "v_" {
        let fn_name = slice(callee.val, 2, len(callee.val))
        if fn_name == "weak" or fn_name == "upgrade" {
            if len(args_c) != 1 { report_error(at_tok(emitter).file, "W2005", at_tok(emitter).line, at_tok(emitter).col, "weak/upgrade expects one argument") }
            if fn_name == "weak" {
                return bind_call(emitter, "wysna_builtin_weak_owned(" + own_expr(args_c[0]) + ")")
            }
            return bind_call(emitter, "wysna_builtin_" + fn_name + "(" + args_c[0] + ")")
        }
        if fn_name == "Ok" and len(args_c) == 1 {
            return bind_call(emitter, "wysna_ok(" + own_expr(args_c[0]) + ")")
        }
        if fn_name == "Err" and len(args_c) == 1 {
            return bind_call(emitter, "wysna_err(" + own_expr(args_c[0]) + ")")
        }
        if fn_name == "Some" and len(args_c) == 1 {
            return bind_call(emitter, "wysna_enum_payload(\"Option\", \"Some\", " + own_expr(args_c[0]) + ")")
        }
        if fn_name == "print" {
            if len(args_c) == 0 {
                return bind_call(emitter, "wysna_builtin_print(0, NULL)")
            }
            let arr_tmp = new_aux(emitter, "_arr")
            let mut joined = ""
            for idx in 0..len(args_c) {
                if idx > 0 {
                    joined = joined + ", "
                }
                joined = joined + args_c[idx]
            }
            let cnt = str(len(args_c))
            emit_line(emitter, "WVal " + arr_tmp + "[" + cnt + "] = { " + joined + " };")
            return bind_call(emitter, "wysna_builtin_print(" + cnt + ", " + arr_tmp + ")")
        }
        if fn_name == "eprint" {
            if len(args_c) == 0 {
                return bind_call(emitter, "wysna_builtin_eprint(0, NULL)")
            }
            let arr_tmp = new_aux(emitter, "_arr")
            let mut joined = ""
            for idx in 0..len(args_c) {
                if idx > 0 {
                    joined = joined + ", "
                }
                joined = joined + args_c[idx]
            }
            let cnt = str(len(args_c))
            emit_line(emitter, "WVal " + arr_tmp + "[" + cnt + "] = { " + joined + " };")
            return bind_call(emitter, "wysna_builtin_eprint(" + cnt + ", " + arr_tmp + ")")
        }
        if fn_name == "exit" and len(args_c) == 1 {
            return bind_call(emitter, "wysna_builtin_exit(" + args_c[0] + ")")
        }
        if fn_name == "join_strings" { return bind_call(emitter, "wysna_builtin_join_strings(" + args_c[0] + ", " + args_c[1] + ")") }
        if fn_name == "len" {
            return bind_call(emitter, "wysna_builtin_len(" + args_c[0] + ")")
        }
        if fn_name == "str" {
            return bind_call(emitter, "wysna_builtin_str(" + args_c[0] + ")")
        }
        if fn_name == "int" {
            return bind_call(emitter, "wysna_builtin_int(" + args_c[0] + ")")
        }
        if fn_name == "float" {
            return bind_call(emitter, "wysna_builtin_float(" + args_c[0] + ")")
        }
        if fn_name == "ord" {
            return bind_call(emitter, "wysna_builtin_ord(" + args_c[0] + ")")
        }
        if fn_name == "chr" {
            return bind_call(emitter, "wysna_builtin_chr(" + args_c[0] + ")")
        }
        if fn_name == "bytes" {
            return bind_call(emitter, "wysna_builtin_bytes(" + args_c[0] + ")")
        }
        if fn_name == "enumerate" {
            return bind_call(emitter, "wysna_builtin_enumerate(" + args_c[0] + ")")
        }
        if fn_name == "dict_items" {
            return bind_call(emitter, "wysna_builtin_dict_items(" + args_c[0] + ")")
        }
        if fn_name == "read_file" {
            return bind_call(emitter, "wysna_builtin_read_file(" + args_c[0] + ")")
        }
        if fn_name == "write_file" {
            return bind_call(emitter, "wysna_builtin_write_file(" + args_c[0] + ", " + args_c[1] + ")")
        }
        if fn_name == "slice" {
            return bind_call(emitter, "wysna_builtin_slice(" + args_c[0] + ", " + args_c[1] + ", " + args_c[2] + ")")
        }
        if fn_name == "args" {
            return bind_call(emitter, "wysna_builtin_args()")
        }
        let mut joined = ""
        for idx in 0..len(args_c) {
            if idx > 0 {
                joined = joined + ", "
            }
            joined = joined + args_c[idx]
        }
        if find_class_meta_idx(emitter, fn_name) != -1 {
            return bind_call(emitter, "wysna_new_" + fn_name + "(" + joined + ")")
        }
        let generic_type = checked_generic_type(emitter.checked, fn_name)
        if generic_type >= 0 and emitter.checked.c99.generic_types[generic_type].kind == "struct" { return emit_struct_constructor(emitter, fn_name, args_c) }
        return bind_call(emitter, c_fn_name(fn_name) + "(" + joined + ")")
    }
    return ExprRes { val: "wysna_unit()", lref: "" }
}

fn parse_block_expr(emitter: CEmitter) -> str {
    expect_kind(emitter, "LBRACE")
    let res = new_temp(emitter)
    declare_owned_var(emitter, res, "wysna_unit()")
    emit_line(emitter, "{")
    let saved = emitter.cur_stmts
    let empty: list[str] = []
    emitter.cur_stmts = empty
    push_scope(emitter, "block")
    let mut tail_val = "wysna_unit()"
    while not check_kind(emitter, "RBRACE") and not is_eof(emitter) {
        skip_statement_separators(emitter)
        if check_kind(emitter, "RBRACE") or is_eof(emitter) { break }
        if check_kind(emitter, "LET") {
            parse_let_stmt(emitter, false)
            tail_val = "wysna_unit()"
        } elif check_kind(emitter, "WHILE") {
            parse_while_stmt(emitter)
            tail_val = "wysna_unit()"
        } elif check_kind(emitter, "FOR") {
            parse_for_stmt(emitter)
            tail_val = "wysna_unit()"
        } elif check_kind(emitter, "RETURN") {
            parse_return_stmt(emitter)
            tail_val = "wysna_unit()"
        } elif check_kind(emitter, "BREAK") {
            advance_tok(emitter)
            emit_cleanup_until_loop(emitter)
            emit_line(emitter, "break;")
            tail_val = "wysna_unit()"
        } elif check_kind(emitter, "CONTINUE") {
            advance_tok(emitter)
            emit_cleanup_until_loop(emitter)
            emit_line(emitter, "continue;")
            tail_val = "wysna_unit()"
        } else {
            let expr_r = parse_expr(emitter, 0, true)
            skip_statement_separators(emitter)
            if check_kind(emitter, "RBRACE") {
                tail_val = expr_r.val
            } else {
                emit_line(emitter, "(void)" + expr_r.val + ";")
                tail_val = "wysna_unit()"
            }
        }
    }
    expect_kind(emitter, "RBRACE")
    if tail_val != "wysna_unit()" {
        emit_line(emitter, "wysna_assign(&" + res + ", " + own_expr(tail_val) + ");")
    }
    pop_scope(emitter)
    let inner = emitter.cur_stmts
    emitter.cur_stmts = saved
    for l in inner {
        emit_line(emitter, "    " + l)
    }
    emit_line(emitter, "}")
    return res
}

fn parse_if_expr(emitter: CEmitter) -> ExprRes {
    expect_kind(emitter, "IF")
    let res = new_temp(emitter)
    declare_owned_var(emitter, res, "wysna_unit()")
    let cond_r = parse_expr(emitter, 0, false)
    emit_line(emitter, "if ((" + cond_r.val + ").as.b) {")
    push_scope(emitter, "block")
    let saved = emitter.cur_stmts
    let empty: list[str] = []
    emitter.cur_stmts = empty
    let then_v = parse_block_expr(emitter)
    emit_line(emitter, "wysna_assign(&" + res + ", " + own_expr(then_v) + ");")
    pop_scope(emitter)
    let then_lines = emitter.cur_stmts
    emitter.cur_stmts = saved
    for l in then_lines {
        emit_line(emitter, "    " + l)
    }
    emit_line(emitter, "}")
    parse_elif_chain(emitter, res)
    return ExprRes { val: res, lref: "" }
}

fn parse_elif_chain(emitter: CEmitter, res: str) -> unit {
    skip_newlines_before_branch(emitter)
    if match_kind(emitter, "ELIF") {
        emit_line(emitter, "else {")
        push_scope(emitter, "block")
        let saved = emitter.cur_stmts
        let empty: list[str] = []
        emitter.cur_stmts = empty
        let eb_cond = parse_expr(emitter, 0, false)
        emit_line(emitter, "if ((" + eb_cond.val + ").as.b) {")
        push_scope(emitter, "block")
        let saved_inner = emitter.cur_stmts
        let empty2: list[str] = []
        emitter.cur_stmts = empty2
        let eb_v = parse_block_expr(emitter)
        emit_line(emitter, "wysna_assign(&" + res + ", " + own_expr(eb_v) + ");")
        pop_scope(emitter)
        let eb_lines = emitter.cur_stmts
        emitter.cur_stmts = saved_inner
        for l in eb_lines {
            emit_line(emitter, "    " + l)
        }
        emit_line(emitter, "}")
        parse_elif_chain(emitter, res)
        pop_scope(emitter)
        let outer_lines = emitter.cur_stmts
        emitter.cur_stmts = saved
        for l in outer_lines {
            emit_line(emitter, "    " + l)
        }
        emit_line(emitter, "}")
    } elif match_kind(emitter, "ELSE") {
        emit_line(emitter, "else {")
        push_scope(emitter, "block")
        let saved = emitter.cur_stmts
        let empty: list[str] = []
        emitter.cur_stmts = empty
        let else_v = parse_block_expr(emitter)
        emit_line(emitter, "wysna_assign(&" + res + ", " + own_expr(else_v) + ");")
        pop_scope(emitter)
        let else_lines = emitter.cur_stmts
        emitter.cur_stmts = saved
        for l in else_lines {
            emit_line(emitter, "    " + l)
        }
        emit_line(emitter, "}")
    }
}

fn parse_match_expr(emitter: CEmitter) -> ExprRes {
    expect_kind(emitter, "MATCH")
    let subj_r = parse_expr(emitter, 0, false)
    let subj_tmp = new_temp(emitter)
    declare_owned_var(emitter, subj_tmp, own_expr(subj_r.val))
    let res = new_temp(emitter)
    declare_owned_var(emitter, res, "wysna_unit()")
    expect_kind(emitter, "LBRACE")
    if not check_kind(emitter, "RBRACE") {
        parse_match_arms(emitter, subj_tmp, res)
    }
    expect_kind(emitter, "RBRACE")
    return ExprRes { val: res, lref: "" }
}

fn parse_pattern_condition(emitter: CEmitter, subject: str) -> str {
    if match_kind(emitter, "LPAREN") {
        let mut index = 0
        let mut condition = "true"
        if not check_kind(emitter, "RPAREN") {
            while true {
                let element = "(" + subject + ").as.tuple->items[" + str(index) + "]"
                let child = parse_pattern_condition(emitter, element)
                condition = "(" + condition + ") && (" + child + ")"
                index = index + 1
                if not match_kind(emitter, "COMMA") or check_kind(emitter, "RPAREN") { break }
            }
        }
        expect_kind(emitter, "RPAREN")
        return "(" + subject + ").tag == W_TUPLE && (" + subject + ").as.tuple->len == " + str(index) + " && (" + condition + ")"
    }
    let pattern_position = emitter.pos + 1
    let mut error_pattern_kind = ""
    let mut error_pattern_name = ""
    for i in 0..len(emitter.checked.c99.error_pattern_positions) {
        if emitter.checked.c99.error_pattern_positions[i] == pattern_position {
            error_pattern_kind = emitter.checked.c99.error_pattern_kinds[i]
            error_pattern_name = emitter.checked.c99.error_pattern_names[i]
        }
    }
    if error_pattern_kind != "" {
        expect_kind(emitter, "IDENT")
        expect_kind(emitter, "LPAREN")
        let mut condition = "wysna_value_is_error_type(" + subject + ", " + escape_c_str(error_pattern_kind) + ", " + escape_c_str(error_pattern_name) + ")"
        if not check_kind(emitter, "RPAREN") {
            let child = parse_pattern_condition(emitter, subject)
            condition = "(" + condition + ") && (" + child + ")"
        }
        expect_kind(emitter, "RPAREN")
        return condition
    }
    if match_kind(emitter, "ELSE") { return "true" }
    if match_kind(emitter, "NONE") { return "wysna_is_none(" + subject + ")" }
    if check_kind(emitter, "MINUS") {
        let literal = parse_prefix_expr(emitter, false)
        return "wysna_eq(" + subject + ", " + literal.val + ")"
    }
    if check_kind(emitter, "INT") or check_kind(emitter, "FLOAT") or check_kind(emitter, "STR") or check_kind(emitter, "TRUE") or check_kind(emitter, "FALSE") {
        let literal = parse_prefix_expr(emitter, false)
        return "wysna_eq(" + subject + ", " + literal.val + ")"
    }
    let name = expect_kind(emitter, "IDENT").val
    if name == "_" { return "true" }
    let mut owner = ""
    let mut variant = name
    if match_kind(emitter, "DOT") {
        owner = name
        variant = expect_kind(emitter, "IDENT").val
    }
    let mut enum_owner = owner
    let mut arity = -1
    if owner == "Option" and variant == "None" { return "wysna_is_none(" + subject + ")" }
    if (owner == "Option" or owner == "") and variant == "Some" { arity = 1 enum_owner = "Option" }
    if (owner == "Result" or owner == "") and (variant == "Ok" or variant == "Err") { arity = 1 enum_owner = "Result" }
    if arity < 0 {
        for i in 0..len(emitter.enum_variant_names) {
            if emitter.enum_variant_names[i] == variant and (owner == "" or emitter.enum_variant_owners[i] == owner) {
                arity = emitter.enum_variant_arities[i]
                enum_owner = emitter.enum_variant_owners[i]
            }
        }
    }
    if arity >= 0 {
        let mut condition = "true"
        if enum_owner == "Option" and variant == "Some" { condition = "!wysna_is_none(" + subject + ")" }
        elif enum_owner == "Result" and variant == "Ok" { condition = "(" + subject + ").tag == W_OK" }
        elif enum_owner == "Result" and variant == "Err" { condition = "(" + subject + ").tag == W_ERR" }
        else { condition = "wysna_is_enum_variant(" + subject + ", \"" + enum_owner + "\", \"" + variant + "\")" }
        if match_kind(emitter, "LPAREN") {
            let mut index = 0
            if not check_kind(emitter, "RPAREN") {
                let mut payload = "wysna_peek_enum_payload(" + subject + ")"
                if enum_owner == "Option" { payload = "wysna_peek_optional(" + subject + ")" }
                elif enum_owner == "Result" and variant == "Ok" { payload = "wysna_peek_ok(" + subject + ")" }
                elif enum_owner == "Result" and variant == "Err" { payload = "wysna_peek_err(" + subject + ")" }
                if arity > 1 { payload = "(" + payload + ").as.tuple->items[0]" }
                let child = parse_pattern_condition(emitter, payload)
                condition = "(" + condition + ") && (" + child + ")"
                index = 1
                while match_kind(emitter, "COMMA") {
                    if check_kind(emitter, "RPAREN") { break }
                    if index >= arity { report_error(at_tok(emitter).file, "W2001", at_tok(emitter).line, at_tok(emitter).col, "too many enum pattern elements") }
                    let mut next_payload = "wysna_peek_enum_payload(" + subject + ")"
                    if enum_owner == "Option" { next_payload = "wysna_peek_optional(" + subject + ")" }
                    elif enum_owner == "Result" and variant == "Ok" { next_payload = "wysna_peek_ok(" + subject + ")" }
                    elif enum_owner == "Result" and variant == "Err" { next_payload = "wysna_peek_err(" + subject + ")" }
                    next_payload = "(" + next_payload + ").as.tuple->items[" + str(index) + "]"
                    let next_condition = parse_pattern_condition(emitter, next_payload)
                    condition = "(" + condition + ") && (" + next_condition + ")"
                    index = index + 1
                }
            }
            expect_kind(emitter, "RPAREN")
            if index != arity { report_error(at_tok(emitter).file, "W2001", at_tok(emitter).line, at_tok(emitter).col, "enum pattern arity") }
        } elif arity != 0 {
            report_error(at_tok(emitter).file, "W2005", at_tok(emitter).line, at_tok(emitter).col, "enum pattern requires payload")
        }
        return condition
    }
    if owner != "" { return "wysna_is_enum_variant(" + subject + ", \"" + owner + "\", \"" + variant + "\")" }
    emitter.pattern_bind_lines.append("WVal v_" + name + " = wysna_clone(" + subject + ");")
    emitter.pattern_bind_names.append("v_" + name)
    return "true"
}

fn parse_match_arms(emitter: CEmitter, subj_tmp: str, res: str) -> unit {
    let matched = new_aux(emitter, "_match_taken")
    emit_line(emitter, "bool " + matched + " = false;")
    while not check_kind(emitter, "RBRACE") and not is_eof(emitter) {
        skip_statement_separators(emitter)
        if check_kind(emitter, "RBRACE") or is_eof(emitter) { break }
        let empty_bindings: list[str] = []
        emitter.pattern_bind_lines = empty_bindings
        emitter.pattern_bind_names = empty_bindings
        let condition = parse_pattern_condition(emitter, subj_tmp)
        emit_line(emitter, "if (!" + matched + " && (" + condition + ")) {")
        push_scope(emitter, "block")
        for binding in emitter.pattern_bind_lines { emit_line(emitter, binding) }
        for binding_name in emitter.pattern_bind_names { register_var(emitter, binding_name) }
        let has_guard = match_kind(emitter, "IF")
        if has_guard {
            let guard = parse_expr(emitter, 0, false)
            emit_line(emitter, "if ((" + guard.val + ").as.b) {")
            push_scope(emitter, "block")
        }
        expect_kind(emitter, "FAT_ARROW")
        if check_kind(emitter, "LBRACE") {
            let arm_value = parse_block_expr(emitter)
            emit_line(emitter, "wysna_assign(&" + res + ", " + own_expr(arm_value) + ");")
        } else {
            let arm_value = parse_expr(emitter, 0, true)
            skip_statement_separators(emitter)
            emit_line(emitter, "wysna_assign(&" + res + ", " + own_expr(arm_value.val) + ");")
        }
        emit_line(emitter, matched + " = true;")
        if has_guard { pop_scope(emitter) emit_line(emitter, "}") }
        pop_scope(emitter)
        emit_line(emitter, "}")
        match_kind(emitter, "COMMA")
    }
}

fn parse_prefix_expr(emitter: CEmitter, allow_struct: bool) -> ExprRes {
    let tok = at_tok(emitter)
    if check_kind(emitter, "PIPE") { return parse_lambda(emitter) }
    if match_kind(emitter, "INT") {
        return ExprRes { val: "wysna_int(" + tok.val + "LL)", lref: "" }
    }
    if match_kind(emitter, "FLOAT") {
        return ExprRes { val: "wysna_float(" + tok.val + ")", lref: "" }
    }
    if match_kind(emitter, "STR") {
        if len(tok.val) <= 1 {
            return ExprRes { val: "wysna_str_n(" + escape_c_str(tok.val) + ", " + str(len(bytes(tok.val))) + ")", lref: "" }
        }
        let literal = new_aux(emitter, "_literal")
        emit_line(emitter, "static WStringLiteral " + literal + " = {0};")
        return ExprRes { val: "wysna_literal_str_n(&" + literal + ", " + escape_c_str(tok.val) + ", " + str(len(bytes(tok.val))) + ")", lref: "" }
    }
    if match_kind(emitter, "TRUE") {
        return ExprRes { val: "wysna_bool(true)", lref: "" }
    }
    if match_kind(emitter, "FALSE") {
        return ExprRes { val: "wysna_bool(false)", lref: "" }
    }
    if match_kind(emitter, "NONE") {
        return ExprRes { val: "wysna_none()", lref: "" }
    }
    if match_kind(emitter, "THIS") {
        return ExprRes { val: "v_self", lref: "&v_self" }
    }
    if match_kind(emitter, "SUPER") {
        return ExprRes { val: "v_super", lref: "&v_super" }
    }
    if match_kind(emitter, "NEW") {
        let cname_tok = expect_kind(emitter, "IDENT")
        expect_kind(emitter, "LPAREN")
        let mut args_c: list[str] = []
        if not check_kind(emitter, "RPAREN") {
            let a0 = parse_expr(emitter, 0, true)
            args_c.append(snapshot_value(emitter, a0.val))
            while match_kind(emitter, "COMMA") {
                if check_kind(emitter, "RPAREN") {
                    break
                }
                let an = parse_expr(emitter, 0, true)
                args_c.append(snapshot_value(emitter, an.val))
            }
        }
        expect_kind(emitter, "RPAREN")
        let mut joined = ""
        for idx in 0..len(args_c) {
            if idx > 0 {
                joined = joined + ", "
            }
            joined = joined + args_c[idx]
        }
        return bind_call(emitter, "wysna_new_" + cname_tok.val + "(" + joined + ")")
    }
    if match_kind(emitter, "IDENT") {
        let name = tok.val
        if name == "None" and not is_bound_variable(emitter, "v_" + name) { return ExprRes { val: "wysna_none()", lref: "" } }
        let function_index = checked_function(emitter.checked, name)
        if function_index >= 0 and not is_bound_variable(emitter, "v_" + name) and len(emitter.checked.signatures[function_index].type_params) > 0 and match_kind(emitter, "LBRACKET") {
            while not check_kind(emitter, "RBRACKET") and not is_eof(emitter) {
                parse_type_ann(emitter)
                if not match_kind(emitter, "COMMA") { break }
            }
            expect_kind(emitter, "RBRACKET")
        }
        let generic_type = checked_generic_type(emitter.checked, name)
        if generic_type >= 0 and not is_bound_variable(emitter, "v_" + name) and match_kind(emitter, "LBRACKET") {
            while not check_kind(emitter, "RBRACKET") and not is_eof(emitter) {
                parse_type_ann(emitter)
                if not match_kind(emitter, "COMMA") { break }
            }
            expect_kind(emitter, "RBRACKET")
        }
        if allow_struct and check_kind(emitter, "LBRACE") {
            let p1 = peek_tok(emitter, 1)
            let p2 = peek_tok(emitter, 2)
            if p1.kind == "RBRACE" or p1.kind == "IDENT" and p2.kind == "COLON" {
                advance_tok(emitter)
                let mut f_names: list[str] = []
                let mut f_vals: list[str] = []
                while not check_kind(emitter, "RBRACE") and not is_eof(emitter) {
                    skip_statement_separators(emitter)
                    if check_kind(emitter, "RBRACE") or is_eof(emitter) { break }
                    let f_tok = expect_kind(emitter, "IDENT")
                    expect_kind(emitter, "COLON")
                    let f_v = parse_expr(emitter, 0, true)
                    f_names.append("\"" + f_tok.val + "\"")
                    f_vals.append(snapshot_value(emitter, f_v.val))
                    match_kind(emitter, "COMMA")
                }
                expect_kind(emitter, "RBRACE")
                if len(f_names) == 0 {
                    return bind_call(emitter, "wysna_make_struct(\"" + name + "\", 0, NULL, NULL)")
                }
                let mut ordered_names: list[str] = []
                let mut ordered_values: list[str] = []
                for field in emitter.checked.c99.fields {
                    if field.owner == name {
                        let key = "\"" + field.name + "\""
                        for index in 0..len(f_names) {
                            if f_names[index] == key {
                                ordered_names.append(key)
                                ordered_values.append(f_vals[index])
                            }
                        }
                    }
                }
                f_names = ordered_names
                f_vals = ordered_values
                let k_tmp = new_aux(emitter, "_k")
                let v_tmp = new_aux(emitter, "_v")
                let mut k_joined = ""
                let mut v_joined = ""
                for idx in 0..len(f_names) {
                    if idx > 0 {
                        k_joined = k_joined + ", "
                        v_joined = v_joined + ", "
                    }
                    k_joined = k_joined + f_names[idx]
                    v_joined = v_joined + f_vals[idx]
                }
                let cnt = str(len(f_names))
                emit_line(emitter, "const char* " + k_tmp + "[" + cnt + "] = { " + k_joined + " };")
                emit_line(emitter, "WVal " + v_tmp + "[" + cnt + "] = { " + v_joined + " };")
                return bind_call(emitter, "wysna_make_struct(\"" + name + "\", " + cnt + ", " + k_tmp + ", " + v_tmp + ")")
            }
        }
        if not check_kind(emitter, "LPAREN") and not is_bound_variable(emitter, "v_" + name) and checked_function(emitter.checked, name) >= 0 {
            return emit_function_value(emitter, name)
        }
        if not is_bound_variable(emitter, "v_" + name) {
            let mut variant_owner = ""
            let mut variant_arity = -1
            for variant_index in 0..len(emitter.enum_variant_names) {
                if emitter.enum_variant_names[variant_index] == name {
                    variant_owner = emitter.enum_variant_owners[variant_index]
                    variant_arity = emitter.enum_variant_arities[variant_index]
                }
            }
            if variant_arity == 0 { return ExprRes { val: "wysna_enum(\"" + variant_owner + "\", \"" + name + "\")", lref: "" } }
            if variant_arity > 0 { return ExprRes { val: "enum::" + variant_owner + "::" + name, lref: "" } }
        }
        return ExprRes { val: "v_" + name, lref: "&v_" + name }
    }
    if match_kind(emitter, "MINUS") {
        # SPEC 5 puts unary at level 3, tighter than multiplicative (level 4), so the
        # operand stops below `* / %`. A literal operand folds into a negative constant
        # so negated whole-number literals emit identically to Wysna Seed's C99 backend, which
        # is what keeps the three-stage bootstrap hash a fixed point.
        if check_kind(emitter, "INT") {
            let mut lit = advance_tok(emitter).val
            let digits = slice(lit, 0, len(lit))
            if digits == "9223372036854775808" {
                return ExprRes { val: "wysna_int((-9223372036854775807LL - 1LL))", lref: "" }
            }
            return ExprRes { val: "wysna_int(-" + digits + "LL)", lref: "" }
        }
        let op_r = parse_expr(emitter, 9, allow_struct)
        return ExprRes { val: "wysna_neg(" + op_r.val + ")", lref: "" }
    }
    if match_kind(emitter, "NOT") {
        let op_r = parse_expr(emitter, 9, allow_struct)
        return ExprRes { val: "wysna_bool(!(" + op_r.val + ").as.b)", lref: "" }
    }
    if match_kind(emitter, "LPAREN") {
        if match_kind(emitter, "RPAREN") {
            return bind_call(emitter, "wysna_make_tuple(0, NULL)")
        }
        let first = parse_expr(emitter, 0, true)
        if match_kind(emitter, "COMMA") {
            let mut t_elems: list[str] = [snapshot_value(emitter, first.val)]
            if not check_kind(emitter, "RPAREN") {
                let second = parse_expr(emitter, 0, true)
                t_elems.append(snapshot_value(emitter, second.val))
                while match_kind(emitter, "COMMA") {
                    if check_kind(emitter, "RPAREN") {
                        break
                    }
                    let nxt = parse_expr(emitter, 0, true)
                    t_elems.append(snapshot_value(emitter, nxt.val))
                }
            }
            expect_kind(emitter, "RPAREN")
            let arr_tmp = new_aux(emitter, "_arr")
            let mut joined = ""
            for idx in 0..len(t_elems) {
                if idx > 0 {
                    joined = joined + ", "
                }
                joined = joined + t_elems[idx]
            }
            let cnt = str(len(t_elems))
            emit_line(emitter, "WVal " + arr_tmp + "[" + cnt + "] = { " + joined + " };")
            return bind_call(emitter, "wysna_make_tuple(" + cnt + ", " + arr_tmp + ")")
        }
        expect_kind(emitter, "RPAREN")
        return first
    }
    if match_kind(emitter, "LBRACKET") {
        let mut elems: list[str] = []
        if not check_kind(emitter, "RBRACKET") {
            let first = parse_expr(emitter, 0, true)
            elems.append(snapshot_value(emitter, first.val))
            while match_kind(emitter, "COMMA") {
                if check_kind(emitter, "RBRACKET") {
                    break
                }
                let nxt = parse_expr(emitter, 0, true)
                elems.append(snapshot_value(emitter, nxt.val))
            }
        }
        expect_kind(emitter, "RBRACKET")
        if len(elems) == 0 {
            return bind_call(emitter, "wysna_make_list(0, NULL)")
        }
        let arr_tmp = new_aux(emitter, "_arr")
        let mut joined = ""
        for idx in 0..len(elems) {
            if idx > 0 {
                joined = joined + ", "
            }
            joined = joined + elems[idx]
        }
        let cnt = str(len(elems))
        emit_line(emitter, "WVal " + arr_tmp + "[" + cnt + "] = { " + joined + " };")
        return bind_call(emitter, "wysna_make_list(" + cnt + ", " + arr_tmp + ")")
    }
    if match_kind(emitter, "LBRACE") {
        let mut d_keys: list[str] = []
        let mut d_vals: list[str] = []
        if not check_kind(emitter, "RBRACE") {
            let k0 = parse_expr(emitter, 0, true)
            if len(k0.val) >= 11 and slice(k0.val, 0, 11) == "wysna_float" {
                report_error(at_tok(emitter).file, "W2010", at_tok(emitter).line, at_tok(emitter).col, "invalid dictionary key type: float is not allowed as dictionary key")
            }
            expect_kind(emitter, "COLON")
            let key0 = snapshot_value(emitter, k0.val)
            let v0 = parse_expr(emitter, 0, true)
            d_keys.append(key0)
            d_vals.append(snapshot_value(emitter, v0.val))
            while match_kind(emitter, "COMMA") {
                if check_kind(emitter, "RBRACE") {
                    break
                }
                let kn = parse_expr(emitter, 0, true)
                if len(kn.val) >= 11 and slice(kn.val, 0, 11) == "wysna_float" {
                    report_error(at_tok(emitter).file, "W2010", at_tok(emitter).line, at_tok(emitter).col, "invalid dictionary key type: float is not allowed as dictionary key")
                }
                expect_kind(emitter, "COLON")
                let keyn = snapshot_value(emitter, kn.val)
                let vn = parse_expr(emitter, 0, true)
                d_keys.append(keyn)
                d_vals.append(snapshot_value(emitter, vn.val))
            }
        }
        expect_kind(emitter, "RBRACE")
        if len(d_keys) == 0 {
            return bind_call(emitter, "wysna_make_dict(0, NULL, NULL)")
        }
        let k_tmp = new_temp(emitter)
        let v_tmp = new_temp(emitter)
        let mut kj = ""
        let mut vj = ""
        for idx in 0..len(d_keys) {
            if idx > 0 {
                kj = kj + ", "
                vj = vj + ", "
            }
            kj = kj + d_keys[idx]
            vj = vj + d_vals[idx]
        }
        let cnt = str(len(d_keys))
        emit_line(emitter, "WVal " + k_tmp + "[" + cnt + "] = { " + kj + " };")
        emit_line(emitter, "WVal " + v_tmp + "[" + cnt + "] = { " + vj + " };")
        return bind_call(emitter, "wysna_make_dict(" + cnt + ", " + k_tmp + ", " + v_tmp + ")")
    }
    if check_kind(emitter, "IF") {
        return parse_if_expr(emitter)
    }
    if check_kind(emitter, "MATCH") {
        return parse_match_expr(emitter)
    }
    report_error_at("W9999", at_tok(emitter), "unsupported checked expression in C emission")
    return ExprRes { val: "wysna_unit()", lref: "" }
}

fn parse_expr(emitter: CEmitter, min_prec: int, allow_struct: bool) -> ExprRes {
    let expression_start = emitter.pos
    let statements_before = emitter.cur_stmts
    let scopes_before = emitter.scope_stack
    let temps_before = emitter.temp_id
    let aux_before = emitter.aux_id
    let mut left = parse_prefix_expr(emitter, allow_struct)
    while true {
        while true {
            if check_kind(emitter, "NEWLINE") and peek_tok(emitter, 1).kind == "ELSE" {
                let saved = emitter.pos
                while check_kind(emitter, "NEWLINE") { advance_tok(emitter) }
                let mut starts_match_arm = false
                if check_kind(emitter, "ELSE") and peek_tok(emitter, 1).kind == "FAT_ARROW" { starts_match_arm = true }
                if check_kind(emitter, "ELSE") and peek_tok(emitter, 1).kind == "IDENT" and peek_tok(emitter, 2).kind == "FAT_ARROW" { starts_match_arm = true }
                if starts_match_arm { emitter.pos = saved }
            }
            if check_kind(emitter, "LPAREN") {
                let call_tok = at_tok(emitter)
                let mut collection = false
                for position in emitter.checked.c99.collection_call_positions { if position == emitter.pos + 1 { collection = true } }
                for position in emitter.checked.c99.indirect_positions {
                    if position == emitter.pos + 1 { left = ExprRes { val: snapshot_value(emitter, left.val), lref: "" } }
                }
                left = snapshot_callee(emitter, left, collection)
                advance_tok(emitter)
                let mut args_c: list[str] = []
                if not check_kind(emitter, "RPAREN") {
                    let a0 = parse_expr(emitter, 0, true)
                    args_c.append(snapshot_value(emitter, a0.val))
                    while match_kind(emitter, "COMMA") {
                        if check_kind(emitter, "RPAREN") {
                            break
                        }
                        let an = parse_expr(emitter, 0, true)
                        args_c.append(snapshot_value(emitter, an.val))
                    }
                }
                expect_kind(emitter, "RPAREN")
                left = emit_call(emitter, left, args_c, collection, call_tok.file, call_tok.line, call_tok.col)
            } elif check_kind(emitter, "DOT") {
                let projection_position = emitter.pos + 1
                advance_tok(emitter)
                let prop_tok = expect_kind(emitter, "IDENT")
                let prop = prop_tok.val
                if projection_is_mutated(emitter) {
                    for position in emitter.checked.c99.class_projection_positions {
                        if position == projection_position {
                            let held = snapshot_value(emitter, left.val)
                            left = ExprRes { val: held, lref: "&" + held }
                        }
                    }
                }
                if len(left.val) >= 2 and slice(left.val, 0, 2) == "v_" {
                    let raw_obj = slice(left.val, 2, len(left.val))
                    if (is_enum_name(emitter, raw_obj) or raw_obj == "Option" or raw_obj == "Result") and not is_bound_variable(emitter, left.val) {
                        if raw_obj == "Option" and prop == "None" { left = ExprRes { val: "wysna_none()", lref: "" } }
                        elif (raw_obj == "Option" and prop == "Some") or (raw_obj == "Result" and (prop == "Ok" or prop == "Err")) { left = ExprRes { val: "enum::" + raw_obj + "::" + prop, lref: "" } }
                        else {
                            let mut variant_arity = 0
                            for variant_index in 0..len(emitter.enum_variant_names) {
                                if emitter.enum_variant_names[variant_index] == prop and emitter.enum_variant_owners[variant_index] == raw_obj { variant_arity = emitter.enum_variant_arities[variant_index] }
                            }
                            if variant_arity > 0 { left = ExprRes { val: "enum::" + raw_obj + "::" + prop, lref: "" } }
                            else { left = ExprRes { val: "wysna_enum(\"" + raw_obj + "\", \"" + prop + "\")", lref: "" } }
                        }
                    } else {
                        left = ExprRes { val: "wysna_member_get(" + left.val + ", \"" + prop + "\")", lref: "wysna_member_ref(" + clean_lref(left.lref) + ", \"" + prop + "\")::" + prop + "::" + clean_lref(left.lref) + "::" + left.val }
                    }
                } else {
                    left = ExprRes { val: "wysna_member_get(" + left.val + ", \"" + prop + "\")", lref: "wysna_member_ref(" + clean_lref(left.lref) + ", \"" + prop + "\")::" + prop + "::" + clean_lref(left.lref) + "::" + left.val }
                }
                if not projection_is_mutated(emitter) and not check_kind(emitter, "LPAREN") and left.lref != "" {
                    left = ExprRes { val: bind_call(emitter, "wysna_clone(" + left.val + ")").val, lref: left.lref }
                }
            } elif check_kind(emitter, "LBRACKET") {
                let bracket_tok = at_tok(emitter)
                let mutated = projection_is_mutated(emitter)
                advance_tok(emitter)
                let mut object_value = left.val
                if not mutated {
                    object_value = snapshot_value(emitter, left.val)
                }
                let mut idx_r = parse_expr(emitter, 0, true)
                expect_kind(emitter, "RBRACKET")
                if mutated {
                    idx_r = ExprRes { val: snapshot_value(emitter, idx_r.val), lref: idx_r.lref }
                }
                let source_args = escape_c_str(bracket_tok.file) + ", " + str(bracket_tok.line) + ", " + str(bracket_tok.col)
                let index_lref = "wysna_index_ref_at(" + clean_lref(left.lref) + ", " + idx_r.val + ", " + source_args + ")"
                if mutated {
                    left = ExprRes { val: "wysna_index_get_at(" + left.val + ", " + idx_r.val + ", " + source_args + ")", lref: index_lref }
                } else {
                    left = ExprRes { val: bind_call(emitter, "wysna_index_get_owned_at(" + object_value + ", " + idx_r.val + ", " + source_args + ")").val, lref: index_lref }
                }
            } elif check_kind(emitter, "QUESTION") {
                advance_tok(emitter)
                let tmp = new_temp(emitter)
                declare_owned_var(emitter, tmp, own_expr(left.val))
                emit_line(emitter, "if (" + str(not emitter.fn_fallible) + " && (" + tmp + ".tag == W_NONE)) {")
                emit_cleanup_until_fn_indented(emitter)
                emit_line(emitter, "    return wysna_none();")
                emit_line(emitter, "}")
                let err_hold = new_aux(emitter, "_err")
                emit_line(emitter, "if (" + str(emitter.fn_fallible) + " && (" + tmp + ".tag == W_ERR)) {")
                emit_line(emitter, "    WVal " + err_hold + " = wysna_clone(" + tmp + ");")
                emit_cleanup_until_fn_indented(emitter)
                emit_line(emitter, "    return " + err_hold + ";")
                emit_line(emitter, "}")
                let unw = new_temp(emitter)
                let mut unwrap_helper = "wysna_unwrap_optional"
                if emitter.fn_fallible { unwrap_helper = "wysna_unwrap_ok" }
                declare_owned_var(emitter, unw, unwrap_helper + "(" + tmp + ")")
                left = ExprRes { val: unw, lref: "" }
            } elif check_kind(emitter, "ELSE") {
                advance_tok(emitter)
                let mut err_name = ""
                if check_kind(emitter, "IDENT") {
                    let et = advance_tok(emitter)
                    err_name = et.val
                }
                let tmp = new_temp(emitter)
                declare_owned_var(emitter, tmp, own_expr(left.val))
                let res = new_temp(emitter)
                declare_owned_var(emitter, res, "wysna_unit()")
                emit_line(emitter, "if (" + tmp + ".tag == W_ERR || " + tmp + ".tag == W_NONE) {")
                push_scope(emitter, "block")
                let saved = emitter.cur_stmts
                let empty: list[str] = []
                emitter.cur_stmts = empty
                if err_name != "" {
                    declare_owned_var(emitter, "v_" + err_name, "wysna_unwrap_err(" + tmp + ")")
                }
                let hv = parse_block_expr(emitter)
                emit_line(emitter, "wysna_assign(&" + res + ", " + own_expr(hv) + ");")
                pop_scope(emitter)
                let h_lines = emitter.cur_stmts
                emitter.cur_stmts = saved
                for l in h_lines {
                    emit_line(emitter, "    " + l)
                }
                emit_line(emitter, "} else {")
                emit_line(emitter, "    wysna_assign(&" + res + ", wysna_unwrap_success(" + tmp + "));")
                emit_line(emitter, "}")
                left = ExprRes { val: res, lref: "" }
            } else {
                break
            }
        }
        let op_tok = at_tok(emitter)
        let prec = op_precedence(op_tok.kind)
        if prec <= min_prec {
            break
        }
        advance_tok(emitter)
        let mut next_min = prec
        if op_tok.kind == "ASSIGN" or op_tok.kind == "QQ" {
            next_min = prec - 1
        }
        if op_tok.kind == "AND" {
            let res = new_temp(emitter)
            declare_owned_var(emitter, res, "wysna_bool(false)")
            emit_line(emitter, "if ((" + left.val + ").as.b) {")
            push_scope(emitter, "block")
            let saved = emitter.cur_stmts
            let empty: list[str] = []
            emitter.cur_stmts = empty
            let rhs = parse_expr(emitter, next_min, allow_struct)
            emit_line(emitter, res + " = wysna_bool((" + rhs.val + ").as.b);")
            pop_scope(emitter)
            let r_lines = emitter.cur_stmts
            emitter.cur_stmts = saved
            for l in r_lines {
                emit_line(emitter, "    " + l)
            }
            emit_line(emitter, "}")
            left = ExprRes { val: res, lref: "" }
        } elif op_tok.kind == "OR" {
            let res = new_temp(emitter)
            declare_owned_var(emitter, res, "wysna_bool(true)")
            emit_line(emitter, "if (!(" + left.val + ").as.b) {")
            push_scope(emitter, "block")
            let saved = emitter.cur_stmts
            let empty: list[str] = []
            emitter.cur_stmts = empty
            let rhs = parse_expr(emitter, next_min, allow_struct)
            emit_line(emitter, res + " = wysna_bool((" + rhs.val + ").as.b);")
            pop_scope(emitter)
            let r_lines = emitter.cur_stmts
            emitter.cur_stmts = saved
            for l in r_lines {
                emit_line(emitter, "    " + l)
            }
            emit_line(emitter, "}")
            left = ExprRes { val: res, lref: "" }
        } elif op_tok.kind == "QQ" {
            let res = new_temp(emitter)
            declare_owned_var(emitter, res, own_expr(left.val))
            emit_line(emitter, "if (" + res + ".tag == W_NONE) {")
            push_scope(emitter, "block")
            let saved = emitter.cur_stmts
            let empty: list[str] = []
            emitter.cur_stmts = empty
            let rhs = parse_expr(emitter, next_min, allow_struct)
            emit_line(emitter, "wysna_assign(&" + res + ", " + own_expr(rhs.val) + ");")
            pop_scope(emitter)
            let r_lines = emitter.cur_stmts
            emitter.cur_stmts = saved
            for l in r_lines {
                emit_line(emitter, "    " + l)
            }
            emit_line(emitter, "} else {")
            emit_line(emitter, "    wysna_assign(&" + res + ", wysna_unwrap_optional(" + res + "));")
            emit_line(emitter, "}")
            left = ExprRes { val: res, lref: "" }
        } else {
            if op_tok.kind != "ASSIGN" {
                left = ExprRes { val: snapshot_value(emitter, left.val), lref: left.lref }
            }
            let right = parse_expr(emitter, next_min, allow_struct)
            if op_tok.kind == "ASSIGN" {
                if (len(left.val) < 2 or slice(left.val, 0, 2) != "v_") and left.lref == "" {
                    report_error(at_tok(emitter).file, "W2002", op_tok.line, op_tok.col, "invalid assignment target")
                }
                let rhs_hold = new_aux(emitter, "_rhs")
                declare_owned_var(emitter, rhs_hold, own_expr(right.val))
                if len(left.val) >= 2 and slice(left.val, 0, 2) == "v_" {
                    emit_line(emitter, "wysna_assign(&" + left.val + ", " + "wysna_move(&" + rhs_hold + "));")
                    left = ExprRes { val: left.val, lref: left.lref }
                } else {
                    let target_ref = clean_lref(left.lref)
                    left = bind_call(emitter, "wysna_clone(wysna_assign(" + target_ref + ", wysna_move(&" + rhs_hold + ")))")
                }
            } elif op_tok.kind == "DOT_DOT" {
                left = bind_call(emitter, "wysna_make_range(" + left.val + ", " + right.val + ", false)")
            } elif op_tok.kind == "DOT_DOT_EQ" {
                left = bind_call(emitter, "wysna_make_range(" + left.val + ", " + right.val + ", true)")
            } elif op_tok.kind == "PLUS" {
                left = ExprRes { val: bind_call(emitter, "wysna_add(" + left.val + ", " + right.val + ")").val, lref: "" }
            } elif op_tok.kind == "MINUS" {
                left = ExprRes { val: "wysna_sub(" + left.val + ", " + right.val + ")", lref: "" }
            } elif op_tok.kind == "STAR" {
                left = ExprRes { val: "wysna_mul(" + left.val + ", " + right.val + ")", lref: "" }
            } elif op_tok.kind == "SLASH" {
                left = ExprRes { val: "wysna_div_at(" + left.val + ", " + right.val + ", " + escape_c_str(op_tok.file) + ", " + str(op_tok.line) + ", " + str(op_tok.col) + ")", lref: "" }
            } elif op_tok.kind == "PERCENT" {
                left = ExprRes { val: "wysna_mod_at(" + left.val + ", " + right.val + ", " + escape_c_str(op_tok.file) + ", " + str(op_tok.line) + ", " + str(op_tok.col) + ")", lref: "" }
            } elif op_tok.kind == "LT" {
                left = ExprRes { val: "wysna_lt(" + left.val + ", " + right.val + ")", lref: "" }
            } elif op_tok.kind == "LTE" {
                left = ExprRes { val: "wysna_le(" + left.val + ", " + right.val + ")", lref: "" }
            } elif op_tok.kind == "GT" {
                left = ExprRes { val: "wysna_gt(" + left.val + ", " + right.val + ")", lref: "" }
            } elif op_tok.kind == "GTE" {
                left = ExprRes { val: "wysna_ge(" + left.val + ", " + right.val + ")", lref: "" }
            } elif op_tok.kind == "EQ" {
                left = ExprRes { val: "wysna_bool(wysna_eq(" + left.val + ", " + right.val + "))", lref: "" }
            } elif op_tok.kind == "NEQ" {
                left = ExprRes { val: "wysna_bool(!wysna_eq(" + left.val + ", " + right.val + "))", lref: "" }
            }
        }
    }
    let mut needs_result_lift = false
    for position in emitter.checked.c99.result_lift_positions { if position == expression_start + 1 { needs_result_lift = true } }
    if needs_result_lift { left = bind_call(emitter, "wysna_ok(" + own_expr(left.val) + ")") }
    return left
}

fn parse_lambda(emitter: CEmitter) -> ExprRes {
    let token = expect_kind(emitter, "PIPE")
    let mut index = -1
    for i in 0..len(emitter.checked.c99.lambdas) { if emitter.checked.c99.lambdas[i].position == emitter.pos { index = i } }
    if index < 0 { report_error_at("W9999", token, "missing checked closure") }
    let lambda = emitter.checked.c99.lambdas[index]
    while not check_kind(emitter, "PIPE") {
        expect_kind(emitter, "IDENT")
        if match_kind(emitter, "COLON") { parse_type_ann(emitter) }
        if not match_kind(emitter, "COMMA") { break }
    }
    expect_kind(emitter, "PIPE")
    if match_kind(emitter, "ARROW") { parse_type_ann(emitter) }
    let saved_statements = emitter.cur_stmts
    let saved_scopes = emitter.scope_stack
    let saved_borrowed = emitter.borrowed_vars
    let saved_fallible = emitter.fn_fallible
    let saved_error = emitter.cur_err_type
    let empty_statements: list[str] = []
    let empty_scopes: list[CleanupScope] = []
    let mut borrowed: list[str] = []
    emitter.cur_stmts = empty_statements
    emitter.scope_stack = empty_scopes
    emitter.fn_fallible = false
    emitter.cur_err_type = ""
    push_scope(emitter, "fn")
    for i in 0..len(lambda.params) {
        let variable = "v_" + lambda.params[i]
        emit_line(emitter, "WVal " + variable + " = argv[" + str(i) + "];")
        borrowed.append(variable)
    }
    for i in 0..len(lambda.captures) {
        let variable = "v_" + lambda.captures[i]
        declare_owned_var(emitter, variable, "wysna_clone(environment.as.tuple->items[" + str(i) + "])")
    }
    emitter.borrowed_vars = borrowed
    let mut result = "wysna_unit()"
    if match_kind(emitter, "FAT_ARROW") { result = parse_expr(emitter, 0, true).val }
    else { result = parse_block_expr(emitter) }
    let signature_types = emitter.checked.types[lambda.type_id].args
    let return_type = signature_types[len(signature_types) - 1]
    if return_type == emitter.checked.unit_type { result = "wysna_unit()" }
    elif checked_unit_return(emitter.checked, return_type) { result = bind_call(emitter, "wysna_discard_result_value(" + own_expr(result) + ")").val }
    elif checked_kind(emitter.checked, return_type) == "result" { result = bind_call(emitter, "wysna_wrap_result(" + own_expr(result) + ", \"\")").val }
    let returned = new_aux(emitter, "_ret")
    emit_line(emitter, "WVal " + returned + " = " + own_expr(result) + ";")
    pop_scope(emitter)
    emit_line(emitter, "return " + returned + ";")
    let name = "wysna_lambda_" + str(index)
    let signature = "static WVal " + name + "(WVal environment, int32_t argc, const WVal* argv)"
    let mut definition = signature + " {\n"
    definition = definition + "    if (argc != " + str(len(lambda.params)) + ") { fprintf(stderr, \"[W4003] RuntimeError: Call arity mismatch\\n\"); exit(1); }\n"
    for line in emitter.cur_stmts { definition = definition + "    " + line + "\n" }
    definition = definition + "}"
    emitter.protos.append(signature + ";")
    emitter.fn_defs.append(definition)
    emitter.cur_stmts = saved_statements
    emitter.scope_stack = saved_scopes
    emitter.borrowed_vars = saved_borrowed
    emitter.fn_fallible = saved_fallible
    emitter.cur_err_type = saved_error
    let mut captures = ""
    for i in 0..len(lambda.captures) {
        if i > 0 { captures = captures + ", " }
        captures = captures + "v_" + lambda.captures[i]
    }
    let mut environment = "wysna_make_tuple(0, NULL)"
    if len(lambda.captures) > 0 {
        let array = new_aux(emitter, "_captures")
        emit_line(emitter, "WVal " + array + "[" + str(len(lambda.captures)) + "] = { " + captures + " };")
        environment = "wysna_make_tuple(" + str(len(lambda.captures)) + ", " + array + ")"
    }
    return bind_call(emitter, "wysna_function_new(" + name + ", " + environment + ")")
}
