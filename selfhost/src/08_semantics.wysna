fn sem_at(context: SemanticContext) -> Token {
    let token = context.tokens[context.pos]
    return token
}
fn sem_is(context: SemanticContext, kind: str) -> bool { return sem_at(context).kind == kind }
fn sem_take(context: SemanticContext) -> Token {
    let token = sem_at(context)
    if context.pos + 1 < len(context.tokens) { context.pos = context.pos + 1 }
    return token
}
fn sem_match(context: SemanticContext, kind: str) -> bool {
    if sem_is(context, kind) { sem_take(context) return true }
    return false
}
fn sem_skip_separators(context: SemanticContext) {
    while sem_is(context, "NEWLINE") or sem_is(context, "SEMICOLON") { sem_take(context) }
}
fn sem_skip_newlines_before_branch(context: SemanticContext) {
    let saved = context.pos
    while sem_is(context, "NEWLINE") { sem_take(context) }
    let mut branch = sem_is(context, "ELIF")
    if sem_is(context, "ELSE") {
        if context.tokens[context.pos + 1].kind == "LBRACE" or context.tokens[context.pos + 1].kind == "IDENT" and context.tokens[context.pos + 2].kind == "LBRACE" { branch = true }
    }
    if not branch { context.pos = saved }
}
fn sem_error(context: SemanticContext, code: str, message: str) {
    report_error_at(code, sem_at(context), message)
}
fn sem_expect(context: SemanticContext, kind: str) -> Token {
    if not sem_is(context, kind) { sem_error(context, "W0006", "expected " + kind) }
    return sem_take(context)
}
fn sem_intern(context: SemanticContext, kind: str, name: str, args: list[int]) -> int {
    for i in 0..len(context.types) {
        let candidate = context.types[i]
        if candidate.kind == kind and candidate.name == name and candidate.args == args { return i }
    }
    context.types.append(SemType { kind: kind, name: name, args: args })
    return len(context.types) - 1
}
fn sem_simple(context: SemanticContext, kind: str) -> int {
    let empty: list[int] = []
    return sem_intern(context, kind, "", empty)
}
fn sem_wrap(context: SemanticContext, kind: str, child: int) -> int { return sem_intern(context, kind, "", [child]) }
fn sem_kind(context: SemanticContext, type_id: int) -> str { return context.types[type_id].kind }
fn sem_unwrap_expected_payload(context: SemanticContext, expected: int) -> int {
    let mut current = expected
    while current >= 0 and (sem_kind(context, current) == "result" or sem_kind(context, current) == "optional") {
        current = context.types[current].args[0]
    }
    return current
}
fn sem_error_type_name(context: SemanticContext, type_id: int) -> str {
    let type_ = context.types[type_id]
    if type_.kind == "int" { return "int" }
    if type_.kind == "float" { return "float" }
    if type_.kind == "bool" { return "bool" }
    if type_.kind == "str" { return "str" }
    if len(type_.args) > 0 { return sem_nominal_specialization_name(type_.name, type_.args) }
    return type_.name
}
fn sem_error_union(context: SemanticContext, first: int) -> int {
    let mut alternatives: list[int] = [first]
    let mut has_union = false
    while sem_match(context, "PIPE") { has_union = true alternatives.append(sem_type(context)) }
    if not has_union { return first }
    return sem_intern_error_union(context, alternatives)
}
fn sem_intern_error_union(context: SemanticContext, alternatives: list[int]) -> int {
    let mut unique: list[int] = []
    for alternative in alternatives {
        let kind = sem_kind(context, alternative)
        if kind != "int" and kind != "float" and kind != "bool" and kind != "str" and kind != "struct" and kind != "enum" and kind != "class" {
            sem_error(context, "W2001", "error union alternatives must be scalar, struct, enum, or class types")
        }
        let mut found = false
        for existing in unique { if existing == alternative { found = true } }
        if not found { unique.append(alternative) }
    }
    if len(unique) < 2 { sem_error(context, "W2001", "an error union requires at least two distinct alternatives") }
    let mut canonical: list[int] = []
    let mut previous = -1
    while len(canonical) < len(unique) {
        let mut next = -1
        for alternative in unique {
            if alternative > previous and (next < 0 or alternative < next) { next = alternative }
        }
        if next < 0 { sem_error(context, "W9999", "failed to canonicalize error union") }
        canonical.append(next)
        previous = next
    }
    return sem_intern(context, "error_union", "", canonical)
}
fn sem_named(context: SemanticContext, name: str) -> int {
    for i in 0..len(context.types) { if context.types[i].name == name { return i } }
    sem_error(context, "W1001", "unknown type: " + name)
    return context.unit_type
}
fn sem_generic_type(context: SemanticContext, name: str) -> int {
    for i in 0..len(context.generic_types) { if context.generic_types[i].name == name { return i } }
    return -1
}
fn sem_class_parent_type(context: SemanticContext, type_id: int) -> int {
    if type_id < 0 { return -1 }
    let type_ = context.types[type_id]
    if type_.kind != "class" { return -1 }
    for class_ in context.classes {
        if class_.name == type_.name {
            if class_.parent == "" { return -1 }
            let mut names: list[str] = []
            let generic = sem_generic_type(context, type_.name)
            if generic >= 0 { names = context.generic_types[generic].params }
            let mut resolved_args: list[int] = []
            for arg_id in class_.parent_args {
                resolved_args.append(sem_substitute_type(context, arg_id, names, type_.args))
            }
            return sem_intern(context, "class", class_.parent, resolved_args)
        }
    }
    return -1
}
fn sem_class_interface_types(context: SemanticContext, type_id: int) -> list[int] {
    let mut result: list[int] = []
    if type_id < 0 { return result }
    let type_ = context.types[type_id]
    if type_.kind != "class" { return result }
    for class_ in context.classes {
        if class_.name == type_.name {
            let mut names: list[str] = []
            let generic = sem_generic_type(context, type_.name)
            if generic >= 0 { names = context.generic_types[generic].params }
            for iface_ref in class_.interfaces {
                let mut resolved_args: list[int] = []
                for arg_id in iface_ref.args {
                    resolved_args.append(sem_substitute_type(context, arg_id, names, type_.args))
                }
                if len(resolved_args) > 0 {
                    sem_check_nominal_constraints(context, iface_ref.name, resolved_args, context.tokens[0])
                }
                result.append(sem_intern(context, "interface", iface_ref.name, resolved_args))
            }
            return result
        }
    }
    return result
}
fn sem_resolve_member_owner(context: SemanticContext, receiver_type_id: int, owner_name: str) -> int {
    let mut current = receiver_type_id
    let mut visits = 0
    while current >= 0 and visits <= len(context.classes) {
        if context.types[current].name == owner_name { return current }
        current = sem_class_parent_type(context, current)
        visits = visits + 1
    }
    return receiver_type_id
}
fn sem_check_nominal_constraints(context: SemanticContext, name: str, arguments: list[int], location: Token) {
    let generic = sem_generic_type(context, name)
    if generic < 0 { return }
    let constraints = context.generic_types[generic].constraints
    for i in 0..len(arguments) {
        if i < len(constraints) and constraints[i] != "" {
            let concrete = arguments[i]
            if not sem_symbolic(context, concrete) {
                let bound = sem_named(context, constraints[i])
                if not sem_assignable(context, concrete, bound) {
                    report_error_at("W2001", location, "generic constraint not satisfied: " + constraints[i])
                }
            }
        }
    }
}
fn sem_same_type_declaration(context: SemanticContext, declaration: int, instance: int) -> bool {
    let declared = context.types[declaration]
    let concrete = context.types[instance]
    return declared.kind == concrete.kind and declared.name == concrete.name
}
fn sem_function(context: SemanticContext, name: str) -> int {
    for i in 0..len(context.functions) { if context.functions[i].name == name { return i } }
    return -1
}
fn sem_method(context: SemanticContext, owner: str, name: str) -> int {
    let mut current = owner
    let mut visits = 0
    while current != "" and visits <= len(context.classes) {
        let index = sem_function(context, current + "." + name)
        if index >= 0 { return index }
        let mut next = ""
        for class_ in context.classes { if class_.name == current { next = class_.parent } }
        current = next
        visits = visits + 1
    }
    return -1
}
fn sem_error_channel_assignable(context: SemanticContext, source: int, target: int) -> bool {
    if source == target { return true }
    if sem_defer(context, "assignable", [source, target]) { return true }
    let s = context.types[source]
    let t = context.types[target]
    let source_members = if s.kind == "error_union" { s.args } else { [source] }
    let target_members = if t.kind == "error_union" { t.args } else { [target] }
    for source_member in source_members {
        let mut covered = false
        for target_member in target_members { if source_member == target_member { covered = true } }
        if not covered { return false }
    }
    return true
}
# Equality follows stored payloads; class and weak identity remain comparable.
fn sem_equality_value(context: SemanticContext, root: int) -> bool {
    let mut pending: list[int] = [root]
    let mut seen: list[int] = []
    while len(pending) > 0 {
        let id = pending.pop()
        let mut visited = false
        for previous in seen { if previous == id { visited = true } }
        if not visited {
            seen.append(id)
            let type_ = context.types[id]
            if type_.kind == "function" { return false }
            if type_.kind == "struct" or type_.kind == "enum" {
                let mut names: list[str] = []
                let generic = sem_generic_type(context, type_.name)
                if generic >= 0 {
                    sem_require_nominal_budget(context, id)
                    names = context.generic_types[generic].params
                    if len(type_.args) != len(names) { sem_error(context, "W2013", "nominal equality requires an explicit type context") }
                }
                for field in context.fields {
                    if field.owner == type_.name { pending.append(sem_substitute_type(context, field.type_id, names, type_.args)) }
                }
                for i in 0..len(context.variants) {
                    if context.types[context.variant_types[i]].name == type_.name {
                        for payload in context.variant_payloads[i] { pending.append(sem_substitute_type(context, payload, names, type_.args)) }
                    }
                }
            } elif type_.kind == "list" or type_.kind == "optional" or type_.kind == "tuple" or type_.kind == "result" or type_.kind == "error_union" or type_.kind == "dict" or type_.kind == "ok" or type_.kind == "err" {
                for child in type_.args { pending.append(child) }
            }
        }
    }
    return true
}

fn sem_assignable(context: SemanticContext, source: int, target: int) -> bool {
    if source == target { return true }
    if sem_defer(context, "assignable", [source, target]) { return true }
    let s = context.types[source]
    let t = context.types[target]
    if s.kind == "empty" and (t.kind == "list" or t.kind == "dict") { return true }
    if t.kind == "optional" {
        if source == context.none_type { return true }
        if s.kind == "optional" { return sem_assignable(context, s.args[0], t.args[0]) }
        return sem_assignable(context, source, t.args[0])
    }
    if t.kind == "result" {
        if s.kind == "result" {
            if s.args[0] == t.args[0] and sem_error_channel_assignable(context, s.args[1], t.args[1]) { return true }
            return sem_assignable(context, source, t.args[0])
        }
        if s.kind == "ok" { return sem_assignable(context, s.args[0], t.args[0]) }
        if s.kind == "err" { return sem_error_channel_assignable(context, s.args[0], t.args[1]) }
        return sem_assignable(context, source, t.args[0])
    }
    if t.kind == "error_union" {
        return sem_error_channel_assignable(context, source, target)
    }
    if s.kind == "class" and (t.kind == "class" or t.kind == "interface") {
        let mut current_id = source
        let mut visits = 0
        while current_id >= 0 and visits <= len(context.classes) {
            let current_type = context.types[current_id]
            if t.kind == "class" and current_type.name == t.name {
                return current_id == target
            }
            if t.kind == "interface" {
                for iface_id in sem_class_interface_types(context, current_id) {
                    if iface_id == target { return true }
                }
            }
            current_id = sem_class_parent_type(context, current_id)
            visits = visits + 1
        }
    }
    if s.kind == "struct" and t.kind == "struct" and sem_task_struct_pair(context, source, target) { return true }
    if s.kind == "list" and t.kind == "list" and sem_task_struct_pair(context, s.args[0], t.args[0]) { return true }
    return false
}
fn sem_is_task_struct_name(name: str) -> bool {
    if name == "Task" { return true }
    if len(name) >= 13 and slice(name, 0, 13) == "__WysnaTask__" { return true }
    if len(name) >= 6 and slice(name, len(name) - 6, len(name)) == "__Task" { return true }
    return false
}
fn sem_task_struct_pair(context: SemanticContext, left: int, right: int) -> bool {
    if left == right { return true }
    let lt = context.types[left]
    let rt = context.types[right]
    if lt.kind != "struct" or rt.kind != "struct" { return false }
    if not sem_is_task_struct_name(lt.name) or not sem_is_task_struct_name(rt.name) { return false }
    let lval = sem_field(context, lt.name, "value")
    let rval = sem_field(context, rt.name, "value")
    if lval < 0 or rval < 0 { return false }
    let mut lf = context.fields[lval].type_id
    let mut rf = context.fields[rval].type_id
    let lg = sem_generic_type(context, lt.name)
    if lg >= 0 and len(lt.args) == len(context.generic_types[lg].params) { lf = sem_substitute_type(context, lf, context.generic_types[lg].params, lt.args) }
    let rg = sem_generic_type(context, rt.name)
    if rg >= 0 and len(rt.args) == len(context.generic_types[rg].params) { rf = sem_substitute_type(context, rf, context.generic_types[rg].params, rt.args) }
    return lf == rf
}
fn sem_resolve_async_task_type(context: SemanticContext, inner_tid: int) -> int {
    let mut tmpl_name = ""
    for g in context.generic_types {
        if g.kind == "struct" and len(g.params) == 1 and sem_is_task_struct_name(g.name) {
            tmpl_name = g.name
            break
        }
    }
    if tmpl_name != "" and not sem_symbolic(context, inner_tid) {
        return sem_intern(context, "struct", tmpl_name, [inner_tid])
    }
    let task_name = "__WysnaTask__" + str(inner_tid)
    for i in 0..len(context.types) {
        let t = context.types[i]
        if t.kind == "struct" and t.name == task_name { return i }
    }
    let empty: list[int] = []
    let tid = sem_intern(context, "struct", task_name, empty)
    context.fields.append(SemField { owner: task_name, name: "id", type_id: context.integer_type, visible: true })
    context.fields.append(SemField { owner: task_name, name: "handle", type_id: context.integer_type, visible: true })
    context.fields.append(SemField { owner: task_name, name: "is_ready", type_id: context.boolean_type, visible: true })
    context.fields.append(SemField { owner: task_name, name: "is_failed", type_id: context.boolean_type, visible: true })
    context.fields.append(SemField { owner: task_name, name: "value", type_id: sem_wrap(context, "optional", inner_tid), visible: true })
    context.fields.append(SemField { owner: task_name, name: "error", type_id: sem_wrap(context, "optional", context.string_type), visible: true })
    return tid
}
fn sem_external_async_signature(context: SemanticContext, fn_tid: int) -> int {
    let fn_t = context.types[fn_tid]
    if fn_t.kind != "function" or len(fn_t.args) == 0 { return fn_tid }
    let mut parts: list[int] = []
    for i in 0..len(fn_t.args) - 1 { parts.append(fn_t.args[i]) }
    parts.append(sem_resolve_async_task_type(context, fn_t.args[len(fn_t.args) - 1]))
    return sem_intern(context, "function", "", parts)
}
fn sem_demangle_name(raw: str) -> str {
    let prefix = "__wysna_module_"
    if len(raw) > len(prefix) and slice(raw, 0, len(prefix)) == prefix {
        for i in len(prefix)..len(raw) - 1 {
            if slice(raw, i, i + 2) == "__" {
                return slice(raw, i + 2, len(raw))
            }
        }
    }
    return raw
}
fn sem_diagnostic_type(context: SemanticContext, type_id: int, depth: int) -> str {
    if type_id < 0 or type_id >= len(context.types) { return "?" }
    let type_ = context.types[type_id]
    let mut name = type_.kind
    if type_.name != "" { name = sem_demangle_name(type_.name) }
    if depth >= 8 { return name }
    if type_.kind == "optional" and len(type_.args) == 1 {
        return sem_diagnostic_type(context, type_.args[0], depth + 1) + "?"
    }
    if type_.kind == "result" and len(type_.args) == 2 {
        return sem_diagnostic_type(context, type_.args[0], depth + 1) + " ! " + sem_diagnostic_type(context, type_.args[1], depth + 1)
    }
    if len(type_.args) > 0 {
        name = name + "["
        for i in 0..len(type_.args) {
            if i > 0 { name = name + ", " }
            name = name + sem_diagnostic_type(context, type_.args[i], depth + 1)
        }
        name = name + "]"
    }
    return name
}
fn sem_require_at(context: SemanticContext, source: int, target: int, code: str, location: Token) {
    if not sem_assignable(context, source, target) {
        report_error_at(code, location, "incompatible types: expected '" + sem_diagnostic_type(context, target, 0) + "', found '" + sem_diagnostic_type(context, source, 0) + "'")
    }
}
fn sem_source_at(context: SemanticContext, sources: list[Token], index: int) -> Token {
    if index >= 0 and index < len(sources) { return sources[index] }
    return sem_at(context)
}
fn sem_type(context: SemanticContext) -> int {
    let source = sem_at(context)
    let mut result = context.unit_type
    if sem_match(context, "FN") {
        sem_expect(context, "LPAREN")
        let mut args: list[int] = []
        if not sem_is(context, "RPAREN") {
            args.append(sem_type(context))
            while sem_match(context, "COMMA") { args.append(sem_type(context)) }
        }
        sem_expect(context, "RPAREN")
        sem_expect(context, "ARROW")
        args.append(sem_type(context))
        return sem_intern(context, "function", "", args)
    } elif sem_match(context, "LPAREN") {
        if sem_match(context, "RPAREN") {
            let empty: list[int] = []
            result = sem_intern(context, "tuple", "", empty)
        } else {
            let mut elems: list[int] = [sem_type(context)]
            let mut saw_comma = false
            while sem_match(context, "COMMA") {
                saw_comma = true
                if sem_is(context, "RPAREN") { break }
                elems.append(sem_type(context))
            }
            sem_expect(context, "RPAREN")
            if len(elems) == 1 and not saw_comma {
                result = elems[0]
            } else {
                result = sem_intern(context, "tuple", "", elems)
            }
        }
    } else {
        let name = sem_expect(context, "IDENT").val
        let mut substitution = -1
        for i in 0..len(context.substitution_names) { if context.substitution_names[i] == name { substitution = context.substitution_types[i] } }
        let mut is_parameter = false
        for parameter in context.type_params { if parameter == name { is_parameter = true } }
        if substitution >= 0 { result = substitution }
        elif is_parameter {
            let empty: list[int] = []
            result = sem_intern(context, "typeparam", name, empty)
        } elif name == "int" or name == "int32" or name == "int64" { result = context.integer_type }
        elif name == "float" or name == "double" { result = context.float_type }
        elif name == "bool" { result = context.boolean_type }
        elif name == "str" { result = context.string_type }
        elif name == "unit" { result = context.unit_type }
        elif name == "list" or name == "dict" or name == "tuple" or name == "Option" or name == "Result" or name == "Weak" {
            sem_expect(context, "LBRACKET")
            let mut args: list[int] = []
            if not (name == "tuple" and sem_is(context, "RBRACKET")) {
                args.append(sem_type(context))
                while sem_match(context, "COMMA") {
                    if name == "tuple" and sem_is(context, "RBRACKET") { break }
                    args.append(sem_type(context))
                }
            }
            sem_expect(context, "RBRACKET")
            let mut kind = name
            if name == "Option" { kind = "optional" }
            if name == "Result" { kind = "result" }
            if name == "Weak" { kind = "weak" }
            if (kind == "list" or kind == "optional" or kind == "weak") and len(args) != 1 { report_error_at("W2001", source, "type arity") }
            if (kind == "dict" or kind == "result") and len(args) != 2 { report_error_at("W2001", source, "type arity") }
            if kind == "dict" {
                if context.collecting_declarations {
                    context.pending_key_types.append(args[0])
                    context.pending_key_sources.append(source)
                } elif not sem_key(context, args[0]) { report_error_at("W2010", source, "invalid dictionary key") }
            }
            result = sem_intern(context, kind, "", args)
        } else {
            let base = sem_named(context, name)
            let generic = sem_generic_type(context, name)
            if sem_match(context, "LBRACKET") {
                if generic < 0 { report_error_at("W2001", source, "type is not generic: " + name) }
                let mut arguments: list[int] = [sem_type(context)]
                while sem_match(context, "COMMA") { arguments.append(sem_type(context)) }
                sem_expect(context, "RBRACKET")
                if len(arguments) != len(context.generic_types[generic].params) { report_error_at("W2001", source, "generic type arity: " + name) }
                sem_check_nominal_constraints(context, name, arguments, source)
                result = sem_intern(context, context.types[base].kind, name, arguments)
            } else {
                if generic >= 0 { report_error_at("W2001", source, "generic type arguments required: " + name) }
                result = base
            }
        }
    }
    if sem_match(context, "QUESTION") { result = sem_wrap(context, "optional", result) }
    if sem_match(context, "BANG") { result = sem_intern(context, "result", "", [result, sem_error_union(context, sem_type(context))]) }
    return result
}
fn sem_key(context: SemanticContext, type_id: int) -> bool {
    let mut pending: list[int] = [type_id]
    let mut seen: list[int] = []
    let mut active: list[int] = []
    while len(pending) > 0 {
        let current = pending.pop()
        if current < 0 {
            active.pop()
            seen.append(-current - 1)
        } elif current != context.integer_type and current != context.string_type and current != context.boolean_type {
            let type_ = context.types[current]
            if type_.kind == "tuple" {
                for elem_id in type_.args {
                    pending.append(elem_id)
                }
            } elif type_.kind != "enum" {
                return false
            } else {
                let mut visited = false
                for previous in seen { if previous == current { visited = true } }
                if not visited {
                    for previous in active { if previous == current { return false } }
                    let mut complete = false
                    for name in context.completed_enums { if name == type_.name { complete = true } }
                    if not complete { return false }
                    active.append(current)
                    pending.append(-current - 1)
                    let mut names: list[str] = []
                    let generic = sem_generic_type(context, type_.name)
                    if generic >= 0 {
                        names = context.generic_types[generic].params
                        if len(type_.args) != len(names) { return false }
                        sem_require_nominal_budget(context, current)
                    }
                    for i in 0..len(context.variants) {
                        if context.types[context.variant_types[i]].name == type_.name {
                            for payload in context.variant_payloads[i] {
                                pending.append(sem_substitute_type(context, payload, names, type_.args))
                            }
                        }
                    }
                }
            }
        }
    }
    return true
}
fn sem_lookup(context: SemanticContext, name: str) -> int {
    let mut i = len(context.variables) - 1
    while i >= 0 {
        if context.variables[i].name == name { return i }
        i = i - 1
    }
    return -1
}
fn sem_declare(context: SemanticContext, name: str, type_id: int, mutable: bool) -> int {
    for variable in context.variables {
        if variable.name == name and variable.depth == context.depth { sem_error(context, "W1002", "duplicate declaration: " + name) }
    }
    let mut binding = -1
    if context.capture_nodes {
        binding = len(context.symbols)
        context.symbols.append(CheckedBinding { name: name, type_id: type_id, mutable: mutable, global: context.depth == 0, source: sem_at(context) })
    }
    context.variables.append(SemVar { name: name, type_id: type_id, mutable: mutable, depth: context.depth, binding: binding })
    return binding
}
fn sem_value(type_id: int) -> SemValue {
    return SemValue { type_id: type_id, root: "", writable: -1, terminates: false, node: -1 }
}
fn sem_mutable_at(context: SemanticContext, root: str, location: Token) {
    if len(root) >= 5 and slice(root, 0, 5) == "this:" { return }
    if root != "" {
        let variable = sem_lookup(context, root)
        if variable >= 0 and context.capture_depth >= 0 and context.variables[variable].depth < context.capture_depth { report_error_at("W3001", location, "captured snapshots are immutable (use a `class` for shared mutable state or return the updated value)") }
        if variable < 0 or not context.variables[variable].mutable { report_error_at("W3001", location, "mutation of immutable binding") }
    }
}
fn sem_mutable(context: SemanticContext, root: str) {
    sem_mutable_at(context, root, sem_at(context))
}
fn sem_skip_block(context: SemanticContext) -> int {
    sem_expect(context, "LBRACE")
    let mut depth = 1
    while depth > 0 and not sem_is(context, "EOF") {
        if sem_match(context, "LBRACE") { depth = depth + 1 }
        elif sem_match(context, "RBRACE") { depth = depth - 1 }
        else { sem_take(context) }
    }
    if depth != 0 { sem_error(context, "W0006", "unclosed block") }
    return context.pos
}
fn sem_collect_function(context: SemanticContext, owner: str, visible: bool, is_async: bool) {
    sem_expect(context, "FN")
    let local_tok = sem_expect(context, "IDENT")
    let local = local_tok.val
    let previous_type_params = context.type_params
    let mut type_params: list[str] = previous_type_params
    let mut constraints: list[str] = []
    let owner_name = if len(owner) > 0 { slice(owner, 0, len(owner) - 1) } else { "" }
    if owner_name != "" and local == owner_name {
        for cls in context.classes {
            if cls.name == owner_name {
                report_error_at("W3004", local_tok, "Constructor in class '" + owner_name + "' must be named 'init', found 'fn " + local + "'")
            }
        }
    }
    let owner_generic = if owner_name != "" { sem_generic_type(context, owner_name) } else { -1 }
    for i in 0..len(type_params) {
        if owner_generic >= 0 and i < len(context.generic_types[owner_generic].constraints) {
            constraints.append(context.generic_types[owner_generic].constraints[i])
        } else {
            constraints.append("")
        }
    }
    if sem_match(context, "LBRACKET") {
        while not sem_is(context, "RBRACKET") {
            let parameter = sem_expect(context, "IDENT")
            for previous in type_params { if previous == parameter.val { report_error_at("W2001", parameter, "duplicate generic type parameter") } }
            type_params.append(parameter.val)
            let mut constraint = ""
            if sem_match(context, "COLON") { constraint = sem_expect(context, "IDENT").val }
            constraints.append(constraint)
            if not sem_match(context, "COMMA") { break }
        }
        sem_expect(context, "RBRACKET")
    }
    context.type_params = type_params
    let name = owner + local
    if sem_function(context, name) >= 0 { sem_error(context, "W1002", "duplicate function: " + name) }
    sem_expect(context, "LPAREN")
    let mut params: list[str] = []
    let mut abi_params: list[str] = []
    let mut types: list[int] = []
    while not sem_is(context, "RPAREN") {
        params.append(sem_expect(context, "IDENT").val)
        sem_expect(context, "COLON")
        abi_params.append(sem_at(context).val)
        types.append(sem_type(context))
        if not sem_match(context, "COMMA") { break }
    }
    sem_expect(context, "RPAREN")
    let mut returned = context.unit_type
    let mut abi_return = "unit"
    if sem_match(context, "ARROW") { abi_return = sem_at(context).val returned = sem_type(context) }
    types.append(returned)
    sem_skip_separators(context)
    let mut contract_start = -1
    let contract_token = sem_at(context)
    if contract_token.kind == "IDENT" and (contract_token.val == "requires" or contract_token.val == "ensures") {
        contract_start = context.pos
        let mut depth_p = 0
        let mut depth_b = 0
        while not sem_is(context, "EOF") {
            if sem_is(context, "LPAREN") { depth_p = depth_p + 1 }
            elif sem_is(context, "RPAREN") { if depth_p > 0 { depth_p = depth_p - 1 } }
            elif sem_is(context, "LBRACKET") { depth_b = depth_b + 1 }
            elif sem_is(context, "RBRACKET") { if depth_b > 0 { depth_b = depth_b - 1 } }
            elif sem_is(context, "LBRACE") and depth_p == 0 and depth_b == 0 { break }
            elif sem_is(context, "SEMI") and depth_p == 0 and depth_b == 0 { break }
            sem_take(context)
        }
    }
    sem_skip_separators(context)
    let signature = sem_intern(context, "function", "", types)
    let mut body = -1
    let mut end = context.pos
    if sem_is(context, "LBRACE") { body = context.pos end = sem_skip_block(context) }
    context.type_params = previous_type_params
    context.functions.append(SemFunction { attributes: [], abi_params: abi_params, abi_return: abi_return, name: name, params: params, type_params: type_params, constraints: constraints, type_id: signature, body: body, end: end, owner: owner, visible: visible, contract_start: contract_start, is_async: is_async })
}
fn sem_collect_record(context: SemanticContext, kind: str) {
    sem_take(context)
    let name_token = sem_at(context)
    let name = sem_expect(context, "IDENT").val
    let previous_type_params = context.type_params
    let mut type_params: list[str] = []
    let generic = sem_generic_type(context, name)
    let generic_class = generic >= 0 and kind == "class"
    if generic >= 0 {
        type_params = context.generic_types[generic].params
    }
    context.type_params = type_params
    if generic >= 0 {
        sem_expect(context, "LBRACKET")
        let mut parameter_index = 0
        while not sem_is(context, "RBRACKET") {
            let parameter = sem_expect(context, "IDENT")
            if parameter_index >= len(type_params) or type_params[parameter_index] != parameter.val { report_error_at("W0006", parameter, "generic parameter list changed during collection") }
            if sem_match(context, "COLON") {
                let constraint = sem_expect(context, "IDENT")
                if kind == "class" or kind == "interface" {
                    let mut declared_interface = false
                    for candidate in context.types { if candidate.name == constraint.val and candidate.kind == "interface" { declared_interface = true } }
                    if not declared_interface { report_error_at("W2012", constraint, "generic constraint is not a declared interface") }
                }
            }
            parameter_index = parameter_index + 1
            if not sem_match(context, "COMMA") { break }
        }
        sem_expect(context, "RBRACKET")
    }
    let type_id = sem_named(context, name)
    let mut parent = ""
    let mut parent_args: list[int] = []
    let mut interfaces: list[SemInterfaceRef] = []
    if sem_match(context, "EXTENDS") {
        let parent_token = sem_expect(context, "IDENT")
        parent = parent_token.val
        let parent_generic = sem_generic_type(context, parent)
        if sem_match(context, "LBRACKET") {
            if parent_generic < 0 { report_error_at("W2001", parent_token, "base class is not generic: " + parent) }
            parent_args.append(sem_type(context))
            while sem_match(context, "COMMA") { parent_args.append(sem_type(context)) }
            sem_expect(context, "RBRACKET")
            if len(parent_args) != len(context.generic_types[parent_generic].params) { report_error_at("W2001", parent_token, "generic base class arity: " + parent) }
            sem_check_nominal_constraints(context, parent, parent_args, parent_token)
        } elif parent_generic >= 0 {
            report_error_at("W2001", parent_token, "generic base class requires type arguments: " + parent)
        }
    }
    if sem_match(context, "IMPLEMENTS") {
        while true {
            let iface_token = sem_expect(context, "IDENT")
            let iface_name = iface_token.val
            let iface_generic = sem_generic_type(context, iface_name)
            let mut iface_args: list[int] = []
            if sem_match(context, "LBRACKET") {
                if iface_generic < 0 { report_error_at("W2001", iface_token, "interface is not generic: " + iface_name) }
                iface_args.append(sem_type(context))
                while sem_match(context, "COMMA") { iface_args.append(sem_type(context)) }
                sem_expect(context, "RBRACKET")
                if len(iface_args) != len(context.generic_types[iface_generic].params) { report_error_at("W2001", iface_token, "generic type arity: " + iface_name) }
                sem_check_nominal_constraints(context, iface_name, iface_args, iface_token)
            } elif iface_generic >= 0 {
                report_error_at("W2001", iface_token, "generic type arguments required: " + iface_name)
            }
            interfaces.append(SemInterfaceRef { name: iface_name, args: iface_args })
            if not sem_match(context, "COMMA") { break }
        }
    }
    if kind == "class" { context.classes.append(SemClass { name: name, parent: parent, parent_args: parent_args, interfaces: interfaces }) }
    sem_expect(context, "LBRACE")
    while true {
        sem_skip_separators(context)
        if sem_is(context, "RBRACE") { break }
        let mut visible = true
        if sem_is(context, "AT") { sem_error(context, "W0006", "static attributes require a top-level function declaration") }
        if sem_match(context, "PRIVATE") { visible = false } else { sem_match(context, "PUBLIC") }
        let mut method_is_async = false
        if sem_is(context, "IDENT") and sem_at(context).val == "async" and context.tokens[context.pos + 1].kind == "FN" { sem_take(context) method_is_async = true }
        if sem_is(context, "FN") {
            sem_collect_function(context, name + ".", visible, method_is_async)
        }
        elif kind == "enum" {
            let variant = sem_expect(context, "IDENT").val
            let mut payload_types: list[int] = []
            if sem_match(context, "LPAREN") {
                if not sem_is(context, "RPAREN") {
                    payload_types.append(sem_type(context))
                    while sem_match(context, "COMMA") {
                        if sem_is(context, "RPAREN") { break }
                        payload_types.append(sem_type(context))
                    }
                }
                sem_expect(context, "RPAREN")
            }
            context.variants.append(variant)
            context.variant_types.append(type_id)
            context.variant_payloads.append(payload_types)
            sem_match(context, "COMMA")
        } else {
            let field = sem_expect(context, "IDENT").val
            sem_expect(context, "COLON")
            let field_type = sem_type(context)
            if sem_at(context).kind == "IDENT" and sem_at(context).val == "requires" {
                let mut depth_p = 0
                let mut depth_b = 0
                while not sem_is(context, "EOF") {
                    if sem_is(context, "LPAREN") { depth_p = depth_p + 1 }
                    elif sem_is(context, "RPAREN") { if depth_p > 0 { depth_p = depth_p - 1 } }
                    elif sem_is(context, "LBRACKET") { depth_b = depth_b + 1 }
                    elif sem_is(context, "RBRACKET") { if depth_b > 0 { depth_b = depth_b - 1 } }
                    elif (sem_is(context, "NEWLINE") or sem_is(context, "COMMA") or sem_is(context, "RBRACE")) and depth_p == 0 and depth_b == 0 { break }
                    sem_take(context)
                }
            }
            context.fields.append(SemField { owner: name, name: field, type_id: field_type, visible: visible })
            sem_match(context, "COMMA")
        }
    }
    sem_expect(context, "RBRACE")
    if kind == "enum" { context.completed_enums.append(name) }
    context.type_params = previous_type_params
}
fn sem_builtin(name: str) -> bool {
    return name == "join_strings" or name == "print" or name == "eprint" or name == "len" or name == "int" or name == "float" or name == "str" or name == "ord" or name == "chr" or name == "bytes" or name == "slice" or name == "args" or name == "env" or name == "unix_time" or name == "exit" or name == "enumerate" or name == "dict_items" or name == "read_file" or name == "write_file" or name == "Some" or name == "Ok" or name == "Err" or name == "weak" or name == "upgrade" or name == "contract_assert"
}
fn sem_call_builtin(context: SemanticContext, name: str, args: list[int], sources: list[Token], discard: bool) -> int {
    let count = len(args)
    if name == "print" or name == "eprint" { return context.unit_type }
    if name == "contract_assert" {
        if count != 2 { sem_error(context, "W2005", "contract_assert arity") }
        return context.unit_type
    }
    if name == "args" or name == "unix_time" {
        if count != 0 { sem_error(context, "W2005", name + " arity") }
        if name == "unix_time" { return context.integer_type }
        return sem_wrap(context, "list", context.string_type)
    }
    let mut arity = 1
    if name == "slice" { arity = 3 }
    if name == "write_file" or name == "join_strings" { arity = 2 }
    if count != arity { sem_error(context, "W2005", "builtin arity: " + name) }
    if name == "join_strings" {
        if count != 2 { sem_error(context, "W2005", "join_strings arity") }
        sem_require_at(context, args[0], sem_wrap(context, "list", context.string_type), "W2001", sem_source_at(context, sources, 0))
        sem_require_at(context, args[1], context.string_type, "W2001", sem_source_at(context, sources, 1))
        return context.string_type
    }
    let first = args[0]
    let kind = sem_kind(context, first)
    if name == "Some" { return sem_wrap(context, "optional", first) }
    if name == "Ok" or name == "Err" {
        if context.expected_type >= 0 and sem_kind(context, context.expected_type) == "result" {
            let channel = context.types[context.expected_type].args
            if name == "Ok" { if not discard or channel[0] != context.unit_type { sem_require_at(context, first, channel[0], "W2001", sem_source_at(context, sources, 0)) } }
            elif discard and channel[0] == context.unit_type { sem_require_at(context, first, channel[1], "W2004", sem_source_at(context, sources, 0)) }
            else { sem_require_at(context, first, channel[1], "W2001", sem_source_at(context, sources, 0)) }
            return context.expected_type
        }
        if name == "Ok" { return sem_wrap(context, "ok", first) }
        return sem_wrap(context, "err", first)
    }
    if name == "len" {
        if kind != "list" and kind != "dict" and kind != "tuple" and first != context.string_type { report_error_at("W2001", sem_source_at(context, sources, 0), "len requires a collection or string") }
        return context.integer_type
    }
    if name == "int" or name == "float" or name == "str" {
        if name != "str" and first != context.integer_type and first != context.float_type and first != context.string_type and first != context.boolean_type { report_error_at("W2001", sem_source_at(context, sources, 0), "conversion argument") }
        if name == "int" { return context.integer_type }
        if name == "float" { return context.float_type }
        return context.string_type
    }
    if name == "chr" or name == "exit" {
        sem_require_at(context, first, context.integer_type, "W2001", sem_source_at(context, sources, 0))
        if name == "chr" { return context.string_type }
        return context.unit_type
    }
    if name == "slice" {
        # SPEC 11.1: slice() is polymorphic over str and list[T] and preserves the
        # container kind.
        let first_type = context.types[first]
        sem_require_at(context, args[1], context.integer_type, "W2001", sem_source_at(context, sources, 1))
        sem_require_at(context, args[2], context.integer_type, "W2001", sem_source_at(context, sources, 2))
        if first == context.string_type { return context.string_type }
        if first_type.kind == "list" { return first }
        report_error_at("W2001", sem_source_at(context, sources, 0), "slice expects str or list")
        return context.string_type
    }
    if name == "env" {
        sem_require_at(context, first, context.string_type, "W2001", sem_source_at(context, sources, 0))
        return sem_wrap(context, "optional", context.string_type)
    }
    if name == "ord" or name == "bytes" or name == "read_file" or name == "write_file" {
        sem_require_at(context, first, context.string_type, "W2001", sem_source_at(context, sources, 0))
        if name == "ord" { return context.integer_type }
        if name == "bytes" { return sem_wrap(context, "list", context.integer_type) }
        let io = sem_named(context, "IoError")
        if name == "read_file" { return sem_intern(context, "result", "", [context.string_type, io]) }
        sem_require_at(context, args[1], context.string_type, "W2001", sem_source_at(context, sources, 1))
        return sem_intern(context, "result", "", [context.unit_type, io])
    }
    if name == "weak" {
        if kind != "class" { report_error_at("W2001", sem_source_at(context, sources, 0), "weak requires class") }
        return sem_wrap(context, "weak", first)
    }
    if name == "upgrade" {
        if kind != "weak" { report_error_at("W2001", sem_source_at(context, sources, 0), "upgrade requires weak") }
        return sem_wrap(context, "optional", context.types[first].args[0])
    }
    if name == "enumerate" {
        if kind != "list" { report_error_at("W2001", sem_source_at(context, sources, 0), "enumerate requires list") }
        return sem_wrap(context, "list", sem_intern(context, "tuple", "", [context.integer_type, context.types[first].args[0]]))
    }
    if name == "dict_items" {
        if kind != "dict" { report_error_at("W2001", sem_source_at(context, sources, 0), "dict_items requires dict") }
        return sem_wrap(context, "list", sem_intern(context, "tuple", "", context.types[first].args))
    }
    sem_error(context, "W1001", "unknown builtin")
    return context.unit_type
}
fn sem_check_call(context: SemanticContext, signature: int, args: list[int], sources: list[Token], discard: bool) -> int {
    let unification = SemUnification()
    let type_ = context.types[signature]
    if type_.kind == "builtin" { return sem_call_builtin(context, type_.name, args, sources, discard) }
    if type_.kind == "enum_ctor" {
        let mut separator = -1
        for i in 0..len(type_.name) - 1 { if slice(type_.name, i, i + 1) == "." { separator = i } }
        if separator < 0 { sem_error(context, "W9999", "invalid enum constructor metadata") }
        let owner = slice(type_.name, 0, separator)
        let variant = slice(type_.name, separator + 1, len(type_.name))
        if owner == "Option" and variant == "Some" {
            if len(args) != 1 { sem_error(context, "W2005", "Option.Some arity") }
            return sem_wrap(context, "optional", args[0])
        }
        if owner == "Result" and (variant == "Ok" or variant == "Err") {
            if len(args) != 1 { sem_error(context, "W2005", "Result constructor arity") }
            if context.expected_type >= 0 and sem_kind(context, context.expected_type) == "result" {
                let expected = context.types[context.expected_type]
                if variant == "Ok" { if not discard or expected.args[0] != context.unit_type { sem_require_at(context, args[0], expected.args[0], "W2001", sem_source_at(context, sources, 0)) } }
                elif discard and expected.args[0] == context.unit_type { sem_require_at(context, args[0], expected.args[1], "W2004", sem_source_at(context, sources, 0)) }
                else { sem_require_at(context, args[0], expected.args[1], "W2001", sem_source_at(context, sources, 0)) }
            }
            if variant == "Ok" { return sem_wrap(context, "ok", args[0]) }
            return sem_wrap(context, "err", args[0])
        }
        let mut target = type_.args[0]
        let generic = sem_generic_type(context, owner)
        let mut payload_types: list[int] = []
        for i in 1..len(type_.args) { payload_types.append(type_.args[i]) }
        if len(args) != len(payload_types) { sem_error(context, "W2005", "enum constructor arity: " + owner + "." + variant) }
        if generic >= 0 and len(context.types[target].args) == 0 {
            let empty_names: list[str] = []
            let empty_types: list[int] = []
            unification.names = empty_names
            unification.types = empty_types
            for i in 0..len(args) { if not sem_unify_type(context, unification, payload_types[i], args[i]) { report_error_at("W2001", sem_source_at(context, sources, i), "enum payload type mismatch") } }
            let mut concrete: list[int] = []
            for parameter in context.generic_types[generic].params {
                let mut found = -1
                for i in 0..len(unification.names) { if unification.names[i] == parameter { found = unification.types[i] } }
                if found < 0 { sem_error(context, "W2001", "cannot infer enum type argument: " + parameter) }
                concrete.append(found)
            }
            target = sem_intern(context, "enum", owner, concrete)
            sem_check_nominal_constraints(context, owner, concrete, sem_source_at(context, sources, 0))
        } elif generic >= 0 {
            unification.names = context.generic_types[generic].params
            unification.types = context.types[target].args
            for i in 0..len(args) {
                sem_require_at(context, args[i], sem_substitute_type(context, payload_types[i], unification.names, unification.types), "W2001", sem_source_at(context, sources, i))
            }
        } else {
            for i in 0..len(args) { sem_require_at(context, args[i], payload_types[i], "W2001", sem_source_at(context, sources, i)) }
        }
        return target
    }
    if type_.kind == "struct_ctor" {
        let generic = sem_generic_type(context, type_.name)
        let mut target = sem_named(context, type_.name)
        let mut explicit = false
        if len(type_.args) == 1 { target = type_.args[0] explicit = true }
        let mut fields: list[int] = []
        for i in 0..len(context.fields) { if context.fields[i].owner == type_.name { fields.append(i) } }
        if len(args) != len(fields) { sem_error(context, "W2005", "struct constructor arity: " + type_.name) }
        let empty_names: list[str] = []
        let empty_types: list[int] = []
        unification.names = empty_names
        unification.types = empty_types
        if explicit and generic >= 0 {
            unification.names = context.generic_types[generic].params
            unification.types = context.types[target].args
        }
        for i in 0..len(args) {
            let field_type = context.fields[fields[i]].type_id
            if generic >= 0 and not explicit { sem_unify_type(context, unification, field_type, args[i]) }
            sem_require_at(context, args[i], sem_substitute_type(context, field_type, unification.names, unification.types), "W2001", sem_source_at(context, sources, i))
        }
        if generic >= 0 and not explicit {
            let mut concrete: list[int] = []
            for parameter in context.generic_types[generic].params {
                let mut inferred = -1
                for i in 0..len(unification.names) { if unification.names[i] == parameter { inferred = unification.types[i] } }
                if inferred < 0 { sem_error(context, "W2001", "cannot infer generic struct type argument: " + parameter) }
                concrete.append(inferred)
            }
            target = sem_intern(context, context.generic_types[generic].kind, type_.name, concrete)
            sem_check_nominal_constraints(context, type_.name, concrete, sem_source_at(context, sources, 0))
        }
        return target
    }
    if type_.kind == "constructor" {
        let target = type_.args[0]
        let method = sem_method(context, context.types[target].name, "init")
        if method >= 0 {
            let mut selected = context.functions[method].type_id
            let owner_name = slice(context.functions[method].owner, 0, len(context.functions[method].owner) - 1)
            let owner_type_id = sem_resolve_member_owner(context, target, owner_name)
            let owner_type = context.types[owner_type_id]
            let generic = sem_generic_type(context, owner_type.name)
            if generic >= 0 { selected = sem_substitute_type(context, selected, context.generic_types[generic].params, owner_type.args) }
            sem_check_call(context, selected, args, sources, false)
        }
        elif len(args) != 0 { sem_error(context, "W2005", "constructor arity") }
        return target
    }
    if type_.kind == "dependent" and sem_defer(context, "call", [signature]) { return signature }
    if type_.kind != "function" { sem_error(context, "W2005", "value is not callable") }
    if len(type_.args) != len(args) + 1 { sem_error(context, "W2005", "call arity") }
    let empty_names: list[str] = []
    let empty_types: list[int] = []
    unification.names = empty_names
    unification.types = empty_types
    for i in 0..len(args) { sem_unify_type(context, unification, type_.args[i], args[i]) }
    for i in 0..len(args) {
        let expected = sem_substitute_type(context, type_.args[i], unification.names, unification.types)
        sem_require_at(context, args[i], expected, "W2001", sem_source_at(context, sources, i))
    }
    return sem_substitute_type(context, type_.args[len(args)], unification.names, unification.types)
}
fn sem_substitute_type(context: SemanticContext, type_id: int, names: list[str], values: list[int]) -> int {
    let type_ = context.types[type_id]
    if type_.kind == "typeparam" {
        for i in 0..len(names) { if names[i] == type_.name { return values[i] } }
        return type_id
    }
    if len(type_.args) == 0 { return type_id }
    let mut replaced: list[int] = []
    let mut changed = false
    for arg in type_.args {
        let next = sem_substitute_type(context, arg, names, values)
        replaced.append(next)
        if next != arg { changed = true }
    }
    if not changed { return type_id }
    if type_.kind == "error_union" { return sem_intern_error_union(context, replaced) }
    return sem_intern(context, type_.kind, type_.name, replaced)
}
fn sem_unify_type(context: SemanticContext, unification: SemUnification, pattern: int, actual: int) -> bool {
    let expected = context.types[pattern]
    if expected.kind == "typeparam" {
        for i in 0..len(unification.names) {
            if unification.names[i] == expected.name { return unification.types[i] == actual }
        }
        unification.names.append(expected.name)
        unification.types.append(actual)
        return true
    }
    let actual_type = context.types[actual]
    if actual_type.kind == "class" and (expected.kind == "interface" or (expected.kind == "class" and expected.name != actual_type.name)) {
        let mut cur = actual
        let mut visits = 0
        while cur >= 0 and visits <= len(context.classes) {
            let ct = context.types[cur]
            if expected.kind == "class" and ct.name == expected.name {
                if len(expected.args) != len(ct.args) { return false }
                for i in 0..len(expected.args) {
                    if not sem_unify_type(context, unification, expected.args[i], ct.args[i]) { return false }
                }
                return true
            }
            if expected.kind == "interface" {
                for iface_id in sem_class_interface_types(context, cur) {
                    let it = context.types[iface_id]
                    if it.name == expected.name and len(expected.args) == len(it.args) {
                        let mut ok = true
                        for i in 0..len(expected.args) {
                            if not sem_unify_type(context, unification, expected.args[i], it.args[i]) { ok = false break }
                        }
                        if ok { return true }
                        return false
                    }
                }
            }
            cur = sem_class_parent_type(context, cur)
            visits = visits + 1
        }
        return false
    }
    if expected.kind != actual_type.kind or expected.name != actual_type.name or len(expected.args) != len(actual_type.args) { return false }
    for i in 0..len(expected.args) {
        if not sem_unify_type(context, unification, expected.args[i], actual_type.args[i]) { return false }
    }
    return true
}
fn sem_field(context: SemanticContext, owner: str, name: str) -> int {
    let mut current = owner
    let mut visits = 0
    while current != "" and visits <= len(context.classes) {
        for i in 0..len(context.fields) {
            let field = context.fields[i]
            if field.owner == current and field.name == name { return i }
        }
        let mut next = ""
        for class_ in context.classes { if class_.name == current { next = class_.parent } }
        current = next
        visits = visits + 1
    }
    return -1
}
fn sem_member(context: SemanticContext, receiver: SemValue, name: str, location: Token) -> SemValue {
    let type_ = context.types[receiver.type_id]
    if type_.kind == "typeparam" {
        let mut constraint = ""
        for i in 0..len(context.type_params) {
            if context.type_params[i] == type_.name and i < len(context.active_constraints) { constraint = context.active_constraints[i] }
        }
        if constraint != "" {
            let method_index = sem_method(context, constraint, name)
            if method_index >= 0 {
                let method = context.functions[method_index]
                let mut m_sig = method.type_id
                if method.is_async and not sem_symbolic(context, m_sig) { m_sig = sem_external_async_signature(context, m_sig) }
                return SemValue { type_id: m_sig, root: "#method", writable: -1, terminates: false, node: -1 }
            }
        }
        if sem_defer(context, "member:" + name, [receiver.type_id]) { return sem_value(sem_intern(context, "dependent", name, [receiver.type_id])) }
        report_error_at("W3002", location, "unknown member on generic type parameter: " + name)
    }
    if type_.kind == "enum" {
        for i in 0..len(context.variants) {
            if context.variants[i] == name and context.types[context.variant_types[i]].name == type_.name {
                if len(context.variant_payloads[i]) == 0 { return sem_value(receiver.type_id) }
                let mut arguments: list[int] = [receiver.type_id]
                for payload in context.variant_payloads[i] { arguments.append(payload) }
                return sem_value(sem_intern(context, "enum_ctor", type_.name + "." + name, arguments))
            }
        }
        report_error_at("W1001", location, "unknown enum variant")
    }
    if type_.kind == "optional" and (name == "Some" or name == "None") {
        if name == "None" { return sem_value(context.none_type) }
        return sem_value(sem_intern(context, "enum_ctor", "Option.Some", [receiver.type_id, type_.args[0]]))
    }
    if type_.kind == "result" and (name == "Ok" or name == "Err") {
        let mut payload = type_.args[0]
        if name == "Err" { payload = type_.args[1] }
        return sem_value(sem_intern(context, "enum_ctor", "Result." + name, [receiver.type_id, payload]))
    }
    if type_.kind == "list" or type_.kind == "dict" {
        let mut args: list[int] = []
        if name == "append" and type_.kind == "list" {
            sem_mutable_at(context, receiver.root, location)
            args = [type_.args[0], context.unit_type]
        } elif name == "pop" and type_.kind == "list" {
            sem_mutable_at(context, receiver.root, location)
            args = [type_.args[0]]
        } elif name == "clear" and type_.kind == "list" {
            sem_mutable_at(context, receiver.root, location)
            args = [context.unit_type]
        } elif name == "contains" and type_.kind == "list" {
            args = [type_.args[0], context.boolean_type]
        } elif name == "is_empty" and type_.kind == "list" {
            args = [context.boolean_type]
        } elif name == "get" and type_.kind == "dict" { args = [type_.args[0], sem_wrap(context, "optional", type_.args[1])] }
        elif name == "keys" and type_.kind == "dict" { args = [sem_wrap(context, "list", type_.args[0])] }
        elif name == "values" and type_.kind == "dict" { args = [sem_wrap(context, "list", type_.args[1])] }
        elif name == "items" and type_.kind == "dict" { args = [sem_wrap(context, "list", sem_intern(context, "tuple", "", type_.args))] }
        elif name == "contains" and type_.kind == "dict" { args = [type_.args[0], context.boolean_type] }
        elif name == "is_empty" and type_.kind == "dict" { args = [context.boolean_type] }
        elif name == "remove" and type_.kind == "dict" {
            sem_mutable_at(context, receiver.root, location)
            args = [type_.args[0], sem_wrap(context, "optional", type_.args[1])]
        } elif name == "clear" and type_.kind == "dict" {
            sem_mutable_at(context, receiver.root, location)
            args = [context.unit_type]
        } else { report_error_at("W3002", location, "unknown collection method") }
        return SemValue { type_id: sem_intern(context, "function", "", args), root: "#collection", writable: -1, terminates: false, node: -1 }
    }
    if receiver.type_id == context.string_type {
        let mut args: list[int] = []
        if name == "contains" { args = [context.string_type, context.boolean_type] }
        elif name == "is_empty" { args = [context.boolean_type] }
        elif name == "trim" or name == "to_lower" or name == "to_upper" { args = [context.string_type] }
        elif name == "split" { args = [context.string_type, sem_wrap(context, "list", context.string_type)] }
        elif name == "starts_with" or name == "ends_with" { args = [context.string_type, context.boolean_type] }
        elif name == "replace" { args = [context.string_type, context.string_type, context.string_type] }
        else { report_error_at("W3002", location, "unknown string method: " + name) }
        return SemValue { type_id: sem_intern(context, "function", "", args), root: "#collection", writable: -1, terminates: false, node: -1 }
    }
    let field_index = sem_field(context, type_.name, name)
    if field_index >= 0 {
        let field = context.fields[field_index]
        if not field.visible and context.owner != field.owner { report_error_at("W3002", location, "private field") }
        if context.initializing and receiver.root == "this" and field.owner == context.owner {
            let mut found = false
            for initialized in context.initialized { if initialized == name { found = true } }
            if not found and not sem_is(context, "ASSIGN") { report_error_at("W3004", location, "read before initialization") }
        }
        let mut root = receiver.root
        if type_.kind == "class" {
            root = ""
            if context.initializing and receiver.root == "this" { root = "this:" + name }
        }
        let mut field_type = field.type_id
        let field_owner_type_id = sem_resolve_member_owner(context, receiver.type_id, field.owner)
        let field_owner_type = context.types[field_owner_type_id]
        let generic = sem_generic_type(context, field_owner_type.name)
        if generic >= 0 and len(field_owner_type.args) == len(context.generic_types[generic].params) {
            field_type = sem_substitute_type(context, field_type, context.generic_types[generic].params, field_owner_type.args)
        }
        return SemValue { type_id: field_type, root: root, writable: field_type, terminates: false, node: -1 }
    }
    let method_index = sem_method(context, type_.name, name)
    if method_index >= 0 {
        let method = context.functions[method_index]
        if not method.visible and method.owner != context.owner + "." { report_error_at("W3002", location, "private method access") }
        let mut method_type = method.type_id
        let method_owner_name = if len(method.owner) > 0 { slice(method.owner, 0, len(method.owner) - 1) } else { type_.name }
        let method_owner_type_id = sem_resolve_member_owner(context, receiver.type_id, method_owner_name)
        let method_owner_type = context.types[method_owner_type_id]
        let generic = sem_generic_type(context, method_owner_type.name)
        if generic >= 0 and len(method_owner_type.args) == len(context.generic_types[generic].params) {
            method_type = sem_substitute_type(context, method_type, context.generic_types[generic].params, method_owner_type.args)
        }
        if method.is_async and not sem_symbolic(context, method_type) {
            method_type = sem_external_async_signature(context, method_type)
        }
        return SemValue { type_id: method_type, root: "#method", writable: -1, terminates: false, node: -1 }
    }
    report_error_at("W3002", location, "unknown member: " + name)
    return sem_value(context.unit_type)
}
fn sem_group_is_tuple(context: SemanticContext) -> bool {
    let mut position = context.pos
    let mut depth = 0
    while position < len(context.tokens) {
        let kind = context.tokens[position].kind
        if depth == 0 and kind == "RPAREN" { return false }
        if depth == 0 and kind == "COMMA" { return true }
        if kind == "LPAREN" or kind == "LBRACE" or kind == "LBRACKET" { depth = depth + 1 }
        elif kind == "RPAREN" or kind == "RBRACE" or kind == "RBRACKET" { depth = depth - 1 }
        position = position + 1
    }
    return false
}

fn sem_prefix(context: SemanticContext, allow_struct: bool, statement: bool) -> SemValue {
    let source = sem_at(context)
    if sem_is(context, "PIPE") { return sem_lambda(context) }
    if sem_match(context, "INT") { return sem_expr(context, "integer", sem_value(context.integer_type), source, source.val, [], -1, -1) }
    if sem_match(context, "FLOAT") { return sem_expr(context, "float", sem_value(context.float_type), source, source.val, [], -1, -1) }
    if sem_match(context, "STR") { return sem_expr(context, "string", sem_value(context.string_type), source, source.val, [], -1, -1) }
    if sem_match(context, "TRUE") or sem_match(context, "FALSE") { return sem_expr(context, "boolean", sem_value(context.boolean_type), source, source.kind, [], -1, -1) }
    if sem_match(context, "MINUS") {
        let value_source = sem_at(context)
        let value = sem_expression(context, 9, allow_struct)
        if value.type_id != context.integer_type and value.type_id != context.float_type { report_error_at("W2001", value_source, "numeric negation") }
        return sem_expr(context, "unary", sem_value(value.type_id), source, "MINUS", [value.node], -1, -1)
    }
    if sem_match(context, "NOT") {
        let operand_source = sem_at(context)
        let operand = sem_expression(context, 9, allow_struct)
        sem_require_at(context, operand.type_id, context.boolean_type, "W2001", operand_source)
        return sem_expr(context, "unary", sem_value(context.boolean_type), source, "NOT", [operand.node], -1, -1)
    }
    if sem_is(context, "IDENT") and sem_at(context).val == "await" and expression_starter(context.tokens[context.pos + 1].kind) {
        sem_take(context)
        let operand = sem_expression(context, 10, allow_struct)
        let mut awaited_type = operand.type_id
        let op_type = context.types[awaited_type]
        if (op_type.kind == "struct" or op_type.kind == "class") and len(op_type.args) > 0 {
            awaited_type = op_type.args[0]
        } elif op_type.kind == "struct" or op_type.kind == "class" {
            for field in context.fields {
                if field.owner == op_type.name and field.name == "value" {
                    let ft = field.type_id
                    if sem_kind(context, ft) == "optional" { awaited_type = context.types[ft].args[0] } else { awaited_type = ft }
                }
            }
        }
        return sem_expr(context, "unary", sem_value(awaited_type), source, "AWAIT", [operand.node], -1, -1)
    }
    if sem_match(context, "LPAREN") {
        if sem_match(context, "RPAREN") {
            let empty: list[int] = []
            return sem_expr(context, "tuple", sem_value(sem_intern(context, "tuple", "", empty)), source, "", [], -1, -1)
        }
        let outer_expected_group = context.expected_type
        let expected_tuple = sem_unwrap_expected_payload(context, context.expected_type)
        let is_tuple_ctx = expected_tuple >= 0 and sem_kind(context, expected_tuple) == "tuple" and sem_group_is_tuple(context)
        context.statement_context = statement and not sem_group_is_tuple(context) and
            not sem_delimited_expression_suffix(context.tokens, context.pos - 1, "LPAREN", "RPAREN")
        if is_tuple_ctx and len(context.types[expected_tuple].args) > 0 {
            context.expected_type = context.types[expected_tuple].args[0]
        }
        let first = sem_expression(context, 0, true)
        if sem_match(context, "COMMA") {
            if is_tuple_ctx and len(context.types[expected_tuple].args) > 0 { sem_require_at(context, first.type_id, context.types[expected_tuple].args[0], "W2001", source) }
            let mut types: list[int] = [if is_tuple_ctx and len(context.types[expected_tuple].args) > 0 { context.types[expected_tuple].args[0] } else { first.type_id }]
            let mut values: list[int] = [first.node]
            let mut elem_idx = 1
            while not sem_is(context, "RPAREN") {
                if is_tuple_ctx and elem_idx < len(context.types[expected_tuple].args) {
                    context.expected_type = context.types[expected_tuple].args[elem_idx]
                } else {
                    context.expected_type = -1
                }
                let next = sem_expression(context, 0, true)
                if is_tuple_ctx and elem_idx < len(context.types[expected_tuple].args) {
                    sem_require_at(context, next.type_id, context.types[expected_tuple].args[elem_idx], "W2001", source)
                    types.append(context.types[expected_tuple].args[elem_idx])
                } else { types.append(next.type_id) }
                values.append(next.node)
                elem_idx = elem_idx + 1
                if not sem_match(context, "COMMA") { break }
            }
            context.expected_type = outer_expected_group
            sem_expect(context, "RPAREN")
            return sem_expr(context, "tuple", sem_value(sem_intern(context, "tuple", "", types)), source, "", values, -1, -1)
        }
        context.expected_type = outer_expected_group
        sem_expect(context, "RPAREN")
        return first
    }
    if sem_match(context, "LBRACKET") {
        if sem_match(context, "RBRACKET") {
            let expected = sem_unwrap_expected_payload(context, context.expected_type)
            let type_id = if expected >= 0 and sem_kind(context, expected) == "list" { expected } else { sem_wrap(context, "list", sem_simple(context, "any")) }
            return sem_expr(context, "list", sem_value(type_id), source, "", [], -1, -1)
        }
        let outer_expected_list = context.expected_type
        let expected_container = sem_unwrap_expected_payload(context, context.expected_type)
        let mut element = -1
        if expected_container >= 0 and sem_kind(context, expected_container) == "list" { element = context.types[expected_container].args[0] }
        context.expected_type = element
        let initial_source = sem_at(context)
        let initial = sem_expression(context, 0, true)
        let mut values: list[int] = [initial.node]
        let mut first = initial.type_id
        if element >= 0 { sem_require_at(context, first, element, "W2001", initial_source) first = element }
        while sem_match(context, "COMMA") {
            if sem_is(context, "RBRACKET") { break }
            let next_source = sem_at(context)
            let next = sem_expression(context, 0, true)
            sem_require_at(context, next.type_id, first, "W2001", next_source)
            values.append(next.node)
        }
        sem_expect(context, "RBRACKET")
        context.expected_type = outer_expected_list
        return sem_expr(context, "list", sem_value(sem_wrap(context, "list", first)), source, "", values, -1, -1)
    }
    if sem_match(context, "LBRACE") {
        if sem_match(context, "RBRACE") {
            let expected = sem_unwrap_expected_payload(context, context.expected_type)
            let type_id = if expected >= 0 and sem_kind(context, expected) == "dict" { expected } else { sem_intern(context, "dict", "", [sem_simple(context, "any"), sem_simple(context, "any")]) }
            return sem_expr(context, "dict", sem_value(type_id), source, "", [], -1, -1)
        }
        let outer_expected_dict = context.expected_type
        let expected_container = sem_unwrap_expected_payload(context, context.expected_type)
        let mut expected_key = -1
        let mut expected_value = -1
        if expected_container >= 0 and sem_kind(context, expected_container) == "dict" {
            expected_key = context.types[expected_container].args[0]
            expected_value = context.types[expected_container].args[1]
        }
        context.expected_type = expected_key
        let key_source = sem_at(context)
        let key_value = sem_expression(context, 0, true)
        let key = key_value.type_id
        context.expected_type = expected_container
        if not sem_key(context, key) { report_error_at("W2010", key_source, "invalid dictionary key") }
        if expected_key >= 0 { sem_require_at(context, key, expected_key, "W2001", key_source) }
        sem_expect(context, "COLON")
        context.expected_type = expected_value
        let first_value_source = sem_at(context)
        let first_value = sem_expression(context, 0, true)
        let value = first_value.type_id
        let mut values: list[int] = [key_value.node, first_value.node]
        context.expected_type = expected_container
        if expected_value >= 0 { sem_require_at(context, value, expected_value, "W2001", first_value_source) }
        while sem_match(context, "COMMA") {
            if sem_is(context, "RBRACE") { break }
            context.expected_type = expected_key
            let next_key_source = sem_at(context)
            let next_key_value = sem_expression(context, 0, true)
            let next_key = next_key_value.type_id
            values.append(next_key_value.node)
            context.expected_type = expected_container
            sem_require_at(context, next_key, key, "W2001", next_key_source)
            sem_expect(context, "COLON")
            context.expected_type = expected_value
            let next_value_source = sem_at(context)
            let next_value_expression = sem_expression(context, 0, true)
            let next_value = next_value_expression.type_id
            values.append(next_value_expression.node)
            context.expected_type = expected_container
            sem_require_at(context, next_value, value, "W2001", next_value_source)
        }
        sem_expect(context, "RBRACE")
        context.expected_type = outer_expected_dict
        let type_id = if expected_key >= 0 { expected_container } else { sem_intern(context, "dict", "", [key, value]) }
        return sem_expr(context, "dict", sem_value(type_id), source, "", values, -1, -1)
    }
    if sem_is(context, "IF") { return sem_if(context, statement) }
    if sem_is(context, "MATCH") { return sem_match_expression(context, statement) }
    if sem_is(context, "THIS") or sem_is(context, "SUPER") {
        if context.capture_depth >= 0 { report_error_at("W2001", source, "capture receiver through explicit local binding") }
        let is_super = sem_take(context).kind == "SUPER"
        if context.owner == "" { report_error_at("W1004", source, "receiver outside method") }
        let mut owner = context.owner
        if is_super {
            owner = ""
            for class_ in context.classes { if class_.name == context.owner { owner = class_.parent } }
            if owner == "" { report_error_at("W1004", source, "super without base class") }
        }
        let symbol = sem_lookup(context, "self")
        if symbol < 0 { report_error_at("W9999", source, "checked receiver binding missing") }
        let mut target_type = context.variables[symbol].type_id
        if is_super {
            target_type = sem_class_parent_type(context, target_type)
            if target_type < 0 { target_type = sem_named(context, owner) }
        }
        return sem_expr(context, if is_super { "super" } else { "binding" }, SemValue { type_id: target_type, root: "this", writable: -1, terminates: false, node: -1 }, source, "self", [], context.variables[symbol].binding, -1)
    }
    let name_token = sem_expect(context, "IDENT")
    let name = name_token.val
    if name == "new" and sem_is(context, "IDENT") {
        report_error_at("W0006", name_token, "the 'new' keyword has been removed; construct classes directly with 'ClassName(...)'")
    }
    let variable = sem_lookup(context, name)
    if variable >= 0 {
        let value = context.variables[variable]
        if context.capture_depth >= 0 and value.depth < context.capture_depth and not module_contains(context.capture_names, name) { context.capture_names.append(name) }
        return sem_expr(context, "binding", SemValue { type_id: value.type_id, root: name, writable: value.type_id, terminates: false, node: -1 }, source, name, [], value.binding, -1)
    }
    if name == "None" { return sem_expr(context, "none", sem_value(context.none_type), source, "", [], -1, -1) }
    if name == "Option" or name == "Result" {
        sem_expect(context, "DOT")
        let variant_token = sem_expect(context, "IDENT")
        let variant = variant_token.val
        if name == "Option" and variant == "None" { return sem_expr(context, "none", sem_value(context.none_type), source, "", [], -1, -1) }
        if name == "Option" and variant == "Some" or name == "Result" and (variant == "Ok" or variant == "Err") {
            let empty: list[int] = []
            return sem_expr(context, "callee", sem_value(sem_intern(context, "enum_ctor", name + "." + variant, empty)), source, variant, [], -1, -1)
        }
        report_error_at("W1001", variant_token, "unknown built-in enum variant: " + name + "." + variant)
    }
    if sem_builtin(name) {
        let empty: list[int] = []
        return sem_expr(context, "callee", sem_value(sem_intern(context, "builtin", name, empty)), source, name, [], -1, -1)
    }
    let function = sem_function(context, name)
    if function >= 0 {
        let signature = context.functions[function]
        let mut type_id = signature.type_id
        if len(signature.type_params) > 0 and sem_match(context, "LBRACKET") {
            let mut arguments: list[int] = []
            while not sem_is(context, "RBRACKET") {
                arguments.append(sem_type(context))
                if not sem_match(context, "COMMA") { break }
            }
            sem_expect(context, "RBRACKET")
            if len(arguments) != len(signature.type_params) { report_error_at("W2001", source, "generic function type arity") }
            let mut substitutions: list[int] = []
            for parameter in signature.type_params {
                let empty: list[int] = []
                substitutions.append(sem_intern(context, "typeparam", parameter, empty))
            }
            let target = context.types[signature.type_id]
            let mut specialized: list[int] = []
            for part in target.args { specialized.append(sem_substitute_type(context, part, signature.type_params, arguments)) }
            type_id = sem_intern(context, "function", "", specialized)
        }
        if context.functions[function].is_async and not sem_symbolic(context, type_id) {
            type_id = sem_external_async_signature(context, type_id)
        }
        return sem_expr(context, "callee", SemValue { type_id: type_id, root: "fn:" + name, writable: -1, terminates: false, node: -1 }, source, name, [], -1, function)
    }
    let generic_type = sem_generic_type(context, name)
    let mut selected_type = -1
    if generic_type >= 0 and sem_match(context, "LBRACKET") {
        let mut type_arguments: list[int] = []
        while not sem_is(context, "RBRACKET") {
            type_arguments.append(sem_type(context))
            if not sem_match(context, "COMMA") { break }
        }
        sem_expect(context, "RBRACKET")
        if len(type_arguments) != len(context.generic_types[generic_type].params) { report_error_at("W2001", source, "generic type arity: " + name) }
        sem_check_nominal_constraints(context, name, type_arguments, source)
        selected_type = sem_intern(context, context.generic_types[generic_type].kind, name, type_arguments)
    } elif context.expected_type >= 0 and generic_type >= 0 and sem_same_type_declaration(context, sem_named(context, name), context.expected_type) {
        selected_type = context.expected_type
    }
    let mut named_type = selected_type
    if named_type < 0 {
        for i in 0..len(context.types) {
            if context.types[i].name == name and (context.types[i].kind == "class" or context.types[i].kind == "struct" or context.types[i].kind == "enum") {
                if len(context.types[i].args) == 0 { named_type = i }
            }
        }
    }
    if named_type < 0 {
        let mut variant = -1
        for i in 0..len(context.variants) {
            if context.variants[i] == name {
                if variant >= 0 { report_error_at("W1001", name_token, "ambiguous enum variant: " + name) }
                if len(context.variant_payloads[i]) > 0 { report_error_at("W2005", name_token, "enum variant requires a payload: " + name) }
                variant = context.variant_types[i]
            }
        }
        if variant >= 0 {
            let value = sem_expr(context, "enum", sem_value(variant), source, name, [], -1, -1)
            if context.capture_nodes { context.nodes[value.node].labels = [context.types[variant].name, name] }
            return value
        }
        if name == "none" { report_error_at("W1001", name_token, "unknown identifier: none (lowercase 'none' has been removed; use canonical 'None')") }
        report_error_at("W1001", name_token, "unknown identifier: " + name)
    }
    if sem_kind(context, named_type) == "class" { return sem_expr(context, "new_callee", sem_value(sem_wrap(context, "constructor", named_type)), source, name, [], -1, -1) }
    if sem_kind(context, named_type) == "struct" {
        if sem_is(context, "LPAREN") {
            let mut target_types: list[int] = []
            if selected_type >= 0 { target_types.append(selected_type) }
            return sem_expr(context, "constructor", sem_value(sem_intern(context, "struct_ctor", name, target_types)), source, name, [], -1, -1)
        }
        if allow_struct and sem_match(context, "LBRACE") {
            let unification = SemUnification()
            let empty_names: list[str] = []
            let empty_types: list[int] = []
            unification.names = empty_names
            unification.types = empty_types
            if selected_type >= 0 and generic_type >= 0 {
                unification.names = context.generic_types[generic_type].params
                unification.types = context.types[selected_type].args
            }
            let mut has_spread = false
            let mut spread_val = sem_value(-1)
            let mut spread_source = source
            let mut initialized: list[str] = []
            let mut values: list[int] = []
            while not sem_is(context, "RBRACE") {
                if sem_match(context, "NEWLINE") { continue }
                if sem_is(context, "DOT_DOT") {
                    let dot_tok = sem_take(context)
                    if has_spread { report_error_at("W0006", dot_tok, "multiple spread expressions in struct literal") }
                    let prev_sp_ctx = context.expected_type
                    context.expected_type = if selected_type >= 0 { selected_type } else { -1 }
                    spread_source = sem_at(context)
                    spread_val = sem_expression(context, 0, true)
                    context.expected_type = prev_sp_ctx
                    has_spread = true
                    if generic_type >= 0 and selected_type < 0 and sem_kind(context, spread_val.type_id) == context.generic_types[generic_type].kind and context.types[spread_val.type_id].name == name {
                        let gparams = context.generic_types[generic_type].params
                        let sp_args = context.types[spread_val.type_id].args
                        if len(gparams) == len(sp_args) {
                            for pi in 0..len(gparams) {
                                let mut already = false
                                for ni in 0..len(unification.names) {
                                    if unification.names[ni] == gparams[pi] { already = true }
                                }
                                if not already {
                                    unification.names.append(gparams[pi])
                                    unification.types.append(sp_args[pi])
                                }
                            }
                        }
                    }
                    sem_match(context, "COMMA")
                    while sem_match(context, "NEWLINE") {}
                    continue
                }
                let field_token = sem_at(context)
                let field_name = sem_expect(context, "IDENT").val
                let field = sem_field(context, name, field_name)
                if field < 0 { report_error_at("W3002", field_token, "unknown struct field") }
                for previous in initialized { if previous == field_name { report_error_at("W2007", field_token, "duplicate initializer") } }
                initialized.append(field_name)
                sem_expect(context, "COLON")
                let field_context = context.expected_type
                let field_type = sem_substitute_type(context, context.fields[field].type_id, unification.names, unification.types)
                context.expected_type = if sem_symbolic(context, field_type) { -1 } else { field_type }
                let field_value_source = sem_at(context)
                let expression = sem_expression(context, 0, true)
                context.expected_type = field_context
                let actual = expression.type_id
                values.append(expression.node)
                if generic_type >= 0 and selected_type < 0 { sem_unify_type(context, unification, context.fields[field].type_id, actual) }
                let expected = sem_substitute_type(context, context.fields[field].type_id, unification.names, unification.types)
                sem_require_at(context, actual, expected, "W2001", field_value_source)
                sem_match(context, "COMMA")
                while sem_match(context, "NEWLINE") {}
            }
            sem_expect(context, "RBRACE")
            if generic_type >= 0 and selected_type < 0 {
                let mut concrete_types: list[int] = []
                for parameter in context.generic_types[generic_type].params {
                    let mut concrete = -1
                    for i in 0..len(unification.names) { if unification.names[i] == parameter { concrete = unification.types[i] } }
                    if concrete < 0 { report_error_at("W2001", source, "cannot infer generic struct type argument: " + parameter) }
                    concrete_types.append(concrete)
                }
                named_type = sem_intern(context, context.generic_types[generic_type].kind, name, concrete_types)
                sem_check_nominal_constraints(context, name, concrete_types, source)
            }
            if has_spread {
                sem_require_at(context, spread_val.type_id, named_type, "W2001", spread_source)
                let mut missing_names: list[str] = []
                let mut missing_types: list[int] = []
                for field in context.fields {
                    if field.owner == name {
                        let mut found = false
                        for candidate in initialized { if candidate == field.name { found = true } }
                        if not found {
                            let ftype = sem_substitute_type(context, field.type_id, unification.names, unification.types)
                            missing_names.append(field.name)
                            missing_types.append(ftype)
                        }
                    }
                }
                if len(missing_names) > 1 and context.capture_nodes and spread_val.node >= 0 and context.nodes[spread_val.node].kind != "binding" {
                    let sp_scope = sem_enter_scope(context)
                    let sp_binding = sem_declare(context, "__wysna_spread", spread_val.type_id, false)
                    let sp_let = sem_node(context, "let", context.unit_type, spread_source, "__wysna_spread", [spread_val.node], sp_binding, -1)
                    for mi in 0..len(missing_names) {
                        let sp_ref = sem_node(context, "binding", spread_val.type_id, spread_source, "__wysna_spread", [], sp_binding, -1)
                        let sp_member = sem_node(context, "member", missing_types[mi], spread_source, missing_names[mi], [sp_ref], -1, -1)
                        initialized.append(missing_names[mi])
                        values.append(sp_member)
                    }
                    let constructed_sp = sem_expr(context, "struct", sem_value(named_type), source, name, values, -1, -1)
                    if context.capture_nodes { context.nodes[constructed_sp.node].labels = initialized }
                    sem_leave_scope(context, sp_scope)
                    let wrapped = sem_node(context, "block", named_type, source, "", [sp_let, constructed_sp.node], -1, -1)
                    return SemValue { type_id: named_type, root: "", writable: -1, terminates: false, node: wrapped }
                } else {
                    for mi in 0..len(missing_names) {
                        let sp_member = sem_node(context, "member", missing_types[mi], spread_source, missing_names[mi], [spread_val.node], -1, -1)
                        initialized.append(missing_names[mi])
                        values.append(sp_member)
                    }
                }
            }
            for field in context.fields {
                if field.owner == name {
                    let mut found = false
                    for candidate in initialized { if candidate == field.name { found = true } }
                    if not found { report_error_at("W2007", source, "missing struct field") }
                }
            }
            let constructed = sem_expr(context, "struct", sem_value(named_type), source, name, values, -1, -1)
            if context.capture_nodes { context.nodes[constructed.node].labels = initialized }
            return constructed
        }
        return sem_value(named_type)
    }
    return sem_expr(context, "namespace", sem_value(named_type), source, name, [], -1, -1)
}
fn sem_complete_constructor(context: SemanticContext) {
    if context.initializing {
        for field in context.fields {
            if field.owner == context.owner {
                let mut found = false
                for initialized in context.initialized { if initialized == field.name { found = true } }
                if not found { sem_error(context, "W3004", "uninitialized constructor field: " + field.name) }
            }
        }
    }
}
fn sem_expression(context: SemanticContext, minimum: int, allow_struct: bool) -> SemValue {
    let statement = context.statement_context
    context.statement_context = false
    let source = sem_at(context)
    let mut left = sem_prefix(context, allow_struct, statement)
    context.last_method_template = -1
    context.last_method_owner = -1
    if context.capture_nodes and left.node < 0 { left = sem_expr(context, "unsupported", left, source, source.kind, [], -1, -1) }
    while true {
        let saved = context.pos
        while sem_is(context, "NEWLINE") { sem_take(context) }
        if sem_is(context, "DOT") { }
        elif not (minimum < 9 and sem_is(context, "ELSE") and (context.tokens[context.pos + 1].kind == "LBRACE" or context.tokens[context.pos + 1].kind == "IDENT" and context.tokens[context.pos + 2].kind == "LBRACE")) { context.pos = saved }

        let call_token = sem_at(context)
        let call_line = call_token.line
        let call_col = call_token.col
        let call_file = call_token.file
        if sem_match(context, "LPAREN") {
            let callee = left
            let active_method_template = context.last_method_template
            let active_method_owner = context.last_method_owner
            let active_method_explicit = context.last_method_args
            context.last_method_template = -1
            context.last_method_owner = -1
            let empty_m_args: list[int] = []
            context.last_method_args = empty_m_args
            let mut argument_nodes: list[int] = []
            let mut args: list[int] = []
            let mut arg_sources: list[Token] = []
            let signature = context.types[left.type_id]
            let previous_expected = context.expected_type
            while not sem_is(context, "RPAREN") {
                context.expected_type = -1
                if signature.kind == "function" and len(args) + 1 < len(signature.args) and not sem_symbolic(context, signature.args[len(args)]) { context.expected_type = signature.args[len(args)] }
                if signature.kind == "builtin" and previous_expected >= 0 {
                    let expected_type = context.types[previous_expected]
                    if signature.name == "Some" and expected_type.kind == "optional" { context.expected_type = expected_type.args[0] }
                    elif signature.name == "Ok" and expected_type.kind == "result" { context.expected_type = expected_type.args[0] }
                    elif signature.name == "Err" and expected_type.kind == "result" { context.expected_type = expected_type.args[1] }
                }
                if signature.kind == "enum_ctor" and previous_expected >= 0 {
                    let expected_type = context.types[previous_expected]
                    if signature.name == "Option.Some" and expected_type.kind == "optional" { context.expected_type = expected_type.args[0] }
                    elif signature.name == "Result.Ok" and expected_type.kind == "result" { context.expected_type = expected_type.args[0] }
                    elif signature.name == "Result.Err" and expected_type.kind == "result" { context.expected_type = expected_type.args[1] }
                }

                arg_sources.append(sem_at(context))
                let argument = sem_expression(context, 0, true)
                if context.initializing and argument.root == "this" { sem_complete_constructor(context) }
                args.append(argument.type_id)
                argument_nodes.append(argument.node)
                if not sem_match(context, "COMMA") { break }
            }
            sem_expect(context, "RPAREN")
            context.expected_type = previous_expected
            if len(left.root) >= 3 and slice(left.root, 0, 3) == "fn:" {
                let function_index = sem_function(context, slice(left.root, 3, len(left.root)))
                if function_index >= 0 and len(context.functions[function_index].type_params) > 0 {
                    sem_check_generic_constraints(context, function_index, args, call_file, call_line, call_col)
                }
            }
            let mut concrete_target = -1
            if callee.root == "#method" and active_method_template >= 0 {
                let m_template = context.functions[active_method_template]
                let m_owner_args = context.types[active_method_owner].args
                if len(m_template.type_params) > len(m_owner_args) {
                    let mut full_args: list[int] = []
                    for a_id in m_owner_args { full_args.append(a_id) }
                    if len(active_method_explicit) > 0 {
                        for a_id in active_method_explicit { full_args.append(a_id) }
                    } else {
                        let m_unification = SemUnification()
                        let u_names: list[str] = []
                        let u_types: list[int] = []
                        m_unification.names = u_names
                        m_unification.types = u_types
                        let sig_args = context.types[callee.type_id].args
                        if len(sig_args) > 0 and len(args) == len(sig_args) - 1 {
                            for i in 0..len(args) { sem_unify_type(context, m_unification, sig_args[i], args[i]) }
                            if previous_expected >= 0 {
                                sem_unify_type(context, m_unification, sig_args[len(sig_args) - 1], previous_expected)
                            }
                            let mut own_params: list[str] = []
                            let mut own_inferred: list[int] = []
                            for p_idx in len(m_owner_args)..len(m_template.type_params) {
                                let pname = m_template.type_params[p_idx]
                                let mut found = -1
                                for u_idx in 0..len(m_unification.names) {
                                    if m_unification.names[u_idx] == pname { found = m_unification.types[u_idx] }
                                }
                                if found < 0 or (context.capture_nodes and sem_symbolic(context, found)) {
                                    report_error_at("W2001", call_token, "cannot infer generic method type argument: " + pname)
                                }
                                own_params.append(pname)
                                own_inferred.append(found)
                                full_args.append(found)
                            }
                            let mut inst_parts: list[int] = []
                            for part in sig_args { inst_parts.append(sem_substitute_type(context, part, own_params, own_inferred)) }
                            left = SemValue { type_id: sem_intern(context, "function", "", inst_parts), root: left.root, writable: left.writable, terminates: left.terminates, node: left.node }
                        }
                    }
                    if len(full_args) == len(m_template.type_params) {
                        for i in len(m_owner_args)..len(m_template.type_params) {
                            let constraint = m_template.constraints[i]
                            if constraint != "" and not sem_symbolic(context, full_args[i]) {
                                if not sem_assignable(context, full_args[i], sem_named(context, constraint)) {
                                    report_error_at("W2001", call_token, "generic constraint not satisfied: " + constraint)
                                }
                            }
                        }
                        let mut m_all_concrete = not sem_symbolic(context, active_method_owner)
                        for a_id in full_args { if sem_symbolic(context, a_id) { m_all_concrete = false } }
                        if context.capture_nodes and m_all_concrete {
                            concrete_target = sem_specialize_arguments(context, active_method_template, full_args, call_token)
                        }
                    }
                }
            }
            let mut call_was_symbolic_async = false
            if len(callee.root) >= 3 and slice(callee.root, 0, 3) == "fn:" {
                let fn_idx = sem_function(context, slice(callee.root, 3, len(callee.root)))
                if fn_idx >= 0 and context.functions[fn_idx].is_async and sem_symbolic(context, callee.type_id) {
                    call_was_symbolic_async = true
                }
            }
            let mut actual = sem_check_call(context, left.type_id, args, arg_sources, statement)
            if call_was_symbolic_async and not sem_symbolic(context, actual) {
                actual = sem_resolve_async_task_type(context, actual)
            }
            if context.capture_nodes and len(callee.root) >= 3 and slice(callee.root, 0, 3) == "fn:" {
                let template = sem_function(context, slice(callee.root, 3, len(callee.root)))
                if template >= 0 and len(context.functions[template].type_params) > 0 { concrete_target = sem_specialize(context, template, callee.type_id, args, call_token) }
            }
            let result_kind = sem_kind(context, actual)
            if context.expected_type >= 0 and sem_kind(context, context.expected_type) == "result" and (result_kind == "ok" or result_kind == "err") and sem_assignable(context, actual, context.expected_type) {
                left = sem_value(context.expected_type)
            } else { left = sem_value(actual) }
            if sem_kind(context, callee.type_id) == "builtin" and context.types[callee.type_id].name == "exit" {
                left.terminates = true
            }
            if context.capture_nodes {
                let target = context.nodes[callee.node]
                let mut nodes = argument_nodes
                let mut kind = "call"
                if target.kind == "collection_method" { kind = "collection_call" nodes = target.children for argument in argument_nodes { nodes.append(argument) } }
                elif target.kind == "constructor" { kind = "struct_call" }
                elif target.kind == "new_callee" { kind = "new" }
                elif target.kind == "method" or target.kind == "direct_method" {
                    kind = if target.kind == "method" { "virtual_call" } else { "call" }
                    nodes = target.children
                    for argument in argument_nodes { nodes.append(argument) }
                }
                elif target.kind == "enum_callee" { kind = "enum_call" }
                elif target.kind != "callee" { kind = "indirect_call" nodes = [callee.node] for argument in argument_nodes { nodes.append(argument) } }
                left = sem_expr(context, kind, left, call_token, target.text, nodes, -1, target.target)
                context.nodes[left.node].labels = target.labels
                if concrete_target >= 0 {
                    context.nodes[left.node].target = concrete_target
                    context.nodes[left.node].text = context.functions[concrete_target].name
                }
            }
        } elif sem_match(context, "DOT") {
            let name_token = sem_at(context)
            if sem_is(context, "INT") {
                let idx_tok = sem_take(context)
                let recv_t = context.types[left.type_id]
                if recv_t.kind != "tuple" { report_error_at("W3002", idx_tok, "Tuple index access requires tuple receiver") }
                let idx = int(idx_tok.val)
                if idx < 0 or idx >= len(recv_t.args) { report_error_at("W3002", idx_tok, "Tuple index out of range") }
                left = sem_expr(context, "member", SemValue { type_id: recv_t.args[idx], root: left.root, writable: -1, terminates: false, node: -1 }, name_token, idx_tok.val, [left.node], -1, -1)
                context.last_method_template = -1
                context.last_method_owner = -1
                let empty_m_args: list[int] = []
                context.last_method_args = empty_m_args
            } else {
                let name = sem_expect(context, "IDENT").val
                let receiver = left
                left = sem_member(context, left, name, name_token)
                let receiver_type = context.types[receiver.type_id]
                context.last_method_template = -1
                context.last_method_owner = -1
                let empty_m_args: list[int] = []
                context.last_method_args = empty_m_args
                if left.root == "#method" {
                    let mut method_index = sem_method(context, receiver_type.name, name)
                    if method_index < 0 and receiver_type.kind == "typeparam" {
                        let mut constraint = ""
                        for i in 0..len(context.type_params) {
                            if context.type_params[i] == receiver_type.name and i < len(context.active_constraints) { constraint = context.active_constraints[i] }
                        }
                        if constraint != "" { method_index = sem_method(context, constraint, name) }
                    }
                    if method_index >= 0 {
                        let method = context.functions[method_index]
                        let method_owner_name = if len(method.owner) > 0 { slice(method.owner, 0, len(method.owner) - 1) } else { receiver_type.name }
                        let owner_type_id = sem_resolve_member_owner(context, receiver.type_id, method_owner_name)
                        let owner_args = context.types[owner_type_id].args
                        let has_own_generic = len(method.type_params) > len(owner_args)
                        context.last_method_template = method_index
                        context.last_method_owner = owner_type_id
                        if context.capture_nodes {
                            let mut target = method_index
                            if not has_own_generic and len(owner_args) > 0 and not sem_symbolic(context, owner_type_id) {
                                target = sem_specialize_arguments(context, target, owner_args, name_token)
                            }
                            let kind = if context.nodes[receiver.node].kind == "super" or name == "init" or has_own_generic { "direct_method" } else { "method" }
                            left = sem_expr(context, kind, left, call_token, context.functions[target].name, [receiver.node], -1, target)
                            context.nodes[left.node].labels = [receiver_type.name, name]
                        }
                    }
                } elif context.capture_nodes {
                    let mut category = if left.root == "#collection" { "collection_method" } else { "member" }
                    if receiver_type.kind == "enum" and context.nodes[receiver.node].kind == "namespace" { category = if sem_kind(context, left.type_id) == "enum_ctor" { "enum_callee" } else { "enum" } }
                    left = sem_expr(context, category, left, call_token, name, if category == "enum" or category == "enum_callee" { [] } else { [receiver.node] }, -1, -1)
                    if category == "enum" or category == "enum_callee" { context.nodes[left.node].labels = [receiver_type.name, name] }
                }
            }
        } elif sem_match(context, "LBRACKET") {
            if left.root == "#method" and context.last_method_template >= 0 {
                let method = context.functions[context.last_method_template]
                let owner_args = context.types[context.last_method_owner].args
                let mut explicit_args: list[int] = []
                while not sem_is(context, "RBRACKET") {
                    explicit_args.append(sem_type(context))
                    if not sem_match(context, "COMMA") { break }
                }
                sem_expect(context, "RBRACKET")
                let own_count = len(method.type_params) - len(owner_args)
                if own_count <= 0 or len(explicit_args) != own_count {
                    report_error_at("W2001", call_token, "generic method type arity")
                }
                let mut own_params: list[str] = []
                for p_idx in len(owner_args)..len(method.type_params) {
                    let a_idx = p_idx - len(owner_args)
                    let constraint = method.constraints[p_idx]
                    if constraint != "" and not sem_symbolic(context, explicit_args[a_idx]) {
                        if not sem_assignable(context, explicit_args[a_idx], sem_named(context, constraint)) {
                            report_error_at("W2001", call_token, "generic constraint not satisfied: " + constraint)
                        }
                    }
                    own_params.append(method.type_params[p_idx])
                }
                let sig_type = context.types[left.type_id]
                let mut subst_parts: list[int] = []
                for part in sig_type.args { subst_parts.append(sem_substitute_type(context, part, own_params, explicit_args)) }
                left = SemValue { type_id: sem_intern(context, "function", "", subst_parts), root: left.root, writable: left.writable, terminates: left.terminates, node: left.node }
                if context.capture_nodes and left.node >= 0 { context.nodes[left.node].type_id = left.type_id }
                context.last_method_args = explicit_args
                if not sem_is(context, "LPAREN") { report_error_at("W2001", call_token, "generic method specialization must be called") }
            } else {
                let receiver = left
                let index_source = sem_at(context)
                let indexed = sem_expression(context, 0, true)
                let index = indexed.type_id
                sem_expect(context, "RBRACKET")
                let type_ = context.types[left.type_id]
                if type_.kind == "list" {
                    sem_require_at(context, index, context.integer_type, "W2001", index_source)
                    left = SemValue { type_id: type_.args[0], root: left.root, writable: type_.args[0], terminates: false, node: -1 }
                } elif type_.kind == "dict" {
                    # `d[k]` yields V and panics with W4002 when the key is absent; the
                    # optional form is `d.get(k)`. See SPEC 10.2.
                    sem_require_at(context, index, type_.args[0], "W2001", index_source)
                    left = SemValue { type_id: type_.args[1], root: left.root, writable: type_.args[1], terminates: false, node: -1 }
                } elif left.type_id == context.string_type {
                    sem_require_at(context, index, context.integer_type, "W2001", index_source)
                    left = sem_value(context.string_type)
                } else { report_error_at("W2001", call_token, "value cannot be indexed") }
                left = sem_expr(context, "index", left, call_token, "", [receiver.node, indexed.node], -1, -1)
            }
        } elif minimum < 10 and sem_match(context, "QUESTION") {
            let operand_node = left.node
            let type_ = context.types[left.type_id]
            let returned = context.types[context.return_type]
            if type_.kind != "optional" and type_.kind != "result" { report_error_at("W2006", call_token, "propagation operand") }
            if returned.kind != type_.kind { report_error_at("W2006", call_token, "propagation return channel") }
            if type_.kind == "result" and not sem_error_channel_assignable(context, type_.args[1], returned.args[1]) { report_error_at("W2006", call_token, "propagation error channel") }
            left = sem_expr(context, "propagate", sem_value(type_.args[0]), call_token, "", [operand_node], -1, -1)
        } elif minimum < 10 and sem_match(context, "ELSE") {
            let operand_node = left.node
            let mut error_binding = -1
            let operand = context.types[left.type_id]
            if operand.kind != "optional" and operand.kind != "result" { report_error_at("W2006", call_token, "handler operand") }
            let scope = sem_enter_scope(context)
            if sem_is(context, "IDENT") {
                let binding_token = sem_at(context)
                let error_name = sem_take(context).val
                if operand.kind != "result" { report_error_at("W2006", binding_token, "optional has no error binding") }
                error_binding = sem_declare(context, error_name, operand.args[1], false)
            }
            let handler_source = sem_at(context)
            let prev_handler_expected = context.expected_type
            context.expected_type = operand.args[0]
            let handler = sem_block(context, false)
            context.expected_type = prev_handler_expected
            sem_leave_scope(context, scope)
            if not handler.terminates {
                if sem_kind(context, handler.type_id) == "empty" { report_error_at("W2001", handler_source, "handler collection requires a concrete element type") }
                sem_require_at(context, handler.type_id, operand.args[0], "W2001", handler_source)
            }
            left = sem_expr(context, "handler", sem_value(operand.args[0]), call_token, "", [operand_node, handler.node], error_binding, -1)
        } else {
            let operand_node = left.node
            let operator = sem_at(context).kind
            let precedence = op_precedence(operator)
            if precedence <= minimum { break }
            let is_compound = operator == "PLUS_ASSIGN" or operator == "MINUS_ASSIGN" or operator == "STAR_ASSIGN"
            let logical_left = context.pos - 1
            let mut logical_constant = -1
            if logical_left >= 0 {
                if context.tokens[logical_left].kind == "FALSE" { logical_constant = 0 }
                elif context.tokens[logical_left].kind == "TRUE" { logical_constant = 1 }
            }
            sem_take(context)
            let mut right_minimum = precedence
            if operator == "ASSIGN" or is_compound or operator == "QQ" { right_minimum = precedence - 1 }
            let previous_expected = context.expected_type
            if operator == "ASSIGN" or is_compound { context.expected_type = left.writable }
            let before_right = context.initialized
            let right_source = sem_at(context)
            let right = sem_expression(context, right_minimum, allow_struct)
            let after_right = context.initialized
            context.expected_type = previous_expected
            if operator == "ASSIGN" {
                if left.writable < 0 { report_error_at("W2002", source, "invalid assignment target") }
                sem_mutable_at(context, left.root, source)
                sem_require_at(context, right.type_id, left.writable, "W2001", right_source)
                if context.initializing and len(left.root) > 5 and slice(left.root, 0, 5) == "this:" { context.initialized.append(slice(left.root, 5, len(left.root))) }
                left = sem_value(left.writable)
                left = sem_expr(context, "assign", left, call_token, operator, [operand_node, right.node], -1, -1)
            } elif is_compound {
                if left.writable < 0 { report_error_at("W2002", source, "invalid assignment target") }
                sem_mutable_at(context, left.root, source)
                let bin_op = if operator == "PLUS_ASSIGN" { "PLUS" } elif operator == "MINUS_ASSIGN" { "MINUS" } else { "STAR" }
                let deferred = sem_defer(context, "operator:" + bin_op, [left.type_id, right.type_id])
                if not deferred and left.type_id != right.type_id {
                    report_error_at("W2001", right_source, "binary operand types: expected '" + sem_diagnostic_type(context, left.type_id, 0) + "', found '" + sem_diagnostic_type(context, right.type_id, 0) + "'")
                }
                if not deferred and left.type_id != context.integer_type and left.type_id != context.float_type and (bin_op != "PLUS" or left.type_id != context.string_type) {
                    report_error_at("W2001", source, "invalid binary operation")
                }
                sem_require_at(context, left.type_id, left.writable, "W2001", right_source)
                let bin_node = sem_node(context, "binary", left.writable, call_token, bin_op, [operand_node, right.node], -1, -1)
                left = sem_expr(context, "assign", sem_value(left.writable), call_token, "ASSIGN", [operand_node, bin_node], -1, -1)
            } elif operator == "QQ" {
                if left.type_id == context.none_type {
                    context.initialized = after_right
                } else {
                    context.initialized = sem_intersect(before_right, after_right)
                }
                if left.type_id == context.none_type { left = right }
                elif sem_kind(context, left.type_id) == "optional" {
                    let inner = context.types[left.type_id].args[0]
                    sem_require_at(context, right.type_id, inner, "W2001", right_source)
                    left = sem_value(inner)
                } else { report_error_at("W2006", source, "coalesce requires optional") }
                left = sem_expr(context, "binary", left, call_token, operator, [operand_node, right.node], -1, -1)
            } elif operator == "DOT_DOT" or operator == "DOT_DOT_EQ" {
                sem_require_at(context, left.type_id, context.integer_type, "W2001", source)
                sem_require_at(context, right.type_id, context.integer_type, "W2001", right_source)
                left = sem_value(sem_wrap(context, "list", context.integer_type))
                left = sem_expr(context, "binary", left, call_token, operator, [operand_node, right.node], -1, -1)
            } elif operator == "AND" or operator == "OR" {
                sem_require_at(context, left.type_id, context.boolean_type, "W2001", source)
                sem_require_at(context, right.type_id, context.boolean_type, "W2001", right_source)
                let skips_right = (operator == "AND" and logical_constant == 0) or (
                    operator == "OR" and logical_constant == 1
                )
                let runs_right = (operator == "AND" and logical_constant == 1) or (
                    operator == "OR" and logical_constant == 0
                )
                if skips_right { context.initialized = before_right }
                elif runs_right { context.initialized = after_right }
                else { context.initialized = sem_intersect(before_right, after_right) }
                left = sem_value(context.boolean_type)
                left = sem_expr(context, "binary", left, call_token, operator, [operand_node, right.node], -1, -1)
            } elif operator == "EQ" or operator == "NEQ" {
                let left_kind = sem_kind(context, left.type_id)
                let right_kind = sem_kind(context, right.type_id)
                if not sem_defer(context, "equality", [left.type_id, right.type_id]) and (not sem_equality_value(context, left.type_id) or not sem_equality_value(context, right.type_id)) { report_error_at("W2001", right_source, "function payloads do not support value equality") }
                let result_pair = (left_kind == "ok" or left_kind == "err") and (right_kind == "ok" or right_kind == "err")
                if not result_pair and not sem_assignable(context, left.type_id, right.type_id) and not sem_assignable(context, right.type_id, left.type_id) { report_error_at("W2001", right_source, "equality types") }
                left = sem_value(context.boolean_type)
                left = sem_expr(context, "binary", left, call_token, operator, [operand_node, right.node], -1, -1)
            } elif operator == "IN" {
                let right_t = context.types[right.type_id]
                let mut ok = false
                if right_t.kind == "list" or right_t.kind == "dict" {
                    sem_require_at(context, left.type_id, right_t.args[0], "W2001", source)
                    ok = true
                } elif right.type_id == context.string_type {
                    sem_require_at(context, left.type_id, context.string_type, "W2001", source)
                    ok = true
                } else {
                    report_error_at("W2001", right_source, "'in' requires list, dict, or str container")
                }
                if ok {
                    left = sem_expr(context, "collection_call", sem_value(context.boolean_type), call_token, "contains", [right.node, operand_node], -1, -1)
                } else {
                    left = sem_value(context.boolean_type)
                }
            } else {
                let deferred = sem_defer(context, "operator:" + operator, [left.type_id, right.type_id])
                if not deferred and left.type_id != right.type_id {
                    report_error_at("W2001", right_source, "binary operand types: expected '" + sem_diagnostic_type(context, left.type_id, 0) + "', found '" + sem_diagnostic_type(context, right.type_id, 0) + "'")
                }
                if not deferred and left.type_id != context.integer_type and left.type_id != context.float_type and (operator != "PLUS" or left.type_id != context.string_type) { report_error_at("W2001", source, "invalid binary operation") }
                if not deferred and operator == "PERCENT" and left.type_id != context.integer_type { report_error_at("W2001", source, "modulo requires integers") }
                if operator == "LT" or operator == "LTE" or operator == "GT" or operator == "GTE" { left = sem_value(context.boolean_type) }
                else { left = sem_value(left.type_id) }
                left = sem_expr(context, "binary", left, call_token, operator, [operand_node, right.node], -1, -1)
            }
        }
    }
    if left.root == "#method" or left.root == "#collection" or sem_kind(context, left.type_id) == "builtin" or sem_kind(context, left.type_id) == "constructor" { sem_error(context, "W2013", "callable syntax requires an explicit lambda adapter") }
    return left
}
fn sem_intersect(left: list[str], right: list[str]) -> list[str] {
    let mut result: list[str] = []
    for value in left { for other in right { if value == other { result.append(value) } } }
    return result
}
fn sem_check_discarded_branch(context: SemanticContext, type_id: int, statement: bool, location: Token) {
    if statement and context.expected_type >= 0 and sem_kind(context, context.expected_type) == "result" and sem_unit_return(context, context.expected_type) {
        sem_require_tail_at(context, type_id, context.expected_type, location)
    }
}
fn sem_if(context: SemanticContext, statement: bool) -> SemValue {
    let outer_expected = context.expected_type
    let stmt_result_ctx = if statement and outer_expected >= 0 and sem_kind(context, outer_expected) == "result" and sem_unit_return(context, outer_expected) { outer_expected } else { -1 }
    context.expected_type = -1
    let source = sem_expect(context, "IF")
    let condition_source = sem_at(context)
    let condition = sem_expression(context, 0, false)
    sem_require_at(context, condition.type_id, context.boolean_type, "W2001", condition_source)
    let mut conditions: list[int] = [condition.node]
    let mut branches: list[int] = []
    let mut sources: list[Token] = [source]
    let initial = context.initialized
    let first_source = sem_at(context)
    context.expected_type = if statement { stmt_result_ctx } else { outer_expected }
    let first = sem_block(context, statement)
    branches.append(first.node)
    sem_check_discarded_branch(context, first.type_id, statement, first_source)
    let mut initialized = context.initialized
    let mut all_return = first.terminates
    let mut common = first.type_id
    let mut branch_expected = -1
    if not statement {
        if outer_expected >= 0 and outer_expected != context.unit_type { branch_expected = outer_expected }
        elif not first.terminates and first.type_id != context.unit_type { branch_expected = first.type_id }
    }
    sem_skip_newlines_before_branch(context)
    while sem_is(context, "ELIF") {
        sources.append(sem_take(context))
        context.initialized = initial
        context.expected_type = -1
        let condition_source = sem_at(context)
        let condition = sem_expression(context, 0, false)
        sem_require_at(context, condition.type_id, context.boolean_type, "W2001", condition_source)
        conditions.append(condition.node)
        let branch_source = sem_at(context)
        context.expected_type = if statement { stmt_result_ctx } else { branch_expected }
        let branch = sem_block(context, statement)
        branches.append(branch.node)
        sem_check_discarded_branch(context, branch.type_id, statement, branch_source)
        if not branch.terminates and not all_return and not sem_assignable(context, branch.type_id, common) { if not statement { report_error_at("W2001", branch_source, "incompatible if branches") } common = context.unit_type }
        if not branch.terminates {
            if all_return { initialized = context.initialized } else { initialized = sem_intersect(initialized, context.initialized) }
            if all_return {
                common = branch.type_id
                if not statement and branch_expected < 0 and common != context.unit_type { branch_expected = common }
            }
        }
        all_return = all_return and branch.terminates
        sem_skip_newlines_before_branch(context)
    }
    context.initialized = initial
    if sem_match(context, "ELSE") {
        let branch_source = sem_at(context)
        context.expected_type = if statement { stmt_result_ctx } else { branch_expected }
        let branch = sem_block(context, statement)
        branches.append(branch.node)
        sem_check_discarded_branch(context, branch.type_id, statement, branch_source)
        if not branch.terminates {
            if not all_return and not sem_assignable(context, branch.type_id, common) { if not statement { report_error_at("W2001", branch_source, "incompatible if branches") } common = context.unit_type }
            if all_return { initialized = context.initialized } else { initialized = sem_intersect(initialized, context.initialized) }
            if all_return { common = branch.type_id }
        }
        all_return = all_return and branch.terminates
    } else {
        initialized = sem_intersect(initialized, initial)
        all_return = false
        common = context.unit_type
    }
    context.expected_type = outer_expected
    context.initialized = initialized
    let mut alternate = sem_node(context, "unit", context.unit_type, source, "", [], -1, -1)
    if len(branches) > len(conditions) { alternate = branches[len(branches) - 1] }
    let mut index = len(conditions) - 1
    while index >= 0 {
        alternate = sem_node(context, "if", common, sources[index], "", [conditions[index], branches[index], alternate], -1, -1)
        index = index - 1
    }
    return SemValue { type_id: common, root: "", writable: -1, terminates: all_return, node: alternate }
}
fn sem_record_pattern(context: SemanticContext, name: str, children: list[int]) -> str {
    context.patterns.append(SemPattern { name: name, children: children, type_id: context.unit_type, binding: -1, source: sem_at(context) })
    context.last_pattern = len(context.patterns) - 1
    return name
}
fn sem_leaf_pattern(context: SemanticContext, name: str) -> str {
    let empty: list[int] = []
    return sem_record_pattern(context, name, empty)
}
fn sem_constructors(context: SemanticContext, subject: int) -> list[SemConstructor] {
    let type_ = context.types[subject]
    let mut constructors: list[SemConstructor] = []
    let empty: list[int] = []
    if type_.kind == "struct" {
        let mut payloads: list[int] = []
        let generic = sem_generic_type(context, type_.name)
        for field in context.fields {
            if field.owner == type_.name {
                payloads.append(if generic >= 0 { sem_substitute_type(context, field.type_id, context.generic_types[generic].params, type_.args) } else { field.type_id })
            }
        }
        constructors.append(SemConstructor { name: "struct", payloads: payloads })
    }
    elif type_.kind == "tuple" { constructors.append(SemConstructor { name: "tuple", payloads: type_.args }) }
    elif type_.kind == "bool" {
        constructors.append(SemConstructor { name: "literal:true", payloads: empty })
        constructors.append(SemConstructor { name: "literal:false", payloads: empty })
    } elif type_.kind == "optional" {
        constructors.append(SemConstructor { name: "Some", payloads: [type_.args[0]] })
        constructors.append(SemConstructor { name: "None", payloads: empty })
    } elif type_.kind == "result" {
        constructors.append(SemConstructor { name: "Ok", payloads: [type_.args[0]] })
        constructors.append(SemConstructor { name: "Err", payloads: [type_.args[1]] })
    } elif type_.kind == "error_union" {
        for alternative in type_.args { constructors.append(SemConstructor { name: sem_error_type_name(context, alternative), payloads: [alternative] }) }
    } elif type_.kind == "enum" {
        let generic = sem_generic_type(context, type_.name)
        for i in 0..len(context.variants) {
            if sem_same_type_declaration(context, context.variant_types[i], subject) {
                let mut payloads = context.variant_payloads[i]
                if generic >= 0 and len(type_.args) == len(context.generic_types[generic].params) {
                    let mut concrete: list[int] = []
                    for payload in payloads { concrete.append(sem_substitute_type(context, payload, context.generic_types[generic].params, type_.args)) }
                    payloads = concrete
                }
                constructors.append(SemConstructor { name: context.variants[i], payloads: payloads })
            }
        }
    }
    return constructors
}
fn sem_pattern_matrix(context: SemanticContext, types: list[int], rows: list[list[int]]) -> bool {
    if len(types) == 0 { return len(rows) > 0 }
    if len(rows) == 0 { return false }
    let mut expanded: list[list[int]] = []
    let mut has_or = false
    for row in rows {
        if context.patterns[row[0]].name == "or" {
            has_or = true
            for child in context.patterns[row[0]].children {
                let mut next = [child]
                for item in slice(row, 1, len(row)) { next.append(item) }
                expanded.append(next)
            }
        } else { expanded.append(row) }
    }
    if has_or { return sem_pattern_matrix(context, types, expanded) }
    let tail = slice(types, 1, len(types))
    let mut defaults: list[list[int]] = []
    for row in rows { if context.patterns[row[0]].name == "*" { defaults.append(slice(row, 1, len(row))) } }
    if len(defaults) > 0 and sem_pattern_matrix(context, tail, defaults) { return true }
    if sem_kind(context, types[0]) == "int" { return sem_integer_pattern_matrix(context, tail, rows) }
    let constructors = sem_constructors(context, types[0])
    if len(constructors) == 0 { return false }
    for constructor in constructors {
        let mut specialized: list[list[int]] = []
        for row in rows {
            let pattern = context.patterns[row[0]]
            let mut children: list[int] = []
            let mut matches = false
            if pattern.name == "*" {
                for payload in constructor.payloads { sem_leaf_pattern(context, "*") children.append(context.last_pattern) }
                matches = true
            } elif pattern.name == constructor.name { children = pattern.children matches = true }
            if matches {
                for element in slice(row, 1, len(row)) { children.append(element) }
                specialized.append(children)
            }
        }
        let mut next_types = constructor.payloads
        for type_id in tail { next_types.append(type_id) }
        if not sem_pattern_matrix(context, next_types, specialized) { return false }
    }
    return true
}
fn sem_pattern_atom(context: SemanticContext, subject: int) -> str {
    let source = sem_at(context)
    let name = sem_pattern_syntax(context, subject, source)
    if name == "None" and sem_kind(context, subject) != "optional" and sem_kind(context, subject) != "enum" { report_error_at("W2001", source, "none pattern requires an optional subject") }
    context.patterns[context.last_pattern].source = source
    context.patterns[context.last_pattern].type_id = subject
    return name
}
fn sem_binding_pattern(context: SemanticContext, name: str, subject: int) -> str {
    let binding = sem_declare(context, name, subject, false)
    let pattern = sem_leaf_pattern(context, "*")
    context.patterns[context.last_pattern].binding = binding
    return pattern
}
fn sem_pattern_syntax(context: SemanticContext, subject: int, source: Token) -> str {
    if sem_match(context, "STAR") { report_error_at("W0001", source, "wildcard '* =>' has been removed in match; use canonical '_ =>'") }
    if sem_match(context, "ELSE") { report_error_at("W0001", source, "wildcard 'else =>' has been removed in match; use canonical '_ =>'") }
    if sem_match(context, "MINUS") {
        return sem_pattern_number(context, subject, source, true, sem_expect(context, "INT"))
    }
    if sem_is(context, "INT") { return sem_pattern_number(context, subject, source, false, sem_take(context)) }
    if sem_is(context, "STR") or sem_is(context, "TRUE") or sem_is(context, "FALSE") {
        let token = sem_take(context)
        let type_id = if token.kind == "STR" { context.string_type } else { context.boolean_type }
        sem_require_at(context, type_id, subject, "W2001", token)
        return sem_leaf_pattern(context, "literal:" + token.val)
    }
    if sem_match(context, "LPAREN") {
        if sem_kind(context, subject) != "tuple" { report_error_at("W2001", source, "tuple pattern requires a tuple") }
        let elements = context.types[subject].args
        let mut children: list[int] = []
        if not sem_is(context, "RPAREN") {
            while true {
                if len(children) >= len(elements) { report_error_at("W2001", source, "too many tuple pattern elements") }
                sem_pattern(context, elements[len(children)])
                children.append(context.last_pattern)
                if not sem_match(context, "COMMA") or sem_is(context, "RPAREN") { break }
            }
        }
        sem_expect(context, "RPAREN")
        if len(children) != len(elements) { report_error_at("W2001", source, "tuple pattern arity") }
        return sem_record_pattern(context, "tuple", children)
    }

    let pattern_start = context.pos
    let mut owner = ""
    let mut name = sem_expect(context, "IDENT").val
    if name == "_" { return sem_leaf_pattern(context, "*") }
    if name == "none" { report_error_at("W0001", source, "lowercase 'none' pattern has been removed; use canonical 'None'") }
    if sem_match(context, "DOT") { owner = name name = sem_expect(context, "IDENT").val }
    let kind = sem_kind(context, subject)
    if (sem_is(context, "LBRACE") or sem_is(context, "LBRACKET")) and kind == "struct" {
        let pattern_name = if owner == "" { name } else { owner + "." + name }
        if pattern_name != context.types[subject].name { report_error_at("W2001", source, "struct pattern identity does not match subject") }
        if sem_is(context, "LBRACKET") {
            context.pos = pattern_start
            let specified = sem_type(context)
            if specified != subject { report_error_at("W2001", source, "struct pattern type arguments do not match subject") }
        }
        return sem_struct_pattern(context, subject, source)
    }
    if kind == "error_union" and (sem_is(context, "LBRACKET") or sem_is(context, "LPAREN")) {
        if owner != "" { report_error_at("W2001", source, "error type patterns must be unqualified") }
        context.pos = pattern_start
        let error_type = sem_type(context)
        sem_expect(context, "LPAREN")
        let mut is_alternative = false
        for alternative in context.types[subject].args { if alternative == error_type { is_alternative = true } }
        if not is_alternative { report_error_at("W2001", source, "error type pattern is not an alternative of this union") }
        if sem_is(context, "RPAREN") { report_error_at("W2005", source, "error type pattern requires exactly one payload binding") }
        if not sem_is(context, "IDENT") { report_error_at("W2005", source, "error type pattern payload must be a binding or wildcard") }
        let child_pattern = sem_pattern(context, error_type)
        if child_pattern != "*" { report_error_at("W2005", source, "error type pattern payload must be a binding or wildcard") }
        if sem_match(context, "COMMA") { report_error_at("W2005", source, "error type pattern requires exactly one payload binding") }
        sem_expect(context, "RPAREN")
        return sem_record_pattern(context, sem_error_type_name(context, error_type), [context.last_pattern])
    }
    if sem_match(context, "LPAREN") {
        let mut payload_types: list[int] = []
        let mut valid = false
        if (owner == "" or owner == "Option") and name == "Some" and kind == "optional" {
            payload_types = [context.types[subject].args[0]]
            valid = true
        } elif (owner == "" or owner == "Result") and name == "Ok" and kind == "result" {
            payload_types = [context.types[subject].args[0]]
            valid = true
        } elif (owner == "" or owner == "Result") and name == "Err" and kind == "result" {
            payload_types = [context.types[subject].args[1]]
            valid = true
        } elif kind == "enum" {
            if owner != "" and owner != context.types[subject].name { report_error_at("W2001", source, "pattern enum identity") }
            let generic = sem_generic_type(context, context.types[subject].name)
            for i in 0..len(context.variants) {
                if context.variants[i] == name and context.types[context.variant_types[i]].name == context.types[subject].name {
                    payload_types = context.variant_payloads[i]
                    if generic >= 0 and len(context.types[subject].args) == len(context.generic_types[generic].params) {
                        let mut concrete: list[int] = []
                        for payload in payload_types { concrete.append(sem_substitute_type(context, payload, context.generic_types[generic].params, context.types[subject].args)) }
                        payload_types = concrete
                    }
                    valid = true
                }
            }
        }
        if not valid { report_error_at("W2001", source, "payload pattern") }
        let mut count = 0
        let mut children: list[int] = []
        if not sem_is(context, "RPAREN") {
            if count >= len(payload_types) { report_error_at("W2001", source, "too many enum pattern bindings") }
            sem_pattern(context, payload_types[count])
            children.append(context.last_pattern)
            count = count + 1
            while sem_match(context, "COMMA") {
                if sem_is(context, "RPAREN") { break }
                if count >= len(payload_types) { report_error_at("W2001", source, "too many enum pattern bindings") }
                sem_pattern(context, payload_types[count])
                children.append(context.last_pattern)
                count = count + 1
            }
        }
        sem_expect(context, "RPAREN")
        if count != len(payload_types) { report_error_at("W2001", source, "enum pattern arity") }
        return sem_record_pattern(context, name, children)
    }
    if kind == "enum" {
        if owner != "" and owner != context.types[subject].name { report_error_at("W2001", source, "pattern enum identity") }
        let mut valid = false
        for i in 0..len(context.variants) { if context.variants[i] == name and context.types[context.variant_types[i]].name == context.types[subject].name and len(context.variant_payloads[i]) == 0 { valid = true } }
        if valid { return sem_leaf_pattern(context, name) }
        if owner != "" { report_error_at("W1001", source, "unknown enum pattern") }
        return sem_binding_pattern(context, name, subject)
    }
    if name == "None" and (kind == "optional" or owner == "Option") { return sem_leaf_pattern(context, "None") }
    if owner != "" { report_error_at("W2001", source, "qualified enum pattern required") }
    return sem_binding_pattern(context, name, subject)
}
fn sem_match_expression(context: SemanticContext, statement_context: bool) -> SemValue {
    let source = sem_expect(context, "MATCH")
    # Preserve syntax-error priority before resolving an atomic subject's name.
    # A bare pattern followed by a block always lacks its required arrow.
    let mut pattern_start = context.pos + 2
    if pattern_start + 2 < len(context.tokens) and context.tokens[context.pos + 1].kind == "LBRACE" {
        if context.tokens[pattern_start].kind == "MINUS" { pattern_start = pattern_start + 1 }
        let pattern_kind = context.tokens[pattern_start].kind
        let bare_pattern = pattern_kind == "IDENT" or pattern_kind == "INT" or pattern_kind == "STR" or pattern_kind == "TRUE" or pattern_kind == "FALSE"
        let following = context.tokens[pattern_start + 1]
        if bare_pattern and following.kind == "LBRACE" and not sem_pattern_brace(context.tokens, pattern_start + 1) {
            report_error_at("W0001", following, "expected '=>' after match pattern")
        }
    }
    let outer_expected = context.expected_type
    context.expected_type = -1
    let subject_value = sem_expression(context, 0, false)
    let subject = subject_value.type_id
    let statement = statement_context and not sem_delimited_expression_suffix(context.tokens, context.pos, "LBRACE", "RBRACE")
    let stmt_result_ctx = if statement and outer_expected >= 0 and sem_kind(context, outer_expected) == "result" and sem_unit_return(context, outer_expected) { outer_expected } else { -1 }
    let mut arms: list[int] = []
    sem_expect(context, "LBRACE")
    let mut covered: list[list[int]] = []
    let mut all_return = true
    let mut common = -1
    let mut arm_expected = if not statement and outer_expected >= 0 and outer_expected != context.unit_type { outer_expected } else { -1 }
    let mut wildcard = false
    let initial = context.initialized
    let mut initialized = initial
    let mut live_branches = 0
    while true {
        sem_skip_separators(context)
        if sem_is(context, "RBRACE") { break }
        let scope = sem_enter_scope(context)
        context.initialized = initial
        context.expected_type = -1
        sem_pattern(context, subject)
        let pattern = context.last_pattern
        if sem_is(context, "COMMA") {
            report_error_at("W0001", sem_at(context), "unparenthesized tuple patterns are not allowed in match; use '(a, b) =>'")
        }
        let mut guarded = false
        let mut guard = -1
        if sem_match(context, "IF") { guarded = true let guard_source = sem_at(context) let value = sem_expression(context, 0, false) sem_require_at(context, value.type_id, context.boolean_type, "W2001", guard_source) guard = value.node }
        if not sem_match(context, "FAT_ARROW") { sem_error(context, "W0001", "expected '=>' after match pattern") }
        let mut branch = SemFlow { type_id: context.unit_type, terminates: false, node: -1 }
        let branch_source = sem_at(context)
        context.expected_type = if statement { stmt_result_ctx } else { arm_expected }
        if sem_is(context, "LBRACE") { branch = sem_block(context, false) }
        else { let value = sem_expression(context, 0, true) branch = SemFlow { type_id: value.type_id, terminates: value.terminates, node: value.node } }
        context.expected_type = outer_expected
        if context.capture_nodes {
            arms.append(len(context.arms))
            context.arms.append(CheckedArm { pattern: pattern, guard: guard, body: branch.node, source: context.patterns[pattern].source })
        }
        if not guarded {
            covered.append([pattern])
            if context.patterns[pattern].name == "*" { wildcard = true }
        }
        if not branch.terminates {
            if live_branches == 0 { initialized = context.initialized } else { initialized = sem_intersect(initialized, context.initialized) }
            live_branches = live_branches + 1
            if not statement {
                if common >= 0 { sem_require_at(context, branch.type_id, common, "W2001", branch_source) }
                else {
                    common = branch.type_id
                    if arm_expected < 0 and common != context.unit_type { arm_expected = common }
                }
            }
        }
        all_return = all_return and branch.terminates
        sem_leave_scope(context, scope)
        sem_match(context, "COMMA")
    }
    context.expected_type = outer_expected
    sem_expect(context, "RBRACE")
    let kind = sem_kind(context, subject)
    let closed = kind == "enum" or kind == "optional" or kind == "result" or kind == "error_union" or kind == "bool" or kind == "tuple"
    let exhaustive = sem_pattern_matrix(context, [subject], covered)
    if closed and not exhaustive { report_error_at("W2003", source, "non-exhaustive match") }
    if not closed and not exhaustive {
        if common >= 0 and common != context.unit_type { report_error_at("W2003", source, "value match requires exhaustive patterns") }
        if not statement and context.expected_type >= 0 and context.expected_type != context.unit_type { report_error_at("W2003", source, "value match requires exhaustive patterns") }
        initialized = sem_intersect(initialized, initial)
        all_return = false
    }
    context.initialized = initialized
    if common < 0 { common = context.unit_type }
    let result = sem_expr(context, "match", SemValue { type_id: common, root: "", writable: -1, terminates: all_return, node: -1 }, source, "", [subject_value.node], -1, -1)
    if context.capture_nodes { context.nodes[result.node].arms = arms context.nodes[result.node].total = exhaustive }
    return result
}
fn sem_collect_let_names(context: SemanticContext, pat_id: int) -> list[str] {
    let pat = context.patterns[pat_id]
    let mut names: list[str] = []
    if pat.name == "tuple" {
        for child_id in pat.children {
            for sub in sem_collect_let_names(context, child_id) {
                for prev in names {
                    if prev == sub { report_error_at("W1002", context.patterns[child_id].source, "duplicate binding in let destructuring: " + sub) }
                }
                names.append(sub)
            }
        }
        return names
    }
    let name = slice(pat.name, 12, len(pat.name))
    if name != "_" { names.append(name) }
    return names
}
fn sem_let_path_node(context: SemanticContext, tmp_binding: int, tmp_name: str, tmp_type: int, path: list[int], path_types: list[int], source: Token) -> int {
    let mut cur = sem_node(context, "binding", tmp_type, source, tmp_name, [], tmp_binding, -1)
    for i in 0..len(path) {
        cur = sem_node(context, "member", path_types[i], source, str(path[i]), [cur], -1, -1)
    }
    return cur
}
fn sem_bind_let_pattern(context: SemanticContext, pat_id: int, type_id: int, mutable: bool, tmp_binding: int, tmp_name: str, tmp_type: int, path: list[int], path_types: list[int]) -> list[int] {
    let pat = context.patterns[pat_id]
    let mut out_nodes: list[int] = []
    if pat.name == "tuple" {
        let type_ = context.types[type_id]
        if type_.kind != "tuple" or len(type_.args) != len(pat.children) {
            report_error_at("W2001", pat.source, "let destructuring requires matching tuple shape")
        }
        for i in 0..len(pat.children) {
            let mut next_path: list[int] = []
            for x in path { next_path.append(x) }
            next_path.append(i)
            let mut next_types: list[int] = []
            for pt in path_types { next_types.append(pt) }
            next_types.append(type_.args[i])
            for ln in sem_bind_let_pattern(context, pat.children[i], type_.args[i], mutable, tmp_binding, tmp_name, tmp_type, next_path, next_types) {
                out_nodes.append(ln)
            }
        }
        return out_nodes
    }
    let name = slice(pat.name, 12, len(pat.name))
    if name != "_" {
        let val_node = sem_let_path_node(context, tmp_binding, tmp_name, tmp_type, path, path_types, pat.source)
        let binding = sem_declare(context, name, type_id, mutable)
        out_nodes.append(sem_node(context, "let", context.unit_type, pat.source, name, [val_node], binding, -1))
    }
    return out_nodes
}
fn sem_let_nodes(context: SemanticContext) -> list[int] {
    let source = sem_expect(context, "LET")
    let mutable = sem_match(context, "MUT")
    let mut pat_id = -1
    let mut name = ""
    if sem_is(context, "LPAREN") {
        pat_id = sem_for_pattern(context, false)
        if context.patterns[pat_id].name != "tuple" {
            report_error_at("W0006", source, "let destructuring requires tuple pattern")
        }
    } else {
        name = sem_expect(context, "IDENT").val
    }
    let mut annotation = -1
    if sem_match(context, "COLON") { annotation = sem_type(context) }
    sem_expect(context, "ASSIGN")
    let previous = context.expected_type
    context.expected_type = annotation

    let initializer_source = sem_at(context)
    let initializer = sem_expression(context, 0, true)
    let value = initializer.type_id
    context.expected_type = previous
    if sem_kind(context, value) == "builtin" { report_error_at("W2013", initializer_source, "builtin values require an explicit lambda adapter") }
    if annotation < 0 {
        let inferred = context.types[value]
        let untyped_list = inferred.kind == "list" and sem_kind(context, inferred.args[0]) == "any"
        let untyped_dict = inferred.kind == "dict" and sem_kind(context, inferred.args[0]) == "any"
        if value == context.none_type or sem_kind(context, value) == "empty" or untyped_list or untyped_dict { report_error_at("W2001", initializer_source, "initializer needs type context") }
        annotation = value
    } else { sem_require_at(context, value, annotation, "W2001", initializer_source) }
    if pat_id >= 0 {
        let _checked_names = sem_collect_let_names(context, pat_id)
        let tmp_name = "__let_tuple_" + str(source.line) + "_" + str(source.col) + "_" + str(len(context.variables))
        let tmp_binding = sem_declare(context, tmp_name, annotation, false)
        let mut out_nodes: list[int] = [sem_node(context, "let", context.unit_type, source, tmp_name, [initializer.node], tmp_binding, -1)]
        let empty_path: list[int] = []
        let empty_types: list[int] = []
        for ln in sem_bind_let_pattern(context, pat_id, annotation, mutable, tmp_binding, tmp_name, annotation, empty_path, empty_types) {
            out_nodes.append(ln)
        }
        return out_nodes
    }
    let binding = sem_declare(context, name, annotation, mutable)
    return [sem_node(context, "let", context.unit_type, source, name, [initializer.node], binding, -1)]
}
fn sem_let(context: SemanticContext) -> int {
    return sem_let_nodes(context)[0]
}
fn sem_block(context: SemanticContext, statement: bool) -> SemFlow {
    let source = sem_expect(context, "LBRACE")
    let outer_expected = context.expected_type
    let stmt_keep_expected = if outer_expected >= 0 and sem_kind(context, outer_expected) == "result" and sem_unit_return(context, outer_expected) { outer_expected } else { -1 }
    let mut statements: list[int] = []
    let scope = sem_enter_scope(context)
    let mut tail = context.unit_type
    let mut terminates = false
    while true {
        sem_skip_separators(context)
        if sem_is(context, "RBRACE") or sem_is(context, "EOF") { break }
        let statement_source = sem_at(context)
        if sem_is(context, "AT") { sem_error(context, "W0006", "static attributes require a top-level function declaration") }
        if sem_is(context, "LET") {
            context.expected_type = -1
            for ln in sem_let_nodes(context) { statements.append(ln) }
            tail = context.unit_type
        }
        elif sem_match(context, "RETURN") {
            let previous = context.expected_type
            context.expected_type = context.return_type
            let mut value = context.unit_type
            let mut returned_node = sem_node(context, "unit", context.unit_type, statement_source, "", [], -1, -1)
            let mut return_source = statement_source
            if expression_starter(sem_at(context).kind) {

                return_source = sem_at(context)
                let expression = sem_expression(context, 0, true)
                value = expression.type_id
                returned_node = expression.node
            }
            context.expected_type = previous
            if context.return_type < 0 { context.return_type = value }
            sem_require_at(context, value, context.return_type, "W2004", return_source)
            sem_complete_constructor(context)
            if len(context.active_ensures_tokens) > 0 and context.capture_nodes {
                let saved_pos = context.pos
                let ens_scope = sem_enter_scope(context)
                let result_var = sem_declare(context, "result", value, false)
                let result_let = sem_node(context, "let", context.unit_type, statement_source, "result", [returned_node], result_var, -1)
                statements.append(result_let)
                for ens_pos in context.active_ensures_tokens {
                    context.pos = ens_pos
                    sem_skip_separators(context)
                    sem_take(context)
                    let ens_src = sem_at(context)
                    let cond_val = sem_expression(context, 0, false)
                    let msg_text = "Postcondition ('ensures') failed in '" + context.current_function + "'"
                    let msg_node = sem_node(context, "string", context.string_type, ens_src, msg_text, [], -1, -1)
                    let assert_node = sem_node(context, "call", context.unit_type, ens_src, "contract_assert", [cond_val.node, msg_node], -1, -1)
                    statements.append(assert_node)
                }
                let res_ref = sem_node(context, "binding", value, return_source, "result", [], result_var, -1)
                statements.append(sem_node(context, "return", context.unit_type, statement_source, "", [res_ref], -1, -1))
                sem_leave_scope(context, ens_scope)
                context.pos = saved_pos
            } else {
                statements.append(sem_node(context, "return", context.unit_type, statement_source, "", [returned_node], -1, -1))
            }
            terminates = true
            tail = context.unit_type
        } elif sem_match(context, "WHILE") {
            context.expected_type = -1
            let condition_source = sem_at(context)
            let condition = sem_expression(context, 0, false)
            sem_require_at(context, condition.type_id, context.boolean_type, "W2001", condition_source)
            context.loop = context.loop + 1
            let initialized = context.initialized
            let body = sem_block(context, true)
            statements.append(sem_node(context, "while", context.unit_type, statement_source, "", [condition.node, body.node], -1, -1))
            context.initialized = initialized
            context.loop = context.loop - 1
            tail = context.unit_type
        } elif sem_match(context, "FOR") {
            context.expected_type = -1
            let pattern = sem_for_pattern(context, true)
            sem_expect(context, "IN")
            let sequence_source = sem_at(context)
            let sequence = sem_expression(context, 0, false)
            let iterable = sequence.type_id
            let mut element = -1
            let mut iter_node = sequence.node
            if sem_kind(context, iterable) == "list" {
                element = context.types[iterable].args[0]
            } elif sem_kind(context, iterable) == "dict" {
                element = sem_intern(context, "tuple", "", context.types[iterable].args)
                if context.capture_nodes {
                    let items_list_t = sem_wrap(context, "list", element)
                    iter_node = sem_node(context, "collection_call", items_list_t, sequence_source, "items", [sequence.node], -1, -1)
                }
            } else {
                report_error_at("W2001", sequence_source, "for requires list, dict, or range")
            }
            let scope = sem_enter_scope(context)
            sem_bind_for_pattern(context, pattern, element)
            context.loop = context.loop + 1
            let initialized = context.initialized
            let body = sem_block(context, true)
            let node = sem_node(context, "for", context.unit_type, statement_source, "", [iter_node, body.node], -1, -1)
            if context.capture_nodes { context.nodes[node].pattern = pattern }
            statements.append(node)
            context.initialized = initialized
            context.loop = context.loop - 1
            sem_leave_scope(context, scope)
            tail = context.unit_type
        } elif sem_match(context, "BREAK") or sem_match(context, "CONTINUE") {
            if context.loop == 0 { sem_error(context, "W1004", "loop transfer outside loop") }
            statements.append(sem_node(context, if statement_source.kind == "BREAK" { "break" } else { "continue" }, context.unit_type, statement_source, "", [], -1, -1))
            terminates = true
            tail = context.unit_type
        } else {
            let result_match = statement_source.kind == "MATCH" and stmt_keep_expected >= 0
            context.statement_context = (statement and not result_match) or not sem_tail_expression(context)
            context.expected_type = if context.statement_context { stmt_keep_expected } else { outer_expected }
            let expression = sem_expression(context, 0, true)
            tail = expression.type_id
            statements.append(expression.node)
            terminates = terminates or expression.terminates
        }
    }
    context.expected_type = outer_expected
    sem_expect(context, "RBRACE")
    sem_leave_scope(context, scope)
    return SemFlow { type_id: tail, terminates: terminates, node: sem_node(context, "block", tail, source, "", statements, -1, -1) }
}
fn sem_unit_return(context: SemanticContext, type_id: int) -> bool {
    if type_id == context.unit_type { return true }
    return type_id >= 0 and sem_kind(context, type_id) == "result" and context.types[type_id].args[0] == context.unit_type
}
fn sem_require_tail_at(context: SemanticContext, source: int, target: int, location: Token) {
    if sem_unit_return(context, target) {
        if sem_kind(context, target) == "result" {
            let mut error_type = -1
            if sem_kind(context, source) == "result" { error_type = context.types[source].args[1] }
            elif sem_kind(context, source) == "err" { error_type = context.types[source].args[0] }
            if error_type >= 0 and not sem_error_channel_assignable(context, error_type, context.types[target].args[1]) { report_error_at("W2004", location, "incompatible error channel") }
        }
    } else { sem_require_at(context, source, target, "W2004", location) }
}
fn sem_function_owner_type(context: SemanticContext, function: SemFunction) -> int {
    let owner = slice(function.owner, 0, len(function.owner) - 1)
    let generic = sem_generic_type(context, owner)
    if generic < 0 { return sem_named(context, owner) }
    let params = context.generic_types[generic].params
    let mut args: list[int] = []
    for item in context.specializations {
        if context.functions[item.function].name == function.name {
            for i in 0..len(params) { args.append(item.arguments[i]) }
            return sem_intern(context, context.generic_types[generic].kind, owner, args)
        }
    }
    for parameter in params { args.append(sem_intern(context, "typeparam", parameter, [])) }
    return sem_intern(context, context.generic_types[generic].kind, owner, args)
}
fn sem_check_function(context: SemanticContext, function: SemFunction) {
    if function.body < 0 { return }
    let previous_capture = context.capture_nodes
    let previous_definition = context.checking_definition
    if len(function.type_params) > 0 { context.capture_nodes = false context.checking_definition = true }
    let previous_position = context.pos
    let scope = sem_enter_scope(context)
    let owner = context.owner
    let returned = context.return_type
    let previous_expected = context.expected_type
    let current_function = context.current_function
    let initial = context.initializing
    let initialized = context.initialized
    let previous_type_params = context.type_params
    let previous_constraints = context.active_constraints
    context.owner = function.owner
    context.current_function = function.name
    context.type_params = function.type_params
    context.active_constraints = function.constraints
    if len(context.owner) > 0 { context.owner = slice(context.owner, 0, len(context.owner) - 1) }
    context.pos = function.body
    let signature = context.types[function.type_id].args
    context.return_type = signature[len(signature) - 1]
    context.expected_type = context.return_type
    context.initializing = context.owner != "" and function.name == context.owner + ".init"
    for item in context.specializations { if context.functions[item.function].name == function.name and context.functions[item.template].name == context.owner + ".init" { context.initializing = true } }
    let empty: list[str] = []
    context.initialized = empty
    let mut parameters: list[int] = []
    for i in 0..len(function.params) { parameters.append(sem_declare(context, function.params[i], signature[i], false)) }
    if context.owner != "" {
        let receiver = sem_declare(context, "self", sem_function_owner_type(context, function), false)
        let mut with_receiver: list[int] = [receiver]
        for parameter in parameters { with_receiver.append(parameter) }
        parameters = with_receiver
    }
    if context.initializing {
        if context.return_type != context.unit_type { sem_error(context, "W3004", "constructor must return unit") }
        let mut parent = ""
        for class_ in context.classes { if class_.name == context.owner { parent = class_.parent } }
        if parent != "" and sem_method(context, parent, "init") >= 0 {
            if context.tokens[context.pos + 1].kind != "SUPER" or context.tokens[context.pos + 2].kind != "DOT" or context.tokens[context.pos + 3].val != "init" { sem_error(context, "W3004", "super.init must be first") }
        }
    }
    let mut req_assert_nodes: list[int] = []
    let mut ens_start_tokens: list[int] = []
    if function.contract_start >= 0 and function.contract_start < function.body {
        let contract_pos = context.pos
        context.pos = function.contract_start
        while context.pos < function.body and not sem_is(context, "EOF") and not sem_is(context, "LBRACE") {
            sem_skip_separators(context)
            if context.pos >= function.body or sem_is(context, "LBRACE") { break }
            if sem_at(context).kind == "IDENT" and sem_at(context).val == "requires" {
                sem_take(context)
                let req_src = sem_at(context)
                let cond_val = sem_expression(context, 0, false)
                sem_require_at(context, cond_val.type_id, context.boolean_type, "W2001", req_src)
                let msg_text = "Precondition ('requires') failed in '" + function.name + "'"
                let msg_node = sem_node(context, "string", context.string_type, req_src, msg_text, [], -1, -1)
                let assert_node = sem_node(context, "call", context.unit_type, req_src, "contract_assert", [cond_val.node, msg_node], -1, -1)
                req_assert_nodes.append(assert_node)
            } elif sem_at(context).kind == "IDENT" and sem_at(context).val == "ensures" {
                let ens_tok_pos = context.pos
                ens_start_tokens.append(ens_tok_pos)
                sem_take(context)
                let ens_scope = sem_enter_scope(context)
                let _res = sem_declare(context, "result", context.return_type, false)
                let ens_src = sem_at(context)
                let cond_val = sem_expression(context, 0, false)
                sem_require_at(context, cond_val.type_id, context.boolean_type, "W2001", ens_src)
                sem_leave_scope(context, ens_scope)
            } else {
                break
            }
        }
        context.pos = contract_pos
    }
    let previous_ensures = context.active_ensures_tokens
    context.active_ensures_tokens = ens_start_tokens
    context.pos = function.body
    let flow = sem_block(context, sem_unit_return(context, context.return_type))
    context.active_ensures_tokens = previous_ensures
    if not flow.terminates {
        sem_require_tail_at(context, flow.type_id, context.return_type, context.tokens[function.body])
        if sem_kind(context, context.return_type) == "result" and sem_unit_return(context, context.return_type) { sem_mark_unit_tail(context, flow.node) }
    }
    if len(req_assert_nodes) > 0 and context.capture_nodes and flow.node >= 0 {
        let mut new_children: list[int] = []
        for a_node in req_assert_nodes { new_children.append(a_node) }
        for old_child in context.nodes[flow.node].children { new_children.append(old_child) }
        context.nodes[flow.node].children = new_children
    }
    if not flow.terminates and len(ens_start_tokens) > 0 and context.capture_nodes and flow.node >= 0 {
        if len(context.nodes[flow.node].children) > 0 and flow.type_id != context.unit_type {
            let last_idx = len(context.nodes[flow.node].children) - 1
            let tail_child = context.nodes[flow.node].children[last_idx]
            let saved_pos = context.pos
            let tail_src = context.tokens[function.body]
            let ens_scope = sem_enter_scope(context)
            let result_var = sem_declare(context, "result", flow.type_id, false)
            let result_let = sem_node(context, "let", context.unit_type, tail_src, "result", [tail_child], result_var, -1)
            context.nodes[flow.node].children[last_idx] = result_let
            for ens_pos in ens_start_tokens {
                context.pos = ens_pos
                sem_skip_separators(context)
                sem_take(context)
                let ens_src = sem_at(context)
                let cond_val = sem_expression(context, 0, false)
                let msg_text = "Postcondition ('ensures') failed in '" + function.name + "'"
                let msg_node = sem_node(context, "string", context.string_type, ens_src, msg_text, [], -1, -1)
                let assert_node = sem_node(context, "call", context.unit_type, ens_src, "contract_assert", [cond_val.node, msg_node], -1, -1)
                context.nodes[flow.node].children.append(assert_node)
            }
            let res_ref = sem_node(context, "binding", flow.type_id, tail_src, "result", [], result_var, -1)
            context.nodes[flow.node].children.append(res_ref)
            sem_leave_scope(context, ens_scope)
            context.pos = saved_pos
        }
    }
    sem_complete_constructor(context)
    if context.capture_nodes {
        let raw_type_id = if function.is_async { sem_external_async_signature(context, function.type_id) } else { function.type_id }
        let type_id = if context.owner == "" { raw_type_id } else { checked_receiver_signature(context, sem_function_owner_type(context, function), raw_type_id) }
        let captures: list[int] = []
        context.checked_functions.append(CheckedFunction { captures: captures, closure: false, name: function.name, type_id: type_id, params: parameters, body: flow.node, source: context.tokens[function.body], is_async: function.is_async, async_return_type: context.return_type })
    }
    context.pos = previous_position
    sem_leave_scope(context, scope)
    context.owner = owner
    context.return_type = returned
    context.expected_type = previous_expected
    context.current_function = current_function
    context.initializing = initial
    context.initialized = initialized
    context.type_params = previous_type_params
    context.active_constraints = previous_constraints
    context.capture_nodes = previous_capture
    context.checking_definition = previous_definition
}
fn sem_check_generic_constraints(context: SemanticContext, function_index: int, args: list[int], file: str, line: int, col: int) {
    let unification = SemUnification()
    let function = context.functions[function_index]
    let signature = context.types[function.type_id]
    let empty_names: list[str] = []
    let empty_types: list[int] = []
    unification.names = empty_names
    unification.types = empty_types
    for i in 0..len(args) { sem_unify_type(context, unification, signature.args[i], args[i]) }
    if function.name == context.current_function {
        for parameter in function.type_params {
            for i in 0..len(unification.names) {
                if unification.names[i] == parameter and sem_kind(context, unification.types[i]) != "typeparam" and sem_contains_type_parameter(context, unification.types[i], parameter) {
                    report_error_at_location("W2011", file, line, col, "structural generic expansion cycle detected: " + function.name)
                }
            }
        }
    }
    for i in 0..len(function.type_params) {
        let constraint = function.constraints[i]
        if constraint != "" {
            let mut concrete = -1
            for j in 0..len(unification.names) { if unification.names[j] == function.type_params[i] { concrete = unification.types[j] } }
            if concrete < 0 or not sem_assignable(context, concrete, sem_named(context, constraint)) { report_error_at_location("W2001", file, line, col, "generic constraint not satisfied: " + constraint) }
        }
    }
}
fn sem_contains_type_parameter(context: SemanticContext, type_id: int, name: str) -> bool {
    let type_ = context.types[type_id]
    if type_.kind == "typeparam" { return type_.name == name }
    for argument in type_.args { if sem_contains_type_parameter(context, argument, name) { return true } }
    return false
}
fn sem_struct_reaches(context: SemanticContext, current: str, target: str) -> bool {
    if current == target { return true }
    for seen in context.layout_seen { if seen == current { return false } }
    context.layout_seen.append(current)
    for field in context.fields {
        if field.owner == current and sem_kind(context, field.type_id) == "struct" {
            if sem_struct_reaches(context, context.types[field.type_id].name, target) { return true }
        }
    }
    return false
}
fn sem_validate_layout_cycles(context: SemanticContext) {
    for field in context.fields {
        let empty_seen: list[str] = []
        context.layout_seen = empty_seen
        if sem_kind(context, field.type_id) == "struct" and sem_struct_reaches(context, context.types[field.type_id].name, field.owner) {
            sem_error(context, "W2011", "recursive inline struct layout detected: " + field.owner + " -> " + context.types[field.type_id].name)
        }
    }
}
fn sem_initialize(context: SemanticContext, tokens: list[Token]) {
    context.tokens = tokens
    context.integer_type = sem_simple(context, "int")
    context.float_type = sem_simple(context, "float")
    context.boolean_type = sem_simple(context, "bool")
    context.string_type = sem_simple(context, "str")
    context.unit_type = sem_simple(context, "unit")
    context.none_type = sem_simple(context, "none")
    sem_simple(context, "empty")
    context.return_type = context.unit_type
    let empty: list[int] = []
    sem_intern(context, "struct", "IoError", empty)
    sem_intern(context, "struct", "NetError", empty)
    sem_intern(context, "opaque", "opaque", empty)
    context.fields.append(SemField { owner: "IoError", name: "message", type_id: context.string_type, visible: true })
    context.fields.append(SemField { owner: "NetError", name: "message", type_id: context.string_type, visible: true })
    for i in 0..len(tokens) - 1 {
        let kind = tokens[i].kind
        if kind == "STRUCT" or kind == "CLASS" or kind == "INTERFACE" or kind == "ENUM" {
            let name = tokens[i + 1].val
            let mut tag = "struct"
            if kind == "CLASS" { tag = "class" }
            if kind == "INTERFACE" { tag = "interface" }
            if kind == "ENUM" { tag = "enum" }
            for type_ in context.types { if type_.name == name { report_error_at("W1002", tokens[i + 1], "duplicate type") } }
            sem_intern(context, tag, name, empty)
            if tokens[i + 2].kind == "LBRACKET" {
                let mut params: list[str] = []
                let mut g_constraints: list[str] = []
                let mut position = i + 3
                while position < len(tokens) and tokens[position].kind != "RBRACKET" {
                    let parameter = tokens[position]
                    if parameter.kind != "IDENT" { report_error_at("W0006", parameter, "expected generic type parameter") }
                    params.append(parameter.val)
                    position = position + 1
                    let mut constraint_name = ""
                    if position < len(tokens) and tokens[position].kind == "COLON" {
                        position = position + 1
                        if position >= len(tokens) or tokens[position].kind != "IDENT" { report_error_at("W0006", tokens[position - 1], "expected generic constraint") }
                        constraint_name = tokens[position].val
                        position = position + 1
                    }
                    g_constraints.append(constraint_name)
                    if position < len(tokens) and tokens[position].kind == "COMMA" { position = position + 1 }
                    elif position < len(tokens) and tokens[position].kind != "RBRACKET" { report_error_at("W0006", tokens[position], "expected ',' in generic parameters") }
                }
                if len(params) == 0 { report_error_at("W2001", tokens[i + 2], "generic declaration requires a type parameter") }
                context.generic_types.append(SemGenericType { name: name, kind: tag, params: params, constraints: g_constraints })
            }
        }
    }
}
fn sem_validate(context: SemanticContext, tokens: list[Token]) {
    let mut surrounded: list[Token] = [Token { kind: "LBRACE", val: "{", line: 1, col: 1, file: tokens[0].file }]
    for token in tokens {
        if token.kind != "EOF" { surrounded.append(token) }
    }
    surrounded.append(Token { kind: "RBRACE", val: "}", line: 1, col: 1, file: tokens[len(tokens) - 1].file })
    surrounded.append(Token { kind: "EOF", val: "", line: 1, col: 1, file: tokens[len(tokens) - 1].file })
    sem_initialize(context, surrounded)
    context.pos = 1
    context.collecting_declarations = true
    while true {
        sem_skip_separators(context)
        if sem_is(context, "EOF") { break }
        let attributes = sem_static_attributes(context)
        sem_match(context, "PUB")
        if sem_is(context, "AT") { sem_error(context, "W0006", "static attributes must precede pub") }
        let mut decl_is_async = false
        if sem_is(context, "IDENT") and sem_at(context).val == "async" and context.tokens[context.pos + 1].kind == "FN" { sem_take(context) decl_is_async = true }
        let declaration_source = sem_at(context)
        if len(attributes) > 0 and not sem_is(context, "FN") { report_error_at("W0006", declaration_source, "static attributes require a top-level function declaration") }
        if sem_match(context, "EXTERN") {
            if decl_is_async { report_error_at("W2001", declaration_source, "C FFI extern functions cannot be async") }
            if sem_expect(context, "STR").val != "C" { report_error_at("W2013", declaration_source, "only C ABI is supported") }
            sem_collect_function(context, "", true, false)
            let signature = context.types[context.functions[len(context.functions) - 1].type_id].args
            for i in 0..len(signature) {
                let kind = sem_kind(context, signature[i])
                if kind != "int" and kind != "float" and kind != "bool" and kind != "opaque" and not (i == len(signature) - 1 and kind == "unit") { report_error_at("W2001", declaration_source, "FFI accepts only scalars and opaque handles") }
            }
        }
        elif sem_is(context, "FN") and context.tokens[context.pos + 1].kind == "IDENT" { sem_collect_function(context, "", true, decl_is_async) sem_attach_attributes(context, attributes) }
        elif sem_is(context, "STRUCT") { sem_collect_record(context, "struct") }
        elif sem_is(context, "CLASS") { sem_collect_record(context, "class") }
        elif sem_is(context, "INTERFACE") { sem_collect_record(context, "interface") }
        elif sem_is(context, "ENUM") { sem_collect_record(context, "enum") }
        else { sem_take(context) }
    }
    context.collecting_declarations = false
    sem_validate_inheritance(context)
    sem_validate_layout_cycles(context)
    for i in 0..len(context.pending_key_types) {
        if not sem_key(context, context.pending_key_types[i]) {
            report_error_at("W2010", context.pending_key_sources[i], "invalid dictionary key")
        }
    }
    context.pos = 1
    while true {
        sem_skip_separators(context)
        if sem_is(context, "RBRACE") or sem_is(context, "EOF") { break }
        sem_static_attributes(context)
        sem_match(context, "PUB")
        if sem_is(context, "AT") { sem_error(context, "W0006", "static attributes must precede pub") }
        if sem_is(context, "IDENT") and sem_at(context).val == "async" and context.tokens[context.pos + 1].kind == "FN" { sem_take(context) }
        let mut declaration = false
        for function in context.functions {
            if function.body >= 0 and context.pos < function.body and sem_is(context, "FN") and context.tokens[context.pos + 1].val == function.name {
                sem_check_function(context, function)
                context.pos = function.end
                declaration = true
                break
            }
        }
        if not declaration {
            if sem_match(context, "EXTERN") {
                sem_expect(context, "STR")
                sem_expect(context, "FN")
                let name = sem_expect(context, "IDENT").val
                let index = sem_function(context, name)
                context.pos = context.functions[index].end
            }
            elif sem_is(context, "STRUCT") or sem_is(context, "CLASS") or sem_is(context, "INTERFACE") or sem_is(context, "ENUM") {
                sem_take(context)
                while not sem_is(context, "LBRACE") and not sem_is(context, "EOF") { sem_take(context) }
                sem_skip_block(context)
            } elif sem_is(context, "LET") {
                for ln in sem_let_nodes(context) { context.top_nodes.append(ln) }
            }
            elif sem_is(context, "FOR") or sem_is(context, "WHILE") {
                let beginning = context.pos
                while not sem_is(context, "LBRACE") and not sem_is(context, "EOF") { sem_take(context) }
                let end = sem_skip_block(context)
                let saved_tokens = context.tokens
                let mut block: list[Token] = [Token { kind: "LBRACE", val: "{", line: context.tokens[beginning].line, col: 1, file: context.tokens[beginning].file }]
                for i in beginning..end { block.append(context.tokens[i]) }
                block.append(Token { kind: "RBRACE", val: "}", line: 1, col: 1, file: context.tokens[end - 1].file })
                block.append(Token { kind: "EOF", val: "", line: 1, col: 1, file: context.tokens[end - 1].file })

                context.tokens = block
                context.pos = 0
                let flow = sem_block(context, true)
                context.top_nodes.append(flow.node)
                context.tokens = saved_tokens

                context.pos = end
            }
            elif sem_is(context, "IMPORT") {
                # Checked-module identity and dependency linking remain an explicit capability boundary.
                sem_take(context)
                sem_expect(context, "STR")
                if sem_at(context).kind == "IDENT" and sem_at(context).val == "as" {
                    sem_take(context)
                    sem_expect(context, "IDENT")
                }
            } else { context.statement_context = true context.top_nodes.append(sem_expression(context, 0, true).node) }
        }
    }
    for function in context.functions {
        let mut specialized = false
        for item in context.specializations { if context.functions[item.function].name == function.name { specialized = true } }
        if function.owner != "" and not specialized { sem_check_function(context, function) }
    }
}

fn sem_lambda(context: SemanticContext) -> SemValue {
    let token = sem_expect(context, "PIPE")
    let expected = context.expected_type
    let scope = sem_enter_scope(context)
    let previous_return = context.return_type
    let previous_loop = context.loop
    let previous_captures = context.capture_names
    let previous_capture_depth = context.capture_depth
    context.capture_depth = context.depth
    let empty_names: list[str] = []
    context.capture_names = empty_names
    let mut params: list[str] = []
    let mut parameter_bindings: list[int] = []
    let mut body = -1
    let mut types: list[int] = []
    while not sem_is(context, "PIPE") {
        let parameter_token = sem_at(context)
        let name = sem_expect(context, "IDENT").val
        let mut type_id = -1
        if sem_match(context, "COLON") { type_id = sem_type(context) }
        elif expected >= 0 and sem_kind(context, expected) == "function" and len(params) + 1 < len(context.types[expected].args) { type_id = context.types[expected].args[len(params)] }
        else { report_error_at("W2001", parameter_token, "lambda parameter needs type context") }
        params.append(name)
        types.append(type_id)
        parameter_bindings.append(sem_declare(context, name, type_id, false))
        if not sem_match(context, "COMMA") { break }
    }
    sem_expect(context, "PIPE")
    let mut returned = -1
    if sem_match(context, "ARROW") { returned = sem_type(context) }
    elif expected >= 0 and sem_kind(context, expected) == "function" {
        let exp_ret = context.types[expected].args[len(context.types[expected].args) - 1]
        if not sem_symbolic(context, exp_ret) { returned = exp_ret }
    }
    context.return_type = returned
    context.expected_type = returned
    context.loop = 0
    if sem_match(context, "FAT_ARROW") {
        context.expected_type = returned
        context.statement_context = sem_unit_return(context, returned)
        let expression_source = sem_at(context)
        let expression = sem_expression(context, 0, true)
        let actual = expression.type_id
        body = sem_node(context, "block", actual, token, "", [expression.node], -1, -1)
        if returned < 0 { returned = actual } else { sem_require_tail_at(context, actual, returned, expression_source) }
    } else {
        let flow = sem_block(context, sem_unit_return(context, context.return_type))
        body = flow.node
        if returned < 0 { returned = if context.return_type >= 0 { context.return_type } else { flow.type_id } }
        if not flow.terminates { sem_require_tail_at(context, flow.type_id, returned, token) }
    }
    types.append(returned)
    let signature = sem_intern(context, "function", "", types)
    if expected >= 0 and not sem_symbolic(context, expected) { sem_require_at(context, signature, expected, "W2001", token) }
    let captures = context.capture_names
    sem_leave_scope(context, scope)
    context.return_type = previous_return
    context.loop = previous_loop
    context.expected_type = expected
    context.capture_names = previous_captures
    context.capture_depth = previous_capture_depth
    for name in captures {
        let variable = sem_lookup(context, name)
        if variable >= 0 and context.capture_depth >= 0 and context.variables[variable].depth < context.capture_depth and not module_contains(context.capture_names, name) { context.capture_names.append(name) }
    }
    if context.capture_nodes {
        let mut capture_bindings: list[int] = []
        for name in captures {
            let variable = sem_lookup(context, name)
            if variable < 0 { report_error_at("W9999", token, "checked closure capture is unavailable") }
            capture_bindings.append(context.variables[variable].binding)
        }
        let id = len(context.checked_functions)
        let sig_args = context.types[signature].args
        context.checked_functions.append(CheckedFunction { captures: capture_bindings, closure: true, name: "closure_" + str(id), type_id: signature, params: parameter_bindings, body: body, source: token, is_async: false, async_return_type: sig_args[len(sig_args) - 1] })
        return sem_expr(context, "closure", sem_value(signature), token, "", [], -1, id)
    }
    return sem_value(signature)
}

fn sem_expression_suffix(tokens: list[Token], start: int) -> bool {
    if start >= len(tokens) { return false }
    let mut cursor = start
    while cursor < len(tokens) and tokens[cursor].kind == "NEWLINE" { cursor += 1 }
    if cursor >= len(tokens) { return false }
    let kind = tokens[cursor].kind
    if kind == "DOT" { return true }
    if kind == "ELSE" and cursor + 1 < len(tokens) {
        return tokens[cursor + 1].kind == "LBRACE" or
            (tokens[cursor + 1].kind == "IDENT" and cursor + 2 < len(tokens) and tokens[cursor + 2].kind == "LBRACE")
    }
    return cursor == start and
        (op_precedence(kind) > 0 or kind == "LPAREN" or kind == "LBRACKET" or kind == "QUESTION")
}

fn sem_delimited_expression_suffix(tokens: list[Token], start: int, open_kind: str, close_kind: str) -> bool {
    if start < 0 or start >= len(tokens) or tokens[start].kind != open_kind { return false }
    let mut depth = 0
    for i in start..len(tokens) {
        if tokens[i].kind == open_kind { depth += 1 }
        elif tokens[i].kind == close_kind {
            depth -= 1
            if depth == 0 { return sem_expression_suffix(tokens, i + 1) }
        }
    }
    return false
}

fn sem_tail_expression(context: SemanticContext) -> bool {
    let mut position = context.pos
    let mut depth = 0
    while position < len(context.tokens) {
        let kind = context.tokens[position].kind
        if kind == "LBRACE" or kind == "LPAREN" or kind == "LBRACKET" { depth = depth + 1 }
        elif kind == "RBRACE" or kind == "RPAREN" or kind == "RBRACKET" {
            if depth == 0 { return kind == "RBRACE" }
            depth = depth - 1
            if depth == 0 {
                let mut next_pos = position + 1
                while next_pos < len(context.tokens) and (context.tokens[next_pos].kind == "NEWLINE" or context.tokens[next_pos].kind == "SEMICOLON") {
                    next_pos = next_pos + 1
                }
                let next = if next_pos < len(context.tokens) { context.tokens[next_pos].kind } else { "EOF" }
                if next != "ELSE" and next != "ELIF" and next != "LBRACE" and
                   not sem_expression_suffix(context.tokens, position + 1) { return next == "RBRACE" }
            }
        }
        if depth == 0 and (kind == "LET" or kind == "RETURN") and position > context.pos { return false }
        position = position + 1
    }
    return false
}
fn sem_compatible_override(context: SemanticContext, actual: int, expected: int) -> bool {
    let a = context.types[actual].args
    let b = context.types[expected].args
    if len(a) != len(b) { return false }
    for i in 0..len(a) - 1 { if a[i] != b[i] { return false } }
    return sem_assignable(context, a[len(a) - 1], b[len(b) - 1])
}
fn sem_validate_inheritance(context: SemanticContext) {
    for class_ in context.classes {
        let mut current = class_.parent
        let mut visited: list[str] = [class_.name]
        while current != "" {
            if module_contains(visited, current) { sem_error(context, "W3003", "inheritance cycle") }
            visited.append(current)
            if sem_kind(context, sem_named(context, current)) != "class" { sem_error(context, "W3003", "base must be a class") }
            let mut next = ""
            for parent in context.classes { if parent.name == current { next = parent.parent } }
            current = next
        }
        for field in context.fields {
            if field.owner == class_.name and sem_field(context, class_.parent, field.name) >= 0 { sem_error(context, "W3003", "inherited field cannot be redeclared") }
        }
        for method in context.functions {
            if method.owner == class_.name + "." and method.name != class_.name + ".init" {
                let name = slice(method.name, len(method.owner), len(method.name))
                let inherited = sem_method(context, class_.parent, name)
                if inherited >= 0 {
                    let parent = context.functions[inherited]
                    if not parent.visible or not method.visible { sem_error(context, "W3002", "invalid override visibility") }
                    let mut parent_sig = parent.type_id
                    let parent_owner = if len(parent.owner) > 0 { slice(parent.owner, 0, len(parent.owner) - 1) } else { "" }
                    if parent_owner == class_.parent and len(class_.parent_args) > 0 {
                        let p_gen = sem_generic_type(context, parent_owner)
                        if p_gen >= 0 { parent_sig = sem_substitute_type(context, parent_sig, context.generic_types[p_gen].params, class_.parent_args) }
                    }
                    if not sem_compatible_override(context, method.type_id, parent_sig) { sem_error(context, "W3003", "incompatible override") }
                }
            }
        }
        let class_generic = sem_generic_type(context, class_.name)
        let mut class_self_args: list[int] = []
        if class_generic >= 0 {
            let empty_tp_args: list[int] = []
            for p_name in context.generic_types[class_generic].params {
                class_self_args.append(sem_intern(context, "typeparam", p_name, empty_tp_args))
            }
        }
        let class_self_type = sem_intern(context, "class", class_.name, class_self_args)
        for iface_ref in class_.interfaces {
            if sem_kind(context, sem_named(context, iface_ref.name)) != "interface" { sem_error(context, "W3003", "implements requires interface") }
            let i_gen = sem_generic_type(context, iface_ref.name)
            for requirement in context.functions {
                if requirement.owner == iface_ref.name + "." {
                    let name = slice(requirement.name, len(requirement.owner), len(requirement.name))
                    let mut req_sig = requirement.type_id
                    if i_gen >= 0 and len(iface_ref.args) > 0 {
                        req_sig = sem_substitute_type(context, req_sig, context.generic_types[i_gen].params, iface_ref.args)
                    }
                    let implementation = sem_method(context, class_.name, name)
                    if implementation < 0 { sem_error(context, "W3003", "missing interface method") }
                    let method = context.functions[implementation]
                    let mut impl_sig = method.type_id
                    if method.owner != class_.name + "." and len(method.owner) > 0 {
                        let method_owner_name = slice(method.owner, 0, len(method.owner) - 1)
                        let owner_type_id = sem_resolve_member_owner(context, class_self_type, method_owner_name)
                        let owner_type = context.types[owner_type_id]
                        let o_gen = sem_generic_type(context, method_owner_name)
                        if o_gen >= 0 and len(owner_type.args) == len(context.generic_types[o_gen].params) {
                            impl_sig = sem_substitute_type(context, impl_sig, context.generic_types[o_gen].params, owner_type.args)
                        }
                    }
                    if not method.visible or not sem_compatible_override(context, impl_sig, req_sig) { sem_error(context, "W3003", "incompatible interface implementation") }
                }
            }
        }
    }
}

# Parse irrefutable binding syntax before the iterable's type is available.
fn sem_for_pattern(context: SemanticContext, comma: bool) -> int {
    let source = sem_at(context)
    let mut children: list[int] = []
    let mut name = ""
    if sem_match(context, "LPAREN") {
        if not sem_is(context, "RPAREN") {
            children.append(sem_for_pattern(context, false))
            while sem_match(context, "COMMA") { if sem_is(context, "RPAREN") { break } children.append(sem_for_pattern(context, false)) }
        }
        sem_expect(context, "RPAREN")
        if len(children) == 1 { return children[0] }
        name = "tuple"
    } else { name = "for_binding:" + sem_expect(context, "IDENT").val }
    context.patterns.append(SemPattern { name: name, children: children, type_id: context.unit_type, binding: -1, source: source })
    let id = len(context.patterns) - 1
    if comma and sem_match(context, "COMMA") {
        let mut parts: list[int] = [id, sem_for_pattern(context, false)]
        while sem_match(context, "COMMA") { parts.append(sem_for_pattern(context, false)) }
        context.patterns.append(SemPattern { name: "tuple", children: parts, type_id: context.unit_type, binding: -1, source: source })
        return len(context.patterns) - 1
    }
    return id
}
fn sem_bind_for_pattern(context: SemanticContext, id: int, type_id: int) {
    context.patterns[id].type_id = type_id
    let pattern = context.patterns[id]
    if pattern.name == "tuple" {
        let type_ = context.types[type_id]
        if type_.kind != "tuple" or len(type_.args) != len(pattern.children) { report_error_at("W2001", pattern.source, "for destructuring requires matching tuple shape") }
        for i in 0..len(pattern.children) { sem_bind_for_pattern(context, pattern.children[i], type_.args[i]) }
    } else {
        context.patterns[id].name = "*"
        let name = slice(pattern.name, 12, len(pattern.name))
        if name != "_" { context.patterns[id].binding = sem_declare(context, name, type_id, false) }
    }
}
