# Static metadata grammar: no expressions, evaluation, macros, or plugins.
fn sem_static_attributes(context: SemanticContext) -> list[StaticAttribute] {
    let mut attributes: list[StaticAttribute] = []
    while sem_match(context, "AT") {
        let source = sem_expect(context, "IDENT")
        let mut name = source.val
        while sem_match(context, "DOT") { name = name + "." + sem_expect(context, "IDENT").val }
        for previous in attributes {
            if previous.name == name { report_error_at("W1002", source, "duplicate static attribute") }
        }
        let mut message = ""
        let mut arguments: list[AttributeArgument] = []
        if name == "deprecated" {
            sem_expect(context, "LPAREN")
            message = sem_expect(context, "STR").val
            let mut meaningful = false
            for i in 0..len(message) {
                let ch = message[i]
                if ch != " " and ch != "\t" and ch != "\n" and ch != "\r" { meaningful = true }
            }
            if not meaningful { report_error_at("W0006", source, "@deprecated requires a non-empty string literal") }
            sem_expect(context, "RPAREN")
        } elif name == "must_use" and sem_is(context, "LPAREN") {
            report_error_at("W0006", source, "@must_use does not accept arguments")
        } elif name != "must_use" and sem_match(context, "LPAREN") {
            while not sem_is(context, "RPAREN") {
                let field = sem_expect(context, "IDENT")
                for previous in arguments {
                    if previous.name == field.val { report_error_at("W1002", field, "duplicate annotation field") }
                }
                sem_expect(context, "COLON")
                let negative = sem_match(context, "MINUS")
                let literal = sem_take(context)
                let mut kind = ""
                let mut value = literal.val
                if literal.kind == "INT" {
                    kind = "int"
                    sem_pattern_int_text(context, negative, literal)
                    if negative { value = "-" + value }
                } elif literal.kind == "STR" and not negative { kind = "str" }
                elif (literal.kind == "TRUE" or literal.kind == "FALSE") and not negative { kind = "bool" }
                else { report_error_at("W0006", literal, "annotation values must be str, bool, or Int64 literals") }
                arguments.append(AttributeArgument { name: field.val, kind: kind, value: value })
                if not sem_match(context, "COMMA") { break }
            }
            sem_expect(context, "RPAREN")
        }
        attributes.append(StaticAttribute { name: name, message: message, arguments: arguments, source: source })
        sem_skip_separators(context)
    }
    return attributes
}

fn sem_validate_attributes(context: SemanticContext) {
    for function in context.functions {
        for attribute in function.attributes {
            if attribute.name == "deprecated" or attribute.name == "must_use" { continue }
            let mut schema = -1
            for i in 0..len(context.types) {
                if context.types[i].name == attribute.name and context.types[i].kind == "struct" { schema = i }
            }
            if schema < 0 or sem_generic_type(context, attribute.name) >= 0 {
                report_error_at("W0006", attribute.source, "annotation requires a non-generic struct schema: " + attribute.name)
            }
            let mut count = 0
            for field in context.fields {
                if field.owner != attribute.name { continue }
                count = count + 1
                let mut found = false
                for argument in attribute.arguments {
                    if argument.name == field.name {
                        found = true
                        if argument.kind != sem_kind(context, field.type_id) {
                            report_error_at("W2001", attribute.source, "annotation field type mismatch: " + field.name)
                        }
                    }
                }
                if not found { report_error_at("W2001", attribute.source, "missing annotation field: " + field.name) }
            }
            if count != len(attribute.arguments) { report_error_at("W2001", attribute.source, "annotation fields must match schema") }
        }
    }
}

fn sem_attach_attributes(context: SemanticContext, attributes: list[StaticAttribute]) {
    let index = len(context.functions) - 1
    let function = context.functions[index]
    let signature = context.types[function.type_id].args
    for attribute in attributes {
        if attribute.name == "must_use" and not function.is_async and signature[len(signature) - 1] == context.unit_type {
            report_error_at("W2001", attribute.source, "@must_use requires a non-unit result")
        }
    }
    context.functions[index].attributes = attributes
}

fn tool_attributes_json(attributes: list[StaticAttribute]) -> str {
    let mut items: list[str] = []
    for attribute in attributes {
        let mut arguments: list[str] = []
        if attribute.name == "deprecated" { arguments.append("\"message\":" + diag_json_quote(attribute.message)) }
        for argument in attribute.arguments {
            let value = if argument.kind == "str" { diag_json_quote(argument.value) } elif argument.kind == "int" { str(int(argument.value)) } else { argument.value }
            arguments.append(diag_json_quote(argument.name) + ":" + value)
        }
        items.append("{\"name\":" + diag_json_quote(attribute.name) + ",\"arguments\":{" + join_strings(arguments, ",") + "}}")
    }
    return "[" + join_strings(items, ",") + "]"
}
