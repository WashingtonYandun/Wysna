# Native Language Server Protocol (LSP 3.17) server backed by the semantic graph and compiler frontend.
# Shared host externs, buffer helpers, and LspJson live in 01_tool_common.wysna.

fn lsp_create_workspace() -> str {
    let nonce = diag_uuid4()
    if nonce == "native" { return "" }
    let directory = lsp_tmp_dir() + "/wysna_lsp_" + nonce
    let path = lsp_buf_from_str(directory)
    let unused = lsp_buf_from_str("")
    let status = wysna_host_fs(path, unused, 2)
    wysna_host_close(path)
    wysna_host_close(unused)
    return if status == 0 { directory } else { "" }
}

fn lsp_next_tmp_path(state: LspServerState, prefix: str, ext: str) -> str {
    state.tmp_seq = state.tmp_seq + 1
    return state.tmp_dir + "/" + prefix + "_" + str(state.tmp_seq) + ext
}

fn lsp_send_message(json_body: str) -> unit {
    let body_bytes = bytes(json_body)
    let header = "Content-Length: " + str(len(body_bytes)) + "\r\n\r\n"
    let out = wysna_host_buffer_new()
    for b in bytes(header) { wysna_host_buffer_append(out, b) }
    for b in body_bytes { wysna_host_buffer_append(out, b) }
    let _w = wysna_host_stdout_write_raw(out)
    wysna_host_close(out)
}

fn lsp_read_frame_clean(state: LspServerState) -> str {
    let mut content_length = -1
    let mut got_header = false
    while true {
        let buf = wysna_host_buffer_new()
        let st = wysna_host_stdin_read_line(buf)
        if st <= 0 {
            wysna_host_close(buf)
            state.eof_reached = true
            return ""
        }
        let line_len = lsp_buf_read_line_len(buf)
        let line = lsp_buf_to_str(buf, line_len)
        wysna_host_close(buf)
        let trimmed = lsp_trim(line)
        if trimmed == "" {
            if got_header { break }
            continue
        }
        got_header = true
        let mut colon = -1
        for i in 0..len(trimmed) {
            if trimmed[i] == ":" {
                colon = i
                break
            }
        }
        if colon > 0 {
            let key = lsp_ascii_lower(lsp_trim(slice(trimmed, 0, colon)))
            if key == "content-length" {
                content_length = lsp_parse_int(slice(trimmed, colon + 1, len(trimmed)), -1)
            }
        }
    }
    if content_length <= 0 { return "" }
    let body_buf = wysna_host_buffer_new()
    let got = wysna_host_stdin_read_exact(body_buf, content_length)
    if got <= 0 {
        wysna_host_close(body_buf)
        state.eof_reached = true
        return ""
    }
    let payload = lsp_buf_to_str(body_buf, got)
    wysna_host_close(body_buf)
    return payload
}

# LspJson and lsp_parse_json live in 01_tool_common.wysna.

fn lsp_uri_decode_pct(raw: str) -> str {
    let mut parts: list[str] = []
    let n = len(raw)
    let mut i = 0
    while i < n {
        if raw[i] == "%" and i + 2 < n {
            let hi = hex_val(ord(raw[i + 1]))
            let lo = hex_val(ord(raw[i + 2]))
            if hi >= 0 and lo >= 0 {
                parts.append(chr(hi * 16 + lo))
                i = i + 3
                continue
            }
        }
        parts.append(raw[i])
        i = i + 1
    }
    return join_strings(parts, "")
}

fn lsp_uri_to_path(uri: str) -> str {
    let mut raw = uri
    if len(uri) >= 7 and slice(uri, 0, 7) == "file://" {
        let rest = slice(uri, 7, len(uri))
        if len(rest) >= 10 and slice(rest, 0, 9) == "localhost" and rest[9] == "/" {
            raw = slice(rest, 9, len(rest))
        } else {
            raw = rest
        }
        raw = lsp_uri_decode_pct(raw)
        if len(raw) >= 3 and raw[0] == "/" and is_alpha(ord(raw[1])) and raw[2] == ":" {
            raw = slice(raw, 1, len(raw))
        }
    }
    return module_canonical(raw)
}

fn lsp_path_to_uri(path: str) -> str {
    let canon = module_canonical(path)
    let mut prefix = "file://"
    if len(canon) >= 2 and is_alpha(ord(canon[0])) and canon[1] == ":" {
        prefix = "file:///"
    } elif len(canon) == 0 or canon[0] != "/" {
        prefix = "file:///"
    }
    let mut parts: list[str] = [prefix]
    for i in 0..len(canon) {
        let ch = canon[i]
        if ch == " " { parts.append("%20") }
        elif ch == "#" { parts.append("%23") }
        elif ch == "?" { parts.append("%3F") }
        elif ch == "%" { parts.append("%25") }
        else { parts.append(ch) }
    }
    return join_strings(parts, "")
}

fn lsp_utf16_offset(src: str, target_line: int, target_char: int) -> int {
    let n = len(src)
    let mut line = 0
    let mut i = 0
    while i < n and line < target_line {
        if src[i] == "\n" { line = line + 1 }
        i = i + 1
    }
    let mut u16 = 0
    while i < n and src[i] != "\n" and u16 < target_char {
        let width = if ord(src[i]) > 65535 { 2 } else { 1 }
        if u16 + width > target_char { break }
        u16 = u16 + width
        i = i + 1
    }
    return i
}

fn lsp_utf16_pos(src: str, char_off: int) -> list[int] {
    let mut limit = char_off
    let n = len(src)
    if limit < 0 { limit = 0 }
    if limit > n { limit = n }
    let mut line = 0
    let mut u16 = 0
    for i in 0..limit {
        if src[i] == "\n" {
            line = line + 1
            u16 = 0
        } else {
            u16 = u16 + (if ord(src[i]) > 65535 { 2 } else { 1 })
        }
    }
    return [line, u16]
}

fn lsp_char_offset_from_utf8_byte(src: str, target_byte: int) -> int {
    if target_byte <= 0 { return 0 }
    let mut byte_pos = 0
    let mut i = 0
    let n = len(src)
    while i < n and byte_pos < target_byte {
        let cp = ord(src[i])
        let w = if cp < 128 { 1 } elif cp < 2048 { 2 } elif cp < 65536 { 3 } else { 4 }
        byte_pos = byte_pos + w
        i = i + 1
    }
    return i
}

fn lsp_pos_json(line: int, ch: int) -> str {
    return "{\"line\":" + str(line) + ",\"character\":" + str(ch) + "}"
}

fn lsp_range_json_offsets(src: str, start_off: int, end_off: int) -> str {
    let p0 = lsp_utf16_pos(src, start_off)
    let p1 = lsp_utf16_pos(src, end_off)
    return "{\"start\":" + lsp_pos_json(p0[0], p0[1]) + ",\"end\":" + lsp_pos_json(p1[0], p1[1]) + "}"
}

fn lsp_span_range_json(src: str, line_1: int, col_1: int, width_chars: int) -> str {
    let l1 = if line_1 < 1 { 1 } else { line_1 }
    let c1 = if col_1 < 1 { 1 } else { col_1 }
    let start_off = lsp_utf16_offset(src, l1 - 1, c1 - 1)
    let w = if width_chars < 1 { 1 } else { width_chars }
    let mut end_off = start_off + w
    if end_off > len(src) { end_off = len(src) }
    return lsp_range_json_offsets(src, start_off, end_off)
}

class LspDocument {
    uri: str
    path: str
    version: int
    text: str
    tmp_path: str
    has_graph: bool
    clean_ok: bool
    graph: ToolGraph
    diagnostics: list[LspJson]
    function_sites: list[LspRenameSite]

    fn init(uri: str, path: str, version: int, text: str, tmp_path: str) {
        this.uri = uri
        this.path = path
        this.version = version
        this.text = text
        this.tmp_path = tmp_path
        this.has_graph = false
        this.clean_ok = false
        this.graph = ToolGraph(path, text)
        let diagnostics: list[LspJson] = []
        this.diagnostics = diagnostics
        let sites: list[LspRenameSite] = []
        this.function_sites = sites
    }
}

class LspServerState {
    docs: list[LspDocument]
    stopping: bool
    eof_reached: bool
    tmp_seq: int
    tmp_dir: str
    diag_tmp_path: str
    self_exe: str
    stdlib_root: str
    workspace_roots: list[str]

    fn init(tmp_dir: str) {
        let d0: list[LspDocument] = []
        this.docs = d0
        this.stopping = false
        this.eof_reached = false
        this.tmp_seq = 1
        this.tmp_dir = tmp_dir
        this.diag_tmp_path = tmp_dir + "/diagnostics.json"
        this.self_exe = lsp_self_exe_path()
        this.stdlib_root = lsp_stdlib_root_arg()
        let roots: list[str] = []
        this.workspace_roots = roots
    }
}

fn lsp_find_doc_idx(state: LspServerState, uri: str) -> int {
    for i in 0..len(state.docs) {
        if state.docs[i].uri == uri { return i }
    }
    return -1
}

fn lsp_overlay_paths(state: LspServerState) -> list[str] {
    let mut paths: list[str] = []
    for doc in state.docs { paths.append(doc.path) }
    return paths
}

fn lsp_overlay_texts(state: LspServerState) -> list[str] {
    let mut texts: list[str] = []
    for doc in state.docs { texts.append(doc.text) }
    return texts
}

fn lsp_apply_content_changes(text: str, changes: LspJson) -> str {
    if changes.kind != "array" { return text }
    let mut current = text
    for change in changes.items {
        let rep = lsp_json_str(change, "text", "")
        if lsp_json_has(change, "range") {
            let rng = lsp_json_get(change, "range")
            let st = lsp_json_get(rng, "start")
            let en = lsp_json_get(rng, "end")
            let start_off = lsp_utf16_offset(current, lsp_json_int(st, "line", 0), lsp_json_int(st, "character", 0))
            let end_off = lsp_utf16_offset(current, lsp_json_int(en, "line", 0), lsp_json_int(en, "character", 0))
            current = slice(current, 0, start_off) + rep + slice(current, end_off, len(current))
        } else {
            current = rep
        }
    }
    return current
}

fn lsp_publish_empty_diags(uri: str) -> unit {
    lsp_send_message("{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{\"uri\":" + diag_json_quote(uri) + ",\"diagnostics\":[]}}")
}

fn lsp_check_snapshot(state: LspServerState, path: str, paths: list[str], snapshots: list[str]) -> str {
    let mut argv: list[str] = []
    if state.stdlib_root != "" {
        argv.append("--stdlib-root")
        argv.append(state.stdlib_root)
    }
    argv.append("check")
    argv.append(path)
    argv.append("--output-format=json-v1")
    argv.append("--diag-out")
    argv.append(state.diag_tmp_path)
    for index in 0..len(paths) {
        argv.append("--overlay")
        argv.append(paths[index])
        argv.append(snapshots[index])
    }
    let exe_buf = lsp_buf_from_str(state.self_exe)
    let args_buf = lsp_pack_argv_buf(argv)
    let rc = wysna_host_process_run(exe_buf, args_buf, 30000)
    wysna_host_close(exe_buf)
    wysna_host_close(args_buf)

    let diag_raw = read_file(state.diag_tmp_path) else err { "" }
    lsp_remove_file(state.diag_tmp_path)
    if rc != 0 and lsp_json_str(lsp_parse_json(diag_raw), "status", "") == "ok" { return "" }
    return diag_raw
}

fn lsp_check_and_publish(state: LspServerState, doc_idx: int) -> unit {
    if doc_idx < 0 or doc_idx >= len(state.docs) { return }
    let doc = state.docs[doc_idx]
    let mut snapshots: list[str] = []
    for d in state.docs {
        write_file(d.tmp_path, d.text) else _err { return }
        snapshots.append(d.tmp_path)
    }
    let diag_raw = lsp_check_snapshot(state, doc.path, lsp_overlay_paths(state), snapshots)
    let mut diag_items: list[str] = []
    let mut diagnostics: list[LspJson] = []
    let mut parsed_ok = false
    if diag_raw != "" {
        let parsed = lsp_parse_json(diag_raw)
        if lsp_json_str(parsed, "status", "") == "ok" {
            parsed_ok = true
        }
        let d_arr = lsp_json_get(parsed, "diagnostics")
        if d_arr.kind == "array" {
            for item in d_arr.items {
                diagnostics.append(item)
                let code = lsp_json_str(item, "code", "W0001")
                let sev_str = lsp_json_str(item, "severity", "error")
                let sev = if sev_str == "warning" { 2 } elif sev_str == "info" { 3 } else { 1 }
                let msg = lsp_json_str(item, "message", "Compiler diagnostic")
                let sp = lsp_json_get(item, "primary_span")
                let mut range_json = "{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":0,\"character\":1}}"
                if sp.kind == "object" {
                    let sb = lsp_json_int(sp, "start_byte", 0)
                    let eb = lsp_json_int(sp, "end_byte", sb + 1)
                    let span_file = lsp_json_str(sp, "source_id", "")
                    let span_src = lsp_node_source_text(state, doc, span_file)
                    let start_c = lsp_char_offset_from_utf8_byte(span_src, sb)
                    let mut end_c = lsp_char_offset_from_utf8_byte(span_src, eb)
                    if end_c <= start_c { end_c = start_c + 1 }
                    if end_c > len(span_src) { end_c = len(span_src) }
                    range_json = lsp_range_json_offsets(span_src, start_c, end_c)
                }
                diag_items.append("{\"range\":" + range_json + ",\"severity\":" + str(sev) + ",\"code\":" + diag_json_quote(code) + ",\"source\":\"wysna\",\"message\":" + diag_json_quote(msg) + "}")
            }
        }
    }
    doc.diagnostics = diagnostics
    lsp_send_message("{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{\"uri\":" + diag_json_quote(doc.uri) + ",\"diagnostics\":[" + join_strings(diag_items, ",") + "]}}")

    if parsed_ok {
        let paths = lsp_overlay_paths(state)
        let texts = lsp_overlay_texts(state)
        let loader = lsp_load_source(doc.text, doc.path, paths, texts)
        let program = check_program(loader.output, doc.path, true)
        doc.graph = tool_build_checked_graph(doc.text, doc.path, loader.output, program, paths, texts, false)
        doc.function_sites = lsp_collect_function_sites(loader, program)
        doc.has_graph = true
        doc.clean_ok = true
    } else {
        doc.clean_ok = false
    }
}

fn lsp_ident_bounds_at(src: str, offset: int) -> list[int] {
    let n = len(src)
    let mut pos = offset
    if pos > 0 and (pos == n or not is_alnum(ord(src[pos]))) and is_alnum(ord(src[pos - 1])) {
        pos = pos - 1
    }
    if pos >= n or not is_alnum(ord(src[pos])) { return [-1, -1] }
    let mut lo = pos
    while lo > 0 and is_alnum(ord(src[lo - 1])) { lo = lo - 1 }
    let mut hi = pos + 1
    while hi < n and is_alnum(ord(src[hi])) { hi = hi + 1 }
    if is_digit(ord(src[lo])) { return [-1, -1] }
    return [lo, hi]
}

fn lsp_qualifier_before(src: str, ident_lo: int) -> str {
    if ident_lo < 2 or src[ident_lo - 1] != "." { return "" }
    let mut q_hi = ident_lo - 1
    let mut q_lo = q_hi
    while q_lo > 0 and is_alnum(ord(src[q_lo - 1])) { q_lo = q_lo - 1 }
    if q_lo == q_hi { return "" }
    return slice(src, q_lo, q_hi)
}

fn lsp_resolve_nodes_at(doc: LspDocument, line: int, character: int) -> list[int] {
    let mut matched: list[int] = []
    if not doc.has_graph { return matched }
    let off = lsp_utf16_offset(doc.text, line, character)
    let bounds = lsp_ident_bounds_at(doc.text, off)
    if bounds[0] < 0 { return matched }
    let word = slice(doc.text, bounds[0], bounds[1])
    let qual = lsp_qualifier_before(doc.text, bounds[0])
    if qual != "" {
        let dotted = qual + "." + word
        for i in 0..len(doc.graph.nodes) {
            let n = doc.graph.nodes[i]
            if n.qualified_name == dotted or n.name == word and (n.owner == qual or tool_basename(n.file) == qual + ".wysna") {
                matched.append(i)
            }
        }
        if len(matched) > 0 { return matched }
    }
    for i in 0..len(doc.graph.nodes) {
        let n = doc.graph.nodes[i]
        if n.name == word or n.qualified_name == word { matched.append(i) }
    }
    return matched
}

fn lsp_node_source_text(state: LspServerState, doc: LspDocument, file: str) -> str {
    if file == doc.path { return doc.text }
    for d in state.docs {
        if d.path == file { return d.text }
    }
    let res = module_read_text_or_overlay(file)
    return if res[0] == "1" { res[1] } else { doc.text }
}

fn lsp_node_location_json(state: LspServerState, doc: LspDocument, n: ToolGraphNode) -> str {
    let target_src = lsp_node_source_text(state, doc, n.file)
    let range_json = lsp_span_range_json(target_src, n.line, n.col, len(n.name))
    return "{\"uri\":" + diag_json_quote(lsp_path_to_uri(n.file)) + ",\"range\":" + range_json + "}"
}

fn lsp_handle_definition(state: LspServerState, doc: LspDocument, pos_obj: LspJson) -> str {
    let idxs = lsp_resolve_nodes_at(doc, lsp_json_int(pos_obj, "line", 0), lsp_json_int(pos_obj, "character", 0))
    if len(idxs) == 0 { return "null" }
    return lsp_node_location_json(state, doc, doc.graph.nodes[idxs[0]])
}

fn lsp_handle_implementation(state: LspServerState, doc: LspDocument, pos_obj: LspJson) -> str {
    let idxs = lsp_resolve_nodes_at(doc, lsp_json_int(pos_obj, "line", 0), lsp_json_int(pos_obj, "character", 0))
    if len(idxs) == 0 { return "[]" }
    let node = doc.graph.nodes[idxs[0]]
    let mut locs: list[str] = []
    for target_id in node.implemented_by {
        let tidx = tool_find_node_idx(doc.graph, target_id)
        if tidx >= 0 { locs.append(lsp_node_location_json(state, doc, doc.graph.nodes[tidx])) }
    }
    for sub_id in node.subclasses {
        let sidx = tool_find_node_idx(doc.graph, sub_id)
        if sidx >= 0 { locs.append(lsp_node_location_json(state, doc, doc.graph.nodes[sidx])) }
    }
    return "[" + join_strings(locs, ",") + "]"
}

fn lsp_rel_line(label: str, items: list[str]) -> str {
    if len(items) == 0 { return "" }
    return "- **" + label + ":** `" + join_strings(items, "`, `") + "`"
}

fn lsp_add_rel(lines: list[str], label: str, items: list[str]) -> list[str] {
    let entry = lsp_rel_line(label, items)
    if entry == "" { return lines }
    let mut out = lines
    out.append(entry)
    return out
}

fn lsp_handle_hover(doc: LspDocument, pos_obj: LspJson) -> str {
    let idxs = lsp_resolve_nodes_at(doc, lsp_json_int(pos_obj, "line", 0), lsp_json_int(pos_obj, "character", 0))
    if len(idxs) == 0 { return "null" }
    let n = doc.graph.nodes[idxs[0]]
    let mut lines: list[str] = ["```wysna", n.signature, "```", "", "`" + n.kind + "` in `" + tool_basename(n.file) + "`"]
    if n.super_class != "" { lines.append("- **Extends:** `" + n.super_class + "`") }
    lines = lsp_add_rel(lines, "Implements", n.implements_list)
    lines = lsp_add_rel(lines, "Implemented by", n.implemented_by)
    lines = lsp_add_rel(lines, "Subclasses", n.subclasses)
    lines = lsp_add_rel(lines, "Calls", n.calls)
    lines = lsp_add_rel(lines, "Called by", n.called_by)
    lines = lsp_add_rel(lines, "Uses types", n.uses_types)
    lines = lsp_add_rel(lines, "Effects", n.effects)
    lines = lsp_add_rel(lines, "Capabilities", n.capabilities)
    let md = join_strings(lines, "\n")
    return "{\"contents\":{\"kind\":\"markdown\",\"value\":" + diag_json_quote(md) + "}}"
}

class LspRefCollector {
    locs: list[str]
    seen: list[str]

    fn init() {
        let l0: list[str] = []
        this.locs = l0
        let s0: list[str] = []
        this.seen = s0
    }
}

fn lsp_scan_word_locs(acc: LspRefCollector, file_path: str, src: str, word: str, skip_decl_line: int) -> unit {
    let n = len(src)
    let wlen = len(word)
    let uri = lsp_path_to_uri(file_path)
    let mut i = 0
    while i < n {
        if src[i] == "#" {
            while i < n and src[i] != "\n" { i = i + 1 }
            continue
        }
        if is_alpha(ord(src[i])) or src[i] == "_" {
            let start = i
            while i < n and is_alnum(ord(src[i])) { i = i + 1 }
            if i - start == wlen and slice(src, start, i) == word {
                let pos = lsp_utf16_pos(src, start)
                if skip_decl_line > 0 and pos[0] + 1 == skip_decl_line { continue }
                let loc_key = uri + ":" + str(pos[0]) + ":" + str(pos[1])
                if not tool_str_contains(acc.seen, loc_key) {
                    acc.seen.append(loc_key)
                    acc.locs.append("{\"uri\":" + diag_json_quote(uri) + ",\"range\":" + lsp_range_json_offsets(src, start, i) + "}")
                }
            }
        } else {
            i = i + 1
        }
    }
}

fn lsp_handle_references(state: LspServerState, doc: LspDocument, pos_obj: LspJson, include_decl: bool) -> str {
    let off = lsp_utf16_offset(doc.text, lsp_json_int(pos_obj, "line", 0), lsp_json_int(pos_obj, "character", 0))
    let bounds = lsp_ident_bounds_at(doc.text, off)
    if bounds[0] < 0 { return "[]" }
    let word = slice(doc.text, bounds[0], bounds[1])
    let idxs = lsp_resolve_nodes_at(doc, lsp_json_int(pos_obj, "line", 0), lsp_json_int(pos_obj, "character", 0))
    let skip_file = if not include_decl and len(idxs) > 0 { doc.graph.nodes[idxs[0]].file } else { "" }
    let skip_line = if not include_decl and len(idxs) > 0 { doc.graph.nodes[idxs[0]].line } else { -1 }

    let acc = LspRefCollector()
    let mut scanned_files: list[str] = []
    for d in state.docs {
        scanned_files.append(d.path)
        let sk = if d.path == skip_file { skip_line } else { -1 }
        lsp_scan_word_locs(acc, d.path, d.text, word, sk)
    }
    if doc.has_graph {
        for mpath in doc.graph.mod_names {
            if not tool_str_contains(scanned_files, mpath) {
                scanned_files.append(mpath)
                let res = module_read_text_or_overlay(mpath)
                if res[0] == "1" {
                    let sk = if mpath == skip_file { skip_line } else { -1 }
                    lsp_scan_word_locs(acc, mpath, res[1], word, sk)
                }
            }
        }
    }
    return "[" + join_strings(acc.locs, ",") + "]"
}

fn lsp_completion_kind(kind: str) -> int {
    if kind == "fn" { return 3 }
    if kind == "method" { return 2 }
    if kind == "field" { return 5 }
    if kind == "struct" { return 22 }
    if kind == "class" { return 7 }
    if kind == "interface" { return 8 }
    if kind == "enum" { return 13 }
    return 6
}

fn lsp_handle_completion(doc: LspDocument, pos_obj: LspJson) -> str {
    let off = lsp_utf16_offset(doc.text, lsp_json_int(pos_obj, "line", 0), lsp_json_int(pos_obj, "character", 0))
    let mut lo = off
    while lo > 0 and is_alnum(ord(doc.text[lo - 1])) { lo = lo - 1 }
    let prefix = slice(doc.text, lo, off)
    let qual = lsp_qualifier_before(doc.text, lo)
    let mut items: list[str] = []
    let mut seen_labels: list[str] = []

    if doc.has_graph {
        for n in doc.graph.nodes {
            if qual != "" {
                let matches_owner = n.owner == qual or tool_short_name(n.owner) == qual or tool_basename(n.file) == qual + ".wysna"
                if not matches_owner { continue }
            }
            if prefix != "" and (len(n.name) < len(prefix) or slice(n.name, 0, len(prefix)) != prefix) {
                continue
            }
            if not tool_str_contains(seen_labels, n.name) {
                seen_labels.append(n.name)
                items.append("{\"label\":" + diag_json_quote(n.name) + ",\"kind\":" + str(lsp_completion_kind(n.kind)) + ",\"detail\":" + diag_json_quote(n.signature) + "}")
            }
        }
    }
    if qual == "" {
        let kws: list[str] = ["fn", "async", "struct", "class", "interface", "enum", "let", "mut", "if", "elif", "else", "for", "while", "match", "return", "await", "import", "pub", "priv", "true", "false", "None", "Some", "Ok", "Err"]
        for kw in kws {
            if prefix != "" and (len(kw) < len(prefix) or slice(kw, 0, len(prefix)) != prefix) { continue }
            if not tool_str_contains(seen_labels, kw) {
                seen_labels.append(kw)
                items.append("{\"label\":" + diag_json_quote(kw) + ",\"kind\":14}")
            }
        }
    }
    return "[" + join_strings(items, ",") + "]"
}

fn lsp_handle_formatting(doc: LspDocument) -> str {
    if not doc.clean_ok { return "[]" }
    let body = selfhost_format_body(doc.text, doc.path)
    let formatted = if len(body) > 0 { body + "\n" } else { "" }
    if formatted == doc.text { return "[]" }
    let rng = lsp_range_json_offsets(doc.text, 0, len(doc.text))
    return "[{\"range\":" + rng + ",\"newText\":" + diag_json_quote(formatted) + "}]"
}

fn lsp_semantic_tok_type(tok: Token) -> int {
    # Legend index: 0:keyword, 1:type, 2:class, 3:interface, 4:enum, 5:struct,
    # 6:function, 7:method, 8:property, 9:variable, 10:parameter, 11:string, 12:number, 13:operator
    let k = tok.kind
    if k == "STR" or k == "FSTR" { return 11 }
    if k == "INT" or k == "FLOAT" { return 12 }
    if k == "FN" or k == "LET" or k == "MUT" or k == "STRUCT" or k == "CLASS" or k == "INTERFACE" or k == "ENUM" or k == "IF" or k == "ELIF" or k == "ELSE" or k == "FOR" or k == "IN" or k == "WHILE" or k == "RETURN" or k == "MATCH" or k == "IMPORT" or k == "FROM" or k == "AS" or k == "PUB" or k == "PRIV" or k == "TRUE" or k == "FALSE" or k == "THIS" or k == "SUPER" or k == "EXTERN" or k == "AND" or k == "OR" or k == "NOT" or k == "REQUIRES" or k == "ENSURES" {
        return 0
    }
    if k == "IDENT" {
        if tok.val == "async" or tok.val == "await" { return 0 }
        if tok.val == "int" or tok.val == "float" or tok.val == "str" or tok.val == "bool" or tok.val == "unit" or tok.val == "list" or tok.val == "dict" or tok.val == "opaque" {
            return 1
        }
        if len(tok.val) > 0 and ord(tok.val[0]) >= 65 and ord(tok.val[0]) <= 90 { return 1 }
        return 9
    }
    if k == "PLUS" or k == "MINUS" or k == "STAR" or k == "SLASH" or k == "PERCENT" or k == "EQ" or k == "NEQ" or k == "LT" or k == "LTE" or k == "GT" or k == "GTE" or k == "ASSIGN" or k == "PLUS_ASSIGN" or k == "MINUS_ASSIGN" or k == "STAR_ASSIGN" or k == "ARROW" or k == "FAT_ARROW" {
        return 13
    }
    return -1
}

fn lsp_handle_semantic_tokens(doc: LspDocument) -> str {
    if not doc.clean_ok { return "{\"data\":[]}" }
    let tokens = tokenize(doc.text, doc.path)
    let mut nums: list[str] = []
    let mut prev_line = 0
    let mut prev_col = 0
    for i in 0..len(tokens) {
        let tok = tokens[i]
        let mut ttype = lsp_semantic_tok_type(tok)
        if ttype < 0 { continue }
        if ttype == 9 and i + 1 < len(tokens) and tokens[i + 1].kind == "LPAREN" {
            ttype = 6
        }
        let mut tok_len = len(tok.val)
        if tok.kind == "STR" { tok_len = tok_len + 2 }
        if tok_len <= 0 { continue }
        let line0 = if tok.line > 0 { tok.line - 1 } else { 0 }
        let off = lsp_utf16_offset(doc.text, line0, if tok.col > 0 { tok.col - 1 } else { 0 })
        let u16 = lsp_utf16_pos(doc.text, off)
        let cur_line = u16[0]
        let cur_col = u16[1]
        let d_line = cur_line - prev_line
        let d_col = if d_line == 0 { cur_col - prev_col } else { cur_col }
        nums.append(str(d_line))
        nums.append(str(d_col))
        nums.append(str(tok_len))
        nums.append(str(ttype))
        nums.append("0")
        prev_line = cur_line
        prev_col = cur_col
    }
    return "{\"data\":[" + join_strings(nums, ",") + "]}"
}

fn lsp_recheck_dependents(state: LspServerState, exclude_uri: str) -> unit {
    for i in 0..len(state.docs) {
        if state.docs[i].uri != exclude_uri {
            lsp_check_and_publish(state, i)
        }
    }
}

fn lsp_cleanup(state: LspServerState) -> unit {
    lsp_remove_file(state.diag_tmp_path)
    for d in state.docs { lsp_remove_file(d.tmp_path) }
    lsp_remove_file(state.tmp_dir)
}

fn lsp_range_offset(src: str, range_: LspJson, endpoint: str) -> int {
    let pos = lsp_json_get(range_, endpoint)
    return lsp_utf16_offset(src, lsp_json_int(pos, "line", 0), lsp_json_int(pos, "character", 0))
}

fn lsp_text_document_edit(uri: str, version: str, edits: list[str]) -> str {
    return "{\"textDocument\":{\"uri\":" + diag_json_quote(uri) + ",\"version\":" + version +
        "},\"edits\":[" + join_strings(edits, ",") + "]}"
}

fn lsp_edit_json(src: str, start: int, end: int, replacement: str) -> str {
    return "{\"range\":" + lsp_range_json_offsets(src, start, end) + ",\"newText\":" + diag_json_quote(replacement) + "}"
}

fn lsp_handle_code_actions(doc: LspDocument, params: LspJson) -> str {
    let only = lsp_json_get(lsp_json_get(params, "context"), "only")
    if only.kind == "array" and len(only.items) > 0 {
        let mut allowed = false
        for item in only.items { if item.str_val == "quickfix" or item.str_val == "" { allowed = true } }
        if not allowed { return "[]" }
    }
    if len(doc.diagnostics) == 0 { return "[]" }
    let range_ = lsp_json_get(params, "range")
    let requested_start = lsp_range_offset(doc.text, range_, "start")
    let requested_end = lsp_range_offset(doc.text, range_, "end")
    let sha = diag_sha256_hex(doc.text)
    let length = diag_utf8_byte_at(doc.text, len(doc.text))
    let mut actions: list[str] = []
    for diagnostic in doc.diagnostics {
        let span = lsp_json_get(diagnostic, "primary_span")
        if lsp_json_str(span, "source_id", "") != doc.path or lsp_json_str(span, "source_sha256", "") != sha { continue }
        let start = lsp_char_offset_from_utf8_byte(doc.text, lsp_json_int(span, "start_byte", 0))
        let end = lsp_char_offset_from_utf8_byte(doc.text, lsp_json_int(span, "end_byte", 0))
        if range_.kind == "object" and (end < requested_start or start > requested_end) { continue }
        let code = lsp_json_str(diagnostic, "code", "")
        for fix in lsp_json_get(diagnostic, "fixes").items {
            let proposed = lsp_json_get(fix, "edits").items
            let mut edits: list[str] = []
            for edit in proposed {
                let start_byte = lsp_json_int(edit, "start_byte", -1)
                let end_byte = lsp_json_int(edit, "end_byte", -1)
                if start_byte < 0 or end_byte < start_byte or end_byte > length or
                   lsp_json_str(edit, "source_id", "") != doc.path or lsp_json_str(edit, "source_sha256", "") != sha { break }
                let start_char = lsp_char_offset_from_utf8_byte(doc.text, start_byte)
                let end_char = lsp_char_offset_from_utf8_byte(doc.text, end_byte)
                if diag_utf8_byte_at(doc.text, start_char) != start_byte or diag_utf8_byte_at(doc.text, end_char) != end_byte { break }
                edits.append(lsp_edit_json(doc.text, start_char, end_char, lsp_json_str(edit, "replacement", "")))
            }
            if len(edits) == 0 or len(edits) != len(proposed) { continue }
            let title = "[" + code + "] " + lsp_json_str(fix, "description", "Repair diagnostic")
            let preferred = if lsp_json_str(fix, "applicability", "") == "machine" { "true" } else { "false" }
            actions.append("{\"title\":" + diag_json_quote(title) + ",\"kind\":\"quickfix\",\"isPreferred\":" + preferred +
                ",\"edit\":{\"documentChanges\":[" + lsp_text_document_edit(doc.uri, str(doc.version), edits) + "]}}")
        }
    }
    return "[" + join_strings(actions, ",") + "]"
}

# Inspect incomplete calls without asking the reporting lexer to accept invalid editor text.
fn lsp_call_prefix(src: str, limit: int) -> list[int] {
    let mut delimiters: list[str] = []
    let mut opens: list[int] = []
    let mut commas: list[int] = []
    let mut i = 0
    while i < limit {
        let ch = src[i]
        if ch == "#" {
            while i < limit and src[i] != "\n" { i += 1 }
        } elif ch == "\"" {
            let quote_width = if i + 2 < limit and src[i + 1] == "\"" and src[i + 2] == "\"" { 3 } else { 1 }
            i += quote_width
            while i < limit {
                if src[i] == "\\" { i += 2 }
                elif src[i] == "\"" and (quote_width == 1 or
                     (i + 2 < limit and src[i + 1] == "\"" and src[i + 2] == "\"")) {
                    i += quote_width
                    break
                } else { i += 1 }
            }
        } else {
            if ch == "(" or ch == "[" or ch == "{" {
                opens.append(i)
                delimiters.append(ch)
                commas.append(0)
            } elif (ch == ")" or ch == "]" or ch == "}") and len(opens) > 0 {
                delimiters.pop()
                opens.pop()
                commas.pop()
            } elif ch == "," and len(opens) > 0 {
                commas[len(commas) - 1] += 1
            }
            i += 1
        }
    }
    for index in 0..len(opens) {
        let last = len(opens) - 1 - index
        if delimiters[last] == "(" { return [opens[last], commas[last]] }
    }
    return [-1, 0]
}

fn lsp_signature_parameters(label: str) -> list[str] {
    let mut params: list[str] = []
    let mut depth = 0
    let mut start = -1
    for i in 0..len(label) {
        let ch = label[i]
        if start < 0 {
            if ch == "(" { start = i + 1 }
        } elif depth == 0 and (ch == "," or ch == ")") {
            let param = lsp_trim(slice(label, start, i))
            if param != "" { params.append("{\"label\":" + diag_json_quote(param) + "}") }
            if ch == ")" { break }
            start = i + 1
        } elif ch == "(" or ch == "[" { depth += 1 }
        elif ch == ")" or ch == "]" { depth -= 1 }
    }
    return params
}

fn lsp_handle_signature_help(doc: LspDocument, pos: LspJson) -> str {
    let offset = lsp_utf16_offset(doc.text, lsp_json_int(pos, "line", 0), lsp_json_int(pos, "character", 0))
    let call = lsp_call_prefix(doc.text, offset)
    if call[0] <= 0 { return "null" }
    let mut callee_end = call[0]
    while callee_end > 0 and (doc.text[callee_end - 1] == " " or doc.text[callee_end - 1] == "\t") { callee_end -= 1 }
    if callee_end > 0 and doc.text[callee_end - 1] == "]" {
        let mut depth = 1
        callee_end -= 1
        while callee_end > 0 and depth > 0 {
            callee_end -= 1
            if doc.text[callee_end] == "]" { depth += 1 }
            elif doc.text[callee_end] == "[" { depth -= 1 }
        }
    }
    let callee = lsp_ident_bounds_at(doc.text, callee_end)
    if callee[0] < 0 or callee[1] != callee_end { return "null" }
    let callee_pos = lsp_utf16_pos(doc.text, callee[0])
    let mut candidates: list[int] = []
    let spelling = slice(doc.text, callee[0], callee[1])
    for site in doc.function_sites {
        if site.source.val != spelling or not lsp_rename_token_at(doc, site.source, callee[0]) { continue }
        for index in 0..len(doc.graph.nodes) {
            let node = doc.graph.nodes[index]
            if node.name == site.declaration.val and node.file == site.declaration.file and node.line == site.declaration.line and not (index in candidates) {
                candidates.append(index)
            }
        }
    }
    if len(candidates) == 0 { candidates = lsp_resolve_nodes_at(doc, callee_pos[0], callee_pos[1]) }
    let mut signatures: list[str] = []
    let mut active = 0
    for candidate in candidates {
        let node = doc.graph.nodes[candidate]
        if node.kind != "fn" and node.kind != "method" and node.kind != "extern" { continue }
        let params = lsp_signature_parameters(node.signature)
        if len(signatures) == 0 and len(params) > 0 {
            active = if call[1] < len(params) { call[1] } else { len(params) - 1 }
        }
        signatures.append("{\"label\":" + diag_json_quote(node.signature) + ",\"parameters\":[" + join_strings(params, ",") + "]}")
    }
    if len(signatures) == 0 { return "null" }
    return "{\"signatures\":[" + join_strings(signatures, ",") + "],\"activeSignature\":0,\"activeParameter\":" + str(active) + "}"
}

struct LspRenameSite { source: Token, declaration: Token, rewrite: bool }

fn lsp_same_token(left: Token, right: Token) -> bool {
    return left.file == right.file and left.line == right.line and left.col == right.col
}

fn lsp_token_key(token: Token) -> str {
    return token.file + ":" + str(token.line) + ":" + str(token.col) + ":" + token.val
}

fn lsp_load_source(src: str, file: str, paths: list[str], texts: list[str]) -> ModuleLoader {
    let loader = ModuleLoader()
    loader.ov_paths = paths
    loader.ov_texts = texts
    loader.trace_names = true
    module_expand(loader, src, file, true)
    loader.output.append(Token { kind: "EOF", val: "", line: 1, col: 1, file: file })
    return loader
}

fn lsp_collect_function_sites(loader: ModuleLoader, program: CheckedProgram) -> list[LspRenameSite] {
    let mut declarations: dict[str, Token] = {}
    let mut sites: list[LspRenameSite] = []
    let mut depth = 0
    for i in 0..len(loader.output) - 1 {
        let token = loader.output[i]
        if depth == 0 and token.kind == "FN" and loader.output[i + 1].kind == "IDENT" {
            let name = loader.output[i + 1]
            let where_ = Token { kind: "IDENT", val: tool_short_name(name.val), file: name.file, line: name.line, col: name.col }
            declarations[name.val] = where_
            sites.append(LspRenameSite { source: where_, declaration: where_, rewrite: true })
        }
        if token.kind == "LBRACE" { depth += 1 }
        elif token.kind == "RBRACE" { depth -= 1 }
    }
    let mut translations: dict[str, ModuleNameSite] = {}
    for site in loader.name_sites {
        if site.import_site {
            let target = declarations.get(site.expanded.val) else { continue }
            sites.append(LspRenameSite { source: site.source, declaration: target, rewrite: true })
        } else {
            translations[lsp_token_key(site.expanded)] = site
        }
    }
    for node in program.nodes {
        if node.kind != "callee" or node.target < 0 { continue }
        let name = program.signatures[node.target].name
        let target = declarations.get(name) else { continue }
        let original = node.source
        let fallback = Token { kind: "IDENT", val: target.val, file: original.file, line: original.line, col: original.col }
        let translated = translations.get(lsp_token_key(original)) else {
            ModuleNameSite { source: fallback, expanded: original, import_site: false, rewrite: true }
        }
        sites.append(LspRenameSite { source: translated.source, declaration: target, rewrite: translated.rewrite })
    }
    return sites
}

fn lsp_workspace_files(directory: str) -> list[str] ! str {
    let input = lsp_buf_from_str(directory)
    let output = wysna_host_buffer_new()
    let count = wysna_host_project_entries(input, output)
    wysna_host_close(input)
    let raw = if count >= 0 { lsp_buf_to_str(output, count) } else { "" }
    wysna_host_close(output)
    if count < 0 { return Err("cannot read workspace directory") }
    let mut files: list[str] = []
    let mut i = 0
    while i < len(raw) {
        let kind = raw[i]
        i += 1
        let start = i
        while i < len(raw) and ord(raw[i]) != 0 { i += 1 }
        let name = slice(raw, start, i)
        i += 1
        if name == "" or name[0] == "." or name == "node_modules" or name == "dist" { continue }
        let path = directory + "/" + name
        if kind == "d" {
            for nested in lsp_workspace_files(path)? { files.append(nested) }
        } elif kind == "f" and proj_str_ends_with(name, ".wysna") {
            files.append(path)
        }
    }
    return Ok(files)
}

class LspRenameWorkspace {
    paths: list[str]
    texts: list[str]
    snapshots: list[str]
    versions: list[str]
    candidates: list[int]

    fn init() {
        let strings: list[str] = []
        let integers: list[int] = []
        this.paths = strings
        this.texts = strings
        this.snapshots = strings
        this.versions = strings
        this.candidates = integers
    }
}

fn lsp_stage_rename_workspace(state: LspServerState, workspace: LspRenameWorkspace, files: list[str], root: str, spelling: str) -> bool {
    for doc in state.docs {
        workspace.paths.append(doc.path)
        workspace.texts.append(doc.text)
        workspace.versions.append(str(doc.version))
    }
    for file in files {
        if tool_str_contains(workspace.paths, file) { continue }
        let source = read_file(file) else error { return false }
        if proj_str_contains_substr(source, spelling) {
            workspace.paths.append(file)
            workspace.texts.append(source)
            workspace.versions.append("null")
        }
    }
    for i in 0..len(workspace.paths) {
        let snapshot = lsp_next_tmp_path(state, "wysna_lsp_rename", ".wysna")
        workspace.snapshots.append(snapshot)
        write_file(snapshot, workspace.texts[i]) else error { return false }
        if module_is_confined_under(workspace.paths[i], root) and proj_str_contains_substr(workspace.texts[i], spelling) {
            workspace.candidates.append(i)
        }
    }
    return true
}

fn lsp_rename_token_at(doc: LspDocument, site: Token, offset: int) -> bool {
    if site.file != doc.path { return false }
    let start = diag_char_offset_at(doc.text, site.line, site.col)
    return start >= 0 and start <= offset and offset <= start + len(site.val)
}

fn lsp_snapshot_is_valid(state: LspServerState, workspace: LspRenameWorkspace, index: int) -> bool {
    let raw = lsp_check_snapshot(state, workspace.paths[index], workspace.paths, workspace.snapshots)
    return lsp_json_str(lsp_parse_json(raw), "status", "") == "ok"
}

fn lsp_workspace_rename_edits(state: LspServerState, workspace: LspRenameWorkspace, declaration: Token, new_name: str) -> str {
    let mut changes: list[str] = []
    let mut updated = workspace.texts
    for index in workspace.candidates {
        if not lsp_snapshot_is_valid(state, workspace, index) { return "null" }
        let file = workspace.paths[index]
        let text = workspace.texts[index]
        let loader = lsp_load_source(text, file, workspace.paths, workspace.texts)
        let sites = lsp_collect_function_sites(loader, check_program(loader.output, file, true))
        let mut edits: list[str] = []
        let mut patches: list[FixEdit] = []
        let mut seen: list[int] = []
        for site in sites {
            if not site.rewrite or site.source.file != file or not lsp_same_token(site.declaration, declaration) { continue }
            let start = diag_char_offset_at(text, site.source.line, site.source.col)
            let end = start + len(site.source.val)
            if start < 0 or end > len(text) or slice(text, start, end) != site.source.val { return "null" }
            if start in seen { continue }
            seen.append(start)
            edits.append(lsp_edit_json(text, start, end, new_name))
            patches.append(FixEdit("", "", "", diag_utf8_byte_at(text, start), diag_utf8_byte_at(text, end), new_name))
        }
        if len(edits) == 0 { continue }
        for token in tokenize(text, file) {
            if token.kind == "IDENT" and token.val == new_name { return "null" }
        }
        changes.append(lsp_text_document_edit(lsp_path_to_uri(file), workspace.versions[index], edits))
        updated[index] = fix_apply_non_overlapping(text, patches)
    }
    if len(changes) == 0 { return "null" }
    for index in workspace.candidates {
        if updated[index] != workspace.texts[index] {
            write_file(workspace.snapshots[index], updated[index]) else error { return "null" }
        }
    }
    for index in workspace.candidates {
        if not lsp_snapshot_is_valid(state, workspace, index) { return "null" }
    }
    return "{\"documentChanges\":[" + join_strings(changes, ",") + "]}"
}

fn lsp_handle_rename(state: LspServerState, doc: LspDocument, pos: LspJson, new_name: str) -> str {
    if not doc.clean_ok or new_name == "" or not (is_alpha(ord(new_name[0])) or new_name[0] == "_") or
       new_name == "main" or new_name == "_" or sem_builtin(new_name) { return "null" }
    if (len(new_name) >= 8 and slice(new_name, 0, 8) == "__wysna_") or
       (len(new_name) >= 7 and slice(new_name, 0, 7) == "_WYSNA_") { return "null" }
    for i in 0..len(new_name) { if not is_alnum(ord(new_name[i])) { return "null" } }
    if tokenize(new_name, doc.path)[0].kind != "IDENT" { return "null" }
    let offset = lsp_utf16_offset(doc.text, lsp_json_int(pos, "line", 0), lsp_json_int(pos, "character", 0))
    for site in doc.function_sites {
        if not lsp_rename_token_at(doc, site.source, offset) { continue }
        let declaration = site.declaration
        if declaration.val == "main" or declaration.val == new_name { return "null" }
        let mut root = ""
        for candidate in state.workspace_roots {
            if len(candidate) > len(root) and module_is_confined_under(doc.path, candidate) and
               module_is_confined_under(declaration.file, candidate) { root = candidate }
        }
        if root == "" { return "null" }
        let files = lsp_workspace_files(root) else error { return "null" }
        if not tool_str_contains(files, declaration.file) { return "null" }
        let workspace = LspRenameWorkspace()
        let staged = lsp_stage_rename_workspace(state, workspace, files, root, declaration.val)
        let result = if staged { lsp_workspace_rename_edits(state, workspace, declaration, new_name) } else { "null" }
        for snapshot in workspace.snapshots { lsp_remove_file(snapshot) }
        return result
    }
    return "null"
}

fn lsp_dispatch_message(state: LspServerState, msg: LspJson) -> bool {
    let method = lsp_json_str(msg, "method", "")
    let params = lsp_json_get(msg, "params")
    let has_id = lsp_json_has(msg, "id")
    let req_id_raw = if has_id { lsp_json_raw_literal(lsp_json_get(msg, "id")) } else { "null" }

    if method == "initialize" {
        let mut roots: list[str] = []
        for folder in lsp_json_get(params, "workspaceFolders").items {
            let path = lsp_uri_to_path(lsp_json_str(folder, "uri", ""))
            if path != "" { roots.append(module_canonical(path)) }
        }
        if len(roots) == 0 {
            let path = lsp_uri_to_path(lsp_json_str(params, "rootUri", ""))
            if path != "" { roots.append(module_canonical(path)) }
        }
        state.workspace_roots = roots
        let legend = "\"tokenTypes\":[\"keyword\",\"type\",\"class\",\"interface\",\"enum\",\"struct\",\"function\",\"method\",\"property\",\"variable\",\"parameter\",\"string\",\"number\",\"operator\",\"comment\"],\"tokenModifiers\":[]"
        let caps = "\"positionEncoding\":\"utf-16\",\"textDocumentSync\":{\"openClose\":true,\"change\":2},\"definitionProvider\":true,\"implementationProvider\":true,\"hoverProvider\":true,\"referencesProvider\":true,\"documentFormattingProvider\":true,\"completionProvider\":{\"triggerCharacters\":[\".\"]},\"codeActionProvider\":{\"codeActionKinds\":[\"quickfix\"]},\"renameProvider\":true,\"signatureHelpProvider\":{\"triggerCharacters\":[\"(\",\",\"]},\"semanticTokensProvider\":{\"legend\":{" + legend + "},\"full\":true,\"range\":false}"
        let res = "{\"capabilities\":{" + caps + ("},\"serverInfo\":{\"name\":\"wysna-native\",\"version\":\"" + tool_compiler_version() + "\"}}")
        if has_id { lsp_send_message("{\"jsonrpc\":\"2.0\",\"id\":" + req_id_raw + ",\"result\":" + res + "}") }
        return true
    }
    if method == "initialized" { return true }
    if method == "shutdown" {
        state.stopping = true
        if has_id { lsp_send_message("{\"jsonrpc\":\"2.0\",\"id\":" + req_id_raw + ",\"result\":null}") }
        return true
    }
    if method == "exit" { return false }
    if state.stopping {
        if has_id { lsp_send_message("{\"jsonrpc\":\"2.0\",\"id\":" + req_id_raw + ",\"error\":{\"code\":-32600,\"message\":\"Server is shutting down\"}}") }
        return true
    }

    if method == "textDocument/didOpen" {
        let td = lsp_json_get(params, "textDocument")
        let uri = lsp_json_str(td, "uri", "")
        let text = lsp_json_str(td, "text", "")
        let version = lsp_json_int(td, "version", 0)
        let path = lsp_uri_to_path(uri)
        let existing = lsp_find_doc_idx(state, uri)
        if existing >= 0 {
            state.docs[existing].text = text
            state.docs[existing].version = version
            lsp_check_and_publish(state, existing)
        } else {
            let tmp_p = lsp_next_tmp_path(state, "wysna_lsp_doc", ".wysna")
            let doc = LspDocument(uri, path, version, text, tmp_p)
            state.docs.append(doc)
            lsp_check_and_publish(state, len(state.docs) - 1)
        }
        lsp_recheck_dependents(state, uri)
        return true
    }
    if method == "textDocument/didChange" {
        let td = lsp_json_get(params, "textDocument")
        let uri = lsp_json_str(td, "uri", "")
        let version = lsp_json_int(td, "version", 0)
        let idx = lsp_find_doc_idx(state, uri)
        if idx >= 0 and version >= state.docs[idx].version {
            state.docs[idx].version = version
            state.docs[idx].text = lsp_apply_content_changes(state.docs[idx].text, lsp_json_get(params, "contentChanges"))
            lsp_check_and_publish(state, idx)
            lsp_recheck_dependents(state, uri)
        }
        return true
    }
    if method == "textDocument/didClose" {
        let td = lsp_json_get(params, "textDocument")
        let uri = lsp_json_str(td, "uri", "")
        let idx = lsp_find_doc_idx(state, uri)
        if idx >= 0 {
            lsp_remove_file(state.docs[idx].tmp_path)
            let mut next_docs: list[LspDocument] = []
            for j in 0..len(state.docs) {
                if j != idx { next_docs.append(state.docs[j]) }
            }
            state.docs = next_docs
        }
        lsp_publish_empty_diags(uri)
        lsp_recheck_dependents(state, uri)
        return true
    }

    let td_req = lsp_json_get(params, "textDocument")
    let req_uri = lsp_json_str(td_req, "uri", "")
    let req_pos = lsp_json_get(params, "position")
    let idx = lsp_find_doc_idx(state, req_uri)
    let mut result_json = "null"
    let mut handled = true

    if method == "textDocument/definition" {
        result_json = if idx >= 0 { lsp_handle_definition(state, state.docs[idx], req_pos) } else { "null" }
    } elif method == "textDocument/implementation" {
        result_json = if idx >= 0 { lsp_handle_implementation(state, state.docs[idx], req_pos) } else { "[]" }
    } elif method == "textDocument/hover" {
        result_json = if idx >= 0 { lsp_handle_hover(state.docs[idx], req_pos) } else { "null" }
    } elif method == "textDocument/references" {
        let ctx = lsp_json_get(params, "context")
        let inc_decl = lsp_json_bool(ctx, "includeDeclaration", true)
        result_json = if idx >= 0 { lsp_handle_references(state, state.docs[idx], req_pos, inc_decl) } else { "[]" }
    } elif method == "textDocument/completion" {
        result_json = if idx >= 0 { lsp_handle_completion(state.docs[idx], req_pos) } else { "[]" }
    } elif method == "textDocument/codeAction" {
        result_json = if idx >= 0 { lsp_handle_code_actions(state.docs[idx], params) } else { "[]" }
    } elif method == "textDocument/signatureHelp" {
        result_json = if idx >= 0 { lsp_handle_signature_help(state.docs[idx], req_pos) } else { "null" }
    } elif method == "textDocument/rename" {
        result_json = if idx >= 0 { lsp_handle_rename(state, state.docs[idx], req_pos, lsp_json_str(params, "newName", "")) } else { "null" }
    } elif method == "textDocument/formatting" {
        result_json = if idx >= 0 { lsp_handle_formatting(state.docs[idx]) } else { "[]" }
    } elif method == "textDocument/semanticTokens/full" {
        result_json = if idx >= 0 { lsp_handle_semantic_tokens(state.docs[idx]) } else { "{\"data\":[]}" }
    } else {
        handled = false
    }

    if not handled {
        if has_id { lsp_send_message("{\"jsonrpc\":\"2.0\",\"id\":" + req_id_raw + ",\"error\":{\"code\":-32601,\"message\":\"Method not found\"}}") }
        return true
    }
    if has_id { lsp_send_message("{\"jsonrpc\":\"2.0\",\"id\":" + req_id_raw + ",\"result\":" + result_json + "}") }
    return true
}

fn lsp_serve() -> unit {
    let tmp_dir = lsp_create_workspace()
    if tmp_dir == "" {
        lsp_send_message("{\"jsonrpc\":\"2.0\",\"method\":\"window/logMessage\",\"params\":{\"type\":1,\"message\":\"Could not create LSP workspace\"}}")
        exit(2)
    }
    let state = LspServerState(tmp_dir)
    while not state.eof_reached {
        let payload = lsp_read_frame_clean(state)
        if state.eof_reached { break }
        if payload == "" { continue }
        let msg = lsp_parse_json(payload)
        if not lsp_dispatch_message(state, msg) { break }
    }
    lsp_cleanup(state)
}
