struct Token {
    kind: str,
    val: str,
    line: int,
    col: int,
    file: str,
}

# Standalone semantic parsing. Types are interned structures, never fixture names.
struct SemType { kind: str, name: str, args: list[int] }
struct SemGenericType { name: str, kind: str, params: list[str], constraints: list[str] }
struct SemVar { name: str, type_id: int, mutable: bool, depth: int, binding: int, source: Token }
struct AttributeArgument { name: str, kind: str, value: str }
struct StaticAttribute { name: str, message: str, arguments: list[AttributeArgument], source: Token, schema_file: str, schema_name: str }
struct SemFunction { source: Token, declaration_name: str, attributes: list[StaticAttribute], abi_params: list[str], abi_return: str, name: str, params: list[str], type_params: list[str], constraints: list[str], type_id: int, body: int, end: int, owner: str, visible: bool, contract_start: int, is_async: bool }
struct SemField { source: Token, owner: str, name: str, type_id: int, visible: bool, requires: list[Token] }
struct SemInterfaceRef { name: str, args: list[int] }
struct SemClass { name: str, parent: str, parent_args: list[int], interfaces: list[SemInterfaceRef] }
struct SemValue { type_id: int, root: str, writable: int, terminates: bool, node: int }
struct SemFlow { type_id: int, terminates: bool, node: int }


struct SemPattern { name: str, children: list[int], type_id: int, binding: int, source: Token }
struct SemConstructor { name: str, payloads: list[int] }

struct SemObligation { function: str, kind: str, types: list[int], source: Token }
struct SemSpecialization { template: int, arguments: list[int], function: int, ancestry: list[int] }

# Each inference operation owns its substitutions, including nested initializers.
class SemUnification { names: list[str], types: list[int] }
