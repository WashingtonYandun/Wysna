# An import graph belongs to one source expansion.
class ModuleLoader {
    paths: list[str]
    states: list[int]
    public_names: list[list[str]]
    all_names: list[list[str]]
    import_owners: list[int]
    import_aliases: list[str]
    import_targets: list[int]
    import_public: list[bool]
    output: list[Token]
    fn init() {
        let initial_paths: list[str] = []
        this.paths = initial_paths
        let initial_states: list[int] = []
        this.states = initial_states
        let initial_public_names: list[list[str]] = []
        this.public_names = initial_public_names
        let initial_all_names: list[list[str]] = []
        this.all_names = initial_all_names
        let initial_import_owners: list[int] = []
        this.import_owners = initial_import_owners
        let initial_import_aliases: list[str] = []
        this.import_aliases = initial_import_aliases
        let initial_import_targets: list[int] = []
        this.import_targets = initial_import_targets
        let initial_import_public: list[bool] = []
        this.import_public = initial_import_public
        let initial_output: list[Token] = []
        this.output = initial_output
    }
}
# Module expansion shares one token stream with the standalone semantic checker.

fn module_normalize(path: str) -> str {
    let mut parts: list[str] = []
    let mut part = ""
    for i in 0..len(path) + 1 {
        let mut ch = "/"
        if i < len(path) { ch = path[i] }
        if ch == "\\" { ch = "/" }
        if ch == "/" {
            if part == ".." and len(parts) > 0 { parts.pop() }
            elif part != "" and part != "." { parts.append(part) }
            part = ""
        } else { part = part + ch }
    }
    let mut result = ""
    if len(path) > 0 and path[0] == "/" { result = "/" }
    for i in 0..len(parts) {
        if i > 0 { result = result + "/" }
        result = result + parts[i]
    }
    return result
}
fn module_directory(path: str) -> str {
    let mut boundary = -1
    for i in 0..len(path) { if path[i] == "/" { boundary = i } }
    if boundary < 0 { return "" }
    return slice(path, 0, boundary + 1)
}
fn module_name(index: int, name: str) -> str { return "__wysna_module_" + str(index) + "__" + name }
fn module_contains(names: list[str], name: str) -> bool {
    for candidate in names { if candidate == name { return true } }
    return false
}
fn module_stdlib_path(requested: str) -> str {
    let relative = "stdlib/" + slice(requested, 4, len(requested)) + ".wysna"
    let local = read_file(relative) else error { "" }
    if local != "" { return relative }
    let arguments = args()
    let mut directory = module_directory(module_normalize(arguments[0]))
    while directory != "" {
        let candidate = module_normalize(directory + relative)
        let content = read_file(candidate) else error { "" }
        if content != "" { return candidate }
        let parent = module_directory(slice(directory, 0, len(directory) - 1))
        if parent == directory { break }
        directory = parent
    }
    return relative
}
fn module_expand(context: ModuleLoader, src: str, path: str, entry: bool) -> int {
    let canonical = module_normalize(path)

    for i in 0..len(context.paths) {
        if context.paths[i] == canonical {
            if context.states[i] == 1 { report_error(canonical, "W1003", 1, 1, "circular import: " + canonical) }
            return i
        }
    }
    let index = len(context.paths)
    context.paths.append(canonical)
    context.states.append(1)
    let mut names: list[str] = []
    let mut exports: list[str] = []
    let tokens = tokenize(src, canonical)
    for token in tokens {
        if token.kind == "IDENT" {
            if (len(token.val) >= 8 and slice(token.val, 0, 8) == "__wysna_") or (len(token.val) >= 7 and slice(token.val, 0, 7) == "_WYSNA_") { report_error_at("W1002", token, "reserved compiler namespace") }
        }
    }
    let mut depth = 0
    let mut exported = false
    for i in 0..len(tokens) - 1 {
        let kind = tokens[i].kind
        if depth == 0 {
            if kind == "PUB" { exported = true }
            elif kind == "FN" or kind == "STRUCT" or kind == "ENUM" or kind == "CLASS" or kind == "INTERFACE" or kind == "LET" {
                let mut offset = 1
                if kind == "LET" and tokens[i + 1].kind == "MUT" { offset = 2 }
                let name = tokens[i + offset].val
                names.append(name)
                if exported { exports.append(name) }
                exported = false
            }
        }
        if kind == "LBRACE" { depth = depth + 1 }
        if kind == "RBRACE" { depth = depth - 1 }
    }
    context.all_names.append(names)
    context.public_names.append(exports)
    let mut aliases: list[str] = []
    let mut dependencies: list[int] = []
    let mut body: list[Token] = []
    let mut position = 0
    while position < len(tokens) - 1 {
        let token = tokens[position]

        if token.kind == "IMPORT" {
            let public_import = position > 0 and tokens[position - 1].kind == "PUB"
            if public_import and len(body) > 0 and body[len(body) - 1].kind == "PUB" { body.pop() }
            let requested = tokens[position + 1].val
            let mut resolved = module_normalize(module_directory(canonical) + requested)
            if len(requested) >= 4 and slice(requested, 0, 4) == "std/" { resolved = module_stdlib_path(requested) }
            let mut content = read_file(resolved) else err { "" }
            if content == "" {
                resolved = module_normalize(requested)
                content = read_file(resolved) else err { report_error_at("W1003", token, "module not found: " + requested) "" }
            }
            let dependency = module_expand(context, content, resolved, false)
            let mut alias = extract_module_ns(requested)
            position = position + 2
            if tokens[position].kind == "AS" { alias = tokens[position + 1].val position = position + 2 }
            if module_contains(aliases, alias) or module_contains(names, alias) { report_error_at("W1002", token, "duplicate module alias") }
            aliases.append(alias)
            dependencies.append(dependency)
            context.import_owners.append(index)
            context.import_aliases.append(alias)
            context.import_targets.append(dependency)
            context.import_public.append(public_import)
            if public_import { context.public_names[index].append(alias) }
        } else {
            body.append(token)
            position = position + 1
        }
    }
    position = 0
    let mut braces = 0
    let mut parentheses = 0
    while position < len(body) {
        let token = body[position]

        let mut consumed = false
        if token.kind == "IDENT" {
            for i in 0..len(aliases) {
                if token.val == aliases[i] and position + 2 < len(body) and body[position + 1].kind == "DOT" {
                    let member = body[position + 2]
                    let dependency = dependencies[i]
                    let mut nested_target = -1
                    for import_index in 0..len(context.import_owners) {
                        if context.import_owners[import_index] == dependency and context.import_aliases[import_index] == member.val and context.import_public[import_index] { nested_target = context.import_targets[import_index] }
                    }
                    if nested_target >= 0 and position + 4 < len(body) and body[position + 3].kind == "DOT" {
                        let nested_member = body[position + 4]
                        if not module_contains(context.public_names[nested_target], nested_member.val) { report_error_at("W1001", nested_member, "member is not exported: " + nested_member.val) }
                        context.output.append(Token { kind: "IDENT", val: module_name(nested_target, nested_member.val), line: token.line, col: token.col, file: token.file })
                        position = position + 5
                    } else {
                        if not module_contains(context.public_names[dependency], member.val) { report_error_at("W1001", member, "member is not exported: " + member.val) }
                        context.output.append(Token { kind: "IDENT", val: module_name(dependency, member.val), line: token.line, col: token.col, file: token.file })
                        position = position + 3
                    }
                    consumed = true
                }
            }
            if not consumed and not entry and module_contains(names, token.val) {
                let mut field = false
                if position > 0 and body[position - 1].kind == "DOT" { field = true }
                if position + 1 < len(body) and body[position + 1].kind == "COLON" and parentheses == 0 {
                    field = true
                    if position > 0 and (body[position - 1].kind == "LET" or body[position - 1].kind == "MUT") { field = false }
                }
                if braces > 0 and position > 0 and body[position - 1].kind == "FN" { field = true }
                if not field { context.output.append(Token { kind: token.kind, val: module_name(index, token.val), line: token.line, col: token.col, file: token.file }) consumed = true position = position + 1 }
            }
        }
        if not consumed { context.output.append(token) position = position + 1 }
        if token.kind == "LBRACE" { braces = braces + 1 }
        if token.kind == "RBRACE" { braces = braces - 1 }
        if token.kind == "LPAREN" { parentheses = parentheses + 1 }
        if token.kind == "RPAREN" { parentheses = parentheses - 1 }
    }
    context.states[index] = 2
    return index
}
fn module_tokens(src: str, path: str) -> list[Token] {
    let context = new ModuleLoader()
    module_expand(context, src, path, true)
    context.output.append(Token { kind: "EOF", val: "", line: 1, col: 1, file: module_normalize(path) })
    return context.output
}
