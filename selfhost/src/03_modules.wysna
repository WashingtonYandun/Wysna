# Path canonicalization helpers live in 01_paths.wysna.

fn module_read_with_overlays(path: str, ov_paths: list[str], ov_texts: list[str]) -> list[str] {
    let canon = module_canonical(path)
    for i in 0..len(ov_paths) {
        if ov_paths[i] == canon or ov_paths[i] == path {
            return ["1", ov_texts[i]]
        }
    }
    let raw = args()
    let mut idx = 1
    while idx < len(raw) {
        if raw[idx] == "--overlay" and idx + 2 < len(raw) {
            let target = raw[idx + 1]
            let ov_canon = module_canonical(target)
            if target == path or ov_canon == canon {
                let ov_src = read_file(raw[idx + 2]) else error { "" }
                return ["1", ov_src]
            }
            idx = idx + 3
        } else {
            idx = idx + 1
        }
    }
    let disk = read_file(path) else error { return ["0", ""] }
    return ["1", disk]
}

fn module_read_text_or_overlay(path: str) -> list[str] {
    return module_read_with_overlays(path, [], [])
}

# An import graph belongs to one source expansion.
struct ModuleNameSite { source: Token, expanded: Token, import_site: bool, rewrite: bool }

class ModuleLoader {
    trace_names: bool
    name_sites: list[ModuleNameSite]
    paths: list[str]
    states: list[int]
    public_names: list[list[str]]
    all_names: list[list[str]]
    import_owners: list[int]
    import_aliases: list[str]
    import_targets: list[int]
    import_public: list[bool]
    output: list[Token]
    ov_paths: list[str]
    ov_texts: list[str]
    project_sources_root: str
    dep_aliases: list[str]
    dep_roots: list[str]
    fn init() {
        this.trace_names = false
        let initial_sites: list[ModuleNameSite] = []
        this.name_sites = initial_sites
        let initial_paths: list[str] = []
        this.paths = initial_paths
        let initial_states: list[int] = []
        this.states = initial_states
        let initial_public_names: list[list[str]] = []
        this.public_names = initial_public_names
        let initial_all_names: list[list[str]] = []
        this.all_names = initial_all_names
        let initial_import_owners: list[int] = []
        this.import_owners = initial_import_owners
        let initial_import_aliases: list[str] = []
        this.import_aliases = initial_import_aliases
        let initial_import_targets: list[int] = []
        this.import_targets = initial_import_targets
        let initial_import_public: list[bool] = []
        this.import_public = initial_import_public
        let initial_output: list[Token] = []
        this.output = initial_output
        let initial_ov_paths: list[str] = []
        this.ov_paths = initial_ov_paths
        let initial_ov_texts: list[str] = []
        this.ov_texts = initial_ov_texts
        this.project_sources_root = ""
        let initial_dep_aliases: list[str] = []
        this.dep_aliases = initial_dep_aliases
        let initial_dep_roots: list[str] = []
        this.dep_roots = initial_dep_roots
    }
}

fn module_loader_file_readable(context: ModuleLoader, path: str) -> bool {
    let res = module_read_with_overlays(path, context.ov_paths, context.ov_texts)
    return res[0] == "1"
}
# Module expansion shares one token stream with the standalone semantic checker.

fn module_name(index: int, name: str) -> str { return "__wysna_module_" + str(index) + "__" + name }
fn module_contains(names: list[str], name: str) -> bool {
    for candidate in names { if candidate == name { return true } }
    return false
}
# Standard modules are names under one root, never relative filesystem paths.
fn module_stdlib_name_safe(requested: str) -> bool {
    let mut segment = ""
    for index in 4..len(requested) {
        let ch = requested[index]
        if ch == "\\" { return false }
        if ch == "/" {
            if segment == "" or segment == "." or segment == ".." { return false }
            segment = ""
        } else { segment = segment + ch }
    }
    return segment != "" and segment != "." and segment != ".."
}

# Resolve both paths physically so a symlink in the library cannot escape its root.
fn module_stdlib_confined(requested: str, resolved: str) -> bool {
    let relative = slice(requested, 4, len(requested)) + ".wysna"
    if len(resolved) <= len(relative) { return false }
    let root = slice(resolved, 0, len(resolved) - len(relative))
    let canonical_root = module_canonical_resolved(root)
    let canonical_file = module_canonical_resolved(resolved)
    if canonical_root == "" or canonical_file == "" { return false }
    let prefix = if canonical_root == "/" { "/" } else { canonical_root + "/" }
    return len(canonical_file) > len(prefix) and slice(canonical_file, 0, len(prefix)) == prefix
}

fn module_file_readable(path: str) -> bool {
    let res = module_read_text_or_overlay(path)
    return res[0] == "1"
}

fn module_stdlib_path(requested: str) -> str {
    let relative = "stdlib/" + slice(requested, 4, len(requested)) + ".wysna"
    let arguments = args()
    if len(arguments) > 2 and arguments[1] == "--stdlib-root" {
        return module_normalize(arguments[2] + "/" + slice(requested, 4, len(requested)) + ".wysna")
    }
    let mut directory = module_directory(module_normalize(arguments[0]))
    while directory != "" {
        let candidate = module_normalize(directory + relative)
        if module_file_readable(candidate) { return candidate }
        let parent = module_directory(slice(directory, 0, len(directory) - 1))
        if parent == directory { break }
        directory = parent
    }
    return relative
}
fn module_project_sources_root() -> str {
    let arguments = args()
    let mut i = 1
    while i < len(arguments) {
        if arguments[i] == "--project-sources-root" and i + 1 < len(arguments) { return arguments[i + 1] }
        i = i + 1
    }
    return ""
}

fn module_project_dep_root(alias: str) -> str {
    let arguments = args()
    let mut i = 1
    while i < len(arguments) {
        if arguments[i] == "--project-dep" and i + 2 < len(arguments) and arguments[i + 1] == alias {
            return arguments[i + 2]
        }
        i = i + 1
    }
    return ""
}

fn module_safe_pkg_rel(path: str) -> bool {
    if path == "" or path[0] == "/" { return false }
    let mut segment = ""
    for index in 0..len(path) {
        let ch = path[index]
        if ch == "\\" or ch == ":" { return false }
        if ch == "/" {
            if segment == "" or segment == "." or segment == ".." { return false }
            segment = ""
        } else { segment = segment + ch }
    }
    return segment != "" and segment != "." and segment != ".."
}

fn module_resolve_dep_root(context: ModuleLoader, alias: str) -> str {
    for k in 0..len(context.dep_aliases) {
        if context.dep_aliases[k] == alias { return context.dep_roots[k] }
    }
    return module_project_dep_root(alias)
}

fn module_resolve_proj_src_root(context: ModuleLoader) -> str {
    if context.project_sources_root != "" { return context.project_sources_root }
    return module_project_sources_root()
}

fn module_is_confined_under(candidate: str, root: str) -> bool {
    let can_root = module_canonical_resolved(root)
    let can_file = module_canonical_resolved(candidate)
    if can_root == "" or can_file == "" { return false }
    let prefix = if can_root == "/" { "/" } else { can_root + "/" }
    return len(can_file) > len(prefix) and slice(can_file, 0, len(prefix)) == prefix
}

struct UseHeader {
    found: bool,
    use_pos: int,
    requested: str,
}

fn module_strip_wysna_ext(path: str) -> str {
    let n = len(path)
    if n >= 6 and slice(path, n - 6, n) == ".wysna" {
        return slice(path, 0, n - 6)
    }
    return path
}

fn module_parse_from_header(tokens: list[Token], pos_in: int) -> UseHeader {
    let n = len(tokens)
    if pos_in >= n or tokens[pos_in].kind != "IDENT" or tokens[pos_in].val != "from" {
        return UseHeader { found: false, use_pos: pos_in, requested: "" }
    }
    let mut cur = pos_in + 1
    let mut requested = ""
    if cur < n and tokens[cur].kind == "STR" {
        requested = tokens[cur].val
        cur = cur + 1
    } else {
        let mut prefix = ""
        if cur < n and tokens[cur].kind == "DOT" {
            prefix = "./"
            cur = cur + 1
        } elif cur < n and tokens[cur].kind == "DOT_DOT" {
            prefix = "../"
            cur = cur + 1
        }
        if cur >= n or tokens[cur].kind != "IDENT" {
            return UseHeader { found: false, use_pos: pos_in, requested: "" }
        }
        let mut segs: list[str] = [tokens[cur].val]
        cur = cur + 1
        while cur + 1 < n and tokens[cur].kind == "DOT" and tokens[cur + 1].kind == "IDENT" {
            segs.append(tokens[cur + 1].val)
            cur = cur + 2
        }
        requested = prefix + join_strings(segs, "/")
    }
    if cur < n and tokens[cur].kind == "IDENT" and tokens[cur].val == "use" {
        return UseHeader { found: true, use_pos: cur, requested: requested }
    }
    return UseHeader { found: false, use_pos: pos_in, requested: "" }
}

fn module_try_resolve_source(context: ModuleLoader, canonical: str, requested: str, token: Token) -> str {
    let mut resolved = module_normalize(module_directory(canonical) + requested)
    let standard = len(requested) >= 4 and slice(requested, 0, 4) == "std/"
    if standard {
        if not module_stdlib_name_safe(requested) { report_error_at("W1003", token, "invalid standard module: " + requested) }
        resolved = module_stdlib_path(requested)
        if not module_loader_file_readable(context, resolved) { return "" }
        if not module_stdlib_confined(requested, resolved) { report_error_at("W1003", token, "cannot resolve standard module within its root: " + requested) }
        return resolved
    } elif len(requested) >= 4 and slice(requested, 0, 4) == "pkg/" {
        let rest = slice(requested, 4, len(requested))
        let mut slash = -1
        for k in 0..len(rest) {
            if rest[k] == "/" { slash = k break }
        }
        if slash <= 0 or slash + 1 >= len(rest) { report_error_at("W1003", token, "invalid package import: " + requested) }
        let dep_alias = slice(rest, 0, slash)
        let dep_mod = slice(rest, slash + 1, len(rest))
        if not module_safe_pkg_rel(dep_mod) { report_error_at("W1003", token, "invalid package import path: " + requested) }
        let dep_root = module_resolve_dep_root(context, dep_alias)
        if dep_root == "" { report_error_at("W1003", token, "unknown project dependency: " + dep_alias) }
        let need_ext = len(dep_mod) < 6 or slice(dep_mod, len(dep_mod) - 6, len(dep_mod)) != ".wysna"
        let cand = module_normalize(dep_root + "/" + (if need_ext { dep_mod + ".wysna" } else { dep_mod }))
        if not module_loader_file_readable(context, cand) { return "" }
        if not module_is_confined_under(cand, dep_root) {
            report_error_at("W1003", token, "module not found: " + requested)
        }
        return cand
    } else {
        let need_ext = len(requested) < 6 or slice(requested, len(requested) - 6, len(requested)) != ".wysna"
        let proj_src = module_resolve_proj_src_root(context)
        if proj_src != "" {
            let is_rel_dot = (len(requested) >= 2 and slice(requested, 0, 2) == "./") or (len(requested) >= 3 and slice(requested, 0, 3) == "../")
            if not is_rel_dot and not module_safe_pkg_rel(requested) {
                report_error_at("W1003", token, "invalid project import path: " + requested)
            }
            let mut owner = proj_src
            for dep_root in context.dep_roots {
                if module_is_confined_under(canonical, dep_root) {
                    owner = dep_root
                    break
                }
            }
            let base = if is_rel_dot or module_is_confined_under(canonical, owner) { module_directory(canonical) } else { owner + "/" }
            let relative = if need_ext { requested + ".wysna" } else { requested }
            resolved = module_normalize(base + relative)
            if not module_is_confined_under(resolved, owner) {
                report_error_at("W1003", token, "module not found inside project source root: " + requested)
            }
            return if module_loader_file_readable(context, resolved) { resolved } else { "" }
        } else {
            let rel_ext = if need_ext { module_normalize(module_directory(canonical) + requested + ".wysna") } else { "" }
            let cwd_ext = if need_ext { module_normalize(requested + ".wysna") } else { "" }
            if module_loader_file_readable(context, resolved) {
                return resolved
            } elif rel_ext != "" and module_loader_file_readable(context, rel_ext) {
                return rel_ext
            } elif module_loader_file_readable(context, module_normalize(requested)) {
                return module_normalize(requested)
            } elif cwd_ext != "" and module_loader_file_readable(context, cwd_ext) {
                return cwd_ext
            }
        }
    }
    return ""
}

fn module_load_from_resolved(context: ModuleLoader, resolved: str, requested: str, token: Token) -> int {
    let loaded = module_read_with_overlays(resolved, context.ov_paths, context.ov_texts)
    if loaded[0] != "1" {
        report_error_at("W1003", token, "module not found: " + requested)
    }
    return module_expand(context, loaded[1], resolved, false)
}

fn module_load_source(context: ModuleLoader, canonical: str, requested: str, token: Token) -> int {
    let resolved = module_try_resolve_source(context, canonical, requested, token)
    if resolved == "" {
        report_error_at("W1003", token, "module not found: " + requested)
    }
    return module_load_from_resolved(context, resolved, requested, token)
}

fn module_format_exports_hint(context: ModuleLoader, dep: int) -> str {
    let exps = context.public_names[dep]
    if len(exps) == 0 { return "" }
    return " (Available exports: " + join_strings(exps, ", ") + ")"
}

fn module_expand(context: ModuleLoader, src: str, path: str, entry: bool) -> int {
    let canonical = module_canonical(path)

    for i in 0..len(context.paths) {
        if context.paths[i] == canonical {
            if context.states[i] == 1 { report_error(canonical, "W1003", 1, 1, "circular import: " + canonical) }
            return i
        }
    }
    let index = len(context.paths)
    context.paths.append(canonical)
    context.states.append(1)
    let mut names: list[str] = []
    let mut exports: list[str] = []
    let tokens = tokenize(src, canonical)
    for token in tokens {
        if token.kind == "IDENT" {
            if (len(token.val) >= 8 and slice(token.val, 0, 8) == "__wysna_") or (len(token.val) >= 7 and slice(token.val, 0, 7) == "_WYSNA_") { report_error_at("W1002", token, "reserved compiler namespace") }
        }
    }
    let mut depth = 0
    let mut exported = false
    for i in 0..len(tokens) - 1 {
        let kind = tokens[i].kind
        if depth == 0 {
            if kind == "PUB" { exported = true }
            elif kind == "FN" or kind == "STRUCT" or kind == "ENUM" or kind == "CLASS" or kind == "INTERFACE" or kind == "LET" {
                let mut offset = 1
                if kind == "LET" and tokens[i + 1].kind == "MUT" { offset = 2 }
                if kind == "LET" and tokens[i + offset].kind == "LPAREN" {
                    let mut pd = 0
                    let mut p = i + offset
                    while p < len(tokens) - 1 {
                        if tokens[p].kind == "LPAREN" { pd = pd + 1 }
                        elif tokens[p].kind == "RPAREN" {
                            pd = pd - 1
                            if pd <= 0 { break }
                        } elif tokens[p].kind == "IDENT" and tokens[p].val != "_" {
                            names.append(tokens[p].val)
                            if exported { exports.append(tokens[p].val) }
                        }
                        p = p + 1
                    }
                    exported = false
                } else {
                    let name = tokens[i + offset].val
                    names.append(name)
                    if exported { exports.append(name) }
                    exported = false
                }
            }
        }
        if kind == "LBRACE" { depth = depth + 1 }
        if kind == "RBRACE" { depth = depth - 1 }
    }
    context.all_names.append(names)
    context.public_names.append(exports)
    let mut aliases: list[str] = []
    let mut dependencies: list[int] = []
    let mut use_locals: list[str] = []
    let mut use_targets: list[str] = []
    let mut use_aliased: list[bool] = []
    let mut body: list[Token] = []
    let mut position = 0
    let mut top_depth = 0
    while position < len(tokens) - 1 {
        let token = tokens[position]
        let from_hdr = if top_depth == 0 { module_parse_from_header(tokens, position) } else { UseHeader { found: false, use_pos: position, requested: "" } }

        if top_depth == 0 and token.kind == "IMPORT" {
            let public_import = position > 0 and tokens[position - 1].kind == "PUB"
            if public_import and len(body) > 0 and body[len(body) - 1].kind == "PUB" { body.pop() }
            let requested = tokens[position + 1].val
            let dependency = module_load_source(context, canonical, requested, token)
            let mut alias = extract_module_ns(requested)
            position = position + 2
            if tokens[position].kind == "AS" { alias = tokens[position + 1].val position = position + 2 }
            if module_contains(aliases, alias) or module_contains(names, alias) or module_contains(use_locals, alias) { report_error_at("W1002", token, "duplicate module alias") }
            aliases.append(alias)
            dependencies.append(dependency)
            context.import_owners.append(index)
            context.import_aliases.append(alias)
            context.import_targets.append(dependency)
            context.import_public.append(public_import)
            if public_import { context.public_names[index].append(alias) }
        } elif from_hdr.found {
            let public_use = position > 0 and tokens[position - 1].kind == "PUB"
            if public_use and len(body) > 0 and body[len(body) - 1].kind == "PUB" { body.pop() }
            let requested = from_hdr.requested
            let base_req = module_strip_wysna_ext(requested)
            let mut base_resolved = false
            let mut base_dep = -1
            position = from_hdr.use_pos + 1
            let braced = position < len(tokens) - 1 and tokens[position].kind == "LBRACE"
            if braced { position = position + 1 }
            let mut parsed_any = false
            while position < len(tokens) - 1 {
                if braced {
                    while position < len(tokens) - 1 and (tokens[position].kind == "NEWLINE" or tokens[position].kind == "COMMA") { position = position + 1 }
                    if position >= len(tokens) - 1 or tokens[position].kind == "RBRACE" { break }
                } elif parsed_any {
                    break
                }
                if tokens[position].kind != "IDENT" { report_error_at("W0006", tokens[position], "expected imported symbol identifier") }
                let first_tok = tokens[position]
                position = position + 1
                parsed_any = true
                if position + 1 < len(tokens) and tokens[position].kind == "DOT" and tokens[position + 1].kind == "IDENT" {
                    let sym_tok = tokens[position + 1]
                    position = position + 2
                    let mut bound = sym_tok.val
                    let aliased = position + 1 < len(tokens) and tokens[position].kind == "AS"
                    if position + 1 < len(tokens) and tokens[position].kind == "AS" {
                        if tokens[position + 1].kind != "IDENT" { report_error_at("W0006", tokens[position + 1], "expected alias identifier") }
                        bound = tokens[position + 1].val
                        position = position + 2
                    }
                    let sub_req = base_req + "/" + first_tok.val
                    let sub_dep = module_load_source(context, canonical, sub_req, first_tok)
                    if not module_contains(context.public_names[sub_dep], sym_tok.val) {
                        report_error_at("W1003", sym_tok, "member is not exported: " + sym_tok.val + module_format_exports_hint(context, sub_dep))
                    }
                    if module_contains(names, bound) or module_contains(aliases, bound) or module_contains(use_locals, bound) {
                        report_error_at("W1002", sym_tok, "imported symbol conflicts with declaration: " + bound)
                    }
                    use_locals.append(bound)
                    let target = module_name(sub_dep, sym_tok.val)
                    use_targets.append(target)
                    use_aliased.append(aliased)
                    module_trace_name(context, sym_tok, sym_tok, target, true, true)
                    if public_use { context.public_names[index].append(bound) }
                } else {
                    let sym_tok = first_tok
                    let mut bound = sym_tok.val
                    let aliased = position + 1 < len(tokens) and tokens[position].kind == "AS"
                    if position + 1 < len(tokens) and tokens[position].kind == "AS" {
                        if tokens[position + 1].kind != "IDENT" { report_error_at("W0006", tokens[position + 1], "expected alias identifier") }
                        bound = tokens[position + 1].val
                        position = position + 2
                    }
                    if not base_resolved {
                        base_resolved = true
                        let base_path = module_try_resolve_source(context, canonical, requested, token)
                        if base_path != "" {
                            base_dep = module_load_from_resolved(context, base_path, requested, token)
                        }
                    }
                    if base_dep >= 0 and module_contains(context.public_names[base_dep], sym_tok.val) {
                        if module_contains(names, bound) or module_contains(aliases, bound) or module_contains(use_locals, bound) {
                            report_error_at("W1002", sym_tok, "imported symbol conflicts with declaration: " + bound)
                        }
                        use_locals.append(bound)
                        let target = module_name(base_dep, sym_tok.val)
                        use_targets.append(target)
                        use_aliased.append(aliased)
                        module_trace_name(context, sym_tok, sym_tok, target, true, true)
                        if public_use { context.public_names[index].append(bound) }
                    } else {
                        let sub_req = base_req + "/" + sym_tok.val
                        let sub_path = module_try_resolve_source(context, canonical, sub_req, sym_tok)
                        if sub_path != "" {
                            let sub_dep = module_load_from_resolved(context, sub_path, sub_req, sym_tok)
                            if module_contains(aliases, bound) or module_contains(names, bound) or module_contains(use_locals, bound) {
                                report_error_at("W1002", sym_tok, "duplicate module alias: " + bound)
                            }
                            aliases.append(bound)
                            dependencies.append(sub_dep)
                            context.import_owners.append(index)
                            context.import_aliases.append(bound)
                            context.import_targets.append(sub_dep)
                            context.import_public.append(public_use)
                            if public_use { context.public_names[index].append(bound) }
                        } elif base_dep >= 0 {
                            report_error_at("W1003", sym_tok, "member is not exported: " + sym_tok.val + module_format_exports_hint(context, base_dep))
                        } else {
                            report_error_at("W1003", token, "module not found: " + requested)
                        }
                    }
                }
            }
            if braced {
                if position >= len(tokens) - 1 or tokens[position].kind != "RBRACE" { report_error_at("W0006", token, "expected '}' in from-use declaration") }
                position = position + 1
            }
        } else {
            if token.kind == "LBRACE" { top_depth = top_depth + 1 }
            elif token.kind == "RBRACE" and top_depth > 0 { top_depth = top_depth - 1 }
            body.append(token)
            position = position + 1
        }
    }
    position = 0
    let mut braces = 0
    let mut parentheses = 0
    let mut in_attribute = false
    while position < len(body) {
        let token = body[position]
        if token.kind == "AT" { in_attribute = true }
        if token.kind == "FN" { in_attribute = false }

        let mut consumed = false
        if token.kind == "IDENT" and not (position > 0 and body[position - 1].kind == "AT" and (token.val == "deprecated" or token.val == "must_use") and not (position + 1 < len(body) and body[position + 1].kind == "DOT")) {
            for i in 0..len(aliases) {
                if token.val == aliases[i] and position + 2 < len(body) and body[position + 1].kind == "DOT" {
                    let member = body[position + 2]
                    let dependency = dependencies[i]
                    let mut nested_target = -1
                    for import_index in 0..len(context.import_owners) {
                        if context.import_owners[import_index] == dependency and context.import_aliases[import_index] == member.val and context.import_public[import_index] { nested_target = context.import_targets[import_index] }
                    }
                    if nested_target >= 0 and position + 4 < len(body) and body[position + 3].kind == "DOT" {
                        let nested_member = body[position + 4]
                        if not module_contains(context.public_names[nested_target], nested_member.val) { report_error_at("W1001", nested_member, "member is not exported: " + nested_member.val) }
                        let target = module_name(nested_target, nested_member.val)
                        module_trace_name(context, nested_member, token, target, false, true)
                        context.output.append(Token { kind: "IDENT", val: target, line: token.line, col: token.col, file: token.file })
                        position = position + 5
                    } else {
                        if not module_contains(context.public_names[dependency], member.val) { report_error_at("W1001", member, "member is not exported: " + member.val) }
                        let target = module_name(dependency, member.val)
                        module_trace_name(context, member, token, target, false, true)
                        context.output.append(Token { kind: "IDENT", val: target, line: token.line, col: token.col, file: token.file })
                        position = position + 3
                    }
                    consumed = true
                }
            }
            if not consumed {
                let mut field = false
                if in_attribute and position + 1 < len(body) and body[position + 1].kind == "COLON" { field = true }
                if position > 0 and body[position - 1].kind == "DOT" { field = true }
                if position + 1 < len(body) and body[position + 1].kind == "COLON" and parentheses == 0 {
                    field = true
                    if position > 0 and (body[position - 1].kind == "LET" or body[position - 1].kind == "MUT") { field = false }
                }
                if braces > 0 and position > 0 and body[position - 1].kind == "FN" { field = true }
                if not field {
                    for u in 0..len(use_locals) {
                        if token.val == use_locals[u] {
                            module_trace_name(context, token, token, use_targets[u], false, not use_aliased[u])
                            context.output.append(Token { kind: token.kind, val: use_targets[u], line: token.line, col: token.col, file: token.file })
                            consumed = true
                            position = position + 1
                            break
                        }
                    }
                }
                if not consumed and not entry and module_contains(names, token.val) and not field {
                    context.output.append(Token { kind: token.kind, val: module_name(index, token.val), line: token.line, col: token.col, file: token.file })
                    consumed = true
                    position = position + 1
                }
            }
        }
        if not consumed { context.output.append(token) position = position + 1 }
        if token.kind == "LBRACE" { braces = braces + 1 }
        if token.kind == "RBRACE" { braces = braces - 1 }
        if token.kind == "LPAREN" { parentheses = parentheses + 1 }
        if token.kind == "RPAREN" { parentheses = parentheses - 1 }
    }
    context.states[index] = 2
    return index
}

fn module_trace_name(context: ModuleLoader, source: Token, anchor: Token, target: str, import_site: bool, rewrite: bool) -> unit {
    if not context.trace_names { return }
    let expanded = Token { kind: "IDENT", val: target, line: anchor.line, col: anchor.col, file: anchor.file }
    context.name_sites.append(ModuleNameSite { source: source, expanded: expanded, import_site: import_site, rewrite: rewrite })
}
fn module_tokens_with_overlays(src: str, path: str, ov_paths: list[str], ov_texts: list[str]) -> list[Token] {
    let context = ModuleLoader()
    context.ov_paths = ov_paths
    context.ov_texts = ov_texts
    module_expand(context, src, path, true)
    context.output.append(Token { kind: "EOF", val: "", line: 1, col: 1, file: module_normalize(path) })
    return context.output
}

fn module_tokens_with_project(src: str, path: str, proj_src_root: str, dep_aliases: list[str], dep_roots: list[str]) -> list[Token] {
    let context = ModuleLoader()
    context.project_sources_root = proj_src_root
    context.dep_aliases = dep_aliases
    context.dep_roots = dep_roots
    module_expand(context, src, path, true)
    context.output.append(Token { kind: "EOF", val: "", line: 1, col: 1, file: module_normalize(path) })
    return context.output
}

fn module_tokens(src: str, path: str) -> list[Token] {
    return module_tokens_with_overlays(src, path, [], [])
}
