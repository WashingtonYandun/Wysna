fn at_tok(emitter: CEmitter) -> Token {
    return emitter.tokens[emitter.pos]
}

fn peek_tok(emitter: CEmitter, offset: int) -> Token {
    let idx = emitter.pos + offset
    if idx >= len(emitter.tokens) {
        return emitter.tokens[len(emitter.tokens) - 1]
    }
    return emitter.tokens[idx]
}

fn is_eof(emitter: CEmitter) -> bool {
    return at_tok(emitter).kind == "EOF"
}

fn check_kind(emitter: CEmitter, k: str) -> bool {
    return at_tok(emitter).kind == k
}

fn advance_tok(emitter: CEmitter) -> Token {
    let tok = emitter.tokens[emitter.pos]
    if emitter.pos + 1 < len(emitter.tokens) {
        emitter.pos = emitter.pos + 1
    }
    return tok
}

fn match_kind(emitter: CEmitter, k: str) -> bool {
    if check_kind(emitter, k) {
        advance_tok(emitter)
        return true
    }
    return false
}

fn skip_statement_separators(emitter: CEmitter) {
    while check_kind(emitter, "NEWLINE") or check_kind(emitter, "SEMICOLON") {
        advance_tok(emitter)
    }
}

fn skip_newlines_before_branch(emitter: CEmitter) {
    let saved = emitter.pos
    while check_kind(emitter, "NEWLINE") {
        advance_tok(emitter)
    }
    if not check_kind(emitter, "ELIF") and not check_kind(emitter, "ELSE") {
        emitter.pos = saved
    }
}

fn expect_kind(emitter: CEmitter, k: str) -> Token {
    let tok = at_tok(emitter)
    if tok.kind != k {
        if k == "RBRACE" or k == "RBRACKET" {
            report_error_at("W0006", tok, "expected '" + k + "', found '" + tok.val + "'")
        } else {
            report_error_at("W0001", tok, "expected '" + k + "', found '" + tok.val + "'")
        }
    }
    advance_tok(emitter)
    return tok
}

fn expression_starter(kind: str) -> bool {
    return kind == "INT" or kind == "FLOAT" or kind == "STR" or kind == "TRUE" or kind == "FALSE" or kind == "NONE" or kind == "IDENT" or kind == "THIS" or kind == "SUPER" or kind == "NEW" or kind == "MINUS" or kind == "NOT" or kind == "LPAREN" or kind == "LBRACKET" or kind == "LBRACE" or kind == "PIPE" or kind == "IF" or kind == "MATCH"
}
