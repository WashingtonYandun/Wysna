# Deterministic diagnostics, UTF-8 byte-span calculation, and SHA-256 helpers shared by all compiler stages.
extern "C" fn wysna_host_buffer_new() -> opaque
extern "C" fn wysna_host_buffer_append(handle: opaque, value: int) -> int
extern "C" fn wysna_host_buffer_get(handle: opaque, index: int) -> int
extern "C" fn wysna_host_crypto_sha256(input_handle: opaque, output_handle: opaque) -> int
extern "C" fn wysna_host_crypto_random_bytes(output_handle: opaque, count: int) -> int
extern "C" fn wysna_host_close(handle: opaque) -> int

fn diag_uuid4() -> str {
    let buf = wysna_host_buffer_new()
    let st = wysna_host_crypto_random_bytes(buf, 16)
    if st != 0 {
        wysna_host_close(buf)
        return "native"
    }
    let mut parts: list[str] = []
    for i in 0..16 {
        let mut b = wysna_host_buffer_get(buf, i)
        if b < 0 { b = 0 }
        if i == 6 { b = (b % 16) + 64 }
        elif i == 8 { b = (b % 64) + 128 }
        parts.append(diag_hex_digit((b / 16) % 16) + diag_hex_digit(b % 16))
        if i == 3 or i == 5 or i == 7 or i == 9 { parts.append("-") }
    }
    wysna_host_close(buf)
    return join_strings(parts, "")
}

fn diag_hex_digit(n: int) -> str {
    let digits = "0123456789abcdef"
    if n < 0 or n >= 16 { return "0" }
    return digits[n]
}

fn diag_sha256_hex(text: str) -> str {
    let input = wysna_host_buffer_new()
    let output = wysna_host_buffer_new()
    for b in bytes(text) {
        wysna_host_buffer_append(input, b)
    }
    let status = wysna_host_crypto_sha256(input, output)
    let mut parts: list[str] = []
    if status == 0 {
        for i in 0..32 {
            let v = wysna_host_buffer_get(output, i)
            let hi = (v / 16) % 16
            let lo = v % 16
            parts.append(diag_hex_digit(hi) + diag_hex_digit(lo))
        }
    }
    wysna_host_close(input)
    wysna_host_close(output)
    return join_strings(parts, "")
}

fn diag_json_quote(s: str) -> str {
    let mut parts: list[str] = ["\""]
    let n = len(s)
    for i in 0..n {
        let ch = s[i]
        let code = ord(ch)
        if code == 34 {
            parts.append("\\\"")
        } elif code == 92 {
            parts.append("\\\\")
        } elif code == 8 {
            parts.append("\\b")
        } elif code == 12 {
            parts.append("\\f")
        } elif code == 10 {
            parts.append("\\n")
        } elif code == 13 {
            parts.append("\\r")
        } elif code == 9 {
            parts.append("\\t")
        } elif code >= 0 and code < 32 {
            parts.append("\\u00" + diag_hex_digit(code / 16) + diag_hex_digit(code % 16))
        } else {
            parts.append(ch)
        }
    }
    parts.append("\"")
    return join_strings(parts, "")
}

fn diag_stage_for_code(code: str) -> str {
    if code == "W0001" or code == "W0002" or code == "W0003" or code == "W0004" or code == "W0005" {
        return "lexer"
    }
    if code == "W0006" { return "syntax" }
    if len(code) >= 2 and code[0] == "W" and code[1] == "1" { return "semantic" }
    if len(code) >= 2 and code[0] == "W" and (code[1] == "2" or code[1] == "3") { return "type" }
    if len(code) >= 2 and code[0] == "W" and code[1] == "4" { return "runtime" }
    if code == "W5005" { return "patch" }
    if code == "W5006" { return "capability-policy" }
    if len(code) >= 2 and code[0] == "W" and code[1] == "5" { return "toolchain" }
    if len(code) >= 2 and code[0] == "W" and code[1] == "6" { return "lint" }
    return "internal"
}

fn diag_char_offset_at(src: str, target_line: int, target_col: int) -> int {
    if target_line < 1 or target_col < 1 { return -1 }
    let n = len(src)
    let mut line = 1
    let mut i = 0
    while line < target_line and i < n {
        let code = ord(src[i])
        if code == 13 {
            if i + 1 < n and ord(src[i + 1]) == 10 { i = i + 2 } else { i = i + 1 }
            line = line + 1
        } elif code == 10 {
            i = i + 1
            line = line + 1
        } else {
            i = i + 1
        }
    }
    if line < target_line { return -1 }
    let mut line_end = i
    while line_end < n {
        let c = ord(src[line_end])
        if c == 10 or c == 13 { break }
        line_end = line_end + 1
    }
    let col_pos = i + target_col - 1
    return if col_pos <= line_end { col_pos } else { line_end }
}

fn diag_utf8_byte_at(src: str, char_pos: int) -> int {
    if char_pos <= 0 { return 0 }
    let clamped = if char_pos > len(src) { len(src) } else { char_pos }
    return len(bytes(slice(src, 0, clamped)))
}

fn diag_char_span_width(src: str, start_char: int) -> int {
    let n = len(src)
    if start_char < 0 or start_char >= n { return start_char }
    let c = ord(src[start_char])
    if c == 10 or c == 13 { return start_char }
    let mut end_c = start_char + 1
    let is_word = (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or (c >= 48 and c <= 57) or c == 95
    if is_word {
        while end_c < n {
            let ch = ord(src[end_c])
            if (ch >= 65 and ch <= 90) or (ch >= 97 and ch <= 122) or (ch >= 48 and ch <= 57) or ch == 95 {
                end_c = end_c + 1
            } else {
                break
            }
        }
    } elif c == 34 {
        while end_c < n {
            let ch = ord(src[end_c])
            if ch == 10 or ch == 13 { break }
            if ch == 92 and end_c + 1 < n {
                end_c = end_c + 2
                continue
            }
            end_c = end_c + 1
            if ch == 34 { break }
        }
    }
    return end_c
}

fn diag_primary_span_json(file: str, line: int, col: int, src: str) -> str {
    if file == "" or src == "" or line < 1 or col < 1 { return "null" }
    let start_char = diag_char_offset_at(src, line, col)
    if start_char < 0 { return "null" }
    let end_char = diag_char_span_width(src, start_char)
    let start_byte = diag_utf8_byte_at(src, start_char)
    let end_byte = diag_utf8_byte_at(src, end_char)
    let sha = diag_sha256_hex(src)
    return "{\"source_id\":" + diag_json_quote(file) + ",\"source_sha256\":" + diag_json_quote(sha) + ",\"start_byte\":" + str(start_byte) + ",\"end_byte\":" + str(end_byte) + "}"
}

fn diag_related_record_json(message: str, file: str, line: int, col: int) -> str {
    let src = if file != "" and file != "<stdin>" and file != "<unknown>" and file != "<cli>" {
        diag_read_snippet_source(file)
    } else { "" }
    let span_json = diag_primary_span_json(file, line, col, src)
    return "{\"message\":" + diag_json_quote(message) + ",\"line\":" + str(line) + ",\"col\":" + str(col) + ",\"span\":" + span_json + "}"
}

fn diag_record_json(code: str, stage: str, severity: str, msg: str, file: str, line: int, col: int, src: str) -> str {
    let data_json = if stage == "type" { fix_mismatch_data_json(msg) } else { "{}" }
    return diag_record_json_full(code, stage, severity, msg, file, line, col, src, data_json, "[]")
}

fn diag_record_json_data(code: str, stage: str, severity: str, msg: str, file: str, line: int, col: int, src: str, data_json: str) -> str {
    return diag_record_json_full(code, stage, severity, msg, file, line, col, src, data_json, "[]")
}

fn diag_record_json_full(code: str, stage: str, severity: str, msg: str, file: str, line: int, col: int, src: str, data_json: str, related_json: str) -> str {
    let span_json = diag_primary_span_json(file, line, col, src)
    let fixes_json = if span_json != "null" { fix_diagnostic_edits_json(code, msg, file, src, line, col) } else { "[]" }
    return "{\"code\":" + diag_json_quote(code) + ",\"severity\":" + diag_json_quote(severity) + ",\"stage\":" + diag_json_quote(stage) + ",\"message\":" + diag_json_quote(msg) + ",\"primary_span\":" + span_json + ",\"related\":" + related_json + ",\"data\":" + data_json + ",\"fixes\":" + fixes_json + "}"
}

fn diag_tool_envelope_json(command: str, status: str, exit_code: int, diagnostics_json: str, result_key: str, result_json: str, artifacts_json: str) -> str {
    let mut parts: list[str] = ["{\"schema_version\":\"wysna.tool-result/1\""]
    parts.append(",\"command\":" + diag_json_quote(command))
    parts.append(",\"status\":" + diag_json_quote(status))
    parts.append(",\"invocation_id\":" + diag_json_quote(diag_uuid4()))
    parts.append(",\"tool_exit_code\":" + str(exit_code))
    parts.append(",\"process_exit_code\":" + str(exit_code))
    parts.append(",\"execution\":null")
    parts.append((",\"toolchain\":{\"compiler\":\"" + tool_compiler_version() + "\"}"))
    parts.append(",\"target\":{\"profile\":\"native-cli\",\"triple\":null}")
    parts.append(",\"diagnostics\":" + diagnostics_json)
    parts.append(",\"artifacts\":" + artifacts_json)
    parts.append(",\"telemetry\":null")
    if result_key != "" {
        parts.append("," + diag_json_quote(result_key) + ":" + result_json)
    }
    parts.append("}")
    return join_strings(parts, "")
}

fn diag_clean_cli_args() -> list[str] {
    let raw = args()
    let mut clean: list[str] = []
    let mut i = 1
    while i < len(raw) {
        if raw[i] == "--diag-array" { i = i + 1 }
        elif (raw[i] == "--stdlib-root" or raw[i] == "--diag-out" or raw[i] == "--project-sources-root") and i + 1 < len(raw) {
            i = i + 2
        } elif (raw[i] == "--overlay" or raw[i] == "--project-dep") and i + 2 < len(raw) {
            i = i + 3
        } else {
            clean.append(raw[i])
            i = i + 1
        }
    }
    return clean
}

fn diag_out_path() -> str {
    let raw = args()
    let mut i = 1
    while i < len(raw) {
        if raw[i] == "--diag-out" and i + 1 < len(raw) { return raw[i + 1] }
        i = i + 1
    }
    return ""
}

fn diag_write_output(payload: str) -> unit {
    let out = diag_out_path()
    if out != "" {
        write_file(out, payload) else err {
            print(payload)
            return
        }
        return
    }
    print(payload)
}

fn diag_read_snippet_source(file: str) -> str {
    let raw = args()
    let mut i = 1
    while i < len(raw) {
        if raw[i] == "--overlay" and i + 2 < len(raw) {
            if raw[i + 1] == file {
                return read_file(raw[i + 2]) else error { "" }
            }
            i = i + 3
        } else {
            i = i + 1
        }
    }
    return read_file(file) else error { "" }
}

fn diag_cli_json_mode() -> str {
    for value in args() { if value == "--diag-array" { return "array" } }
    let clean = diag_clean_cli_args()
    if len(clean) > 0 and clean[0] == "api" { return "json-v1" }
    for i in 0..len(clean) {
        if clean[i] == "--check-json" { return "check-json" }
        if clean[i] == "--output-format=json-v1" { return "json-v1" }
        if clean[i] == "--output-format" and i + 1 < len(clean) and clean[i + 1] == "json-v1" { return "json-v1" }
        if len(clean) > 0 and clean[0] == "schema" and clean[i] == "--json" { return "json-v1" }
    }
    return ""
}

fn diag_cli_command() -> str {
    let clean = diag_clean_cli_args()
    if len(clean) == 0 { return "check" }
    let first = clean[0]
    if first == "check" or first == "--check" or first == "--check-json" { return "check" }
    if first == "fmt" or first == "--fmt" or first == "--fmt-write" { return "fmt" }
    if first == "api" { return "api" }
    if first == "project" {
        if len(clean) > 1 {
            if clean[1] == "check" or clean[1] == "build" or clean[1] == "run" or clean[1] == "test" {
                return "project." + clean[1]
            }
        }
        return "project"
    }
    if first == "graph" or first == "inspect" or first == "patch" or first == "explain" or first == "lsp" or first == "schema" or first == "fix" or first == "skills" or first == "capabilities" or first == "mcp" { return first }
    if first == "--emit-c-mir" or first == "--emit-mir" or first == "--check-mir" { return "build" }
    return "check"
}

fn diag_render_source_excerpt(src: str, target_line: int, target_col: int) -> str {
    if src == "" or target_line < 1 or target_col < 1 { return "" }
    let n = len(src)
    let mut cur = 1
    let mut i = 0
    while cur < target_line and i < n {
        let code = ord(src[i])
        if code == 13 {
            if i + 1 < n and ord(src[i + 1]) == 10 { i = i + 2 } else { i = i + 1 }
            cur = cur + 1
        } elif code == 10 {
            i = i + 1
            cur = cur + 1
        } else {
            i = i + 1
        }
    }
    if cur != target_line { return "" }
    let mut end_i = i
    while end_i < n {
        let c = ord(src[end_i])
        if c == 10 or c == 13 { break }
        end_i = end_i + 1
    }
    let text = slice(src, i, end_i)
    let line_label = str(target_line)
    let mut pad_parts: list[str] = []
    for _k in 0..len(line_label) { pad_parts.append(" ") }
    let mut caret_parts: list[str] = []
    let mut spaces = target_col - 1
    if spaces < 0 { spaces = 0 }
    if spaces > len(text) { spaces = len(text) }
    for _s in 0..spaces { caret_parts.append(" ") }
    let start_char = i + spaces
    let end_char = diag_char_span_width(src, start_char)
    let mut width = end_char - start_char
    if width < 1 { width = 1 }
    for _c in 0..width { caret_parts.append("^") }
    return line_label + " | " + text + "\n" + join_strings(pad_parts, "") + " | " + join_strings(caret_parts, "")
}

struct CollectedDiag {
    file: str,
    code: str,
    line: int,
    col: int,
    msg: str,
    data: str,
    related_json: str,
}

fn diag_emit_and_exit(file: str, code: str, line: int, col: int, msg: str) -> unit {
    diag_emit_and_exit_full(file, code, line, col, msg, "", "[]")
}

fn diag_emit_and_exit_data(file: str, code: str, line: int, col: int, msg: str, data: str) -> unit {
    diag_emit_and_exit_full(file, code, line, col, msg, data, "[]")
}

fn diag_emit_and_exit_full(file: str, code: str, line: int, col: int, msg: str, data: str, related_json: str) -> unit {
    diag_emit_all_and_exit([CollectedDiag {
        file: file,
        code: code,
        line: line,
        col: col,
        msg: msg,
        data: data,
        related_json: related_json,
    }])
}

fn diag_has(h: str, needle: str) -> bool {
    let m = len(needle)
    for i in 0..(len(h) - m + 1) { if slice(h, i, i + m) == needle { return true } }
    return m == 0
}
fn diag_help_field(d: str) -> str {
    for i in 0..(len(d) - 8) { if slice(d, i, i + 8) == "\"help\":\"" {
        let mut k = i + 8
        let mut out: list[str] = []
        while k < len(d) and ord(d[k]) != 34 {
            if ord(d[k]) == 92 and k + 1 < len(d) { out.append(d[k + 1]) k = k + 2 } else { out.append(d[k]) k = k + 1 }
        }
        return join_strings(out, "")
    } }
    return ""
}
fn diag_human_help(code: str, msg: str, data_json: str) -> str {
    let h = diag_help_field(data_json)
    if h != "" { return h }
    if code == "W0001" or code == "W0006" { return "Check for missing delimiters ('}', ')', ']') or unexpected tokens nearby." } elif code == "W1002" { return "Rename or remove the duplicate declaration in this scope." } elif code == "W1003" { return "Check the module path ('std/...' or local path) and ensure there are no circular imports." }
    if code == "W1001" { if diag_has(msg, "ambiguous enum") { return "Qualify the enum variant with its enum name, e.g. MyEnum.Variant." } elif diag_has(msg, "unknown module") { return "Check the module path ('std/...' for stdlib or verify the local path)." } elif diag_has(msg, "unknown identifier") { return "Declare the binding with 'let'/'let mut', define the function, or import it." } }
    if code == "W2001" { if diag_has(msg, "'int'") and diag_has(msg, "'float'") { return "Convert explicitly using int(...) or float(...) before mixing int and float." } elif diag_has(msg, "expected 'str'") { return "Convert the value to a string with str(...)." } elif diag_has(msg, "binary operand types") { return "Operands must have matching types; convert explicitly with int(...), float(...), or str(...)." } }
    if (code == "W2003" or code == "W3001") and diag_has(msg, "immutable") { return "Declare the variable as 'let mut ...' if it needs to be reassigned." } elif code == "W2003" and (diag_has(msg, "exhaustive") or diag_has(msg, "Non-exhaustive")) { return "Handle every variant or add a fallback '_ =>' arm." }
    if code == "W3002" and diag_has(msg, "unknown member") { return "Verify the field or method name on the receiver type, or run 'wysna inspect'." } elif code == "W2004" and diag_has(msg, " ! ") { return "Wrap error values with Err(...) or propagate with '?'." }
    if code == "W2006" { if diag_has(msg, "coalesce") { return "The '??' operator requires an optional 'T?' on the left-hand side." } return "Use '?' inside a function returning a compatible 'T?' or 'T ! E', or handle locally with 'else err { ... }'." } elif code == "W2002" { return "Check the function signature for expected argument count." } elif code == "W2005" { return "Provide the payload argument(s) expected by this enum variant." } elif code == "W2007" { return "Provide every required struct field in the literal." } elif code == "W2009" { return "Add an explicit type annotation so the compiler can resolve the type." }
    return ""
}

fn diag_emit_all_and_exit(diags: list[CollectedDiag]) -> unit {
    if len(diags) == 0 { exit(1) }
    let mode = diag_cli_json_mode()
    if mode == "" {
        for d in diags {
            let mut src = ""
            if d.file != "" and d.file != "<stdin>" and d.file != "<unknown>" and d.file != "<cli>" {
                src = diag_read_snippet_source(d.file)
            }
            eprint("[" + d.code + "] " + d.file + ":" + str(d.line) + ":" + str(d.col) + " - " + d.msg)
            let excerpt = diag_render_source_excerpt(src, d.line, d.col)
            if excerpt != "" { eprint(excerpt) }
            let help_text = diag_human_help(d.code, d.msg, d.data)
            if help_text != "" { eprint("  help: " + help_text) }
        }
        exit(1)
    }
    let mut records: list[str] = []
    for d in diags {
        let mut src = ""
        if d.file != "" and d.file != "<stdin>" and d.file != "<unknown>" and d.file != "<cli>" {
            src = diag_read_snippet_source(d.file)
        }
        let stage = diag_stage_for_code(d.code)
        let eff_data = if d.data == "" {
            if stage == "type" { fix_mismatch_data_json(d.msg) } else { "{}" }
        } else { d.data }
        let rel = if d.related_json == "" { "[]" } else { d.related_json }
        records.append(diag_record_json_full(d.code, stage, "error", d.msg, d.file, d.line, d.col, src, eff_data, rel))
    }
    let joined = "[" + join_strings(records, ",") + "]"
    if mode == "array" {
        diag_write_output(joined)
        exit(1)
    }
    if mode == "check-json" {
        diag_write_output(("{\"schema_version\":\"wysna.cli.result/1\",\"compiler_version\":\"" + tool_compiler_version() + "\",\"command\":\"check\",\"ok\":false,\"exit_code\":1,\"diagnostics\":") + joined + ",\"data\":null}")
        exit(1)
    }
    let cmd = diag_cli_command()
    let first_code = diags[0].code
    let status = if first_code == "W5002" { "usage_error" } elif first_code == "W5003" or first_code == "W5004" { "toolchain_error" } else { "diagnostic_error" }
    diag_write_output(diag_tool_envelope_json(cmd, status, 1, joined, "", "", "[]"))
    exit(1)
}
