fn new_temp(emitter: CEmitter) -> str {
    let name = "_t" + str(emitter.temp_id)
    emitter.temp_id = emitter.temp_id + 1
    return name
}

fn new_aux(emitter: CEmitter, prefix: str) -> str {
    let s = prefix + str(emitter.aux_id)
    emitter.aux_id = emitter.aux_id + 1
    return s
}

fn push_scope(emitter: CEmitter, kind: str) -> unit {
    let empty_v: list[str] = []
    emitter.scope_stack.append(CleanupScope { kind: kind, vars: empty_v })
}

fn register_var(emitter: CEmitter, v: str) -> unit {
    let n = len(emitter.scope_stack)
    if n > 0 {
        emitter.scope_stack[n - 1].vars.append(v)
    }
}

fn declare_owned_var(emitter: CEmitter, var_name: str, init_c_expr: str) -> str {
    emit_line(emitter, "WVal " + var_name + " = " + init_c_expr + ";")
    register_var(emitter, var_name)
    return var_name
}

fn pop_scope(emitter: CEmitter) -> unit {
    let n = len(emitter.scope_stack)
    if n == 0 {
        return
    }
    let top = emitter.scope_stack[n - 1]
    emitter.scope_stack.pop()
    let num_vars = len(top.vars)
    if num_vars > 0 {
        let mut idx = num_vars - 1
        while idx >= 0 {
            emit_line(emitter, "wysna_release(" + top.vars[idx] + ");")
            idx = idx - 1
        }
    }
}

fn emit_cleanup_until_fn(emitter: CEmitter) -> unit {
    let num_scopes = len(emitter.scope_stack)
    let mut si = num_scopes - 1
    while si >= 0 {
        let sc = emitter.scope_stack[si]
        let num_vars = len(sc.vars)
        if num_vars > 0 {
            let mut vi = num_vars - 1
            while vi >= 0 {
                emit_line(emitter, "wysna_release(" + sc.vars[vi] + ");")
                vi = vi - 1
            }
        }
        if sc.kind == "fn" {
            break
        }
        si = si - 1
    }
}

fn emit_cleanup_until_fn_indented(emitter: CEmitter) -> unit {
    let num_scopes = len(emitter.scope_stack)
    let mut si = num_scopes - 1
    while si >= 0 {
        let sc = emitter.scope_stack[si]
        let num_vars = len(sc.vars)
        if num_vars > 0 {
            let mut vi = num_vars - 1
            while vi >= 0 {
                emit_line(emitter, "    wysna_release(" + sc.vars[vi] + ");")
                vi = vi - 1
            }
        }
        if sc.kind == "fn" {
            break
        }
        si = si - 1
    }
}

fn emit_cleanup_until_loop(emitter: CEmitter) -> unit {
    let num_scopes = len(emitter.scope_stack)
    let mut si = num_scopes - 1
    while si >= 0 {
        let sc = emitter.scope_stack[si]
        let num_vars = len(sc.vars)
        if num_vars > 0 {
            let mut vi = num_vars - 1
            while vi >= 0 {
                emit_line(emitter, "wysna_release(" + sc.vars[vi] + ");")
                vi = vi - 1
            }
        }
        if sc.kind == "loop" {
            break
        }
        si = si - 1
    }
}

fn has_cleanup_until_loop(emitter: CEmitter) -> bool {
    let num_scopes = len(emitter.scope_stack)
    let mut si = num_scopes - 1
    while si >= 0 {
        let sc = emitter.scope_stack[si]
        if len(sc.vars) > 0 {
            return true
        }
        if sc.kind == "loop" {
            break
        }
        si = si - 1
    }
    return false
}

fn emit_cleanup_until_loop_indented(emitter: CEmitter) -> unit {
    let num_scopes = len(emitter.scope_stack)
    let mut si = num_scopes - 1
    while si >= 0 {
        let sc = emitter.scope_stack[si]
        let num_vars = len(sc.vars)
        if num_vars > 0 {
            let mut vi = num_vars - 1
            while vi >= 0 {
                emit_line(emitter, "    wysna_release(" + sc.vars[vi] + ");")
                vi = vi - 1
            }
        }
        if sc.kind == "loop" {
            break
        }
        si = si - 1
    }
}

fn own_expr(val_expr: str) -> str {
    if len(val_expr) >= 2 and slice(val_expr, 0, 2) == "_t" {
        return "wysna_move(&" + val_expr + ")"
    }
    if len(val_expr) >= 11 and slice(val_expr, 0, 11) == "wysna_make_" {
        return val_expr
    }
    if len(val_expr) >= 10 and slice(val_expr, 0, 10) == "wysna_new_" {
        return val_expr
    }
    if len(val_expr) >= 12 and slice(val_expr, 0, 12) == "wysna_clone(" {
        return val_expr
    }
    return "wysna_clone(" + val_expr + ")"
}

fn emit_line(emitter: CEmitter, line: str) -> unit {
    emitter.cur_stmts.append(line)
}


fn snapshot_value(emitter: CEmitter, value: str) -> str {
    if len(value) >= 2 and slice(value, 0, 2) == "_t" {
        return value
    }
    if len(value) >= 11 and slice(value, 0, 11) == "wysna_make_" {
        return bind_call(emitter, value).val
    }
    return bind_call(emitter, "wysna_clone(" + value + ")").val
}

fn is_bound_variable(emitter: CEmitter, value: str) -> bool {
    for name in emitter.borrowed_vars { if name == value { return true } }
    for name in emitter.globals { if name == value { return true } }
    for scope in emitter.scope_stack { for name in scope.vars { if name == value { return true } } }
    return false
}
fn emit_indirect_call(emitter: CEmitter, callee: str, args: list[str]) -> ExprRes {
    let mut joined = ""
    for i in 0..len(args) {
        if i > 0 { joined = joined + ", " }
        joined = joined + args[i]
    }
    if len(args) == 0 { return bind_call(emitter, "wysna_call(" + callee + ", 0, NULL)") }
    let array = new_aux(emitter, "_call_args")
    emit_line(emitter, "WVal " + array + "[" + str(len(args)) + "] = { " + joined + " };")
    return bind_call(emitter, "wysna_call(" + callee + ", " + str(len(args)) + ", " + array + ")")
}

fn emit_function_value(emitter: CEmitter, name: str) -> ExprRes {
    let index = checked_function(emitter.checked, name)
    let arity = len(emitter.checked.signatures[index].params)
    let adapter = "wysna_adapter_" + name
    let prototype = "static WVal " + adapter + "(WVal, int32_t, const WVal*);"
    let mut exists = false
    for declaration in emitter.protos { if declaration == prototype { exists = true } }
    if not exists {
        emitter.protos.append(prototype)
        let mut arguments = ""
        for i in 0..arity {
            if i > 0 { arguments = arguments + ", " }
            arguments = arguments + "argv[" + str(i) + "]"
        }
        emitter.fn_defs.append("static WVal " + adapter + "(WVal environment, int32_t argc, const WVal* argv) { (void)environment; if (argc != " + str(arity) + ") (fprintf(stderr, \"[W4003] RuntimeError: Call arity mismatch\\n\"), exit(1)); return " + c_fn_name(name) + "(" + arguments + "); }")
    }
    return bind_call(emitter, "wysna_function_new(" + adapter + ", wysna_unit())")
}

fn emit_struct_constructor(emitter: CEmitter, name: str, values: list[str]) -> ExprRes {
    let mut keys: list[str] = []
    let mut field_count = 0
    for field in emitter.checked.c99.fields {
        if field.owner == name {
            keys.append("\"" + field.name + "\"")
            field_count = field_count + 1
        }
    }
    if field_count != len(values) { report_error(at_tok(emitter).file, "W2005", at_tok(emitter).line, at_tok(emitter).col, "struct constructor arity: " + name) }
    if field_count == 0 { return bind_call(emitter, "wysna_make_struct(\"" + name + "\", 0, NULL, NULL)") }
    let keys_var = new_aux(emitter, "_keys")
    let values_var = new_aux(emitter, "_values")
    let mut joined_keys = ""
    let mut joined_values = ""
    for i in 0..field_count {
        if i > 0 { joined_keys = joined_keys + ", " joined_values = joined_values + ", " }
        joined_keys = joined_keys + keys[i]
        joined_values = joined_values + values[i]
    }
    let count = str(field_count)
    emit_line(emitter, "const char* " + keys_var + "[" + count + "] = { " + joined_keys + " };")
    emit_line(emitter, "WVal " + values_var + "[" + count + "] = { " + joined_values + " };")
    return bind_call(emitter, "wysna_make_struct(\"" + name + "\", " + count + ", " + keys_var + ", " + values_var + ")")
}
