fn selfhost_trim_line(line: str) -> str {
    let n = len(line)
    let mut start = 0
    while start < n and (ord(line[start]) == 32 or ord(line[start]) == 9) {
        start = start + 1
    }
    let mut end = n
    while end > start and (ord(line[end - 1]) == 32 or ord(line[end - 1]) == 9) {
        end = end - 1
    }
    return slice(line, start, end)
}

fn selfhost_format_body(source: str, in_path: str) -> str {
    let module = mir_build(check_source(source, in_path))
    mir_verify(module)
    let mut raw_lines: list[str] = []
    let n = len(source)
    let mut line_start = 0
    let mut pos = 0
    while pos < n {
        let code = ord(source[pos])
        if code == 13 or code == 10 {
            raw_lines.append(slice(source, line_start, pos))
            if code == 13 and pos + 1 < n and ord(source[pos + 1]) == 10 {
                pos = pos + 2
            } else {
                pos = pos + 1
            }
            line_start = pos
        } else {
            pos = pos + 1
        }
    }
    if line_start < n {
        raw_lines.append(slice(source, line_start, n))
    }

    let mut out_lines: list[str] = []
    let mut depth = 0
    let mut block_depth = 0
    let mut prev_blank = true
    for raw in raw_lines {
        if block_depth > 0 {
            out_lines.append(raw)
            let rlen = len(raw)
            let mut idx = 0
            while idx < rlen {
                if ord(raw[idx]) == 47 and idx + 1 < rlen and ord(raw[idx + 1]) == 42 {
                    block_depth = block_depth + 1
                    idx = idx + 2
                } elif ord(raw[idx]) == 42 and idx + 1 < rlen and ord(raw[idx + 1]) == 47 {
                    block_depth = block_depth - 1
                    idx = idx + 2
                    if block_depth == 0 {
                        prev_blank = false
                        break
                    }
                } else {
                    idx = idx + 1
                }
            }
            continue
        }
        let trimmed = selfhost_trim_line(raw)
        if len(trimmed) == 0 {
            if not prev_blank {
                out_lines.append("")
                prev_blank = true
            }
        } else {
            prev_blank = false
            let tlen = len(trimmed)
            let mut leading_closes = 0
            if not (tlen >= 2 and ord(trimmed[0]) == 47 and ord(trimmed[1]) == 42) {
                while leading_closes < tlen and ord(trimmed[leading_closes]) == 125 {
                    leading_closes = leading_closes + 1
                }
            }
            let mut indent_level = depth - leading_closes
            if indent_level < 0 { indent_level = 0 }
            let mut prefix = ""
            for _step in 0..indent_level {
                prefix = prefix + "    "
            }
            out_lines.append(prefix + trimmed)

            let mut opens = 0
            let mut closes = 0
            let mut in_str = false
            let mut escaped = false
            let mut idx = 0
            while idx < tlen {
                let c = ord(trimmed[idx])
                if block_depth > 0 {
                    if c == 47 and idx + 1 < tlen and ord(trimmed[idx + 1]) == 42 {
                        block_depth = block_depth + 1
                        idx = idx + 2
                    } elif c == 42 and idx + 1 < tlen and ord(trimmed[idx + 1]) == 47 {
                        block_depth = block_depth - 1
                        idx = idx + 2
                    } else {
                        idx = idx + 1
                    }
                } elif in_str {
                    if escaped {
                        escaped = false
                    } elif c == 92 {
                        escaped = true
                    } elif c == 34 {
                        in_str = false
                    }
                    idx = idx + 1
                } else {
                    if c == 35 {
                        break
                    } elif c == 47 and idx + 1 < tlen and ord(trimmed[idx + 1]) == 42 {
                        block_depth = block_depth + 1
                        idx = idx + 2
                    } elif c == 34 {
                        in_str = true
                        idx = idx + 1
                    } elif c == 123 {
                        opens = opens + 1
                        idx = idx + 1
                    } elif c == 125 {
                        closes = closes + 1
                        idx = idx + 1
                    } else {
                        idx = idx + 1
                    }
                }
            }
            depth = depth + opens - closes
            if depth < 0 { depth = 0 }
        }
    }
    while len(out_lines) > 0 and len(out_lines[len(out_lines) - 1]) == 0 {
        out_lines.pop()
    }
    return join_strings(out_lines, "\n")
}

fn selfhost_json_quote(s: str) -> str {
    let mut out = "\""
    let n = len(s)
    for i in 0..n {
        let ch = s[i]
        let code = ord(ch)
        if code == 34 { out = out + "\\\"" }
        elif code == 92 { out = out + "\\\\" }
        elif code == 10 { out = out + "\\n" }
        elif code == 13 { out = out + "\\r" }
        elif code == 9 { out = out + "\\t" }
        else { out = out + ch }
    }
    return out + "\""
}

fn run_compiler() -> unit ! IoError {
    let raw_cli = args()
    let mut cli = raw_cli
    if len(raw_cli) > 1 and raw_cli[1] == "--stdlib-root" {
        if len(raw_cli) < 4 { eprint("[W5002] Missing SDK compiler arguments") exit(2) }
        cli = [raw_cli[0]]
        for index in 3..len(raw_cli) { cli.append(raw_cli[index]) }
    }
    if len(cli) == 2 and (cli[1] == "--version" or cli[1] == "-v") {
        print("wysna 0.6.0")
        return
    }
    if len(cli) > 1 and (cli[1] == "--check" or cli[1] == "--check-json") {
        if len(cli) != 3 {
            eprint("[W5002] Usage: Wysna Compiler --check INPUT")
            exit(2)
        }
        let in_path = cli[2]
        let source = read_file(in_path)?
        let module = mir_build(check_source(source, in_path))
        mir_verify(module)
        if cli[1] == "--check-json" {
            let fn_count = str(len(module.functions))
            let payload = "{\"schema_version\":\"wysna.cli.result/1\",\"compiler_version\":\"0.6.0\",\"command\":\"check\",\"ok\":true,\"exit_code\":0,\"diagnostics\":[],\"data\":{\"file\":" + selfhost_json_quote(in_path) + ",\"functions\":" + fn_count + "}}"
            print(payload)
        } else {
            print("[Wysna Compiler] Checked", in_path)
        }
        return
    }
    if len(cli) > 1 and (cli[1] == "--fmt" or cli[1] == "--fmt-write") {
        if len(cli) != 3 {
            eprint("[W5002] Usage: Wysna Compiler --fmt INPUT")
            exit(2)
        }
        let in_path = cli[2]
        let source = read_file(in_path)?
        let body = selfhost_format_body(source, in_path)
        if cli[1] == "--fmt-write" {
            write_file(in_path, body + "\n")?
            print("Formatted", in_path)
        } else {
            print(body)
        }
        return
    }
    if len(cli) > 1 and (cli[1] == "--emit-mir" or cli[1] == "--emit-c-mir" or cli[1] == "--check-mir") {
        if (len(cli) != 3 and len(cli) != 4) or cli[1] == "--check-mir" and len(cli) != 3 {
            eprint("[W5002] Usage: Wysna Compiler --emit-mir INPUT")
            exit(2)
        }
        let source = read_file(cli[2])?
        let module = mir_build(check_source(source, cli[2]))
        if cli[1] == "--check-mir" { mir_verify(module) }
        else {
            let output = if cli[1] == "--emit-mir" { mir_module_json(module) } else { mir_emit_c(module) }
            if len(cli) == 4 {
                if module_normalize(cli[2]) == module_normalize(cli[3]) { eprint("[W5002] Output must differ from input") exit(2) }
                write_file(cli[3], output)?
            } else { print(output) }
        }
        return
    }
    if len(cli) != 3 { eprint("[W5002] Usage: Wysna Compiler INPUT OUTPUT") exit(2) }
    let in_path = cli[1]
    let out_path = cli[2]
    if module_normalize(in_path) == module_normalize(out_path) { eprint("[W5002] Output must differ from input") exit(2) }
    let src = read_file(in_path)?
    let checked = check_source(src, in_path)
    let c_code = compile_source(checked)
    write_file(out_path, c_code)?
    print("[Wysna Compiler] Compiled", in_path, "->", out_path)
}

let res = run_compiler() else err {
    eprint("[W4003] Wysna Compiler I/O error:", err.message)
    exit(1)
}
