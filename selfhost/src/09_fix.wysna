# Native `wysna fix`: automated mechanical diagnostic repair with byte-span overlap rejection and atomic writes.

class FixEdit {
    code: str
    description: str
    applicability: str
    start_byte: int
    end_byte: int
    replacement: str

    fn init(code: str, description: str, applicability: str, start_byte: int, end_byte: int, replacement: str) {
        this.code = code
        this.description = description
        this.applicability = applicability
        this.start_byte = start_byte
        this.end_byte = end_byte
        this.replacement = replacement
    }
}

class FixSkipped {
    code: str
    description: str
    reason: str

    fn init(code: str, description: str, reason: str) {
        this.code = code
        this.description = description
        this.reason = reason
    }
}

fn fix_run_check_subprocess(canonical_file: str, candidate_src: str, pass_idx: int) -> str {
    let exe = lsp_self_exe_path()
    let stdlib_root = lsp_stdlib_root_arg()
    let tdir = lsp_tmp_dir()
    let stamp = str(unix_time()) + "_" + str(pass_idx)
    let tmp_src = tdir + "/wysna_fix_src_" + stamp + ".wysna"
    let tmp_diag = tdir + "/wysna_fix_diag_" + stamp + ".json"
    write_file(tmp_src, candidate_src) else _err {
        return ""
    }
    let mut argv: list[str] = []
    if stdlib_root != "" {
        argv.append("--stdlib-root")
        argv.append(stdlib_root)
    }
    argv.append("check")
    argv.append(canonical_file)
    argv.append("--output-format=json-v1")
    argv.append("--diag-out")
    argv.append(tmp_diag)
    argv.append("--overlay")
    argv.append(canonical_file)
    argv.append(tmp_src)
    let exe_buf = lsp_buf_from_str(exe)
    let args_buf = lsp_pack_argv_buf(argv)
    let _rc = wysna_host_process_run(exe_buf, args_buf, 30000)
    wysna_host_close(exe_buf)
    wysna_host_close(args_buf)
    let diag_raw = read_file(tmp_diag) else err { "" }
    lsp_remove_file(tmp_src)
    lsp_remove_file(tmp_diag)
    return diag_raw
}

# fix_extract_json_* helpers live in 01_tool_common.wysna.

fn fix_line_col_from_char(src: str, target_char: int) -> list[int] {
    let mut line = 1
    let mut col = 1
    let limit = if target_char < len(src) { target_char } else { len(src) }
    for i in 0..limit {
        if src[i] == "\n" {
            line = line + 1
            col = 1
        } else {
            col = col + 1
        }
    }
    return [line, col]
}

fn fix_tok_index_at(tokens: list[Token], target_line: int, target_col: int) -> int {
    for i in 0..len(tokens) {
        let t = tokens[i]
        if t.line == target_line and t.col == target_col { return i }
    }
    let mut best = -1
    for i in 0..len(tokens) {
        let t = tokens[i]
        if t.kind == "EOF" { break }
        if t.line < target_line or (t.line == target_line and t.col <= target_col) {
            best = i
        }
    }
    return best
}

fn fix_resolve_mut_root_name(tokens: list[Token], tok_idx: int) -> str {
    if tok_idx < 0 or tok_idx >= len(tokens) { return "" }
    let t = tokens[tok_idx]
    if t.kind == "IDENT" {
        if tok_idx > 0 and tokens[tok_idx - 1].kind == "DOT" {
            let mut p = tok_idx - 2
            while p >= 0 and (tokens[p].kind == "DOT" or tokens[p].kind == "RBRACKET") {
                if tokens[p].kind == "RBRACKET" {
                    let mut bd = 1
                    p = p - 1
                    while p >= 0 and bd > 0 {
                        if tokens[p].kind == "RBRACKET" { bd = bd + 1 }
                        elif tokens[p].kind == "LBRACKET" { bd = bd - 1 }
                        p = p - 1
                    }
                } else {
                    p = p - 1
                }
            }
            if p >= 0 and tokens[p].kind == "IDENT" { return tokens[p].val }
        }
        return t.val
    }
    if (t.kind == "ASSIGN" or t.kind == "PLUS_ASSIGN" or t.kind == "MINUS_ASSIGN" or t.kind == "STAR_ASSIGN") and tok_idx > 0 {
        let mut p = tok_idx - 1
        while p >= 0 {
            if tokens[p].kind == "RBRACKET" {
                let mut bd = 1
                p = p - 1
                while p >= 0 and bd > 0 {
                    if tokens[p].kind == "RBRACKET" { bd = bd + 1 }
                    elif tokens[p].kind == "LBRACKET" { bd = bd - 1 }
                    p = p - 1
                }
            } elif tokens[p].kind == "IDENT" and p > 0 and tokens[p - 1].kind == "DOT" {
                p = p - 2
            } else {
                break
            }
        }
        if p >= 0 and tokens[p].kind == "IDENT" { return tokens[p].val }
    }
    return ""
}

fn fix_is_scalar_wrap_tok(t: Token) -> bool {
    return t.kind == "IDENT" or t.kind == "INT" or t.kind == "FLOAT" or t.kind == "TRUE" or t.kind == "FALSE"
}

fn fix_raw_token_span(src: str, tok: Token) -> list[int] {
    let off0 = diag_char_offset_at(src, tok.line, tok.col)
    if off0 < 0 or off0 >= len(src) { return [-1, -1] }
    let mut off1 = off0
    let mut saw_dot = false
    while off1 < len(src) {
        let ch = src[off1]
        let c = ord(ch)
        if is_alnum(c) {
            off1 = off1 + 1
        } elif tok.kind == "FLOAT" and ch == "." and not saw_dot and off1 + 1 < len(src) and is_digit(ord(src[off1 + 1])) {
            saw_dot = true
            off1 = off1 + 1
        } else {
            break
        }
    }
    if off1 <= off0 { return [-1, -1] }
    return [off0, off1]
}

fn fix_extract_expected_found(msg: str) -> list[str] {
    let empty: list[str] = []
    let p1 = "expected '"
    let p2 = "', found '"
    let n = len(msg)
    let l1 = len(p1)
    let l2 = len(p2)
    let mut i = 0
    while i + l1 <= n {
        if slice(msg, i, i + l1) == p1 {
            let e0 = i + l1
            let mut e1 = e0
            while e1 < n and msg[e1] != "'" { e1 = e1 + 1 }
            if e1 + l2 <= n and slice(msg, e1, e1 + l2) == p2 {
                let f0 = e1 + l2
                let mut f1 = f0
                while f1 < n and msg[f1] != "'" { f1 = f1 + 1 }
                if f1 < n and e1 > e0 and f1 > f0 {
                    return [slice(msg, e0, e1), slice(msg, f0, f1)]
                }
            }
        }
        i = i + 1
    }
    return empty
}

fn fix_propagation_requirement(expected: str, found: str) -> str {
    if found == expected + "?" { return "an optional return type" }
    let prefix = expected + " ! "
    if len(found) > len(prefix) and slice(found, 0, len(prefix)) == prefix {
        return "a result return type that accepts " + slice(found, len(prefix), len(found))
    }
    return ""
}

fn fix_mismatch_data_json(msg: str) -> str {
    let types = fix_extract_expected_found(msg)
    if len(types) != 2 { return "{}" }
    let base = "{\"kind\":\"type_mismatch\",\"expected\":" + diag_json_quote(types[0]) + ",\"found\":" + diag_json_quote(types[1])
    let requirement = fix_propagation_requirement(types[0], types[1])
    if requirement == "" { return base + "}" }
    let help = "'?' can return early and requires " + requirement + " on the enclosing function. Use 'else' for a local fallback."
    return base + ",\"unwrap_hint\":\"?\",\"help\":" + diag_json_quote(help) + "}"
}

fn fix_postfix_end_token(tokens: list[Token], start_idx: int) -> int {
    if start_idx < 0 or start_idx >= len(tokens) { return -1 }
    let first_kind = tokens[start_idx].kind
    if first_kind != "IDENT" and first_kind != "THIS" and first_kind != "SUPER" { return -1 }
    let mut end_idx = start_idx
    let mut j = start_idx + 1
    let n = len(tokens)
    while j < n {
        let tk = tokens[j].kind
        if tk == "DOT" and j + 1 < n and (tokens[j + 1].kind == "IDENT" or tokens[j + 1].kind == "INT") {
            end_idx = j + 1
            j = j + 2
        } elif tk == "LPAREN" or tk == "LBRACKET" {
            let open_k = tk
            let close_k = if tk == "LPAREN" { "RPAREN" } else { "RBRACKET" }
            let mut depth = 1
            let mut p = j + 1
            while p < n and depth > 0 {
                if tokens[p].kind == open_k { depth = depth + 1 }
                elif tokens[p].kind == close_k { depth = depth - 1 }
                p = p + 1
            }
            if depth != 0 { return -1 }
            end_idx = p - 1
            j = p
        } else {
            break
        }
    }
    if j < n and tokens[j].kind == "QUESTION" { return -1 }
    return end_idx
}

fn fix_token_end_char(src: str, tok: Token) -> int {
    if tok.kind == "RPAREN" or tok.kind == "RBRACKET" {
        let off = diag_char_offset_at(src, tok.line, tok.col)
        if off < 0 or off >= len(src) { return -1 }
        return off + 1
    }
    let span = fix_raw_token_span(src, tok)
    return span[1]
}

fn fix_plan_w2001(src: str, tokens: list[Token], start_byte: int, msg: str) -> list[FixEdit] {
    let mut out: list[FixEdit] = []
    if proj_str_contains_substr(msg, "binary operand types:") {
        let is_str_scalar = proj_str_contains_substr(msg, "expected 'str', found 'int'") or proj_str_contains_substr(msg, "expected 'str', found 'float'") or proj_str_contains_substr(msg, "expected 'str', found 'bool'")
        let is_scalar_str = proj_str_contains_substr(msg, "expected 'int', found 'str'") or proj_str_contains_substr(msg, "expected 'float', found 'str'") or proj_str_contains_substr(msg, "expected 'bool', found 'str'")
        if not is_str_scalar and not is_scalar_str { return out }
        let start_char = lsp_char_offset_from_utf8_byte(src, start_byte)
        let lc = fix_line_col_from_char(src, start_char)
        let tok_idx = fix_tok_index_at(tokens, lc[0], lc[1])
        if tok_idx < 0 or tok_idx >= len(tokens) { return out }
        let mut wrap_idx = -1
        if is_str_scalar and tok_idx >= 1 and tokens[tok_idx - 1].kind == "PLUS" and fix_is_scalar_wrap_tok(tokens[tok_idx]) {
            let nxt_kind = if tok_idx + 1 < len(tokens) { tokens[tok_idx + 1].kind } else { "EOF" }
            if nxt_kind != "LPAREN" and nxt_kind != "DOT" and nxt_kind != "LBRACKET" {
                wrap_idx = tok_idx
            }
        } elif is_scalar_str and tok_idx >= 2 and tokens[tok_idx - 1].kind == "PLUS" and fix_is_scalar_wrap_tok(tokens[tok_idx - 2]) {
            let prev_kind = if tok_idx >= 3 { tokens[tok_idx - 3].kind } else { "EOF" }
            if prev_kind != "DOT" and prev_kind != "RBRACKET" and prev_kind != "RPAREN" {
                wrap_idx = tok_idx - 2
            }
        }
        if wrap_idx < 0 { return out }
        let wtok = tokens[wrap_idx]
        let span = fix_raw_token_span(src, wtok)
        if span[0] < 0 { return out }
        let orig = slice(src, span[0], span[1])
        let b0 = diag_utf8_byte_at(src, span[0])
        let b1 = diag_utf8_byte_at(src, span[1])
        out.append(FixEdit("W2001", "wrap '" + orig + "' in str(...)", "machine", b0, b1, "str(" + orig + ")"))
        return out
    }
    let ef = fix_extract_expected_found(msg)
    if len(ef) != 2 { return out }
    let exp = ef[0]
    let fnd = ef[1]
    if fix_propagation_requirement(exp, fnd) == "" { return out }
    let start_char = lsp_char_offset_from_utf8_byte(src, start_byte)
    let lc = fix_line_col_from_char(src, start_char)
    let tok_idx = fix_tok_index_at(tokens, lc[0], lc[1])
    let end_idx = fix_postfix_end_token(tokens, tok_idx)
    if end_idx < 0 { return out }
    let c0 = diag_char_offset_at(src, tokens[tok_idx].line, tokens[tok_idx].col)
    let c1 = fix_token_end_char(src, tokens[end_idx])
    if c0 < 0 or c1 <= c0 or c1 > len(src) { return out }
    let orig = slice(src, c0, c1)
    let b0 = diag_utf8_byte_at(src, c0)
    let b1 = diag_utf8_byte_at(src, c1)
    out.append(FixEdit("W2001", "append '?' to '" + orig + "' to propagate failure by returning early", "maybe", b0, b1, orig + "?"))
    return out
}

fn fix_plan_w3001(src: str, tokens: list[Token], start_byte: int, msg: str) -> list[FixEdit] {
    let mut out: list[FixEdit] = []
    if len(msg) >= 18 and slice(msg, 0, 18) == "captured snapshots" { return out }
    let start_char = lsp_char_offset_from_utf8_byte(src, start_byte)
    let lc = fix_line_col_from_char(src, start_char)
    let tok_idx = fix_tok_index_at(tokens, lc[0], lc[1])
    let var_name = fix_resolve_mut_root_name(tokens, tok_idx)
    if var_name == "" { return out }

    let mut depth = 0
    let mut scope_stack: list[int] = []
    let mut matched_let = -1
    let mut i = 0
    while i < tok_idx and i + 1 < len(tokens) {
        let tk = tokens[i].kind
        if tk == "LBRACE" {
            depth = depth + 1
            scope_stack.append(matched_let)
        } elif tk == "RBRACE" {
            if depth > 0 {
                depth = depth - 1
                if len(scope_stack) > 0 { matched_let = scope_stack.pop() }
            }
        } elif tk == "LET" and tokens[i + 1].kind == "IDENT" and tokens[i + 1].val == var_name {
            matched_let = i
        }
        i = i + 1
    }
    if matched_let < 0 { return out }
    let let_tok = tokens[matched_let]
    let lc_off = diag_char_offset_at(src, let_tok.line, let_tok.col)
    if lc_off < 0 or lc_off + 3 > len(src) { return out }
    if slice(src, lc_off, lc_off + 3) != "let" { return out }
    let b0 = diag_utf8_byte_at(src, lc_off)
    let b1 = diag_utf8_byte_at(src, lc_off + 3)
    out.append(FixEdit("W3001", "mark binding '" + var_name + "' as mutable (`let mut`)", "machine", b0, b1, "let mut"))
    return out
}

fn fix_levenshtein(a: str, b: str) -> int {
    let la = len(a)
    let lb = len(b)
    if la == 0 { return lb }
    if lb == 0 { return la }
    let mut prev: list[int] = []
    for j in 0..lb + 1 { prev.append(j) }
    for i in 1..la + 1 {
        let mut cur: list[int] = [i]
        for j in 1..lb + 1 {
            let cost = if a[i - 1] == b[j - 1] { 0 } else { 1 }
            let del_c = prev[j] + 1
            let ins_c = cur[j - 1] + 1
            let sub_c = prev[j - 1] + cost
            let mut m = del_c
            if ins_c < m { m = ins_c }
            if sub_c < m { m = sub_c }
            cur.append(m)
        }
        prev = cur
    }
    return prev[lb]
}

fn fix_collect_visible_names(tokens: list[Token], err_idx: int, types_only: bool) -> list[str] {
    let mut names: list[str] = []
    if not types_only {
        let mut depth = 0
        let mut i = 0
        let mut cur_fn_params: list[str] = []
        let mut local_names: list[list[str]] = [[]]
        while i < err_idx and i < len(tokens) {
            let tk = tokens[i].kind
            if tk == "LBRACE" {
                depth = depth + 1
                let empty_lvl: list[str] = []
                local_names.append(empty_lvl)
                if depth == 1 and len(cur_fn_params) > 0 {
                    for p in cur_fn_params { local_names[1].append(p) }
                    cur_fn_params = []
                }
            } elif tk == "RBRACE" {
                if depth > 0 {
                    if len(local_names) > 1 { let _popped = local_names.pop() }
                    depth = depth - 1
                }
                if depth == 0 { cur_fn_params = [] }
            } elif depth == 0 and tk == "FN" and i + 1 < len(tokens) and tokens[i + 1].kind == "IDENT" {
                let fname = tokens[i + 1].val
                if not tool_str_contains(names, fname) { names.append(fname) }
                cur_fn_params = []
                let mut p = i + 2
                if p < len(tokens) and tokens[p].kind == "LBRACKET" {
                    let mut bd = 1
                    p = p + 1
                    while p < len(tokens) and bd > 0 {
                        if tokens[p].kind == "LBRACKET" { bd = bd + 1 }
                        elif tokens[p].kind == "RBRACKET" { bd = bd - 1 }
                        p = p + 1
                    }
                }
                if p < len(tokens) and tokens[p].kind == "LPAREN" {
                    p = p + 1
                    let mut pd = 1
                    while p < len(tokens) and pd > 0 {
                        if tokens[p].kind == "LPAREN" { pd = pd + 1 }
                        elif tokens[p].kind == "RPAREN" { pd = pd - 1 }
                        elif pd == 1 and tokens[p].kind == "IDENT" and p + 1 < len(tokens) and tokens[p + 1].kind == "COLON" {
                            cur_fn_params.append(tokens[p].val)
                        }
                        p = p + 1
                    }
                }
            } elif tk == "LET" and i + 1 < len(tokens) {
                let mut npos = i + 1
                if tokens[npos].kind == "MUT" { npos = npos + 1 }
                if npos < len(tokens) and tokens[npos].kind == "IDENT" {
                    local_names[len(local_names) - 1].append(tokens[npos].val)
                }
            } elif tk == "FOR" and i + 1 < len(tokens) and tokens[i + 1].kind == "IDENT" {
                local_names[len(local_names) - 1].append(tokens[i + 1].val)
            }
            i = i + 1
        }
        for lvl in local_names {
            for item in lvl {
                if not tool_str_contains(names, item) { names.append(item) }
            }
        }
    }
    for i in 0..len(tokens) - 1 {
        let tk = tokens[i].kind
        if tk == "STRUCT" or tk == "ENUM" or tk == "CLASS" or tk == "INTERFACE" or (not types_only and tk == "FN") {
            if tokens[i + 1].kind == "IDENT" {
                let v = tokens[i + 1].val
                if not tool_str_contains(names, v) { names.append(v) }
            }
        }
    }
    if types_only {
        for prim in ["int", "float", "bool", "str", "unit", "none"] {
            if not tool_str_contains(names, prim) { names.append(prim) }
        }
    }
    return names
}

fn fix_plan_w1001(src: str, tokens: list[Token], start_byte: int, end_byte: int, msg: str) -> list[FixEdit] {
    let mut out: list[FixEdit] = []
    let mut bad = ""
    let mut types_only = false
    if len(msg) > 20 and slice(msg, 0, 20) == "unknown identifier: " {
        bad = slice(msg, 20, len(msg))
    } elif len(msg) > 14 and slice(msg, 0, 14) == "unknown type: " {
        bad = slice(msg, 14, len(msg))
        types_only = true
    } else {
        return out
    }
    if bad == "" { return out }
    let start_char = lsp_char_offset_from_utf8_byte(src, start_byte)
    let end_char = lsp_char_offset_from_utf8_byte(src, end_byte)
    if start_char < 0 or end_char <= start_char or end_char > len(src) { return out }
    if slice(src, start_char, end_char) != bad { return out }
    let lc = fix_line_col_from_char(src, start_char)
    let err_idx = fix_tok_index_at(tokens, lc[0], lc[1])
    let cands = fix_collect_visible_names(tokens, err_idx, types_only)

    let mut best_name = ""
    let mut best_sim = -1
    let mut tie = false
    for cand in cands {
        if cand == bad { continue }
        let dist = fix_levenshtein(bad, cand)
        if dist <= 0 { continue }
        let mlen = if len(bad) > len(cand) { len(bad) } else { len(cand) }
        let sim = ((mlen - dist) * 1000) / mlen
        if sim > best_sim {
            best_sim = sim
            best_name = cand
            tie = false
        } elif sim == best_sim {
            tie = true
        }
    }
    if tie or best_name == "" or best_sim < 600 { return out }
    let app = if best_sim >= 800 { "machine" } else { "maybe" }
    out.append(FixEdit("W1001", "replace unknown identifier '" + bad + "' with '" + best_name + "'", app, start_byte, end_byte, best_name))
    return out
}

fn fix_plan_w3004(src: str, tokens: list[Token], start_byte: int, end_byte: int, msg: str) -> list[FixEdit] {
    let mut out: list[FixEdit] = []
    if not proj_str_contains_substr(msg, "must be named 'init', found 'fn ") { return out }
    let start_char = lsp_char_offset_from_utf8_byte(src, start_byte)
    let end_char = lsp_char_offset_from_utf8_byte(src, end_byte)
    if start_char < 0 or end_char <= start_char or end_char > len(src) { return out }
    let lc = fix_line_col_from_char(src, start_char)
    let tok_idx = fix_tok_index_at(tokens, lc[0], lc[1])
    if tok_idx < 0 or tok_idx >= len(tokens) or tokens[tok_idx].kind != "IDENT" { return out }
    let orig = slice(src, start_char, end_char)
    out.append(FixEdit("W3004", "rename constructor 'fn " + orig + "' to 'fn init'", "machine", start_byte, end_byte, "init"))
    return out
}

fn fix_is_ident_char(c: int) -> bool {
    return (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or (c >= 48 and c <= 57) or c == 95
}

fn fix_is_digit_char(c: int) -> bool {
    return c >= 48 and c <= 57
}

fn fix_is_hws_char(c: int) -> bool {
    return c == 32 or c == 9
}

fn fix_is_ws_char(c: int) -> bool {
    return c == 32 or c == 9 or c == 13 or c == 10
}

fn fix_binary_left_disallowed(w: str) -> bool {
    return w == "return" or w == "if" or w == "elif" or w == "else" or w == "while" or w == "for" or w == "match" or w == "and" or w == "or" or w == "not" or w == "in" or w == "let" or w == "mut"
}

fn fix_unary_bang_left_kw(w: str) -> bool {
    return w == "if" or w == "elif" or w == "while" or w == "return" or w == "and" or w == "or" or w == "not" or w == "in" or w == "else"
}

fn fix_pad_binary_keyword(src: str, sc: int, ec: int, kw: str) -> str {
    let n = len(src)
    let mut prefix = " "
    if sc == 0 {
        prefix = ""
    } else {
        let pb = ord(src[sc - 1])
        if pb == 32 or pb == 9 or pb == 13 or pb == 10 or pb == 40 or pb == 91 or pb == 44 {
            prefix = ""
        }
    }
    let mut suffix = " "
    if ec >= n {
        suffix = ""
    } else {
        let nb = ord(src[ec])
        if nb == 32 or nb == 9 or nb == 13 or nb == 10 or nb == 41 or nb == 93 or nb == 44 or nb == 59 {
            suffix = ""
        }
    }
    return prefix + kw + suffix
}

fn fix_is_inside_class_body(src: str, target_char: int) -> bool {
    let mut brace_stack: list[bool] = []
    let mut in_string = false
    let mut escaped = false
    let mut in_comment = false
    let mut header_kw = ""
    let mut i = 0
    while i < target_char {
        let c = ord(src[i])
        if in_comment {
            if c == 10 { in_comment = false }
            i = i + 1
            continue
        }
        if in_string {
            if escaped { escaped = false }
            elif c == 92 { escaped = true }
            elif c == 34 { in_string = false }
            i = i + 1
            continue
        }
        if c == 35 {
            in_comment = true
            i = i + 1
            continue
        }
        if c == 34 {
            in_string = true
            i = i + 1
            continue
        }
        if fix_is_ident_char(c) {
            let mut j = i
            while j < target_char and fix_is_ident_char(ord(src[j])) {
                j = j + 1
            }
            let w = slice(src, i, j)
            if header_kw == "" and w != "pub" and w != "public" and w != "private" and w != "async" {
                header_kw = w
            } elif w == "fn" or w == "struct" or w == "enum" or w == "interface" or w == "class" {
                header_kw = w
            }
            i = j
            continue
        }
        if c == 123 {
            brace_stack.append(header_kw == "class")
            header_kw = ""
        } elif c == 125 {
            if len(brace_stack) > 0 { let _popped = brace_stack.pop() }
            header_kw = ""
        } elif c == 59 or c == 61 {
            header_kw = ""
        } elif c == 10 and header_kw != "class" and header_kw != "struct" and header_kw != "enum" and header_kw != "interface" {
            header_kw = ""
        }
        i = i + 1
    }
    return len(brace_stack) > 0 and brace_stack[len(brace_stack) - 1]
}

fn fix_plan_syntax(code: str, src: str, start_byte: int, end_byte: int, msg: str) -> list[FixEdit] {
    let mut out: list[FixEdit] = []
    let sc = lsp_char_offset_from_utf8_byte(src, start_byte)
    let ec = lsp_char_offset_from_utf8_byte(src, end_byte)
    let n = len(src)
    if sc < 0 or sc > n { return out }

    if code == "W0001" and sc + 2 <= n and slice(src, sc, sc + 2) == "&&" {
        let b0 = diag_utf8_byte_at(src, sc)
        let b1 = diag_utf8_byte_at(src, sc + 2)
        out.append(FixEdit("W0001", "replace '&&' with 'and'", "machine", b0, b1, fix_pad_binary_keyword(src, sc, sc + 2, "and")))
        return out
    }

    if code == "W0006" and (proj_str_contains_substr(msg, "expected LBRACE") or proj_str_contains_substr(msg, "expected RPAREN") or proj_str_contains_substr(msg, "Expected '{'") or proj_str_contains_substr(msg, "Expected ')'")) {
        let mut pipe_start = -1
        if sc + 2 <= n and slice(src, sc, sc + 2) == "||" {
            pipe_start = sc
        } elif sc >= 1 and sc + 1 <= n and slice(src, sc - 1, sc + 1) == "||" {
            pipe_start = sc - 1
        } else {
            let mut j = sc
            while j > 0 and fix_is_hws_char(ord(src[j - 1])) {
                j = j - 1
            }
            if j >= 2 and slice(src, j - 2, j) == "||" {
                pipe_start = j - 2
            }
        }
        if pipe_start >= 0 {
            let mut left_end = pipe_start
            while left_end > 0 and fix_is_hws_char(ord(src[left_end - 1])) {
                left_end = left_end - 1
            }
            let mut left_ok = false
            if left_end > 0 {
                let lc = ord(src[left_end - 1])
                if lc == 41 or lc == 93 or lc == 34 or lc == 39 or fix_is_digit_char(lc) {
                    left_ok = true
                } elif fix_is_ident_char(lc) {
                    let mut ws = left_end - 1
                    while ws > 0 and fix_is_ident_char(ord(src[ws - 1])) {
                        ws = ws - 1
                    }
                    let w = slice(src, ws, left_end)
                    left_ok = not fix_binary_left_disallowed(w)
                }
            }
            let mut right_start = pipe_start + 2
            while right_start < n and fix_is_hws_char(ord(src[right_start])) {
                right_start = right_start + 1
            }
            let mut right_ok = right_start < n
            if right_ok {
                let rc = ord(src[right_start])
                if rc == 13 or rc == 10 or rc == 123 or rc == 44 or rc == 41 or rc == 93 {
                    right_ok = false
                } elif right_start + 2 <= n {
                    let r2 = slice(src, right_start, right_start + 2)
                    if r2 == "=>" or r2 == "->" {
                        right_ok = false
                    }
                }
            }
            if left_ok and right_ok {
                let b0 = diag_utf8_byte_at(src, pipe_start)
                let b1 = diag_utf8_byte_at(src, pipe_start + 2)
                out.append(FixEdit("W0006", "replace '||' with 'or'", "machine", b0, b1, fix_pad_binary_keyword(src, pipe_start, pipe_start + 2, "or")))
                return out
            }
        }
    }

    let mut bang_pos = -1
    if (code == "W0001" or code == "W0006") and sc + 1 <= n and src[sc] == "!" {
        if sc + 1 >= n or src[sc + 1] != "=" {
            bang_pos = sc
        }
    } elif code == "W2004" and ec <= n and sc < ec and slice(src, sc, ec) == "return" and proj_str_contains_substr(msg, "found 'unit'") {
        let mut k = ec
        while k < n and fix_is_hws_char(ord(src[k])) {
            k = k + 1
        }
        if k < n and src[k] == "!" and (k + 1 >= n or src[k + 1] != "=") {
            bang_pos = k
        }
    }
    if bang_pos >= 0 {
        let mut left_end = bang_pos
        while left_end > 0 and fix_is_ws_char(ord(src[left_end - 1])) {
            left_end = left_end - 1
        }
        let mut prefix_ok = false
        if left_end == 0 {
            prefix_ok = true
        } else {
            let lc = ord(src[left_end - 1])
            if lc == 40 or lc == 91 or lc == 123 or lc == 44 or lc == 61 or lc == 58 or lc == 59 or lc == 60 or lc == 43 or lc == 45 or lc == 42 or lc == 47 or lc == 37 or lc == 33 {
                prefix_ok = true
            } elif left_end >= 2 and slice(src, left_end - 2, left_end) == "=>" {
                prefix_ok = true
            } elif fix_is_ident_char(lc) {
                let mut ws = left_end - 1
                while ws > 0 and fix_is_ident_char(ord(src[ws - 1])) {
                    ws = ws - 1
                }
                prefix_ok = fix_unary_bang_left_kw(slice(src, ws, left_end))
            }
        }
        if prefix_ok {
            let mut prefix = " "
            if bang_pos == 0 {
                prefix = ""
            } else {
                let pb = ord(src[bang_pos - 1])
                if fix_is_ws_char(pb) or pb == 40 or pb == 91 or pb == 123 or pb == 44 {
                    prefix = ""
                }
            }
            let next_ws = bang_pos + 1 < n and fix_is_hws_char(ord(src[bang_pos + 1]))
            let repl = prefix + (if next_ws { "not" } else { "not " })
            let b0 = diag_utf8_byte_at(src, bang_pos)
            let b1 = diag_utf8_byte_at(src, bang_pos + 1)
            out.append(FixEdit(code, "replace '!' with 'not'", "machine", b0, b1, repl))
            return out
        }
    }

    if code == "W0006" and sc + 3 <= n and slice(src, sc, sc + 3) == "pub" {
        let left_ok = sc == 0 or not fix_is_ident_char(ord(src[sc - 1]))
        let right_ok = sc + 3 >= n or not fix_is_ident_char(ord(src[sc + 3]))
        if left_ok and right_ok and fix_is_inside_class_body(src, sc) {
            let b0 = diag_utf8_byte_at(src, sc)
            let b1 = diag_utf8_byte_at(src, sc + 3)
            out.append(FixEdit("W0006", "replace 'pub' with 'public' inside class", "machine", b0, b1, "public"))
            return out
        }
    }

    return out
}

fn fix_plan_diagnostic(code: str, src: str, tokens: list[Token], start_byte: int, end_byte: int, msg: str) -> list[FixEdit] {
    if code == "W0001" or code == "W0006" or code == "W2004" {
        return fix_plan_syntax(code, src, start_byte, end_byte, msg)
    }
    if code == "W2001" { return fix_plan_w2001(src, tokens, start_byte, msg) }
    if code == "W1001" { return fix_plan_w1001(src, tokens, start_byte, end_byte, msg) }
    if code == "W3001" { return fix_plan_w3001(src, tokens, start_byte, msg) }
    if code == "W3004" { return fix_plan_w3004(src, tokens, start_byte, end_byte, msg) }
    return []
}

fn fix_diagnostic_edits_json(code: str, msg: str, file: str, src: str, line: int, col: int) -> str {
    let is_syntax = code == "W0001" or code == "W0006" or code == "W2004"
    if not is_syntax and code != "W2001" and code != "W1001" and code != "W3001" and code != "W3004" { return "[]" }
    let start_char = diag_char_offset_at(src, line, col)
    let end_char = diag_char_span_width(src, start_char)
    if start_char < 0 or end_char <= start_char { return "[]" }
    let mut fixes: list[FixEdit] = []
    if is_syntax {
        fixes = fix_plan_syntax(code, src, diag_utf8_byte_at(src, start_char), diag_utf8_byte_at(src, end_char), msg)
    } else {
        fixes = fix_plan_diagnostic(code, src, tokenize(src, file), diag_utf8_byte_at(src, start_char), diag_utf8_byte_at(src, end_char), msg)
    }
    if len(fixes) == 0 { return "[]" }
    let source = "{\"source_id\":" + diag_json_quote(file) + ",\"source_sha256\":" + diag_json_quote(diag_sha256_hex(src))
    let mut parts: list[str] = []
    for fix in fixes {
        let edit = source + ",\"start_byte\":" + str(fix.start_byte) + ",\"end_byte\":" + str(fix.end_byte) + ",\"replacement\":" + diag_json_quote(fix.replacement) + "}"
        parts.append("{\"description\":" + diag_json_quote(fix.description) + ",\"applicability\":" + diag_json_quote(fix.applicability) + ",\"edits\":[" + edit + "]}")
    }
    return "[" + join_strings(parts, ",") + "]"
}

fn fix_apply_non_overlapping(src: str, edits: list[FixEdit]) -> str {
    # Sort descending by start_byte
    let mut sorted: list[FixEdit] = []
    for e in edits { sorted.append(e) }
    let n = len(sorted)
    for i in 1..n {
        let key = sorted[i]
        let mut j = i - 1
        while j >= 0 and sorted[j].start_byte < key.start_byte {
            sorted[j + 1] = sorted[j]
            j = j - 1
        }
        sorted[j + 1] = key
    }
    let mut cur = src
    for e in sorted {
        let sc = lsp_char_offset_from_utf8_byte(cur, e.start_byte)
        let ec = lsp_char_offset_from_utf8_byte(cur, e.end_byte)
        if sc >= 0 and ec >= sc and ec <= len(cur) {
            cur = slice(cur, 0, sc) + e.replacement + slice(cur, ec, len(cur))
        }
    }
    return cur
}

fn fix_emit_usage_error(json_mode: bool, msg: str) -> unit {
    if json_mode {
        let diag = diag_record_json("W5002", "usage", "error", msg, "<cli>", 1, 1, "")
        diag_write_output(diag_tool_envelope_json("fix", "usage_error", 2, "[" + diag + "]", "", "", "[]"))
    } else {
        eprint("wysna fix: " + msg)
    }
    exit(2)
}

fn tool_handle_fix(args: list[str], json_mode_in: bool) -> unit {
    let mut json_mode = json_mode_in
    let mut apply = false
    let mut include_maybe = false
    let mut file = ""
    let mut i = 1
    while i < len(args) {
        let a = args[i]
        if a == "--output-format=json-v1" {
            json_mode = true
            i = i + 1
        } elif a == "--output-format" and i + 1 < len(args) {
            if args[i + 1] != "json-v1" { fix_emit_usage_error(json_mode, "unsupported output format: " + args[i + 1]) }
            json_mode = true
            i = i + 2
        } elif a == "--apply" {
            apply = true
            i = i + 1
        } elif a == "--include-maybe" {
            include_maybe = true
            i = i + 1
        } elif len(a) > 0 and a[0] != "-" and file == "" {
            file = a
            i = i + 1
        } else {
            fix_emit_usage_error(json_mode, "unknown or incomplete option for fix: " + a)
        }
    }
    if file == "" { fix_emit_usage_error(json_mode, "fix requires a source file path") }
    let loaded = module_read_text_or_overlay(file)
    if loaded[0] != "1" {
        report_error(file, "W5003", 1, 1, "cannot read input file: " + file)
    }
    let orig_src = loaded[1]
    let before_sha = diag_sha256_hex(orig_src)
    let canonical = module_canonical(file)

    let mut current_src = orig_src
    let mut applied_all: list[FixEdit] = []
    let mut skipped_all: list[FixSkipped] = []
    let mut diag_before_count = 0
    let mut last_raw = fix_run_check_subprocess(canonical, current_src, 0)
    let mut pass_num = 0

    while pass_num < 64 {
        if last_raw == "" { break }
        let parsed = lsp_parse_json(last_raw)
        let d_arr = lsp_json_get(parsed, "diagnostics")
        if pass_num == 0 and d_arr.kind == "array" {
            diag_before_count = len(d_arr.items)
        }
        if lsp_json_str(parsed, "status", "") == "ok" or d_arr.kind != "array" or len(d_arr.items) == 0 {
            break
        }
        let cur_sha = diag_sha256_hex(current_src)
        let mut has_lexer_fatal = false
        let mut need_tokens = false
        for item in d_arr.items {
            let d_code = lsp_json_str(item, "code", "")
            let d_msg = lsp_json_str(item, "message", "")
            if d_code == "W0001" and proj_str_contains_substr(d_msg, "unexpected character") {
                has_lexer_fatal = true
            }
            if d_code == "W2001" or d_code == "W1001" or d_code == "W3001" or d_code == "W3004" {
                need_tokens = true
            }
        }
        let mut tokens: list[Token] = []
        if need_tokens and not has_lexer_fatal {
            tokens = tokenize(current_src, file)
        }
        let mut cands: list[FixEdit] = []
        for item in d_arr.items {
            let code = lsp_json_str(item, "code", "")
            let msg = lsp_json_str(item, "message", "")
            let sp = lsp_json_get(item, "primary_span")
            if sp.kind != "object" { continue }
            let s_sha = lsp_json_str(sp, "source_sha256", "")
            if s_sha != "" and s_sha != cur_sha { continue }
            let sb = lsp_json_int(sp, "start_byte", -1)
            let eb = lsp_json_int(sp, "end_byte", -1)
            if sb < 0 or eb <= sb { continue }
            let gen = fix_plan_diagnostic(code, current_src, tokens, sb, eb, msg)
            for g in gen {
                if g.applicability == "machine" or (include_maybe and g.applicability == "maybe") {
                    cands.append(g)
                }
            }
        }
        if len(cands) == 0 { break }
        let mut chosen_pass: list[FixEdit] = []
        let mut taken_start: list[int] = []
        let mut taken_end: list[int] = []
        for c in cands {
            let mut overlaps = false
            for t in 0..len(taken_start) {
                if c.start_byte < taken_end[t] and taken_start[t] < c.end_byte {
                    overlaps = true
                    break
                }
            }
            if overlaps {
                skipped_all.append(FixSkipped(c.code, c.description, "overlaps another edit"))
            } else {
                taken_start.append(c.start_byte)
                taken_end.append(c.end_byte)
                chosen_pass.append(c)
                applied_all.append(c)
            }
        }
        if len(chosen_pass) == 0 { break }
        let next_src = fix_apply_non_overlapping(current_src, chosen_pass)
        if next_src == current_src { break }
        current_src = next_src
        pass_num = pass_num + 1
        last_raw = fix_run_check_subprocess(canonical, current_src, pass_num)
    }

    let changed = current_src != orig_src
    let mut written = false
    if apply and changed {
        tool_write_atomic_verified(file, before_sha, current_src)
        written = true
    }

    let mut rem_diags_json = "[]"
    let mut still_failing = false
    if last_raw != "" {
        let last_parsed = lsp_parse_json(last_raw)
        let rem_arr = lsp_json_get(last_parsed, "diagnostics")
        if rem_arr.kind == "array" and len(rem_arr.items) > 0 {
            still_failing = true
            rem_diags_json = fix_extract_json_array_field(last_raw, "diagnostics")
        } elif lsp_json_str(last_parsed, "status", "") != "ok" {
            still_failing = true
            rem_diags_json = fix_extract_json_array_field(last_raw, "diagnostics")
        }
    }

    let mut app_parts: list[str] = ["["]
    for idx in 0..len(applied_all) {
        if idx > 0 { app_parts.append(",") }
        app_parts.append("{\"code\":" + diag_json_quote(applied_all[idx].code) + ",\"description\":" + diag_json_quote(applied_all[idx].description) + "}")
    }
    app_parts.append("]")

    let mut skip_parts: list[str] = ["["]
    for idx in 0..len(skipped_all) {
        if idx > 0 { skip_parts.append(",") }
        skip_parts.append("{\"code\":" + diag_json_quote(skipped_all[idx].code) + ",\"description\":" + diag_json_quote(skipped_all[idx].description) + ",\"reason\":" + diag_json_quote(skipped_all[idx].reason) + "}")
    }
    skip_parts.append("]")

    let mut res_parts: list[str] = ["{"]
    res_parts.append("\"applied\":" + join_strings(app_parts, ""))
    res_parts.append(",\"skipped\":" + join_strings(skip_parts, ""))
    res_parts.append(",\"changed\":" + (if changed { "true" } else { "false" }))
    res_parts.append(",\"written\":" + (if written { "true" } else { "false" }))
    res_parts.append(",\"remaining_diagnostics\":" + rem_diags_json)
    res_parts.append(",\"diagnostics_before\":" + str(diag_before_count))
    if not apply {
        res_parts.append(",\"fixed_source\":" + diag_json_quote(current_src))
    }
    res_parts.append("}")
    let result_json = join_strings(res_parts, "")

    if json_mode {
        let status_str = if still_failing { "diagnostic_error" } else { "ok" }
        let exit_c = if still_failing { 1 } else { 0 }
        diag_write_output(diag_tool_envelope_json("fix", status_str, exit_c, rem_diags_json, "result", result_json, "[]"))
    } else {
        let verb = if apply { "Applied" } else { "Would apply" }
        for item in applied_all {
            print(verb + ": [" + item.code + "] " + item.description)
        }
        if len(applied_all) == 0 {
            print("No machine-applicable fixes.")
        }
        if still_failing {
            eprint("Diagnostics remain; run 'wysna check'.")
        }
    }
    if still_failing { exit(1) }
    exit(0)
}
