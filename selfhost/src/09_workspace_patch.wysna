# Checked multi-file workspace patch planning, atomic commit, and rollback for native SDK.

fn wpatch_valid_rel_wysna(name: str) -> bool {
    if name == "" or name[0] == "/" or name[len(name) - 1] == "/" { return false }
    if len(name) <= 6 or not proj_str_ends_with(name, ".wysna") { return false }
    for i in 0..len(name) {
        if name[i] == "\\" { return false }
    }
    let mut seg = ""
    for i in 0..len(name) + 1 {
        if i == len(name) or name[i] == "/" {
            if seg == "" or seg == "." or seg == ".." { return false }
            seg = ""
        } else {
            seg = seg + name[i]
        }
    }
    return true
}

fn wpatch_unified_diff_kind(rel_path: str, action: str, old_text: str, new_text: str) -> str {
    if action == "modify" and old_text == new_text { return "" }
    let empty_lines: list[str] = []
    let old_lines = if action == "create" { empty_lines } else { schema_split_lines(old_text) }
    let new_lines = if action == "delete" { empty_lines } else { schema_split_lines(new_text) }
    let mut prefix = 0
    while prefix < len(old_lines) and prefix < len(new_lines) and old_lines[prefix] == new_lines[prefix] {
        prefix = prefix + 1
    }
    let mut old_end = len(old_lines)
    let mut new_end = len(new_lines)
    while old_end > prefix and new_end > prefix and old_lines[old_end - 1] == new_lines[new_end - 1] {
        old_end = old_end - 1
        new_end = new_end - 1
    }
    let old_count = old_end - prefix
    let new_count = new_end - prefix
    let old_start = if old_count == 0 { prefix } else { prefix + 1 }
    let new_start = if new_count == 0 { prefix } else { prefix + 1 }
    let from_h = if action == "create" { "--- /dev/null\n" } else { "--- a/" + rel_path + "\n" }
    let to_h = if action == "delete" { "+++ /dev/null\n" } else { "+++ b/" + rel_path + "\n" }
    let mut parts: list[str] = [
        from_h,
        to_h,
        "@@ -" + str(old_start) + "," + str(old_count) + " +" + str(new_start) + "," + str(new_count) + " @@\n",
    ]
    for i in prefix..old_end { parts.append("-" + old_lines[i] + "\n") }
    for i in prefix..new_end { parts.append("+" + new_lines[i] + "\n") }
    return join_strings(parts, "")
}

fn wpatch_no_symlink_ancestors(root: str, rel: str) -> bool {
    let mut cur = root
    let mut seg = ""
    for i in 0..len(rel) + 1 {
        if i == len(rel) or rel[i] == "/" {
            if seg != "" {
                cur = cur + "/" + seg
                if proj_path_exists(cur) and module_canonical_resolved(cur) != cur {
                    return false
                }
                seg = ""
            }
        } else {
            seg = seg + rel[i]
        }
    }
    return true
}

fn wpatch_ensure_parents(root: str, rel: str) -> bool {
    let mut cur = root
    let mut seg = ""
    for i in 0..len(rel) {
        if rel[i] == "/" {
            if seg != "" {
                cur = cur + "/" + seg
                if not proj_is_dir(cur) {
                    if proj_path_exists(cur) { return false }
                    if proj_scaffold_fs(cur, 2) != 0 { return false }
                }
                seg = ""
            }
        } else {
            seg = seg + rel[i]
        }
    }
    return true
}

fn wpatch_find_nth_match(hay: str, needle: str) -> list[int] {
    if needle == "" or len(needle) > len(hay) { return [0, -1] }
    let mut count = 0
    let mut first_idx = -1
    let limit = len(hay) - len(needle) + 1
    let mut i = 0
    while i < limit {
        if slice(hay, i, i + len(needle)) == needle {
            count = count + 1
            if first_idx < 0 { first_idx = i }
            i = i + len(needle)
        } else {
            i = i + 1
        }
    }
    return [count, first_idx]
}

fn wpatch_apply_hunks(rel: str, before_src: str, hunks_val: LspJson, json_mode: bool) -> str {
    if hunks_val.kind != "array" or len(hunks_val.items) == 0 {
        proj_emit_error_and_exit("patch", json_mode, "W5002", "Workspace edit 'hunks' must be a non-empty array: " + rel)
    }
    let mut cur = before_src
    for h_idx in 0..len(hunks_val.items) {
        let h = hunks_val.items[h_idx]
        if h.kind != "object" or len(h.keys) != 2 or not lsp_json_has(h, "old_text") or not lsp_json_has(h, "new_text") {
            proj_emit_error_and_exit("patch", json_mode, "W5002", "Hunk requires old_text and new_text: " + rel)
        }
        let ov = lsp_json_get(h, "old_text")
        let nv = lsp_json_get(h, "new_text")
        if ov.kind != "str" or nv.kind != "str" or ov.str_val == "" {
            proj_emit_error_and_exit("patch", json_mode, "W5002", "Hunk requires non-empty old_text and string new_text: " + rel)
        }
        let hit = wpatch_find_nth_match(cur, ov.str_val)
        if hit[0] != 1 {
            proj_emit_error_and_exit("patch", json_mode, "W5002", "Hunk matched " + str(hit[0]) + " times in '" + rel + "' (expected 1)")
        }
        let pos = hit[1]
        cur = slice(cur, 0, pos) + nv.str_val + slice(cur, pos + len(ov.str_val), len(cur))
    }
    return cur
}

fn wpatch_apply_symbol_edit(abs_p: str, before_src: str, sym_name: str, replacement: str, json_mode: bool) -> str {
    if sym_name == "" {
        proj_emit_error_and_exit("patch", json_mode, "W5002", "Workspace symbol edit requires non-empty symbol")
    }
    let graph = tool_build_graph(before_src, abs_p)
    let n_idx = tool_require_symbol(graph, sym_name, "patch", json_mode)
    let n = graph.nodes[n_idx]
    if module_canonical(n.file) != module_canonical(abs_p) {
        proj_emit_error_and_exit("patch", json_mode, "W5002", "Target symbol belongs to another file: " + sym_name)
    }
    let orig_bytes = bytes(before_src)
    if n.start_byte < 0 or n.end_byte < n.start_byte or n.end_byte > len(orig_bytes) {
        proj_emit_error_and_exit("patch", json_mode, "W5004", "Invalid symbol byte range for patch: " + sym_name)
    }
    let mut prefix_b: list[int] = []
    for i in 0..n.start_byte { prefix_b.append(orig_bytes[i]) }
    let mut suffix_b: list[int] = []
    for i in n.end_byte..len(orig_bytes) { suffix_b.append(orig_bytes[i]) }
    return wpatch_utf8_bytes_to_str(prefix_b) + replacement + wpatch_utf8_bytes_to_str(suffix_b)
}

fn wpatch_utf8_bytes_to_str(bs: list[int]) -> str {
    let mut parts: list[str] = []
    let mut i = 0
    while i < len(bs) {
        let first = bs[i]
        let width = if first < 128 { 1 } elif first < 224 { 2 } elif first < 240 { 3 } else { 4 }
        let mut cp = if width == 1 { first } elif width == 2 { first % 32 } elif width == 3 { first % 16 } else { first % 8 }
        for off in 1..width {
            if i + off < len(bs) { cp = cp * 64 + (bs[i + off] % 64) }
        }
        parts.append(chr(cp))
        i = i + width
    }
    return join_strings(parts, "")
}

fn wpatch_live_revision(state: ProjectLockState, m: ProjectManifest, sdk_sha: str) -> str {
    let lock_path = m.root + "/wysna.lock"
    let lock_sha = if proj_test_exists(state, lock_path) { proj_lock_host_text(state, lock_path, "hash") } else { "" }
    let ws_sha = proj_workspace_sha256(state, m.root)
    let live_manifest_sha = proj_lock_host_text(state, m.path, "hash")
    let parts = proj_workspace_revision_parts(live_manifest_sha, lock_sha, sdk_sha, ws_sha)
    return parts[1]
}

fn wpatch_remove(path: str) -> bool {
    let first = tool_buf_from_str(path)
    let second = tool_buf_from_str("")
    let result = wysna_host_fs(first, second, 3)
    wysna_host_close(first)
    wysna_host_close(second)
    return result == 0
}

fn wpatch_unlink_all(paths: list[str]) -> unit {
    for path in paths {
        if path != "" { let _removed = wpatch_remove(path) }
    }
}

fn wpatch_matches(path: str, expected_sha: str) -> bool {
    if module_canonical_resolved(path) != path { return false }
    let text = read_file(path) else err { return false }
    return diag_sha256_hex(text) == expected_sha
}

fn wpatch_stage_temp_file(target_abs: str, stamp: str, idx: int, content: str, mode_from: str) -> str {
    let empty_buf = tool_buf_from_str("")
    let mut tmp_path = ""
    let mut fh = empty_buf
    let mut opened = false
    for attempt in 0..32 {
        let candidate = target_abs + ".wysna_tmp_" + stamp + "_" + str(idx) + "_" + str(attempt)
        let c_buf = tool_buf_from_str(candidate)
        let handle = wysna_host_file_open(c_buf, if mode_from == "" { 3 } else { 4 })
        wysna_host_close(c_buf)
        if wysna_host_is_open(handle) == 1 {
            tmp_path = candidate
            fh = handle
            opened = true
            break
        }
    }
    wysna_host_close(empty_buf)
    if not opened { return "" }
    let data_buf = tool_buf_from_str(content)
    let wr = wysna_host_file_write(fh, data_buf)
    let cl = wysna_host_close(fh)
    wysna_host_close(data_buf)
    if wr != 0 or cl != 0 {
        wpatch_unlink_all([tmp_path])
        return ""
    }
    if mode_from != "" {
        let original = tool_buf_from_str(mode_from)
        let staged = tool_buf_from_str(tmp_path)
        let matched = wysna_host_fs(original, staged, 7)
        wysna_host_close(original)
        wysna_host_close(staged)
        if matched != 0 { wpatch_unlink_all([tmp_path]); return "" }
    }
    return tmp_path
}

fn wpatch_rename_file(src_path: str, dst_path: str) -> bool {
    let s_buf = tool_buf_from_str(src_path)
    let d_buf = tool_buf_from_str(dst_path)
    let mv = wysna_host_fs(s_buf, d_buf, 4)
    wysna_host_close(s_buf)
    wysna_host_close(d_buf)
    return mv >= 0
}

extern "C" fn wysna_host_monotonic_ms() -> int

fn wpatch_test_paths(state: ProjectLockState, root: str) -> list[str] {
    let mut paths = proj_snapshot_paths(state, root, "", false, true)
    if proj_test_exists(state, root + "/wysna.lock") { paths.append("wysna.lock") }
    return tool_sort_strings(paths)
}

fn wpatch_test_inputs_sha(state: ProjectLockState, root: str, paths: list[str]) -> str {
    let mut rows: list[str] = []
    for path in paths {
        let absolute = root + "/" + path
        if module_canonical_resolved(absolute) != absolute {
            state.fail("W5005", "Workspace test input changed during staging: " + path)
        }
        let digest = proj_lock_host_text(state, absolute, "hash")
        rows.append("[" + diag_json_quote(path) + "," + diag_json_quote(digest) + "]")
    }
    return diag_sha256_hex("[" + join_strings(rows, ",") + "]")
}

fn wpatch_copy_test_input(source: str, destination: str) -> bool {
    if module_canonical_resolved(source) != source { return false }
    let source_buf = tool_buf_from_str(source)
    let destination_buf = tool_buf_from_str(destination)
    let input = wysna_host_file_open(source_buf, 0)
    let output = wysna_host_file_open(destination_buf, 3)
    wysna_host_close(source_buf)
    wysna_host_close(destination_buf)
    let chunk = wysna_host_buffer_new()
    let mut ok = wysna_host_is_open(input) == 1 and wysna_host_is_open(output) == 1
    while ok {
        let count = wysna_host_file_read(input, chunk, 1048576)
        if count == 0 { break }
        ok = count > 0 and wysna_host_file_write(output, chunk) == 0
    }
    wysna_host_close(chunk)
    let closed_input = wysna_host_close(input)
    let closed_output = wysna_host_close(output)
    return ok and closed_input == 0 and closed_output == 0
}

struct PatchTestVerification { code: int, evidence: str, timings: str }

fn wpatch_verify_candidate_tests(state: ProjectLockState, m: ProjectManifest, paths: list[str], inputs_sha: str,
                                  edit_rels: list[str], edit_actions: list[str], edit_after: list[str],
                                  sdk_sha: str, revision: str, plan_hash: str, discover: bool, frozen: bool,
                                  expected_count: int) -> PatchTestVerification {
    let staging_started = wysna_host_monotonic_ms()
    let driver = env("WYSNA_SDK_DRIVER") else { "" }
    let stage_env = env("WYSNA_PATCH_TEST_STAGE") else { "" }
    let staging = if stage_env == "" { "" } else { module_canonical_resolved(stage_env) }
    if driver == "" or staging == "" {
        state.fail("W5002", "Tested patches require the wysna native SDK driver")
    }
    let candidate = staging + "/candidate"
    if proj_path_exists(candidate) or not wpatch_ensure_parents(staging, "candidate/file") {
        state.fail("W5004", "Cannot create a private patch test workspace")
    }
    for path in paths {
        if not wpatch_ensure_parents(candidate, path) or not wpatch_copy_test_input(m.root + "/" + path, candidate + "/" + path) {
            state.fail("W5004", "Cannot stage workspace test input: " + path)
        }
    }
    if wpatch_test_inputs_sha(state, candidate, paths) != inputs_sha {
        state.fail("W5005", "Workspace test snapshot changed during staging")
    }
    for index in 0..len(edit_rels) {
        let relative = edit_rels[index]
        let path = candidate + "/" + relative
        if edit_actions[index] != "create" and not wpatch_remove(path) {
            state.fail("W5004", "Cannot remove staged source: " + relative)
        }
        if edit_actions[index] != "delete" and
           (not wpatch_ensure_parents(candidate, relative) or not proj_scaffold_write(path, edit_after[index])[1]) {
            state.fail("W5004", "Cannot stage candidate source: " + relative)
        }
    }
    let candidate_manifest = candidate + "/" + tool_basename(m.path)
    let staged_manifest = proj_load_manifest(candidate_manifest)
    if not staged_manifest.ok { state.fail(staged_manifest.err_code, staged_manifest.err_msg) }
    if wpatch_live_revision(state, staged_manifest, sdk_sha) != revision {
        state.fail("W5005", "Staged workspace differs from the checked patch")
    }

    let report_path = staging + "/test-result.json"
    let mut argv: list[str] = ["project", "test", "--manifest", candidate_manifest, "--output-format=json-v1", "--diag-out", report_path]
    if discover { argv.append("--discover") }
    if frozen { argv.append("--frozen") }
    let exe_buf = lsp_buf_from_str(driver)
    let args_buf = lsp_pack_argv_buf(argv)
    let test_started = wysna_host_monotonic_ms()
    let rc = wysna_host_process_run(exe_buf, args_buf, 600000)
    let test_ms = wysna_host_monotonic_ms() - test_started
    wysna_host_close(exe_buf)
    wysna_host_close(args_buf)
    let raw = read_file(report_path) else err { "" }
    let envelope = mcp_parse_json_strict(raw)
    let report = lsp_json_get(envelope, "result")
    let status = lsp_json_str(report, "status", "")
    let case_reports = lsp_json_get(report, "cases")
    if lsp_json_str(report, "workspace_revision", "") != revision or case_reports.kind != "array" or
       lsp_json_int(report, "selected", -1) != expected_count {
        state.fail("W5001", "Project tests did not return a report for the checked candidate")
    }
    if not ((rc == 0 and status == "passed" and len(case_reports.items) == expected_count and expected_count > 0) or
            (rc == 1 and status == "failed") or (rc == 2 and status == "empty") or (rc == 130 and status == "cancelled")) {
        state.fail("W5001", "Project test runner did not complete verification")
    }
    if wpatch_live_revision(state, staged_manifest, sdk_sha) != revision {
        state.fail("W5005", "Tests changed the staged source revision")
    }

    let mut rows: list[str] = []
    let mut timings: list[str] = []
    let fields: list[str] = ["id", "status", "failure_kind", "exit_code", "duration_ms", "stdout_sha256", "stderr_sha256"]
    for record in case_reports.items {
        timings.append("{\"id\":" + diag_json_quote(lsp_json_str(record, "id", "")) +
            ",\"compile_ms\":" + str(lsp_json_int(record, "compile_ms", 0)) +
            ",\"run_ms\":" + str(lsp_json_int(record, "run_ms", 0)) + "}")
        let mut parts: list[str] = []
        for field in fields {
            parts.append(diag_json_quote(field) + ":" + mcp_serialize_json_val(lsp_json_get(record, field)))
        }
        if lsp_json_str(record, "status", "") != "passed" {
            let stderr = lsp_json_str(record, "stderr", "")
            let excerpt = if len(stderr) > 2048 { slice(stderr, 0, 2048) } else { stderr }
            parts.append("\"stderr\":" + diag_json_quote(excerpt))
        }
        rows.append("{" + join_strings(parts, ",") + "}")
    }
    let evidence = "{\"plan_hash\":" + diag_json_quote(plan_hash) + ",\"workspace_revision\":" + diag_json_quote(revision) +
        ",\"test_plan_hash\":" + diag_json_quote(lsp_json_str(report, "plan_hash", "")) +
        ",\"status\":" + diag_json_quote(status) + ",\"cases\":[" + join_strings(rows, ",") + "]}"
    let timing_json = "{\"staging\":" + str(test_started - staging_started) + ",\"test_runner\":" + str(test_ms) +
        ",\"cases\":[" + join_strings(timings, ",") + "]}"
    return PatchTestVerification { code: rc, evidence: evidence, timings: timing_json }
}

fn proj_handle_workspace_patch(manifest_arg: str, edits_file: str, expected_hash: str, apply: bool, discover: bool, frozen: bool, test: bool, json_mode: bool) -> unit {
    if apply and expected_hash == "" {
        proj_emit_error_and_exit("patch", json_mode, "W5002", "Applying workspace edits requires --expect-plan-hash from a successful preview")
    }
    let m = proj_load_manifest(manifest_arg)
    if not m.ok {
        proj_emit_error_and_exit("patch", json_mode, m.err_code, m.err_msg)
    }
    if frozen { proj_verify_lock(m, "patch", json_mode) }

    let state = ProjectLockState("patch", json_mode, m.root)
    let snap_paths = tool_sort_strings(proj_snapshot_paths(state, m.root, "", true, true))
    proj_lock_verify_collisions(state, snap_paths)
    let mut snap_hashes: list[str] = []
    for p in snap_paths {
        snap_hashes.append(proj_lock_host_text(state, m.root + "/" + p, "hash"))
    }
    let sdk_sha = proj_sdk_fingerprint(state)
    let test_plan = proj_test_plan(m, discover, "", false, "", json_mode)
    let live_start = wpatch_live_revision(state, m, sdk_sha)
    if test_plan.revision != live_start {
        proj_emit_error_and_exit("patch", json_mode, "W5005", "Workspace changed during edit planning")
    }

    let raw_edits = read_file(edits_file) else err {
        proj_emit_error_and_exit("patch", json_mode, "W5003", "cannot read --edits file: " + edits_file)
        ""
    }
    let parsed_edits = mcp_parse_json_strict(raw_edits)
    if parsed_edits.kind != "array" or len(parsed_edits.items) == 0 {
        proj_emit_error_and_exit("patch", json_mode, "W5002", "Workspace edits must be a nonempty array")
    }

    let mut protected_rels: list[str] = []
    for t in m.targets {
        if not tool_str_contains(protected_rels, t.entry) { protected_rels.append(t.entry) }
    }
    for tc in test_plan.cases {
        if not tool_str_contains(protected_rels, tc.entry) { protected_rels.append(tc.entry) }
    }

    let mut seen_rel: list[str] = []
    let mut edit_actions: list[str] = []
    let mut edit_rels: list[str] = []
    let mut edit_abs: list[str] = []
    let mut edit_canon: list[str] = []
    let mut edit_before: list[str] = []
    let mut edit_after: list[str] = []
    let mut edit_before_sha: list[str] = []
    let mut edit_after_sha: list[str] = []

    for item in parsed_edits.items {
        if item.kind != "object" or not lsp_json_has(item, "path") {
            proj_emit_error_and_exit("patch", json_mode, "W5002", "Each workspace edit requires path")
        }
        let pv = lsp_json_get(item, "path")
        if pv.kind != "str" {
            proj_emit_error_and_exit("patch", json_mode, "W5002", "Workspace edit path must be a string")
        }
        let rel = pv.str_val
        if not wpatch_valid_rel_wysna(rel) or tool_str_contains(seen_rel, rel) {
            proj_emit_error_and_exit("patch", json_mode, "W5002", "Workspace edit must use a unique relative .wysna path: " + rel)
        }
        seen_rel.append(rel)
        let abs_p = m.root + "/" + rel

        let has_create = lsp_json_has(item, "create")
        let has_delete = lsp_json_has(item, "delete")
        let has_src = lsp_json_has(item, "source")
        let has_sym = lsp_json_has(item, "symbol")
        let has_rep = lsp_json_has(item, "replacement")
        let has_hunks = lsp_json_has(item, "hunks")

        let mut snap_idx = -1
        for k in 0..len(snap_paths) {
            if snap_paths[k] == rel { snap_idx = k break }
        }

        if len(item.keys) == 3 and has_create and has_src {
            let cv = lsp_json_get(item, "create")
            let sv = lsp_json_get(item, "source")
            if cv.kind != "bool" or not cv.bool_val or sv.kind != "str" {
                proj_emit_error_and_exit("patch", json_mode, "W5002", "Create workspace edit requires create=true and string source")
            }
            if snap_idx >= 0 or proj_path_exists(abs_p) or not wpatch_no_symlink_ancestors(m.root, rel) {
                proj_emit_error_and_exit("patch", json_mode, "W5002", "Cannot create existing or symlinked workspace path: " + rel)
            }
            edit_actions.append("create")
            edit_rels.append(rel)
            edit_abs.append(abs_p)
            edit_canon.append(module_normalize(abs_p))
            edit_before.append("")
            edit_after.append(sv.str_val)
            edit_before_sha.append("")
            edit_after_sha.append(diag_sha256_hex(sv.str_val))
            continue
        }

        if len(item.keys) == 2 and has_delete {
            let dv = lsp_json_get(item, "delete")
            if dv.kind != "bool" or not dv.bool_val {
                proj_emit_error_and_exit("patch", json_mode, "W5002", "Delete workspace edit requires delete=true")
            }
            if snap_idx < 0 or module_canonical_resolved(abs_p) != abs_p {
                proj_emit_error_and_exit("patch", json_mode, "W5002", "Delete workspace edit must reference one existing project source: " + rel)
            }
            if tool_str_contains(protected_rels, rel) {
                proj_emit_error_and_exit("patch", json_mode, "W5002", "Cannot delete protected manifest entry: " + rel)
            }
            let before_src = read_file(abs_p) else err {
                proj_emit_error_and_exit("patch", json_mode, "W5003", "cannot read workspace source: " + abs_p)
                ""
            }
            let b_sha = diag_sha256_hex(before_src)
            if b_sha != snap_hashes[snap_idx] {
                proj_emit_error_and_exit("patch", json_mode, "W5005", "Source changed during workspace planning: " + rel)
            }
            edit_actions.append("delete")
            edit_rels.append(rel)
            edit_abs.append(abs_p)
            edit_canon.append(module_canonical(abs_p))
            edit_before.append(before_src)
            edit_after.append("__WYSNA_OVERLAY_DELETED__")
            edit_before_sha.append(b_sha)
            edit_after_sha.append("")
            continue
        }

        if snap_idx < 0 or module_canonical_resolved(abs_p) != abs_p {
            proj_emit_error_and_exit("patch", json_mode, "W5002", "Workspace edit must identify one existing project source: " + rel)
        }
        let before_src = read_file(abs_p) else err {
            proj_emit_error_and_exit("patch", json_mode, "W5003", "cannot read workspace source: " + abs_p)
            ""
        }
        let b_sha = diag_sha256_hex(before_src)
        if b_sha != snap_hashes[snap_idx] {
            proj_emit_error_and_exit("patch", json_mode, "W5005", "Source changed during workspace planning: " + rel)
        }

        let mut after_src = ""
        if len(item.keys) == 2 and has_src {
            let sv = lsp_json_get(item, "source")
            if sv.kind != "str" {
                proj_emit_error_and_exit("patch", json_mode, "W5002", "Workspace edit path and source must be strings")
            }
            after_src = sv.str_val
        } elif len(item.keys) == 3 and has_sym and has_rep {
            let sym_v = lsp_json_get(item, "symbol")
            let rep_v = lsp_json_get(item, "replacement")
            if sym_v.kind != "str" or rep_v.kind != "str" {
                proj_emit_error_and_exit("patch", json_mode, "W5002", "Workspace symbol edit requires string symbol and replacement")
            }
            after_src = wpatch_apply_symbol_edit(abs_p, before_src, sym_v.str_val, rep_v.str_val, json_mode)
        } elif len(item.keys) == 2 and has_hunks {
            after_src = wpatch_apply_hunks(rel, before_src, lsp_json_get(item, "hunks"), json_mode)
        } else {
            proj_emit_error_and_exit("patch", json_mode, "W5002", "Unsupported workspace edit fields for: " + rel)
        }

        if before_src != after_src {
            edit_actions.append("modify")
            edit_rels.append(rel)
            edit_abs.append(abs_p)
            edit_canon.append(module_canonical(abs_p))
            edit_before.append(before_src)
            edit_after.append(after_src)
            edit_before_sha.append(b_sha)
            edit_after_sha.append(diag_sha256_hex(after_src))
        }
    }
    if len(edit_rels) == 0 {
        proj_emit_error_and_exit("patch", json_mode, "W5002", "Workspace edit contains no changes")
    }

    let mut entries: list[str] = []
    for t in m.targets {
        if not tool_str_contains(entries, t.entry) { entries.append(t.entry) }
    }
    for ek in 0..len(edit_rels) {
        if edit_actions[ek] != "delete" and not tool_str_contains(entries, edit_rels[ek]) {
            entries.append(edit_rels[ek])
        }
    }
    let mut patch_cases = test_plan.cases
    if test and discover {
        for ek in 0..len(edit_rels) {
            let path = edit_rels[ek]
            let filename = tool_basename(path)
            if edit_actions[ek] == "create" and (len(path) > 6 and slice(path, 0, 6) == "tests/") and
               ((len(filename) >= 5 and slice(filename, 0, 5) == "test_") or proj_str_ends_with(filename, "_test.wysna")) {
                let tc = ProjectTestCase()
                tc.name = "auto:" + path
                tc.entry = path
                patch_cases.append(tc)
            }
        }
    }
    for tc in patch_cases {
        if not tool_str_contains(entries, tc.entry) { entries.append(tc.entry) }
    }
    let sorted_entries = tool_sort_strings(entries)

    let mut dep_aliases: list[str] = []
    let mut dep_roots: list[str] = []
    for d in m.deps {
        dep_aliases.append(d.alias)
        dep_roots.append(d.source_root_abs)
    }

    let mut entry_inputs: list[list[str]] = []
    for entry in sorted_entries {
        let entry_abs = m.root + "/" + entry
        let mut entry_canon = module_canonical(entry_abs)
        if entry_canon == "" { entry_canon = module_normalize(entry_abs) }
        let mut entry_src = ""
        let mut edited_hit = -1
        for k in 0..len(edit_canon) {
            if edit_canon[k] == entry_canon { edited_hit = k break }
        }
        if edited_hit >= 0 {
            entry_src = edit_after[edited_hit]
        } else {
            entry_src = read_file(entry_abs) else err {
                proj_emit_error_and_exit("patch", json_mode, "W5003", "cannot read workspace entry: " + entry_abs)
                ""
            }
        }
        let loader = ModuleLoader()
        let mut enforce_architecture = false
        if m.architecture.enabled {
            for target in m.targets {
                if target.entry == entry { enforce_architecture = true }
            }
        }
        loader.track_dependencies = enforce_architecture
        loader.project_sources_root = m.source_root_abs
        loader.dep_aliases = dep_aliases
        loader.dep_roots = dep_roots
        loader.ov_paths = edit_canon
        loader.ov_texts = edit_after
        module_expand(loader, entry_src, entry_canon, true)
        loader.output.append(Token { kind: "EOF", val: "", line: 1, col: 1, file: module_normalize(entry_canon) })
        let checked = check_program(loader.output, entry_canon, true)
        for node in checked.nodes {
            if node.kind == "unsupported" {
                report_error_at("W2013", node.source, "Compiler native-core-v1 does not support expression " + node.text)
            }
        }
        if enforce_architecture {
            let graph = tool_build_checked_graph(entry_src, entry_canon, loader, checked, false)
            let evaluation = arch_evaluate(m, graph, loader)
            if len(evaluation.issues) > 0 {
                let diagnostics = arch_report_diagnostics(evaluation, loader, json_mode)
                if json_mode { diag_write_output(diag_tool_envelope_json("patch", "diagnostic_error", 1, diagnostics, "", "", "[]")) }
                exit(1)
            }
        }
        mir_verify(mir_build(checked))
        entry_inputs.append(loader.paths)
    }

    let sorted_edit_rels = tool_sort_strings(edit_rels)
    let mut changes_rows: list[str] = []
    for srel in sorted_edit_rels {
        let mut eidx = 0
        for k in 0..len(edit_rels) {
            if edit_rels[k] == srel { eidx = k break }
        }
        let act = edit_actions[eidx]
        let diff = wpatch_unified_diff_kind(srel, act, edit_before[eidx], edit_after[eidx])
        let b_json = if act == "create" { "null" } else { diag_json_quote(edit_before_sha[eidx]) }
        let a_json = if act == "delete" { "null" } else { diag_json_quote(edit_after_sha[eidx]) }
        changes_rows.append("{\"path\":" + diag_json_quote(srel) + ",\"action\":" + diag_json_quote(act) +
            ",\"before_sha256\":" + b_json + ",\"after_sha256\":" + a_json + ",\"diff\":" + diag_json_quote(diff) + "}")
    }

    let mut next_paths: list[str] = []
    let mut next_hashes: list[str] = []
    for k in 0..len(snap_paths) {
        let p = snap_paths[k]
        let mut f_sha = snap_hashes[k]
        let mut deleted = false
        for ek in 0..len(edit_rels) {
            if edit_rels[ek] == p {
                if edit_actions[ek] == "delete" { deleted = true }
                else { f_sha = edit_after_sha[ek] }
                break
            }
        }
        if not deleted {
            next_paths.append(p)
            next_hashes.append(f_sha)
        }
    }
    for ek in 0..len(edit_rels) {
        if edit_actions[ek] == "create" {
            next_paths.append(edit_rels[ek])
            next_hashes.append(edit_after_sha[ek])
        }
    }
    let sorted_after_paths = tool_sort_strings(next_paths)
    let mut after_ws_rows: list[str] = []
    for p in sorted_after_paths {
        for nk in 0..len(next_paths) {
            if next_paths[nk] == p {
                after_ws_rows.append("[" + diag_json_quote(p) + "," + diag_json_quote(next_hashes[nk]) + "]")
                break
            }
        }
    }
    let after_ws_sha = diag_sha256_hex("[" + join_strings(after_ws_rows, ",") + "]")
    let after_rev_parts = proj_workspace_revision_parts(m.manifest_sha256, test_plan.lock_sha, sdk_sha, after_ws_sha)
    let after_rev = after_rev_parts[1]

    let mut impact_rows: list[str] = []
    let mut selected_ids: list[str] = []
    for tc in patch_cases {
        let tid = "test:" + tc.name
        selected_ids.append(diag_json_quote(tid))
        let mut entry_pos = -1
        for k in 0..len(sorted_entries) {
            if sorted_entries[k] == tc.entry { entry_pos = k break }
        }
        let mut causes: list[str] = []
        if entry_pos >= 0 {
            let paths_for_case = entry_inputs[entry_pos]
            for srel in sorted_edit_rels {
                let mut eidx = 0
                for k in 0..len(edit_rels) {
                    if edit_rels[k] == srel { eidx = k break }
                }
                if tool_str_contains(paths_for_case, edit_canon[eidx]) {
                    causes.append(srel)
                }
            }
        }
        let imp_status = if len(causes) > 0 { "affected" } else { "uncertain" }
        let mut cause_q: list[str] = []
        for c in causes { cause_q.append(diag_json_quote(c)) }
        impact_rows.append("{\"id\":" + diag_json_quote(tid) + ",\"entry\":" + diag_json_quote(tc.entry) +
            ",\"impact_status\":" + diag_json_quote(imp_status) + ",\"sources\":[" + join_strings(cause_q, ",") + "]}")
    }

    let mut checked_q: list[str] = []
    for e in sorted_entries { checked_q.append(diag_json_quote(e)) }
    let test_paths: list[str] = if test { wpatch_test_paths(state, m.root) } else { [] }
    let test_inputs_sha = if test { wpatch_test_inputs_sha(state, m.root, test_paths) } else { "" }
    let payload_body = "{\"schema_version\":\"wysna.workspace-patch/1\"" +
        ",\"workspace_revision_before\":" + diag_json_quote(test_plan.revision) +
        ",\"workspace_revision_after\":" + diag_json_quote(after_rev) +
        ",\"changes\":[" + join_strings(changes_rows, ",") + "]" +
        ",\"checked\":[" + join_strings(checked_q, ",") + "]" +
        ",\"tests\":[" + join_strings(impact_rows, ",") + "]" +
        ",\"selected_test_ids\":[" + join_strings(selected_ids, ",") + "]" +
        (if test { ",\"test_inputs_sha256\":" + diag_json_quote(test_inputs_sha) } else { "" }) + "}"
    let plan_hash = diag_sha256_hex(payload_body)

    let live_mid = wpatch_live_revision(state, m, sdk_sha)
    if live_mid != test_plan.revision {
        proj_emit_error_and_exit("patch", json_mode, "W5005", "Workspace changed during edit planning")
    }
    if expected_hash != "" and plan_hash != expected_hash {
        proj_emit_error_and_exit("patch", json_mode, "W5005", "Workspace edit plan is stale")
    }

    let mut test_code = 0
    let mut evidence = ""
    if test {
        let verification = wpatch_verify_candidate_tests(state, m, test_paths, test_inputs_sha,
            edit_rels, edit_actions, edit_after, sdk_sha, after_rev, plan_hash, discover, frozen, len(patch_cases))
        test_code = verification.code
        evidence = ",\"test_verification\":" + verification.evidence + ",\"test_timing_ms\":" + verification.timings
        if wpatch_live_revision(state, m, sdk_sha) != test_plan.revision or
           wpatch_test_inputs_sha(state, m.root, wpatch_test_paths(state, m.root)) != test_inputs_sha {
            state.fail("W5005", "Workspace test inputs changed during verification")
        }
    }

    if apply and test_code == 0 {
        let stamp = str(unix_time())
        let mut tmp_paths: list[str] = []
        let mut backups: list[str] = []
        for k in 0..len(edit_abs) {
            let act = edit_actions[k]
            let path = edit_abs[k]
            let backup = if act == "create" { "" }
                else { wpatch_stage_temp_file(path, stamp + "_backup", k, edit_before[k], path) }
            backups.append(backup)
            if act != "create" and backup == "" {
                wpatch_unlink_all(tmp_paths)
                wpatch_unlink_all(backups)
                proj_emit_error_and_exit("patch", json_mode, "W5004", "failed staging workspace backup: " + edit_rels[k])
            }
            if act == "create" and not wpatch_ensure_parents(m.root, edit_rels[k]) {
                wpatch_unlink_all(tmp_paths)
                wpatch_unlink_all(backups)
                proj_emit_error_and_exit("patch", json_mode, "W5004", "failed creating parent directory: " + edit_rels[k])
            }
            let staged = if act == "delete" { "" } else { wpatch_stage_temp_file(path, stamp, k, edit_after[k], if act == "modify" { path } else { "" }) }
            tmp_paths.append(staged)
            if act != "delete" and staged == "" {
                wpatch_unlink_all(tmp_paths)
                wpatch_unlink_all(backups)
                proj_emit_error_and_exit("patch", json_mode, "W5004", "failed staging workspace operation: " + edit_rels[k])
            }
        }
        let live_commit = wpatch_live_revision(state, m, sdk_sha)
        if live_commit != test_plan.revision {
            wpatch_unlink_all(tmp_paths)
            wpatch_unlink_all(backups)
            proj_emit_error_and_exit("patch", json_mode, "W5005", "Workspace changed during edit planning")
        }
        let mut published = 0
        let mut failure_code = ""
        for k in 0..len(edit_abs) {
            let act = edit_actions[k]
            let path = edit_abs[k]
            let current_matches = if act == "create" {
                not proj_path_exists(path) and wpatch_no_symlink_ancestors(m.root, edit_rels[k])
            } else { wpatch_matches(path, edit_before_sha[k]) }
            if not current_matches {
                failure_code = "W5005"
                break
            }
            let committed = if act == "delete" { wpatch_remove(path) }
                else { wpatch_rename_file(tmp_paths[k], path) }
            if not committed {
                failure_code = "W5004"
                break
            }
            published = published + 1
        }
        wpatch_unlink_all(tmp_paths)
        if failure_code != "" {
            let mut failed_restores: list[str] = []
            let mut index = published - 1
            while index >= 0 {
                let act = edit_actions[index]
                let path = edit_abs[index]
                let current_matches = if act == "delete" {
                    not proj_path_exists(path) and wpatch_no_symlink_ancestors(m.root, edit_rels[index])
                } else { wpatch_matches(path, edit_after_sha[index]) }
                let restored = current_matches and (if act == "create" { wpatch_remove(path) }
                    else { wpatch_rename_file(backups[index], path) })
                if not restored {
                    let backup = backups[index]
                    let info = if backup == "" { "" } else { " (backup " + backup + ")" }
                    failed_restores.append(path + info)
                    backups[index] = ""
                }
                index = index - 1
            }
            wpatch_unlink_all(backups)
            if len(failed_restores) > 0 {
                proj_emit_error_and_exit("patch", json_mode, "W5004",
                    "Workspace publication failed; could not restore " + join_strings(failed_restores, ", "))
            }
            let message = if failure_code == "W5005" { "Source changed before workspace apply: " }
                else { "failed committing workspace operation: " }
            proj_emit_error_and_exit("patch", json_mode, failure_code, message + edit_rels[published])
        }
        wpatch_unlink_all(backups)
    }

    let written_str = if apply and test_code == 0 { "true" } else { "false" }
    let full_result = slice(payload_body, 0, len(payload_body) - 1) +
        ",\"plan_hash\":" + diag_json_quote(plan_hash) + ",\"written\":" + written_str + evidence + "}"
    if json_mode {
        let status = if test_code == 0 { "ok" } elif test_code == 2 { "usage_error" } else { "runtime_error" }
        diag_write_output(diag_tool_envelope_json("patch", status, test_code, "[]", "result", full_result, "[]"))
    } else {
        print(full_result)
    }
    exit(test_code)
}
