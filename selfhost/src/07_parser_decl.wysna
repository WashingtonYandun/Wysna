fn parse_let_stmt(emitter: CEmitter, is_global: bool) -> unit {
    expect_kind(emitter, "LET")
    match_kind(emitter, "MUT")
    let name_tok = expect_kind(emitter, "IDENT")
    if match_kind(emitter, "COLON") {
        parse_type_ann(emitter)
    }
    expect_kind(emitter, "ASSIGN")
    let mut val_r = ExprRes { val: "", lref: "" }
    if is_global and check_kind(emitter, "LBRACKET") and peek_tok(emitter, 1).kind == "RBRACKET" {
        advance_tok(emitter)
        advance_tok(emitter)
        val_r = ExprRes { val: "wysna_make_list(0, NULL)", lref: "" }
    } else {
        val_r = parse_expr(emitter, 0, true)
    }
    let vname = "v_" + name_tok.val
    if is_global {
        emitter.globals.append(vname)
        emit_line(emitter, "wysna_assign(&" + vname + ", " + own_expr(val_r.val) + ");")
    } else {
        let initial = snapshot_value(emitter, val_r.val)
        declare_owned_var(emitter, vname, own_expr(initial))
    }
}

fn parse_return_stmt(emitter: CEmitter) -> unit {
    expect_kind(emitter, "RETURN")
    if not expression_starter(at_tok(emitter).kind) {
        emit_cleanup_until_fn(emitter)
        if emitter.fn_fallible {
            emit_line(emitter, "return wysna_ok(wysna_unit());")
        } else {
            emit_line(emitter, "return wysna_unit();")
        }
        return
    }
    let val_r = parse_expr(emitter, 0, true)
    let ret_hold = new_aux(emitter, "_ret")
    emit_line(emitter, "WVal " + ret_hold + " = " + own_expr(val_r.val) + ";")
    emit_cleanup_until_fn(emitter)
    if emitter.fn_fallible {
        emit_line(emitter, "return wysna_wrap_result(" + ret_hold + ", \"" + emitter.cur_err_type + "\");")
    } else {
        emit_line(emitter, "return " + ret_hold + ";")
    }
}

fn parse_while_stmt(emitter: CEmitter) -> unit {
    expect_kind(emitter, "WHILE")
    emit_line(emitter, "while (1) {")
    push_scope(emitter, "loop")
    let saved = emitter.cur_stmts
    let empty: list[str] = []
    emitter.cur_stmts = empty
    let cond_r = parse_expr(emitter, 0, false)
    let cond_b = new_aux(emitter, "_cond")
    emit_line(emitter, "bool " + cond_b + " = (" + cond_r.val + ").as.b;")
    if has_cleanup_until_loop(emitter) {
        emit_line(emitter, "if (!" + cond_b + ") {")
        emit_cleanup_until_loop_indented(emitter)
        emit_line(emitter, "    break;")
        emit_line(emitter, "}")
    } else {
        emit_line(emitter, "if (!" + cond_b + ") break;")
    }
    let body_v = parse_block_expr(emitter)
    emit_line(emitter, "(void)" + body_v + ";")
    pop_scope(emitter)
    let inner = emitter.cur_stmts
    emitter.cur_stmts = saved
    for l in inner {
        emit_line(emitter, "    " + l)
    }
    emit_line(emitter, "}")
}

fn direct_range_operator(emitter: CEmitter) -> str {
    let mut offset = 0
    let mut depth = 0
    while true {
        let kind = peek_tok(emitter, offset).kind
        if kind == "EOF" or (depth == 0 and (kind == "LBRACE" or kind == "RBRACE")) { return "" }
        if depth == 0 and (kind == "DOT_DOT" or kind == "DOT_DOT_EQ") { return kind }
        if kind == "LPAREN" or kind == "LBRACKET" { depth = depth + 1 }
        elif kind == "RPAREN" or kind == "RBRACKET" {
            if depth == 0 { return "" }
            depth = depth - 1
        }
        offset = offset + 1
    }
    return ""
}

fn parse_for_stmt(emitter: CEmitter) -> unit {
    expect_kind(emitter, "FOR")
    let grouped = match_kind(emitter, "LPAREN")
    let pat0 = expect_kind(emitter, "IDENT")
    let mut pat_names: list[str] = [pat0.val]
    while match_kind(emitter, "COMMA") {
        let pn = expect_kind(emitter, "IDENT")
        pat_names.append(pn.val)
    }
    if grouped { expect_kind(emitter, "RPAREN") }
    expect_kind(emitter, "IN")
    emit_line(emitter, "{")
    push_scope(emitter, "block")
    let saved_outer = emitter.cur_stmts
    let empty: list[str] = []
    emitter.cur_stmts = empty
    let range_kind = direct_range_operator(emitter)
    let mut first = ""
    let mut iter_tmp = ""
    let mut count = ""
    let mut idx_tmp = ""
    let mut item_tmp = ""
    if range_kind != "" {
        let start = parse_expr(emitter, op_precedence(range_kind), false)
        first = snapshot_value(emitter, start.val)
        expect_kind(emitter, range_kind)
        let end = parse_expr(emitter, 0, false)
        let last = snapshot_value(emitter, end.val)
        count = new_aux(emitter, "_count")
        idx_tmp = new_aux(emitter, "_idx")
        item_tmp = new_aux(emitter, "_item")
        let inclusive = range_kind == "DOT_DOT_EQ"
        emit_line(emitter, "int32_t " + count + " = wysna_range_count(" + first + ", " + last + ", " + str(inclusive) + ");")
        emit_line(emitter, "for (int32_t " + idx_tmp + " = 0; " + idx_tmp + " < " + count + "; " + idx_tmp + "++) {")
    } else {
        let iter_r = parse_expr(emitter, 0, false)
        iter_tmp = new_temp(emitter)
        idx_tmp = new_aux(emitter, "_idx")
        item_tmp = new_aux(emitter, "_item")
        declare_owned_var(emitter, iter_tmp, own_expr(iter_r.val))
        emit_line(emitter, "for (int32_t " + idx_tmp + " = 0; " + idx_tmp + " < " + iter_tmp + ".as.list->len; " + idx_tmp + "++) {")
    }
    push_scope(emitter, "loop")
    let saved_loop = emitter.cur_stmts
    emitter.cur_stmts = empty
    if range_kind != "" {
        emit_line(emitter, "WVal " + item_tmp + " = wysna_int((" + first + ").as.i + (int64_t)" + idx_tmp + ");")
    } else {
        emit_line(emitter, "WVal " + item_tmp + " = " + iter_tmp + ".as.list->data[" + idx_tmp + "];")
    }
    if len(pat_names) == 1 {
        declare_owned_var(emitter, "v_" + pat_names[0], "wysna_clone(" + item_tmp + ")")
    } else {
        for pi in 0..len(pat_names) {
            declare_owned_var(emitter, "v_" + pat_names[pi], "wysna_clone((" + item_tmp + ").as.tuple->items[" + str(pi) + "])")
        }
    }
    let body_v = parse_block_expr(emitter)
    emit_line(emitter, "(void)" + body_v + ";")
    pop_scope(emitter)
    let loop_lines = emitter.cur_stmts
    emitter.cur_stmts = saved_loop
    for l in loop_lines {
        emit_line(emitter, "    " + l)
    }
    emit_line(emitter, "}")
    pop_scope(emitter)
    let outer_lines = emitter.cur_stmts
    emitter.cur_stmts = saved_outer
    for l in outer_lines {
        emit_line(emitter, "    " + l)
    }
    emit_line(emitter, "}")
}

fn parse_struct_decl(emitter: CEmitter) -> unit {
    expect_kind(emitter, "STRUCT")
    expect_kind(emitter, "IDENT")
    if match_kind(emitter, "LBRACKET") {
        while not check_kind(emitter, "RBRACKET") and not is_eof(emitter) {
            expect_kind(emitter, "IDENT")
            if match_kind(emitter, "COLON") { parse_type_ann(emitter) }
            if not match_kind(emitter, "COMMA") { break }
        }
        expect_kind(emitter, "RBRACKET")
    }
    expect_kind(emitter, "LBRACE")
    while not check_kind(emitter, "RBRACE") and not is_eof(emitter) {
        skip_statement_separators(emitter)
        if check_kind(emitter, "RBRACE") or is_eof(emitter) { break }
        expect_kind(emitter, "IDENT")
        expect_kind(emitter, "COLON")
        if check_kind(emitter, "RBRACE") or check_kind(emitter, "EOF") {
            report_error(at_tok(emitter).file, "W0001", at_tok(emitter).line, at_tok(emitter).col, "expected type name in struct field")
        }
        parse_type_ann(emitter)
        match_kind(emitter, "COMMA")
    }
    expect_kind(emitter, "RBRACE")
}

fn parse_enum_decl(emitter: CEmitter) -> unit {
    expect_kind(emitter, "ENUM")
    let name_tok = expect_kind(emitter, "IDENT")
    emitter.enums.append(name_tok.val)
    if match_kind(emitter, "LBRACKET") {
        while not check_kind(emitter, "RBRACKET") and not is_eof(emitter) {
            expect_kind(emitter, "IDENT")
            if match_kind(emitter, "COLON") { expect_kind(emitter, "IDENT") }
            if not match_kind(emitter, "COMMA") { break }
        }
        expect_kind(emitter, "RBRACKET")
    }
    expect_kind(emitter, "LBRACE")
    while not check_kind(emitter, "RBRACE") and not is_eof(emitter) {
        skip_statement_separators(emitter)
        if check_kind(emitter, "RBRACE") or is_eof(emitter) { break }
        let variant = expect_kind(emitter, "IDENT")
        let mut arity = 0
        if match_kind(emitter, "LPAREN") {
            if not check_kind(emitter, "RPAREN") {
                parse_type_ann(emitter)
                arity = 1
                while match_kind(emitter, "COMMA") {
                    if check_kind(emitter, "RPAREN") { break }
                    parse_type_ann(emitter)
                    arity = arity + 1
                }
            }
            expect_kind(emitter, "RPAREN")
        }
        emitter.enum_variant_names.append(variant.val)
        emitter.enum_variant_owners.append(name_tok.val)
        emitter.enum_variant_arities.append(arity)
        match_kind(emitter, "COMMA")
    }
    expect_kind(emitter, "RBRACE")
}

fn parse_interface_decl(emitter: CEmitter) -> unit {
    expect_kind(emitter, "INTERFACE")
    expect_kind(emitter, "IDENT")
    expect_kind(emitter, "LBRACE")
    while not check_kind(emitter, "RBRACE") and not is_eof(emitter) {
        skip_statement_separators(emitter)
        if check_kind(emitter, "RBRACE") or is_eof(emitter) { break }
        expect_kind(emitter, "FN")
        expect_kind(emitter, "IDENT")
        expect_kind(emitter, "LPAREN")
        if not check_kind(emitter, "RPAREN") {
            expect_kind(emitter, "IDENT")
            expect_kind(emitter, "COLON")
            parse_type_ann(emitter)
            while match_kind(emitter, "COMMA") {
                if check_kind(emitter, "RPAREN") {
                    break
                }
                expect_kind(emitter, "IDENT")
                expect_kind(emitter, "COLON")
                parse_type_ann(emitter)
            }
        }
        expect_kind(emitter, "RPAREN")
        if match_kind(emitter, "ARROW") {
            parse_type_ann(emitter)
        }
        match_kind(emitter, "COMMA")
    }
    expect_kind(emitter, "RBRACE")
}

fn parse_class_decl(emitter: CEmitter) -> unit {
    expect_kind(emitter, "CLASS")
    let cname_tok = expect_kind(emitter, "IDENT")
    let cls_name = cname_tok.val
    let mut class_protos: list[str] = ["static const WClassVTable wysna_vtable_" + cls_name + ";"]
    let mut sup_name = ""
    if match_kind(emitter, "EXTENDS") {
        let s_tok = expect_kind(emitter, "IDENT")
        sup_name = s_tok.val
    }
    if match_kind(emitter, "IMPLEMENTS") {
        expect_kind(emitter, "IDENT")
        while match_kind(emitter, "COMMA") {
            expect_kind(emitter, "IDENT")
        }
    }
    let mut f_names: list[str] = []
    let mut f_defaults: list[str] = []
    let mut m_names: list[str] = []
    let mut m_arities: list[int] = []
    let mut init_p: list[str] = []
    let prev_cls = emitter.cur_class
    let prev_sup = emitter.cur_super
    emitter.cur_class = cls_name
    emitter.cur_super = sup_name
    expect_kind(emitter, "LBRACE")
    while not check_kind(emitter, "RBRACE") and not is_eof(emitter) {
        skip_statement_separators(emitter)
        if check_kind(emitter, "RBRACE") or is_eof(emitter) { break }
        let mut is_pub = true
        if check_kind(emitter, "PUBLIC") {
            advance_tok(emitter)
            is_pub = true
        } elif check_kind(emitter, "PRIVATE") {
            advance_tok(emitter)
            is_pub = false
        }
        if check_kind(emitter, "FN") {
            advance_tok(emitter)
            let m_tok = expect_kind(emitter, "IDENT")
            let mname = m_tok.val
            expect_kind(emitter, "LPAREN")
            let mut p_names: list[str] = []
            if not check_kind(emitter, "RPAREN") {
                let p0 = expect_kind(emitter, "IDENT")
                expect_kind(emitter, "COLON")
                parse_type_ann(emitter)
                p_names.append(p0.val)
                while match_kind(emitter, "COMMA") {
                    if check_kind(emitter, "RPAREN") {
                        break
                    }
                    let pn = expect_kind(emitter, "IDENT")
                    expect_kind(emitter, "COLON")
                    parse_type_ann(emitter)
                    p_names.append(pn.val)
                }
            }
            expect_kind(emitter, "RPAREN")
            let mut fallible = false
            let mut unit_return = true
            let mut unit_result_return = false
            let mut type_start = 0
            if match_kind(emitter, "ARROW") {
                type_start = emitter.pos
                fallible = parse_type_ann(emitter)
                unit_return = parsed_unit_return(emitter, type_start)
                unit_result_return = parsed_unit_result_return(emitter, type_start)
            }
            m_names.append(mname)
            m_arities.append(len(p_names))
            if mname == "init" {
                init_p = p_names
            } else {
                register_dispatch(emitter, mname, len(p_names))
            }
            let mut m_sig = "WVal v_self"
            for idx in 0..len(p_names) {
                m_sig = m_sig + ", WVal v_" + p_names[idx]
            }
            let c_mname = "wysna_method_" + cls_name + "__" + mname
            class_protos.append("static WVal " + c_mname + "(" + m_sig + ");")
            let prev_fall = emitter.fn_fallible
            let prev_err = emitter.cur_err_type
            emitter.fn_fallible = fallible
            let saved = emitter.cur_stmts
            let empty: list[str] = []
            emitter.cur_stmts = empty
            push_scope(emitter, "fn")
            let mut ret_v = parse_block_expr(emitter)
            if unit_return { ret_v = "wysna_unit()" }
            let ret_hold = new_aux(emitter, "_ret")
            let mut owned_return = own_expr(ret_v)
            if unit_result_return { owned_return = "wysna_discard_result_value(" + owned_return + ")" }
            emit_line(emitter, "WVal " + ret_hold + " = " + owned_return + ";")
            pop_scope(emitter)
            if emitter.fn_fallible {
                emit_line(emitter, "return wysna_wrap_result(" + ret_hold + ", \"" + emitter.cur_err_type + "\");")
            } else {
                emit_line(emitter, "return " + ret_hold + ";")
            }
            let body_lines = emitter.cur_stmts
            emitter.cur_stmts = saved
            emitter.fn_fallible = prev_fall
            emitter.cur_err_type = prev_err
            let mut m_str = "static WVal " + c_mname + "(" + m_sig + ") {\n"
            for l in body_lines {
                m_str = m_str + "    " + l + "\n"
            }
            m_str = m_str + "}"
            emitter.fn_defs.append(m_str)
        } else {
            let f_tok = expect_kind(emitter, "IDENT")
            expect_kind(emitter, "COLON")
            let f_def = parse_field_default(emitter)
            match_kind(emitter, "COMMA")
            f_names.append(f_tok.val)
            f_defaults.append(f_def)
        }
    }
    expect_kind(emitter, "RBRACE")
    emitter.cur_class = prev_cls
    emitter.cur_super = prev_sup
    emitter.classes.append(ClassMeta { name: cls_name, super_name: sup_name, field_names: f_names, field_defaults: f_defaults, method_names: m_names, method_arities: m_arities, init_params: init_p })
    let mut lineage: list[int] = []
    let mut cur_c = cls_name
    while cur_c != "" {
        let cidx = find_class_meta_idx(emitter, cur_c)
        if cidx == -1 {
            break
        }
        lineage.append(cidx)
        cur_c = emitter.classes[cidx].super_name
    }
    let mut all_fnames: list[str] = []
    let mut all_fdefs: list[str] = []
    let mut li = len(lineage) - 1
    while li >= 0 {
        let cm = emitter.classes[lineage[li]]
        for fi in 0..len(cm.field_names) {
            all_fnames.append(cm.field_names[fi])
            all_fdefs.append(cm.field_defaults[fi])
        }
        li = li - 1
    }
    let init_owner = find_class_method_owner(emitter, cls_name, "init")
    let mut eff_init_p: list[str] = []
    if init_owner != "" {
        let oidx = find_class_meta_idx(emitter, init_owner)
        if oidx != -1 {
            eff_init_p = emitter.classes[oidx].init_params
        }
    }
    let mut new_sig = "void"
    let mut init_call_args = "v_self"
    if len(eff_init_p) > 0 {
        new_sig = ""
        for idx in 0..len(eff_init_p) {
            if idx > 0 {
                new_sig = new_sig + ", "
            }
            new_sig = new_sig + "WVal v_" + eff_init_p[idx]
            init_call_args = init_call_args + ", v_" + eff_init_p[idx]
        }
    }
    class_protos.append("static WVal wysna_new_" + cls_name + "(" + new_sig + ");")
    for prototype in class_protos { emitter.class_protos.append(prototype) }
    let mut new_str = "static WVal wysna_new_" + cls_name + "(" + new_sig + ") {\n"
    if len(all_fnames) > 0 {
        let mut kj = ""
        let mut vj = ""
        for fi in 0..len(all_fnames) {
            if fi > 0 {
                kj = kj + ", "
                vj = vj + ", "
            }
            kj = kj + "\"" + all_fnames[fi] + "\""
            vj = vj + all_fdefs[fi]
        }
        let fcnt = str(len(all_fnames))
        new_str = new_str + "    const char* _k[" + fcnt + "] = { " + kj + " };\n"
        new_str = new_str + "    WVal _v[" + fcnt + "] = { " + vj + " };\n"
        new_str = new_str + "    WVal v_self = wysna_make_object(\"" + cls_name + "\", " + fcnt + ", _k, _v);\n"
        new_str = new_str + "    wysna_release_array(" + fcnt + ", _v);\n"
    } else {
        new_str = new_str + "    WVal v_self = wysna_make_object(\"" + cls_name + "\", 0, NULL, NULL);\n"
    }
    new_str = new_str + "    v_self.as.st->vtable = &wysna_vtable_" + cls_name + ";\n"
    if init_owner != "" {
        new_str = new_str + "    wysna_release(wysna_method_" + init_owner + "__init(" + init_call_args + "));\n"
    }
    new_str = new_str + "    return v_self;\n}"
    emitter.fn_defs.append(new_str)
}

fn emit_oop_dispatchers(emitter: CEmitter) -> unit {
    let mut adapters: list[str] = []
    let mut tables: list[str] = []
    for class_ in emitter.classes {
        let mut slots: list[str] = []
        for di in 0..len(emitter.dispatch_names) {
            let name = emitter.dispatch_names[di]
            let arity = emitter.dispatch_arities[di]
            let owner = find_class_method_owner(emitter, class_.name, name)
            if owner == "" or find_class_method_arity(emitter, class_.name, name) != arity { slots.append("NULL") }
            else {
                let adapter = "wysna_vinvoke_" + owner + "__" + name
                slots.append(adapter)
                if not module_contains(adapters, adapter) {
                    adapters.append(adapter)
                    let mut arguments = "receiver"
                    for i in 0..arity { arguments = arguments + ", argv[" + str(i) + "]" }
                    emitter.fn_defs.append("static WVal " + adapter + "(WVal receiver, int32_t argc, const WVal* argv) { (void)argc; (void)argv; return wysna_method_" + owner + "__" + name + "(" + arguments + "); }")
                }
            }
        }
        if len(slots) > 0 {
            let mut joined = ""
            for i in 0..len(slots) { if i > 0 { joined = joined + ", " } joined = joined + slots[i] }
            tables.append("static const WInvoke wysna_slots_" + class_.name + "[" + str(len(slots)) + "] = { " + joined + " };")
            tables.append("static const WClassVTable wysna_vtable_" + class_.name + " = { " + str(len(slots)) + ", wysna_slots_" + class_.name + " };")
        } else { tables.append("static const WClassVTable wysna_vtable_" + class_.name + " = { 0, NULL };") }
    }
    for table in tables { emitter.fn_defs.append(table) }
    for di in 0..len(emitter.dispatch_names) {
        let name = emitter.dispatch_names[di]
        let arity = emitter.dispatch_arities[di]
        let mut signature = "WVal v_self"
        let mut arguments = ""
        for i in 0..arity {
            signature = signature + ", WVal _a" + str(i)
            if i > 0 { arguments = arguments + ", " }
            arguments = arguments + "_a" + str(i)
        }
        if arity == 0 { arguments = "NULL" } else { arguments = "(WVal[]){ " + arguments + " }" }
        emitter.fn_defs.append("static WVal wysna_dispatch__" + name + "__" + str(arity) + "(" + signature + ") { return wysna_virtual_call(v_self, " + str(di) + ", " + str(arity) + ", " + arguments + "); }")
    }
}

fn parse_fn_decl(emitter: CEmitter) -> unit {
    expect_kind(emitter, "FN")
    let name_tok = expect_kind(emitter, "IDENT")
    if match_kind(emitter, "LBRACKET") {
        while not check_kind(emitter, "RBRACKET") and not is_eof(emitter) {
            expect_kind(emitter, "IDENT")
            if match_kind(emitter, "COLON") { parse_type_ann(emitter) }
            if not match_kind(emitter, "COMMA") { break }
        }
        expect_kind(emitter, "RBRACKET")
    }
    expect_kind(emitter, "LPAREN")
    let mut param_names: list[str] = []
    if not check_kind(emitter, "RPAREN") {
        let p0 = expect_kind(emitter, "IDENT")
        expect_kind(emitter, "COLON")
        parse_type_ann(emitter)
        param_names.append(p0.val)
        while match_kind(emitter, "COMMA") {
            if check_kind(emitter, "RPAREN") {
                break
            }
            let pn = expect_kind(emitter, "IDENT")
            expect_kind(emitter, "COLON")
            parse_type_ann(emitter)
            param_names.append(pn.val)
        }
    }
    expect_kind(emitter, "RPAREN")
    let mut fallible = false
    let mut unit_return = true
    let mut unit_result_return = false
    let mut type_start = 0
    if match_kind(emitter, "ARROW") {
        type_start = emitter.pos
        fallible = parse_type_ann(emitter)
        unit_return = parsed_unit_return(emitter, type_start)
        unit_result_return = parsed_unit_result_return(emitter, type_start)
    }
    let mut sig = "void"
    if len(param_names) > 0 {
        sig = ""
        for idx in 0..len(param_names) {
            if idx > 0 {
                sig = sig + ", "
            }
            sig = sig + "WVal v_" + param_names[idx]
        }
    }
    let c_name = c_fn_name(name_tok.val)
    emitter.protos.append("static WVal " + c_name + "(" + sig + ");")
    let prev_fallible = emitter.fn_fallible
    let prev_err = emitter.cur_err_type
    emitter.fn_fallible = fallible
    let saved = emitter.cur_stmts
    let empty: list[str] = []
    emitter.cur_stmts = empty
    let previous_bindings = emitter.borrowed_vars
    let mut borrowed: list[str] = []
    for parameter in param_names { borrowed.append("v_" + parameter) }
    emitter.borrowed_vars = borrowed
    push_scope(emitter, "fn")
    let mut ret_v = parse_block_expr(emitter)
    if unit_return { ret_v = "wysna_unit()" }
    let ret_hold = new_aux(emitter, "_ret")
    let mut owned_return = own_expr(ret_v)
    if unit_result_return { owned_return = "wysna_discard_result_value(" + owned_return + ")" }
    emit_line(emitter, "WVal " + ret_hold + " = " + owned_return + ";")
    pop_scope(emitter)
    if emitter.fn_fallible {
        emit_line(emitter, "return wysna_wrap_result(" + ret_hold + ", \"" + emitter.cur_err_type + "\");")
    } else {
        emit_line(emitter, "return " + ret_hold + ";")
    }
    let body_lines = emitter.cur_stmts
    emitter.cur_stmts = saved
    emitter.borrowed_vars = previous_bindings
    emitter.fn_fallible = prev_fallible
    emitter.cur_err_type = prev_err
    let mut fn_str = "static WVal " + c_name + "(" + sig + ") {\n"
    for l in body_lines {
        fn_str = fn_str + "    " + l + "\n"
    }
    fn_str = fn_str + "}"
    emitter.fn_defs.append(fn_str)
}

fn ffi_c_type(emitter: CEmitter, name: str, returned: bool) -> str {
    if name == "int32" { return "int32_t" }
    if name == "int" or name == "int64" { return "int64_t" }
    if name == "float" or name == "double" { return "double" }
    if name == "bool" { return "bool" }
    if name == "opaque" { return "void*" }
    if name == "unit" and returned { return "void" }
    report_error(at_tok(emitter).file, "W2001", at_tok(emitter).line, at_tok(emitter).col, "unsupported C ABI type")
    return "void"
}
fn parse_extern_decl(emitter: CEmitter) {
    expect_kind(emitter, "EXTERN")
    if expect_kind(emitter, "STR").val != "C" { report_error(at_tok(emitter).file, "W2013", at_tok(emitter).line, at_tok(emitter).col, "only C ABI is supported") }
    expect_kind(emitter, "FN")
    let name = expect_kind(emitter, "IDENT").val
    expect_kind(emitter, "LPAREN")
    let mut types: list[str] = []
    while not check_kind(emitter, "RPAREN") {
        expect_kind(emitter, "IDENT")
        expect_kind(emitter, "COLON")
        types.append(expect_kind(emitter, "IDENT").val)
        if not match_kind(emitter, "COMMA") { break }
    }
    expect_kind(emitter, "RPAREN")
    expect_kind(emitter, "ARROW")
    let returned = expect_kind(emitter, "IDENT").val
    let mut native_name = name
    let module_prefix = "__wysna_module_"
    if len(name) > len(module_prefix) and slice(name, 0, len(module_prefix)) == module_prefix {
        for i in len(module_prefix)..len(name) - 1 { if slice(name, i, i + 2) == "__" { native_name = slice(name, i + 2, len(name)) break } }
    }
    let mut native_params = ""
    let mut wrapped_params = ""
    let mut arguments = ""
    for i in 0..len(types) {
        if i > 0 { native_params = native_params + ", " wrapped_params = wrapped_params + ", " arguments = arguments + ", " }
        native_params = native_params + ffi_c_type(emitter, types[i], false)
        let variable = "v_" + str(i)
        wrapped_params = wrapped_params + "WVal " + variable
        if types[i] == "int32" { arguments = arguments + "wysna_ffi_int32(" + variable + ")" }
        elif types[i] == "int" or types[i] == "int64" { arguments = arguments + variable + ".as.i" }
        elif types[i] == "float" or types[i] == "double" { arguments = arguments + variable + ".as.f" }
        elif types[i] == "bool" { arguments = arguments + variable + ".as.b" }
        else { arguments = arguments + variable + ".as.pointer" }
    }
    if len(types) == 0 { native_params = "void" wrapped_params = "void" }
    let c_name = c_fn_name(name)
    emitter.protos.append("extern " + ffi_c_type(emitter, returned, true) + " " + native_name + "(" + native_params + ");")
    emitter.protos.append("static WVal " + c_name + "(" + wrapped_params + ");")
    let call = native_name + "(" + arguments + ")"
    let mut result = ""
    if returned == "unit" { result = call + "; return wysna_unit();" }
    elif returned == "int" or returned == "int32" or returned == "int64" { result = "return wysna_int(" + call + ");" }
    elif returned == "float" or returned == "double" { result = "return wysna_float(" + call + ");" }
    elif returned == "bool" { result = "return wysna_bool(" + call + ");" }
    elif native_name == "wysna_host_buffer_new" or native_name == "wysna_host_file_open" { result = "return wysna_host_owned_pointer(" + call + ");" }
    else { result = "return wysna_pointer(" + call + ");" }
    emitter.fn_defs.append("static WVal " + c_name + "(" + wrapped_params + ") { " + result + " }")
}
