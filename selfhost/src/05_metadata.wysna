fn is_enum_name(emitter: CEmitter, name: str) -> bool {
    for e in emitter.enums {
        if e == name {
            return true
        }
    }
    return false
}

fn c_fn_name(name: str) -> str { return "wysna_fn_" + name }

fn escape_c_str(s: str) -> str {
    let mut out = "\""
    let n = len(s)
    for i in 0..n {
        let ch = s[i]
        let code = ord(ch)
        if code == 34 {
            out = out + "\\\""
        } elif code == 92 {
            out = out + "\\\\"
        } elif code == 10 {
            out = out + "\\n"
        } elif code == 13 {
            out = out + "\\r"
        } elif code == 9 {
            out = out + "\\t"
        } elif code == 0 {
            out = out + "\\000"
        } elif code == 63 {
            out = out + "\\077"
        } else {
            out = out + ch
        }
    }
    out = out + "\""
    return out
}

fn parsed_unit_return(emitter: CEmitter, start: int) -> bool {
    let mut found = false
    for index in start..emitter.pos {
        let token = emitter.tokens[index]
        if token.kind == "LPAREN" or token.kind == "RPAREN" { continue }
        if not found and token.kind == "IDENT" and token.val == "unit" { found = true }
        else { return false }
    }
    return found
}

fn parsed_unit_result_return(emitter: CEmitter, start: int) -> bool {
    let mut found = false
    for index in start..emitter.pos {
        let token = emitter.tokens[index]
        if token.kind == "BANG" { return found }
        if token.kind == "LPAREN" or token.kind == "RPAREN" { continue }
        if not found and token.kind == "IDENT" and token.val == "unit" { found = true }
        else { return false }
    }
    return false
}

fn parse_type_ann(emitter: CEmitter) -> bool {
    let mut is_fallible = false
    if match_kind(emitter, "FN") {
        expect_kind(emitter, "LPAREN")
        if not check_kind(emitter, "RPAREN") {
            parse_type_ann(emitter)
            while match_kind(emitter, "COMMA") { parse_type_ann(emitter) }
        }
        expect_kind(emitter, "RPAREN")
        expect_kind(emitter, "ARROW")
        return parse_type_ann(emitter)
    }
    if match_kind(emitter, "LPAREN") {
        is_fallible = parse_type_ann(emitter)
        expect_kind(emitter, "RPAREN")
    } else {
        let type_token = at_tok(emitter)
        advance_tok(emitter)
        if type_token.kind == "IDENT" and type_token.val == "Result" { is_fallible = true }
    }
    if match_kind(emitter, "LBRACKET") {
        while not check_kind(emitter, "RBRACKET") and not is_eof(emitter) {
            parse_type_ann(emitter)
            match_kind(emitter, "COMMA")
        }
        expect_kind(emitter, "RBRACKET")
    }
    if match_kind(emitter, "QUESTION") {
        is_fallible = false
    }
    if match_kind(emitter, "BANG") {
        let err_tok = at_tok(emitter)
        parse_type_ann(emitter)
        while match_kind(emitter, "PIPE") { parse_type_ann(emitter) }
        is_fallible = true
        emitter.cur_err_type = err_tok.val
    }
    return is_fallible
}

fn parse_field_default(emitter: CEmitter) -> str {
    if check_kind(emitter, "FN") { parse_type_ann(emitter) return "wysna_none()" }
    let tname = at_tok(emitter).val
    let mut def_c = "wysna_none()"
    if tname == "Weak" {
        def_c = "wysna_empty_weak()"
    } elif tname == "int" {
        def_c = "wysna_int(0LL)"
    } elif tname == "float" {
        def_c = "wysna_float(0.0)"
    } elif tname == "bool" {
        def_c = "wysna_bool(false)"
    } elif tname == "str" {
        def_c = "wysna_str(\"\")"
    } elif tname == "list" {
        def_c = "wysna_make_list(0, NULL)"
    } elif tname == "dict" {
        def_c = "wysna_make_dict(0, NULL, NULL)"
    }
    advance_tok(emitter)
    if match_kind(emitter, "LBRACKET") {
        while not check_kind(emitter, "RBRACKET") and not is_eof(emitter) {
            parse_type_ann(emitter)
            match_kind(emitter, "COMMA")
        }
        expect_kind(emitter, "RBRACKET")
    }
    if match_kind(emitter, "QUESTION") {
        def_c = "wysna_none()"
    }
    return def_c
}

fn find_class_meta_idx(emitter: CEmitter, cls_name: str) -> int {
    for i in 0..len(emitter.classes) {
        if emitter.classes[i].name == cls_name {
            return i
        }
    }
    return -1
}

fn find_class_method_owner(emitter: CEmitter, start_cls: str, m_name: str) -> str {
    let mut cur = start_cls
    while cur != "" {
        let idx = find_class_meta_idx(emitter, cur)
        if idx == -1 {
            return ""
        }
        let cm = emitter.classes[idx]
        for mi in 0..len(cm.method_names) {
            if cm.method_names[mi] == m_name {
                return cm.name
            }
        }
        cur = cm.super_name
    }
    return ""
}

fn find_class_method_arity(emitter: CEmitter, start_cls: str, m_name: str) -> int {
    let mut cur = start_cls
    while cur != "" {
        let idx = find_class_meta_idx(emitter, cur)
        if idx == -1 {
            return -1
        }
        let cm = emitter.classes[idx]
        for mi in 0..len(cm.method_names) {
            if cm.method_names[mi] == m_name {
                return cm.method_arities[mi]
            }
        }
        cur = cm.super_name
    }
    return -1
}

fn register_dispatch(emitter: CEmitter, m_name: str, arity: int) -> unit {
    for i in 0..len(emitter.dispatch_names) {
        if emitter.dispatch_names[i] == m_name and emitter.dispatch_arities[i] == arity {
            return
        }
    }
    emitter.dispatch_names.append(m_name)
    emitter.dispatch_arities.append(arity)
    let mut sig = "WVal v_self"
    for ai in 0..arity {
        sig = sig + ", WVal _a" + str(ai)
    }
    emitter.dispatch_protos.append("static WVal wysna_dispatch__" + m_name + "__" + str(arity) + "(" + sig + ");")
}

fn op_precedence(k: str) -> int {
    if k == "ASSIGN" {
        return 1
    }
    if k == "QQ" {
        return 2
    }
    if k == "OR" {
        return 3
    }
    if k == "AND" {
        return 4
    }
    if k == "EQ" or k == "NEQ" or k == "LT" or k == "LTE" or k == "GT" or k == "GTE" {
        return 6
    }
    if k == "DOT_DOT" or k == "DOT_DOT_EQ" {
        return 7
    }
    if k == "PLUS" or k == "MINUS" {
        return 8
    }
    if k == "STAR" or k == "SLASH" or k == "PERCENT" {
        return 9
    }
    return 0
}

fn clean_lref(raw: str) -> str {
    let n = len(raw)
    if n < 2 {
        return raw
    }
    for i in 0..n - 1 {
        if slice(raw, i, i + 2) == "::" {
            return slice(raw, 0, i)
        }
    }
    return raw
}

fn extract_module_ns(path: str) -> str {
    let n = len(path)
    let mut slash = -1
    let mut dot = n
    for i in 0..n {
        if path[i] == "/" {
            slash = i
        } elif path[i] == "." {
            dot = i
        }
    }
    return slice(path, slash + 1, dot)
}

fn bind_call(emitter: CEmitter, c_call: str) -> ExprRes {
    let tmp = new_temp(emitter)
    declare_owned_var(emitter, tmp, c_call)
    return ExprRes { val: tmp, lref: "" }
}
