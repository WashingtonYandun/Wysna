# Standalone dev unit entrypoint for `wysna-compiler-core` (01..08 without 09_* tooling).

fn run_compiler_core() -> unit ! IoError {
    let raw_cli = args()
    let clean = diag_clean_cli_args()
    if len(clean) == 0 {
        eprint("[W5002] Usage: wysna-compiler-core [--emit-c-mir|--emit-mir|--check-mir] INPUT [OUTPUT]")
        exit(2)
    }
    let mut cli: list[str] = [raw_cli[0]]
    for item in clean { cli.append(item) }
    if len(cli) > 1 and (cli[1] == "--emit-mir" or cli[1] == "--emit-c-mir" or cli[1] == "--check-mir") {
        if (len(cli) != 3 and len(cli) != 4) or (cli[1] == "--check-mir" and len(cli) != 3) {
            eprint("[W5002] Usage: wysna-compiler-core --emit-mir INPUT [OUTPUT]")
            exit(2)
        }
        let source = read_file(cli[2])?
        let module = mir_build(check_source(source, cli[2]))
        if cli[1] == "--check-mir" { mir_verify(module) }
        else {
            let output = if cli[1] == "--emit-mir" { mir_module_json(module) } else { mir_emit_c(module) }
            if len(cli) == 4 {
                if module_normalize(cli[2]) == module_normalize(cli[3]) {
                    eprint("[W5002] Output must differ from input")
                    exit(2)
                }
                write_file(cli[3], output)?
            } else { print(output) }
        }
        return
    }
    if len(cli) != 3 { eprint("[W5002] Usage: wysna-compiler-core INPUT OUTPUT") exit(2) }
    let in_path = cli[1]
    let out_path = cli[2]
    if module_normalize(in_path) == module_normalize(out_path) {
        eprint("[W5002] Output must differ from input")
        exit(2)
    }
    let src = read_file(in_path)?
    let checked = check_source(src, in_path)
    let c_code = compile_source(checked)
    write_file(out_path, c_code)?
}

let res = run_compiler_core() else err {
    eprint("[W4003] wysna-compiler-core I/O error:", err.message)
    exit(1)
}
