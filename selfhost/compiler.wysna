fn line_terminates_statement(kind: str) -> bool {
    return kind == "INT" or kind == "FLOAT" or kind == "STR" or kind == "TRUE" or kind == "FALSE" or kind == "IDENT" or kind == "THIS" or kind == "SUPER" or kind == "RPAREN" or kind == "RBRACKET" or kind == "RBRACE" or kind == "QUESTION" or kind == "BREAK" or kind == "CONTINUE"
}

fn keyword_kind(word: str) -> str {
    if word == "as" { return "AS" }
    if word == "pub" { return "PUB" }
