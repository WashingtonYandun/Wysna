struct Token {
    kind: str,
    val: str,
    line: int,
    col: int,
    file: str,
}

# Standalone semantic parsing. Types are interned structures, never fixture names.
struct SemType { kind: str, name: str, args: list[int] }
struct SemGenericType { name: str, kind: str, params: list[str] }
struct SemVar { name: str, type_id: int, mutable: bool, depth: int, binding: int }
struct SemFunction { abi_params: list[str], abi_return: str, name: str, params: list[str], type_params: list[str], constraints: list[str], type_id: int, body: int, end: int, owner: str, visible: bool }
struct SemField { owner: str, name: str, type_id: int, visible: bool }
struct SemClass { name: str, parent: str, interfaces: list[str] }
struct SemValue { type_id: int, root: str, writable: int, terminates: bool, node: int }
struct SemFlow { type_id: int, terminates: bool, node: int }


struct SemPattern { name: str, children: list[int], type_id: int, binding: int, source: Token }
struct SemConstructor { name: str, payloads: list[int] }

struct SemObligation { function: str, kind: str, types: list[int], source: Token }
struct SemSpecialization { template: int, arguments: list[int], function: int, ancestry: list[int] }

# Each inference operation owns its substitutions, including nested initializers.
class SemUnification { names: list[str], types: list[int] }
fn report_error(file: str, code: str, line: int, col: int, msg: str) -> unit {
    eprint("[" + code + "] " + file + ":" + str(line) + ":" + str(col) + " - " + msg)
    exit(1)
}

fn report_error_at(code: str, token: Token, msg: str) -> unit {
    report_error(token.file, code, token.line, token.col, msg)
}

fn report_error_at_location(code: str, file: str, line: int, col: int, msg: str) -> unit {
    report_error(file, code, line, col, msg)
}

fn is_alpha(c: int) -> bool {
    return c >= 65 and c <= 90 or c >= 97 and c <= 122 or c == 95
}

fn is_digit(c: int) -> bool {
    return c >= 48 and c <= 57
}

fn is_alnum(c: int) -> bool {
    return is_alpha(c) or is_digit(c)
}

fn is_space(c: int) -> bool {
    return c == 32 or c == 9 or c == 10 or c == 13
}

fn line_terminates_statement(kind: str) -> bool {
    return kind == "INT" or kind == "FLOAT" or kind == "STR" or kind == "TRUE" or kind == "FALSE" or kind == "NONE" or kind == "IDENT" or kind == "THIS" or kind == "SUPER" or kind == "RPAREN" or kind == "RBRACKET" or kind == "RBRACE" or kind == "QUESTION" or kind == "BREAK" or kind == "CONTINUE"
}

fn hex_val(c: int) -> int {
    if c >= 48 and c <= 57 {
        return c - 48
    }
    if c >= 65 and c <= 70 {
        return c - 55
    }
    if c >= 97 and c <= 102 {
        return c - 87
    }
    return 0
}

fn keyword_kind(word: str) -> str {
    if word == "as" { return "AS" }
    if word == "pub" { return "PUB" }
    if word == "extern" { return "EXTERN" }
    if word == "fn" {
        return "FN"
    }
    if word == "let" {
        return "LET"
    }
    if word == "mut" {
        return "MUT"
    }
    if word == "struct" {
        return "STRUCT"
    }
    if word == "enum" {
        return "ENUM"
    }
    if word == "class" {
        return "CLASS"
    }
    if word == "interface" {
        return "INTERFACE"
    }
    if word == "extends" {
        return "EXTENDS"
    }
    if word == "implements" {
        return "IMPLEMENTS"
    }
    if word == "new" {
        return "NEW"
    }
    if word == "this" {
        return "THIS"
    }
    if word == "super" {
        return "SUPER"
    }
    if word == "public" {
        return "PUBLIC"
    }
    if word == "private" {
        return "PRIVATE"
    }
    if word == "if" {
        return "IF"
    }
    if word == "elif" {
        return "ELIF"
    }
    if word == "else" {
        return "ELSE"
    }
    if word == "for" {
        return "FOR"
    }
    if word == "while" {
        return "WHILE"
    }
    if word == "in" {
        return "IN"
    }
    if word == "match" {
        return "MATCH"
    }
    if word == "return" {
        return "RETURN"
    }
    if word == "break" {
        return "BREAK"
    }
    if word == "continue" {
        return "CONTINUE"
    }
    if word == "import" {
        return "IMPORT"
    }
    if word == "true" {
        return "TRUE"
    }
    if word == "false" {
        return "FALSE"
    }
    if word == "none" {
        return "NONE"
    }
    if word == "and" {
        return "AND"
    }
    if word == "or" {
        return "OR"
    }
    if word == "not" {
        return "NOT"
    }
    return "IDENT"
}

fn tokenize(src: str, file: str) -> list[Token] {
    let mut tokens: list[Token] = []
    let n = len(src)
    let mut i = 0
    let mut line = 1
    let mut col = 1
    let mut paren_depth = 0
    let mut bracket_depth = 0
    while i < n {
        let ch = src[i]
        let code = ord(ch)
        if code == 10 or code == 13 {
            if paren_depth == 0 and bracket_depth == 0 and len(tokens) > 0 and line_terminates_statement(tokens[len(tokens) - 1].kind) {
                tokens.append(Token { kind: "NEWLINE", val: "\n", line: line, col: col, file: file })
            }
            line = line + 1
            col = 1
            i = i + 1
            if code == 13 and i < n and ord(src[i]) == 10 {
                i = i + 1
            }
        } elif is_space(code) {
            col = col + 1
            i = i + 1
        } elif ch == "#" {
            while i < n and ord(src[i]) != 10 and ord(src[i]) != 13 {
                i = i + 1
                col = col + 1
            }
        } elif is_alpha(code) {
            let start = i
            let start_col = col
            while i < n and is_alnum(ord(src[i])) {
                i = i + 1
                col = col + 1
            }
            let word = slice(src, start, i)
            let k = keyword_kind(word)
            tokens.append(Token { kind: k, val: word, line: line, col: start_col, file: file })
        } elif is_digit(code) {
            let start_col = col
            let mut is_flt = false
            let mut clean_num = ""
            let mut last_was_under = false
            let mut sep_err = false
            while i < n and (is_digit(ord(src[i])) or src[i] == "_") {
                if src[i] == "_" {
                    if last_was_under {
                        sep_err = true
                    }
                    last_was_under = true
                } else {
                    last_was_under = false
                    clean_num = clean_num + src[i]
                }
                i = i + 1
                col = col + 1
            }
            if last_was_under or sep_err {
                report_error(file, "W0002", line, start_col, "malformed numeric separator")
            }
            if i + 1 < n and src[i] == "." and is_digit(ord(src[i + 1])) {
                is_flt = true
                clean_num = clean_num + "."
                i = i + 1
                col = col + 1
                while i < n and (is_digit(ord(src[i])) or src[i] == "_") {
                    if src[i] == "_" {
                        if last_was_under {
                            sep_err = true
                        }
                        last_was_under = true
                    } else {
                        last_was_under = false
                        clean_num = clean_num + src[i]
                    }
                    i = i + 1
                    col = col + 1
                }
                if last_was_under or sep_err {
                    report_error(file, "W0002", line, start_col, "malformed numeric separator")
                }
            } elif i < n and src[i] == "." and not (i + 1 < n and src[i + 1] == ".") {
                report_error(file, "W0002", line, start_col, "malformed float literal: trailing dot")
            }
            if is_flt {
                tokens.append(Token { kind: "FLOAT", val: clean_num, line: line, col: start_col, file: file })
            } else {
                tokens.append(Token { kind: "INT", val: clean_num, line: line, col: start_col, file: file })
            }
        } elif ch == "." and i + 1 < n and is_digit(ord(src[i + 1])) {
            report_error(file, "W0002", line, col, "malformed float literal: leading dot")
        } elif ch == "\"" {
            let start_col = col
            let start_line = line
            i = i + 1
            col = col + 1
            let mut s_val = ""
            while i < n and src[i] != "\"" {
                if src[i] == "\\" {
                    if i + 1 >= n {
                        report_error(file, "W0004", line, col, "unterminated string escape")
                    }
                    i = i + 1
                    col = col + 1
                    let esc = src[i]
                    if esc == "n" {
                        s_val = s_val + "\n"
                        i = i + 1
                        col = col + 1
                    } elif esc == "r" {
                        s_val = s_val + "\r"
                        i = i + 1
                        col = col + 1
                    } elif esc == "t" {
                        s_val = s_val + "\t"
                        i = i + 1
                        col = col + 1
                    } elif esc == "\\" {
                        s_val = s_val + "\\"
                        i = i + 1
                        col = col + 1
                    } elif esc == "\"" {
                        s_val = s_val + "\""
                        i = i + 1
                        col = col + 1
                    } elif esc == "0" {
                        s_val = s_val + chr(0)
                        i = i + 1
                        col = col + 1
                    } elif esc == "u" {
                        if i + 1 >= n or src[i + 1] != "{" {
                            report_error(file, "W0005", line, col - 1, "invalid Unicode scalar escape sequence")
                        }
                        i = i + 2
                        col = col + 2
                        let mut u_cp = 0
                        let mut has_hex = false
                        let mut valid_hex = true
                        while i < n and src[i] != "}" {
                            let hcode = ord(src[i])
                            if not (hcode >= 48 and hcode <= 57 or hcode >= 65 and hcode <= 70 or hcode >= 97 and hcode <= 102) {
                                valid_hex = false
                            }
                            u_cp = u_cp * 16 + hex_val(hcode)
                            has_hex = true
                            i = i + 1
                            col = col + 1
                        }
                        if i >= n or src[i] != "}" or not has_hex or not valid_hex {
                            report_error(file, "W0005", line, col, "invalid Unicode scalar escape sequence")
                        }
                        i = i + 1
                        col = col + 1
                        s_val = s_val + chr(u_cp)
                    } else {
                        report_error(file, "W0004", line, col - 1, "invalid string escape sequence")
                    }
                } else {
                    s_val = s_val + src[i]
                    i = i + 1
                    col = col + 1
                }
            }
            if i >= n {
                report_error(file, "W0003", start_line, start_col, "unterminated string literal")
            }
            i = i + 1
            col = col + 1
            tokens.append(Token { kind: "STR", val: s_val, line: start_line, col: start_col, file: file })
        } else {
            let start_col = col
            let mut two = ""
            let mut three = ""
            if i + 1 < n {
                two = slice(src, i, i + 2)
            }
            if i + 2 < n {
                three = slice(src, i, i + 3)
            }
            if three == "..=" {
                tokens.append(Token { kind: "DOT_DOT_EQ", val: "..=", line: line, col: start_col, file: file })
                i = i + 3
                col = col + 3
            } elif two == "==" {
                tokens.append(Token { kind: "EQ", val: "==", line: line, col: start_col, file: file })
                i = i + 2
                col = col + 2
            } elif two == "!=" {
                tokens.append(Token { kind: "NEQ", val: "!=", line: line, col: start_col, file: file })
                i = i + 2
                col = col + 2
            } elif two == "<=" {
                tokens.append(Token { kind: "LTE", val: "<=", line: line, col: start_col, file: file })
                i = i + 2
                col = col + 2
            } elif two == ">=" {
                tokens.append(Token { kind: "GTE", val: ">=", line: line, col: start_col, file: file })
                i = i + 2
                col = col + 2
            } elif two == "->" {
                tokens.append(Token { kind: "ARROW", val: "->", line: line, col: start_col, file: file })
                i = i + 2
                col = col + 2
            } elif two == "=>" {
                tokens.append(Token { kind: "FAT_ARROW", val: "=>", line: line, col: start_col, file: file })
                i = i + 2
                col = col + 2
            } elif two == ".." {
                tokens.append(Token { kind: "DOT_DOT", val: "..", line: line, col: start_col, file: file })
                i = i + 2
                col = col + 2
            } elif two == "??" {
                tokens.append(Token { kind: "QQ", val: "??", line: line, col: start_col, file: file })
                i = i + 2
                col = col + 2
            } else {
                let mut kind = "OP"
                if ch == "|" { kind = "PIPE"
                } elif ch == "(" {
                    kind = "LPAREN"
                } elif ch == ")" {
                    kind = "RPAREN"
                } elif ch == "{" {
                    kind = "LBRACE"
                } elif ch == "}" {
                    kind = "RBRACE"
                } elif ch == "[" {
                    kind = "LBRACKET"
                } elif ch == "]" {
                    kind = "RBRACKET"
                } elif ch == "," {
                    kind = "COMMA"
                } elif ch == ";" {
                    kind = "SEMICOLON"
                } elif ch == ":" {
                    kind = "COLON"
                } elif ch == "." {
                    kind = "DOT"
                } elif ch == "+" {
                    kind = "PLUS"
                } elif ch == "-" {
                    kind = "MINUS"
                } elif ch == "*" {
                    kind = "STAR"
                } elif ch == "/" {
                    kind = "SLASH"
                } elif ch == "%" {
                    kind = "PERCENT"
                } elif ch == "=" {
                    kind = "ASSIGN"
                } elif ch == "<" {
                    kind = "LT"
                } elif ch == ">" {
                    kind = "GT"
                } elif ch == "!" {
                    kind = "BANG"
                } elif ch == "?" {
                    kind = "QUESTION"
                }
                if kind == "OP" {
                    report_error(file, "W0001", line, start_col, "unexpected character '" + ch + "'")
                }
                tokens.append(Token { kind: kind, val: ch, line: line, col: start_col, file: file })
                if kind == "LPAREN" { paren_depth = paren_depth + 1
                } elif kind == "RPAREN" { if paren_depth > 0 { paren_depth = paren_depth - 1 }
                } elif kind == "LBRACKET" { bracket_depth = bracket_depth + 1
                } elif kind == "RBRACKET" { if bracket_depth > 0 { bracket_depth = bracket_depth - 1 } }
                i = i + 1
                col = col + 1
            }
        }
    }
    tokens.append(Token { kind: "EOF", val: "", line: line, col: col, file: file })
    return tokens
}
# Pure source syntax policy shared by module binding and semantic parsing.
fn expression_starter(kind: str) -> bool {
    return kind == "INT" or kind == "FLOAT" or kind == "STR" or kind == "TRUE" or kind == "FALSE" or kind == "NONE" or kind == "IDENT" or kind == "THIS" or kind == "SUPER" or kind == "NEW" or kind == "MINUS" or kind == "NOT" or kind == "LPAREN" or kind == "LBRACKET" or kind == "LBRACE" or kind == "PIPE" or kind == "IF" or kind == "MATCH"
}

fn op_precedence(k: str) -> int {
    if k == "ASSIGN" {
        return 1
    }
    if k == "QQ" {
        return 2
    }
    if k == "OR" {
        return 3
    }
    if k == "AND" {
        return 4
    }
    if k == "EQ" or k == "NEQ" or k == "LT" or k == "LTE" or k == "GT" or k == "GTE" {
        return 6
    }
    if k == "DOT_DOT" or k == "DOT_DOT_EQ" {
        return 7
    }
    if k == "PLUS" or k == "MINUS" {
        return 8
    }
    if k == "STAR" or k == "SLASH" or k == "PERCENT" {
        return 9
    }
    return 0
}

fn extract_module_ns(path: str) -> str {
    let n = len(path)
    let mut slash = -1
    let mut dot = n
    for i in 0..n {
        if path[i] == "/" {
            slash = i
        } elif path[i] == "." {
            dot = i
        }
    }
    return slice(path, slash + 1, dot)
}
# The compiler owns canonicalization buffers; no path storage crosses the ABI.
extern "C" fn wysna_host_buffer_new() -> opaque
extern "C" fn wysna_host_buffer_append(handle: opaque, value: int) -> int
extern "C" fn wysna_host_buffer_get(handle: opaque, index: int) -> int
extern "C" fn wysna_host_fs_canonical(path: opaque, output: opaque) -> int
extern "C" fn wysna_host_close(handle: opaque) -> int

fn module_canonical(path: str) -> str {
    let input = wysna_host_buffer_new()
    let output = wysna_host_buffer_new()
    for byte in bytes(path) { wysna_host_buffer_append(input, byte) }
    let size = wysna_host_fs_canonical(input, output)
    let mut parts: list[str] = []
    let mut index = 0
    if size >= 0 {
        while index < size {
            let first = wysna_host_buffer_get(output, index)
            let width = if first < 128 { 1 } elif first < 224 { 2 } elif first < 240 { 3 } else { 4 }
            let mut codepoint = if width == 1 { first } elif width == 2 { first % 32 } elif width == 3 { first % 16 } else { first % 8 }
            for offset in 1..width { codepoint = codepoint * 64 + wysna_host_buffer_get(output, index + offset) % 64 }
            parts.append(chr(codepoint))
            index = index + width
        }
    }
    wysna_host_close(input)
    wysna_host_close(output)
    return module_normalize(if size >= 0 { join_strings(parts, "") } else { path })
}

# An import graph belongs to one source expansion.
class ModuleLoader {
    paths: list[str]
    states: list[int]
    public_names: list[list[str]]
    all_names: list[list[str]]
    import_owners: list[int]
    import_aliases: list[str]
    import_targets: list[int]
    import_public: list[bool]
    output: list[Token]
    fn init() {
        let initial_paths: list[str] = []
        this.paths = initial_paths
        let initial_states: list[int] = []
        this.states = initial_states
        let initial_public_names: list[list[str]] = []
        this.public_names = initial_public_names
        let initial_all_names: list[list[str]] = []
        this.all_names = initial_all_names
        let initial_import_owners: list[int] = []
        this.import_owners = initial_import_owners
        let initial_import_aliases: list[str] = []
        this.import_aliases = initial_import_aliases
        let initial_import_targets: list[int] = []
        this.import_targets = initial_import_targets
        let initial_import_public: list[bool] = []
        this.import_public = initial_import_public
        let initial_output: list[Token] = []
        this.output = initial_output
    }
}
# Module expansion shares one token stream with the standalone semantic checker.

fn module_normalize(path: str) -> str {
    let mut parts: list[str] = []
    let mut part = ""
    for i in 0..len(path) + 1 {
        let mut ch = "/"
        if i < len(path) { ch = path[i] }
        if ch == "\\" { ch = "/" }
        if ch == "/" {
            if part == ".." and len(parts) > 0 { parts.pop() }
            elif part != "" and part != "." { parts.append(part) }
            part = ""
        } else { part = part + ch }
    }
    let mut result = ""
    if len(path) > 0 and (path[0] == "/" or path[0] == "\\") { result = "/" }
    if len(path) > 1 and (path[0] == "/" or path[0] == "\\") and (path[1] == "/" or path[1] == "\\") { result = "//" }
    for i in 0..len(parts) {
        if i > 0 { result = result + "/" }
        result = result + parts[i]
    }
    return result
}
fn module_directory(path: str) -> str {
    let mut boundary = -1
    for i in 0..len(path) { if path[i] == "/" { boundary = i } }
    if boundary < 0 { return "" }
    return slice(path, 0, boundary + 1)
}
fn module_name(index: int, name: str) -> str { return "__wysna_module_" + str(index) + "__" + name }
fn module_contains(names: list[str], name: str) -> bool {
    for candidate in names { if candidate == name { return true } }
    return false
}
fn module_stdlib_path(requested: str) -> str {
    let relative = "stdlib/" + slice(requested, 4, len(requested)) + ".wysna"
    let arguments = args()
    if len(arguments) > 2 and arguments[1] == "--stdlib-root" {
        return module_normalize(arguments[2] + "/" + slice(requested, 4, len(requested)) + ".wysna")
    }
    let mut directory = module_directory(module_normalize(arguments[0]))
    while directory != "" {
        let candidate = module_normalize(directory + relative)
        let content = read_file(candidate) else error { "" }
        if content != "" { return candidate }
        let parent = module_directory(slice(directory, 0, len(directory) - 1))
        if parent == directory { break }
        directory = parent
    }
    return relative
}
fn module_expand(context: ModuleLoader, src: str, path: str, entry: bool) -> int {
    let canonical = module_canonical(path)

    for i in 0..len(context.paths) {
        if context.paths[i] == canonical {
            if context.states[i] == 1 { report_error(canonical, "W1003", 1, 1, "circular import: " + canonical) }
            return i
        }
    }
    let index = len(context.paths)
    context.paths.append(canonical)
    context.states.append(1)
    let mut names: list[str] = []
    let mut exports: list[str] = []
    let tokens = tokenize(src, canonical)
    for token in tokens {
        if token.kind == "IDENT" {
            if (len(token.val) >= 8 and slice(token.val, 0, 8) == "__wysna_") or (len(token.val) >= 7 and slice(token.val, 0, 7) == "_WYSNA_") { report_error_at("W1002", token, "reserved compiler namespace") }
        }
    }
    let mut depth = 0
    let mut exported = false
    for i in 0..len(tokens) - 1 {
        let kind = tokens[i].kind
        if depth == 0 {
            if kind == "PUB" { exported = true }
            elif kind == "FN" or kind == "STRUCT" or kind == "ENUM" or kind == "CLASS" or kind == "INTERFACE" or kind == "LET" {
                let mut offset = 1
                if kind == "LET" and tokens[i + 1].kind == "MUT" { offset = 2 }
                let name = tokens[i + offset].val
                names.append(name)
                if exported { exports.append(name) }
                exported = false
            }
        }
        if kind == "LBRACE" { depth = depth + 1 }
        if kind == "RBRACE" { depth = depth - 1 }
    }
    context.all_names.append(names)
    context.public_names.append(exports)
    let mut aliases: list[str] = []
    let mut dependencies: list[int] = []
    let mut body: list[Token] = []
    let mut position = 0
    while position < len(tokens) - 1 {
        let token = tokens[position]

        if token.kind == "IMPORT" {
            let public_import = position > 0 and tokens[position - 1].kind == "PUB"
            if public_import and len(body) > 0 and body[len(body) - 1].kind == "PUB" { body.pop() }
            let requested = tokens[position + 1].val
            let mut resolved = module_normalize(module_directory(canonical) + requested)
            if len(requested) >= 4 and slice(requested, 0, 4) == "std/" { resolved = module_stdlib_path(requested) }
            let mut content = read_file(resolved) else err { "" }
            if content == "" {
                resolved = module_normalize(requested)
                content = read_file(resolved) else err { report_error_at("W1003", token, "module not found: " + requested) "" }
            }
            let dependency = module_expand(context, content, resolved, false)
            let mut alias = extract_module_ns(requested)
            position = position + 2
            if tokens[position].kind == "AS" { alias = tokens[position + 1].val position = position + 2 }
            if module_contains(aliases, alias) or module_contains(names, alias) { report_error_at("W1002", token, "duplicate module alias") }
            aliases.append(alias)
            dependencies.append(dependency)
            context.import_owners.append(index)
            context.import_aliases.append(alias)
            context.import_targets.append(dependency)
            context.import_public.append(public_import)
            if public_import { context.public_names[index].append(alias) }
        } else {
            body.append(token)
            position = position + 1
        }
    }
    position = 0
    let mut braces = 0
    let mut parentheses = 0
    while position < len(body) {
        let token = body[position]

        let mut consumed = false
        if token.kind == "IDENT" {
            for i in 0..len(aliases) {
                if token.val == aliases[i] and position + 2 < len(body) and body[position + 1].kind == "DOT" {
                    let member = body[position + 2]
                    let dependency = dependencies[i]
                    let mut nested_target = -1
                    for import_index in 0..len(context.import_owners) {
                        if context.import_owners[import_index] == dependency and context.import_aliases[import_index] == member.val and context.import_public[import_index] { nested_target = context.import_targets[import_index] }
                    }
                    if nested_target >= 0 and position + 4 < len(body) and body[position + 3].kind == "DOT" {
                        let nested_member = body[position + 4]
                        if not module_contains(context.public_names[nested_target], nested_member.val) { report_error_at("W1001", nested_member, "member is not exported: " + nested_member.val) }
                        context.output.append(Token { kind: "IDENT", val: module_name(nested_target, nested_member.val), line: token.line, col: token.col, file: token.file })
                        position = position + 5
                    } else {
                        if not module_contains(context.public_names[dependency], member.val) { report_error_at("W1001", member, "member is not exported: " + member.val) }
                        context.output.append(Token { kind: "IDENT", val: module_name(dependency, member.val), line: token.line, col: token.col, file: token.file })
                        position = position + 3
                    }
                    consumed = true
                }
            }
            if not consumed and not entry and module_contains(names, token.val) {
                let mut field = false
                if position > 0 and body[position - 1].kind == "DOT" { field = true }
                if position + 1 < len(body) and body[position + 1].kind == "COLON" and parentheses == 0 {
                    field = true
                    if position > 0 and (body[position - 1].kind == "LET" or body[position - 1].kind == "MUT") { field = false }
                }
                if braces > 0 and position > 0 and body[position - 1].kind == "FN" { field = true }
                if not field { context.output.append(Token { kind: token.kind, val: module_name(index, token.val), line: token.line, col: token.col, file: token.file }) consumed = true position = position + 1 }
            }
        }
        if not consumed { context.output.append(token) position = position + 1 }
        if token.kind == "LBRACE" { braces = braces + 1 }
        if token.kind == "RBRACE" { braces = braces - 1 }
        if token.kind == "LPAREN" { parentheses = parentheses + 1 }
        if token.kind == "RPAREN" { parentheses = parentheses - 1 }
    }
    context.states[index] = 2
    return index
}
fn module_tokens(src: str, path: str) -> list[Token] {
    let context = new ModuleLoader()
    module_expand(context, src, path, true)
    context.output.append(Token { kind: "EOF", val: "", line: 1, col: 1, file: module_normalize(path) })
    return context.output
}
# Explicit scalar/opaque ABI policy; no source traversal or emission context.
fn foreign_native_name(name: str) -> str {
    let prefix = "__wysna_module_"
    if len(name) > len(prefix) and slice(name, 0, len(prefix)) == prefix {
        for i in len(prefix)..len(name) - 1 { if slice(name, i, i + 2) == "__" { return slice(name, i + 2, len(name)) } }
    }
    return name
}
fn foreign_c_type(name: str, returned: bool, source: Token) -> str {
    if name == "int32" { return "int32_t" }
    if name == "int" or name == "int64" { return "int64_t" }
    if name == "float" or name == "double" { return "double" }
    if name == "bool" { return "bool" }
    if name == "opaque" { return "void*" }
    if name == "unit" and returned { return "void" }
    report_error_at("W2001", source, "unsupported C ABI type")
    return "void"
}
fn foreign_type_id(name: str) -> str {
    if name == "int" or name == "int32" or name == "int64" { return "int" }
    if name == "float" or name == "double" { return "float" }
    return name
}
fn check_delimiters(tokens: list[Token]) -> unit {
    let mut delim_kinds: list[str] = []
    let mut delim_tokens: list[Token] = []
    for tok in tokens {
        let k = tok.kind
        if k == "LPAREN" or k == "LBRACE" or k == "LBRACKET" {
            delim_kinds.append(k)
            delim_tokens.append(tok)
        } elif k == "RPAREN" {
            let dl = len(delim_kinds)
            if dl == 0 {
                report_error_at("W0001", tok, "unexpected ')'")
            }
            let top = delim_kinds[dl - 1]
            if top != "LPAREN" {
                report_error_at("W0001", tok, "mismatched delimiter ')'")
            }
            delim_kinds.pop()
            delim_tokens.pop()
        } elif k == "RBRACKET" {
            let dl = len(delim_kinds)
            if dl == 0 {
                report_error_at("W0006", tok, "unexpected ']'")
            }
            let top = delim_kinds[dl - 1]
            if top != "LBRACKET" {
                report_error_at("W0006", tok, "mismatched delimiter ']'")
            }
            delim_kinds.pop()
            delim_tokens.pop()
        } elif k == "RBRACE" {
            let dl = len(delim_kinds)
            if dl == 0 {
                report_error_at("W0006", tok, "unexpected '}'")
            }
            let top = delim_kinds[dl - 1]
            if top == "LPAREN" {
                report_error_at("W0006", tok, "expected ')' before '}'")
            }
            if top != "LBRACE" {
                report_error_at("W0006", tok, "mismatched delimiter '}'")
            }
            delim_kinds.pop()
            delim_tokens.pop()
        }
    }
    if len(delim_kinds) > 0 {
        let top_idx = len(delim_kinds) - 1
        let top_k = delim_kinds[top_idx]
        if top_k == "LBRACE" {
            report_error_at("W0006", delim_tokens[top_idx], "unclosed delimiter '{'")
        } elif top_k == "LPAREN" {
            report_error_at("W0006", delim_tokens[top_idx], "unclosed delimiter '('")
        } elif top_k == "LBRACKET" {
            report_error_at("W0006", delim_tokens[top_idx], "unclosed delimiter '['")
        }
    }
}

fn check_program(tokens: list[Token], file: str, capture: bool) -> CheckedProgram {
    check_delimiters(tokens)
    let context = new SemanticContext(capture)
    sem_validate(context, tokens)
    sem_complete_specializations(context)
    return checked_finish(context, tokens, file)
}

fn check_source(src: str, in_path: str) -> CheckedProgram {
    let file = module_canonical(in_path)
    let checked = check_program(module_tokens(src, file), file, true)
    for node in checked.nodes { if node.kind == "unsupported" { report_error_at("W2013", node.source, "Compiler native-core-v1 does not support expression " + node.text) } }
    return checked
}

fn compile_source(checked: CheckedProgram) -> str { return mir_emit_c(mir_build(checked)) }
# Session-local node and binding IDs belong to this value's type arena.
struct CheckedField { name: str, type_id: int, visible: bool }
struct CheckedVariant { name: str, payloads: list[int] }
struct CheckedMethod { name: str, type_id: int, target: int, owner: int, visible: bool }
struct CheckedRecord { type_id: int, fields: list[CheckedField], variants: list[CheckedVariant], parent: int, interfaces: list[int], methods: list[CheckedMethod] }
struct CheckedArm { pattern: int, guard: int, body: int, source: Token }
struct CheckedNode { pattern: int, arms: list[int], total: bool, labels: list[str], kind: str, type_id: int, source: Token, text: str, children: list[int], binding: int, target: int, discard: bool }
struct CheckedBinding { name: str, type_id: int, mutable: bool, global: bool, source: Token }
struct CheckedFunction { captures: list[int], closure: bool, name: str, type_id: int, params: list[int], body: int, source: Token }
struct CheckedSignature { abi_params: list[str], abi_return: str, native: str, name: str, params: list[str], type_params: list[str], type_id: int, foreign: bool, abstract: bool }
struct CheckedProgram {
    templates: list[SemGenericType], obligations: list[SemObligation], has_nodes: bool, file: str, source: Token, records: list[CheckedRecord], types: list[SemType], signatures: list[CheckedSignature],
    patterns: list[SemPattern], arms: list[CheckedArm], nodes: list[CheckedNode], bindings: list[CheckedBinding], functions: list[CheckedFunction], entry: list[int], unit_type: int,
}

struct SemanticScope { variables: int, depth: int }

# Reference identity is deliberate: each checker invocation owns one context.
class SemanticContext {
    capture_nodes: bool
    checking_definition: bool
    obligations: list[SemObligation]
    specializations: list[SemSpecialization]
    specialization_ancestry: list[int]
    substitution_names: list[str]
    substitution_types: list[int]
    tokens: list[Token]
    pos: int
    types: list[SemType]
    generic_types: list[SemGenericType]
    type_params: list[str]
    active_constraints: list[str]
    variables: list[SemVar]
    functions: list[SemFunction]
    fields: list[SemField]
    classes: list[SemClass]
    variants: list[str]
    variant_types: list[int]
    variant_payloads: list[list[int]]
    depth: int
    return_type: int
    owner: str
    current_function: str
    layout_seen: list[str]
    loop: int
    integer_type: int
    float_type: int
    boolean_type: int
    string_type: int
    unit_type: int
    none_type: int
    initializing: bool
    initialized: list[str]
    capture_names: list[str]
    capture_depth: int
    statement_context: bool
    patterns: list[SemPattern]
    arms: list[CheckedArm]
    last_pattern: int
    expected_type: int
    nodes: list[CheckedNode]
    symbols: list[CheckedBinding]
    checked_functions: list[CheckedFunction]
    top_nodes: list[int]
    fn init(capture: bool) {
        let initial_tokens: list[Token] = []
        this.tokens = initial_tokens
        this.pos = 0
        let initial_types: list[SemType] = []
        this.types = initial_types
        let initial_generic_types: list[SemGenericType] = []
        this.generic_types = initial_generic_types
        let initial_type_params: list[str] = []
        this.type_params = initial_type_params
        let initial_active_constraints: list[str] = []
        this.active_constraints = initial_active_constraints
        let initial_variables: list[SemVar] = []
        this.variables = initial_variables
        let initial_functions: list[SemFunction] = []
        this.functions = initial_functions
        let initial_fields: list[SemField] = []
        this.fields = initial_fields
        let initial_classes: list[SemClass] = []
        this.classes = initial_classes
        let initial_variants: list[str] = []
        this.variants = initial_variants
        let initial_variant_types: list[int] = []
        this.variant_types = initial_variant_types
        let initial_variant_payloads: list[list[int]] = []
        this.variant_payloads = initial_variant_payloads
        this.depth = 0
        this.return_type = 0
        this.owner = ""
        this.current_function = ""
        let initial_layout_seen: list[str] = []
        this.layout_seen = initial_layout_seen
        this.loop = 0
        this.integer_type = 0
        this.float_type = 0
        this.boolean_type = 0
        this.string_type = 0
        this.unit_type = 0
        this.none_type = 0
        this.initializing = false
        let initial_initialized: list[str] = []
        this.initialized = initial_initialized
        let initial_capture_names: list[str] = []
        this.capture_names = initial_capture_names
        this.capture_depth = -1
        this.statement_context = false
        let initial_patterns: list[SemPattern] = []
        this.patterns = initial_patterns
        let initial_arms: list[CheckedArm] = []
        this.arms = initial_arms
        this.last_pattern = -1
        this.expected_type = -1
        this.checking_definition = false
        let obligations: list[SemObligation] = []
        this.obligations = obligations
        let specializations: list[SemSpecialization] = []
        this.specializations = specializations
        let ancestry: list[int] = []
        this.specialization_ancestry = ancestry
        let substitution_names: list[str] = []
        this.substitution_names = substitution_names
        let substitution_types: list[int] = []
        this.substitution_types = substitution_types
        this.capture_nodes = capture
        let initial_nodes: list[CheckedNode] = []
        this.nodes = initial_nodes
        let initial_symbols: list[CheckedBinding] = []
        this.symbols = initial_symbols
        let initial_checked_functions: list[CheckedFunction] = []
        this.checked_functions = initial_checked_functions
        let initial_top_nodes: list[int] = []
        this.top_nodes = initial_top_nodes
    }
}

fn sem_enter_scope(context: SemanticContext) -> SemanticScope {
    let scope = SemanticScope { variables: len(context.variables), depth: context.depth }
    context.depth = context.depth + 1
    return scope
}
fn sem_leave_scope(context: SemanticContext, scope: SemanticScope) {
    if len(context.variables) < scope.variables { report_error_at("W9999", context.tokens[context.pos], "invalid semantic scope checkpoint") }
    while len(context.variables) > scope.variables { context.variables.pop() }
    context.depth = scope.depth
}

fn sem_node(context: SemanticContext, kind: str, type_id: int, source: Token, text: str, children: list[int], binding: int, target: int) -> int {
    if not context.capture_nodes { return -1 }
    let id = len(context.nodes)
    let labels: list[str] = []
    let arms: list[int] = []
    context.nodes.append(CheckedNode { pattern: -1, arms: arms, total: false, labels: labels, kind: kind, type_id: type_id, source: source, text: text, children: children, binding: binding, target: target, discard: false })
    return id
}
fn sem_expr(context: SemanticContext, kind: str, value: SemValue, source: Token, text: str, children: list[int], binding: int, target: int) -> SemValue {
    if not context.capture_nodes { return value }
    let mut checked = value
    checked.node = sem_node(context, kind, value.type_id, source, text, children, binding, target)
    return checked
}
fn sem_mark_unit_tail(context: SemanticContext, id: int) {
    if not context.capture_nodes or id < 0 { return }
    let node = context.nodes[id]
    if node.kind == "block" {
        if len(node.children) > 0 { sem_mark_unit_tail(context, node.children[len(node.children) - 1]) }
    } elif node.kind == "if" {
        context.nodes[id].discard = true
        sem_mark_unit_tail(context, node.children[1])
        sem_mark_unit_tail(context, node.children[2])
    }
}
fn checked_function(program: CheckedProgram, name: str) -> int {
    for i in 0..len(program.signatures) { if program.signatures[i].name == name { return i } }
    return -1
}
fn checked_kind(program: CheckedProgram, type_id: int) -> str { return program.types[type_id].kind }
fn checked_unit_return(program: CheckedProgram, type_id: int) -> bool {
    return type_id == program.unit_type or type_id >= 0 and checked_kind(program, type_id) == "result" and program.types[type_id].args[0] == program.unit_type
}
fn checked_finish(context: SemanticContext, tokens: list[Token], file: str) -> CheckedProgram {
    let mut signatures: list[CheckedSignature] = []
    for function in context.functions {
        let mut params = function.params
        let mut type_id = function.type_id
        if function.owner != "" {
            let owner = sem_named(context, slice(function.owner, 0, len(function.owner) - 1))
            type_id = checked_receiver_signature(context, owner, type_id)
            params = ["self"]
            for name in function.params { params.append(name) }
        }
        signatures.append(CheckedSignature { abi_params: function.abi_params, abi_return: function.abi_return, native: foreign_native_name(function.name), name: function.name, params: params, type_params: function.type_params, type_id: type_id, foreign: function.body < 0 and function.owner == "", abstract: function.body < 0 and function.owner != "" })
    }
    let mut records: list[CheckedRecord] = []
    if context.capture_nodes { records = checked_records(context) }
    return CheckedProgram {
        templates: context.generic_types, obligations: context.obligations, records: records, has_nodes: context.capture_nodes, file: file, source: tokens[0], types: context.types, signatures: signatures,
        patterns: context.patterns, arms: context.arms, nodes: context.nodes, bindings: context.symbols, functions: context.checked_functions, entry: context.top_nodes,
        unit_type: context.unit_type,
    }
}
fn checked_type_concrete(types: list[SemType], templates: list[SemGenericType], id: int) -> bool {
    let type_ = types[id]
    if type_.kind == "typeparam" or type_.kind == "dependent" { return false }
    for argument in type_.args { if not checked_type_concrete(types, templates, argument) { return false } }
    for template in templates { if template.name == type_.name and len(template.params) != len(type_.args) { return false } }
    return true
}
fn checked_records(context: SemanticContext) -> list[CheckedRecord] {
    let mut records: list[CheckedRecord] = []
    let mut cursor = 0
    while cursor < len(context.types) {
        let id = cursor
        cursor = cursor + 1
        let type_ = context.types[id]
        if (type_.kind == "struct" or type_.kind == "enum" or type_.kind == "class" or type_.kind == "interface") and checked_type_concrete(context.types, context.generic_types, id) {
            let mut fields: list[CheckedField] = []
            let mut variants: list[CheckedVariant] = []
            let mut methods: list[CheckedMethod] = []
            let mut interfaces: list[int] = []
            let mut parent = -1
            let mut lineage: list[str] = [type_.name]
            let mut current = type_.name
            let mut visits = 0
            while current != "" and visits <= len(context.classes) {
                let mut next = ""
                for class_ in context.classes { if class_.name == current { next = class_.parent if current == type_.name { for interface_ in class_.interfaces { interfaces.append(sem_named(context, interface_)) } } } }
                if next != "" { if parent < 0 { parent = sem_named(context, next) } lineage.append(next) }
                current = next visits = visits + 1
            }
            let mut names: list[str] = []
            let generic = sem_generic_type(context, type_.name)
            if generic >= 0 { names = context.generic_types[generic].params }
            let mut owner_index = len(lineage) - 1
            while owner_index >= 0 {
                let owner_name = lineage[owner_index]
                for field in context.fields {
                    if field.owner == owner_name { fields.append(CheckedField { name: field.name, type_id: sem_substitute_type(context, field.type_id, names, type_.args), visible: field.visible }) }
                }
                for i in 0..len(context.functions) {
                    let function = context.functions[i]
                    if function.owner == owner_name + "." {
                        let method_name = slice(function.name, len(function.owner), len(function.name))
                        let method = CheckedMethod { name: method_name, type_id: function.type_id, target: i, owner: sem_named(context, owner_name), visible: function.visible }
                        let mut replaced = false
                        for j in 0..len(methods) { if methods[j].name == method_name { methods[j] = method replaced = true } }
                        if not replaced { methods.append(method) }
                    }
                }
                owner_index = owner_index - 1
            }
            for i in 0..len(context.variants) {
                if context.types[context.variant_types[i]].name == type_.name {
                    let mut payloads: list[int] = []
                    for payload in context.variant_payloads[i] { payloads.append(sem_substitute_type(context, payload, names, type_.args)) }
                    variants.append(CheckedVariant { name: context.variants[i], payloads: payloads })
                }
            }
            records.append(CheckedRecord { type_id: id, fields: fields, variants: variants, parent: parent, interfaces: interfaces, methods: methods })
        }
    }
    return records
}
fn checked_record(program: CheckedProgram, type_id: int) -> CheckedRecord {
    for record in program.records { if record.type_id == type_id { return record } }
    report_error_at("W9999", program.source, "checked nominal definition is missing")
    let fields: list[CheckedField] = []
    let variants: list[CheckedVariant] = []
    let interfaces: list[int] = []
    let methods: list[CheckedMethod] = []
    return CheckedRecord { type_id: -1, fields: fields, variants: variants, parent: -1, interfaces: interfaces, methods: methods }
}

fn checked_receiver_signature(context: SemanticContext, owner: int, type_id: int) -> int {
    let mut args_: list[int] = [owner]
    for arg in context.types[type_id].args { args_.append(arg) }
    return sem_intern(context, "function", "", args_)
}
# Validate the phase boundary before lowering or indexing checked identities.
fn checked_verify(program: CheckedProgram) {
    let source = program.source
    if not program.has_nodes { report_error_at("W9999", source, "MIR requires a completed checked node program") }
    if program.unit_type < 0 or program.unit_type >= len(program.types) { report_error_at("W9999", source, "invalid checked unit type") }
    if program.types[program.unit_type].kind != "unit" { report_error_at("W9999", source, "checked unit type mismatch") }
    for i in 0..len(program.types) {
        let type_ = program.types[i]
        for child in type_.args { if child < 0 or child >= i { report_error_at("W9999", source, "invalid or cyclic checked type reference") } }
        if (type_.kind == "list" or type_.kind == "optional" or type_.kind == "weak" or type_.kind == "ok" or type_.kind == "err") and len(type_.args) != 1 { report_error_at("W9999", source, "invalid checked unary type") }
        if type_.kind == "dict" and len(type_.args) != 2 { report_error_at("W9999", source, "invalid checked dictionary type") }
        if type_.kind == "result" and len(type_.args) != 2 { report_error_at("W9999", source, "invalid checked result type") }
        if type_.kind == "function" and len(type_.args) == 0 { report_error_at("W9999", source, "invalid checked function type") }
    }
    for obligation in program.obligations {
        for type_id in obligation.types { if type_id < 0 or type_id >= len(program.types) { report_error_at("W9999", obligation.source, "invalid checked generic obligation") } }
    }
    for binding in program.bindings {
        if binding.type_id < 0 or binding.type_id >= len(program.types) { report_error_at("W9999", binding.source, "invalid checked binding type") }
    }
    for signature in program.signatures {
        if signature.type_id < 0 or signature.type_id >= len(program.types) { report_error_at("W9999", source, "invalid checked signature type") }
        let type_ = program.types[signature.type_id]
        if type_.kind != "function" or len(type_.args) != len(signature.params) + 1 { report_error_at("W9999", source, "invalid checked signature shape") }
        for type_id in type_.args { if type_id < 0 or type_id >= len(program.types) { report_error_at("W9999", source, "invalid checked signature reference") } }
    }
    let mut template_names: list[str] = []
    for template in program.templates {
        if module_contains(template_names, template.name) or len(template.params) == 0 { report_error_at("W9999", source, "invalid checked template identity") }
        template_names.append(template.name)
    }
    checked_verify_records(program)
    for i in 0..len(program.patterns) {
        let pattern = program.patterns[i]
        if pattern.type_id < 0 or pattern.type_id >= len(program.types) { report_error_at("W9999", pattern.source, "invalid checked pattern type") }
        for child in pattern.children { if child < 0 or child >= i { report_error_at("W9999", pattern.source, "invalid or cyclic checked pattern") } }
        if pattern.binding >= 0 {
            if pattern.name != "*" or pattern.binding >= len(program.bindings) { report_error_at("W9999", pattern.source, "invalid checked pattern binding") }
            if program.bindings[pattern.binding].type_id != pattern.type_id { report_error_at("W9999", pattern.source, "checked pattern binding type mismatch") }
        }
    }
    # Validate every node reference before arms can inspect guard or subject types.
    for i in 0..len(program.nodes) {
        let node = program.nodes[i]
        if not checked_valid_type(program, node.type_id) { report_error_at("W9999", node.source, "invalid checked node type") }
        for child in node.children { if child < 0 or child >= i { report_error_at("W9999", node.source, "invalid or cyclic checked node reference") } }
    }
    for arm in program.arms {
        if arm.pattern < 0 or arm.pattern >= len(program.patterns) or arm.body < 0 or arm.body >= len(program.nodes) or arm.guard < -1 or arm.guard >= len(program.nodes) { report_error_at("W9999", arm.source, "invalid checked match arm") }
        if arm.guard >= 0 and program.types[program.nodes[arm.guard].type_id].kind != "bool" { report_error_at("W9999", arm.source, "checked match guard requires bool") }
    }
    for i in 0..len(program.nodes) {
        let node = program.nodes[i]
        let leaf_type = if node.kind == "integer" { "int" } elif node.kind == "boolean" { "bool" } elif node.kind == "string" { "str" } else { node.kind }
        if node.kind == "integer" or node.kind == "boolean" or node.kind == "string" or node.kind == "float" or node.kind == "unit" {
            if program.types[node.type_id].kind != leaf_type { report_error_at("W9999", node.source, "checked literal type mismatch") }
        }
        let count = len(node.children)
        let mut valid = false
        if node.kind == "integer" or node.kind == "float" or node.kind == "string" or node.kind == "boolean" or node.kind == "unit" or node.kind == "none" or node.kind == "binding" or node.kind == "super" or node.kind == "callee" or node.kind == "closure" or node.kind == "break" or node.kind == "continue" { valid = count == 0 }
        elif node.kind == "unary" or node.kind == "propagate" or node.kind == "let" or node.kind == "return" { valid = count == 1 }
        elif node.kind == "binary" or node.kind == "assign" or node.kind == "index" or node.kind == "handler" or node.kind == "while" { valid = count == 2 }
        elif node.kind == "if" { valid = count == 3 }
        elif node.kind == "new" or node.kind == "new_callee" or node.kind == "method" or node.kind == "direct_method" or node.kind == "virtual_call" or node.kind == "struct" or node.kind == "struct_call" or node.kind == "enum" or node.kind == "enum_call" or node.kind == "namespace" or node.kind == "constructor" or node.kind == "enum_callee" or node.kind == "call" or node.kind == "block" or node.kind == "list" or node.kind == "tuple" or node.kind == "collection_call" { valid = true }
        elif node.kind == "indirect_call" { valid = count >= 1 }
        elif node.kind == "dict" { valid = count % 2 == 0 }
        elif node.kind == "match" or node.kind == "collection_method" or node.kind == "member" { valid = count == 1 }
        elif node.kind == "for" { valid = count == 2 and node.pattern >= 0 and node.pattern < len(program.patterns) }
        if not valid { report_error_at("W9999", node.source, "invalid checked node shape: " + node.kind) }
        if node.kind != "for" and node.pattern != -1 { report_error_at("W9999", node.source, "unexpected checked binding pattern") }
        for arm_id in node.arms {
            if node.kind != "match" or arm_id < 0 or arm_id >= len(program.arms) { report_error_at("W9999", node.source, "invalid checked match arm identity") }
            let arm = program.arms[arm_id]
            checked_verify_pattern(program, arm.pattern, program.nodes[node.children[0]].type_id)
            if arm.body >= i or arm.guard >= i { report_error_at("W9999", node.source, "cyclic checked match arm") }
        }
        if node.total and node.kind != "match" { report_error_at("W9999", node.source, "unexpected checked match totality") }
        if node.discard and node.kind != "if" { report_error_at("W9999", node.source, "invalid checked discard marker") }
        if node.kind == "super" or node.kind == "binding" or node.kind == "let" or node.kind == "handler" and node.binding >= 0 {
            if node.binding < 0 or node.binding >= len(program.bindings) { report_error_at("W9999", node.source, "invalid checked binding identity") }
            if node.kind == "binding" and node.type_id != program.bindings[node.binding].type_id { report_error_at("W9999", node.source, "checked binding type mismatch") }
        } elif node.binding != -1 { report_error_at("W9999", node.source, "unexpected checked binding") }
        if node.kind == "closure" {
            if node.target < 0 or node.target >= len(program.functions) { report_error_at("W9999", node.source, "invalid checked closure target") }
            let function = program.functions[node.target]
            if not function.closure or function.type_id != node.type_id { report_error_at("W9999", node.source, "checked closure signature mismatch") }
        } elif node.kind == "call" or node.kind == "callee" or node.kind == "method" or node.kind == "direct_method" or node.kind == "virtual_call" {
            if node.target < -1 or node.target >= len(program.signatures) { report_error_at("W9999", node.source, "invalid checked call target") }
            if node.kind == "call" and node.target < 0 {
                let mut arity = -1
                if node.text == "slice" { arity = 3 }
                elif node.text == "Ok" or node.text == "Err" or node.text == "int" or node.text == "float" or node.text == "str" or node.text == "len" or node.text == "ord" or node.text == "chr" { arity = 1 }
                if arity >= 0 and count != arity { report_error_at("W9999", node.source, "checked builtin arity mismatch") }
            }
            if node.target >= 0 {
                let signature = program.signatures[node.target]
                if signature.name != node.text { report_error_at("W9999", node.source, "checked call target name mismatch") }
                if (node.kind == "call" or node.kind == "virtual_call") and count != len(signature.params) { report_error_at("W9999", node.source, "checked call arity mismatch") }
                let returned = program.types[signature.type_id].args
                if (node.kind == "call" or node.kind == "virtual_call") and node.type_id != returned[len(returned) - 1] { report_error_at("W9999", node.source, "checked call return type mismatch") }
            }
        } elif node.target != -1 { report_error_at("W9999", node.source, "unexpected checked call target") }
        if node.kind == "for" {
            let sequence = program.types[program.nodes[node.children[0]].type_id]
            if sequence.kind != "list" { report_error_at("W9999", node.source, "checked for requires list type") }
            checked_verify_pattern(program, node.pattern, sequence.args[0])
        }
        if node.kind == "indirect_call" {
            let signature = program.types[program.nodes[node.children[0]].type_id]
            if signature.kind != "function" or count != len(signature.args) or node.type_id != signature.args[len(signature.args) - 1] { report_error_at("W9999", node.source, "invalid checked indirect signature") }
        }
        if node.kind == "assign" {
            let target = program.nodes[node.children[0]]
            if target.kind != "binding" and target.kind != "index" and target.kind != "member" { report_error_at("W9999", node.source, "invalid checked assignment place") }
            if target.kind == "binding" and not program.bindings[target.binding].mutable { report_error_at("W9999", node.source, "checked assignment mutates immutable binding") }
        }
    }
    let mut expected_functions = 0
    for signature in program.signatures { if not signature.foreign and not signature.abstract and len(signature.type_params) == 0 { expected_functions = expected_functions + 1 } }
    for function in program.functions { if function.closure { expected_functions = expected_functions + 1 } }
    if len(program.functions) != expected_functions { report_error_at("W9999", source, "incomplete checked function bodies") }
    let mut names: list[str] = []
    for function in program.functions {
        for name in names { if name == function.name { report_error_at("W9999", function.source, "duplicate checked function body") } }
        names.append(function.name)
        if function.type_id < 0 or function.type_id >= len(program.types) { report_error_at("W9999", function.source, "invalid checked function type") }
        if program.types[function.type_id].kind != "function" { report_error_at("W9999", function.source, "invalid checked function signature") }
        let index = checked_function(program, function.name)
        if not function.closure and (index < 0 or program.signatures[index].type_id != function.type_id) { report_error_at("W9999", function.source, "invalid checked function identity") }
        if function.body < 0 or function.body >= len(program.nodes) { report_error_at("W9999", function.source, "invalid checked function body") }
        if program.nodes[function.body].kind != "block" { report_error_at("W9999", function.source, "checked function requires block body") }
        if not function.closure and len(function.captures) > 0 { report_error_at("W9999", function.source, "unexpected function captures") }
        let mut captured: list[int] = []
        for id in function.captures {
            if id < 0 or id >= len(program.bindings) { report_error_at("W9999", function.source, "invalid checked capture identity") }
            for previous in captured { if previous == id { report_error_at("W9999", function.source, "duplicate checked capture") } }
            captured.append(id)
        }
        let signature = program.types[function.type_id].args
        if len(function.params) + 1 != len(signature) { report_error_at("W9999", function.source, "invalid checked parameter count") }
        let mut parameters: list[int] = []
        for i in 0..len(function.params) {
            let id = function.params[i]
            if id < 0 or id >= len(program.bindings) { report_error_at("W9999", function.source, "invalid checked parameter identity") }
            for capture in function.captures { if capture == id { report_error_at("W9999", function.source, "checked capture shadows parameter identity") } }
            for previous in parameters { if previous == id { report_error_at("W9999", function.source, "duplicate checked parameter") } }
            parameters.append(id)
            if program.bindings[id].type_id != signature[i] { report_error_at("W9999", function.source, "checked parameter type mismatch") }
        }
    }
    for id in program.entry { if id < 0 or id >= len(program.nodes) { report_error_at("W9999", source, "invalid checked entry identity") } }
}

fn checked_valid_type(program: CheckedProgram, type_id: int) -> bool { return type_id >= 0 and type_id < len(program.types) }
fn checked_verify_records(program: CheckedProgram) {
    let source = program.source
    let mut seen: list[int] = []
    for record in program.records {
        if not checked_valid_type(program, record.type_id) { report_error_at("W9999", source, "invalid checked record identity") }
        for id in seen { if id == record.type_id { report_error_at("W9999", source, "duplicate checked record identity") } }
        seen.append(record.type_id)
        let kind = program.types[record.type_id].kind
        if kind != "struct" and kind != "enum" and kind != "class" and kind != "interface" { report_error_at("W9999", source, "invalid checked record kind") }
        if record.parent != -1 {
            if kind != "class" or not checked_valid_type(program, record.parent) { report_error_at("W9999", source, "invalid checked parent identity") }
            if program.types[record.parent].kind != "class" { report_error_at("W9999", source, "invalid checked parent kind") }
        }
        for interface_ in record.interfaces {
            if kind != "class" or not checked_valid_type(program, interface_) { report_error_at("W9999", source, "invalid checked interface identity") }
            if program.types[interface_].kind != "interface" { report_error_at("W9999", source, "invalid checked interface kind") }
        }
        let mut names: list[str] = []
        for field in record.fields {
            if (kind != "struct" and kind != "class") or not checked_valid_type(program, field.type_id) or module_contains(names, field.name) { report_error_at("W9999", source, "invalid checked field metadata") }
            names.append(field.name)
        }
        let variants: list[str] = []
        names = variants
        for variant in record.variants {
            if kind != "enum" or module_contains(names, variant.name) { report_error_at("W9999", source, "invalid checked variant metadata") }
            names.append(variant.name)
            for payload in variant.payloads { if not checked_valid_type(program, payload) { report_error_at("W9999", source, "invalid checked variant payload") } }
        }
        let methods: list[str] = []
        names = methods
        for method in record.methods {
            if (kind != "class" and kind != "interface") or method.target < 0 or method.target >= len(program.signatures) or not checked_valid_type(program, method.type_id) or not checked_valid_type(program, method.owner) or module_contains(names, method.name) { report_error_at("W9999", source, "invalid checked method metadata") }
            names.append(method.name)
            let signature = program.types[method.type_id]
            let target = program.types[program.signatures[method.target].type_id]
            if signature.kind != "function" or len(target.args) != len(signature.args) + 1 or target.args[0] != method.owner { report_error_at("W9999", source, "invalid checked method signature") }
            for i in 0..len(signature.args) { if target.args[i + 1] != signature.args[i] { report_error_at("W9999", source, "checked method target signature mismatch") } }
        }
    }
    for i in 0..len(program.types) {
        let type_ = program.types[i]
        if (type_.kind == "struct" or type_.kind == "enum" or type_.kind == "class" or type_.kind == "interface") and checked_type_concrete(program.types, program.templates, i) {
            let mut found = false
            for id in seen { if i == id { found = true } }
            if not found { report_error_at("W9999", source, "missing checked concrete record") }
        }
    }
}

fn checked_verify_pattern(program: CheckedProgram, id: int, expected: int) {
    let pattern = program.patterns[id]
    let type_ = program.types[expected]
    let source = pattern.source
    if pattern.type_id != expected { report_error_at("W9999", source, "checked pattern subject mismatch") }
    if pattern.name == "*" {
        if len(pattern.children) != 0 { report_error_at("W9999", source, "invalid checked binding pattern") }
        return
    }
    if len(pattern.name) >= 8 and slice(pattern.name, 0, 8) == "literal:" {
        if len(pattern.children) != 0 or (type_.kind != "int" and type_.kind != "str" and type_.kind != "bool") { report_error_at("W9999", source, "invalid checked literal pattern") }
        return
    }
    let mut payloads: list[int] = []
    if type_.kind == "tuple" and pattern.name == "tuple" { payloads = type_.args }
    elif type_.kind == "optional" and (pattern.name == "Some" or pattern.name == "None") { if pattern.name == "Some" { payloads = type_.args } }
    elif type_.kind == "result" and (pattern.name == "Ok" or pattern.name == "Err") { payloads = [type_.args[if pattern.name == "Ok" { 0 } else { 1 }]] }
    elif type_.kind == "error_union" {
        if len(pattern.children) != 1 { report_error_at("W9999", source, "invalid checked error type pattern") }
        let narrowed = program.patterns[pattern.children[0]].type_id
        let mut found = false
        for member in type_.args { if member == narrowed { found = true } }
        if not found { report_error_at("W9999", source, "invalid checked error alternative") }
        payloads = [narrowed]
    } elif type_.kind == "enum" {
        let record = checked_record(program, expected)
        let mut found = false
        for variant in record.variants { if variant.name == pattern.name { payloads = variant.payloads found = true } }
        if not found { report_error_at("W9999", source, "invalid checked enum pattern") }
    } else { report_error_at("W9999", source, "invalid checked constructor pattern") }
    if len(payloads) != len(pattern.children) { report_error_at("W9999", source, "invalid checked pattern arity") }
    for i in 0..len(payloads) { checked_verify_pattern(program, pattern.children[i], payloads[i]) }
}
fn sem_at(context: SemanticContext) -> Token {
    let token = context.tokens[context.pos]
    return token
}
fn sem_is(context: SemanticContext, kind: str) -> bool { return sem_at(context).kind == kind }
fn sem_take(context: SemanticContext) -> Token {
    let token = sem_at(context)
    if context.pos + 1 < len(context.tokens) { context.pos = context.pos + 1 }
    return token
}
fn sem_match(context: SemanticContext, kind: str) -> bool {
    if sem_is(context, kind) { sem_take(context) return true }
    return false
}
fn sem_skip_separators(context: SemanticContext) {
    while sem_is(context, "NEWLINE") or sem_is(context, "SEMICOLON") { sem_take(context) }
}
fn sem_skip_newlines_before_branch(context: SemanticContext) {
    let saved = context.pos
    while sem_is(context, "NEWLINE") { sem_take(context) }
    let mut branch = sem_is(context, "ELIF")
    if sem_is(context, "ELSE") {
        if context.tokens[context.pos + 1].kind == "LBRACE" or context.tokens[context.pos + 1].kind == "IDENT" and context.tokens[context.pos + 2].kind == "LBRACE" { branch = true }
    }
    if not branch { context.pos = saved }
}
fn sem_error(context: SemanticContext, code: str, message: str) {
    report_error_at(code, sem_at(context), message)
}
fn sem_expect(context: SemanticContext, kind: str) -> Token {
    if not sem_is(context, kind) { sem_error(context, "W0006", "expected " + kind) }
    return sem_take(context)
}
fn sem_intern(context: SemanticContext, kind: str, name: str, args: list[int]) -> int {
    for i in 0..len(context.types) {
        let candidate = context.types[i]
        if candidate.kind == kind and candidate.name == name and candidate.args == args { return i }
    }
    context.types.append(SemType { kind: kind, name: name, args: args })
    return len(context.types) - 1
}
fn sem_simple(context: SemanticContext, kind: str) -> int {
    let empty: list[int] = []
    return sem_intern(context, kind, "", empty)
}
fn sem_wrap(context: SemanticContext, kind: str, child: int) -> int { return sem_intern(context, kind, "", [child]) }
fn sem_kind(context: SemanticContext, type_id: int) -> str { return context.types[type_id].kind }
fn sem_error_type_name(context: SemanticContext, type_id: int) -> str {
    let type_ = context.types[type_id]
    if type_.kind == "int" { return "int" }
    if type_.kind == "float" { return "float" }
    if type_.kind == "bool" { return "bool" }
    if type_.kind == "str" { return "str" }
    return type_.name
}
fn sem_error_union(context: SemanticContext, first: int) -> int {
    let mut alternatives: list[int] = [first]
    let mut has_union = false
    while sem_match(context, "PIPE") { has_union = true alternatives.append(sem_type(context)) }
    if not has_union { return first }
    let mut unique: list[int] = []
    for alternative in alternatives {
        let kind = sem_kind(context, alternative)
        if kind != "int" and kind != "float" and kind != "bool" and kind != "str" and kind != "struct" and kind != "enum" {
            sem_error(context, "W2001", "error union alternatives must be scalar, non-generic struct, or non-generic enum types")
        }
        if len(context.types[alternative].args) > 0 and (kind == "struct" or kind == "enum") {
            sem_error(context, "W2001", "generic nominal types cannot be error union alternatives")
        }
        let mut found = false
        for existing in unique { if existing == alternative { found = true } }
        if not found { unique.append(alternative) }
    }
    if len(unique) < 2 { sem_error(context, "W2001", "an error union requires at least two distinct alternatives") }
    let mut canonical: list[int] = []
    let mut previous = -1
    while len(canonical) < len(unique) {
        let mut next = -1
        for alternative in unique {
            if alternative > previous and (next < 0 or alternative < next) { next = alternative }
        }
        if next < 0 { sem_error(context, "W9999", "failed to canonicalize error union") }
        canonical.append(next)
        previous = next
    }
    return sem_intern(context, "error_union", "", canonical)
}
fn sem_named(context: SemanticContext, name: str) -> int {
    for i in 0..len(context.types) { if context.types[i].name == name { return i } }
    sem_error(context, "W1001", "unknown type: " + name)
    return context.unit_type
}
fn sem_generic_type(context: SemanticContext, name: str) -> int {
    for i in 0..len(context.generic_types) { if context.generic_types[i].name == name { return i } }
    return -1
}
fn sem_same_type_declaration(context: SemanticContext, declaration: int, instance: int) -> bool {
    let declared = context.types[declaration]
    let concrete = context.types[instance]
    return declared.kind == concrete.kind and declared.name == concrete.name
}
fn sem_function(context: SemanticContext, name: str) -> int {
    for i in 0..len(context.functions) { if context.functions[i].name == name { return i } }
    return -1
}
fn sem_method(context: SemanticContext, owner: str, name: str) -> int {
    let mut current = owner
    let mut visits = 0
    while current != "" and visits <= len(context.classes) {
        let index = sem_function(context, current + "." + name)
        if index >= 0 { return index }
        let mut next = ""
        for class_ in context.classes { if class_.name == current { next = class_.parent } }
        current = next
        visits = visits + 1
    }
    return -1
}
fn sem_error_channel_assignable(context: SemanticContext, source: int, target: int) -> bool {
    if source == target { return true }
    if sem_defer(context, "assignable", [source, target]) { return true }
    let s = context.types[source]
    let t = context.types[target]
    let source_members = if s.kind == "error_union" { s.args } else { [source] }
    let target_members = if t.kind == "error_union" { t.args } else { [target] }
    for source_member in source_members {
        let mut covered = false
        for target_member in target_members { if source_member == target_member { covered = true } }
        if not covered { return false }
    }
    return true
}
fn sem_assignable(context: SemanticContext, source: int, target: int) -> bool {
    if source == target { return true }
    if sem_defer(context, "assignable", [source, target]) { return true }
    let s = context.types[source]
    let t = context.types[target]
    if s.kind == "empty" and (t.kind == "list" or t.kind == "dict") { return true }
    if t.kind == "optional" {
        if source == context.none_type { return true }
        if s.kind == "optional" { return sem_assignable(context, s.args[0], t.args[0]) }
        return sem_assignable(context, source, t.args[0])
    }
    if t.kind == "result" {
        if s.kind == "result" {
            if s.args[0] == t.args[0] and sem_error_channel_assignable(context, s.args[1], t.args[1]) { return true }
            return sem_assignable(context, source, t.args[0])
        }
        if s.kind == "ok" { return sem_assignable(context, s.args[0], t.args[0]) }
        if s.kind == "err" { return sem_error_channel_assignable(context, s.args[0], t.args[1]) }
        return sem_assignable(context, source, t.args[0])
    }
    if t.kind == "error_union" {
        return sem_error_channel_assignable(context, source, target)
    }
    if s.kind == "class" and (t.kind == "class" or t.kind == "interface") {
        let mut current = s.name
        let mut visits = 0
        while current != "" and visits <= len(context.classes) {
            if current == t.name { return true }
            let mut next = ""
            for class_ in context.classes {
                if class_.name == current {
                    for interface_ in class_.interfaces { if interface_ == t.name { return true } }
                    next = class_.parent
                }
            }
            current = next
            visits = visits + 1
        }
    }
    return false
}
fn sem_require(context: SemanticContext, source: int, target: int, code: str) {
    if not sem_assignable(context, source, target) { sem_error(context, code, "incompatible types") }
}
fn sem_type(context: SemanticContext) -> int {
    let mut result = context.unit_type
    if sem_match(context, "FN") {
        sem_expect(context, "LPAREN")
        let mut args: list[int] = []
        if not sem_is(context, "RPAREN") {
            args.append(sem_type(context))
            while sem_match(context, "COMMA") { args.append(sem_type(context)) }
        }
        sem_expect(context, "RPAREN")
        sem_expect(context, "ARROW")
        args.append(sem_type(context))
        return sem_intern(context, "function", "", args)
    } elif sem_match(context, "LPAREN") {
        result = sem_type(context)
        sem_expect(context, "RPAREN")
    } else {
        let name = sem_expect(context, "IDENT").val
        let mut substitution = -1
        for i in 0..len(context.substitution_names) { if context.substitution_names[i] == name { substitution = context.substitution_types[i] } }
        let mut is_parameter = false
        for parameter in context.type_params { if parameter == name { is_parameter = true } }
        if substitution >= 0 { result = substitution }
        elif is_parameter {
            let empty: list[int] = []
            result = sem_intern(context, "typeparam", name, empty)
        } elif name == "int" or name == "int32" or name == "int64" { result = context.integer_type }
        elif name == "float" or name == "double" { result = context.float_type }
        elif name == "bool" { result = context.boolean_type }
        elif name == "str" { result = context.string_type }
        elif name == "unit" { result = context.unit_type }
        elif name == "list" or name == "dict" or name == "tuple" or name == "Option" or name == "Result" or name == "Weak" {
            sem_expect(context, "LBRACKET")
            let mut args: list[int] = [sem_type(context)]
            while sem_match(context, "COMMA") { args.append(sem_type(context)) }
            sem_expect(context, "RBRACKET")
            let mut kind = name
            if name == "Option" { kind = "optional" }
            if name == "Result" { kind = "result" }
            if name == "Weak" { kind = "weak" }
            if (kind == "list" or kind == "optional" or kind == "weak") and len(args) != 1 { sem_error(context, "W2001", "type arity") }
            if (kind == "dict" or kind == "result") and len(args) != 2 { sem_error(context, "W2001", "type arity") }
            if kind == "dict" and not sem_key(context, args[0]) { sem_error(context, "W2010", "invalid dictionary key") }
            result = sem_intern(context, kind, "", args)
        } else {
            let base = sem_named(context, name)
            let generic = sem_generic_type(context, name)
            if sem_match(context, "LBRACKET") {
                if generic < 0 { sem_error(context, "W2001", "type is not generic: " + name) }
                let mut arguments: list[int] = [sem_type(context)]
                while sem_match(context, "COMMA") { arguments.append(sem_type(context)) }
                sem_expect(context, "RBRACKET")
                if len(arguments) != len(context.generic_types[generic].params) { sem_error(context, "W2001", "generic type arity: " + name) }
                result = sem_intern(context, context.types[base].kind, name, arguments)
            } else {
                if generic >= 0 { sem_error(context, "W2001", "generic type arguments required: " + name) }
                result = base
            }
        }
    }
    if sem_match(context, "QUESTION") { result = sem_wrap(context, "optional", result) }
    if sem_match(context, "BANG") { result = sem_intern(context, "result", "", [result, sem_error_union(context, sem_type(context))]) }
    return result
}
fn sem_key(context: SemanticContext, type_id: int) -> bool {
    return type_id == context.integer_type or type_id == context.string_type or type_id == context.boolean_type or sem_kind(context, type_id) == "enum"
}
fn sem_lookup(context: SemanticContext, name: str) -> int {
    let mut i = len(context.variables) - 1
    while i >= 0 {
        if context.variables[i].name == name { return i }
        i = i - 1
    }
    return -1
}
fn sem_declare(context: SemanticContext, name: str, type_id: int, mutable: bool) -> int {
    for variable in context.variables {
        if variable.name == name and variable.depth == context.depth { sem_error(context, "W1002", "duplicate declaration: " + name) }
    }
    let mut binding = -1
    if context.capture_nodes {
        binding = len(context.symbols)
        context.symbols.append(CheckedBinding { name: name, type_id: type_id, mutable: mutable, global: context.depth == 0, source: sem_at(context) })
    }
    context.variables.append(SemVar { name: name, type_id: type_id, mutable: mutable, depth: context.depth, binding: binding })
    return binding
}
fn sem_value(type_id: int) -> SemValue {
    return SemValue { type_id: type_id, root: "", writable: -1, terminates: false, node: -1 }
}
fn sem_mutable(context: SemanticContext, root: str) {
    if len(root) >= 5 and slice(root, 0, 5) == "this:" { return }
    if root != "" {
        let variable = sem_lookup(context, root)
        if variable >= 0 and context.capture_depth >= 0 and context.variables[variable].depth < context.capture_depth { sem_error(context, "W3001", "captured snapshots are immutable") }
        if variable < 0 or not context.variables[variable].mutable { sem_error(context, "W3001", "mutation of immutable binding") }
    }
}
fn sem_skip_block(context: SemanticContext) -> int {
    sem_expect(context, "LBRACE")
    let mut depth = 1
    while depth > 0 and not sem_is(context, "EOF") {
        if sem_match(context, "LBRACE") { depth = depth + 1 }
        elif sem_match(context, "RBRACE") { depth = depth - 1 }
        else { sem_take(context) }
    }
    if depth != 0 { sem_error(context, "W0006", "unclosed block") }
    return context.pos
}
fn sem_collect_function(context: SemanticContext, owner: str, visible: bool) {
    sem_expect(context, "FN")
    let local = sem_expect(context, "IDENT").val
    let previous_type_params = context.type_params
    let mut type_params: list[str] = []
    let mut constraints: list[str] = []
    if sem_match(context, "LBRACKET") {
        while not sem_is(context, "RBRACKET") {
            let parameter = sem_expect(context, "IDENT")
            for previous in type_params { if previous == parameter.val { report_error_at("W2001", parameter, "duplicate generic type parameter") } }
            type_params.append(parameter.val)
            let mut constraint = ""
            if sem_match(context, "COLON") { constraint = sem_expect(context, "IDENT").val }
            constraints.append(constraint)
            if not sem_match(context, "COMMA") { break }
        }
        sem_expect(context, "RBRACKET")
    }
    context.type_params = type_params
    let name = owner + local
    if sem_function(context, name) >= 0 { sem_error(context, "W1002", "duplicate function: " + name) }
    sem_expect(context, "LPAREN")
    let mut params: list[str] = []
    let mut abi_params: list[str] = []
    let mut types: list[int] = []
    while not sem_is(context, "RPAREN") {
        params.append(sem_expect(context, "IDENT").val)
        sem_expect(context, "COLON")
        abi_params.append(sem_at(context).val)
        types.append(sem_type(context))
        if not sem_match(context, "COMMA") { break }
    }
    sem_expect(context, "RPAREN")
    let mut returned = context.unit_type
    let mut abi_return = "unit"
    if sem_match(context, "ARROW") { abi_return = sem_at(context).val returned = sem_type(context) }
    types.append(returned)
    let signature = sem_intern(context, "function", "", types)
    let mut body = -1
    let mut end = context.pos
    if sem_is(context, "LBRACE") { body = context.pos end = sem_skip_block(context) }
    context.type_params = previous_type_params
    context.functions.append(SemFunction { abi_params: abi_params, abi_return: abi_return, name: name, params: params, type_params: type_params, constraints: constraints, type_id: signature, body: body, end: end, owner: owner, visible: visible })
}
fn sem_collect_record(context: SemanticContext, kind: str) {
    sem_take(context)
    let name = sem_expect(context, "IDENT").val
    let previous_type_params = context.type_params
    let mut type_params: list[str] = []
    let generic = sem_generic_type(context, name)
    if generic >= 0 {
        if kind == "class" or kind == "interface" { report_error_at("W2013", sem_at(context), "Compiler native-core-v1 does not support parameterized classes or interfaces") }
        type_params = context.generic_types[generic].params
    }
    context.type_params = type_params
    if generic >= 0 {
        sem_expect(context, "LBRACKET")
        let mut parameter_index = 0
        while not sem_is(context, "RBRACKET") {
            let parameter = sem_expect(context, "IDENT")
            if parameter_index >= len(type_params) or type_params[parameter_index] != parameter.val { report_error_at("W0006", parameter, "generic parameter list changed during collection") }
            if sem_match(context, "COLON") { sem_expect(context, "IDENT") }
            parameter_index = parameter_index + 1
            if not sem_match(context, "COMMA") { break }
        }
        sem_expect(context, "RBRACKET")
    }
    let type_id = sem_named(context, name)
    let mut parent = ""
    let mut interfaces: list[str] = []
    if sem_match(context, "EXTENDS") { parent = sem_expect(context, "IDENT").val }
    if sem_match(context, "IMPLEMENTS") {
        interfaces.append(sem_expect(context, "IDENT").val)
        while sem_match(context, "COMMA") { interfaces.append(sem_expect(context, "IDENT").val) }
    }
    if kind == "class" { context.classes.append(SemClass { name: name, parent: parent, interfaces: interfaces }) }
    sem_expect(context, "LBRACE")
    while true {
        sem_skip_separators(context)
        if sem_is(context, "RBRACE") { break }
        let mut visible = true
        if sem_match(context, "PRIVATE") { visible = false } else { sem_match(context, "PUBLIC") }
        if sem_is(context, "FN") { sem_collect_function(context, name + ".", visible) }
        elif kind == "enum" {
            let variant = sem_expect(context, "IDENT").val
            let mut payload_types: list[int] = []
            if sem_match(context, "LPAREN") {
                if not sem_is(context, "RPAREN") {
                    payload_types.append(sem_type(context))
                    while sem_match(context, "COMMA") {
                        if sem_is(context, "RPAREN") { break }
                        payload_types.append(sem_type(context))
                    }
                }
                sem_expect(context, "RPAREN")
            }
            context.variants.append(variant)
            context.variant_types.append(type_id)
            context.variant_payloads.append(payload_types)
            sem_match(context, "COMMA")
        } else {
            let field = sem_expect(context, "IDENT").val
            sem_expect(context, "COLON")
            let field_type = sem_type(context)
            context.fields.append(SemField { owner: name, name: field, type_id: field_type, visible: visible })
            sem_match(context, "COMMA")
        }
    }
    sem_expect(context, "RBRACE")
    context.type_params = previous_type_params
}
fn sem_builtin(name: str) -> bool {
    return name == "join_strings" or name == "print" or name == "eprint" or name == "len" or name == "int" or name == "float" or name == "str" or name == "ord" or name == "chr" or name == "bytes" or name == "slice" or name == "args" or name == "exit" or name == "enumerate" or name == "dict_items" or name == "read_file" or name == "write_file" or name == "Some" or name == "Ok" or name == "Err" or name == "weak" or name == "upgrade"
}
fn sem_call_builtin(context: SemanticContext, name: str, args: list[int], discard: bool) -> int {
    let count = len(args)
    if name == "print" or name == "eprint" { return context.unit_type }
    if name == "args" {
        if count != 0 { sem_error(context, "W2005", "args arity") }
        return sem_wrap(context, "list", context.string_type)
    }
    let mut arity = 1
    if name == "slice" { arity = 3 }
    if name == "write_file" or name == "join_strings" { arity = 2 }
    if count != arity { sem_error(context, "W2005", "builtin arity: " + name) }
    if name == "join_strings" {
        if count != 2 { sem_error(context, "W2005", "join_strings arity") }
        sem_require(context, args[0], sem_wrap(context, "list", context.string_type), "W2001")
        sem_require(context, args[1], context.string_type, "W2001")
        return context.string_type
    }
    let first = args[0]
    let kind = sem_kind(context, first)
    if name == "Some" { return sem_wrap(context, "optional", first) }
    if name == "Ok" or name == "Err" {
        if context.expected_type >= 0 and sem_kind(context, context.expected_type) == "result" {
            let channel = context.types[context.expected_type].args
            if name == "Ok" { if not discard or channel[0] != context.unit_type { sem_require(context, first, channel[0], "W2001") } }
            elif discard and channel[0] == context.unit_type { sem_require(context, first, channel[1], "W2004") }
            else { sem_require(context, first, channel[1], "W2001") }
            return context.expected_type
        }
        if name == "Ok" { return sem_wrap(context, "ok", first) }
        return sem_wrap(context, "err", first)
    }
    if name == "len" {
        if kind != "list" and kind != "dict" and kind != "tuple" and first != context.string_type { sem_error(context, "W2001", "len requires a collection or string") }
        return context.integer_type
    }
    if name == "int" or name == "float" or name == "str" {
        if name != "str" and first != context.integer_type and first != context.float_type and first != context.string_type and first != context.boolean_type { sem_error(context, "W2001", "conversion argument") }
        if name == "int" { return context.integer_type }
        if name == "float" { return context.float_type }
        return context.string_type
    }
    if name == "chr" or name == "exit" {
        sem_require(context, first, context.integer_type, "W2001")
        if name == "chr" { return context.string_type }
        return context.unit_type
    }
    if name == "slice" {
        # SPEC 11.1: slice() is polymorphic over str and list[T] and preserves the
        # container kind.
        let first_type = context.types[first]
        sem_require(context, args[1], context.integer_type, "W2001")
        sem_require(context, args[2], context.integer_type, "W2001")
        if first == context.string_type { return context.string_type }
        if first_type.kind == "list" { return first }
        sem_error(context, "W2001", "slice expects str or list")
        return context.string_type
    }
    if name == "ord" or name == "bytes" or name == "read_file" or name == "write_file" {
        sem_require(context, first, context.string_type, "W2001")
        if name == "ord" { return context.integer_type }
        if name == "bytes" { return sem_wrap(context, "list", context.integer_type) }
        let io = sem_named(context, "IoError")
        if name == "read_file" { return sem_intern(context, "result", "", [context.string_type, io]) }
        sem_require(context, args[1], context.string_type, "W2001")
        return sem_intern(context, "result", "", [context.unit_type, io])
    }
    if name == "weak" {
        if kind != "class" { sem_error(context, "W2001", "weak requires class") }
        return sem_wrap(context, "weak", first)
    }
    if name == "upgrade" {
        if kind != "weak" { sem_error(context, "W2001", "upgrade requires weak") }
        return sem_wrap(context, "optional", context.types[first].args[0])
    }
    if name == "enumerate" {
        if kind != "list" { sem_error(context, "W2001", "enumerate requires list") }
        return sem_wrap(context, "list", sem_intern(context, "tuple", "", [context.integer_type, context.types[first].args[0]]))
    }
    if name == "dict_items" {
        if kind != "dict" { sem_error(context, "W2001", "dict_items requires dict") }
        return sem_wrap(context, "list", sem_intern(context, "tuple", "", context.types[first].args))
    }
    sem_error(context, "W1001", "unknown builtin")
    return context.unit_type
}
fn sem_check_call(context: SemanticContext, signature: int, args: list[int], discard: bool) -> int {
    let unification = new SemUnification()
    let type_ = context.types[signature]
    if type_.kind == "builtin" { return sem_call_builtin(context, type_.name, args, discard) }
    if type_.kind == "enum_ctor" {
        let mut separator = -1
        for i in 0..len(type_.name) - 1 { if slice(type_.name, i, i + 1) == "." { separator = i } }
        if separator < 0 { sem_error(context, "W9999", "invalid enum constructor metadata") }
        let owner = slice(type_.name, 0, separator)
        let variant = slice(type_.name, separator + 1, len(type_.name))
        if owner == "Option" and variant == "Some" {
            if len(args) != 1 { sem_error(context, "W2005", "Option.Some arity") }
            return sem_wrap(context, "optional", args[0])
        }
        if owner == "Result" and (variant == "Ok" or variant == "Err") {
            if len(args) != 1 { sem_error(context, "W2005", "Result constructor arity") }
            if context.expected_type >= 0 and sem_kind(context, context.expected_type) == "result" {
                let expected = context.types[context.expected_type]
                if variant == "Ok" { if not discard or expected.args[0] != context.unit_type { sem_require(context, args[0], expected.args[0], "W2001") } }
                elif discard and expected.args[0] == context.unit_type { sem_require(context, args[0], expected.args[1], "W2004") }
                else { sem_require(context, args[0], expected.args[1], "W2001") }
            }
            if variant == "Ok" { return sem_wrap(context, "ok", args[0]) }
            return sem_wrap(context, "err", args[0])
        }
        let mut target = type_.args[0]
        let generic = sem_generic_type(context, owner)
        let mut payload_types: list[int] = []
        for i in 1..len(type_.args) { payload_types.append(type_.args[i]) }
        if len(args) != len(payload_types) { sem_error(context, "W2005", "enum constructor arity: " + owner + "." + variant) }
        if generic >= 0 and len(context.types[target].args) == 0 {
            let empty_names: list[str] = []
            let empty_types: list[int] = []
            unification.names = empty_names
            unification.types = empty_types
            for i in 0..len(args) { if not sem_unify_type(context, unification, payload_types[i], args[i]) { sem_error(context, "W2001", "enum payload type mismatch") } }
            let mut concrete: list[int] = []
            for parameter in context.generic_types[generic].params {
                let mut found = -1
                for i in 0..len(unification.names) { if unification.names[i] == parameter { found = unification.types[i] } }
                if found < 0 { sem_error(context, "W2001", "cannot infer enum type argument: " + parameter) }
                concrete.append(found)
            }
            target = sem_intern(context, "enum", owner, concrete)
        } elif generic >= 0 {
            unification.names = context.generic_types[generic].params
            unification.types = context.types[target].args
            for i in 0..len(args) {
                sem_require(context, args[i], sem_substitute_type(context, payload_types[i], unification.names, unification.types), "W2001")
            }
        } else {
            for i in 0..len(args) { sem_require(context, args[i], payload_types[i], "W2001") }
        }
        return target
    }
    if type_.kind == "struct_ctor" {
        let generic = sem_generic_type(context, type_.name)
        let mut target = sem_named(context, type_.name)
        let mut explicit = false
        if len(type_.args) == 1 { target = type_.args[0] explicit = true }
        let mut fields: list[int] = []
        for i in 0..len(context.fields) { if context.fields[i].owner == type_.name { fields.append(i) } }
        if len(args) != len(fields) { sem_error(context, "W2005", "struct constructor arity: " + type_.name) }
        let empty_names: list[str] = []
        let empty_types: list[int] = []
        unification.names = empty_names
        unification.types = empty_types
        if explicit and generic >= 0 {
            unification.names = context.generic_types[generic].params
            unification.types = context.types[target].args
        }
        for i in 0..len(args) {
            let field_type = context.fields[fields[i]].type_id
            if generic >= 0 and not explicit { sem_unify_type(context, unification, field_type, args[i]) }
            sem_require(context, args[i], sem_substitute_type(context, field_type, unification.names, unification.types), "W2001")
        }
        if generic >= 0 and not explicit {
            let mut concrete: list[int] = []
            for parameter in context.generic_types[generic].params {
                let mut inferred = -1
                for i in 0..len(unification.names) { if unification.names[i] == parameter { inferred = unification.types[i] } }
                if inferred < 0 { sem_error(context, "W2001", "cannot infer generic struct type argument: " + parameter) }
                concrete.append(inferred)
            }
            target = sem_intern(context, context.generic_types[generic].kind, type_.name, concrete)
        }
        return target
    }
    if type_.kind == "constructor" {
        let target = type_.args[0]
        let method = sem_method(context, context.types[target].name, "init")
        if method >= 0 { sem_check_call(context, context.functions[method].type_id, args, false) }
        elif len(args) != 0 { sem_error(context, "W2005", "constructor arity") }
        return target
    }
    if type_.kind == "dependent" and sem_defer(context, "call", [signature]) { return signature }
    if type_.kind != "function" { sem_error(context, "W2005", "value is not callable") }
    if len(type_.args) != len(args) + 1 { sem_error(context, "W2005", "call arity") }
    let empty_names: list[str] = []
    let empty_types: list[int] = []
    unification.names = empty_names
    unification.types = empty_types
    for i in 0..len(args) { sem_unify_type(context, unification, type_.args[i], args[i]) }
    for i in 0..len(args) {
        let expected = sem_substitute_type(context, type_.args[i], unification.names, unification.types)
        sem_require(context, args[i], expected, "W2001")
    }
    return sem_substitute_type(context, type_.args[len(args)], unification.names, unification.types)
}
fn sem_substitute_type(context: SemanticContext, type_id: int, names: list[str], values: list[int]) -> int {
    let type_ = context.types[type_id]
    if type_.kind == "typeparam" {
        for i in 0..len(names) { if names[i] == type_.name { return values[i] } }
        return type_id
    }
    if len(type_.args) == 0 { return type_id }
    let mut replaced: list[int] = []
    let mut changed = false
    for arg in type_.args {
        let next = sem_substitute_type(context, arg, names, values)
        replaced.append(next)
        if next != arg { changed = true }
    }
    if not changed { return type_id }
    return sem_intern(context, type_.kind, type_.name, replaced)
}
fn sem_unify_type(context: SemanticContext, unification: SemUnification, pattern: int, actual: int) -> bool {
    let expected = context.types[pattern]
    if expected.kind == "typeparam" {
        for i in 0..len(unification.names) {
            if unification.names[i] == expected.name { return unification.types[i] == actual }
        }
        unification.names.append(expected.name)
        unification.types.append(actual)
        return true
    }
    let actual_type = context.types[actual]
    if expected.kind != actual_type.kind or expected.name != actual_type.name or len(expected.args) != len(actual_type.args) { return false }
    for i in 0..len(expected.args) {
        if not sem_unify_type(context, unification, expected.args[i], actual_type.args[i]) { return false }
    }
    return true
}
fn sem_field(context: SemanticContext, owner: str, name: str) -> int {
    let mut current = owner
    let mut visits = 0
    while current != "" and visits <= len(context.classes) {
        for i in 0..len(context.fields) {
            let field = context.fields[i]
            if field.owner == current and field.name == name { return i }
        }
        let mut next = ""
        for class_ in context.classes { if class_.name == current { next = class_.parent } }
        current = next
        visits = visits + 1
    }
    return -1
}
fn sem_member(context: SemanticContext, receiver: SemValue, name: str) -> SemValue {
    let type_ = context.types[receiver.type_id]
    if type_.kind == "typeparam" {
        let mut constraint = ""
        for i in 0..len(context.type_params) {
            if context.type_params[i] == type_.name and i < len(context.active_constraints) { constraint = context.active_constraints[i] }
        }
        if constraint != "" {
            let method_index = sem_method(context, constraint, name)
            if method_index >= 0 {
                let method = context.functions[method_index]
                return SemValue { type_id: method.type_id, root: "#method", writable: -1, terminates: false, node: -1 }
            }
        }
        if sem_defer(context, "member:" + name, [receiver.type_id]) { return sem_value(sem_intern(context, "dependent", name, [receiver.type_id])) }
        sem_error(context, "W3002", "unknown member on generic type parameter: " + name)
    }
    if type_.kind == "enum" {
        for i in 0..len(context.variants) {
            if context.variants[i] == name and context.types[context.variant_types[i]].name == type_.name {
                if len(context.variant_payloads[i]) == 0 { return sem_value(receiver.type_id) }
                let mut arguments: list[int] = [receiver.type_id]
                for payload in context.variant_payloads[i] { arguments.append(payload) }
                return sem_value(sem_intern(context, "enum_ctor", type_.name + "." + name, arguments))
            }
        }
        sem_error(context, "W1001", "unknown enum variant")
    }
    if type_.kind == "optional" and (name == "Some" or name == "None") {
        if name == "None" { return sem_value(context.none_type) }
        return sem_value(sem_intern(context, "enum_ctor", "Option.Some", [receiver.type_id, type_.args[0]]))
    }
    if type_.kind == "result" and (name == "Ok" or name == "Err") {
        let mut payload = type_.args[0]
        if name == "Err" { payload = type_.args[1] }
        return sem_value(sem_intern(context, "enum_ctor", "Result." + name, [receiver.type_id, payload]))
    }
    if type_.kind == "list" or type_.kind == "dict" {
        let mut args: list[int] = []
        if name == "append" and type_.kind == "list" {
            sem_mutable(context, receiver.root)
            args = [type_.args[0], context.unit_type]
        } elif name == "pop" and type_.kind == "list" {
            sem_mutable(context, receiver.root)
            args = [type_.args[0]]
        } elif name == "clear" and type_.kind == "list" {
            sem_mutable(context, receiver.root)
            args = [context.unit_type]
        } elif name == "get" and type_.kind == "dict" { args = [type_.args[0], sem_wrap(context, "optional", type_.args[1])] }
        elif name == "keys" and type_.kind == "dict" { args = [sem_wrap(context, "list", type_.args[0])] }
        elif name == "values" and type_.kind == "dict" { args = [sem_wrap(context, "list", type_.args[1])] }
        else { sem_error(context, "W3002", "unknown collection method") }
        return SemValue { type_id: sem_intern(context, "function", "", args), root: "#collection", writable: -1, terminates: false, node: -1 }
    }
    let field_index = sem_field(context, type_.name, name)
    if field_index >= 0 {
        let field = context.fields[field_index]
        if not field.visible and context.owner != field.owner { sem_error(context, "W3002", "private field") }
        if context.initializing and receiver.root == "this" and field.owner == context.owner {
            let mut found = false
            for initialized in context.initialized { if initialized == name { found = true } }
            if not found and not sem_is(context, "ASSIGN") { sem_error(context, "W3004", "read before initialization") }
        }
        let mut root = receiver.root
        if type_.kind == "class" {
            root = ""
            if context.initializing and receiver.root == "this" { root = "this:" + name }
        }
        let mut field_type = field.type_id
        let generic = sem_generic_type(context, type_.name)
        if generic >= 0 and len(type_.args) == len(context.generic_types[generic].params) {
            field_type = sem_substitute_type(context, field_type, context.generic_types[generic].params, type_.args)
        }
        return SemValue { type_id: field_type, root: root, writable: field_type, terminates: false, node: -1 }
    }
    let method_index = sem_method(context, type_.name, name)
    if method_index >= 0 {
        let method = context.functions[method_index]
        if not method.visible and method.owner != context.owner + "." { sem_error(context, "W3002", "private method access") }
        return SemValue { type_id: method.type_id, root: "#method", writable: -1, terminates: false, node: -1 }
    }
    sem_error(context, "W3002", "unknown member: " + name)
    return sem_value(context.unit_type)
}
fn sem_group_is_tuple(context: SemanticContext) -> bool {
    let mut position = context.pos
    let mut depth = 0
    while position < len(context.tokens) {
        let kind = context.tokens[position].kind
        if depth == 0 and kind == "RPAREN" { return false }
        if depth == 0 and kind == "COMMA" { return true }
        if kind == "LPAREN" or kind == "LBRACE" or kind == "LBRACKET" { depth = depth + 1 }
        elif kind == "RPAREN" or kind == "RBRACE" or kind == "RBRACKET" { depth = depth - 1 }
        position = position + 1
    }
    return false
}

fn sem_prefix(context: SemanticContext, allow_struct: bool, statement: bool) -> SemValue {
    let source = sem_at(context)
    if sem_is(context, "PIPE") { return sem_lambda(context) }
    if sem_match(context, "INT") { return sem_expr(context, "integer", sem_value(context.integer_type), source, source.val, [], -1, -1) }
    if sem_match(context, "FLOAT") { return sem_expr(context, "float", sem_value(context.float_type), source, source.val, [], -1, -1) }
    if sem_match(context, "STR") { return sem_expr(context, "string", sem_value(context.string_type), source, source.val, [], -1, -1) }
    if sem_match(context, "TRUE") or sem_match(context, "FALSE") { return sem_expr(context, "boolean", sem_value(context.boolean_type), source, source.kind, [], -1, -1) }
    if sem_match(context, "NONE") { return sem_expr(context, "none", sem_value(context.none_type), source, "", [], -1, -1) }
    if sem_match(context, "MINUS") {
        let value = sem_expression(context, 9, allow_struct)
        if value.type_id != context.integer_type and value.type_id != context.float_type { sem_error(context, "W2001", "numeric negation") }
        return sem_expr(context, "unary", sem_value(value.type_id), source, "MINUS", [value.node], -1, -1)
    }
    if sem_match(context, "NOT") {
        let operand = sem_expression(context, 9, allow_struct)
        sem_require(context, operand.type_id, context.boolean_type, "W2001")
        return sem_expr(context, "unary", sem_value(context.boolean_type), source, "NOT", [operand.node], -1, -1)
    }
    if sem_match(context, "LPAREN") {
        if sem_match(context, "RPAREN") {
            let empty: list[int] = []
            return sem_expr(context, "tuple", sem_value(sem_intern(context, "tuple", "", empty)), source, "", [], -1, -1)
        }
        context.statement_context = statement and not sem_group_is_tuple(context)
        let first = sem_expression(context, 0, true)
        if sem_match(context, "COMMA") {
            let mut types: list[int] = [first.type_id]
            let mut values: list[int] = [first.node]
            while not sem_is(context, "RPAREN") {
                let next = sem_expression(context, 0, true)
                types.append(next.type_id)
                values.append(next.node)
                if not sem_match(context, "COMMA") { break }
            }
            sem_expect(context, "RPAREN")
            return sem_expr(context, "tuple", sem_value(sem_intern(context, "tuple", "", types)), source, "", values, -1, -1)
        }
        sem_expect(context, "RPAREN")
        return first
    }
    if sem_match(context, "LBRACKET") {
        if sem_match(context, "RBRACKET") {
            let expected = context.expected_type
            let type_id = if expected >= 0 and sem_kind(context, expected) == "list" { expected } else { sem_wrap(context, "list", sem_simple(context, "any")) }
            return sem_expr(context, "list", sem_value(type_id), source, "", [], -1, -1)
        }
        let expected_container = context.expected_type
        let mut element = -1
        if expected_container >= 0 and sem_kind(context, expected_container) == "list" { element = context.types[expected_container].args[0] }
        context.expected_type = element
        let initial = sem_expression(context, 0, true)
        let mut values: list[int] = [initial.node]
        let mut first = initial.type_id
        if element >= 0 { sem_require(context, first, element, "W2001") first = element }
        while sem_match(context, "COMMA") {
            if sem_is(context, "RBRACKET") { break }
            let next = sem_expression(context, 0, true)
            sem_require(context, next.type_id, first, "W2001")
            values.append(next.node)
        }
        sem_expect(context, "RBRACKET")
        context.expected_type = expected_container
        return sem_expr(context, "list", sem_value(sem_wrap(context, "list", first)), source, "", values, -1, -1)
    }
    if sem_match(context, "LBRACE") {
        if sem_match(context, "RBRACE") {
            let expected = context.expected_type
            let type_id = if expected >= 0 and sem_kind(context, expected) == "dict" { expected } else { sem_intern(context, "dict", "", [sem_simple(context, "any"), sem_simple(context, "any")]) }
            return sem_expr(context, "dict", sem_value(type_id), source, "", [], -1, -1)
        }
        let expected_container = context.expected_type
        let mut expected_key = -1
        let mut expected_value = -1
        if expected_container >= 0 and sem_kind(context, expected_container) == "dict" {
            expected_key = context.types[expected_container].args[0]
            expected_value = context.types[expected_container].args[1]
        }
        context.expected_type = expected_key
        let key_value = sem_expression(context, 0, true)
        let key = key_value.type_id
        context.expected_type = expected_container
        if not sem_key(context, key) { sem_error(context, "W2010", "invalid dictionary key") }
        if expected_key >= 0 { sem_require(context, key, expected_key, "W2001") }
        sem_expect(context, "COLON")
        context.expected_type = expected_value
        let first_value = sem_expression(context, 0, true)
        let value = first_value.type_id
        let mut values: list[int] = [key_value.node, first_value.node]
        context.expected_type = expected_container
        if expected_value >= 0 { sem_require(context, value, expected_value, "W2001") }
        while sem_match(context, "COMMA") {
            if sem_is(context, "RBRACE") { break }
            context.expected_type = expected_key
            let next_key_value = sem_expression(context, 0, true)
            let next_key = next_key_value.type_id
            values.append(next_key_value.node)
            context.expected_type = expected_container
            sem_require(context, next_key, key, "W2001")
            sem_expect(context, "COLON")
            context.expected_type = expected_value
            let next_value_expression = sem_expression(context, 0, true)
            let next_value = next_value_expression.type_id
            values.append(next_value_expression.node)
            context.expected_type = expected_container
            sem_require(context, next_value, value, "W2001")
        }
        sem_expect(context, "RBRACE")
        let type_id = if expected_key >= 0 { expected_container } else { sem_intern(context, "dict", "", [key, value]) }
        return sem_expr(context, "dict", sem_value(type_id), source, "", values, -1, -1)
    }
    if sem_is(context, "IF") { return sem_if(context, statement) }
    if sem_is(context, "MATCH") { return sem_match_expression(context, statement) }
    if sem_is(context, "THIS") or sem_is(context, "SUPER") {
        if context.capture_depth >= 0 { sem_error(context, "W2001", "capture receiver through explicit local binding") }
        let is_super = sem_take(context).kind == "SUPER"
        if context.owner == "" { sem_error(context, "W1004", "receiver outside method") }
        let mut owner = context.owner
        if is_super {
            owner = ""
            for class_ in context.classes { if class_.name == context.owner { owner = class_.parent } }
            if owner == "" { sem_error(context, "W1004", "super without base class") }
        }
        let symbol = sem_lookup(context, "self")
        if symbol < 0 { sem_error(context, "W9999", "checked receiver binding missing") }
        return sem_expr(context, if is_super { "super" } else { "binding" }, SemValue { type_id: sem_named(context, owner), root: "this", writable: -1, terminates: false, node: -1 }, source, "self", [], context.variables[symbol].binding, -1)
    }
    sem_match(context, "NEW")
    let name = sem_expect(context, "IDENT").val
    let variable = sem_lookup(context, name)
    if variable >= 0 {
        let value = context.variables[variable]
        if context.capture_depth >= 0 and value.depth < context.capture_depth and not module_contains(context.capture_names, name) { context.capture_names.append(name) }
        return sem_expr(context, "binding", SemValue { type_id: value.type_id, root: name, writable: value.type_id, terminates: false, node: -1 }, source, name, [], value.binding, -1)
    }
    if name == "None" { return sem_expr(context, "none", sem_value(context.none_type), source, "", [], -1, -1) }
    if name == "Option" or name == "Result" {
        sem_expect(context, "DOT")
        let variant = sem_expect(context, "IDENT").val
        if name == "Option" and variant == "None" { return sem_expr(context, "none", sem_value(context.none_type), source, "", [], -1, -1) }
        if name == "Option" and variant == "Some" or name == "Result" and (variant == "Ok" or variant == "Err") {
            let empty: list[int] = []
            return sem_expr(context, "callee", sem_value(sem_intern(context, "enum_ctor", name + "." + variant, empty)), source, variant, [], -1, -1)
        }
        sem_error(context, "W1001", "unknown built-in enum variant: " + name + "." + variant)
    }
    if sem_builtin(name) {
        let empty: list[int] = []
        return sem_expr(context, "callee", sem_value(sem_intern(context, "builtin", name, empty)), source, name, [], -1, -1)
    }
    let function = sem_function(context, name)
    if function >= 0 {
        let signature = context.functions[function]
        let mut type_id = signature.type_id
        if len(signature.type_params) > 0 and sem_match(context, "LBRACKET") {
            let mut arguments: list[int] = []
            while not sem_is(context, "RBRACKET") {
                arguments.append(sem_type(context))
                if not sem_match(context, "COMMA") { break }
            }
            sem_expect(context, "RBRACKET")
            if len(arguments) != len(signature.type_params) { sem_error(context, "W2001", "generic function type arity") }
            let mut substitutions: list[int] = []
            for parameter in signature.type_params {
                let empty: list[int] = []
                substitutions.append(sem_intern(context, "typeparam", parameter, empty))
            }
            let target = context.types[signature.type_id]
            let mut specialized: list[int] = []
            for part in target.args { specialized.append(sem_substitute_type(context, part, signature.type_params, arguments)) }
            type_id = sem_intern(context, "function", "", specialized)
        }
        return sem_expr(context, "callee", SemValue { type_id: type_id, root: "fn:" + name, writable: -1, terminates: false, node: -1 }, source, name, [], -1, function)
    }
    let generic_type = sem_generic_type(context, name)
    let mut selected_type = -1
    if generic_type >= 0 and sem_match(context, "LBRACKET") {
        let mut type_arguments: list[int] = []
        while not sem_is(context, "RBRACKET") {
            type_arguments.append(sem_type(context))
            if not sem_match(context, "COMMA") { break }
        }
        sem_expect(context, "RBRACKET")
        if len(type_arguments) != len(context.generic_types[generic_type].params) { sem_error(context, "W2001", "generic type arity: " + name) }
        selected_type = sem_intern(context, context.generic_types[generic_type].kind, name, type_arguments)
    } elif context.expected_type >= 0 and generic_type >= 0 and sem_same_type_declaration(context, sem_named(context, name), context.expected_type) {
        selected_type = context.expected_type
    }
    let mut named_type = selected_type
    if named_type < 0 {
        for i in 0..len(context.types) {
            if context.types[i].name == name and (context.types[i].kind == "class" or context.types[i].kind == "struct" or context.types[i].kind == "enum") {
                if len(context.types[i].args) == 0 { named_type = i }
            }
        }
    }
    if named_type < 0 {
        let mut variant = -1
        for i in 0..len(context.variants) {
            if context.variants[i] == name {
                if variant >= 0 { sem_error(context, "W1001", "ambiguous enum variant") }
                if len(context.variant_payloads[i]) > 0 { sem_error(context, "W2005", "enum variant requires a payload: " + name) }
                variant = context.variant_types[i]
            }
        }
        if variant >= 0 {
            let value = sem_expr(context, "enum", sem_value(variant), source, name, [], -1, -1)
            if context.capture_nodes { context.nodes[value.node].labels = [context.types[variant].name, name] }
            return value
        }
        sem_error(context, "W1001", "unknown identifier: " + name)
    }
    if sem_kind(context, named_type) == "class" { return sem_expr(context, "new_callee", sem_value(sem_wrap(context, "constructor", named_type)), source, name, [], -1, -1) }
    if sem_kind(context, named_type) == "struct" {
        if sem_is(context, "LPAREN") {
            let mut target_types: list[int] = []
            if selected_type >= 0 { target_types.append(selected_type) }
            return sem_expr(context, "constructor", sem_value(sem_intern(context, "struct_ctor", name, target_types)), source, name, [], -1, -1)
        }
        if allow_struct and sem_match(context, "LBRACE") {
            let unification = new SemUnification()
            let empty_names: list[str] = []
            let empty_types: list[int] = []
            unification.names = empty_names
            unification.types = empty_types
            if selected_type >= 0 and generic_type >= 0 {
                unification.names = context.generic_types[generic_type].params
                unification.types = context.types[selected_type].args
            }
            let mut initialized: list[str] = []
            let mut values: list[int] = []
            while not sem_is(context, "RBRACE") {
                let field_name = sem_expect(context, "IDENT").val
                let field = sem_field(context, name, field_name)
                if field < 0 { sem_error(context, "W3002", "unknown struct field") }
                for previous in initialized { if previous == field_name { sem_error(context, "W2007", "duplicate initializer") } }
                initialized.append(field_name)
                sem_expect(context, "COLON")
                let field_context = context.expected_type
                let field_type = sem_substitute_type(context, context.fields[field].type_id, unification.names, unification.types)
                context.expected_type = if sem_symbolic(context, field_type) { -1 } else { field_type }
                let expression = sem_expression(context, 0, true)
                context.expected_type = field_context
                let actual = expression.type_id
                values.append(expression.node)
                if generic_type >= 0 and selected_type < 0 { sem_unify_type(context, unification, context.fields[field].type_id, actual) }
                let expected = sem_substitute_type(context, context.fields[field].type_id, unification.names, unification.types)
                sem_require(context, actual, expected, "W2001")
                sem_match(context, "COMMA")
            }
            sem_expect(context, "RBRACE")
            for field in context.fields {
                if field.owner == name {
                    let mut found = false
                    for candidate in initialized { if candidate == field.name { found = true } }
                    if not found { sem_error(context, "W2007", "missing struct field") }
                }
            }
            if generic_type >= 0 and selected_type < 0 {
                let mut concrete_types: list[int] = []
                for parameter in context.generic_types[generic_type].params {
                    let mut concrete = -1
                    for i in 0..len(unification.names) { if unification.names[i] == parameter { concrete = unification.types[i] } }
                    if concrete < 0 { sem_error(context, "W2001", "cannot infer generic struct type argument: " + parameter) }
                    concrete_types.append(concrete)
                }
                named_type = sem_intern(context, context.generic_types[generic_type].kind, name, concrete_types)
            }
            let constructed = sem_expr(context, "struct", sem_value(named_type), source, name, values, -1, -1)
            if context.capture_nodes { context.nodes[constructed.node].labels = initialized }
            return constructed
        }
        return sem_value(named_type)
    }
    return sem_expr(context, "namespace", sem_value(named_type), source, name, [], -1, -1)
}
fn sem_complete_constructor(context: SemanticContext) {
    if context.initializing {
        for field in context.fields {
            if field.owner == context.owner {
                let mut found = false
                for initialized in context.initialized { if initialized == field.name { found = true } }
                if not found { sem_error(context, "W3004", "uninitialized constructor field: " + field.name) }
            }
        }
    }
}
fn sem_expression(context: SemanticContext, minimum: int, allow_struct: bool) -> SemValue {
    let statement = context.statement_context
    context.statement_context = false
    let source = sem_at(context)
    let mut left = sem_prefix(context, allow_struct, statement)
    if context.capture_nodes and left.node < 0 { left = sem_expr(context, "unsupported", left, source, source.kind, [], -1, -1) }
    while true {
        let saved = context.pos
        while sem_is(context, "NEWLINE") { sem_take(context) }
        if not sem_is(context, "ELSE") or not (context.tokens[context.pos + 1].kind == "LBRACE" or context.tokens[context.pos + 1].kind == "IDENT" and context.tokens[context.pos + 2].kind == "LBRACE") { context.pos = saved }

        let call_token = sem_at(context)
        let call_line = call_token.line
        let call_col = call_token.col
        let call_file = call_token.file
        if sem_match(context, "LPAREN") {
            let callee = left
            let mut argument_nodes: list[int] = []
            let mut args: list[int] = []
            let signature = context.types[left.type_id]
            let previous_expected = context.expected_type
            while not sem_is(context, "RPAREN") {
                context.expected_type = -1
                if signature.kind == "function" and len(args) + 1 < len(signature.args) { context.expected_type = signature.args[len(args)] }
                if signature.kind == "builtin" and previous_expected >= 0 {
                    let expected_type = context.types[previous_expected]
                    if signature.name == "Some" and expected_type.kind == "optional" { context.expected_type = expected_type.args[0] }
                    elif signature.name == "Ok" and expected_type.kind == "result" { context.expected_type = expected_type.args[0] }
                    elif signature.name == "Err" and expected_type.kind == "result" { context.expected_type = expected_type.args[1] }
                }
                if signature.kind == "enum_ctor" and previous_expected >= 0 {
                    let expected_type = context.types[previous_expected]
                    if signature.name == "Option.Some" and expected_type.kind == "optional" { context.expected_type = expected_type.args[0] }
                    elif signature.name == "Result.Ok" and expected_type.kind == "result" { context.expected_type = expected_type.args[0] }
                    elif signature.name == "Result.Err" and expected_type.kind == "result" { context.expected_type = expected_type.args[1] }
                }

                let argument = sem_expression(context, 0, true)
                if context.initializing and argument.root == "this" { sem_complete_constructor(context) }
                args.append(argument.type_id)
                argument_nodes.append(argument.node)
                if not sem_match(context, "COMMA") { break }
            }
            sem_expect(context, "RPAREN")
            context.expected_type = previous_expected
            if len(left.root) >= 3 and slice(left.root, 0, 3) == "fn:" {
                let function_index = sem_function(context, slice(left.root, 3, len(left.root)))
                if function_index >= 0 and len(context.functions[function_index].type_params) > 0 {
                    sem_check_generic_constraints(context, function_index, args, call_file, call_line, call_col)
                }
            }
            let actual = sem_check_call(context, left.type_id, args, statement)
            let mut concrete_target = -1
            if context.capture_nodes and len(callee.root) >= 3 and slice(callee.root, 0, 3) == "fn:" {
                let template = sem_function(context, slice(callee.root, 3, len(callee.root)))
                if template >= 0 and len(context.functions[template].type_params) > 0 { concrete_target = sem_specialize(context, template, callee.type_id, args, call_token) }
            }
            let result_kind = sem_kind(context, actual)
            if context.expected_type >= 0 and sem_kind(context, context.expected_type) == "result" and (result_kind == "ok" or result_kind == "err") and sem_assignable(context, actual, context.expected_type) {
                left = sem_value(context.expected_type)
            } else { left = sem_value(actual) }
            if context.capture_nodes {
                let target = context.nodes[callee.node]
                let mut nodes = argument_nodes
                let mut kind = "call"
                if target.kind == "collection_method" { kind = "collection_call" nodes = target.children for argument in argument_nodes { nodes.append(argument) } }
                elif target.kind == "constructor" { kind = "struct_call" }
                elif target.kind == "new_callee" { kind = "new" }
                elif target.kind == "method" or target.kind == "direct_method" {
                    kind = if target.kind == "method" { "virtual_call" } else { "call" }
                    nodes = target.children
                    for argument in argument_nodes { nodes.append(argument) }
                }
                elif target.kind == "enum_callee" { kind = "enum_call" }
                elif target.kind != "callee" { kind = "indirect_call" nodes = [callee.node] for argument in argument_nodes { nodes.append(argument) } }
                left = sem_expr(context, kind, left, call_token, target.text, nodes, -1, target.target)
                context.nodes[left.node].labels = target.labels
                if concrete_target >= 0 {
                    context.nodes[left.node].target = concrete_target
                    context.nodes[left.node].text = context.functions[concrete_target].name
                }
            }
        } elif sem_match(context, "DOT") {
            let name = sem_expect(context, "IDENT").val
            let receiver = left
            left = sem_member(context, left, name)
            if context.capture_nodes {
                let receiver_type = context.types[receiver.type_id]
                if left.root == "#method" {
                    let target = sem_method(context, receiver_type.name, name)
                    let kind = if context.nodes[receiver.node].kind == "super" or name == "init" { "direct_method" } else { "method" }
                    left = sem_expr(context, kind, left, call_token, context.functions[target].name, [receiver.node], -1, target)
                    context.nodes[left.node].labels = [receiver_type.name, name]
                } else {
                    let mut category = if left.root == "#collection" { "collection_method" } else { "member" }
                    if receiver_type.kind == "enum" and context.nodes[receiver.node].kind == "namespace" { category = if sem_kind(context, left.type_id) == "enum_ctor" { "enum_callee" } else { "enum" } }
                    left = sem_expr(context, category, left, call_token, name, if category == "enum" or category == "enum_callee" { [] } else { [receiver.node] }, -1, -1)
                    if category == "enum" or category == "enum_callee" { context.nodes[left.node].labels = [receiver_type.name, name] }
                }
            }
        } elif sem_match(context, "LBRACKET") {
            let receiver = left
            let indexed = sem_expression(context, 0, true)
            let index = indexed.type_id
            sem_expect(context, "RBRACKET")
            let type_ = context.types[left.type_id]
            if type_.kind == "list" {
                sem_require(context, index, context.integer_type, "W2001")
                left = SemValue { type_id: type_.args[0], root: left.root, writable: type_.args[0], terminates: false, node: -1 }
            } elif type_.kind == "dict" {
                # `d[k]` yields V and panics with W4002 when the key is absent; the
                # optional form is `d.get(k)`. See SPEC 10.2.
                sem_require(context, index, type_.args[0], "W2001")
                left = SemValue { type_id: type_.args[1], root: left.root, writable: type_.args[1], terminates: false, node: -1 }
            } elif left.type_id == context.string_type {
                sem_require(context, index, context.integer_type, "W2001")
                left = sem_value(context.string_type)
            } else { sem_error(context, "W2001", "value cannot be indexed") }
            left = sem_expr(context, "index", left, call_token, "", [receiver.node, indexed.node], -1, -1)
        } elif sem_match(context, "QUESTION") {
            let operand_node = left.node
            let type_ = context.types[left.type_id]
            let returned = context.types[context.return_type]
            if type_.kind != "optional" and type_.kind != "result" { sem_error(context, "W2006", "propagation operand") }
            if returned.kind != type_.kind { sem_error(context, "W2006", "propagation return channel") }
            if type_.kind == "result" and not sem_error_channel_assignable(context, type_.args[1], returned.args[1]) { sem_error(context, "W2006", "propagation error channel") }
            left = sem_expr(context, "propagate", sem_value(type_.args[0]), call_token, "", [operand_node], -1, -1)
        } elif sem_match(context, "ELSE") {
            let operand_node = left.node
            let mut error_binding = -1
            let operand = context.types[left.type_id]
            if operand.kind != "optional" and operand.kind != "result" { sem_error(context, "W2006", "handler operand") }
            let scope = sem_enter_scope(context)
            if sem_is(context, "IDENT") {
                let error_name = sem_take(context).val
                if operand.kind != "result" { sem_error(context, "W2006", "optional has no error binding") }
                error_binding = sem_declare(context, error_name, operand.args[1], false)
            }
            let handler = sem_block(context, false)
            sem_leave_scope(context, scope)
            if not handler.terminates {
                if sem_kind(context, handler.type_id) == "empty" { sem_error(context, "W2001", "handler collection requires a concrete element type") }
                sem_require(context, handler.type_id, operand.args[0], "W2001")
            }
            left = sem_expr(context, "handler", sem_value(operand.args[0]), call_token, "", [operand_node, handler.node], error_binding, -1)
        } else {
            let operand_node = left.node
            let operator = sem_at(context).kind
            let precedence = op_precedence(operator)
            if precedence <= minimum { break }
            let logical_left = context.pos - 1
            let mut logical_constant = -1
            if logical_left >= 0 {
                if context.tokens[logical_left].kind == "FALSE" { logical_constant = 0 }
                elif context.tokens[logical_left].kind == "TRUE" { logical_constant = 1 }
            }
            sem_take(context)
            let mut right_minimum = precedence
            if operator == "ASSIGN" or operator == "QQ" { right_minimum = precedence - 1 }
            let previous_expected = context.expected_type
            if operator == "ASSIGN" { context.expected_type = left.writable }
            let before_right = context.initialized
            let right = sem_expression(context, right_minimum, allow_struct)
            let after_right = context.initialized
            context.expected_type = previous_expected
            if operator == "ASSIGN" {
                if left.writable < 0 { sem_error(context, "W2002", "invalid assignment target") }
                sem_mutable(context, left.root)
                sem_require(context, right.type_id, left.writable, "W2001")
                if context.initializing and len(left.root) > 5 and slice(left.root, 0, 5) == "this:" { context.initialized.append(slice(left.root, 5, len(left.root))) }
                left = sem_value(left.writable)
            } elif operator == "QQ" {
                if left.type_id == context.none_type {
                    context.initialized = after_right
                } else {
                    context.initialized = sem_intersect(before_right, after_right)
                }
                if left.type_id == context.none_type { left = right }
                elif sem_kind(context, left.type_id) == "optional" {
                    let inner = context.types[left.type_id].args[0]
                    sem_require(context, right.type_id, inner, "W2001")
                    left = sem_value(inner)
                } else { sem_error(context, "W2006", "coalesce requires optional") }
            } elif operator == "DOT_DOT" or operator == "DOT_DOT_EQ" {
                sem_require(context, left.type_id, context.integer_type, "W2001")
                sem_require(context, right.type_id, context.integer_type, "W2001")
                left = sem_value(sem_wrap(context, "list", context.integer_type))
            } elif operator == "AND" or operator == "OR" {
                sem_require(context, left.type_id, context.boolean_type, "W2001")
                sem_require(context, right.type_id, context.boolean_type, "W2001")
                let skips_right = (operator == "AND" and logical_constant == 0) or (
                    operator == "OR" and logical_constant == 1
                )
                let runs_right = (operator == "AND" and logical_constant == 1) or (
                    operator == "OR" and logical_constant == 0
                )
                if skips_right { context.initialized = before_right }
                elif runs_right { context.initialized = after_right }
                else { context.initialized = sem_intersect(before_right, after_right) }
                left = sem_value(context.boolean_type)
            } elif operator == "EQ" or operator == "NEQ" {
                let left_kind = sem_kind(context, left.type_id)
                let right_kind = sem_kind(context, right.type_id)
                let result_pair = (left_kind == "ok" or left_kind == "err") and (right_kind == "ok" or right_kind == "err")
                if not result_pair and not sem_assignable(context, left.type_id, right.type_id) and not sem_assignable(context, right.type_id, left.type_id) { sem_error(context, "W2001", "equality types") }
                left = sem_value(context.boolean_type)
            } else {
                let deferred = sem_defer(context, "operator:" + operator, [left.type_id, right.type_id])
                if not deferred and left.type_id != right.type_id { sem_error(context, "W2001", "binary operand types") }
                if not deferred and left.type_id != context.integer_type and left.type_id != context.float_type and (operator != "PLUS" or left.type_id != context.string_type) { sem_error(context, "W2001", "invalid binary operation") }
                if not deferred and operator == "PERCENT" and left.type_id != context.integer_type { sem_error(context, "W2001", "modulo requires integers") }
                if operator == "LT" or operator == "LTE" or operator == "GT" or operator == "GTE" { left = sem_value(context.boolean_type) }
                else { left = sem_value(left.type_id) }
            }
            left = sem_expr(context, if operator == "ASSIGN" { "assign" } else { "binary" }, left, call_token, operator, [operand_node, right.node], -1, -1)
        }
    }
    if left.root == "#method" or left.root == "#collection" or sem_kind(context, left.type_id) == "builtin" or sem_kind(context, left.type_id) == "constructor" { sem_error(context, "W2013", "callable syntax requires an explicit lambda adapter") }
    return left
}
fn sem_intersect(left: list[str], right: list[str]) -> list[str] {
    let mut result: list[str] = []
    for value in left { for other in right { if value == other { result.append(value) } } }
    return result
}
fn sem_check_discarded_branch(context: SemanticContext, type_id: int, statement: bool) {
    if statement and context.expected_type >= 0 and sem_kind(context, context.expected_type) == "result" and sem_unit_return(context, context.expected_type) {
        sem_require_tail(context, type_id, context.expected_type)
    }
}
fn sem_if(context: SemanticContext, statement: bool) -> SemValue {
    let source = sem_expect(context, "IF")
    let condition = sem_expression(context, 0, false)
    sem_require(context, condition.type_id, context.boolean_type, "W2001")
    let mut conditions: list[int] = [condition.node]
    let mut branches: list[int] = []
    let mut sources: list[Token] = [source]
    let initial = context.initialized
    let first = sem_block(context, statement)
    branches.append(first.node)
    sem_check_discarded_branch(context, first.type_id, statement)
    let mut initialized = context.initialized
    let mut all_return = first.terminates
    let mut common = first.type_id
    sem_skip_newlines_before_branch(context)
    while sem_is(context, "ELIF") {
        sources.append(sem_take(context))
        context.initialized = initial
        let condition = sem_expression(context, 0, false)
        sem_require(context, condition.type_id, context.boolean_type, "W2001")
        conditions.append(condition.node)
        let branch = sem_block(context, statement)
        branches.append(branch.node)
        sem_check_discarded_branch(context, branch.type_id, statement)
        if not branch.terminates and not all_return and not sem_assignable(context, branch.type_id, common) { if not statement { sem_error(context, "W2001", "incompatible if branches") } common = context.unit_type }
        if not branch.terminates {
            if all_return { initialized = context.initialized } else { initialized = sem_intersect(initialized, context.initialized) }
            if all_return { common = branch.type_id }
        }
        all_return = all_return and branch.terminates
        sem_skip_newlines_before_branch(context)
    }
    context.initialized = initial
    if sem_match(context, "ELSE") {
        let branch = sem_block(context, statement)
        branches.append(branch.node)
        sem_check_discarded_branch(context, branch.type_id, statement)
        if not branch.terminates {
            if not all_return and not sem_assignable(context, branch.type_id, common) { if not statement { sem_error(context, "W2001", "incompatible if branches") } common = context.unit_type }
            if all_return { initialized = context.initialized } else { initialized = sem_intersect(initialized, context.initialized) }
            if all_return { common = branch.type_id }
        }
        all_return = all_return and branch.terminates
    } else {
        initialized = sem_intersect(initialized, initial)
        all_return = false
        common = context.unit_type
    }
    context.initialized = initialized
    let mut alternate = sem_node(context, "unit", context.unit_type, source, "", [], -1, -1)
    if len(branches) > len(conditions) { alternate = branches[len(branches) - 1] }
    let mut index = len(conditions) - 1
    while index >= 0 {
        alternate = sem_node(context, "if", common, sources[index], "", [conditions[index], branches[index], alternate], -1, -1)
        index = index - 1
    }
    return SemValue { type_id: common, root: "", writable: -1, terminates: all_return, node: alternate }
}
fn sem_record_pattern(context: SemanticContext, name: str, children: list[int]) -> str {
    context.patterns.append(SemPattern { name: name, children: children, type_id: context.unit_type, binding: -1, source: sem_at(context) })
    context.last_pattern = len(context.patterns) - 1
    return name
}
fn sem_leaf_pattern(context: SemanticContext, name: str) -> str {
    let empty: list[int] = []
    return sem_record_pattern(context, name, empty)
}
fn sem_constructors(context: SemanticContext, subject: int) -> list[SemConstructor] {
    let type_ = context.types[subject]
    let mut constructors: list[SemConstructor] = []
    let empty: list[int] = []
    if type_.kind == "tuple" { constructors.append(SemConstructor { name: "tuple", payloads: type_.args }) }
    elif type_.kind == "bool" {
        constructors.append(SemConstructor { name: "literal:true", payloads: empty })
        constructors.append(SemConstructor { name: "literal:false", payloads: empty })
    } elif type_.kind == "optional" {
        constructors.append(SemConstructor { name: "Some", payloads: [type_.args[0]] })
        constructors.append(SemConstructor { name: "None", payloads: empty })
    } elif type_.kind == "result" {
        constructors.append(SemConstructor { name: "Ok", payloads: [type_.args[0]] })
        constructors.append(SemConstructor { name: "Err", payloads: [type_.args[1]] })
    } elif type_.kind == "error_union" {
        for alternative in type_.args { constructors.append(SemConstructor { name: sem_error_type_name(context, alternative), payloads: [alternative] }) }
    } elif type_.kind == "enum" {
        let generic = sem_generic_type(context, type_.name)
        for i in 0..len(context.variants) {
            if sem_same_type_declaration(context, context.variant_types[i], subject) {
                let mut payloads = context.variant_payloads[i]
                if generic >= 0 and len(type_.args) == len(context.generic_types[generic].params) {
                    let mut concrete: list[int] = []
                    for payload in payloads { concrete.append(sem_substitute_type(context, payload, context.generic_types[generic].params, type_.args)) }
                    payloads = concrete
                }
                constructors.append(SemConstructor { name: context.variants[i], payloads: payloads })
            }
        }
    }
    return constructors
}
fn sem_pattern_matrix(context: SemanticContext, types: list[int], rows: list[list[int]]) -> bool {
    if len(types) == 0 { return len(rows) > 0 }
    if len(rows) == 0 { return false }
    let tail = slice(types, 1, len(types))
    let mut defaults: list[list[int]] = []
    for row in rows { if context.patterns[row[0]].name == "*" { defaults.append(slice(row, 1, len(row))) } }
    if len(defaults) > 0 and sem_pattern_matrix(context, tail, defaults) { return true }
    let constructors = sem_constructors(context, types[0])
    if len(constructors) == 0 { return false }
    for constructor in constructors {
        let mut specialized: list[list[int]] = []
        for row in rows {
            let pattern = context.patterns[row[0]]
            let mut children: list[int] = []
            let mut matches = false
            if pattern.name == "*" {
                for payload in constructor.payloads { sem_leaf_pattern(context, "*") children.append(context.last_pattern) }
                matches = true
            } elif pattern.name == constructor.name { children = pattern.children matches = true }
            if matches {
                for element in slice(row, 1, len(row)) { children.append(element) }
                specialized.append(children)
            }
        }
        let mut next_types = constructor.payloads
        for type_id in tail { next_types.append(type_id) }
        if not sem_pattern_matrix(context, next_types, specialized) { return false }
    }
    return true
}
fn sem_pattern(context: SemanticContext, subject: int) -> str {
    let source = sem_at(context)
    let name = sem_pattern_syntax(context, subject)
    if name == "None" and sem_kind(context, subject) != "optional" and sem_kind(context, subject) != "enum" { report_error_at("W2001", source, "none pattern requires an optional subject") }
    context.patterns[context.last_pattern].source = source
    context.patterns[context.last_pattern].type_id = subject
    return name
}
fn sem_binding_pattern(context: SemanticContext, name: str, subject: int) -> str {
    let binding = sem_declare(context, name, subject, false)
    let pattern = sem_leaf_pattern(context, "*")
    context.patterns[context.last_pattern].binding = binding
    return pattern
}
fn sem_pattern_syntax(context: SemanticContext, subject: int) -> str {
    if sem_match(context, "ELSE") { return sem_leaf_pattern(context, "*") }
    if sem_match(context, "NONE") { return sem_leaf_pattern(context, "None") }
    if sem_match(context, "MINUS") {
        let literal = sem_take(context)
        if literal.kind != "INT" { report_error_at("W0002", literal, "expected integer pattern after '-'") }
        sem_require(context, context.integer_type, subject, "W2001")
        return sem_leaf_pattern(context, "literal:-" + literal.val)
    }
    if sem_is(context, "INT") or sem_is(context, "STR") or sem_is(context, "TRUE") or sem_is(context, "FALSE") {
        let token = sem_take(context)
        let mut type_id = context.boolean_type
        if token.kind == "INT" { type_id = context.integer_type }
        elif token.kind == "FLOAT" { type_id = context.float_type }
        elif token.kind == "STR" { type_id = context.string_type }
        sem_require(context, type_id, subject, "W2001")
        return sem_leaf_pattern(context, "literal:" + token.val)
    }
    if sem_match(context, "LPAREN") {
        if sem_kind(context, subject) != "tuple" { sem_error(context, "W2001", "tuple pattern requires a tuple") }
        let elements = context.types[subject].args
        let mut children: list[int] = []
        if not sem_is(context, "RPAREN") {
            while true {
                if len(children) >= len(elements) { sem_error(context, "W2001", "too many tuple pattern elements") }
                sem_pattern(context, elements[len(children)])
                children.append(context.last_pattern)
                if not sem_match(context, "COMMA") or sem_is(context, "RPAREN") { break }
            }
        }
        sem_expect(context, "RPAREN")
        if len(children) != len(elements) { sem_error(context, "W2001", "tuple pattern arity") }
        return sem_record_pattern(context, "tuple", children)
    }

    let mut owner = ""
    let mut name = sem_expect(context, "IDENT").val
    if name == "_" { return sem_leaf_pattern(context, "*") }
    if sem_match(context, "DOT") { owner = name name = sem_expect(context, "IDENT").val }
    let kind = sem_kind(context, subject)
    if sem_match(context, "LPAREN") {
        if kind == "error_union" {
            if owner != "" { sem_error(context, "W2001", "error type patterns must be unqualified") }
            let mut error_type = -1
            if name == "int" { error_type = context.integer_type }
            elif name == "float" { error_type = context.float_type }
            elif name == "bool" { error_type = context.boolean_type }
            elif name == "str" { error_type = context.string_type }
            else { error_type = sem_named(context, name) }
            let mut is_alternative = false
            for alternative in context.types[subject].args { if alternative == error_type { is_alternative = true } }
            if not is_alternative { sem_error(context, "W2001", "error type pattern is not an alternative of this union") }
            if sem_is(context, "RPAREN") { sem_error(context, "W2005", "error type pattern requires exactly one payload binding") }
            if not sem_is(context, "IDENT") { sem_error(context, "W2005", "error type pattern payload must be a binding or wildcard") }
            let child_pattern = sem_pattern(context, error_type)
            if child_pattern != "*" { sem_error(context, "W2005", "error type pattern payload must be a binding or wildcard") }
            if sem_match(context, "COMMA") { sem_error(context, "W2005", "error type pattern requires exactly one payload binding") }
            sem_expect(context, "RPAREN")
            return sem_record_pattern(context, sem_error_type_name(context, error_type), [context.last_pattern])
        }
        let mut payload_types: list[int] = []
        let mut valid = false
        if (owner == "" or owner == "Option") and name == "Some" and kind == "optional" {
            payload_types = [context.types[subject].args[0]]
            valid = true
        } elif (owner == "" or owner == "Result") and name == "Ok" and kind == "result" {
            payload_types = [context.types[subject].args[0]]
            valid = true
        } elif (owner == "" or owner == "Result") and name == "Err" and kind == "result" {
            payload_types = [context.types[subject].args[1]]
            valid = true
        } elif kind == "enum" {
            if owner != "" and owner != context.types[subject].name { sem_error(context, "W2001", "pattern enum identity") }
            let generic = sem_generic_type(context, context.types[subject].name)
            for i in 0..len(context.variants) {
                if context.variants[i] == name and context.types[context.variant_types[i]].name == context.types[subject].name {
                    payload_types = context.variant_payloads[i]
                    if generic >= 0 and len(context.types[subject].args) == len(context.generic_types[generic].params) {
                        let mut concrete: list[int] = []
                        for payload in payload_types { concrete.append(sem_substitute_type(context, payload, context.generic_types[generic].params, context.types[subject].args)) }
                        payload_types = concrete
                    }
                    valid = true
                }
            }
        }
        if not valid { sem_error(context, "W2001", "payload pattern") }
        let mut count = 0
        let mut children: list[int] = []
        if not sem_is(context, "RPAREN") {
            if count >= len(payload_types) { sem_error(context, "W2001", "too many enum pattern bindings") }
            sem_pattern(context, payload_types[count])
            children.append(context.last_pattern)
            count = count + 1
            while sem_match(context, "COMMA") {
                if sem_is(context, "RPAREN") { break }
                if count >= len(payload_types) { sem_error(context, "W2001", "too many enum pattern bindings") }
                sem_pattern(context, payload_types[count])
                children.append(context.last_pattern)
                count = count + 1
            }
        }
        sem_expect(context, "RPAREN")
        if count != len(payload_types) { sem_error(context, "W2001", "enum pattern arity") }
        return sem_record_pattern(context, name, children)
    }
    if kind == "enum" {
        if owner != "" and owner != context.types[subject].name { sem_error(context, "W2001", "pattern enum identity") }
        let mut valid = false
        for i in 0..len(context.variants) { if context.variants[i] == name and context.types[context.variant_types[i]].name == context.types[subject].name and len(context.variant_payloads[i]) == 0 { valid = true } }
        if valid { return sem_leaf_pattern(context, name) }
        if owner != "" { sem_error(context, "W1001", "unknown enum pattern") }
        return sem_binding_pattern(context, name, subject)
    }
    if name == "None" and (kind == "optional" or owner == "Option") { return sem_leaf_pattern(context, "None") }
    if owner != "" { sem_error(context, "W2001", "qualified enum pattern required") }
    return sem_binding_pattern(context, name, subject)
}
fn sem_match_expression(context: SemanticContext, statement: bool) -> SemValue {
    let source = sem_expect(context, "MATCH")
    # Preserve syntax-error priority before resolving an atomic subject's name.
    # A bare pattern followed by a block always lacks its required arrow.
    let mut pattern_start = context.pos + 2
    if pattern_start + 2 < len(context.tokens) and context.tokens[context.pos + 1].kind == "LBRACE" {
        if context.tokens[pattern_start].kind == "MINUS" { pattern_start = pattern_start + 1 }
        let pattern_kind = context.tokens[pattern_start].kind
        let bare_pattern = pattern_kind == "IDENT" or pattern_kind == "INT" or pattern_kind == "STR" or pattern_kind == "TRUE" or pattern_kind == "FALSE" or pattern_kind == "NONE"
        let following = context.tokens[pattern_start + 1]
        if bare_pattern and following.kind == "LBRACE" {
            report_error_at("W0001", following, "expected '=>' after match pattern")
        }
    }
    let subject_value = sem_expression(context, 0, false)
    let subject = subject_value.type_id
    let mut arms: list[int] = []
    sem_expect(context, "LBRACE")
    let mut covered: list[list[int]] = []
    let mut all_return = true
    let mut common = -1
    let mut wildcard = false
    let initial = context.initialized
    let mut initialized = initial
    let mut live_branches = 0
    while true {
        sem_skip_separators(context)
        if sem_is(context, "RBRACE") { break }
        let scope = sem_enter_scope(context)
        context.initialized = initial
        sem_pattern(context, subject)
        let pattern = context.last_pattern
        let mut guarded = false
        let mut guard = -1
        if sem_match(context, "IF") { guarded = true let value = sem_expression(context, 0, false) sem_require(context, value.type_id, context.boolean_type, "W2001") guard = value.node }
        if not sem_match(context, "FAT_ARROW") { sem_error(context, "W0001", "expected '=>' after match pattern") }
        let mut branch = SemFlow { type_id: context.unit_type, terminates: false, node: -1 }
        if sem_is(context, "LBRACE") { branch = sem_block(context, false) }
        else { let value = sem_expression(context, 0, true) branch = SemFlow { type_id: value.type_id, terminates: value.terminates, node: value.node } }
        if context.capture_nodes {
            arms.append(len(context.arms))
            context.arms.append(CheckedArm { pattern: pattern, guard: guard, body: branch.node, source: context.patterns[pattern].source })
        }
        if not guarded {
            covered.append([pattern])
            if context.patterns[pattern].name == "*" { wildcard = true }
        }
        if not branch.terminates {
            if live_branches == 0 { initialized = context.initialized } else { initialized = sem_intersect(initialized, context.initialized) }
            live_branches = live_branches + 1
            if common >= 0 { sem_require(context, branch.type_id, common, "W2001") } else { common = branch.type_id }
        }
        all_return = all_return and branch.terminates
        sem_leave_scope(context, scope)
        sem_match(context, "COMMA")
    }
    sem_expect(context, "RBRACE")
    let kind = sem_kind(context, subject)
    let closed = kind == "enum" or kind == "optional" or kind == "result" or kind == "error_union" or kind == "bool" or kind == "tuple"
    let exhaustive = sem_pattern_matrix(context, [subject], covered)
    if closed and not exhaustive { sem_error(context, "W2003", "non-exhaustive match") }
    if not closed and not exhaustive {
        if common >= 0 and common != context.unit_type { sem_error(context, "W2003", "value match requires exhaustive patterns") }
        if not statement and context.expected_type >= 0 and context.expected_type != context.unit_type { sem_error(context, "W2003", "value match requires exhaustive patterns") }
        initialized = sem_intersect(initialized, initial)
        all_return = false
    }
    context.initialized = initialized
    if common < 0 { common = context.unit_type }
    let result = sem_expr(context, "match", SemValue { type_id: common, root: "", writable: -1, terminates: all_return, node: -1 }, source, "", [subject_value.node], -1, -1)
    if context.capture_nodes { context.nodes[result.node].arms = arms context.nodes[result.node].total = exhaustive }
    return result
}
fn sem_let(context: SemanticContext) -> int {
    let source = sem_expect(context, "LET")
    let mutable = sem_match(context, "MUT")
    let name = sem_expect(context, "IDENT").val
    let mut annotation = -1
    if sem_match(context, "COLON") { annotation = sem_type(context) }
    sem_expect(context, "ASSIGN")
    let previous = context.expected_type
    context.expected_type = annotation

    let initializer = sem_expression(context, 0, true)
    let value = initializer.type_id
    context.expected_type = previous
    if sem_kind(context, value) == "builtin" { sem_error(context, "W2013", "builtin values require an explicit lambda adapter") }
    if annotation < 0 {
        let inferred = context.types[value]
        let untyped_list = inferred.kind == "list" and sem_kind(context, inferred.args[0]) == "any"
        let untyped_dict = inferred.kind == "dict" and sem_kind(context, inferred.args[0]) == "any"
        if value == context.none_type or sem_kind(context, value) == "empty" or untyped_list or untyped_dict { sem_error(context, "W2001", "initializer needs type context") }
        annotation = value
    } else { sem_require(context, value, annotation, "W2001") }
    let binding = sem_declare(context, name, annotation, mutable)
    return sem_node(context, "let", context.unit_type, source, name, [initializer.node], binding, -1)
}
fn sem_block(context: SemanticContext, statement: bool) -> SemFlow {
    let source = sem_expect(context, "LBRACE")
    let mut statements: list[int] = []
    let scope = sem_enter_scope(context)
    let mut tail = context.unit_type
    let mut terminates = false
    while true {
        sem_skip_separators(context)
        if sem_is(context, "RBRACE") or sem_is(context, "EOF") { break }
        let statement_source = sem_at(context)
        if sem_is(context, "LET") { statements.append(sem_let(context)) tail = context.unit_type }
        elif sem_match(context, "RETURN") {
            let previous = context.expected_type
            context.expected_type = context.return_type
            let mut value = context.unit_type
            let mut returned_node = sem_node(context, "unit", context.unit_type, statement_source, "", [], -1, -1)
            if expression_starter(sem_at(context).kind) {

                let expression = sem_expression(context, 0, true)
                value = expression.type_id
                returned_node = expression.node
            }
            context.expected_type = previous
            if context.return_type < 0 { context.return_type = value }
            sem_require(context, value, context.return_type, "W2004")
            sem_complete_constructor(context)
            statements.append(sem_node(context, "return", context.unit_type, statement_source, "", [returned_node], -1, -1))
            terminates = true
            tail = context.unit_type
        } elif sem_match(context, "WHILE") {
            let condition = sem_expression(context, 0, false)
            sem_require(context, condition.type_id, context.boolean_type, "W2001")
            context.loop = context.loop + 1
            let initialized = context.initialized
            let body = sem_block(context, true)
            statements.append(sem_node(context, "while", context.unit_type, statement_source, "", [condition.node, body.node], -1, -1))
            context.initialized = initialized
            context.loop = context.loop - 1
            tail = context.unit_type
        } elif sem_match(context, "FOR") {
            let pattern = sem_for_pattern(context, true)
            sem_expect(context, "IN")
            let sequence = sem_expression(context, 0, false)
            let iterable = sequence.type_id
            if sem_kind(context, iterable) != "list" { sem_error(context, "W2001", "for requires list or range") }
            let element = context.types[iterable].args[0]
            let scope = sem_enter_scope(context)
            sem_bind_for_pattern(context, pattern, element)
            context.loop = context.loop + 1
            let initialized = context.initialized
            let body = sem_block(context, true)
            let node = sem_node(context, "for", context.unit_type, statement_source, "", [sequence.node, body.node], -1, -1)
            if context.capture_nodes { context.nodes[node].pattern = pattern }
            statements.append(node)
            context.initialized = initialized
            context.loop = context.loop - 1
            sem_leave_scope(context, scope)
            tail = context.unit_type
        } elif sem_match(context, "BREAK") or sem_match(context, "CONTINUE") {
            if context.loop == 0 { sem_error(context, "W1004", "loop transfer outside loop") }
            statements.append(sem_node(context, if statement_source.kind == "BREAK" { "break" } else { "continue" }, context.unit_type, statement_source, "", [], -1, -1))
            terminates = true
            tail = context.unit_type
        } else {
            context.statement_context = statement or not sem_tail_expression(context)
            let expression = sem_expression(context, 0, true)
            tail = expression.type_id
            statements.append(expression.node)
            terminates = terminates or expression.terminates
        }
    }
    sem_expect(context, "RBRACE")
    sem_leave_scope(context, scope)
    return SemFlow { type_id: tail, terminates: terminates, node: sem_node(context, "block", tail, source, "", statements, -1, -1) }
}
fn sem_unit_return(context: SemanticContext, type_id: int) -> bool {
    if type_id == context.unit_type { return true }
    return type_id >= 0 and sem_kind(context, type_id) == "result" and context.types[type_id].args[0] == context.unit_type
}
fn sem_require_tail(context: SemanticContext, source: int, target: int) {
    if sem_unit_return(context, target) {
        if sem_kind(context, target) == "result" {
            let mut error_type = -1
            if sem_kind(context, source) == "result" { error_type = context.types[source].args[1] }
            elif sem_kind(context, source) == "err" { error_type = context.types[source].args[0] }
            if error_type >= 0 and not sem_error_channel_assignable(context, error_type, context.types[target].args[1]) { sem_error(context, "W2004", "incompatible error channel") }
        }
    } else { sem_require(context, source, target, "W2004") }
}
fn sem_check_function(context: SemanticContext, function: SemFunction) {
    if function.body < 0 { return }
    let previous_capture = context.capture_nodes
    let previous_definition = context.checking_definition
    if len(function.type_params) > 0 { context.capture_nodes = false context.checking_definition = true }
    let previous_position = context.pos
    let scope = sem_enter_scope(context)
    let owner = context.owner
    let returned = context.return_type
    let previous_expected = context.expected_type
    let current_function = context.current_function
    let initial = context.initializing
    let initialized = context.initialized
    let previous_type_params = context.type_params
    let previous_constraints = context.active_constraints
    context.owner = function.owner
    context.current_function = function.name
    context.type_params = function.type_params
    context.active_constraints = function.constraints
    if len(context.owner) > 0 { context.owner = slice(context.owner, 0, len(context.owner) - 1) }
    context.pos = function.body
    let signature = context.types[function.type_id].args
    context.return_type = signature[len(signature) - 1]
    context.expected_type = context.return_type
    context.initializing = context.owner != "" and function.name == context.owner + ".init"
    let empty: list[str] = []
    context.initialized = empty
    let mut parameters: list[int] = []
    for i in 0..len(function.params) { parameters.append(sem_declare(context, function.params[i], signature[i], false)) }
    if context.owner != "" {
        let receiver = sem_declare(context, "self", sem_named(context, context.owner), false)
        let mut with_receiver: list[int] = [receiver]
        for parameter in parameters { with_receiver.append(parameter) }
        parameters = with_receiver
    }
    if context.initializing {
        if context.return_type != context.unit_type { sem_error(context, "W3004", "constructor must return unit") }
        let mut parent = ""
        for class_ in context.classes { if class_.name == context.owner { parent = class_.parent } }
        if parent != "" and sem_method(context, parent, "init") >= 0 {
            if context.tokens[context.pos + 1].kind != "SUPER" or context.tokens[context.pos + 2].kind != "DOT" or context.tokens[context.pos + 3].val != "init" { sem_error(context, "W3004", "super.init must be first") }
        }
    }
    let flow = sem_block(context, sem_unit_return(context, context.return_type))
    if not flow.terminates {
        sem_require_tail(context, flow.type_id, context.return_type)
        if sem_kind(context, context.return_type) == "result" and sem_unit_return(context, context.return_type) { sem_mark_unit_tail(context, flow.node) }
    }
    sem_complete_constructor(context)
    if context.capture_nodes {
        let type_id = if context.owner == "" { function.type_id } else { checked_receiver_signature(context, sem_named(context, context.owner), function.type_id) }
        let captures: list[int] = []
        context.checked_functions.append(CheckedFunction { captures: captures, closure: false, name: function.name, type_id: type_id, params: parameters, body: flow.node, source: context.tokens[function.body] })
    }
    context.pos = previous_position
    sem_leave_scope(context, scope)
    context.owner = owner
    context.return_type = returned
    context.expected_type = previous_expected
    context.current_function = current_function
    context.initializing = initial
    context.initialized = initialized
    context.type_params = previous_type_params
    context.active_constraints = previous_constraints
    context.capture_nodes = previous_capture
    context.checking_definition = previous_definition
}
fn sem_check_generic_constraints(context: SemanticContext, function_index: int, args: list[int], file: str, line: int, col: int) {
    let unification = new SemUnification()
    let function = context.functions[function_index]
    let signature = context.types[function.type_id]
    let empty_names: list[str] = []
    let empty_types: list[int] = []
    unification.names = empty_names
    unification.types = empty_types
    for i in 0..len(args) { sem_unify_type(context, unification, signature.args[i], args[i]) }
    if function.name == context.current_function {
        for parameter in function.type_params {
            for i in 0..len(unification.names) {
                if unification.names[i] == parameter and sem_kind(context, unification.types[i]) != "typeparam" and sem_contains_type_parameter(context, unification.types[i], parameter) {
                    report_error_at_location("W2011", file, line, col, "structural generic expansion cycle detected: " + function.name)
                }
            }
        }
    }
    for i in 0..len(function.type_params) {
        let constraint = function.constraints[i]
        if constraint != "" {
            let mut concrete = -1
            for j in 0..len(unification.names) { if unification.names[j] == function.type_params[i] { concrete = unification.types[j] } }
            if concrete < 0 or not sem_assignable(context, concrete, sem_named(context, constraint)) { report_error_at_location("W2001", file, line, col, "generic constraint not satisfied: " + constraint) }
        }
    }
}
fn sem_contains_type_parameter(context: SemanticContext, type_id: int, name: str) -> bool {
    let type_ = context.types[type_id]
    if type_.kind == "typeparam" { return type_.name == name }
    for argument in type_.args { if sem_contains_type_parameter(context, argument, name) { return true } }
    return false
}
fn sem_struct_reaches(context: SemanticContext, current: str, target: str) -> bool {
    if current == target { return true }
    for seen in context.layout_seen { if seen == current { return false } }
    context.layout_seen.append(current)
    for field in context.fields {
        if field.owner == current and sem_kind(context, field.type_id) == "struct" {
            if sem_struct_reaches(context, context.types[field.type_id].name, target) { return true }
        }
    }
    return false
}
fn sem_validate_layout_cycles(context: SemanticContext) {
    for field in context.fields {
        let empty_seen: list[str] = []
        context.layout_seen = empty_seen
        if sem_kind(context, field.type_id) == "struct" and sem_struct_reaches(context, context.types[field.type_id].name, field.owner) {
            sem_error(context, "W2011", "recursive inline struct layout detected: " + field.owner + " -> " + context.types[field.type_id].name)
        }
    }
}
fn sem_initialize(context: SemanticContext, tokens: list[Token]) {
    context.tokens = tokens
    context.integer_type = sem_simple(context, "int")
    context.float_type = sem_simple(context, "float")
    context.boolean_type = sem_simple(context, "bool")
    context.string_type = sem_simple(context, "str")
    context.unit_type = sem_simple(context, "unit")
    context.none_type = sem_simple(context, "none")
    sem_simple(context, "empty")
    context.return_type = context.unit_type
    let empty: list[int] = []
    sem_intern(context, "struct", "IoError", empty)
    sem_intern(context, "struct", "NetError", empty)
    sem_intern(context, "opaque", "opaque", empty)
    context.fields.append(SemField { owner: "IoError", name: "message", type_id: context.string_type, visible: true })
    context.fields.append(SemField { owner: "NetError", name: "message", type_id: context.string_type, visible: true })
    for i in 0..len(tokens) - 1 {
        let kind = tokens[i].kind
        if kind == "STRUCT" or kind == "CLASS" or kind == "INTERFACE" or kind == "ENUM" {
            let name = tokens[i + 1].val
            let mut tag = "struct"
            if kind == "CLASS" { tag = "class" }
            if kind == "INTERFACE" { tag = "interface" }
            if kind == "ENUM" { tag = "enum" }
            for type_ in context.types { if type_.name == name { report_error_at("W1002", tokens[i + 1], "duplicate type") } }
            sem_intern(context, tag, name, empty)
            if tokens[i + 2].kind == "LBRACKET" {
                let mut params: list[str] = []
                let mut position = i + 3
                while position < len(tokens) and tokens[position].kind != "RBRACKET" {
                    let parameter = tokens[position]
                    if parameter.kind != "IDENT" { report_error_at("W0006", parameter, "expected generic type parameter") }
                    params.append(parameter.val)
                    position = position + 1
                    if position < len(tokens) and tokens[position].kind == "COLON" {
                        position = position + 1
                        if position >= len(tokens) or tokens[position].kind != "IDENT" { report_error_at("W0006", tokens[position - 1], "expected generic constraint") }
                        position = position + 1
                    }
                    if position < len(tokens) and tokens[position].kind == "COMMA" { position = position + 1 }
                    elif position < len(tokens) and tokens[position].kind != "RBRACKET" { report_error_at("W0006", tokens[position], "expected ',' in generic parameters") }
                }
                if len(params) == 0 { report_error_at("W2001", tokens[i + 2], "generic declaration requires a type parameter") }
                context.generic_types.append(SemGenericType { name: name, kind: tag, params: params })
            }
        }
    }
}
fn sem_validate(context: SemanticContext, tokens: list[Token]) {
    let mut surrounded: list[Token] = [Token { kind: "LBRACE", val: "{", line: 1, col: 1, file: tokens[0].file }]
    for token in tokens {
        if token.kind != "EOF" { surrounded.append(token) }
    }
    surrounded.append(Token { kind: "RBRACE", val: "}", line: 1, col: 1, file: tokens[len(tokens) - 1].file })
    surrounded.append(Token { kind: "EOF", val: "", line: 1, col: 1, file: tokens[len(tokens) - 1].file })
    sem_initialize(context, surrounded)
    context.pos = 1
    while true {
        sem_skip_separators(context)
        if sem_is(context, "EOF") { break }
        sem_match(context, "PUB")
        if sem_match(context, "EXTERN") {
            if sem_expect(context, "STR").val != "C" { sem_error(context, "W2013", "only C ABI is supported") }
            sem_collect_function(context, "", true)
            let signature = context.types[context.functions[len(context.functions) - 1].type_id].args
            for i in 0..len(signature) {
                let kind = sem_kind(context, signature[i])
                if kind != "int" and kind != "float" and kind != "bool" and kind != "opaque" and not (i == len(signature) - 1 and kind == "unit") { sem_error(context, "W2001", "FFI accepts only scalars and opaque handles") }
            }
        }
        elif sem_is(context, "FN") and context.tokens[context.pos + 1].kind == "IDENT" { sem_collect_function(context, "", true) }
        elif sem_is(context, "STRUCT") { sem_collect_record(context, "struct") }
        elif sem_is(context, "CLASS") { sem_collect_record(context, "class") }
        elif sem_is(context, "INTERFACE") { sem_collect_record(context, "interface") }
        elif sem_is(context, "ENUM") { sem_collect_record(context, "enum") }
        else { sem_take(context) }
    }
    sem_validate_inheritance(context)
    sem_validate_layout_cycles(context)
    context.pos = 1
    while true {
        sem_skip_separators(context)
        if sem_is(context, "RBRACE") or sem_is(context, "EOF") { break }
        sem_match(context, "PUB")
        let mut declaration = false
        for function in context.functions {
            if function.body >= 0 and context.pos < function.body and sem_is(context, "FN") and context.tokens[context.pos + 1].val == function.name {
                sem_check_function(context, function)
                context.pos = function.end
                declaration = true
                break
            }
        }
        if not declaration {
            if sem_match(context, "EXTERN") {
                sem_expect(context, "STR")
                sem_expect(context, "FN")
                let name = sem_expect(context, "IDENT").val
                let index = sem_function(context, name)
                context.pos = context.functions[index].end
            }
            elif sem_is(context, "STRUCT") or sem_is(context, "CLASS") or sem_is(context, "INTERFACE") or sem_is(context, "ENUM") {
                sem_take(context)
                while not sem_is(context, "LBRACE") and not sem_is(context, "EOF") { sem_take(context) }
                sem_skip_block(context)
            } elif sem_is(context, "LET") { context.top_nodes.append(sem_let(context)) }
            elif sem_is(context, "FOR") or sem_is(context, "WHILE") {
                let beginning = context.pos
                while not sem_is(context, "LBRACE") and not sem_is(context, "EOF") { sem_take(context) }
                let end = sem_skip_block(context)
                let saved_tokens = context.tokens
                let mut block: list[Token] = [Token { kind: "LBRACE", val: "{", line: context.tokens[beginning].line, col: 1, file: context.tokens[beginning].file }]
                for i in beginning..end { block.append(context.tokens[i]) }
                block.append(Token { kind: "RBRACE", val: "}", line: 1, col: 1, file: context.tokens[end - 1].file })
                block.append(Token { kind: "EOF", val: "", line: 1, col: 1, file: context.tokens[end - 1].file })

                context.tokens = block
                context.pos = 0
                let flow = sem_block(context, true)
                context.top_nodes.append(flow.node)
                context.tokens = saved_tokens

                context.pos = end
            }
            elif sem_is(context, "IMPORT") {
                # Checked-module identity and dependency linking remain an explicit capability boundary.
                sem_take(context)
                sem_expect(context, "STR")
            } else { context.statement_context = true context.top_nodes.append(sem_expression(context, 0, true).node) }
        }
    }
    for function in context.functions {
        if function.owner != "" { sem_check_function(context, function) }
    }
}

fn sem_lambda(context: SemanticContext) -> SemValue {
    let token = sem_expect(context, "PIPE")
    let expected = context.expected_type
    let scope = sem_enter_scope(context)
    let previous_return = context.return_type
    let previous_loop = context.loop
    let previous_captures = context.capture_names
    let previous_capture_depth = context.capture_depth
    context.capture_depth = context.depth
    let empty_names: list[str] = []
    context.capture_names = empty_names
    let mut params: list[str] = []
    let mut parameter_bindings: list[int] = []
    let mut body = -1
    let mut types: list[int] = []
    while not sem_is(context, "PIPE") {
        let name = sem_expect(context, "IDENT").val
        let mut type_id = -1
        if sem_match(context, "COLON") { type_id = sem_type(context) }
        elif expected >= 0 and sem_kind(context, expected) == "function" and len(params) + 1 < len(context.types[expected].args) { type_id = context.types[expected].args[len(params)] }
        else { sem_error(context, "W2001", "lambda parameter needs type context") }
        params.append(name)
        types.append(type_id)
        parameter_bindings.append(sem_declare(context, name, type_id, false))
        if not sem_match(context, "COMMA") { break }
    }
    sem_expect(context, "PIPE")
    let mut returned = -1
    if sem_match(context, "ARROW") { returned = sem_type(context) }
    elif expected >= 0 and sem_kind(context, expected) == "function" { returned = context.types[expected].args[len(context.types[expected].args) - 1] }
    context.return_type = returned
    context.expected_type = returned
    context.loop = 0
    if sem_match(context, "FAT_ARROW") {
        context.expected_type = returned
        context.statement_context = sem_unit_return(context, returned)
        let expression = sem_expression(context, 0, true)
        let actual = expression.type_id
        body = sem_node(context, "block", actual, token, "", [expression.node], -1, -1)
        if returned < 0 { returned = actual } else { sem_require_tail(context, actual, returned) }
    } else {
        let flow = sem_block(context, sem_unit_return(context, context.return_type))
        body = flow.node
        if returned < 0 { returned = if context.return_type >= 0 { context.return_type } else { flow.type_id } }
        if not flow.terminates { sem_require_tail(context, flow.type_id, returned) }
    }
    types.append(returned)
    let signature = sem_intern(context, "function", "", types)
    if expected >= 0 { sem_require(context, signature, expected, "W2001") }
    let captures = context.capture_names
    sem_leave_scope(context, scope)
    context.return_type = previous_return
    context.loop = previous_loop
    context.expected_type = expected
    context.capture_names = previous_captures
    context.capture_depth = previous_capture_depth
    for name in captures {
        let variable = sem_lookup(context, name)
        if variable >= 0 and context.capture_depth >= 0 and context.variables[variable].depth < context.capture_depth and not module_contains(context.capture_names, name) { context.capture_names.append(name) }
    }
    if context.capture_nodes {
        let mut capture_bindings: list[int] = []
        for name in captures {
            let variable = sem_lookup(context, name)
            if variable < 0 { report_error_at("W9999", token, "checked closure capture is unavailable") }
            capture_bindings.append(context.variables[variable].binding)
        }
        let id = len(context.checked_functions)
        context.checked_functions.append(CheckedFunction { captures: capture_bindings, closure: true, name: "closure_" + str(id), type_id: signature, params: parameter_bindings, body: body, source: token })
        return sem_expr(context, "closure", sem_value(signature), token, "", [], -1, id)
    }
    return sem_value(signature)
}

fn sem_tail_expression(context: SemanticContext) -> bool {
    let mut position = context.pos
    let mut depth = 0
    while position < len(context.tokens) {
        let kind = context.tokens[position].kind
        if kind == "LBRACE" { depth = depth + 1 }
        elif kind == "RBRACE" {
            if depth == 0 { return true }
            depth = depth - 1
            if depth == 0 {
                let next = context.tokens[position + 1].kind
                if next != "ELSE" and next != "ELIF" { return next == "RBRACE" }
            }
        }
        if depth == 0 and (kind == "LET" or kind == "RETURN") and position > context.pos { return false }
        position = position + 1
    }
    return false
}
fn sem_compatible_override(context: SemanticContext, actual: int, expected: int) -> bool {
    let a = context.types[actual].args
    let b = context.types[expected].args
    if len(a) != len(b) { return false }
    for i in 0..len(a) - 1 { if a[i] != b[i] { return false } }
    return sem_assignable(context, a[len(a) - 1], b[len(b) - 1])
}
fn sem_validate_inheritance(context: SemanticContext) {
    for class_ in context.classes {
        let mut current = class_.parent
        let mut visited: list[str] = [class_.name]
        while current != "" {
            if module_contains(visited, current) { sem_error(context, "W3003", "inheritance cycle") }
            visited.append(current)
            if sem_kind(context, sem_named(context, current)) != "class" { sem_error(context, "W3003", "base must be a class") }
            let mut next = ""
            for parent in context.classes { if parent.name == current { next = parent.parent } }
            current = next
        }
        for field in context.fields {
            if field.owner == class_.name and sem_field(context, class_.parent, field.name) >= 0 { sem_error(context, "W3003", "inherited field cannot be redeclared") }
        }
        for method in context.functions {
            if method.owner == class_.name + "." and method.name != class_.name + ".init" {
                let name = slice(method.name, len(method.owner), len(method.name))
                let inherited = sem_method(context, class_.parent, name)
                if inherited >= 0 {
                    let parent = context.functions[inherited]
                    if not parent.visible or not method.visible { sem_error(context, "W3002", "invalid override visibility") }
                    if not sem_compatible_override(context, method.type_id, parent.type_id) { sem_error(context, "W3003", "incompatible override") }
                }
            }
        }
        for interface_ in class_.interfaces {
            if sem_kind(context, sem_named(context, interface_)) != "interface" { sem_error(context, "W3003", "implements requires interface") }
            for requirement in context.functions {
                if requirement.owner == interface_ + "." {
                    let name = slice(requirement.name, len(requirement.owner), len(requirement.name))
                    let implementation = sem_method(context, class_.name, name)
                    if implementation < 0 { sem_error(context, "W3003", "missing interface method") }
                    let method = context.functions[implementation]
                    if not method.visible or not sem_compatible_override(context, method.type_id, requirement.type_id) { sem_error(context, "W3003", "incompatible interface implementation") }
                }
            }
        }
    }
}

# Parse irrefutable binding syntax before the iterable's type is available.
fn sem_for_pattern(context: SemanticContext, comma: bool) -> int {
    let source = sem_at(context)
    let mut children: list[int] = []
    let mut name = ""
    if sem_match(context, "LPAREN") {
        if not sem_is(context, "RPAREN") {
            children.append(sem_for_pattern(context, false))
            while sem_match(context, "COMMA") { if sem_is(context, "RPAREN") { break } children.append(sem_for_pattern(context, false)) }
        }
        sem_expect(context, "RPAREN")
        if len(children) == 1 { return children[0] }
        name = "tuple"
    } else { name = "for_binding:" + sem_expect(context, "IDENT").val }
    context.patterns.append(SemPattern { name: name, children: children, type_id: context.unit_type, binding: -1, source: source })
    let id = len(context.patterns) - 1
    if comma and sem_match(context, "COMMA") {
        let mut parts: list[int] = [id, sem_for_pattern(context, false)]
        while sem_match(context, "COMMA") { parts.append(sem_for_pattern(context, false)) }
        context.patterns.append(SemPattern { name: "tuple", children: parts, type_id: context.unit_type, binding: -1, source: source })
        return len(context.patterns) - 1
    }
    return id
}
fn sem_bind_for_pattern(context: SemanticContext, id: int, type_id: int) {
    context.patterns[id].type_id = type_id
    let pattern = context.patterns[id]
    if pattern.name == "tuple" {
        let type_ = context.types[type_id]
        if type_.kind != "tuple" or len(type_.args) != len(pattern.children) { report_error_at("W2001", pattern.source, "for destructuring requires matching tuple shape") }
        for i in 0..len(pattern.children) { sem_bind_for_pattern(context, pattern.children[i], type_.args[i]) }
    } else {
        context.patterns[id].name = "*"
        let name = slice(pattern.name, 12, len(pattern.name))
        if name != "_" { context.patterns[id].binding = sem_declare(context, name, type_id, false) }
    }
}
# Symbolic definition obligations are discharged by checking each concrete body.
fn sem_symbolic(context: SemanticContext, type_id: int) -> bool {
    let type_ = context.types[type_id]
    if type_.kind == "typeparam" or type_.kind == "dependent" { return true }
    for argument in type_.args { if sem_symbolic(context, argument) { return true } }
    return false
}
fn sem_defer(context: SemanticContext, kind: str, types: list[int]) -> bool {
    if not context.checking_definition { return false }
    let mut dependent = false
    for type_id in types { if sem_symbolic(context, type_id) { dependent = true } }
    if not dependent { return false }
    context.obligations.append(SemObligation { function: context.current_function, kind: kind, types: types, source: sem_at(context) })
    return true
}
fn sem_type_contains(context: SemanticContext, outer: int, inner: int) -> bool {
    if outer == inner { return true }
    for child in context.types[outer].args { if sem_type_contains(context, child, inner) { return true } }
    return false
}
fn sem_type_complexity(context: SemanticContext, id: int) -> int {
    let mut size = 1
    for child in context.types[id].args { size = size + sem_type_complexity(context, child) if size > 256 { return size } }
    return size
}
fn sem_specialize(context: SemanticContext, template_id: int, selected: int, actual: list[int], source: Token) -> int {
    let unification = new SemUnification()
    let template = context.functions[template_id]
    let declared = context.types[template.type_id].args
    let chosen = context.types[selected].args
    let names: list[str] = []
    let types: list[int] = []
    unification.names = names
    unification.types = types
    if selected != template.type_id { for i in 0..len(declared) { sem_unify_type(context, unification, declared[i], chosen[i]) } }
    for i in 0..len(actual) { sem_unify_type(context, unification, declared[i], actual[i]) }
    let mut arguments: list[int] = []
    for parameter in template.type_params {
        let mut type_id = -1
        for i in 0..len(unification.names) { if unification.names[i] == parameter { type_id = unification.types[i] } }
        if type_id < 0 or sem_symbolic(context, type_id) { report_error_at("W2001", source, "cannot infer generic type argument: " + parameter) }
        if sem_type_complexity(context, type_id) > 256 { report_error_at("W2011", source, "generic specialization complexity exceeded") }
        arguments.append(type_id)
    }
    for specialization in context.specializations { if specialization.template == template_id and specialization.arguments == arguments { return specialization.function } }
    # Compare all occurrences in the ancestry, including mutual recursion.
    for id in context.specialization_ancestry {
        let ancestor = context.specializations[id]
        if ancestor.template == template_id {
            let mut grows = false
            let mut contains = true
            for i in 0..len(arguments) {
                if not sem_type_contains(context, arguments[i], ancestor.arguments[i]) { contains = false }
                if arguments[i] != ancestor.arguments[i] { grows = true }
            }
            if grows and contains { report_error_at("W2011", source, "structural generic expansion cycle detected: " + template.name) }
        }
    }
    if len(context.specializations) >= 1024 or len(context.specialization_ancestry) >= 64 { report_error_at("W2011", source, "generic specialization budget exceeded") }
    let mut parts: list[int] = []
    for part in declared { parts.append(sem_substitute_type(context, part, template.type_params, arguments)) }
    let empty: list[str] = []
    let id = len(context.functions)
    let name = "__wysna_specialization_" + str(len(context.specializations))
    if sem_function(context, name) >= 0 { report_error_at("W1002", source, "reserved specialization identity collision") }
    context.functions.append(SemFunction { abi_params: template.abi_params, abi_return: template.abi_return, name: name, params: template.params, type_params: empty, constraints: empty, type_id: sem_intern(context, "function", "", parts), body: template.body, end: template.end, owner: template.owner, visible: false })
    let mut ancestry = context.specialization_ancestry
    ancestry.append(len(context.specializations))
    context.specializations.append(SemSpecialization { template: template_id, arguments: arguments, function: id, ancestry: ancestry })
    return id
}
fn sem_complete_specializations(context: SemanticContext) {
    let mut cursor = 0
    while cursor < len(context.specializations) {
        let item = context.specializations[cursor]
        let template = context.functions[item.template]
        context.substitution_names = template.type_params
        context.substitution_types = item.arguments
        context.specialization_ancestry = item.ancestry
        sem_check_function(context, context.functions[item.function])
        cursor = cursor + 1
    }
    let names: list[str] = []
    let types: list[int] = []
    context.substitution_names = names
    context.substitution_types = types
    context.specialization_ancestry = types
}
# Backend-independent typed CFG and ownership data.
struct MirLiteral { type_id: int, integer: int, floating: float, boolean: bool, text: str }
struct MirSlot { type_id: int, name: str, parameter: bool, origin: int, predicate: bool, counter: bool }
struct MirProjection { kind: str, index: int, owner_type: int, type_id: int, source: Token }
struct MirPlace { root: int, projections: list[MirProjection] }
struct MirOperation { owner_type: int, labels: list[str], place: MirPlace, opcode: str, result: int, args: list[int], name: str, value: MirLiteral, source: Token }
struct MirTerminator { kind: str, targets: list[int], value: int, source: Token }
struct MirBlock { operations: list[MirOperation], terminator: MirTerminator }
struct MirFunction { name: str, return_type: int, slots: list[MirSlot], blocks: list[MirBlock], params: list[int], source: Token }
struct MirExtern { name: str, native: str, params: list[int], return_type: int, abi_params: list[str], abi_return: str }
struct MirVirtualSlot { name: str, arity: int }
struct MirGlobal { symbol: int, type_id: int, name: str }
struct MirBinding { symbol: int, slot: int }
struct MirScope { slots: list[int] }
struct MirLoop { after: int, header: int, depth: int }
struct MirState { seen: bool, defined: list[bool], live: list[bool], facts: list[int] }
struct MirField { name: str, type_id: int, visible: bool }
struct MirVariant { name: str, payloads: list[int] }
struct MirMethod { name: str, type_id: int, target: str, owner: int, visible: bool }
struct MirRecord { type_id: int, fields: list[MirField], variants: list[MirVariant], parent: int, interfaces: list[int], methods: list[MirMethod] }
struct MirType { kind: str, name: str, args: list[int] }


fn mir_empty_labels() -> list[str] { let labels: list[str] = [] return labels }
fn mir_empty_place() -> MirPlace { let projections: list[MirProjection] = [] return MirPlace { root: -1, projections: projections } }

fn mir_literal_unit() -> MirLiteral { return MirLiteral { type_id: 1, integer: 0, floating: 0.0, boolean: false, text: "" } }
fn mir_literal_bool(value: bool) -> MirLiteral { return MirLiteral { type_id: 2, integer: 0, floating: 0.0, boolean: value, text: "" } }
fn mir_literal_int(value: int) -> MirLiteral { return MirLiteral { type_id: 3, integer: value, floating: 0.0, boolean: false, text: "" } }
fn mir_literal_float(value: float) -> MirLiteral { return MirLiteral { type_id: 4, integer: 0, floating: value, boolean: false, text: "" } }

fn mir_literal_str(value: str) -> MirLiteral {
    return MirLiteral { type_id: 5, integer: 0, floating: 0.0, boolean: false, text: value }
}

fn mir_value_storage(type_id: int) -> bool { return type_id == 1 or type_id >= 5 }

fn mir_unsupported(token: Token, feature: str) {
    report_error_at("W2013", token, "Compiler MIR native-core-v1 does not support " + feature)
}

fn mir_intern(context: MirBuilder, kind: str, name: str, args_: list[int]) -> int {
    for i in 0..len(context.types) { let type_ = context.types[i] if type_.kind == kind and type_.name == name and type_.args == args_ { return i } }
    context.types.append(MirType { kind: kind, name: name, args: args_ })
    return len(context.types) - 1
}
fn mir_type(context: MirBuilder, type_id: int, source: Token) -> int {
    let type_ = context.program.types[type_id]
    let names: list[str] = ["error", "unit", "bool", "int", "float", "str", "none"]
    for i in 0..len(names) { if type_.kind == names[i] { return i } }
    if type_.kind == "struct" or type_.kind == "enum" or type_.kind == "class" or type_.kind == "interface" {
        if not checked_type_concrete(context.program.types, context.program.templates, type_id) { mir_unsupported(source, "nominal values with unresolved type arguments; add an explicit type context") }
        let mut name = type_.name
        if len(type_.args) > 0 {
            name = "_WYSNA_G_" + str(len(type_.name)) + "_" + type_.name
            for child in type_.args { name = name + "__" + str(child) }
        }
        for i in 0..len(context.types) { if context.types[i].kind == type_.kind and context.types[i].name == name { return i } }
        let id = mir_intern(context, type_.kind, name, [])
        mir_complete_record(context, type_id, id)
        return id
    }
    if type_.kind == "ok" or type_.kind == "err" {
        let any = mir_intern(context, "any", "", [])
        let payload = mir_type(context, type_.args[0], source)
        return mir_intern(context, "result", "", if type_.kind == "ok" { [payload, any] } else { [any, payload] })
    }
    if type_.kind == "any" { return mir_intern(context, "any", "", []) }
    if type_.kind == "opaque" { return mir_intern(context, "opaque", "", []) }
    let supported: list[str] = ["result", "optional", "weak", "list", "dict", "tuple", "error_union", "function"]
    for kind in supported {
        if type_.kind == kind {
            let mut args_: list[int] = []
            for child in type_.args { args_.append(mir_type(context, child, source)) }
            if kind == "error_union" {
                let mut sorted: list[int] = []
                let mut previous = -1
                while len(sorted) < len(args_) {
                    let mut next = -1
                    for arg in args_ { if arg > previous and (next < 0 or arg < next) { next = arg } }
                    if next < 0 { report_error_at("W9999", source, "noncanonical checked error union") }
                    sorted.append(next) previous = next
                }
                args_ = sorted
            }
            return mir_intern(context, kind, "", args_)
        }
    }
    mir_unsupported(source, "type " + type_.kind)
    return 0
}
fn mir_valid_type(types: list[MirType], type_id: int) -> bool { return type_id > 0 and type_id < len(types) }
fn mir_is_result(types: list[MirType], type_id: int) -> bool { return mir_valid_type(types, type_id) and types[type_id].kind == "result" }
fn mir_is_optional(types: list[MirType], type_id: int) -> bool { return mir_valid_type(types, type_id) and types[type_id].kind == "optional" }

fn mir_consumes(operation: MirOperation) -> bool {
    return operation.opcode == "function" and len(operation.args) > 0 or operation.opcode == "store" or operation.opcode == "store_place" or operation.opcode == "global_store" or operation.opcode == "runtime" and (operation.name == "wysna_ok" or operation.name == "wysna_err" or operation.name == "wysna_enum_payload" or operation.name == "wysna_builtin_weak_owned")
}

fn mir_new_block(context: MirBuilder, source: Token) -> int {
    let operations: list[MirOperation] = []
    let targets: list[int] = []
    let terminator = MirTerminator { kind: "", targets: targets, value: -1, source: source }
    let id = len(context.blocks)
    context.blocks.append(MirBlock { operations: operations, terminator: terminator })
    return id
}

fn mir_push_scope(context: MirBuilder) {
    let slots: list[int] = []
    context.scopes.append(MirScope { slots: slots })
}

fn mir_begin(context: MirBuilder, source: Token, returned: int) {
    let slots: list[MirSlot] = []
    let blocks: list[MirBlock] = []
    let params: list[int] = []
    let bindings: list[MirBinding] = []
    let scopes: list[MirScope] = []
    let loops: list[MirLoop] = []
    context.slots = slots
    context.blocks = blocks
    context.params = params
    context.bindings = bindings
    context.scopes = scopes
    context.loops = loops
    context.return_type = returned
    mir_push_scope(context)
    context.current = mir_new_block(context, source)
}

fn mir_raw_slot(context: MirBuilder, type_id: int, name: str, parameter: bool) -> int {
    let id = len(context.slots)
    context.slots.append(MirSlot { type_id: type_id, name: name, parameter: parameter, origin: -1, predicate: false, counter: false })
    if parameter { context.params.append(id) }
    return id
}

fn mir_track(context: MirBuilder, id: int) {
    if mir_value_storage(context.slots[id].type_id) and not context.slots[id].parameter {
        context.scopes[len(context.scopes) - 1].slots.append(id)
    }
}

fn mir_slot(context: MirBuilder, type_id: int, name: str, parameter: bool) -> int {
    let id = mir_raw_slot(context, type_id, name, parameter)
    mir_track(context, id)
    return id
}

fn mir_append(context: MirBuilder, operation: MirOperation) {
    if context.current < 0 { report_error_at("W9999", operation.source, "MIR emission requires a live block") }
    context.blocks[context.current].operations.append(operation)
}

fn mir_op(context: MirBuilder, opcode: str, type_id: int, args_: list[int], name: str, value: MirLiteral, source: Token) -> int {
    let id = mir_slot(context, type_id, "", false)
    mir_append(context, MirOperation { owner_type: 0, labels: mir_empty_labels(), place: mir_empty_place(), opcode: opcode, result: id, args: args_, name: name, value: value, source: source })
    return id
}

fn mir_store(context: MirBuilder, destination: int, value: int, source: Token) {
    mir_append(context, MirOperation { owner_type: 0, labels: mir_empty_labels(), place: mir_empty_place(), opcode: "store", result: destination, args: [value], name: "", value: mir_literal_unit(), source: source })
}

fn mir_constant(context: MirBuilder, value: MirLiteral, type_id: int, source: Token) -> int {
    let empty: list[int] = []
    return mir_op(context, "const", type_id, empty, "", value, source)
}

fn mir_release(context: MirBuilder, id: int, source: Token) {
    if mir_value_storage(context.slots[id].type_id) and not context.slots[id].parameter {
        mir_append(context, MirOperation { owner_type: 0, labels: mir_empty_labels(), place: mir_empty_place(), opcode: "release", result: -1, args: [id], name: "", value: mir_literal_unit(), source: source })
    }
}

fn mir_cleanup(context: MirBuilder, depth: int, source: Token) {
    let mut scope = len(context.scopes) - 1
    while scope >= depth {
        let slots = context.scopes[scope].slots
        let mut index = len(slots) - 1
        while index >= 0 { mir_release(context, slots[index], source) index = index - 1 }
        scope = scope - 1
    }
}

fn mir_terminate(context: MirBuilder, kind: str, targets: list[int], value: int, source: Token) {
    if context.current < 0 { report_error_at("W9999", source, "MIR block already terminated") }
    context.blocks[context.current].terminator = MirTerminator { kind: kind, targets: targets, value: value, source: source }
    context.current = -1
}

fn mir_jump(context: MirBuilder, target: int, source: Token) { mir_terminate(context, "goto", [target], -1, source) }

fn mir_return(context: MirBuilder, value: int, source: Token) {
    if context.current < 0 { return }
    let checked = mir_coerce(context, value, context.return_type, true, source)
    let escaped = mir_raw_slot(context, context.return_type, "", false)
    mir_store(context, escaped, checked, source)
    mir_cleanup(context, 0, source)
    let targets: list[int] = []
    mir_terminate(context, "return", targets, escaped, source)
}

fn mir_finish(context: MirBuilder, name: str, source: Token) {
    let targets: list[int] = []
    for i in 0..len(context.blocks) {
        if context.blocks[i].terminator.kind == "" {
            context.blocks[i].terminator = MirTerminator { kind: "unreachable", targets: targets, value: -1, source: source }
        }
    }
    context.functions.append(MirFunction { name: name, return_type: context.return_type, slots: context.slots, blocks: context.blocks, params: context.params, source: source })
}

fn mir_integer(context: MirBuilder, text: str, negative: bool, source: Token) -> int {
    let mut start = 0
    while start + 1 < len(text) and text[start] == "0" { start = start + 1 }
    let digits = slice(text, start, len(text))
    let limit = if negative { "9223372036854775808" } else { "9223372036854775807" }
    let mut too_large = len(digits) > len(limit)
    if len(digits) == len(limit) {
        for i in 0..len(limit) {
            if ord(digits[i]) > ord(limit[i]) { too_large = true break }
            if ord(digits[i]) < ord(limit[i]) { break }
        }
    }
    if too_large { report_error_at("W0002", source, "integer literal is outside signed int64 range") }
    let number = int(if negative { "-" + digits } else { digits })
    return mir_constant(context, mir_literal_int(number), 3, source)
}

fn mir_quote(text: str) -> str {
    let hex = "0123456789abcdef"
    let mut quoted = "\""
    for i in 0..len(text) {
        let ch = text[i]
        let code = ord(ch)
        if ch == "\"" { quoted = quoted + "\\\"" }
        elif ch == "\\" { quoted = quoted + "\\\\" }
        elif code < 32 { quoted = quoted + "\\u00" + hex[code / 16] + hex[code % 16] }
        else { quoted = quoted + ch }
    }
    return quoted + "\""
}

fn mir_source_json(source: Token) -> str {
    return "{\"$type\":\"Source\",\"file\":" + mir_quote(source.file) + ",\"line\":" + str(source.line) + ",\"col\":" + str(source.col) + "}"
}

fn mir_ids(ids: list[int], tuple_: bool) -> str {
    let mut result = "["
    for i in 0..len(ids) { if i > 0 { result = result + "," } result = result + str(ids[i]) }
    result = result + "]"
    if tuple_ { return "{\"$tuple\":" + result + "}" }
    return result
}

fn mir_literal_json(value: MirLiteral) -> str {
    if value.type_id == 1 or value.type_id == 6 { return "null" }
    if value.type_id == 2 { return str(value.boolean) }
    if value.type_id == 3 { return str(value.integer) }
    if value.type_id == 5 { return mir_quote(value.text) }
    return str(value.floating)
}

fn mir_operation_json(operation: MirOperation) -> str {
    let mut data = "{}"
    let mut effect = "call"
    let mut result = str(operation.result)
    let mut moves: list[int] = []
    if operation.opcode == "default" { effect = "pure" data = "{\"value\":" + mir_literal_json(operation.value) + ",\"default\":true}" }
    elif operation.opcode == "function" {
        effect = "allocate"
        data = "{\"name\":" + mir_quote(operation.name) + ",\"arity\":" + str(operation.value.integer) + ",\"captured\":" + str(operation.value.boolean) + "}"
        if operation.value.boolean { moves = [0] }
    }
    elif operation.opcode == "virtual" { data = "{\"slot\":" + str(operation.value.integer) + "}" }
    elif operation.opcode == "set_vtable" { effect = "write" result = "null" data = "{\"class\":" + mir_quote(operation.name) + "}" }
    elif operation.opcode == "const" { effect = "pure" data = "{\"value\":" + mir_literal_json(operation.value) + "}" }
    elif operation.opcode == "clone" { effect = "retain" }
    elif operation.opcode == "narrow" { effect = "retain" data = "{\"witness\":" + str(operation.value.integer) + "}" }
    elif operation.opcode == "store" { effect = "move" moves = [0] }
    elif operation.opcode == "release" { effect = "release" result = "null" }
    elif operation.opcode == "test" {
        effect = "read" data = "{\"kind\":" + mir_quote(operation.name)
        if operation.name == "tuple" { data = data + ",\"length\":" + str(operation.value.integer) }
        elif operation.name == "variant" { data = data + ",\"enum\":" + mir_quote(operation.labels[0]) + ",\"variant\":" + mir_quote(operation.labels[1]) }
        elif operation.name == "error_type" { data = data + ",\"type_kind\":" + mir_quote(operation.labels[0]) + ",\"name\":" + mir_quote(operation.labels[1]) }
        data = data + "}"
    }
    elif operation.opcode == "construct" {
        effect = "allocate" data = "{\"kind\":" + mir_quote(operation.name)
        if operation.name == "struct" or operation.name == "object" { data = data + ",\"layout\":" + str(operation.value.integer) }
        data = data + "}"
    }
    elif operation.opcode == "load_field" { effect = "retain" data = "{\"index\":" + str(operation.value.integer) + ",\"layout\":" + str(operation.owner_type) + "}" }
    elif operation.opcode == "counter" or operation.opcode == "increment" { effect = "pure" }
    elif operation.opcode == "range_count" { effect = "check" data = "{\"inclusive\":" + str(operation.value.boolean) + "}" }
    elif operation.opcode == "iterate_test" or operation.opcode == "iterate_value" { effect = if operation.opcode == "iterate_test" { "read" } else { "retain" } data = "{\"range\":" + str(operation.value.boolean) + "}" }
    elif operation.opcode == "tuple_get" { effect = "retain" data = "{\"index\":" + str(operation.value.integer) + "}" }
    else {
        if mir_consumes(operation) { moves = [0] }
        data = "{\"name\":" + mir_quote(if operation.name == "wysna_make_range_inclusive" { "wysna_make_range" } else { operation.name })
        if operation.name == "wysna_enum" or operation.name == "wysna_enum_payload" {
            let labels = if len(operation.labels) == 2 { operation.labels } else { ["Option", "Some"] }
            data = data + ",\"enum\":" + mir_quote(labels[0]) + ",\"variant\":" + mir_quote(labels[1])
        }
        if operation.name == "wysna_enum_payload_owned" { data = data + ",\"variant\":" + mir_quote(operation.labels[1]) }
        if operation.name == "wysna_make_range" or operation.name == "wysna_make_range_inclusive" { data = data + ",\"inclusive\":" + str(operation.name == "wysna_make_range_inclusive") }
        if operation.name == "wysna_div_at" or operation.name == "wysna_mod_at" or operation.name == "wysna_index_get_owned_at" { data = data + ",\"source\":true" }
        data = data + "}"
    }
    if operation.opcode == "store_place" or operation.opcode == "mutate" {
        data = "{\"place\":" + mir_place_json(operation.place)
        if operation.opcode == "store_place" { effect = "write" result = "null" moves = [0] }
        else { effect = "write" data = data + ",\"method\":" + mir_quote(operation.name) }
        data = data + "}"
    }
    let mut opcode = if operation.opcode == "default" { "const" } else { operation.opcode }
    let mut args_ = operation.args
    if opcode == "global_load" { opcode = "clone" effect = "retain" args_ = [-operation.value.integer - 1] data = "{}" }
    elif opcode == "global_store" { opcode = "store" effect = "move" moves = [0] result = str(-operation.value.integer - 1) data = "{}" }
    return "{\"$type\":\"Operation\",\"opcode\":" + mir_quote(opcode) + ",\"result\":" + result + ",\"args\":" + mir_ids(args_, true) + ",\"data\":" + data + ",\"moves\":" + mir_ids(moves, true) + ",\"effect\":" + mir_quote(effect) + ",\"source\":" + mir_source_json(operation.source) + "}"
}

fn mir_function_json(function: MirFunction) -> str {
    let mut slots = "["
    for i in 0..len(function.slots) {
        if i > 0 { slots = slots + "," }
        let slot = function.slots[i]
        let mut storage = "value"
        if slot.type_id == 2 { storage = if slot.predicate { "predicate" } else { "boolean" } }
        elif slot.type_id == 3 { storage = if slot.counter { "counter" } else { "integer" } }
        elif slot.type_id == 4 { storage = "float" }
        let ownership = if slot.parameter { "borrowed" } else { "owned" }
        slots = slots + "{\"$type\":\"Slot\",\"id\":" + str(i) + ",\"type_id\":" + str(slot.type_id) + ",\"name\":" + mir_quote(slot.name) + ",\"storage\":" + mir_quote(storage) + ",\"ownership\":" + mir_quote(ownership) + ",\"parameter\":" + str(slot.parameter) + "}"
    }
    slots = slots + "]"
    let mut blocks = "["
    for i in 0..len(function.blocks) {
        if i > 0 { blocks = blocks + "," }
        let block = function.blocks[i]
        let mut operations = "["
        for j in 0..len(block.operations) {
            if j > 0 { operations = operations + "," }
            operations = operations + mir_operation_json(block.operations[j])
        }
        operations = operations + "]"
        let terminator = block.terminator
        let value = if terminator.value < 0 { "null" } else { str(terminator.value) }
        let term = "{\"$type\":\"Terminator\",\"kind\":" + mir_quote(terminator.kind) + ",\"targets\":" + mir_ids(terminator.targets, true) + ",\"value\":" + value + ",\"source\":" + mir_source_json(terminator.source) + "}"
        blocks = blocks + "{\"$type\":\"BasicBlock\",\"id\":" + str(i) + ",\"operations\":" + operations + ",\"terminator\":" + term + "}"
    }
    return "{\"$type\":\"Function\",\"name\":" + mir_quote(function.name) + ",\"return_type\":" + str(function.return_type) + ",\"slots\":" + slots + ",\"blocks\":" + blocks + "],\"params\":" + mir_ids(function.params, false) + ",\"source\":" + mir_source_json(function.source) + "}"
}

fn mir_arena_json(module: MirModule) -> str {
    let types = module.types
    let mut entries = "["
    let mut capabilities = "["
    for i in 0..len(types) {
        if i > 0 { entries = entries + "," capabilities = capabilities + "," }
        let type_ = types[i]
        let mut tag = type_.kind
        let mut data = "null"
        if (i > 0 and i < 7) or tag == "opaque" { tag = "primitive" data = mir_quote(type_.kind) }
        elif tag == "optional" or tag == "weak" or tag == "list" { data = str(type_.args[0]) }
        elif tag == "struct" or tag == "enum" or tag == "class" or tag == "interface" { data = mir_quote(type_.name) }
        elif tag == "function" {
            let mut params: list[int] = []
            for j in 0..len(type_.args) - 1 { params.append(type_.args[j]) }
            data = "[" + mir_ids(params, false) + "," + str(type_.args[len(type_.args) - 1]) + ",false]"
        }
        elif tag != "error" and tag != "any" { data = mir_ids(type_.args, false) }
        entries = entries + "{\"tag\":" + mir_quote(tag) + ",\"data\":" + data + "}"
        let retain = str(i == 5 or i >= 7)
        let key = str(i == 2 or i == 3 or i == 5 or tag == "enum")
        let comparable = str(tag != "result" and tag != "error_union" and tag != "function")
        let reference = str(mir_reference_type(types, i))
        let identity = str(mir_identity_type(types, i))
        let value = str(mir_value_type(types, i))
        capabilities = capabilities + "{\"needs_retain\":" + retain + ",\"needs_release\":" + retain + ",\"is_value\":" + value + ",\"is_reference\":" + reference + ",\"is_copyable\":true,\"has_identity\":" + identity + ",\"is_comparable\":" + comparable + ",\"is_valid_dict_key\":" + key + "}"
    }
    return "{\"version\":1,\"entries\":" + entries + "],\"capabilities\":" + capabilities + "],\"structs\":" + mir_nominal_definitions(module, "struct") + ",\"enums\":" + mir_nominal_definitions(module, "enum") + ",\"interfaces\":" + mir_nominal_definitions(module, "interface") + ",\"classes\":" + mir_nominal_definitions(module, "class") + "}"
}

struct MirModule { file: str, functions: list[MirFunction], globals: list[MirGlobal], records: list[MirRecord], virtual_slots: list[MirVirtualSlot], externs: list[MirExtern], types: list[MirType], source: Token }
class MirBuilder {
    program: CheckedProgram
    types: list[MirType]
    functions: list[MirFunction]
    globals: list[MirGlobal]
    records: list[MirRecord]
    virtual_slots: list[MirVirtualSlot]
    externs: list[MirExtern]
    slots: list[MirSlot]
    blocks: list[MirBlock]
    params: list[int]
    bindings: list[MirBinding]
    scopes: list[MirScope]
    loops: list[MirLoop]
    current: int
    return_type: int
    fn init(program: CheckedProgram) {
        this.program = program
        let empty_type_args: list[int] = []
        let mut initial_types: list[MirType] = []
        let primitive_names: list[str] = ["error", "unit", "bool", "int", "float", "str", "none"]
        for name in primitive_names { initial_types.append(MirType { kind: name, name: "", args: empty_type_args }) }
        this.types = initial_types
        let initial_functions: list[MirFunction] = []
        this.functions = initial_functions
        let initial_globals: list[MirGlobal] = []
        this.globals = initial_globals
        let initial_records: list[MirRecord] = []
        this.records = initial_records
        let initial_virtual_slots: list[MirVirtualSlot] = []
        this.virtual_slots = initial_virtual_slots
        let initial_externs: list[MirExtern] = []
        this.externs = initial_externs
        let initial_slots: list[MirSlot] = []
        this.slots = initial_slots
        let initial_blocks: list[MirBlock] = []
        this.blocks = initial_blocks
        let initial_params: list[int] = []
        this.params = initial_params
        let initial_bindings: list[MirBinding] = []
        this.bindings = initial_bindings
        let initial_scopes: list[MirScope] = []
        this.scopes = initial_scopes
        let initial_loops: list[MirLoop] = []
        this.loops = initial_loops
        this.current = -1
        this.return_type = 1
    }
}


fn mir_compatible(types: list[MirType], records: list[MirRecord], source: int, target: int) -> bool {
    if source == target { return true }
    let s = types[source]
    let t = types[target]
    if s.kind == "any" { return true }
    if s.kind == "class" and (t.kind == "class" or t.kind == "interface") {
        let mut current = source
        let mut visits = 0
        while current >= 0 and visits <= len(records) {
            if current == target { return true }
            let mut next = -1
            for record in records { if record.type_id == current { next = record.parent for interface_ in record.interfaces { if interface_ == target { return true } } } }
            current = next visits = visits + 1
        }
        return false
    }
    if t.kind == "error_union" {
        let alternatives = if s.kind == "error_union" { s.args } else { [source] }
        for alternative in alternatives {
            let mut found = false
            for member in t.args { if member == alternative { found = true } }
            if not found { return false }
        }
        return true
    }
    if s.kind == "result" and t.kind == "result" { return s.args[0] == t.args[0] and mir_error_compatible(types, s.args[1], t.args[1]) }
    if t.kind == "optional" {
        if source == 6 { return true }
        if s.kind == "optional" {
            if (types[s.args[0]].kind == "optional") != (types[t.args[0]].kind == "optional") { return false }
            return mir_compatible(types, records, s.args[0], t.args[0])
        }
        return mir_compatible(types, records, source, t.args[0])
    }
    return false
}

fn mir_error_compatible(types: list[MirType], source: int, target: int) -> bool {
    let sources = if types[source].kind == "error_union" { types[source].args } else { [source] }
    let targets = if types[target].kind == "error_union" { types[target].args } else { [target] }
    for id in sources { let mut found = false for other in targets { if id == other { found = true } } if not found { return false } }
    return true
}

fn mir_reference_type(types: list[MirType], id: int) -> bool {
    let type_ = types[id]
    if type_.kind == "optional" { return mir_reference_type(types, type_.args[0]) }
    return type_.kind == "class" or type_.kind == "interface" or type_.kind == "any"
}
fn mir_identity_type(types: list[MirType], id: int) -> bool {
    let type_ = types[id]
    if type_.kind == "optional" { return mir_identity_type(types, type_.args[0]) }
    return type_.kind == "class" or type_.kind == "interface" or type_.kind == "weak"
}
fn mir_value_type(types: list[MirType], id: int) -> bool {
    let type_ = types[id]
    if type_.kind == "optional" { return mir_value_type(types, type_.args[0]) }
    return type_.kind != "class" and type_.kind != "interface"
}
# Result channels use explicit branches; payload helpers borrow and return owned values.
fn mir_pack(context: MirBuilder, value: int, type_id: int, error: bool, source: Token) -> int {
    return mir_op(context, "runtime", type_id, [value], if error { "wysna_err" } else { "wysna_ok" }, mir_literal_unit(), source)
}

fn mir_error_test(context: MirBuilder, value: int, source: Token) -> int {
    let predicate = mir_op(context, "test", 2, [value], if mir_is_optional(context.types, context.slots[value].type_id) { "none" } else { "err" }, mir_literal_unit(), source)
    context.slots[predicate].predicate = true
    return predicate
}

fn mir_coerce(context: MirBuilder, value: int, target: int, discard: bool, source: Token) -> int {
    let actual = context.slots[value].type_id
    if actual == target { return value }
    if mir_is_result(context.types, actual) and mir_is_result(context.types, target) {
        if not mir_compatible(context.types, context.records, actual, target) and actual != context.types[target].args[0] { return mir_retype_result(context, value, target, discard, source) }
    }
    if mir_is_optional(context.types, target) {
        if actual == 6 { return mir_constant(context, MirLiteral { type_id: 6, integer: 0, floating: 0.0, boolean: false, text: "" }, target, source) }
        if mir_is_optional(context.types, actual) and not mir_compatible(context.types, context.records, actual, target) {
            return mir_retype_optional(context, value, target, source)
        }
        if actual == context.types[target].args[0] { return mir_op(context, "runtime", target, [value], "wysna_enum_payload", mir_literal_unit(), source) }
    }
    if mir_compatible(context.types, context.records, actual, target) { return mir_op(context, "clone", target, [value], "", mir_literal_unit(), source) }
    if mir_is_result(context.types, target) {
        let ok = context.types[target].args[0]
        if actual == ok { return mir_pack(context, value, target, false, source) }
        if discard and ok == 1 {
            if mir_is_result(context.types, actual) {
                let result = mir_slot(context, target, "", false)
                let condition = mir_error_test(context, value, source)
                let failed = mir_new_block(context, source)
                let succeeded = mir_new_block(context, source)
                let join = mir_new_block(context, source)
                mir_terminate(context, "branch", [failed, succeeded], condition, source)
                context.current = failed
                let error = mir_op(context, "runtime", context.types[actual].args[1], [value], "wysna_unwrap_err", mir_literal_unit(), source)
                let wrapped = mir_pack(context, error, target, true, source)
                mir_store(context, result, wrapped, source)
                mir_jump(context, join, source)
                context.current = succeeded
                let unit = mir_constant(context, mir_literal_unit(), 1, source)
                let success = mir_pack(context, unit, target, false, source)
                mir_store(context, result, success, source)
                mir_jump(context, join, source)
                context.current = join
                return result
            }
            let unit = mir_constant(context, mir_literal_unit(), 1, source)
            return mir_pack(context, unit, target, false, source)
        }
    }
    report_error_at("W9999", source, "unsupported checked MIR coercion")
    return -1
}

fn mir_channel(context: MirBuilder, value: int, source: Token, propagate: bool, error_binding: int, handler: int) -> int {
    let channel = context.slots[value].type_id
    if mir_is_optional(context.types, channel) { return mir_optional_channel(context, value, source, propagate, handler) }
    if not mir_is_result(context.types, channel) { mir_unsupported(source, "non-result channels") }
    let ok = context.types[channel].args[0]
    let result = mir_slot(context, ok, "", false)
    let condition = mir_error_test(context, value, source)
    let failed = mir_new_block(context, source)
    let succeeded = mir_new_block(context, source)
    let join = mir_new_block(context, source)
    mir_terminate(context, "branch", [failed, succeeded], condition, source)
    context.current = failed
    if propagate {
        if not mir_is_result(context.types, context.return_type) { report_error_at("W9999", source, "propagation requires a checked result return") }
        let error = mir_op(context, "runtime", context.types[channel].args[1], [value], "wysna_unwrap_err", mir_literal_unit(), source)
        let returned = mir_pack(context, error, context.return_type, true, source)
        mir_return(context, returned, source)
    } else {
        let bindings = context.bindings
        mir_push_scope(context)
        if error_binding >= 0 {
            let error = mir_op(context, "runtime", context.types[channel].args[1], [value], "wysna_unwrap_err", mir_literal_unit(), source)
            context.bindings.append(MirBinding { symbol: error_binding, slot: error })
        }
        let fallback = mir_block(context, handler)
        if context.current >= 0 {
            let checked = mir_coerce(context, fallback, ok, false, source)
            mir_store(context, result, checked, source)
            mir_cleanup(context, len(context.scopes) - 1, source)
            mir_jump(context, join, source)
        }
        context.scopes.pop()
        context.bindings = bindings
    }
    context.current = succeeded
    let unwrapped = mir_op(context, "runtime", ok, [value], "wysna_unwrap_ok", mir_literal_unit(), source)
    mir_store(context, result, unwrapped, source)
    mir_jump(context, join, source)
    context.current = join
    return result
}


fn mir_optional_channel(context: MirBuilder, value: int, source: Token, propagate: bool, handler: int) -> int {
    let channel = context.slots[value].type_id
    if not mir_is_optional(context.types, channel) { report_error_at("W9999", source, "optional channel requires optional storage") }
    let ok = context.types[channel].args[0]
    let result = mir_slot(context, ok, "", false)
    let condition = mir_error_test(context, value, source)
    let failed = mir_new_block(context, source)
    let succeeded = mir_new_block(context, source)
    let join = mir_new_block(context, source)
    mir_terminate(context, "branch", [failed, succeeded], condition, source)
    context.current = failed
    if propagate {
        if not mir_is_optional(context.types, context.return_type) { report_error_at("W9999", source, "optional propagation requires optional return") }
        let absent = mir_constant(context, MirLiteral { type_id: 6, integer: 0, floating: 0.0, boolean: false, text: "" }, context.return_type, source)
        mir_return(context, absent, source)
    } else {
        let fallback = mir_expression(context, handler)
        if context.current >= 0 {
            mir_store(context, result, mir_coerce(context, fallback, ok, false, source), source)
            mir_jump(context, join, source)
        }
    }
    context.current = succeeded
    let unwrapped = mir_op(context, "runtime", ok, [value], "wysna_unwrap_optional", mir_literal_unit(), source)
    mir_store(context, result, unwrapped, source)
    mir_jump(context, join, source)
    context.current = join
    return result
}

# Reconstruct channels when contextual typing resolves a constructor placeholder.
fn mir_retype_result(context: MirBuilder, value: int, target: int, discard: bool, source: Token) -> int {
    let actual = context.types[context.slots[value].type_id]
    let expected = context.types[target]
    let result = mir_slot(context, target, "", false)
    let condition = mir_error_test(context, value, source)
    let failed = mir_new_block(context, source)
    let succeeded = mir_new_block(context, source)
    let join = mir_new_block(context, source)
    mir_terminate(context, "branch", [failed, succeeded], condition, source)
    context.current = failed
    let error = mir_op(context, "runtime", actual.args[1], [value], "wysna_unwrap_err", mir_literal_unit(), source)
    let error_value = mir_coerce(context, error, expected.args[1], false, source)
    mir_store(context, result, mir_pack(context, error_value, target, true, source), source)
    mir_jump(context, join, source)
    context.current = succeeded
    let payload = mir_op(context, "runtime", actual.args[0], [value], "wysna_unwrap_ok", mir_literal_unit(), source)
    let success = if discard and expected.args[0] == 1 { mir_constant(context, mir_literal_unit(), 1, source) } else { mir_coerce(context, payload, expected.args[0], false, source) }
    mir_store(context, result, mir_pack(context, success, target, false, source), source)
    mir_jump(context, join, source)
    context.current = join
    return result
}

fn mir_retype_optional(context: MirBuilder, value: int, target: int, source: Token) -> int {
    let actual = context.types[context.slots[value].type_id]
    let result = mir_slot(context, target, "", false)
    let condition = mir_error_test(context, value, source)
    let absent = mir_new_block(context, source)
    let present = mir_new_block(context, source)
    let join = mir_new_block(context, source)
    mir_terminate(context, "branch", [absent, present], condition, source)
    context.current = absent
    let absent_value = mir_constant(context, MirLiteral { type_id: 6, integer: 0, floating: 0.0, boolean: false, text: "" }, target, source)
    mir_store(context, result, absent_value, source)
    mir_jump(context, join, source)
    context.current = present
    let payload = mir_op(context, "runtime", actual.args[0], [value], "wysna_unwrap_optional", mir_literal_unit(), source)
    let checked = mir_coerce(context, payload, context.types[target].args[0], false, source)
    let wrapped = mir_op(context, "runtime", target, [checked], "wysna_enum_payload", mir_literal_unit(), source)
    mir_store(context, result, wrapped, source)
    mir_jump(context, join, source)
    context.current = join
    return result
}
# Collection lowering preserves operand snapshots and borrowed constructor inputs.
fn mir_collection(context: MirBuilder, node: CheckedNode) -> int {
    let returned = mir_type(context, node.type_id, node.source)
    let type_ = context.types[returned]
    let mut args_: list[int] = []
    for i in 0..len(node.children) {
        let value = mir_expression(context, node.children[i])
        if context.current < 0 { return -1 }
        let mut target = type_.args[0]
        if node.kind == "tuple" { target = type_.args[i] }
        elif node.kind == "dict" { target = type_.args[i % 2] }
        args_.append(mir_coerce(context, value, target, false, node.source))
    }
    return mir_op(context, "construct", returned, args_, node.kind, mir_literal_unit(), node.source)
}
fn mir_collection_call(context: MirBuilder, node: CheckedNode) -> int {
    let source = node.source
    if node.text == "append" or node.text == "pop" or node.text == "clear" {
        let place = mir_place(context, node.children[0])
        let mut arguments: list[int] = []
        for i in 1..len(node.children) { arguments.append(mir_expression(context, node.children[i])) }
        if context.current < 0 { return -1 }
        let returned = mir_slot(context, mir_type(context, node.type_id, source), "", false)
        mir_append(context, MirOperation { owner_type: 0, labels: mir_empty_labels(), place: place, opcode: "mutate", result: returned, args: arguments, name: node.text, value: mir_literal_unit(), source: source })
        return returned
    }
    let receiver = mir_expression(context, node.children[0])
    let mut args_: list[int] = [receiver]
    for i in 1..len(node.children) { args_.append(mir_expression(context, node.children[i])) }
    if context.current < 0 { return -1 }
    if node.text == "get" or node.text == "keys" or node.text == "values" {
        return mir_op(context, "runtime", mir_type(context, node.type_id, source), args_, "wysna_dict_" + node.text, mir_literal_unit(), source)
    }
    mir_unsupported(source, "collection method " + node.text)
    return -1
}

fn mir_for(context: MirBuilder, node: CheckedNode) {
    let source = node.source
    let bindings = context.bindings
    mir_push_scope(context)
    let sequence = context.program.nodes[node.children[0]]
    let direct_range = sequence.kind == "binary" and (sequence.text == "DOT_DOT" or sequence.text == "DOT_DOT_EQ")
    let mut iterable = -1
    let mut bound = -1
    let mut element_type = 3
    if direct_range {
        iterable = mir_expression(context, sequence.children[0])
        let last = mir_expression(context, sequence.children[1])
        bound = mir_op(context, "range_count", 3, [iterable, last], "", mir_literal_bool(sequence.text == "DOT_DOT_EQ"), source)
        context.slots[bound].counter = true
    } else {
        iterable = mir_expression(context, node.children[0])
        element_type = context.types[context.slots[iterable].type_id].args[0]
        bound = iterable
    }
    if context.current < 0 { return }
    let counter = mir_op(context, "counter", 3, [], "", mir_literal_unit(), source)
    context.slots[counter].counter = true
    let header = mir_new_block(context, source)
    let body = mir_new_block(context, source)
    let increment = mir_new_block(context, source)
    let after = mir_new_block(context, source)
    mir_jump(context, header, source)
    context.current = header
    let condition = mir_op(context, "iterate_test", 2, [counter, bound], "", mir_literal_bool(direct_range), source)
    context.slots[condition].predicate = true
    mir_terminate(context, "branch", [body, after], condition, source)
    context.current = body
    let value = mir_op(context, "iterate_value", element_type, [iterable, counter], "", mir_literal_bool(direct_range), source)
    mir_bind_for_pattern(context, value, node.pattern)
    context.loops.append(MirLoop { after: after, header: increment, depth: len(context.scopes) })
    let tail = mir_block(context, node.children[1])
    if context.current >= 0 { mir_release(context, tail, source) mir_jump(context, increment, source) }
    context.loops.pop()
    context.current = increment
    mir_append(context, MirOperation { owner_type: 0, labels: mir_empty_labels(), place: mir_empty_place(), opcode: "increment", result: counter, args: [counter], name: "", value: mir_literal_unit(), source: source })
    mir_release(context, value, source)
    mir_jump(context, header, source)
    context.current = after
    mir_cleanup(context, len(context.scopes) - 1, source)
    context.scopes.pop()
    context.bindings = bindings
}

fn mir_bind_for_pattern(context: MirBuilder, value: int, id: int) {
    let pattern = context.program.patterns[id]
    if pattern.name == "tuple" {
        for i in 0..len(pattern.children) {
            let child = context.program.patterns[pattern.children[i]]
            let item = mir_op(context, "tuple_get", mir_type(context, child.type_id, child.source), [value], "", mir_literal_int(i), child.source)
            mir_bind_for_pattern(context, item, pattern.children[i])
        }
    } elif pattern.binding >= 0 { context.bindings.append(MirBinding { symbol: pattern.binding, slot: value }) }
}
# Address evaluation happens before the RHS; class projections protect identity.
fn mir_binding_place(context: MirBuilder, symbol: int, source: Token) -> MirPlace {
    let projections: list[MirProjection] = []
    for binding in context.bindings { if binding.symbol == symbol { return MirPlace { root: binding.slot, projections: projections } } }
    for i in 0..len(context.globals) { if context.globals[i].symbol == symbol { return MirPlace { root: -i - 1, projections: projections } } }
    report_error_at("W9999", source, "checked place has no storage")
    return mir_empty_place()
}
fn mir_place(context: MirBuilder, id: int) -> MirPlace {
    let node = context.program.nodes[id]
    if node.kind == "binding" { return mir_binding_place(context, node.binding, node.source) }
    if node.kind == "index" {
        let mut parent = mir_place(context, node.children[0])
        let index = mir_expression(context, node.children[1])
        let owner = mir_type(context, context.program.nodes[node.children[0]].type_id, node.source)
        parent.projections.append(MirProjection { kind: "index", index: index, owner_type: owner, type_id: mir_type(context, node.type_id, node.source), source: node.source })
        return parent
    }
    if node.kind == "member" {
        let receiver = node.children[0]
        let owner = mir_type(context, context.program.nodes[receiver].type_id, node.source)
        let mut parent = mir_empty_place()
        if context.types[owner].kind == "class" { parent = MirPlace { root: mir_expression(context, receiver), projections: parent.projections } }
        else { parent = mir_place(context, receiver) }
        let record = mir_find_record(context.records, owner, node.source)
        let index = mir_field_index(record, node.text, node.source)
        parent.projections.append(MirProjection { kind: "field", index: index, owner_type: owner, type_id: record.fields[index].type_id, source: node.source })
        return parent
    }
    mir_unsupported(node.source, "checked place " + node.kind)
    return mir_empty_place()
}
fn mir_read_place(context: MirBuilder, place: MirPlace, source: Token) -> int {
    let mut value = -1
    if place.root < 0 {
        let id = -place.root - 1
        value = mir_op(context, "global_load", context.globals[id].type_id, [], "", mir_literal_int(id), source)
    } else { value = mir_op(context, "clone", context.slots[place.root].type_id, [place.root], "", mir_literal_unit(), source) }
    for projection in place.projections {
        if projection.kind == "index" { value = mir_op(context, "runtime", projection.type_id, [value, projection.index], "wysna_index_get_owned_at", mir_literal_unit(), projection.source) }
        elif projection.kind == "field" { value = mir_load_field(context, value, projection.index, projection.type_id, projection.source) }
        else { report_error_at("W9999", source, "unknown checked place projection") }
    }
    return value
}
fn mir_place_json(place: MirPlace) -> str {
    let mut projections = "["
    for i in 0..len(place.projections) {
        if i > 0 { projections = projections + "," }
        let projection = place.projections[i]
        projections = projections + "{\"$type\":\"Projection\",\"kind\":" + mir_quote(projection.kind) + ",\"index\":" + str(projection.index) + ",\"owner_type\":" + str(projection.owner_type) + ",\"type_id\":" + str(projection.type_id) + ",\"source\":" + mir_source_json(projection.source) + "}"
    }
    return "{\"$type\":\"Place\",\"root\":" + str(place.root) + ",\"projections\":{\"$tuple\":" + projections + "]}}"
}
fn mir_place_type(module: MirModule, function: MirFunction, place: MirPlace, source: Token) -> int {
    let mut type_id = 0
    if place.root < 0 {
        let global = -place.root - 1
        if global >= len(module.globals) { report_error_at("W9999", source, "invalid MIR global place") }
        type_id = module.globals[global].type_id
    } else {
        if place.root >= len(function.slots) or function.slots[place.root].parameter { report_error_at("W9999", source, "invalid or borrowed MIR place") }
        type_id = function.slots[place.root].type_id
    }
    for projection in place.projections {
        if projection.owner_type != type_id { report_error_at("W9999", source, "MIR projection owner mismatch") }
        let owner = module.types[type_id]
        if projection.kind == "index" {
            let index = projection.index
            if index < 0 or index >= len(function.slots) { report_error_at("W9999", source, "invalid MIR index place") }
            let key = if owner.kind == "dict" { owner.args[0] } else { 3 }
            if owner.kind != "list" and owner.kind != "dict" { report_error_at("W9999", source, "invalid MIR index owner") }
            if function.slots[index].type_id != key { report_error_at("W9999", source, "invalid MIR index type") }
            type_id = owner.args[if owner.kind == "dict" { 1 } else { 0 }]
        } elif projection.kind == "field" {
            let record = mir_find_record(module.records, type_id, source)
            if projection.index < 0 or projection.index >= len(record.fields) { report_error_at("W9999", source, "invalid MIR field offset") }
            type_id = record.fields[projection.index].type_id
        } else { report_error_at("W9999", source, "invalid MIR projection kind") }
        if projection.type_id != type_id { report_error_at("W9999", source, "MIR projection result mismatch") }
    }
    return type_id
}
fn mir_c_place(module: MirModule, function: MirFunction, place: MirPlace) -> str {
    let mut reference = "&" + (if place.root < 0 { module.globals[-place.root - 1].name } else { mir_c_name(place.root) })
    for projection in place.projections {
        if projection.kind == "field" { reference = "wysna_field_ref_at(" + reference + ", " + str(projection.index) + ")" }
        else { reference = "wysna_index_ref_at(" + reference + ", " + mir_c_value(function, projection.index, false) + ", " + escape_c_str(projection.source.file) + ", " + str(projection.source.line) + ", " + str(projection.source.col) + ")" }
    }
    return reference
}
# Nominal metadata is resolved once at the checked boundary and copied into MIR.
fn mir_find_record(records: list[MirRecord], type_id: int, source: Token) -> MirRecord {
    for record in records { if record.type_id == type_id { return record } }
    report_error_at("W9999", source, "MIR nominal definition is missing")
    let fields: list[MirField] = []
    let variants: list[MirVariant] = []
    let methods: list[MirMethod] = []
    let interfaces: list[int] = []
    return MirRecord { type_id: -1, fields: fields, variants: variants, parent: -1, methods: methods, interfaces: interfaces }
}
fn mir_complete_record(context: MirBuilder, source_type: int, type_id: int) {
    let source = context.program.source
    let checked = checked_record(context.program, source_type)
    let mut fields: list[MirField] = []
    let mut variants: list[MirVariant] = []
    let mut methods: list[MirMethod] = []
    let mut interfaces: list[int] = []
    let index = len(context.records)
    context.records.append(MirRecord { type_id: type_id, fields: fields, variants: variants, parent: -1, interfaces: interfaces, methods: methods })
    for field in checked.fields { fields.append(MirField { name: field.name, type_id: mir_type(context, field.type_id, source), visible: field.visible }) }
    for variant in checked.variants {
        let mut payloads: list[int] = []
        for payload in variant.payloads { payloads.append(mir_type(context, payload, source)) }
        variants.append(MirVariant { name: variant.name, payloads: payloads })
    }
    context.records[index].fields = fields
    context.records[index].variants = variants
    for method in checked.methods {
        let owner = mir_type(context, method.owner, source)
        let type_ = mir_type(context, method.type_id, source)
        methods.append(MirMethod { name: method.name, type_id: type_, target: mir_abi_name(context.program.signatures[method.target].name), owner: owner, visible: method.visible })
    }
    for interface_ in checked.interfaces { interfaces.append(mir_type(context, interface_, source)) }
    context.records[index].methods = methods
    context.records[index].interfaces = interfaces
    if checked.parent >= 0 { context.records[index].parent = mir_type(context, checked.parent, source) }
}
fn mir_field_index(record: MirRecord, name: str, source: Token) -> int {
    for i in 0..len(record.fields) { if record.fields[i].name == name { return i } }
    report_error_at("W9999", source, "checked nominal field is missing")
    return -1
}
fn mir_member(context: MirBuilder, node: CheckedNode) -> int {
    let value = mir_expression(context, node.children[0])
    if context.current < 0 { return -1 }
    let record = mir_find_record(context.records, context.slots[value].type_id, node.source)
    let index = mir_field_index(record, node.text, node.source)
    return mir_load_field(context, value, index, record.fields[index].type_id, node.source)
}
fn mir_nominal_expression(context: MirBuilder, node: CheckedNode) -> int {
    let source = node.source
    let returned = mir_type(context, node.type_id, source)
    let record = mir_find_record(context.records, returned, source)
    let mut evaluated: list[int] = []
    for child in node.children { evaluated.append(mir_expression(context, child)) }
    if context.current < 0 { return -1 }
    if node.kind == "struct" or node.kind == "struct_call" {
        let mut values: list[int] = []
        for i in 0..len(record.fields) {
            let field = record.fields[i]
            let mut index = i
            if node.kind == "struct" {
                index = -1
                for j in 0..len(node.labels) { if node.labels[j] == field.name { index = j } }
            }
            if index < 0 or index >= len(evaluated) { report_error_at("W9999", source, "checked struct initializer is incomplete") }
            values.append(mir_coerce(context, evaluated[index], field.type_id, false, source))
        }
        return mir_op(context, "construct", returned, values, "struct", mir_literal_int(returned), source)
    }
    if len(node.labels) != 2 { report_error_at("W9999", source, "checked enum constructor identity missing") }
    let name = context.types[returned].name
    let variant = node.labels[1]
    let mut types: list[int] = []
    let mut found = false
    for alternative in record.variants { if alternative.name == variant { types = alternative.payloads found = true } }
    if not found or len(types) != len(evaluated) { report_error_at("W9999", source, "checked enum payload shape mismatch") }
    let mut values: list[int] = []
    for i in 0..len(evaluated) { values.append(mir_coerce(context, evaluated[i], types[i], false, source)) }
    let mut arguments: list[int] = []
    if len(values) == 1 { arguments = values }
    elif len(values) > 1 {
        let tuple_type = mir_intern(context, "tuple", "", types)
        arguments = [mir_op(context, "construct", tuple_type, values, "tuple", mir_literal_unit(), source)]
    }
    let result = mir_op(context, "runtime", returned, arguments, if len(values) == 0 { "wysna_enum" } else { "wysna_enum_payload" }, mir_literal_unit(), source)
    let block = context.current
    let index = len(context.blocks[block].operations) - 1
    context.blocks[block].operations[index].labels = [name, variant]
    return result
}
fn mir_nominal_definitions(module: MirModule, kind: str) -> str {
    let mut out = "{"
    let mut count = 0
    for record in module.records {
        let type_ = module.types[record.type_id]
        if type_.kind == kind {
            if count > 0 { out = out + "," }
            count = count + 1
            out = out + mir_quote(type_.name) + ":{\"def_id\":" + str(record.type_id)
            if kind == "struct" {
                out = out + ",\"fields\":{"
                for i in 0..len(record.fields) { if i > 0 { out = out + "," } let field = record.fields[i] out = out + mir_quote(field.name) + ":" + str(field.type_id) }
                out = out + "}"
            } elif kind == "class" or kind == "interface" {
                out = out + mir_reference_definition_json(module, record, kind)
            } else {
                out = out + ",\"variants\":["
                for i in 0..len(record.variants) { if i > 0 { out = out + "," } out = out + mir_quote(record.variants[i].name) }
                out = out + "],\"variant_payloads\":{"
                for i in 0..len(record.variants) { if i > 0 { out = out + "," } let variant = record.variants[i] out = out + mir_quote(variant.name) + ":" + mir_ids(variant.payloads, false) }
                out = out + "},\"type_args\":[],\"template_name\":null"
            }
            out = out + "}"
        }
    }
    return out + "}"
}
fn mir_layouts_json(module: MirModule) -> str {
    let mut out = "{"
    let mut count = 0
    for record in module.records {
        let type_ = module.types[record.type_id]
        if type_.kind == "struct" or type_.kind == "class" {
            if count > 0 { out = out + "," }
            count = count + 1
            out = out + mir_quote(str(record.type_id)) + ":{\"$type\":\"Layout\",\"name\":" + mir_quote(type_.name) + ",\"kind\":" + mir_quote(type_.kind) + ",\"type_id\":" + str(record.type_id) + ",\"fields\":["
            for i in 0..len(record.fields) { if i > 0 { out = out + "," } let field = record.fields[i] out = out + "{\"$tuple\":[" + mir_quote(field.name) + "," + str(field.type_id) + "]}" }
            out = out + "],\"parent\":" + (if record.parent < 0 { "null" } else { mir_quote(module.types[record.parent].name) }) + ",\"methods\":" + mir_methods_json(module, record) + "}"
        }
    }
    return out + "}"
}

fn mir_load_field(context: MirBuilder, value: int, index: int, type_id: int, source: Token) -> int {
    let result = mir_op(context, "load_field", type_id, [value], "", mir_literal_int(index), source)
    let block = context.current
    context.blocks[block].operations[len(context.blocks[block].operations) - 1].owner_type = context.slots[value].type_id
    return result
}

fn mir_verify_records(module: MirModule) {
    let mut ids: list[int] = []
    for record in module.records {
        let id = record.type_id
        if not mir_valid_type(module.types, id) { report_error_at("W9999", module.source, "invalid MIR nominal identity") }
        let kind = module.types[id].kind
        if kind != "struct" and kind != "enum" and kind != "class" and kind != "interface" { report_error_at("W9999", module.source, "invalid MIR nominal kind") }
        for previous in ids { if previous == id { report_error_at("W9999", module.source, "duplicate MIR nominal definition") } }
        ids.append(id)
        let mut fields: list[str] = []
        for field in record.fields {
            if (kind != "struct" and kind != "class") or not mir_valid_type(module.types, field.type_id) { report_error_at("W9999", module.source, "invalid MIR nominal field") }
            for name in fields { if name == field.name { report_error_at("W9999", module.source, "duplicate MIR nominal field") } }
            fields.append(field.name)
        }
        if record.parent >= 0 and (not mir_valid_type(module.types, record.parent) or module.types[record.parent].kind != "class") { report_error_at("W9999", module.source, "invalid MIR superclass") }
        for interface_ in record.interfaces { if not mir_valid_type(module.types, interface_) or module.types[interface_].kind != "interface" { report_error_at("W9999", module.source, "invalid MIR interface") } }
        let mut methods: list[str] = []
        for method in record.methods {
            if (kind != "class" and kind != "interface") or not mir_valid_type(module.types, method.type_id) or module.types[method.type_id].kind != "function" or not mir_valid_type(module.types, method.owner) { report_error_at("W9999", module.source, "invalid MIR method signature") }
            for previous in methods { if previous == method.name { report_error_at("W9999", module.source, "duplicate MIR method") } }
            methods.append(method.name)
            if kind == "class" {
                let signature = module.types[method.type_id].args
                let mut found = false
                for function in module.functions {
                    if function.name == method.target and len(function.params) == len(signature) {
                        found = function.return_type == signature[len(signature) - 1] and function.slots[function.params[0]].type_id == method.owner
                        for i in 1..len(function.params) { if function.slots[function.params[i]].type_id != signature[i - 1] { found = false } }
                    }
                }
                if not found { report_error_at("W9999", module.source, "unresolved MIR method implementation") }
            }
        }
        let mut variants: list[str] = []
        for variant in record.variants {
            if kind != "enum" { report_error_at("W9999", module.source, "invalid MIR enum definition") }
            for name in variants { if name == variant.name { report_error_at("W9999", module.source, "duplicate MIR enum variant") } }
            variants.append(variant.name)
            for payload in variant.payloads { if not mir_valid_type(module.types, payload) { report_error_at("W9999", module.source, "invalid MIR enum payload") } }
        }
    }
    for i in 0..len(module.types) {
        let kind = module.types[i].kind
        if kind == "struct" or kind == "enum" or kind == "class" or kind == "interface" {
            let mut found = false
            for id in ids { if id == i { found = true } }
            if not found { report_error_at("W9999", module.source, "missing MIR nominal definition") }
        }
    }
}

fn mir_equality_shapes(module: MirModule, left: int, right: int) -> bool {
    if mir_compatible(module.types, module.records, left, right) or mir_compatible(module.types, module.records, right, left) { return true }
    let a = module.types[left]
    let b = module.types[right]
    if a.kind != b.kind or len(a.args) != len(b.args) { return false }
    if a.kind != "list" and a.kind != "optional" and a.kind != "tuple" and a.kind != "result" and a.kind != "error_union" { return false }
    for i in 0..len(a.args) { if not mir_equality_shapes(module, a.args[i], b.args[i]) { return false } }
    return true
}
fn mir_equality(module: MirModule, left: int, right: int) -> bool {
    let mut pending: list[int] = [left, right]
    let mut seen: list[int] = []
    while len(pending) > 0 {
        let id = pending.pop()
        let mut visited = false
        for previous in seen { if previous == id { visited = true } }
        if not visited {
            seen.append(id)
            let type_ = module.types[id]
            if type_.kind == "function" { return false }
            for child in type_.args { pending.append(child) }
            if type_.kind == "struct" or type_.kind == "enum" {
                let record = mir_find_record(module.records, id, module.source)
                for field in record.fields { pending.append(field.type_id) }
                for variant in record.variants { for payload in variant.payloads { pending.append(payload) } }
            }
        }
    }
    return mir_equality_shapes(module, left, right)
}
fn mir_abi_name(name: str) -> str {
    for i in 0..len(name) { if name[i] == "." { return "wysna_method_" + slice(name, 0, i) + "__" + slice(name, i + 1, len(name)) } }
    return "wysna_fn_" + name
}
fn mir_virtual_index(context: MirBuilder, name: str, arity: int) -> int {
    for i in 0..len(context.virtual_slots) { if context.virtual_slots[i].name == name and context.virtual_slots[i].arity == arity { return i } }
    context.virtual_slots.append(MirVirtualSlot { name: name, arity: arity })
    return len(context.virtual_slots) - 1
}
fn mir_virtual_call(context: MirBuilder, node: CheckedNode) -> int {
    let signature = context.program.types[context.program.signatures[node.target].type_id].args
    let mut arguments: list[int] = []
    for i in 0..len(node.children) {
        let value = mir_expression(context, node.children[i])
        if context.current < 0 { return -1 }
        arguments.append(mir_coerce(context, value, mir_type(context, signature[i], node.source), false, node.source))
    }
    if len(node.labels) != 2 { report_error_at("W9999", node.source, "checked virtual identity missing") }
    let slot = mir_virtual_index(context, node.labels[1], len(arguments) - 1)
    return mir_op(context, "virtual", mir_type(context, node.type_id, node.source), arguments, "", mir_literal_int(slot), node.source)
}
fn mir_default(context: MirBuilder, type_id: int, source: Token) -> int {
    let kind = context.types[type_id].kind
    if kind == "weak" { return mir_op(context, "runtime", type_id, [], "wysna_empty_weak", mir_literal_unit(), source) }
    if kind == "list" or kind == "dict" { return mir_op(context, "construct", type_id, [], kind, mir_literal_unit(), source) }
    let mut literal = MirLiteral { type_id: 6, integer: 0, floating: 0.0, boolean: false, text: "" }
    if type_id <= 5 { literal.type_id = type_id }
    return mir_op(context, "default", type_id, [], "", literal, source)
}
fn mir_new(context: MirBuilder, node: CheckedNode) -> int {
    let source = node.source
    let returned = mir_type(context, node.type_id, source)
    let record = mir_find_record(context.records, returned, source)
    let mut arguments: list[int] = []
    for child in node.children { arguments.append(mir_expression(context, child)) }
    if context.current < 0 { return -1 }
    let mut values: list[int] = []
    for field in record.fields { values.append(mir_default(context, field.type_id, source)) }
    let result = mir_op(context, "construct", returned, values, "object", mir_literal_int(returned), source)
    mir_append(context, MirOperation { owner_type: returned, labels: mir_empty_labels(), place: mir_empty_place(), opcode: "set_vtable", result: -1, args: [result], name: context.types[returned].name, value: mir_literal_unit(), source: source })
    let mut initialized = false
    for method in record.methods {
        if method.name == "init" {
            initialized = true
            let signature = context.types[method.type_id].args
            if len(arguments) + 1 != len(signature) { report_error_at("W9999", source, "checked constructor arity mismatch") }
            let mut checked: list[int] = [mir_coerce(context, result, method.owner, false, source)]
            for i in 0..len(arguments) { checked.append(mir_coerce(context, arguments[i], signature[i], false, source)) }
            mir_op(context, "call", signature[len(signature) - 1], checked, method.target, mir_literal_unit(), source)
        }
    }
    if not initialized and len(arguments) > 0 { report_error_at("W9999", source, "checked constructor has no initializer") }
    return result
}
fn mir_virtual_slots_json(module: MirModule) -> str {
    let mut out = "["
    for i in 0..len(module.virtual_slots) {
        if i > 0 { out = out + "," }
        let slot = module.virtual_slots[i]
        out = out + "{\"$tuple\":[" + mir_quote(slot.name) + "," + str(slot.arity) + "]}"
    }
    return out + "]"
}

fn mir_reference_definition_json(module: MirModule, record: MirRecord, kind: str) -> str {
    let mut out = ""
    if kind == "class" {
        out = out + ",\"superclass\":" + (if record.parent < 0 { "null" } else { str(record.parent) }) + ",\"interfaces\":" + mir_ids(record.interfaces, false) + ",\"fields\":{"
        for i in 0..len(record.fields) { if i > 0 { out = out + "," } let field = record.fields[i] out = out + mir_quote(field.name) + ":[" + str(field.type_id) + "," + str(field.visible) + "]" }
        out = out + "}"
    }
    out = out + ",\"methods\":{"
    let mut count = 0
    let mut init = "null"
    for method in record.methods {
        if method.name == "init" { init = str(method.type_id) }
        else {
            if count > 0 { out = out + "," }
            count = count + 1
            out = out + mir_quote(method.name) + ":"
            if kind == "class" { out = out + "[" + str(method.type_id) + "," + str(method.visible) + "]" }
            else { out = out + str(method.type_id) }
        }
    }
    out = out + "}"
    if kind == "class" { out = out + ",\"init_sig\":" + init }
    return out
}
fn mir_methods_json(module: MirModule, record: MirRecord) -> str {
    let mut out = "{"
    for i in 0..len(record.methods) {
        if i > 0 { out = out + "," }
        let method = record.methods[i]
        let signature = module.types[method.type_id].args
        let mut params: list[int] = []
        for j in 0..len(signature) - 1 { params.append(signature[j]) }
        out = out + mir_quote(method.name) + ":{\"$tuple\":[" + mir_quote(module.types[method.owner].name) + "," + mir_ids(params, false) + "," + str(signature[len(signature) - 1]) + "]}"
    }
    return out + "}"
}
fn mir_c_vtables(module: MirModule) -> str {
    let mut out = ""
    for record in module.records {
        if module.types[record.type_id].kind == "class" {
            let name = module.types[record.type_id].name
            let mut entries: list[str] = []
            for i in 0..len(module.virtual_slots) {
                let slot = module.virtual_slots[i]
                let mut entry = "NULL"
                for method in record.methods {
                    let signature = module.types[method.type_id].args
                    if method.name == slot.name and len(signature) == slot.arity + 1 {
                        entry = "wysna_virtual_" + str(record.type_id) + "_" + str(i)
                        out = out + "static WVal " + entry + "(WVal receiver, int32_t argc, const WVal* argv) {\n    (void)argv;\n    if (argc != " + str(slot.arity) + ") wysna_runtime_fail(\"W4003\", \"Call arity mismatch\");\n    return "
                        let mut call = method.target + "(receiver"
                        for j in 0..slot.arity { call = call + ", " + mir_c_unbox("argv[" + str(j) + "]", signature[j]) }
                        call = call + ")"
                        out = out + mir_c_box(call, signature[len(signature) - 1]) + ";\n}\n"
                    }
                }
                entries.append(entry)
            }
            if len(entries) > 0 {
                out = out + "static const WInvoke wysna_slots_" + name + "[" + str(len(entries)) + "] = {"
                for i in 0..len(entries) { if i > 0 { out = out + ", " } out = out + entries[i] }
                out = out + "};\nstatic const WClassVTable wysna_vtable_" + name + " = {" + str(len(entries)) + ", wysna_slots_" + name + "};\n"
            } else { out = out + "static const WClassVTable wysna_vtable_" + name + " = {0, NULL};\n" }
        }
    }
    return out
}

fn mir_verify_virtual(module: MirModule, operation: MirOperation, slots: list[MirSlot]) -> bool {
    let index = operation.value.integer
    if index < 0 or index >= len(module.virtual_slots) or len(operation.args) == 0 { return false }
    let slot = module.virtual_slots[index]
    if len(operation.args) != slot.arity + 1 { return false }
    let receiver = slots[operation.args[0]].type_id
    let kind = module.types[receiver].kind
    if kind != "class" and kind != "interface" { return false }
    let record = mir_find_record(module.records, receiver, operation.source)
    for method in record.methods {
        if method.name == slot.name {
            let signature = module.types[method.type_id].args
            if len(signature) != slot.arity + 1 or slots[operation.result].type_id != signature[len(signature) - 1] { return false }
            for i in 0..slot.arity { if not mir_compatible(module.types, module.records, slots[operation.args[i + 1]].type_id, signature[i]) { return false } }
            return true
        }
    }
    return false
}
fn mir_add_extern(context: MirBuilder, checked: CheckedSignature) {
    let signature = context.program.types[checked.type_id].args
    let mut params: list[int] = []
    for i in 0..len(signature) - 1 { params.append(mir_type(context, signature[i], context.program.source)) }
    context.externs.append(MirExtern { name: mir_abi_name(checked.name), native: checked.native, params: params, return_type: mir_type(context, signature[len(signature) - 1], context.program.source), abi_params: checked.abi_params, abi_return: checked.abi_return })
}
fn mir_externs_json(module: MirModule) -> str {
    let mut out = "{"
    for i in 0..len(module.externs) {
        if i > 0 { out = out + "," }
        let external = module.externs[i]
        let mut params = "["
        for j in 0..len(external.abi_params) { if j > 0 { params = params + "," } params = params + mir_quote(external.abi_params[j]) }
        params = params + "]"
        out = out + mir_quote(external.name) + ":{\"native\":" + mir_quote(external.native) + ",\"params\":" + mir_ids(external.params, false) + ",\"return_type\":" + str(external.return_type) + ",\"signature\":{\"$tuple\":[{\"$tuple\":" + params + "}," + mir_quote(external.abi_return) + "]}}"
    }
    return out + "}"
}
fn mir_c_externs(module: MirModule) -> str {
    let mut out = ""
    for external in module.externs {
        let mut prototype = "extern " + foreign_c_type(external.abi_return, true, module.source) + " " + external.native + "("
        let mut wrapper = "static WVal " + external.name + "("
        let mut call = external.native + "("
        for i in 0..len(external.params) {
            if i > 0 { prototype = prototype + ", " wrapper = wrapper + ", " call = call + ", " }
            let abi = external.abi_params[i]
            prototype = prototype + foreign_c_type(abi, false, module.source)
            let value = "v_" + str(i)
            wrapper = wrapper + "WVal " + value
            if abi == "int32" { call = call + "wysna_ffi_int32(" + value + ")" }
            elif abi == "int" or abi == "int64" { call = call + value + ".as.i" }
            elif abi == "float" or abi == "double" { call = call + value + ".as.f" }
            elif abi == "bool" { call = call + value + ".as.b" }
            else { call = call + value + ".as.pointer" }
        }
        if len(external.params) == 0 { prototype = prototype + "void" wrapper = wrapper + "void" }
        call = call + ")"
        let returned = foreign_type_id(external.abi_return)
        let mut body = ""
        if returned == "unit" { body = call + "; return wysna_unit();" }
        elif returned == "opaque" {
            let constructor = if external.native == "wysna_host_buffer_new" or external.native == "wysna_host_file_open" { "wysna_host_owned_pointer" } else { "wysna_pointer" }
            body = "return " + constructor + "(" + call + ");"
        } else {
            let constructor = if returned == "int" { "wysna_int" } elif returned == "float" { "wysna_float" } else { "wysna_bool" }
            body = "return " + constructor + "(" + call + ");"
        }
        out = out + prototype + ");\n" + wrapper + ") { " + body + " }\n"
    }
    return out
}
fn mir_verify_externs(module: MirModule) {
    let mut names: list[str] = []
    for external in module.externs {
        for name in names { if name == external.name { report_error_at("W9999", module.source, "duplicate MIR external") } }
        for function in module.functions { if function.name == external.name { report_error_at("W9999", module.source, "MIR external shadows function") } }
        names.append(external.name)
        if not mir_identifier(external.name) or not mir_identifier(external.native) { report_error_at("W9999", module.source, "invalid MIR external ABI identifier") }
        if len(external.params) != len(external.abi_params) { report_error_at("W9999", module.source, "MIR C ABI arity mismatch") }
        for i in 0..len(external.params) {
            if not mir_valid_type(module.types, external.params[i]) { report_error_at("W9999", module.source, "invalid MIR external parameter") }
            let abi = external.abi_params[i]
            if not mir_foreign_abi(abi, false) { report_error_at("W9999", module.source, "invalid MIR C ABI parameter width") }
            if module.types[external.params[i]].kind != foreign_type_id(abi) { report_error_at("W9999", module.source, "MIR C ABI parameter type mismatch") }
        }
        if not mir_valid_type(module.types, external.return_type) { report_error_at("W9999", module.source, "invalid MIR external return") }
        if not mir_foreign_abi(external.abi_return, true) { report_error_at("W9999", module.source, "invalid MIR C ABI return width") }
        if module.types[external.return_type].kind != foreign_type_id(external.abi_return) { report_error_at("W9999", module.source, "MIR C ABI return type mismatch") }
    }
}

fn mir_foreign_abi(name: str, returned: bool) -> bool {
    return name == "int" or name == "int32" or name == "int64" or name == "float" or name == "double" or name == "bool" or name == "opaque" or returned and name == "unit"
}
fn mir_identifier(name: str) -> bool {
    if len(name) == 0 { return false }
    for i in 0..len(name) {
        let code = ord(name[i])
        let letter = code >= 65 and code <= 90 or code >= 97 and code <= 122 or code == 95
        if not letter and not (i > 0 and code >= 48 and code <= 57) { return false }
    }
    return true
}
# Pattern tests dominate all payload reads and refinements.
fn mir_test(context: MirBuilder, value: int, kind: str, labels: list[str], owner: int, index: int, source: Token) -> int {
    let result = mir_op(context, "test", 2, [value], kind, mir_literal_int(index), source)
    context.slots[result].predicate = true
    let block = context.current
    let operation = len(context.blocks[block].operations) - 1
    context.blocks[block].operations[operation].labels = labels
    context.blocks[block].operations[operation].owner_type = owner
    return result
}
fn mir_pattern_branch(context: MirBuilder, condition: int, failure: int, positive: bool, source: Token) {
    let matched = mir_new_block(context, source)
    mir_terminate(context, "branch", if positive { [matched, failure] } else { [failure, matched] }, condition, source)
    context.current = matched
}
fn mir_pattern_literal(context: MirBuilder, pattern: SemPattern) -> int {
    let type_id = mir_type(context, pattern.type_id, pattern.source)
    let text = slice(pattern.name, 8, len(pattern.name))
    if type_id == 3 {
        let negative = len(text) > 0 and text[0] == "-"
        return mir_integer(context, if negative { slice(text, 1, len(text)) } else { text }, negative, pattern.source)
    }
    if type_id == 4 { return mir_constant(context, mir_literal_float(float(text)), 4, pattern.source) }
    if type_id == 5 { return mir_constant(context, mir_literal_str(text), 5, pattern.source) }
    return mir_constant(context, mir_literal_bool(text == "true" or text == "TRUE"), 2, pattern.source)
}
fn mir_pattern(context: MirBuilder, value: int, id: int, failure: int) {
    let pattern = context.program.patterns[id]
    let source = pattern.source
    let type_id = context.slots[value].type_id
    let type_ = context.types[type_id]
    if pattern.name == "*" {
        if pattern.binding >= 0 { context.bindings.append(MirBinding { symbol: pattern.binding, slot: value }) }
        return
    }
    if len(pattern.name) >= 8 and slice(pattern.name, 0, 8) == "literal:" {
        let literal = mir_pattern_literal(context, pattern)
        let test = mir_op(context, "test", 2, [value, literal], "equal", mir_literal_unit(), source)
        context.slots[test].predicate = true
        mir_pattern_branch(context, test, failure, true, source)
        return
    }
    if pattern.name == "None" and type_.kind == "optional" { mir_pattern_branch(context, mir_error_test(context, value, source), failure, true, source) return }
    if type_.kind == "error_union" {
        let child = context.program.patterns[pattern.children[0]]
        let narrowed = mir_type(context, child.type_id, source)
        let descriptor = context.types[narrowed]
        let name = if narrowed <= 5 { descriptor.kind } else { descriptor.name }
        let witness = mir_test(context, value, "error_type", [descriptor.kind, name], narrowed, 0, source)
        mir_pattern_branch(context, witness, failure, true, source)
        let result = mir_op(context, "narrow", narrowed, [value], "", mir_literal_int(witness), source)
        mir_pattern(context, result, pattern.children[0], failure)
        return
    }
    if type_.kind == "tuple" {
        let count = len(type_.args)
        let test = mir_test(context, value, "tuple", mir_empty_labels(), type_id, count, source)
        mir_pattern_branch(context, test, failure, true, source)
        for i in 0..len(pattern.children) {
            let item = mir_op(context, "tuple_get", type_.args[i], [value], "", mir_literal_int(i), source)
            mir_pattern(context, item, pattern.children[i], failure)
        }
        return
    }
    if type_.kind == "optional" or type_.kind == "result" {
        let condition = mir_error_test(context, value, source)
        let error = pattern.name == "Err"
        mir_pattern_branch(context, condition, failure, error, source)
        if len(pattern.children) == 1 {
            let payload = if error { type_.args[1] } else { type_.args[0] }
            let helper = if type_.kind == "optional" { "wysna_unwrap_optional" } elif error { "wysna_unwrap_err" } else { "wysna_unwrap_ok" }
            let item = mir_op(context, "runtime", payload, [value], helper, mir_literal_unit(), source)
            mir_pattern(context, item, pattern.children[0], failure)
        }
        return
    }
    if type_.kind == "enum" {
        let condition = mir_test(context, value, "variant", [type_.name, pattern.name], type_id, 0, source)
        mir_pattern_branch(context, condition, failure, true, source)
        if len(pattern.children) > 0 {
            let mut payloads: list[int] = []
            for child in pattern.children { payloads.append(mir_type(context, context.program.patterns[child].type_id, source)) }
            let payload = if len(payloads) == 1 { payloads[0] } else { mir_intern(context, "tuple", "", payloads) }
            let item = mir_op(context, "runtime", payload, [value], "wysna_enum_payload_owned", mir_literal_unit(), source)
            let block = context.current
            context.blocks[block].operations[len(context.blocks[block].operations) - 1].labels = [type_.name, pattern.name]
            for i in 0..len(pattern.children) {
                let part = if len(payloads) == 1 { item } else { mir_op(context, "tuple_get", payloads[i], [item], "", mir_literal_int(i), source) }
                mir_pattern(context, part, pattern.children[i], failure)
            }
        }
        return
    }
    report_error_at("W9999", source, "checked pattern has no MIR policy")
}
fn mir_match(context: MirBuilder, node: CheckedNode) -> int {
    let source = node.source
    let subject = mir_expression(context, node.children[0])
    if context.current < 0 { return -1 }
    let returned = mir_type(context, node.type_id, source)
    let result = mir_slot(context, returned, "", false)
    let join = mir_new_block(context, source)
    let mut live = false
    for id in node.arms {
        let arm = context.program.arms[id]
        let bindings = context.bindings
        mir_push_scope(context)
        let failure = mir_new_block(context, arm.source)
        let next = mir_new_block(context, arm.source)
        mir_pattern(context, subject, arm.pattern, failure)
        if arm.guard >= 0 {
            let condition = mir_expression(context, arm.guard)
            if context.current >= 0 { mir_pattern_branch(context, condition, failure, true, arm.source) }
        }
        let value = mir_expression(context, arm.body)
        if context.current >= 0 {
            mir_store(context, result, mir_coerce(context, value, returned, false, arm.source), arm.source)
            mir_cleanup(context, len(context.scopes) - 1, arm.source)
            mir_jump(context, join, arm.source)
            live = true
        }
        context.current = failure
        mir_cleanup(context, len(context.scopes) - 1, arm.source)
        mir_jump(context, next, arm.source)
        context.scopes.pop()
        context.bindings = bindings
        context.current = next
    }
    if node.total {
        let targets: list[int] = []
        mir_terminate(context, "unreachable", targets, -1, source)
    } else {
        mir_store(context, result, mir_constant(context, mir_literal_unit(), 1, source), source)
        mir_jump(context, join, source)
        live = true
    }
    context.current = if live { join } else { -1 }
    return if live { result } else { -1 }
}

fn mir_verify_test(module: MirModule, operation: MirOperation, slots: list[MirSlot]) -> bool {
    if slots[operation.result].type_id != 2 or not slots[operation.result].predicate { return false }
    if operation.name == "equal" { return len(operation.args) == 2 and mir_equality(module, slots[operation.args[0]].type_id, slots[operation.args[1]].type_id) }
    if len(operation.args) != 1 { return false }
    let value = slots[operation.args[0]].type_id
    let type_ = module.types[value]
    if operation.name == "err" { return type_.kind == "result" }
    if operation.name == "none" { return type_.kind == "optional" }
    if operation.name == "tuple" { return type_.kind == "tuple" and len(type_.args) == operation.value.integer }
    if operation.name == "variant" {
        if type_.kind != "enum" or len(operation.labels) != 2 or operation.labels[0] != type_.name { return false }
        let record = mir_find_record(module.records, value, operation.source)
        for variant in record.variants { if variant.name == operation.labels[1] { return true } }
        return false
    }
    if operation.name == "error_type" {
        if type_.kind != "error_union" or len(operation.labels) != 2 or not mir_valid_type(module.types, operation.owner_type) { return false }
        let narrowed = module.types[operation.owner_type]
        let expected = if operation.owner_type <= 5 { narrowed.kind } else { narrowed.name }
        if operation.labels != [narrowed.kind, expected] { return false }
        for member in type_.args { if member == operation.owner_type { return true } }
    }
    return false
}
# Function values carry a verified signature and an owned snapshot environment.
fn mir_function_value(context: MirBuilder, type_id: int, target: str, environment: list[int], source: Token) -> int {
    let value = mir_literal_bool(len(environment) > 0)
    let mut metadata = value
    metadata.integer = len(context.types[type_id].args) - 1
    return mir_op(context, "function", type_id, environment, target, metadata, source)
}
fn mir_closure(context: MirBuilder, node: CheckedNode) -> int {
    let function = context.program.functions[node.target]
    let mut environment: list[int] = []
    if len(function.captures) > 0 {
        let mut values: list[int] = []
        let mut types: list[int] = []
        for symbol in function.captures {
            let value = mir_lookup(context, symbol, node.source)
            values.append(value)
            types.append(context.slots[value].type_id)
        }
        environment.append(mir_op(context, "construct", mir_intern(context, "tuple", "", types), values, "tuple", mir_literal_unit(), node.source))
    }
    return mir_function_value(context, mir_type(context, node.type_id, node.source), "wysna_" + function.name, environment, node.source)
}
fn mir_indirect(context: MirBuilder, node: CheckedNode) -> int {
    let callee = mir_expression(context, node.children[0])
    if context.current < 0 { return -1 }
    let signature = context.types[context.slots[callee].type_id].args
    let mut values: list[int] = [callee]
    for i in 1..len(node.children) {
        let value = mir_expression(context, node.children[i])
        if context.current < 0 { return -1 }
        values.append(mir_coerce(context, value, signature[i - 1], false, node.source))
    }
    return mir_op(context, "indirect", mir_type(context, node.type_id, node.source), values, "", mir_literal_unit(), node.source)
}
fn mir_verify_function_value(module: MirModule, operation: MirOperation, slots: list[MirSlot]) -> bool {
    let returned = slots[operation.result].type_id
    if operation.opcode == "indirect" {
        if len(operation.args) == 0 { return false }
        let signature = module.types[slots[operation.args[0]].type_id]
        if signature.kind != "function" or len(signature.args) != len(operation.args) or signature.args[len(signature.args) - 1] != returned { return false }
        for i in 1..len(operation.args) { if not mir_compatible(module.types, module.records, slots[operation.args[i]].type_id, signature.args[i - 1]) { return false } }
        return true
    }
    let signature = module.types[returned]
    if signature.kind != "function" or operation.value.integer != len(signature.args) - 1 { return false }
    let captured = operation.value.boolean
    if len(operation.args) != (if captured { 1 } else { 0 }) { return false }
    if captured and module.types[slots[operation.args[0]].type_id].kind != "tuple" { return false }
    for function in module.functions {
        if function.name == operation.name {
            let offset = if captured { 1 } else { 0 }
            if len(function.params) != len(signature.args) - 1 + offset or function.return_type != signature.args[len(signature.args) - 1] { return false }
            if captured and function.slots[function.params[0]].type_id != slots[operation.args[0]].type_id { return false }
            for i in 0..len(signature.args) - 1 { if function.slots[function.params[i + offset]].type_id != signature.args[i] { return false } }
            return true
        }
    }
    for external in module.externs {
        if external.name == operation.name and not captured {
            if external.return_type != signature.args[len(signature.args) - 1] or len(external.params) != len(signature.args) - 1 { return false }
            for i in 0..len(external.params) { if external.params[i] != signature.args[i] { return false } }
            return true
        }
    }
    return false
}
fn mir_c_function_adapters(module: MirModule) -> str {
    let mut emitted: list[str] = []
    let mut out = ""
    for function in module.functions {
        for block in function.blocks {
            for operation in block.operations {
                if operation.opcode == "function" and not module_contains(emitted, operation.name) {
                    emitted.append(operation.name)
                    let signature = module.types[function.slots[operation.result].type_id].args
                    let arity = len(signature) - 1
                    let mut arguments: list[str] = []
                    if operation.value.boolean { arguments.append("environment") }
                    for i in 0..arity { arguments.append(mir_c_unbox("argv[" + str(i) + "]", signature[i])) }
                    # Foreign adapters take boxed arguments at the internal boundary.
                    for external in module.externs {
                        if external.name == operation.name { for i in 0..arity { arguments[i] = "argv[" + str(i) + "]" } }
                    }
                    let mut call = operation.name + "("
                    for i in 0..len(arguments) { if i > 0 { call = call + ", " } call = call + arguments[i] }
                    call = call + ")"
                    let mut boxed = false
                    for external in module.externs { if external.name == operation.name { boxed = true } }
                    out = out + "static WVal wysna_adapter_" + operation.name + "(WVal environment, int32_t argc, const WVal* argv) {\n    (void)environment; (void)argv;\n    if (argc != " + str(arity) + ") wysna_runtime_fail(\"W4003\", \"Call arity mismatch\");\n    return " + (if boxed { call } else { mir_c_box(call, signature[arity]) }) + ";\n}\n"
                }
            }
        }
    }
    return out
}
# Lower session-owned checked nodes to explicit CFG, storage and cleanup.
fn mir_lookup(context: MirBuilder, symbol: int, source: Token) -> int {
    for binding in context.bindings {
        if binding.symbol == symbol {
            let value = mir_op(context, "clone", context.slots[binding.slot].type_id, [binding.slot], "", mir_literal_unit(), source)
            context.slots[value].origin = binding.slot
            return value
        }
    }
    for i in 0..len(context.globals) {
        let global = context.globals[i]
        if global.symbol == symbol {
            let value = mir_op(context, "global_load", global.type_id, [], "", mir_literal_int(i), source)
            context.slots[value].origin = -i - 2
            return value
        }
    }
    mir_unsupported(source, "unavailable binding")
    return -1
}

fn mir_call(context: MirBuilder, node: CheckedNode) -> int {
    let mut arguments: list[int] = []
    for child in node.children {
        if context.current < 0 { return -1 }
        let argument = mir_expression(context, child)
        if context.current < 0 { arguments.append(argument) }
        elif node.target >= 0 {
            let signature = context.program.types[context.program.signatures[node.target].type_id].args
            arguments.append(mir_coerce(context, argument, mir_type(context, signature[len(arguments)], node.source), false, node.source))
        } else { arguments.append(argument) }
    }
    if context.current < 0 { return -1 }
    let returned = mir_type(context, node.type_id, node.source)
    if node.text == "Some" { return mir_op(context, "runtime", returned, arguments, "wysna_enum_payload", mir_literal_unit(), node.source) }
    if node.text == "Ok" or node.text == "Err" {
        if not mir_is_result(context.types, returned) { mir_unsupported(node.source, "result constructors without a concrete result context") }
        let mut payload = arguments[0]
        if node.text == "Ok" and context.types[returned].args[0] == 1 and context.slots[payload].type_id != 1 { payload = mir_constant(context, mir_literal_unit(), 1, node.source) }
        return mir_pack(context, payload, returned, node.text == "Err", node.source)
    }
    if node.target >= 0 {
        let function = context.program.signatures[node.target]
        if len(function.type_params) > 0 { mir_unsupported(node.source, "generic calls") }
        return mir_op(context, "call", returned, arguments, mir_abi_name(function.name), mir_literal_unit(), node.source)
    }
    if node.text == "weak" { return mir_op(context, "runtime", returned, arguments, "wysna_builtin_weak_owned", mir_literal_unit(), node.source) }
    let builtins: list[str] = ["upgrade", "print", "eprint", "int", "float", "str", "len", "ord", "chr", "slice", "bytes", "args", "exit", "join_strings", "enumerate", "dict_items", "read_file", "write_file"]
    for name in builtins { if node.text == name { return mir_op(context, "runtime", returned, arguments, "wysna_builtin_" + name, mir_literal_unit(), node.source) } }
    mir_unsupported(node.source, "builtin call " + node.text)
    return -1
}

fn mir_binary_name(kind: str) -> str {
    if kind == "PLUS" { return "wysna_add" }
    if kind == "MINUS" { return "wysna_sub" }
    if kind == "STAR" { return "wysna_mul" }
    if kind == "SLASH" { return "wysna_div_at" }
    if kind == "PERCENT" { return "wysna_mod_at" }
    if kind == "EQ" { return "wysna_equal" }
    if kind == "NEQ" { return "wysna_not_equal" }
    if kind == "LT" { return "wysna_lt" }
    if kind == "LTE" { return "wysna_le" }
    if kind == "GT" { return "wysna_gt" }
    if kind == "GTE" { return "wysna_ge" }
    return ""
}

fn mir_expression(context: MirBuilder, id: int) -> int {
    if context.current < 0 { return -1 }
    let node = context.program.nodes[id]
    let source = node.source
    if node.kind == "integer" { return mir_integer(context, node.text, false, source) }
    if node.kind == "float" {
        let number = float(node.text)
        if str(number) == "inf" { report_error_at("W0002", source, "float literal is outside finite binary64 range") }
        return mir_constant(context, mir_literal_float(number), 4, source)
    }
    if node.kind == "string" { return mir_constant(context, mir_literal_str(node.text), 5, source) }
    if node.kind == "boolean" { return mir_constant(context, mir_literal_bool(node.text == "TRUE"), 2, source) }
    if node.kind == "none" { return mir_constant(context, MirLiteral { type_id: 6, integer: 0, floating: 0.0, boolean: false, text: "" }, 6, source) }
    if node.kind == "struct" or node.kind == "struct_call" or node.kind == "enum" or node.kind == "enum_call" { return mir_nominal_expression(context, node) }
    if node.kind == "member" { return mir_member(context, node) }
    if node.kind == "list" or node.kind == "dict" or node.kind == "tuple" { return mir_collection(context, node) }
    if node.kind == "collection_call" { return mir_collection_call(context, node) }
    if node.kind == "unit" { return mir_constant(context, mir_literal_unit(), 1, source) }
    if node.kind == "super" {
        let receiver = mir_lookup(context, node.binding, source)
        return mir_coerce(context, receiver, mir_type(context, node.type_id, source), false, source)
    }
    if node.kind == "closure" { return mir_closure(context, node) }
    if node.kind == "callee" and node.target >= 0 { return mir_function_value(context, mir_type(context, node.type_id, source), mir_abi_name(context.program.signatures[node.target].name), [], source) }
    if node.kind == "indirect_call" { return mir_indirect(context, node) }
    if node.kind == "match" { return mir_match(context, node) }
    if node.kind == "new" { return mir_new(context, node) }
    if node.kind == "virtual_call" { return mir_virtual_call(context, node) }
    if node.kind == "binding" { return mir_lookup(context, node.binding, source) }
    if node.kind == "call" { return mir_call(context, node) }
    if node.kind == "if" { return mir_if(context, node) }
    if node.kind == "block" { return mir_block(context, id) }
    if node.kind == "unary" {
        let operand_node = context.program.nodes[node.children[0]]
        if node.text == "MINUS" and operand_node.kind == "integer" { return mir_integer(context, operand_node.text, true, source) }
        let operand = mir_expression(context, node.children[0])
        if context.current < 0 { return -1 }
        return mir_op(context, "runtime", mir_type(context, node.type_id, source), [operand], if node.text == "MINUS" { "wysna_neg" } else { "wysna_not" }, mir_literal_unit(), source)
    }
    if node.kind == "propagate" or node.kind == "handler" {
        let value = mir_expression(context, node.children[0])
        if context.current < 0 { return -1 }
        return mir_channel(context, value, source, node.kind == "propagate", node.binding, if node.kind == "handler" { node.children[1] } else { -1 })
    }
    if node.kind == "assign" {
        let place = mir_place(context, node.children[0])
        let right = mir_expression(context, node.children[1])
        if context.current < 0 { return -1 }
        let checked = mir_coerce(context, right, mir_type(context, node.type_id, source), false, source)
        mir_append(context, MirOperation { owner_type: 0, labels: mir_empty_labels(), place: place, opcode: "store_place", result: -1, args: [checked], name: "", value: mir_literal_unit(), source: source })
        return mir_read_place(context, place, source)
    }
    if node.kind == "binary" {
        let left = mir_expression(context, node.children[0])
        if context.current < 0 { return -1 }
        if node.text == "QQ" { return mir_optional_channel(context, left, source, false, node.children[1]) }
        if node.text == "AND" or node.text == "OR" {
            let result = mir_slot(context, 2, "", false)
            mir_store(context, result, left, source)
            let right_block = mir_new_block(context, source)
            let join = mir_new_block(context, source)
            mir_terminate(context, "branch", if node.text == "AND" { [right_block, join] } else { [join, right_block] }, result, source)
            context.current = right_block
            let right = mir_expression(context, node.children[1])
            if context.current >= 0 { mir_store(context, result, right, source) mir_jump(context, join, source) }
            context.current = join
            return result
        }
        let right = mir_expression(context, node.children[1])
        if context.current < 0 { return -1 }
        if node.text != "EQ" and node.text != "NEQ" and (mir_is_result(context.types, context.slots[left].type_id) or mir_is_result(context.types, context.slots[right].type_id)) { mir_unsupported(source, "binary result operators") }
        let name = mir_binary_name(node.text)
        if node.text == "DOT_DOT" or node.text == "DOT_DOT_EQ" {
            return mir_op(context, "runtime", mir_type(context, node.type_id, source), [left, right], if node.text == "DOT_DOT" { "wysna_make_range" } else { "wysna_make_range_inclusive" }, mir_literal_unit(), source)
        }
        if name == "" { mir_unsupported(source, "operator " + node.text) }
        return mir_op(context, "runtime", mir_type(context, node.type_id, source), [left, right], name, mir_literal_unit(), source)
    }
    if node.kind == "index" {
        let value = mir_expression(context, node.children[0])
        if context.current < 0 { return -1 }
        let index = mir_expression(context, node.children[1])
        if context.current < 0 { return -1 }
        return mir_op(context, "runtime", mir_type(context, node.type_id, source), [value, index], "wysna_index_get_owned_at", mir_literal_unit(), source)
    }
    mir_unsupported(source, "checked expression " + node.kind)
    return -1
}

fn mir_block(context: MirBuilder, id: int) -> int {
    let node = context.program.nodes[id]
    let bindings = context.bindings
    mir_push_scope(context)
    let mut tail = -1
    for statement in node.children { tail = mir_statement(context, statement) }
    let mut escaped = -1
    if context.current >= 0 {
        if tail < 0 { tail = mir_constant(context, mir_literal_unit(), 1, node.source) }
        escaped = mir_raw_slot(context, context.slots[tail].type_id, "", false)
        mir_store(context, escaped, tail, node.source)
        mir_cleanup(context, len(context.scopes) - 1, node.source)
    }
    context.scopes.pop()
    context.bindings = bindings
    if escaped >= 0 { mir_track(context, escaped) }
    return escaped
}

fn mir_if(context: MirBuilder, node: CheckedNode) -> int {
    let source = node.source
    let condition = mir_expression(context, node.children[0])
    if context.current < 0 { return -1 }
    let yes = mir_new_block(context, source)
    let no = mir_new_block(context, source)
    let join = mir_new_block(context, source)
    mir_terminate(context, "branch", [yes, no], condition, source)
    context.current = yes
    let mut yes_value = mir_expression(context, node.children[1])
    if context.current >= 0 and node.discard {
        if mir_is_result(context.types, context.slots[yes_value].type_id) { mir_channel(context, yes_value, source, true, -1, -1) }
        yes_value = mir_constant(context, mir_literal_unit(), 1, source)
    }
    let yes_end = context.current
    context.current = no
    let mut no_value = mir_expression(context, node.children[2])
    if context.current >= 0 and node.discard {
        if mir_is_result(context.types, context.slots[no_value].type_id) { mir_channel(context, no_value, source, true, -1, -1) }
        no_value = mir_constant(context, mir_literal_unit(), 1, source)
    }
    let no_end = context.current
    if yes_end < 0 and no_end < 0 { context.current = -1 return -1 }
    let returned = if node.discard { 1 } else { mir_type(context, node.type_id, source) }
    let result = mir_slot(context, returned, "", false)
    if yes_end >= 0 {
        context.current = yes_end
        if context.slots[yes_value].type_id != returned { yes_value = if returned == 1 { mir_constant(context, mir_literal_unit(), 1, source) } else { mir_coerce(context, yes_value, returned, false, source) } }
        mir_store(context, result, yes_value, source)
        mir_jump(context, join, source)
    }
    if no_end >= 0 {
        context.current = no_end
        if context.slots[no_value].type_id != returned { no_value = if returned == 1 { mir_constant(context, mir_literal_unit(), 1, source) } else { mir_coerce(context, no_value, returned, false, source) } }
        mir_store(context, result, no_value, source)
        mir_jump(context, join, source)
    }
    context.current = join
    return result
}

fn mir_statement(context: MirBuilder, id: int) -> int {
    let node = context.program.nodes[id]
    let source = node.source
    if context.current < 0 { return -1 }
    if node.kind == "let" {
        let binding = context.program.bindings[node.binding]
        let type_id = mir_type(context, binding.type_id, source)
        let value = mir_expression(context, node.children[0])
        if context.current >= 0 {
            if binding.global {
                for i in 0..len(context.globals) {
                    if context.globals[i].symbol == node.binding { mir_append(context, MirOperation { owner_type: 0, labels: mir_empty_labels(), place: mir_empty_place(), opcode: "global_store", result: -1, args: [mir_coerce(context, value, type_id, false, source)], name: "", value: mir_literal_int(i), source: source }) }
                }
                return -1
            }
            let slot = mir_slot(context, type_id, "", false)
            mir_store(context, slot, mir_coerce(context, value, type_id, false, source), source)
            context.bindings.append(MirBinding { symbol: node.binding, slot: slot })
        }
        return -1
    }
    if node.kind == "return" {
        let value = mir_expression(context, node.children[0])
        if context.current >= 0 { mir_return(context, value, source) }
        return -1
    }
    if node.kind == "for" { mir_for(context, node) return -1 }
    if node.kind == "while" {
        let header = mir_new_block(context, source)
        let body = mir_new_block(context, source)
        let after = mir_new_block(context, source)
        mir_jump(context, header, source)
        context.current = header
        mir_push_scope(context)
        let condition = mir_expression(context, node.children[0])
        if context.current < 0 { context.scopes.pop() return -1 }
        mir_cleanup(context, len(context.scopes) - 1, source)
        context.scopes.pop()
        mir_terminate(context, "branch", [body, after], condition, source)
        context.current = body
        context.loops.append(MirLoop { after: after, header: header, depth: len(context.scopes) })
        let value = mir_block(context, node.children[1])
        if context.current >= 0 { mir_release(context, value, source) mir_jump(context, header, source) }
        context.loops.pop()
        context.current = after
        return -1
    }
    if node.kind == "break" or node.kind == "continue" {
        if len(context.loops) == 0 { report_error_at("W9999", source, "checked loop transfer outside loop") }
        let loop = context.loops[len(context.loops) - 1]
        mir_cleanup(context, loop.depth, source)
        mir_jump(context, if node.kind == "break" { loop.after } else { loop.header }, source)
        return -1
    }
    return mir_expression(context, id)
}

fn mir_lower_function(context: MirBuilder, function: CheckedFunction) {
    let signature = context.program.types[function.type_id].args
    let returned = mir_type(context, signature[len(signature) - 1], function.source)
    mir_begin(context, function.source, returned)
    if function.closure and len(function.captures) > 0 {
        let mut captured_types: list[int] = []
        for id in function.captures { captured_types.append(mir_type(context, context.program.bindings[id].type_id, function.source)) }
        let environment = mir_slot(context, mir_intern(context, "tuple", "", captured_types), "v_environment", true)
        for i in 0..len(function.captures) {
            let value = mir_op(context, "tuple_get", captured_types[i], [environment], "", mir_literal_int(i), function.source)
            context.bindings.append(MirBinding { symbol: function.captures[i], slot: value })
        }
    }
    for i in 0..len(function.params) {
        let slot = mir_slot(context, mir_type(context, signature[i], function.source), "v_arg" + str(i), true)
        context.bindings.append(MirBinding { symbol: function.params[i], slot: slot })
    }
    let value = mir_block(context, function.body)
    if context.current >= 0 { mir_return(context, if returned == 1 { mir_constant(context, mir_literal_unit(), 1, function.source) } else { value }, function.source) }
    mir_finish(context, if function.closure { "wysna_" + function.name } else { mir_abi_name(function.name) }, function.source)
}

fn mir_build(program: CheckedProgram) -> MirModule {
    checked_verify(program)
    let context = new MirBuilder(program)
    for i in 0..len(program.bindings) {
        let binding = program.bindings[i]
        if binding.global { context.globals.append(MirGlobal { symbol: i, type_id: mir_type(context, binding.type_id, binding.source), name: "wysna_global_" + str(i) }) }
    }
    for signature in program.signatures { if signature.foreign { mir_add_extern(context, signature) } }
    for function in program.functions { mir_lower_function(context, function) }
    let source = program.source
    mir_begin(context, source, 1)
    let mut explicit_entry = -1
    let mut root_entry = false
    for id in program.entry {
        if module_normalize(program.nodes[id].source.file) == module_normalize(program.file) { root_entry = true }
        let value = mir_statement(context, id)
        explicit_entry = -1
        let node = program.nodes[id]
        if node.kind == "call" and node.text == "main" and node.target >= 0 and context.current >= 0 { explicit_entry = value }
    }
    if context.current >= 0 {
        let mut value = -1
        let main_index = checked_function(program, "main")
        if not root_entry and main_index >= 0 {
            let signature = program.types[program.signatures[main_index].type_id].args
            context.return_type = mir_type(context, signature[len(signature) - 1], source)
            value = mir_op(context, "call", context.return_type, [], "wysna_fn_main", mir_literal_unit(), source)
        } elif explicit_entry >= 0 { value = explicit_entry context.return_type = context.slots[value].type_id }
        else { value = mir_constant(context, mir_literal_unit(), 1, source) }
        mir_return(context, value, source)
    }
    mir_finish(context, "wysna_program", source)
    return MirModule { file: program.file, functions: context.functions, globals: context.globals, records: context.records, virtual_slots: context.virtual_slots, externs: context.externs, types: context.types, source: source }
}

fn mir_module_json(module: MirModule) -> str {
    mir_verify(module)
    let mut functions = "["
    for i in 0..len(module.functions) {
        if i > 0 { functions = functions + "," }
        functions = functions + mir_function_json(module.functions[i])
    }
    let mut globals = "["
    for i in 0..len(module.globals) {
        if i > 0 { globals = globals + "," }
        let global = module.globals[i]
        globals = globals + "{\"$type\":\"Slot\",\"id\":" + str(-i - 1) + ",\"type_id\":" + str(global.type_id) + ",\"name\":" + mir_quote(global.name) + ",\"storage\":\"value\",\"ownership\":\"global\",\"parameter\":false}"
    }
    globals = globals + "]"
    let mut enum_count = 0
    for record in module.records { if module.types[record.type_id].kind == "enum" { enum_count = enum_count + 1 } }
    let payload = "{\"$type\":\"Module\",\"file\":" + mir_quote(module.file) + ",\"arena_id\":\"compiler-native-core-v1\",\"functions\":" + functions + "],\"globals\":" + globals + ",\"layouts\":" + mir_layouts_json(module) + ",\"virtual_slots\":" + mir_virtual_slots_json(module) + ",\"externs\":" + mir_externs_json(module) + ",\"exports\":[],\"library_mode\":false,\"enum_count\":" + str(enum_count) + "}"
    return "{\"format\":\"wysna.mir\",\"schema_version\":1,\"semantic_revision\":\"0.5.0\",\"runtime_abi_version\":2,\"type_arena\":" + mir_arena_json(module) + ",\"module\":" + payload + "}\n"
}

fn emit_mir_module(src: str, file: str) -> str {
    return mir_module_json(mir_build(check_source(src, file)))
}
fn mir_verify_runtime(module: MirModule, operation: MirOperation, slots: list[MirSlot]) -> bool {
    let name = operation.name
    let returned = slots[operation.result].type_id
    if name == "wysna_empty_weak" { return len(operation.args) == 0 and module.types[returned].kind == "weak" }
    if name == "wysna_enum_payload_owned" {
        if len(operation.args) != 1 or len(operation.labels) != 2 { return false }
        let source = slots[operation.args[0]].type_id
        if module.types[source].kind != "enum" or module.types[source].name != operation.labels[0] { return false }
        let record = mir_find_record(module.records, source, operation.source)
        for variant in record.variants {
            if variant.name == operation.labels[1] {
                if len(variant.payloads) == 1 { return returned == variant.payloads[0] }
                return len(variant.payloads) > 1 and module.types[returned].kind == "tuple" and module.types[returned].args == variant.payloads
            }
        }
        return false
    }
    if len(operation.labels) > 0 and (name == "wysna_enum" or name == "wysna_enum_payload") {
        if len(operation.labels) != 2 or module.types[returned].kind != "enum" or module.types[returned].name != operation.labels[0] { return false }
        let record = mir_find_record(module.records, returned, operation.source)
        for variant in record.variants {
            if variant.name == operation.labels[1] {
                if len(variant.payloads) == 0 { return name == "wysna_enum" and len(operation.args) == 0 }
                if name != "wysna_enum_payload" or len(operation.args) != 1 { return false }
                let payload = slots[operation.args[0]].type_id
                if len(variant.payloads) == 1 { return payload == variant.payloads[0] }
                return module.types[payload].kind == "tuple" and module.types[payload].args == variant.payloads
            }
        }
        return false
    }
    if name == "wysna_builtin_print" or name == "wysna_builtin_eprint" { return returned == 1 }
    if name == "wysna_builtin_args" { return len(operation.args) == 0 and module.types[returned].kind == "list" and module.types[returned].args[0] == 5 }
    if name == "wysna_builtin_read_file" or name == "wysna_builtin_write_file" {
        let expected = if name == "wysna_builtin_read_file" { 1 } else { 2 }
        if len(operation.args) != expected or not mir_is_result(module.types, returned) { return false }
        for argument in operation.args { if slots[argument].type_id != 5 { return false } }
        let channel = module.types[returned].args
        return channel[0] == (if expected == 1 { 5 } else { 1 }) and module.types[channel[1]].kind == "struct" and module.types[channel[1]].name == "IoError"
    }
    if name == "wysna_builtin_slice" {
        return len(operation.args) == 3 and slots[operation.args[0]].type_id == returned and (returned == 5 or module.types[returned].kind == "list") and slots[operation.args[1]].type_id == 3 and slots[operation.args[2]].type_id == 3
    }
    if len(operation.args) == 1 {
        let argument = operation.args[0]
        let type_ = slots[argument].type_id
        if name == "wysna_builtin_weak_owned" { return module.types[type_].kind == "class" and module.types[returned].kind == "weak" and module.types[returned].args[0] == type_ }
        if name == "wysna_builtin_upgrade" { return module.types[type_].kind == "weak" and mir_is_optional(module.types, returned) and module.types[returned].args[0] == module.types[type_].args[0] }
        if name == "wysna_ok" or name == "wysna_err" {
            if not mir_is_result(module.types, returned) { return false }
            let channel = module.types[returned]
            return mir_compatible(module.types, module.records, type_, if name == "wysna_ok" { channel.args[0] } else { channel.args[1] })
        }
        if name == "wysna_unwrap_ok" or name == "wysna_unwrap_err" {
            if not mir_is_result(module.types, type_) { return false }
            let channel = module.types[type_]
            return returned == (if name == "wysna_unwrap_ok" { channel.args[0] } else { channel.args[1] })
        }
        if name == "wysna_enum_payload" { return mir_is_optional(module.types, returned) and module.types[returned].args[0] == type_ }
        if name == "wysna_unwrap_optional" { return mir_is_optional(module.types, type_) and module.types[type_].args[0] == returned }
        if name == "wysna_builtin_exit" { return type_ == 3 and returned == 1 }
        if name == "wysna_builtin_bytes" { return type_ == 5 and module.types[returned].kind == "list" and module.types[returned].args[0] == 3 }
        if name == "wysna_builtin_enumerate" or name == "wysna_builtin_dict_items" {
            let input = module.types[type_]
            let output = module.types[returned]
            if output.kind != "list" { return false }
            let pair = module.types[output.args[0]]
            if pair.kind != "tuple" or len(pair.args) != 2 { return false }
            if name == "wysna_builtin_enumerate" { return input.kind == "list" and pair.args == [3, input.args[0]] }
            return input.kind == "dict" and pair.args == input.args
        }
        if name == "wysna_builtin_str" { return returned == 5 }
        if name == "wysna_builtin_len" { let kind = module.types[type_].kind return returned == 3 and (type_ == 5 or kind == "list" or kind == "dict" or kind == "tuple") }
        if name == "wysna_builtin_ord" { return type_ == 5 and returned == 3 }
        if name == "wysna_dict_keys" or name == "wysna_dict_values" {
            let input = module.types[type_]
            let output = module.types[returned]
            return input.kind == "dict" and output.kind == "list" and output.args[0] == input.args[if name == "wysna_dict_keys" { 0 } else { 1 }]
        }
        if name == "wysna_builtin_chr" { return type_ == 3 and returned == 5 }
        if name == "wysna_neg" { return type_ == returned and (type_ == 3 or type_ == 4) }
        if name == "wysna_not" { return type_ == 2 and returned == 2 }
        if name == "wysna_builtin_int" { return type_ >= 2 and type_ <= 6 and returned == 3 }
        if name == "wysna_builtin_float" { return type_ >= 2 and type_ <= 6 and returned == 4 }
        return false
    }
    if len(operation.args) != 2 { return false }
    let first = slots[operation.args[0]].type_id
    let second = slots[operation.args[1]].type_id
    if name == "wysna_index_get_owned_at" {
        if first == 5 { return second == 3 and returned == 5 }
        let input = module.types[first]
        if input.kind == "list" { return second == 3 and returned == input.args[0] }
        if input.kind == "dict" { return second == input.args[0] and returned == input.args[1] }
        return false
    }
    if name == "wysna_make_range" or name == "wysna_make_range_inclusive" { return first == 3 and second == 3 and module.types[returned].kind == "list" and module.types[returned].args[0] == 3 }
    if name == "wysna_dict_get" {
        let input = module.types[first]
        let output = module.types[returned]
        return input.kind == "dict" and second == input.args[0] and output.kind == "optional" and output.args[0] == input.args[1]
    }
    if name == "wysna_builtin_join_strings" { return module.types[first].kind == "list" and module.types[first].args[0] == 5 and second == 5 and returned == 5 }
    if name == "wysna_equal" or name == "wysna_not_equal" { return returned == 2 and mir_equality(module, first, second) }
    if first != second or mir_is_result(module.types, first) { return false }
    if name == "wysna_add" and first == 5 { return returned == 5 }
    if name == "wysna_equal" or name == "wysna_not_equal" { return returned == 2 }
    if first != 3 and first != 4 { return false }
    if name == "wysna_lt" or name == "wysna_le" or name == "wysna_gt" or name == "wysna_ge" { return returned == 2 }
    if name == "wysna_mod_at" { return first == 3 and returned == 3 }
    return returned == first and (name == "wysna_add" or name == "wysna_sub" or name == "wysna_mul" or name == "wysna_div_at")
}

# Validate structure before indexed access, then solve definite initialization and cleanup.
fn mir_verify_shape(module: MirModule, function: MirFunction) {
    if not mir_valid_type(module.types, function.return_type) or len(function.blocks) == 0 { report_error_at("W9999", function.source, "invalid MIR function signature or entry") }
    let mut parameters: list[bool] = []
    for slot in function.slots {
        if not mir_valid_type(module.types, slot.type_id) { report_error_at("W9999", function.source, "invalid MIR slot type") }
        if slot.predicate and (slot.type_id != 2 or slot.parameter) { report_error_at("W9999", function.source, "invalid MIR predicate storage") }
        if slot.counter and (slot.type_id != 3 or slot.parameter) { report_error_at("W9999", function.source, "invalid MIR counter storage") }
        parameters.append(false)
    }
    for parameter in function.params {
        if parameter < 0 or parameter >= len(function.slots) { report_error_at("W9999", function.source, "invalid MIR parameter") }
        if parameters[parameter] { report_error_at("W9999", function.source, "duplicate MIR parameter") }
        parameters[parameter] = true
    }
    for i in 0..len(function.slots) {
        if parameters[i] != function.slots[i].parameter { report_error_at("W9999", function.source, "invalid MIR parameter ownership") }
    }
    for block in function.blocks {
        for operation in block.operations {
            for arg in operation.args {
                if arg < 0 or arg >= len(function.slots) { report_error_at("W9999", operation.source, "invalid MIR operand") }
            }
            if operation.opcode == "set_vtable" {
                if operation.result != -1 or len(operation.args) != 1 { report_error_at("W9999", operation.source, "invalid MIR vtable shape") }
                let type_id = function.slots[operation.args[0]].type_id
                if type_id != operation.owner_type or module.types[type_id].kind != "class" or module.types[type_id].name != operation.name { report_error_at("W9999", operation.source, "MIR vtable does not match object") }
            } elif operation.opcode == "store_place" {
                let target = mir_place_type(module, function, operation.place, operation.source)
                if operation.result != -1 or len(operation.args) != 1 { report_error_at("W9999", operation.source, "invalid MIR place store") }
                let value = function.slots[operation.args[0]]
                if value.parameter or value.type_id != target { report_error_at("W9999", operation.source, "invalid MIR place store type or ownership") }
            } elif operation.opcode == "global_store" {
                let global = operation.value.integer
                if operation.result != -1 or len(operation.args) != 1 or global < 0 or global >= len(module.globals) { report_error_at("W9999", operation.source, "invalid MIR global store") }
                let value = function.slots[operation.args[0]]
                if value.parameter or value.type_id != module.globals[global].type_id { report_error_at("W9999", operation.source, "invalid MIR global store type or ownership") }
            } elif operation.opcode == "release" {
                if operation.result != -1 or len(operation.args) != 1 { report_error_at("W9999", operation.source, "invalid MIR release shape") }
                let slot = function.slots[operation.args[0]]
                if slot.parameter or not mir_value_storage(slot.type_id) { report_error_at("W9999", operation.source, "invalid MIR release") }
            } else {
                let result = operation.result
                if result < 0 or result >= len(function.slots) { report_error_at("W9999", operation.source, "invalid MIR result") }
                if function.slots[result].parameter { report_error_at("W9999", operation.source, "MIR overwrites borrowed storage") }
                let type_ = function.slots[result].type_id
                let mut valid = false
                if operation.opcode == "default" {
                    valid = len(operation.args) == 0 and (type_ <= 5 and operation.value.type_id == type_ or type_ >= 6 and operation.value.type_id == 6)
                }
                elif operation.opcode == "const" { valid = len(operation.args) == 0 and (operation.value.type_id == type_ and type_ <= 6 or operation.value.type_id == 6 and mir_is_optional(module.types, type_)) }
                elif operation.opcode == "clone" or operation.opcode == "store" {
                    valid = len(operation.args) == 1
                    if valid {
                        let argument = operation.args[0]
                        valid = mir_compatible(module.types, module.records, function.slots[argument].type_id, type_)
                        if operation.opcode == "store" { valid = valid and not function.slots[argument].parameter and argument != result }
                    }
                } elif operation.opcode == "construct" {
                    let descriptor = module.types[type_]
                    valid = (descriptor.kind == operation.name or descriptor.kind == "class" and operation.name == "object") and (descriptor.kind == "list" or descriptor.kind == "dict" or descriptor.kind == "tuple" or descriptor.kind == "struct" or descriptor.kind == "class")
                    let mut fields: list[MirField] = []
                    if valid and (descriptor.kind == "struct" or descriptor.kind == "class") {
                        let record = mir_find_record(module.records, type_, operation.source)
                        fields = record.fields
                        valid = operation.value.integer == type_ and len(operation.args) == len(fields)
                    }
                    if valid and descriptor.kind == "dict" and len(operation.args) % 2 != 0 { valid = false }
                    if valid and descriptor.kind == "tuple" and len(operation.args) != len(descriptor.args) { valid = false }
                    if valid {
                        for i in 0..len(operation.args) {
                            let expected = if descriptor.kind == "list" { descriptor.args[0] } elif descriptor.kind == "dict" { descriptor.args[i % 2] } elif descriptor.kind == "struct" or descriptor.kind == "class" { fields[i].type_id } else { descriptor.args[i] }
                            if function.slots[operation.args[i]].type_id != expected { valid = false }
                        }
                    }
                } elif operation.opcode == "load_field" {
                    valid = len(operation.args) == 1
                    if valid {
                        let owner = function.slots[operation.args[0]].type_id
                        let record = mir_find_record(module.records, owner, operation.source)
                        let index = operation.value.integer
                        valid = owner == operation.owner_type and index >= 0 and index < len(record.fields)
                        if valid { valid = record.fields[index].type_id == type_ }
                    }
                } elif operation.opcode == "tuple_get" {
                    valid = len(operation.args) == 1
                    if valid {
                        let descriptor = module.types[function.slots[operation.args[0]].type_id]
                        let index = operation.value.integer
                        valid = descriptor.kind == "tuple" and index >= 0 and index < len(descriptor.args)
                        if valid { valid = descriptor.args[index] == type_ }
                    }
                } elif operation.opcode == "test" { valid = mir_verify_test(module, operation, function.slots) }
                elif operation.opcode == "narrow" {
                    valid = len(operation.args) == 1
                    if valid {
                        let input = module.types[function.slots[operation.args[0]].type_id]
                        valid = input.kind == "error_union"
                        let mut member = false
                        for alternative in input.args { if alternative == type_ { member = true } }
                        valid = valid and member and operation.value.integer >= 0 and operation.value.integer < len(function.slots)
                        if valid { valid = function.slots[operation.value.integer].predicate }
                    }
                } elif operation.opcode == "counter" { valid = type_ == 3 and function.slots[result].counter and len(operation.args) == 0 }
                elif operation.opcode == "increment" {
                    valid = type_ == 3 and function.slots[result].counter and len(operation.args) == 1
                    if valid { valid = function.slots[operation.args[0]].counter }
                } elif operation.opcode == "range_count" {
                    valid = type_ == 3 and function.slots[result].counter and len(operation.args) == 2
                    if valid { valid = function.slots[operation.args[0]].type_id == 3 and function.slots[operation.args[1]].type_id == 3 }
                } elif operation.opcode == "iterate_test" or operation.opcode == "iterate_value" {
                    valid = len(operation.args) == 2
                    if valid {
                        let counter = operation.args[if operation.opcode == "iterate_test" { 0 } else { 1 }]
                        let iterable = operation.args[if operation.opcode == "iterate_test" { 1 } else { 0 }]
                        valid = function.slots[counter].counter
                        let iterable_type = function.slots[iterable].type_id
                        let descriptor = module.types[iterable_type]
                        if operation.value.boolean { valid = valid and iterable_type == 3 }
                        else { valid = valid and descriptor.kind == "list" }
                        if operation.opcode == "iterate_test" { valid = valid and type_ == 2 and function.slots[result].predicate }
                        elif valid { valid = type_ == (if operation.value.boolean { 3 } else { descriptor.args[0] }) }
                    }
                } elif operation.opcode == "mutate" {
                    let target = mir_place_type(module, function, operation.place, operation.source)
                    let descriptor = module.types[target]
                    if descriptor.kind == "list" {
                        if operation.name == "pop" { valid = type_ == descriptor.args[0] and len(operation.args) == 0 }
                        elif operation.name == "clear" { valid = type_ == 1 and len(operation.args) == 0 }
                        elif operation.name == "append" { valid = type_ == 1 and len(operation.args) == 1 if valid { valid = function.slots[operation.args[0]].type_id == descriptor.args[0] } }
                    }
                } elif operation.opcode == "global_load" {
                    let global = operation.value.integer
                    valid = len(operation.args) == 0 and global >= 0 and global < len(module.globals)
                    if valid { valid = module.globals[global].type_id == type_ }
                } elif operation.opcode == "runtime" { valid = mir_verify_runtime(module, operation, function.slots) }
                elif operation.opcode == "function" or operation.opcode == "indirect" { valid = mir_verify_function_value(module, operation, function.slots) }
                elif operation.opcode == "virtual" { valid = mir_verify_virtual(module, operation, function.slots) }
                elif operation.opcode == "call" {
                    for external in module.externs {
                        if external.name == operation.name and len(external.params) == len(operation.args) and external.return_type == type_ {
                            valid = true
                            for i in 0..len(external.params) { if function.slots[operation.args[i]].type_id != external.params[i] { valid = false } }
                        }
                    }
                    for callee in module.functions {
                        if callee.name == operation.name and len(callee.params) == len(operation.args) and callee.return_type == type_ {
                            valid = true
                            for i in 0..len(callee.params) {
                                if not mir_compatible(module.types, module.records, function.slots[operation.args[i]].type_id, callee.slots[callee.params[i]].type_id) { valid = false }
                            }
                        }
                    }
                }
                if not valid { report_error_at("W9999", operation.source, "invalid typed MIR operation") }
                if mir_consumes(operation) and function.slots[operation.args[0]].parameter { report_error_at("W9999", operation.source, "MIR consumes borrowed storage") }
            }
        }
        let term = block.terminator
        let mut arity = -1
        if term.kind == "goto" { arity = 1 }
        elif term.kind == "branch" { arity = 2 }
        elif term.kind == "return" or term.kind == "unreachable" { arity = 0 }
        if arity < 0 or len(term.targets) != arity { report_error_at("W9999", term.source, "invalid MIR terminator") }
        for target in term.targets {
            if target < 0 or target >= len(function.blocks) { report_error_at("W9999", term.source, "invalid MIR branch target") }
        }
        if term.kind == "branch" or term.kind == "return" {
            if term.value < 0 or term.value >= len(function.slots) { report_error_at("W9999", term.source, "invalid MIR terminator value") }
            let slot = function.slots[term.value]
            if term.kind == "branch" and slot.type_id != 2 { report_error_at("W9999", term.source, "MIR branch requires bool") }
            if term.kind == "return" and (slot.type_id != function.return_type or slot.parameter) { report_error_at("W9999", term.source, "invalid MIR return type or ownership") }
        } elif term.value != -1 { report_error_at("W9999", term.source, "unexpected MIR terminator value") }
    }
}

struct MirGuard { predicate: int, value: int, dependencies: list[int], kind: str, target: int, labels: list[str] }

fn mir_forget_facts(facts: list[int], value: int, guards: list[MirGuard]) -> list[int] {
    let mut next = facts
    next[value] = 0
    for guard in guards { for dependency in guard.dependencies { if dependency == value { next[guard.predicate] = 0 } } }
    return next
}

fn mir_verify_flow(module: MirModule, function: MirFunction) {
    let mut initial: list[bool] = []
    let mut empty: list[bool] = []
    let mut unknown: list[int] = []
    let mut definitions: list[int] = []
    for slot in function.slots { initial.append(slot.parameter) empty.append(false) unknown.append(0) definitions.append(0) }
    for block in function.blocks { for operation in block.operations { if operation.result >= 0 { definitions[operation.result] = definitions[operation.result] + 1 } } }
    let mut guards: list[MirGuard] = []
    for block in function.blocks {
        for operation in block.operations {
            if operation.opcode == "test" and definitions[operation.result] == 1 { guards.append(MirGuard { predicate: operation.result, value: operation.args[0], dependencies: operation.args, kind: operation.name, target: operation.owner_type, labels: operation.labels }) }
        }
    }
    let mut states: list[MirState] = []
    for block in function.blocks { states.append(MirState { seen: false, defined: empty, live: empty, facts: unknown }) }
    states[0] = MirState { seen: true, defined: initial, live: empty, facts: unknown }
    let mut work: list[int] = [0]
    let mut cursor = 0
    while cursor < len(work) {
        let index = work[cursor]
        cursor = cursor + 1
        let mut defined = states[index].defined
        let mut live = states[index].live
        let mut facts = states[index].facts
        let block = function.blocks[index]
        for operation in block.operations {
            if operation.opcode == "release" {
                defined[operation.args[0]] = false
                live[operation.args[0]] = false
                facts = mir_forget_facts(facts, operation.args[0], guards)
            } else {
                if operation.opcode == "store_place" or operation.opcode == "mutate" {
                    let place = operation.place
                    if place.root >= 0 and not defined[place.root] { report_error_at("W9999", operation.source, "uninitialized MIR place root") }
                    for projection in place.projections { if projection.kind == "index" and not defined[projection.index] { report_error_at("W9999", operation.source, "uninitialized MIR place index") } }
                }
                for arg in operation.args {
                    if not defined[arg] { report_error_at("W9999", operation.source, "uninitialized or consumed MIR operand") }
                }
                if operation.opcode == "runtime" and (operation.name == "wysna_unwrap_ok" or operation.name == "wysna_unwrap_err" or operation.name == "wysna_unwrap_optional") {
                    let required = if operation.name == "wysna_unwrap_err" { 1 } else { 2 }
                    let mut proven = false
                    for guard in guards { if guard.value == operation.args[0] and facts[guard.predicate] == required and guard.kind == (if operation.name == "wysna_unwrap_optional" { "none" } else { "err" }) { proven = true } }
                    if not proven { report_error_at("W9999", operation.source, "MIR payload lacks a dominating channel test") }
                }
                if operation.opcode == "narrow" {
                    let mut proven = false
                    for guard in guards { if guard.predicate == operation.value.integer and guard.value == operation.args[0] and guard.kind == "error_type" and guard.target == function.slots[operation.result].type_id and facts[guard.predicate] == 1 { proven = true } }
                    if not proven { report_error_at("W9999", operation.source, "MIR narrowing lacks a dominating type test") }
                }
                if operation.opcode == "runtime" and operation.name == "wysna_enum_payload_owned" {
                    let mut proven = false
                    for guard in guards { if guard.value == operation.args[0] and guard.kind == "variant" and guard.labels == operation.labels and facts[guard.predicate] == 1 { proven = true } }
                    if not proven { report_error_at("W9999", operation.source, "MIR enum payload lacks a dominating variant test") }
                }
                if mir_consumes(operation) {
                    defined[operation.args[0]] = false
                    live[operation.args[0]] = false
                    facts = mir_forget_facts(facts, operation.args[0], guards)
                }
                if operation.result >= 0 {
                    defined[operation.result] = true
                    live[operation.result] = mir_value_storage(function.slots[operation.result].type_id)
                    facts = mir_forget_facts(facts, operation.result, guards)
                }
            }
        }
        let term = block.terminator
        if term.kind == "return" or term.kind == "branch" {
            if not defined[term.value] { report_error_at("W9999", term.source, "uninitialized MIR terminator value") }
        }
        if term.kind == "return" {
            live[term.value] = false
            for owned in live { if owned { report_error_at("W9999", term.source, "MIR return leaks owned storage") } }
        }
        for edge in 0..len(term.targets) {
            let target = term.targets[edge]
            let previous = states[target]
            let mut next_defined = defined
            let mut next_live = live
            let mut next_facts = facts
            if term.kind == "branch" { next_facts[term.value] = if edge == 0 { 1 } else { 2 } }
            let mut changed = not previous.seen
            if previous.seen {
                for i in 0..len(defined) {
                    next_defined[i] = previous.defined[i] and defined[i]
                    next_live[i] = previous.live[i] or live[i]
                    if previous.facts[i] != next_facts[i] { next_facts[i] = 0 }
                    if next_defined[i] != previous.defined[i] or next_live[i] != previous.live[i] or next_facts[i] != previous.facts[i] { changed = true }
                }
            }
            if changed {
                states[target] = MirState { seen: true, defined: next_defined, live: next_live, facts: next_facts }
                work.append(target)
            }
        }
    }
}

fn mir_verify(module: MirModule) {
    let primitive_names: list[str] = ["error", "unit", "bool", "int", "float", "str", "none"]
    if len(module.types) < 7 { report_error_at("W9999", module.source, "incomplete MIR type arena") }
    for i in 0..len(module.types) {
        let type_ = module.types[i]
        if i < 7 {
            if type_.kind != primitive_names[i] or type_.name != "" or len(type_.args) != 0 { report_error_at("W9999", module.source, "invalid reserved MIR type") }
        } else {
            let count = len(type_.args)
            let kind = type_.kind
            let nominal = (kind == "struct" or kind == "enum" or kind == "class" or kind == "interface") and count == 0 and type_.name != ""
            let valid = nominal or (kind == "opaque" or kind == "any") and count == 0 or kind == "function" and count >= 1 or kind == "tuple" or (kind == "optional" or kind == "weak" or kind == "list") and count == 1 or (kind == "result" or kind == "dict") and count == 2 or kind == "error_union" and count >= 2
            if not valid or not nominal and type_.name != "" { report_error_at("W9999", module.source, "invalid MIR type shape") }
            for child in type_.args { if child <= 0 or child >= i { report_error_at("W9999", module.source, "invalid or cyclic MIR type reference") } }
            if kind == "weak" and module.types[type_.args[0]].kind != "class" { report_error_at("W9999", module.source, "MIR weak target must be a class") }
            for j in 7..i { if module.types[j].kind == kind and module.types[j].name == type_.name and module.types[j].args == type_.args { report_error_at("W9999", module.source, "duplicate MIR type") } }
        }
    }
    mir_verify_externs(module)
    mir_verify_records(module)
    for global in module.globals { if not mir_identifier(global.name) or not mir_valid_type(module.types, global.type_id) { report_error_at("W9999", module.source, "invalid MIR global type") } }
    let mut names: list[str] = []
    let mut entry = false
    # Validate every signature first so call validation cannot index malformed callees.
    for function in module.functions {
        for name in names { if name == function.name { report_error_at("W9999", function.source, "duplicate MIR function") } }
        if not mir_identifier(function.name) { report_error_at("W9999", function.source, "invalid MIR function ABI identifier") }
        names.append(function.name)
        if function.name == "wysna_program" { entry = true }
        for parameter in function.params {
            if parameter < 0 or parameter >= len(function.slots) { report_error_at("W9999", function.source, "invalid MIR parameter") }
        }
    }
    if not entry { report_error_at("W9999", module.source, "missing MIR program entry") }
    for function in module.functions { mir_verify_shape(module, function) }
    for function in module.functions { mir_verify_flow(module, function) }
}
# C99 literal encoding is independent of source parsing and checking.
fn escape_c_str(s: str) -> str {
    let mut out = "\""
    let n = len(s)
    for i in 0..n {
        let ch = s[i]
        let code = ord(ch)
        if code == 34 {
            out = out + "\\\""
        } elif code == 92 {
            out = out + "\\\\"
        } elif code == 10 {
            out = out + "\\n"
        } elif code == 13 {
            out = out + "\\r"
        } elif code == 9 {
            out = out + "\\t"
        } elif code == 0 {
            out = out + "\\000"
        } elif code == 63 {
            out = out + "\\077"
        } else {
            out = out + ch
        }
    }
    out = out + "\""
    return out
}
# C99 consumes verified MIR only; it never reads source tokens or semantic state.
fn mir_c_type(type_id: int) -> str {
    if type_id == 2 { return "bool" }
    if type_id == 3 { return "int64_t" }
    if type_id == 4 { return "double" }
    return "WVal"
}
fn mir_c_name(id: int) -> str { return "_m" + str(id) }
fn mir_c_box(value: str, type_id: int) -> str {
    if type_id == 2 { return "wysna_bool(" + value + ")" }
    if type_id == 3 { return "wysna_int(" + value + ")" }
    if type_id == 4 { return "wysna_float(" + value + ")" }
    return value
}
fn mir_c_unbox(value: str, type_id: int) -> str {
    if type_id == 2 { return "(" + value + ").as.b" }
    if type_id == 3 { return "(" + value + ").as.i" }
    if type_id == 4 { return "(" + value + ").as.f" }
    return value
}
fn mir_c_value(function: MirFunction, id: int, move: bool) -> str {
    let name = mir_c_name(id)
    if mir_value_storage(function.slots[id].type_id) {
        if move { return "wysna_move(&" + name + ")" }
        return name
    }
    return mir_c_box(name, function.slots[id].type_id)
}
fn mir_c_write(function: MirFunction, id: int, value: str, boxed: bool) -> str {
    let slot = function.slots[id]
    let name = mir_c_name(id)
    if mir_value_storage(slot.type_id) { return "wysna_assign(&" + name + ", " + value + ");" }
    return name + " = " + (if boxed { mir_c_unbox(value, slot.type_id) } else { value }) + ";"
}
fn mir_c_array(values: list[str]) -> str {
    if len(values) == 0 { return "NULL" }
    let mut out = "(WVal[]){"
    for i in 0..len(values) { if i > 0 { out = out + ", " } out = out + values[i] }
    return out + "}"
}
fn mir_c_signature(function: MirFunction) -> str {
    let mut out = "static " + mir_c_type(function.return_type) + " " + function.name + "("
    if len(function.params) == 0 { out = out + "void" }
    for i in 0..len(function.params) {
        if i > 0 { out = out + ", " }
        let id = function.params[i]
        out = out + mir_c_type(function.slots[id].type_id) + " " + mir_c_name(id)
    }
    return out + ")"
}
fn mir_c_operation(module: MirModule, function: MirFunction, operation: MirOperation) -> str {
    let kind = operation.opcode
    let result = operation.result
    let mut arguments: list[str] = []
    for i in 0..len(operation.args) { arguments.append(mir_c_value(function, operation.args[i], mir_consumes(operation) and i == 0)) }
    if kind == "function" {
        let environment = if len(arguments) > 0 { arguments[0] } else { "wysna_unit()" }
        return mir_c_write(function, result, "wysna_function_new(wysna_adapter_" + operation.name + ", " + environment + ")", true)
    }
    if kind == "indirect" {
        let mut parameters: list[str] = []
        for i in 1..len(arguments) { parameters.append(arguments[i]) }
        return mir_c_write(function, result, "wysna_call(" + arguments[0] + ", " + str(len(parameters)) + ", " + mir_c_array(parameters) + ")", true)
    }
    if kind == "global_load" {
        let global = module.globals[operation.value.integer]
        let value = if mir_value_storage(global.type_id) { "wysna_clone(" + global.name + ")" } else { global.name }
        return mir_c_write(function, result, value, true)
    }
    if kind == "global_store" { return "wysna_assign(&" + module.globals[operation.value.integer].name + ", " + arguments[0] + ");" }
    if kind == "store_place" {
        let place = operation.place
        if place.root >= 0 and len(place.projections) == 0 and not mir_value_storage(function.slots[place.root].type_id) { return mir_c_write(function, place.root, arguments[0], true) }
        return "wysna_assign(" + mir_c_place(module, function, place) + ", " + arguments[0] + ");"
    }
    if kind == "mutate" {
        let reference = mir_c_place(module, function, operation.place)
        let mut call = "wysna_list_" + operation.name + "(" + reference
        if operation.name == "pop" { call = "wysna_list_pop_at(" + reference + ", " + escape_c_str(operation.source.file) + ", " + str(operation.source.line) + ", " + str(operation.source.col) }
        for argument in arguments { call = call + ", " + argument }
        return mir_c_write(function, result, call + ")", true)
    }
    if kind == "virtual" {
        let mut values: list[str] = []
        for i in 1..len(arguments) { values.append(arguments[i]) }
        return mir_c_write(function, result, "wysna_virtual_call(" + arguments[0] + ", " + str(operation.value.integer) + ", " + str(len(values)) + ", " + mir_c_array(values) + ")", true)
    }
    if kind == "set_vtable" { return "(" + arguments[0] + ").as.st->vtable = &wysna_vtable_" + operation.name + ";" }
    if kind == "const" or kind == "default" {
        let literal = operation.value
        let mut value = if literal.type_id == 6 { "wysna_none()" } else { "wysna_unit()" }
        if literal.type_id == 2 { value = "wysna_bool(" + str(literal.boolean) + ")" }
        elif literal.type_id == 3 {
            let integer = if literal.integer == -9223372036854775808 { "(-9223372036854775807LL - 1LL)" } else { str(literal.integer) + "LL" }
            value = "wysna_int(" + integer + ")"
        } elif literal.type_id == 4 { value = "wysna_float(" + str(literal.floating) + ")" }
        elif literal.type_id == 5 {
            value = "wysna_literal_str_n(&_literal, " + escape_c_str(literal.text) + ", " + str(len(bytes(literal.text))) + ")"
            return "{ static WStringLiteral _literal = {0}; " + mir_c_write(function, result, value, true) + " }"
        }
        return mir_c_write(function, result, value, true)
    }
    if kind == "clone" or kind == "narrow" {
        let value = if mir_value_storage(function.slots[result].type_id) { "wysna_clone(" + arguments[0] + ")" } else { arguments[0] }
        return mir_c_write(function, result, value, true)
    }
    if kind == "store" { return mir_c_write(function, result, arguments[0], true) }
    if kind == "release" {
        let name = mir_c_name(operation.args[0])
        return "wysna_release(" + name + "); " + name + " = wysna_unit();"
    }
    if kind == "counter" { return mir_c_write(function, result, "0", false) }
    if kind == "increment" { return mir_c_write(function, result, mir_c_name(operation.args[0]) + " + 1", false) }
    if kind == "range_count" { return mir_c_write(function, result, "wysna_range_count(" + arguments[0] + ", " + arguments[1] + ", " + str(operation.value.boolean) + ")", false) }
    if kind == "iterate_test" {
        let bound = if operation.value.boolean { mir_c_name(operation.args[1]) } else { "wysna_list_iteration_length_at(" + arguments[1] + ", " + escape_c_str(operation.source.file) + ", " + str(operation.source.line) + ", " + str(operation.source.col) + ")" }
        return mir_c_write(function, result, mir_c_name(operation.args[0]) + " < " + bound, false)
    }
    if kind == "iterate_value" {
        let counter = mir_c_name(operation.args[1])
        let mut value = "wysna_int((" + arguments[0] + ").as.i + (int64_t)" + counter + ")"
        if not operation.value.boolean {
            value = "wysna_list_iteration_get_owned_at(" + arguments[0] + ", " + counter + ", " + escape_c_str(operation.source.file) + ", " + str(operation.source.line) + ", " + str(operation.source.col) + ")"
        }
        return mir_c_write(function, result, value, true)
    }
    if kind == "construct" {
        let category = operation.name
        let mut value = "wysna_make_" + category + "(" + str(len(arguments)) + ", " + mir_c_array(arguments) + ")"
        if category == "struct" or category == "object" {
            let record = mir_find_record(module.records, operation.value.integer, operation.source)
            let mut keys = "(const char*[]){"
            for i in 0..len(record.fields) { if i > 0 { keys = keys + ", " } keys = keys + escape_c_str(record.fields[i].name) }
            keys = if len(record.fields) == 0 { "NULL" } else { keys + "}" }
            value = "wysna_make_" + category + "(" + escape_c_str(module.types[record.type_id].name) + ", " + str(len(arguments)) + ", " + keys + ", " + mir_c_array(arguments) + ")"
        }
        if category == "dict" {
            let mut keys: list[str] = []
            let mut values: list[str] = []
            for i in 0..len(arguments) { if i % 2 == 0 { keys.append(arguments[i]) } else { values.append(arguments[i]) } }
            value = "wysna_make_dict(" + str(len(keys)) + ", " + mir_c_array(keys) + ", " + mir_c_array(values) + ")"
        }
        return mir_c_write(function, result, value, true)
    }
    if kind == "load_field" {
        let value = "wysna_field_get_at(" + arguments[0] + ", " + str(operation.value.integer) + ")"
        return mir_c_write(function, result, if mir_value_storage(function.slots[result].type_id) { "wysna_clone(" + value + ")" } else { value }, true)
    }
    if kind == "tuple_get" {
        let value = "wysna_tuple_get_owned_at(" + arguments[0] + ", " + str(operation.value.integer) + ", " + escape_c_str(operation.source.file) + ", " + str(operation.source.line) + ", " + str(operation.source.col) + ")"
        return mir_c_write(function, result, value, true)
    }
    if kind == "test" {
        let name = operation.name
        let value = "(" + arguments[0] + ")"
        let mut condition = value + ".tag == W_ERR"
        if name == "none" { condition = "wysna_is_none(" + value + ")" }
        elif name == "equal" { condition = "wysna_eq(" + arguments[0] + ", " + arguments[1] + ")" }
        elif name == "tuple" { condition = "(" + value + ".tag == W_TUPLE && " + value + ".as.tuple->len == " + str(operation.value.integer) + ")" }
        elif name == "variant" { condition = "wysna_is_enum_variant(" + value + ", " + escape_c_str(operation.labels[0]) + ", " + escape_c_str(operation.labels[1]) + ")" }
        elif name == "error_type" { condition = "wysna_value_is_error_type(" + value + ", " + escape_c_str(operation.labels[0]) + ", " + escape_c_str(operation.labels[1]) + ")" }
        return mir_c_write(function, result, condition, false)
    }
    if kind == "runtime" or kind == "call" {
        let name = if operation.name == "wysna_make_range_inclusive" { "wysna_make_range" } else { operation.name }
        if name == "wysna_enum" or name == "wysna_enum_payload" {
            let labels = if len(operation.labels) == 2 { operation.labels } else { ["Option", "Some"] }
            let mut prefixed: list[str] = [escape_c_str(labels[0]), escape_c_str(labels[1])]
            for argument in arguments { prefixed.append(argument) }
            arguments = prefixed
        }
        if name == "wysna_make_range" { arguments.append(str(operation.name == "wysna_make_range_inclusive")) }
        let mut boxed = true
        if kind == "call" {
            let mut found = false
            for callee in module.functions {
                if callee.name == name {
                    found = true
                    boxed = mir_value_storage(callee.return_type)
                    for i in 0..len(arguments) { arguments[i] = mir_c_unbox(arguments[i], callee.slots[callee.params[i]].type_id) }
                }
            }
            for external in module.externs { if external.name == name { found = true boxed = true } }
            if not found { report_error_at("W9999", operation.source, "verified MIR call target missing during C99 emission") }
        } elif name == "wysna_builtin_print" or name == "wysna_builtin_eprint" { arguments = [str(len(arguments)), mir_c_array(arguments)] }
        if name == "wysna_div_at" or name == "wysna_mod_at" or name == "wysna_index_get_owned_at" {
            arguments.append(escape_c_str(operation.source.file))
            arguments.append(str(operation.source.line))
            arguments.append(str(operation.source.col))
        }
        let mut value = name + "("
        for i in 0..len(arguments) { if i > 0 { value = value + ", " } value = value + arguments[i] }
        value = value + ")"
        return mir_c_write(function, result, value, boxed)
    }
    report_error_at("W9999", operation.source, "verified MIR operation missing during C99 emission")
    return ""
}
fn mir_c_function(module: MirModule, function: MirFunction) -> str {
    let mut parts: list[str] = [mir_c_signature(function) + " {\n"]
    for i in 0..len(function.slots) {
        let slot = function.slots[i]
        if not slot.parameter { parts.append("    " + mir_c_type(slot.type_id) + " " + mir_c_name(i) + " = " + (if mir_value_storage(slot.type_id) { "wysna_unit()" } else { "0" }) + ";\n") }
    }
    parts.append("    goto bb0;\n")
    for i in 0..len(function.blocks) {
        let block = function.blocks[i]
        parts.append("bb" + str(i) + ":;\n")
        for operation in block.operations { parts.append("    " + mir_c_operation(module, function, operation) + "\n") }
        let term = block.terminator
        if term.kind == "goto" { parts.append("    goto bb" + str(term.targets[0]) + ";\n") }
        elif term.kind == "branch" { parts.append("    if (" + mir_c_name(term.value) + ") goto bb" + str(term.targets[0]) + "; else goto bb" + str(term.targets[1]) + ";\n") }
        elif term.kind == "return" { parts.append("    return " + mir_c_unbox(mir_c_value(function, term.value, true), function.return_type) + ";\n") }
        else { parts.append("    wysna_runtime_fail(\"W9999\", \"Unreachable MIR block executed\");\n") }
    }
    parts.append("}\n")
    return join_strings(parts, "")
}
fn mir_emit_c(module: MirModule) -> str {
    mir_verify(module)
    let mut parts: list[str] = []
    for external in module.externs { if external.native == "wysna_host_http_request" { parts.append("#define WYSNA_HAS_HTTP 1\n") } }
    parts.append("#include \"runtime/wysna_runtime.h\"\n/* Verified Compiler MIR: explicit CFG and ownership. */\n")
    for record in module.records { if module.types[record.type_id].kind == "class" { parts.append("static const WClassVTable wysna_vtable_" + module.types[record.type_id].name + ";\n") } }
    for global in module.globals { parts.append("static WVal " + global.name + ";\n") }
    for function in module.functions { parts.append(mir_c_signature(function) + ";\n") }
    parts.append(mir_c_externs(module))
    parts.append(mir_c_function_adapters(module))
    for function in module.functions { parts.append(mir_c_function(module, function)) }
    parts.append(mir_c_vtables(module))
    let mut returned = 1
    for function in module.functions { if function.name == "wysna_program" { returned = function.return_type } }
    parts.append("int main(int argc, char** argv) {\n    wysna_init_args(argc, argv);\n    WVal result = " + mir_c_box("wysna_program()", returned) + ";\n")
    parts.append("    int status = 0;\n    if (result.tag == W_ERR) { wysna_report_entrypoint_error(result.as.box->val); status = 1; }\n    wysna_release(result);\n")
    for global in module.globals { parts.append("    wysna_release(" + global.name + ");\n") }
    parts.append("    wysna_runtime_cleanup();\n    return status;\n}\n")
    return join_strings(parts, "")
}
fn run_compiler() -> unit ! IoError {
    let raw_cli = args()
    let mut cli = raw_cli
    if len(raw_cli) > 1 and raw_cli[1] == "--stdlib-root" {
        if len(raw_cli) < 5 { eprint("[W5002] Missing SDK compiler arguments") exit(2) }
        cli = [raw_cli[0]]
        for index in 3..len(raw_cli) { cli.append(raw_cli[index]) }
    }
    if len(cli) > 1 and (cli[1] == "--emit-mir" or cli[1] == "--emit-c-mir" or cli[1] == "--check-mir") {
        if (len(cli) != 3 and len(cli) != 4) or cli[1] == "--check-mir" and len(cli) != 3 {
            eprint("[W5002] Usage: Wysna Compiler --emit-mir INPUT")
            exit(2)
        }
        let source = read_file(cli[2])?
        let module = mir_build(check_source(source, cli[2]))
        if cli[1] == "--check-mir" { mir_verify(module) }
        else {
            let output = if cli[1] == "--emit-mir" { mir_module_json(module) } else { mir_emit_c(module) }
            if len(cli) == 4 {
                if module_normalize(cli[2]) == module_normalize(cli[3]) { eprint("[W5002] Output must differ from input") exit(2) }
                write_file(cli[3], output)?
            } else { print(output) }
        }
        return
    }
    if len(cli) != 3 { eprint("[W5002] Usage: Wysna Compiler INPUT OUTPUT") exit(2) }
    let in_path = cli[1]
    let out_path = cli[2]
    if module_normalize(in_path) == module_normalize(out_path) { eprint("[W5002] Output must differ from input") exit(2) }
    let src = read_file(in_path)?
    let checked = check_source(src, in_path)
    let c_code = compile_source(checked)
    write_file(out_path, c_code)?
    print("[Wysna Compiler] Compiled", in_path, "->", out_path)
}

let res = run_compiler() else err {
    eprint("[W4003] Wysna Compiler I/O error:", err.message)
    exit(1)
}
