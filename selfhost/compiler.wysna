    }
    report_error_at("W9999", operation.source, "verified MIR operation missing during C99 emission")
    return ""
}
fn mir_c_operation(module: MirModule, function: MirFunction, operation: MirOperation) -> str {
    return mir_c_operation_opt(module, function, operation, mir_c_empty_sync_info())
}
# Intrinsics use declaration identity, never source line numbers or file basenames.
fn mir_c_stdlib_function(function: MirFunction, module_name: str, name: str, arity: int) -> bool {
    let configured = lsp_stdlib_root_arg()
    let root = if configured == "" { "stdlib" } else { configured }
    if module_canonical(function.source.file) != module_canonical(root + "/" + module_name + ".wysna") { return false }
    return tool_short_name(function.declaration_name) == name and len(function.params) == arity
}
fn mir_c_algorithms_parallel_helper(function: MirFunction) -> str {
    if mir_c_stdlib_function(function, "algorithms", "parallel_map", 2) { return "wysna_parallel_map" }
    if mir_c_stdlib_function(function, "algorithms", "parallel_batch", 3) { return "wysna_parallel_batch" }
    if mir_c_stdlib_function(function, "algorithms", "parallel_filter", 2) { return "wysna_parallel_filter" }
    return ""
}
fn mir_c_async_helper(function: MirFunction) -> str {
    if mir_c_stdlib_function(function, "async", "_spawn_handle", 1) { return "wysna_async_spawn_handle" }
    if mir_c_stdlib_function(function, "async", "_take_task_value", 2) { return "wysna_spawn_take_option" }
    return ""
}
fn mir_c_coro_assign(function: MirFunction, dest_id: int, wval_var: str, indent: str) -> str {
    let tid = function.slots[dest_id].type_id
    let dname = mir_c_name(dest_id)
    if mir_value_storage(tid) {
        return indent + "wysna_release(" + dname + "); " + dname + " = " + wval_var + "; " + wval_var + " = wysna_unit();\n"
    }
    if tid == 3 {
        return indent + dname + " = wysna_consume_int(" + wval_var + "); " + wval_var + " = wysna_unit();\n"
    }
    return indent + mir_c_write(function, dest_id, wval_var, true) + " wysna_release(" + wval_var + "); " + wval_var + " = wysna_unit();\n"
}

fn mir_c_coro_flush(function: MirFunction, indent: str) -> str {
    let mut parts: list[str] = []
    for i in 0..len(function.slots) {
        let tid = function.slots[i].type_id
        let sname = mir_c_name(i)
        if mir_value_storage(tid) {
            parts.append(indent + "_frame_slots[" + str(i) + "] = wysna_move(&" + sname + ");\n")
        } else {
            parts.append(indent + "_frame_slots[" + str(i) + "] = " + mir_c_box(sname, tid) + ";\n")
        }
    }
    return join_strings(parts, "")
}

fn mir_c_async_function(module: MirModule, function: MirFunction) -> str {
    let step_name = "wysna_coro_step_" + function.name
    let mut parts: list[str] = ["static WVal " + step_name + "(WVal* _frame_slots, int64_t _slot_count, int64_t* _frame_state, WVal _resume_val, bool _has_resume, WVal* _out_await_box, int64_t* _out_await_handle, int32_t* _out_status) {\n"]
    parts.append("    (void)_slot_count;\n    (void)_has_resume;\n    (void)_out_await_box;\n    (void)_out_await_handle;\n")
    if len(function.slots) == 0 { parts.append("    (void)_frame_slots;\n") }
    for i in 0..len(function.slots) {
        let tid = function.slots[i].type_id
        let sname = mir_c_name(i)
        let fslot = "_frame_slots[" + str(i) + "]"
        if mir_value_storage(tid) {
            parts.append("    WVal " + sname + " = " + fslot + "; " + fslot + " = wysna_unit();\n")
        } elif tid == 3 {
            parts.append("    int64_t " + sname + " = (wysna_tag(" + fslot + ") == W_INT) ? wysna_as_int(" + fslot + ") : 0;\n")
            parts.append("    " + fslot + " = wysna_unit();\n")
        } elif tid == 4 {
            parts.append("    double " + sname + " = (wysna_tag(" + fslot + ") == W_FLOAT) ? wysna_as_float(" + fslot + ") : 0.0;\n")
            parts.append("    " + fslot + " = wysna_unit();\n")
        } else {
            parts.append("    bool " + sname + " = (wysna_tag(" + fslot + ") == W_BOOL) ? wysna_as_bool(" + fslot + ") : false;\n")
            parts.append("    " + fslot + " = wysna_unit();\n")
        }
    }
    parts.append("    switch (*_frame_state) {\n        case 0: goto bb0;\n")
    let mut total_states = 0
    for block in function.blocks {
        for operation in block.operations {
            if operation.opcode == "runtime" and operation.name == "wysna_await" {
                total_states = total_states + 1
                parts.append("        case " + str(total_states) + ": goto cps_resume_" + str(total_states) + ";\n")
            }
        }
    }
    parts.append("        default: *_out_status = WYSNA_CORO_DONE; wysna_release(_resume_val); return wysna_unit();\n    }\n")

    let mut next_state = 0
    for bi in 0..len(function.blocks) {
        let block = function.blocks[bi]
        parts.append("bb" + str(bi) + ":;\n")
        for operation in block.operations {
            if operation.opcode == "runtime" and operation.name == "wysna_await" {
                next_state = next_state + 1
                let sid = str(next_state)
                let cont_lbl = "cps_cont_" + str(bi) + "_" + sid
                let arg_expr = mir_c_value(function, operation.args[0], true)
                parts.append("    {\n")
                parts.append("        WVal _aw_box_" + sid + " = " + arg_expr + ";\n")
                parts.append("        int64_t _aw_handle_" + sid + " = 0;\n")
                parts.append("        WVal _aw_imm_" + sid + " = wysna_unit();\n")
                parts.append("        if (wysna_coro_try_resolve_await(&_aw_box_" + sid + ", &_aw_handle_" + sid + ", &_aw_imm_" + sid + ")) {\n")
                parts.append(mir_c_coro_assign(function, operation.result, "_aw_imm_" + sid, "            "))
                parts.append("            goto " + cont_lbl + ";\n")
                parts.append("        }\n")
                parts.append("        *_frame_state = " + sid + ";\n")
                parts.append("        *_out_await_box = _aw_box_" + sid + ";\n")
                parts.append("        *_out_await_handle = _aw_handle_" + sid + ";\n")
                parts.append("        *_out_status = WYSNA_CORO_SUSPENDED;\n")
                parts.append(mir_c_coro_flush(function, "        "))
                parts.append("        wysna_release(_resume_val);\n")
                parts.append("        return wysna_unit();\n")
                parts.append("    }\n")
                parts.append("cps_resume_" + sid + ":;\n")
                parts.append(mir_c_coro_assign(function, operation.result, "_resume_val", "    "))
                parts.append("    goto " + cont_lbl + ";\n")
                parts.append(cont_lbl + ":;\n")
            } else {
                parts.append("    " + mir_c_operation(module, function, operation) + "\n")
            }
        }
        let term = block.terminator
        if term.kind == "goto" { parts.append("    goto bb" + str(term.targets[0]) + ";\n") }
        elif term.kind == "branch" { parts.append("    if (" + mir_c_name(term.value) + ") goto bb" + str(term.targets[0]) + "; else goto bb" + str(term.targets[1]) + ";\n") }
        elif term.kind == "return" {
            let rslot = function.slots[term.value]
            let rname = mir_c_name(term.value)
            let ret_expr = if mir_value_storage(rslot.type_id) { if rslot.parameter { "wysna_clone(" + rname + ")" } else { "wysna_move(&" + rname + ")" } } else { mir_c_box(rname, rslot.type_id) }
            parts.append("    {\n        WVal _coro_ret = " + ret_expr + ";\n")
            for si in 0..len(function.slots) {
                if mir_value_storage(function.slots[si].type_id) {
                    let sn = mir_c_name(si)
                    parts.append("        wysna_release(" + sn + "); " + sn + " = wysna_unit();\n")
                }
            }
            parts.append("        wysna_release(_resume_val);\n")
            parts.append("        *_out_status = WYSNA_CORO_DONE;\n")
            parts.append("        return _coro_ret;\n    }\n")
        } else {
            for si in 0..len(function.slots) {
                if mir_value_storage(function.slots[si].type_id) {
                    let sn = mir_c_name(si)
                    parts.append("    wysna_release(" + sn + "); " + sn + " = wysna_unit();\n")
                }
            }
            parts.append("    wysna_release(_resume_val);\n")
            parts.append("    wysna_runtime_fail(\"W9999\", \"Unreachable MIR block executed\");\n")
            parts.append("    *_out_status = WYSNA_CORO_DONE;\n    return wysna_unit();\n")
        }
    }
    parts.append("    *_out_status = WYSNA_CORO_DONE;\n    wysna_release(_resume_val);\n    return wysna_unit();\n}\n")
    parts.append(mir_c_signature(function) + " {\n")
    let slot_count = len(function.slots)
    let param_count = len(function.params)
    if param_count > 0 {
        parts.append("    int64_t _p_idx[" + str(param_count) + "];\n")
        parts.append("    WVal _p_vals[" + str(param_count) + "];\n")
        for i in 0..param_count {
            let pid = function.params[i]
            let pslot = function.slots[pid]
            let pname = mir_c_name(pid)
            parts.append("    _p_idx[" + str(i) + "] = " + str(pid) + ";\n")
            parts.append("    _p_vals[" + str(i) + "] = " + (if mir_value_storage(pslot.type_id) { pname } else { mir_c_box(pname, pslot.type_id) }) + ";\n")
        }
        parts.append("    return wysna_coro_spawn(" + step_name + ", " + str(slot_count) + ", " + str(param_count) + ", _p_idx, _p_vals);\n}\n")
    } else {
        parts.append("    return wysna_coro_spawn(" + step_name + ", " + str(slot_count) + ", 0, NULL, NULL);\n}\n")
    }
    return join_strings(parts, "")
}

fn mir_c_display_fn_name(name: str) -> str {
    let mut raw = if len(name) > 9 and slice(name, 0, 9) == "wysna_fn_" { slice(name, 9, len(name)) } else { name }
    let prefix = "__wysna_module_"
    if len(raw) > len(prefix) and slice(raw, 0, len(prefix)) == prefix {
        for i in len(prefix)..len(raw) - 1 {
            if slice(raw, i, i + 2) == "__" {
                return slice(raw, i + 2, len(raw))
            }
        }
    }
    return raw
}

fn mir_c_borrowed_runtime_ok(name: str) -> bool {
    if mir_is_readonly_runtime(name) { return true }
    return (
        name == "wysna_index_get_at" or name == "wysna_index_get_owned" or name == "wysna_index_get" or
        name == "wysna_builtin_json_parse" or name == "wysna_builtin_int" or name == "wysna_builtin_float" or
        name == "wysna_builtin_u8" or name == "wysna_builtin_chr" or name == "wysna_builtin_join_strings" or
        name == "wysna_builtin_read_file" or name == "wysna_builtin_write_file" or
        name == "wysna_add" or name == "wysna_unwrap_ok" or name == "wysna_unwrap_err" or
        name == "wysna_unwrap_optional" or name == "wysna_unwrap_success" or
        name == "wysna_enum_payload_owned" or name == "wysna_builtin_contract_assert_at" or
        name == "wysna_builtin_contract_assert"
    )
}

fn mir_c_is_nontrapping_scalar_op(name: str) -> bool {
    return (
        name == "wysna_add" or name == "wysna_sub" or name == "wysna_mul" or
        name == "wysna_neg" or name == "wysna_not" or
        name == "wysna_lt" or name == "wysna_le" or name == "wysna_gt" or name == "wysna_ge" or
        name == "wysna_equal" or name == "wysna_not_equal"
    )
}

fn mir_c_is_skipped_unit_op(function: MirFunction, op: MirOperation) -> bool {
    let k = op.opcode
    if k == "const" or k == "default" {
        return op.result >= 0 and function.slots[op.result].type_id == 1
    }
    if k == "release" {
        return len(op.args) == 1 and function.slots[op.args[0]].type_id == 1
    }
    if k == "clone" or k == "store" {
        return op.result >= 0 and len(op.args) == 1 and function.slots[op.result].type_id == 1 and function.slots[op.args[0]].type_id == 1
    }
    if k == "store_place" {
        return op.place.root >= 0 and len(op.place.projections) == 0 and len(op.args) == 1 and function.slots[op.place.root].type_id == 1 and function.slots[op.args[0]].type_id == 1
    }
    return false
}

fn mir_c_analyze_sync(module: MirModule, function: MirFunction, sync_fns: dict[str, bool]) -> MirCSyncInfo {
    let slot_count = len(function.slots)
    let block_count = len(function.blocks)
    let mut preds: list[list[int]] = []
    let mut entry_inits: list[list[MirCEntryInit]] = []
    for _bi in 0..block_count {
        let pe: list[int] = []
        preds.append(pe)
        let ie: list[MirCEntryInit] = []
        entry_inits.append(ie)
    }
    let mut definitions: list[int] = []
    let mut iter_test_counts: list[int] = []
    let mut counter_ops: list[int] = []
    let mut inc_blocks: list[list[int]] = []
    let mut inc_valid: list[bool] = []
    let mut hoisted_counter: list[bool] = []
    let mut hoisted_iterable: list[int] = []
    let mut hoisted_in_loop: list[list[bool]] = []
    let mut borrowed_item: list[bool] = []
    let mut unit_read: list[bool] = []
    let mut terminator_used: list[bool] = []
    for _si in 0..slot_count {
        definitions.append(0)
        iter_test_counts.append(0)
        counter_ops.append(0)
        let ib: list[int] = []
        inc_blocks.append(ib)
        inc_valid.append(true)
        hoisted_counter.append(false)
        hoisted_iterable.append(-1)
        let lb_empty: list[bool] = []
        hoisted_in_loop.append(lb_empty)
        borrowed_item.append(false)
        unit_read.append(false)
        terminator_used.append(false)
    }
    for bi in 0..block_count {
        let b = function.blocks[bi]
        let term = b.terminator
        for t in term.targets {
            if t >= 0 and t < block_count { preds[t].append(bi) }
        }
        if term.value >= 0 and term.value < slot_count {
            terminator_used[term.value] = true
        }
        for op in b.operations {
            if op.result >= 0 and op.result < slot_count {
                definitions[op.result] = definitions[op.result] + 1
            }
            if op.opcode == "iterate_test" and not op.value.boolean and len(op.args) == 2 {
                let c = op.args[0]
                if c >= 0 and c < slot_count { iter_test_counts[c] = iter_test_counts[c] + 1 }
            }
            if op.opcode == "counter" and op.result >= 0 and op.result < slot_count {
                counter_ops[op.result] = counter_ops[op.result] + 1
            }
            if op.opcode == "increment" {
                let valid_shape = (
                    op.result >= 0 and op.result < slot_count and
                    len(op.args) == 1 and op.args[0] == op.result and
                    term.kind == "goto" and len(term.targets) == 1
                )
                if op.result >= 0 and op.result < slot_count {
                    if not valid_shape { inc_valid[op.result] = false }
                    else { inc_blocks[op.result].append(bi) }
                }
                for a in op.args {
                    if a >= 0 and a < slot_count and a != op.result { inc_valid[a] = false }
                }
            }
        }
    }
    let mut hoisted_counters_list: list[int] = []
    for header_bid in 0..block_count {
        for op in function.blocks[header_bid].operations {
            if op.opcode != "iterate_test" or op.value.boolean or len(op.args) != 2 { continue }
            let counter = op.args[0]
            let iterable = op.args[1]
            if counter < 0 or counter >= slot_count or iterable < 0 or iterable >= slot_count { continue }
            if hoisted_counter[counter] or iter_test_counts[counter] != 1 or counter_ops[counter] != 1 { continue }
            if not inc_valid[counter] or len(inc_blocks[counter]) == 0 { continue }
            if definitions[counter] != 1 + len(inc_blocks[counter]) { continue }
            if module.types[function.slots[iterable].type_id].kind != "list" { continue }
            let mut latches_ok = true
            for lb_id in inc_blocks[counter] {
                if function.blocks[lb_id].terminator.targets[0] != header_bid {
                    latches_ok = false
                    break
                }
            }
            if not latches_ok { continue }
            let mut in_loop: list[bool] = []
            for _bi in 0..block_count { in_loop.append(false) }
            in_loop[header_bid] = true
            let mut work: list[int] = []
            for lb_id in inc_blocks[counter] {
                if not in_loop[lb_id] {
                    in_loop[lb_id] = true
                    work.append(lb_id)
                }
            }
            let mut cur_idx = 0
            while cur_idx < len(work) {
                let cur = work[cur_idx]
                cur_idx = cur_idx + 1
                for p in preds[cur] {
                    if not in_loop[p] {
                        in_loop[p] = true
                        work.append(p)
                    }
                }
            }
            let mut reducible = true
            for lb_id in 0..block_count {
                if in_loop[lb_id] and lb_id != header_bid {
                    for p in preds[lb_id] {
                        if not in_loop[p] {
                            reducible = false
                            break
                        }
                    }
                    if not reducible { break }
                }
            }
            if not reducible { continue }
            let mut entry_preds: list[int] = []
            let mut entries_ok = true
            for p in preds[header_bid] {
                if not in_loop[p] {
                    let pt = function.blocks[p].terminator
                    if pt.kind != "goto" or len(pt.targets) != 1 or pt.targets[0] != header_bid {
                        entries_ok = false
                        break
                    }
                    entry_preds.append(p)
                }
            }
            if not entries_ok or len(entry_preds) == 0 { continue }
            let mut immutable = true
            for lb_id in 0..block_count {
                if not in_loop[lb_id] { continue }
                for kop in function.blocks[lb_id].operations {
                    if kop.result == iterable { immutable = false break }
                    if (kop.opcode == "mutate" or kop.opcode == "store_place") and kop.place.root == iterable {
                        immutable = false
                        break
                    }
                    if kop.opcode == "release" and len(kop.args) == 1 and kop.args[0] == iterable {
                        immutable = false
                        break
                    }
                    if mir_consumes(kop) and len(kop.args) > 0 and kop.args[0] == iterable {
                        immutable = false
                        break
                    }
                }
                if not immutable { break }
            }
            if not immutable { continue }
            hoisted_counter[counter] = true
            hoisted_counters_list.append(counter)
            hoisted_iterable[counter] = iterable
            hoisted_in_loop[counter] = in_loop
            for p in entry_preds {
                entry_inits[p].append(MirCEntryInit { counter: counter, iterable: iterable, source: op.source })
            }
        }
    }
    for bi in 0..block_count {
        for op in function.blocks[bi].operations {
            if op.opcode != "iterate_value" or op.value.boolean or len(op.args) != 2 { continue }
            let iterable = op.args[0]
            let counter = op.args[1]
            let item = op.result
            if counter < 0 or counter >= slot_count or item < 0 or item >= slot_count { continue }
            if not hoisted_counter[counter] or hoisted_iterable[counter] != iterable { continue }
            let in_loop = hoisted_in_loop[counter]
            if not in_loop[bi] { continue }
            let slot = function.slots[item]
            if slot.parameter or not mir_value_storage(slot.type_id) or slot.type_id == 1 { continue }
            if module.types[slot.type_id].kind == "class" { continue }
            if definitions[item] != 1 or terminator_used[item] { continue }
            let mut safe = true
            for kb in 0..block_count {
                for kop in function.blocks[kb].operations {
                    if (kop.opcode == "mutate" or kop.opcode == "store_place") and kop.place.root == item {
                        safe = false
                        break
                    }
                    let mut in_proj = false
                    if kop.opcode == "mutate" or kop.opcode == "store_place" {
                        for proj in kop.place.projections {
                            if proj.kind == "index" and proj.index == item { in_proj = true }
                        }
                    }
                    let mut in_args = false
                    for a in kop.args { if a == item { in_args = true } }
                    if not in_args and not in_proj { continue }
                    if kop.opcode == "release" and len(kop.args) == 1 and kop.args[0] == item and not in_proj {
                        continue
                    }
                    if not in_loop[kb] {
                        safe = false
                        break
                    }
                    if in_args {
                        if mir_consumes(kop) and len(kop.args) > 0 and kop.args[0] == item {
                            safe = false
                            break
                        }
                        let kcode = kop.opcode
                        if kcode == "indirect" or kcode == "virtual" or kcode == "function" or kcode == "global_store" {
                            safe = false
                            break
                        }
                        if kcode == "call" and not sync_fns.contains(kop.name) {
                            safe = false
                            break
                        }
                        if kcode == "runtime" and not mir_c_borrowed_runtime_ok(kop.name) {
                            safe = false
                            break
                        }
                    }
                }
                if not safe { break }
            }
            if safe { borrowed_item[item] = true }
        }
    }
    let mut can_trap = false
    for bi in 0..block_count {
        let term = function.blocks[bi].terminator
        if term.kind == "unreachable" { can_trap = true }
        for target in term.targets {
            if target <= bi { can_trap = true }
        }
        if term.value >= 0 and term.value < slot_count and function.slots[term.value].type_id == 1 {
            unit_read[term.value] = true
        }
        for op in function.blocks[bi].operations {
            if not mir_c_is_skipped_unit_op(function, op) {
                for a in op.args {
                    if a >= 0 and a < slot_count and function.slots[a].type_id == 1 {
                        unit_read[a] = true
                    }
                }
                if op.opcode == "mutate" or op.opcode == "store_place" {
                    if op.place.root >= 0 and op.place.root < slot_count and function.slots[op.place.root].type_id == 1 {
                        unit_read[op.place.root] = true
                    }
                    for proj in op.place.projections {
                        if proj.kind == "index" and proj.index >= 0 and proj.index < slot_count and function.slots[proj.index].type_id == 1 {
                            unit_read[proj.index] = true
                        }
                    }
                }
            }
            if not can_trap {
                let kcode = op.opcode
                if kcode == "const" or kcode == "default" or kcode == "clone" or kcode == "narrow" or kcode == "store" or kcode == "release" or kcode == "load_field" {
                    continue
                }
                if kcode == "store_place" and len(op.place.projections) == 0 {
                    continue
                }
                if kcode == "test" and op.name != "error_type" {
                    continue
                }
                if kcode == "runtime" {
                    if op.name == "wysna_unwrap_ok" or op.name == "wysna_unwrap_err" or op.name == "wysna_unwrap_optional" {
                        continue
                    }
                    if mir_c_is_nontrapping_scalar_op(op.name) {
                        let mut all_scalar = true
                        for a in op.args {
                            let tid = function.slots[a].type_id
                            if tid != 2 and tid != 3 and tid != 4 {
                                all_scalar = false
                                break
                            }
                        }
                        if all_scalar { continue }
                    }
                }
                can_trap = true
            }
        }
    }
    return MirCSyncInfo {
        sync_mode: true,
        hoisted_counter: hoisted_counter,
        hoisted_counters_list: hoisted_counters_list,
        entry_inits: entry_inits,
        borrowed_item: borrowed_item,
        unit_read: unit_read,
        can_trap: can_trap
    }
}

fn mir_c_function_with_sync(module: MirModule, function: MirFunction, sync_fns: dict[str, bool]) -> str {
    if function.is_async { return mir_c_async_function(module, function) }
    let mut parts: list[str] = [mir_c_signature(function) + " {\n"]
    for name in ["group_cancelled", "cancel_group"] {
        if mir_c_stdlib_function(function, "async", name, 0) {
            return join_strings(parts, "") + "    return wysna_" + name + "();\n}\n"
        }
    }
    if mir_c_stdlib_function(function, "async", "_run_task_group", 5) {
        let mut names: list[str] = []
        for parameter in function.params { names.append(mir_c_name(parameter)) }
        return join_strings(parts, "") + "    return wysna_run_task_group(" + join_strings(names, ", ") + ");\n}\n"
    }
    let async_helper = mir_c_async_helper(function)
    if async_helper == "wysna_async_spawn_handle" and len(function.params) == 1 {
        let p0 = mir_c_name(function.params[0])
        if mir_value_storage(function.return_type) {
            return join_strings(parts, "") + "    return wysna_int(wysna_async_spawn_handle(" + p0 + "));\n}\n"
        }
        return join_strings(parts, "") + "    return wysna_async_spawn_handle(" + p0 + ");\n}\n"
    }
    if async_helper == "wysna_spawn_take_option" and len(function.params) == 2 and mir_value_storage(function.return_type) {
        let p0 = mir_c_name(function.params[0])
        let p0_val = if mir_value_storage(function.slots[function.params[0]].type_id) { p0 } else { "wysna_borrow_int(" + p0 + ")" }
        return join_strings(parts, "") + "    return wysna_spawn_take_option(" + p0_val + ", " + mir_c_name(function.params[1]) + ");\n}\n"
    }
    let parallel_helper = mir_c_algorithms_parallel_helper(function)
    if parallel_helper != "" and mir_value_storage(function.return_type) {
        let p0 = mir_c_name(function.params[0])
        let p1 = mir_c_name(function.params[1])
        let mut call = parallel_helper + "(" + p0 + ", " + p1 + ")"
        if parallel_helper == "wysna_parallel_batch" {
            let p1_int = if mir_value_storage(function.slots[function.params[1]].type_id) { "wysna_as_int(" + p1 + ")" } else { p1 }
            call = "wysna_parallel_batch(" + p0 + ", " + p1_int + ", " + mir_c_name(function.params[2]) + ")"
        }
        let returned = module.types[function.return_type]
        if returned.kind == "list" and returned.args[0] == 7 { call = "wysna_pack_u8_owned(" + call + ")" }
        return join_strings(parts, "") + "    return " + call + ";\n}\n"
    }
    let info = mir_c_analyze_sync(module, function, sync_fns)
    let track_frame = len(function.name) > 9 and slice(function.name, 0, 9) == "wysna_fn_" and info.can_trap
    for i in 0..len(function.slots) {
        let slot = function.slots[i]
        if not slot.parameter and (slot.type_id != 1 or info.unit_read[i]) {
            parts.append("    " + mir_c_type(slot.type_id) + " " + mir_c_name(i) + " = " + (if mir_value_storage(slot.type_id) { "wysna_unit()" } else { "0" }) + ";\n")
        }
    }
    for cs_id in info.hoisted_counters_list {
        let cs = str(cs_id)
        parts.append("    WListBuf* _ibuf_" + cs + " = NULL;\n")
        parts.append("    int32_t _ilen_" + cs + " = 0;\n")
    }
    if track_frame {
        let ffile = if function.source.file != "" { function.source.file } else { "<unknown>" }
        parts.append("    wysna_runtime_push_frame(" + escape_c_str(mir_c_display_fn_name(function.name)) + ", " + escape_c_str(ffile) + ", " + str(function.source.line) + ");\n")
    }
    parts.append("    goto bb0;\n")
    for i in 0..len(function.blocks) {
        let block = function.blocks[i]
        parts.append("bb" + str(i) + ":;\n")
        for operation in block.operations {
            let emitted_op = mir_c_operation_opt(module, function, operation, info)
            if emitted_op != "" { parts.append("    " + emitted_op + "\n") }
        }
        let term = block.terminator
        if term.kind == "goto" {
            for entry in info.entry_inits[i] {
                let cs = str(entry.counter)
                parts.append("    _ibuf_" + cs + " = wysna_list_iter_begin_at(" + mir_c_value(function, entry.iterable, false) + ", " + escape_c_str(entry.source.file) + ", " + str(entry.source.line) + ", " + str(entry.source.col) + ");\n")
                parts.append("    _ilen_" + cs + " = _ibuf_" + cs + "->len;\n")
            }
            parts.append("    goto bb" + str(term.targets[0]) + ";\n")
        }
        elif term.kind == "branch" { parts.append("    if (" + mir_c_name(term.value) + ") goto bb" + str(term.targets[0]) + "; else goto bb" + str(term.targets[1]) + ";\n") }
        elif term.kind == "return" {
            let name = mir_c_name(term.value)
            let expression = if mir_value_storage(function.return_type) { "wysna_move(&" + name + ")" } else { name }
            if track_frame { parts.append("    wysna_runtime_pop_frame();\n") }
            parts.append("    return " + expression + ";\n")
        }
        else { parts.append("    wysna_runtime_fail(\"W9999\", \"Unreachable MIR block executed\");\n") }
    }
    parts.append("}\n")
    return join_strings(parts, "")
}

fn mir_c_function(module: MirModule, function: MirFunction) -> str {
    let mut sync_fns: dict[str, bool] = {}
    for fn_ in module.functions {
        if not fn_.is_async { sync_fns[fn_.name] = true }
    }
    return mir_c_function_with_sync(module, function, sync_fns)
}
fn mir_prune_dead_functions(module: MirModule) -> MirModule {
    let mut fn_index: dict[str, int] = {}
    for i in 0..len(module.functions) {
        fn_index[module.functions[i].name] = i
    }
    if not fn_index.contains("wysna_program") {
        return module
    }
    let mut ext_names: dict[str, bool] = {}
    for external in module.externs {
        ext_names[external.name] = true
    }
    let mut queue: list[str] = ["wysna_program"]
    for record in module.records {
        if module.types[record.type_id].kind == "class" {
            for method in record.methods {
                queue.append(method.target)
            }
        }
    }
    let mut reachable: dict[str, bool] = {}
    let mut reachable_extern: dict[str, bool] = {}
    let mut cursor = 0
    while cursor < len(queue) {
        let fname = queue[cursor]
        cursor = cursor + 1
        if reachable.contains(fname) {
            continue
        }
        if ext_names.contains(fname) {
            reachable_extern[fname] = true
            continue
        }
        if not fn_index.contains(fname) {
            continue
        }
        reachable[fname] = true
        let fn_ = module.functions[fn_index[fname]]
        for block in fn_.blocks {
            for op in block.operations {
                if (op.opcode == "call" or op.opcode == "function") and len(op.name) > 0 {
                    if not reachable.contains(op.name) {
                        queue.append(op.name)
                    }
                }
            }
        }
    }
    let mut pruned_fns: list[MirFunction] = []
    for function in module.functions {
        if reachable.contains(function.name) {
            pruned_fns.append(function)
        }
    }
    let mut pruned_externs: list[MirExtern] = []
    for external in module.externs {
        if reachable_extern.contains(external.name) {
            pruned_externs.append(external)
        }
    }
    return MirModule {
        file: module.file,
        functions: pruned_fns,
        globals: module.globals,
        records: module.records,
        virtual_slots: module.virtual_slots,
        externs: pruned_externs,
        types: module.types,
        source: module.source
    }
}

fn mir_emit_c(module: MirModule) -> str {
    mir_verify(module)
    let active = mir_prune_dead_functions(module)
    let mut parts: list[str] = []
    for external in active.externs { if external.native == "wysna_host_http_request" { parts.append("#define WYSNA_HAS_HTTP 1\n") } }
    parts.append("#include \"runtime/wysna_runtime.h\"\n/* Verified Compiler MIR: explicit CFG and ownership. */\n")
    for record in active.records {
        if len(record.fields) > 0 {
            let mut kparts: list[str] = []
            for field in record.fields { kparts.append(escape_c_str(field.name)) }
            parts.append("static const char* const wysna_rec_keys_" + str(record.type_id) + "[" + str(len(record.fields)) + "] = { " + join_strings(kparts, ", ") + " };\n")
        }
        if active.types[record.type_id].kind == "class" { parts.append("static const WClassVTable wysna_vtable_" + active.types[record.type_id].name + ";\n") }
    }
    for global in active.globals { parts.append("static WVal " + global.name + ";\n") }
    for function in active.functions { parts.append(mir_c_signature(function) + ";\n") }
    parts.append(mir_c_externs(active))
    parts.append(mir_c_function_adapters(active))
    let mut sync_fns: dict[str, bool] = {}
    for fn_ in active.functions {
        if not fn_.is_async { sync_fns[fn_.name] = true }
    }
    for function in active.functions { parts.append(mir_c_function_with_sync(active, function, sync_fns)) }
    parts.append(mir_c_vtables(active))
    let mut returned = 1
    for function in active.functions { if function.name == "wysna_program" { returned = function.return_type } }
    parts.append("int main(int argc, char** argv) {\n    wysna_init_args(argc, argv);\n    WVal result = " + mir_c_box("wysna_program()", returned) + ";\n")
    parts.append("    int status = wysna_entry_status(result);\n    wysna_release(result);\n")
    for global in active.globals { parts.append("    wysna_release(" + global.name + ");\n") }
    parts.append("    wysna_runtime_cleanup();\n    return status;\n}\n")
    return join_strings(parts, "")
}

fn compile_source(checked: CheckedProgram) -> str { return mir_emit_c(mir_build_optimized(checked)) }
# Native SDK non-blocking lints (W6001 discarded pure expressions, W6002 ARC reference cycles)
# and capability sandbox policy enforcement (W5006 + C99 WYSNA_DENY_CAP_* guards).

struct LintWarning {
    code: str
    message: str
    file: str
    line: int
    col: int
    data_json: str
}

fn lint_is_pure_kind(kind: str) -> bool {
    return kind == "integer" or kind == "float" or kind == "string" or kind == "boolean" or kind == "none" or kind == "binding" or kind == "unary" or kind == "binary" or kind == "member" or kind == "index"
}

fn lint_node_is_pure(program: CheckedProgram, node_id: int) -> bool {
    if node_id < 0 or node_id >= len(program.nodes) { return false }
    let node = program.nodes[node_id]
    if not lint_is_pure_kind(node.kind) { return false }
    for child in node.children {
        if not lint_node_is_pure(program, child) { return false }
    }
    return true
}

fn lint_unit_like(program: CheckedProgram, type_id: int) -> bool {
    if type_id < 0 or type_id >= len(program.types) { return true }
    let t = program.types[type_id]
    if t.kind == "unit" { return true }
    if t.kind == "result" and len(t.args) >= 1 and program.types[t.args[0]].kind == "unit" { return true }
    return false
}

fn lint_has_pos(warnings: list[LintWarning], line: int, col: int) -> bool {
    for w in warnings {
        if w.code == "W6001" and w.line == line and w.col == col { return true }
    }
    return false
}

fn lint_record_w6001(program: CheckedProgram, node_id: int, target_file: str, out: list[LintWarning]) -> list[LintWarning] {
    let mut warnings = out
    if not lint_node_is_pure(program, node_id) { return warnings }
    let node = program.nodes[node_id]
    if node.source.file != target_file and module_canonical(node.source.file) != target_file { return warnings }
    if lint_has_pos(warnings, node.source.line, node.source.col) { return warnings }
    let mut help_text = "Remove the statement, or use its value (bind it with 'let' or return it)."
    if node.kind == "unary" and (node.text == "MINUS" or node.text == "PLUS" or node.text == "-" or node.text == "+") {
        let op_ch = if node.text == "PLUS" or node.text == "+" { "+" } else { "-" }
        help_text = "A line starting with '" + op_ch + "' begins a new statement. To continue the previous expression, put the operator at the end of the previous line."
    }
    let data_json = "{\"kind\":\"discarded_expression\",\"help\":" + diag_json_quote(help_text) + "}"
    warnings.append(LintWarning {
        code: "W6001",
        message: "Expression result is discarded; the statement has no effect",
        file: node.source.file,
        line: node.source.line,
        col: node.source.col,
        data_json: data_json,
    })
    return warnings
}

fn lint_walk_node(program: CheckedProgram, node_id: int, discard_tail: bool, target_file: str, out: list[LintWarning]) -> list[LintWarning] {
    let mut warnings = out
    if node_id < 0 or node_id >= len(program.nodes) { return warnings }
    let node = program.nodes[node_id]
    if node.kind == "call" and node.target >= 0 and node.target < len(program.signatures) {
        if node.source.file == target_file or module_canonical(node.source.file) == target_file {
            for attribute in program.signatures[node.target].attributes {
                let code = if attribute.name == "deprecated" { "W6004" } else { "W6005" }
                let mut duplicate = false
                for warning in warnings {
                    if warning.code == code and warning.file == node.source.file and warning.line == node.source.line and warning.col == node.source.col { duplicate = true }
                }
                if not duplicate and (code == "W6004" or discard_tail) {
                    let message = if code == "W6004" { "Call to deprecated function: " + attribute.message } else { "Result of @must_use function is discarded" }
                    let help_text = if code == "W6004" { attribute.message } else { "Bind, return, or consume this result." }
                    warnings.append(LintWarning { code: code, message: message, file: node.source.file, line: node.source.line, col: node.source.col, data_json: "{\"help\":" + diag_json_quote(help_text) + "}" })
                }
            }
        }
    }
    if node.kind == "block" {
        let n = len(node.children)
        for i in 0..n {
            let child = node.children[i]
            let is_last = i == n - 1
            let is_discarded = (not is_last) or discard_tail
            if is_discarded {
                warnings = lint_record_w6001(program, child, target_file, warnings)
            }
            warnings = lint_walk_node(program, child, is_discarded, target_file, warnings)
        }
        return warnings
    }
    if node.kind == "while" or node.kind == "for" {
        if len(node.children) >= 1 { warnings = lint_walk_node(program, node.children[0], false, target_file, warnings) }
        if len(node.children) >= 2 { warnings = lint_walk_node(program, node.children[1], true, target_file, warnings) }
        return warnings
    }
    if node.kind == "if" {
        let branch_discard = discard_tail or node.discard or lint_unit_like(program, node.type_id)
        if len(node.children) >= 1 { warnings = lint_walk_node(program, node.children[0], false, target_file, warnings) }
        if len(node.children) >= 2 { warnings = lint_walk_node(program, node.children[1], branch_discard, target_file, warnings) }
        if len(node.children) >= 3 { warnings = lint_walk_node(program, node.children[2], branch_discard, target_file, warnings) }
        return warnings
    }
    if node.kind == "match" {
        let arm_discard = discard_tail or lint_unit_like(program, node.type_id)
        for child in node.children { warnings = lint_walk_node(program, child, false, target_file, warnings) }
        let mut covered: list[int] = []
        for arm_id in node.arms {
            if arm_id >= 0 and arm_id < len(program.arms) {
                let arm = program.arms[arm_id]
                if lint_pattern_subsumed(program, covered, arm.pattern) {
                    warnings.append(LintWarning { code: "W6003", message: "Match arm is unreachable: earlier unguarded patterns cover it", file: arm.source.file, line: arm.source.line, col: arm.source.col, data_json: "{\"kind\":\"unreachable_match_arm\"}" })
                }
                if arm.guard < 0 { covered.append(arm.pattern) }
                if arm.guard >= 0 { warnings = lint_walk_node(program, arm.guard, false, target_file, warnings) }
                warnings = lint_walk_node(program, arm.body, arm_discard, target_file, warnings)
            }
        }
        return warnings
    }
    if node.kind == "handler" {
        let h_discard = discard_tail or lint_unit_like(program, node.type_id)
        if len(node.children) >= 1 { warnings = lint_walk_node(program, node.children[0], false, target_file, warnings) }
        if len(node.children) >= 2 { warnings = lint_walk_node(program, node.children[1], h_discard, target_file, warnings) }
        return warnings
    }
    for child in node.children {
        warnings = lint_walk_node(program, child, false, target_file, warnings)
    }
    return warnings
}

fn lint_collect_strong_targets(program: CheckedProgram, type_id: int, seen_records: list[int], out: list[str]) -> list[str] {
    let mut targets = out
    if type_id < 0 or type_id >= len(program.types) { return targets }
    let t = program.types[type_id]
    if t.kind == "weak" { return targets }
    if t.kind == "class" {
        if not tool_str_contains(targets, t.name) { targets.append(t.name) }
        return targets
    }
    if t.kind == "optional" or t.kind == "list" or t.kind == "dict" or t.kind == "tuple" or t.kind == "result" or t.kind == "error_union" {
        for arg in t.args {
            targets = lint_collect_strong_targets(program, arg, seen_records, targets)
        }
        return targets
    }
    if t.kind == "struct" or t.kind == "enum" {
        for s in seen_records { if s == type_id { return targets } }
        let mut next_seen = seen_records
        next_seen.append(type_id)
        for rec in program.records {
            if rec.type_id == type_id {
                for f in rec.fields {
                    targets = lint_collect_strong_targets(program, f.type_id, next_seen, targets)
                }
                for v in rec.variants {
                    for p in v.payloads {
                        targets = lint_collect_strong_targets(program, p, next_seen, targets)
                    }
                }
            }
        }
    }
    return targets
}

fn lint_class_index(names: list[str], target: str) -> int {
    for i in 0..len(names) {
        if names[i] == target { return i }
    }
    return -1
}

fn lint_find_class_token(tokens: list[Token], class_name: str) -> list[int] {
    let n = len(tokens)
    for i in 0..(n - 1) {
        if tokens[i].kind == "CLASS" and tokens[i + 1].kind == "IDENT" and tokens[i + 1].val == class_name {
            return [tokens[i + 1].line, tokens[i + 1].col]
        }
    }
    return [1, 1]
}

fn lint_canonical_cycle_key(cycle: list[str]) -> str {
    let n = len(cycle)
    if n == 0 { return "" }
    let mut min_idx = 0
    for i in 1..n {
        if tool_str_gt(cycle[min_idx], cycle[i]) { min_idx = i }
    }
    let mut rotated: list[str] = []
    for k in 0..n {
        rotated.append(cycle[(min_idx + k) % n])
    }
    return join_strings(rotated, "->")
}

fn lint_collect_cycles(program: CheckedProgram, src: str, file: str, out: list[LintWarning]) -> list[LintWarning] {
    let mut warnings = out
    let mut class_names: list[str] = []
    let mut class_adj: list[list[str]] = []
    for rec in program.records {
        let t = program.types[rec.type_id]
        if t.kind == "class" and not tool_str_contains(class_names, t.name) {
            let mut edges: list[str] = []
            for f in rec.fields {
                edges = lint_collect_strong_targets(program, f.type_id, [], edges)
            }
            class_names.append(t.name)
            class_adj.append(edges)
        }
    }
    let count = len(class_names)
    if count == 0 { return warnings }
    let tokens = tokenize(src, file)
    let mut seen_keys: list[str] = []
    for start in 0..count {
        # Iterative DFS from start to find shortest simple cycle returning to start
        let mut stack_node: list[int] = [start]
        let mut stack_edge: list[int] = [0]
        while len(stack_node) > 0 {
            let top = len(stack_node) - 1
            let curr = stack_node[top]
            let edge_idx = stack_edge[top]
            let neighbors = class_adj[curr]
            if edge_idx >= len(neighbors) {
                stack_node.pop()
                stack_edge.pop()
                continue
            }
            stack_edge[top] = edge_idx + 1
            let nxt_name = neighbors[edge_idx]
            let nxt = lint_class_index(class_names, nxt_name)
            if nxt < 0 { continue }
            if nxt == start {
                let mut cycle: list[str] = []
                for idx_v in stack_node { cycle.append(class_names[idx_v]) }
                let key = lint_canonical_cycle_key(cycle)
                if not tool_str_contains(seen_keys, key) {
                    seen_keys.append(key)
                    let mut chain_parts: list[str] = []
                    for c in cycle { chain_parts.append(c) }
                    chain_parts.append(cycle[0])
                    let chain = join_strings(chain_parts, " -> ")
                    let pos = lint_find_class_token(tokens, cycle[0])
                    let advisory = "Strong reference cycle detected across classes: " + chain + ". Under ARC, mutual strong references cause permanent memory retention. Consider breaking the cycle by annotating back-references with 'Weak[T]'."
                    let mut cls_json: list[str] = ["["]
                    for ci in 0..len(cycle) {
                        if ci > 0 { cls_json.append(",") }
                        cls_json.append(diag_json_quote(cycle[ci]))
                    }
                    cls_json.append("]")
                    let data_json = "{\"kind\":\"reference_cycle\",\"classes\":" + join_strings(cls_json, "") + ",\"help\":" + diag_json_quote(advisory) + "}"
                    warnings.append(LintWarning {
                        code: "W6002",
                        message: "strong reference cycle detected in nominal classes: " + chain,
                        file: file,
                        line: pos[0],
                        col: pos[1],
                        data_json: data_json,
                    })
                }
                continue
            }
            if nxt < start { continue }
            let mut in_path = false
            for idx_v in stack_node { if idx_v == nxt { in_path = true } }
            if not in_path and len(stack_node) < 16 {
                stack_node.append(nxt)
                stack_edge.append(0)
            }
        }
    }
    return warnings
}

fn lint_collect_warnings(program: CheckedProgram, src: str, file: str) -> list[LintWarning] {
    let canonical = module_canonical(file)
    let mut warnings: list[LintWarning] = []
    for entry_id in program.entry {
        warnings = lint_record_w6001(program, entry_id, canonical, warnings)
        warnings = lint_walk_node(program, entry_id, true, canonical, warnings)
    }
    for func in program.functions {
        let sig = program.types[func.type_id]
        let ret_type = if len(sig.args) > 0 { sig.args[len(sig.args) - 1] } else { program.unit_type }
        let discard_tail = lint_unit_like(program, ret_type)
        warnings = lint_walk_node(program, func.body, discard_tail, canonical, warnings)
    }
    # Insertion-sort W6001 warnings by (line, col)
    let n = len(warnings)
    for i in 1..n {
        let key = warnings[i]
        let mut j = i - 1
        while j >= 0 and (warnings[j].line > key.line or (warnings[j].line == key.line and warnings[j].col > key.col)) {
            warnings[j + 1] = warnings[j]
            j = j - 1
        }
        warnings[j + 1] = key
    }
    warnings = lint_collect_cycles(program, src, file, warnings)
    return warnings
}

fn lint_warnings_json(warnings: list[LintWarning], src: str) -> str {
    if len(warnings) == 0 { return "[]" }
    let mut items: list[str] = []
    for w in warnings {
        let span_json = diag_primary_span_json(w.file, w.line, w.col, src)
        items.append("{\"code\":" + diag_json_quote(w.code) + ",\"severity\":\"warning\",\"stage\":\"lint\",\"message\":" + diag_json_quote(w.message) + ",\"primary_span\":" + span_json + ",\"related\":[],\"data\":" + w.data_json + ",\"fixes\":[]}")
    }
    return "[" + join_strings(items, ",") + "]"
}

fn lint_print_warnings_stderr(warnings: list[LintWarning]) -> unit {
    for w in warnings {
        eprint("warning[" + w.code + "] " + w.file + ":" + str(w.line) + ":" + str(w.col) + " - " + w.message)
    }
}

# ---- Capability Sandbox Enforcement (W5006 + C99 WYSNA_DENY_CAP_* macros) ----

fn sandbox_all_capabilities() -> list[str] {
    return ["arguments", "clock", "environment", "filesystem.read", "filesystem.write", "native-ffi", "network", "process-control", "processes", "stdio"]
}

fn sandbox_default_capabilities() -> list[str] {
    return ["arguments", "stdio"]
}

fn sandbox_cap_macro(cap: str) -> str {
    if cap == "arguments" { return "WYSNA_DENY_CAP_ARGUMENTS" }
    if cap == "clock" { return "WYSNA_DENY_CAP_CLOCK" }
    if cap == "environment" { return "WYSNA_DENY_CAP_ENVIRONMENT" }
    if cap == "filesystem.read" { return "WYSNA_DENY_CAP_FILESYSTEM_READ" }
    if cap == "filesystem.write" { return "WYSNA_DENY_CAP_FILESYSTEM_WRITE" }
    if cap == "native-ffi" { return "WYSNA_DENY_CAP_NATIVE_FFI" }
    if cap == "network" { return "WYSNA_DENY_CAP_NETWORK" }
    if cap == "process-control" { return "WYSNA_DENY_CAP_PROCESS_CONTROL" }
    if cap == "processes" { return "WYSNA_DENY_CAP_PROCESSES" }
    if cap == "stdio" { return "WYSNA_DENY_CAP_STDIO" }
    return ""
}

fn sandbox_parse_cap_list(raw: str) -> list[str] {
    let valid = sandbox_all_capabilities()
    let mut caps: list[str] = []
    if raw == "" { report_error("<cli>", "W5002", 1, 1, "capability lists must be comma-separated names") }
    let mut cur = ""
    let n = len(raw)
    for i in 0..(n + 1) {
        let ch = if i < n { raw[i] } else { "," }
        if ch == "," {
            if cur == "" { report_error("<cli>", "W5002", 1, 1, "capability lists must be comma-separated names") }
            if not tool_str_contains(valid, cur) {
                report_error("<cli>", "W5002", 1, 1, "unknown capability: " + cur + ". Valid capabilities: " + join_strings(valid, ", "))
            }
            if tool_str_contains(caps, cur) {
                report_error("<cli>", "W5002", 1, 1, "capability lists must not repeat names")
            }
            caps.append(cur)
            cur = ""
        } else {
            cur = cur + ch
        }
    }
    return caps
}

fn sandbox_is_trusted_host_extern(name: str) -> bool {
    return name == "wysna_host_buffer_new" or name == "wysna_host_buffer_size" or name == "wysna_host_buffer_get" or name == "wysna_host_buffer_append" or name == "wysna_host_claim" or name == "wysna_host_claim_valid" or name == "wysna_host_borrow" or name == "wysna_host_close" or name == "wysna_host_is_open" or name == "wysna_host_active_handles" or name == "wysna_host_active_bytes" or name == "wysna_host_last_error" or name == "wysna_host_last_error_domain" or name == "wysna_host_fs" or name == "wysna_host_fs_canonical" or name == "wysna_host_file_open" or name == "wysna_host_file_read" or name == "wysna_host_file_write" or name == "wysna_host_http_request" or name == "wysna_host_http_async_start" or name == "wysna_host_http_async_poll" or name == "wysna_host_http_multi_poll" or name == "wysna_host_http_async_finish" or name == "wysna_host_http_async_cancel" or name == "wysna_host_process_run" or name == "wysna_host_process_capture" or name == "wysna_host_monotonic_ms" or name == "wysna_host_wall_ms" or name == "wysna_host_sleep" or name == "wysna_host_stdout_flush" or name == "wysna_host_stdin_read_line" or name == "wysna_host_stdin_read_all" or name == "wysna_host_stdin_read_exact" or name == "wysna_host_stdout_write_raw" or name == "wysna_host_self_executable" or name == "wysna_host_getcwd" or name == "wysna_host_project_path_key" or name == "wysna_host_project_entries" or name == "wysna_host_project_file_sha256" or name == "wysna_host_unicode_normalize" or name == "wysna_host_crypto_sha256" or name == "wysna_host_crypto_hmac_sha256" or name == "wysna_host_crypto_sha512" or name == "wysna_host_crypto_hmac_sha512" or name == "wysna_host_crypto_md5" or name == "wysna_host_crypto_random_bytes" or name == "wysna_host_crypto_constant_time_compare" or name == "wysna_host_crypto_chacha20_poly1305_seal" or name == "wysna_host_crypto_chacha20_poly1305_open"
}

fn sandbox_caps_for_symbol(name: str) -> list[str] {
    if name == "wysna_builtin_print" or name == "wysna_builtin_eprint" or name == "wysna_host_stdout_flush" or name == "wysna_host_stdin_read_line" or name == "wysna_host_stdin_read_all" or name == "wysna_host_stdin_read_exact" or name == "wysna_host_stdout_write_raw" {
        return ["stdio"]
    }
    if name == "wysna_builtin_args" { return ["arguments"] }
    if name == "wysna_builtin_env" or name == "wysna_host_self_executable" or name == "wysna_host_getcwd" { return ["environment"] }
    if name == "wysna_builtin_unix_time" or name == "wysna_host_monotonic_ms" or name == "wysna_host_wall_ms" or name == "wysna_host_sleep" { return ["clock"] }
    if name == "wysna_builtin_exit" { return ["process-control"] }
    if name == "wysna_builtin_read_file" or name == "wysna_host_fs_canonical" or name == "wysna_host_file_read" or name == "wysna_host_project_entries" or name == "wysna_host_project_file_sha256" {
        return ["filesystem.read"]
    }
    if name == "wysna_builtin_write_file" or name == "wysna_host_file_write" or name == "wysna_host_close" {
        return ["filesystem.write"]
    }
    if name == "wysna_host_fs" or name == "wysna_host_file_open" {
        return ["filesystem.read", "filesystem.write"]
    }
    if name == "wysna_host_http_request" or name == "wysna_host_http_async_start" or name == "wysna_host_http_async_poll" or name == "wysna_host_http_multi_poll" or name == "wysna_host_http_async_finish" or name == "wysna_host_http_async_cancel" {
        return ["network"]
    }
    if name == "wysna_host_process_run" or name == "wysna_host_process_capture" {
        return ["processes"]
    }
    return []
}

fn sandbox_enforce_and_header(module: MirModule, file: str, mode: str, cap_list: list[str]) -> str {
    let mut untrusted: list[str] = []
    for ext in module.externs {
        if not sandbox_is_trusted_host_extern(ext.native) {
            untrusted.append(ext.native)
        }
    }
    if len(untrusted) > 0 {
        report_error(file, "W5006", 1, 1, "Capability policy cannot allow untrusted foreign declarations: " + join_strings(tool_sort_strings(untrusted), ", "))
    }
    let mut reachable: list[str] = []
    let mut queue: list[str] = []
    let mut has_entry = false
    for func in module.functions {
        if func.name == "wysna_program" { has_entry = true }
    }
    if has_entry {
        reachable.append("wysna_program")
        queue.append("wysna_program")
    } else {
        for func in module.functions {
            reachable.append(func.name)
            queue.append(func.name)
        }
    }
    let mut qi = 0
    while qi < len(queue) {
        let cur_name = queue[qi]
        qi = qi + 1
        for func in module.functions {
            if func.name != cur_name { continue }
            for blk in func.blocks {
                for op in blk.operations {
                    if op.opcode == "call" or op.opcode == "function" or op.opcode == "direct_method" {
                        if op.name != "" and not tool_str_contains(reachable, op.name) {
                            reachable.append(op.name)
                            queue.append(op.name)
                        }
                    } elif op.opcode == "virtual_call" {
                        for rec in module.records {
                            for m in rec.methods {
                                if m.name == op.name and not tool_str_contains(reachable, m.target) {
                                    reachable.append(m.target)
                                    queue.append(m.target)
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    let mut observed: list[str] = []
    for func in module.functions {
        if not tool_str_contains(reachable, func.name) { continue }
        for blk in func.blocks {
            for op in blk.operations {
                if op.opcode == "runtime" or op.opcode == "foreign" or op.opcode == "call" {
                    let mut sym_name = op.name
                    for ext in module.externs {
                        if ext.name == op.name { sym_name = ext.native }
                    }
                    let sym_caps = sandbox_caps_for_symbol(sym_name)
                    for cap in sym_caps {
                        if not tool_str_contains(observed, cap) { observed.append(cap) }
                    }
                }
            }
        }
    }
    let mut rejected: list[str] = []
    for cap in observed {
        if mode == "deny" {
            if tool_str_contains(cap_list, cap) { rejected.append(cap) }
        } else {
            if not tool_str_contains(cap_list, cap) { rejected.append(cap) }
        }
    }
    if len(rejected) > 0 {
        let sorted_rej = tool_sort_strings(rejected)
        if mode == "deny" {
            report_error(file, "W5006", 1, 1, "Capability policy denied modeled capabilities: " + join_strings(sorted_rej, ", "))
        } else {
            report_error(file, "W5006", 1, 1, "Capability policy does not allow modeled capabilities: " + join_strings(sorted_rej, ", "))
        }
    }
    let all_caps = sandbox_all_capabilities()
    let mut lines: list[str] = ["/* Enforced Wysna capability sandbox policy */", "#define WYSNA_SANDBOX_ENFORCED 1"]
    for cap in all_caps {
        let denied = if mode == "deny" { tool_str_contains(cap_list, cap) } else { not tool_str_contains(cap_list, cap) }
        if denied {
            let macro_name = sandbox_cap_macro(cap)
            if macro_name != "" { lines.append("#define " + macro_name + " 1") }
        }
    }
    return join_strings(lines, "\n") + "\n"
}

# W6003 only reports definite coverage; guards never add unconditional coverage.
fn lint_pattern_bounds(program: CheckedProgram, id: int) -> list[int] {
    let pattern = program.patterns[id]
    let mut bounds: list[int] = []
    if program.types[pattern.type_id].kind != "int" { return bounds }
    if pattern.name == "range" or pattern.name == "range_inclusive" {
        let lower = program.patterns[pattern.children[0]].name
        let upper = program.patterns[pattern.children[1]].name
        bounds = [int(slice(lower, 8, len(lower))), int(slice(upper, 8, len(upper)))]
        if pattern.name == "range" { bounds[1] = bounds[1] - 1 }
    } elif len(pattern.name) >= 8 and slice(pattern.name, 0, 8) == "literal:" {
        let value = int(slice(pattern.name, 8, len(pattern.name)))
        bounds = [value, value]
    }
    return bounds
}
fn lint_expand_or(program: CheckedProgram, ids: list[int]) -> list[int] {
    let mut result: list[int] = []
    for id in ids {
        if program.patterns[id].name == "or" { for child in lint_expand_or(program, program.patterns[id].children) { result.append(child) } }
        else { result.append(id) }
    }
    return result
}
fn lint_pattern_subsumed(program: CheckedProgram, previous: list[int], id: int) -> bool {
    let patterns = lint_expand_or(program, previous)
    for earlier in patterns { if program.patterns[earlier].name == "*" { return true } }
    let query = program.patterns[id]
    if query.name == "or" {
        for child in query.children { if not lint_pattern_subsumed(program, patterns, child) { return false } }
        return true
    }
    let range = lint_pattern_bounds(program, id)
    if len(range) == 2 {
        let mut point = range[0]
        while true {
            let mut found = false
            let mut maximum = point
            for earlier in patterns {
                let bound = lint_pattern_bounds(program, earlier)
                if len(bound) == 2 and bound[0] <= point and point <= bound[1] {
                    if not found or bound[1] > maximum { maximum = bound[1] }
                    found = true
                }
            }
            if not found { return false }
            if maximum >= range[1] { return true }
            point = maximum + 1
        }
    }
    for earlier in patterns {
        let pattern = program.patterns[earlier]
        if pattern.name == query.name and pattern.type_id == query.type_id and len(pattern.children) == len(query.children) {
            let mut covered = true
            for index in 0..len(query.children) {
                if not lint_pattern_subsumed(program, [pattern.children[index]], query.children[index]) { covered = false }
            }
            if covered { return true }
        }
    }
    return false
}
# Agent-first semantic graph, symbol inspection, hash-guarded checked patching, and diagnostic explain tools.
# Shared host externs live in 01_tool_common.wysna.

struct ToolUncertainCall {
    kind: str
    callee: str
    file: str
    line: int
    reason: str
    candidate_owners: list[str]
}

class ToolGraphNode {
    attributes: list[StaticAttribute]
    architecture_role: str
    role_schema: bool
    id: str
    name: str
    qualified_name: str
    kind: str
    module_name: str
    file: str
    line: int
    col: int
    end_line: int
    start_byte: int
    end_byte: int
    start_char: int
    end_char: int
    visibility: str
    is_async: bool
    indirect_call: bool
    signature: str
    owner: str
    super_class: str
    implements_list: list[str]
    implemented_by: list[str]
    subclasses: list[str]
    instantiates: list[str]
    instantiated_by: list[str]
    calls: list[str]
    called_by: list[str]
    uses_types: list[str]
    used_by: list[str]
    effects: list[str]
    capabilities: list[str]
    variants: list[str]
    uncertain_calls: list[ToolUncertainCall]

    fn init(id: str, name: str, qualified_name: str, kind: str, module_name: str, file: str, line: int, col: int, end_line: int, start_byte: int, end_byte: int, start_char: int, end_char: int, visibility: str, is_async: bool, signature: str, owner: str) {
        this.id = id
        let metadata: list[StaticAttribute] = []
        this.attributes = metadata
        this.architecture_role = ""
        this.role_schema = false""
        this.name = name
        this.qualified_name = qualified_name
        this.kind = kind
        this.module_name = module_name
        this.file = file
        this.line = line
        this.col = col
        this.end_line = end_line
        this.start_byte = start_byte
        this.end_byte = end_byte
        this.start_char = start_char
        this.end_char = end_char
        this.visibility = visibility
        this.is_async = is_async
        this.indirect_call = false
        this.signature = signature
        this.owner = owner
        this.super_class = ""
        let l0: list[str] = []
        this.implements_list = l0
        let l1: list[str] = []
        this.implemented_by = l1
        let l2: list[str] = []
        this.subclasses = l2
        let l3: list[str] = []
        this.instantiates = l3
        let l4: list[str] = []
        this.instantiated_by = l4
        let l5: list[str] = []
        this.calls = l5
        let l6: list[str] = []
        this.called_by = l6
        let l7: list[str] = []
        this.uses_types = l7
        let l8: list[str] = []
        this.used_by = l8
        let l9: list[str] = []
        this.effects = l9
        let l10: list[str] = []
        this.capabilities = l10
        let l11: list[str] = []
        this.variants = l11
        let l12: list[ToolUncertainCall] = []
        this.uncertain_calls = l12
    }

    fn add_uncertain(kind: str, callee: str, file: str, line: int, reason: str, candidate_owners: list[str]) -> unit {
        let label = if callee == "" { "<indirect>" } else { callee }
        for item in this.uncertain_calls {
            if item.kind == kind and item.callee == label and item.file == file and item.line == line {
                return
            }
        }
        this.uncertain_calls.append(ToolUncertainCall { kind: kind, callee: label, file: file, line: line, reason: reason, candidate_owners: candidate_owners })
    }

    fn add_tag(slot: str, value: str) -> unit {
        if value == "" { return }
        if slot == "implements" and not tool_str_contains(this.implements_list, value) { this.implements_list.append(value) }
        elif slot == "implemented_by" and not tool_str_contains(this.implemented_by, value) { this.implemented_by.append(value) }
        elif slot == "subclasses" and not tool_str_contains(this.subclasses, value) { this.subclasses.append(value) }
        elif slot == "instantiates" and not tool_str_contains(this.instantiates, value) { this.instantiates.append(value) }
        elif slot == "instantiated_by" and not tool_str_contains(this.instantiated_by, value) { this.instantiated_by.append(value) }
        elif slot == "calls" and not tool_str_contains(this.calls, value) { this.calls.append(value) }
        elif slot == "called_by" and not tool_str_contains(this.called_by, value) { this.called_by.append(value) }
        elif slot == "uses_types" and not tool_str_contains(this.uses_types, value) { this.uses_types.append(value) }
        elif slot == "used_by" and not tool_str_contains(this.used_by, value) { this.used_by.append(value) }
        elif slot == "effects" and not tool_str_contains(this.effects, value) { this.effects.append(value) }
        elif slot == "capabilities" and not tool_str_contains(this.capabilities, value) { this.capabilities.append(value) }
        elif slot == "variants" and not tool_str_contains(this.variants, value) { this.variants.append(value) }
    }
}

struct ToolGraphEdge {
    from_id: str
    to_id: str
    kind: str
    context: str
    file: str
    line: int
}

struct ToolSpan {
    start_char: int
    end_char: int
    start_byte: int
    end_byte: int
    start_line: int
    end_line: int
}

class ToolGraph {
    entry_file: str
    entry_source: str
    graph_hash: str
    nodes: list[ToolGraphNode]
    edges: list[ToolGraphEdge]
    mod_names: list[str]
    module_dependencies: list[ModuleDependency]
    callable_indexes: dict[str, int]
    node_indexes: dict[str, int]
    nominal_ids: dict[str, str]
    dispatch_cache: dict[str, list[str]]

    fn init(entry_file: str, entry_source: str) {
        this.entry_file = entry_file
        this.entry_source = entry_source
        this.graph_hash = ""
        let n0: list[ToolGraphNode] = []
        this.nodes = n0
        let e0: list[ToolGraphEdge] = []
        this.edges = e0
        let m0: list[str] = []
        this.mod_names = m0
        this.module_dependencies = []
        let callables: dict[str, int] = {}
        this.callable_indexes = callables
        this.node_indexes = {}
        this.nominal_ids = {}
        this.dispatch_cache = {}
    }
}

# tool_str_contains, tool_str_gt, tool_sort_strings, tool_str_list_json live in 01_tool_common.wysna.

fn tool_module_tag(raw: str) -> str {
    let prefix = "__wysna_module_"
    if len(raw) > len(prefix) and slice(raw, 0, len(prefix)) == prefix {
        for i in len(prefix)..len(raw) - 1 {
            if slice(raw, i, i + 2) == "__" {
                return "mod_" + slice(raw, len(prefix), i)
            }
        }
    }
    return "entry"
}

fn tool_qualified_name(raw: str) -> str {
    let tag = tool_module_tag(raw)
    let short = tool_short_name(raw)
    if tag == "entry" { return short }
    return tag + "::" + short
}

fn tool_format_type(program: CheckedProgram, type_id: int) -> str {
    if type_id < 0 or type_id >= len(program.types) { return "unknown" }
    let t = program.types[type_id]
    if t.kind == "int" or t.kind == "float" or t.kind == "bool" or t.kind == "str" or t.kind == "unit" or t.kind == "none" or t.kind == "opaque" {
        return t.kind
    }
    if t.kind == "optional" and len(t.args) == 1 { return tool_format_type(program, t.args[0]) + "?" }
    if t.kind == "list" and len(t.args) == 1 { return "list[" + tool_format_type(program, t.args[0]) + "]" }
    if t.kind == "weak" and len(t.args) == 1 { return "Weak[" + tool_format_type(program, t.args[0]) + "]" }
    if t.kind == "dict" and len(t.args) == 2 {
        return "dict[" + tool_format_type(program, t.args[0]) + ", " + tool_format_type(program, t.args[1]) + "]"
    }
    if t.kind == "result" and len(t.args) == 2 {
        return tool_format_type(program, t.args[0]) + " ! " + tool_format_type(program, t.args[1])
    }
    if t.kind == "tuple" {
        let mut items: list[str] = []
        for a in t.args { items.append(tool_format_type(program, a)) }
        return "tuple[" + join_strings(items, ", ") + "]"
    }
    if t.kind == "function" and len(t.args) >= 1 {
        let mut p_strs: list[str] = []
        for i in 0..len(t.args) - 1 { p_strs.append(tool_format_type(program, t.args[i])) }
        let ret_s = tool_format_type(program, t.args[len(t.args) - 1])
        return "fn(" + join_strings(p_strs, ", ") + ") -> " + ret_s
    }
    let short = tool_short_name(t.name)
    if len(t.args) > 0 {
        let mut a_strs: list[str] = []
        for a in t.args { a_strs.append(tool_format_type(program, a)) }
        return short + "[" + join_strings(a_strs, ", ") + "]"
    }
    return short
}

fn tool_format_signature(program: CheckedProgram, short_name: str, params: list[str], type_id: int, is_async: bool) -> str {
    let mut prefix = if is_async { "async fn " } else { "fn " }
    prefix = prefix + short_name + "("
    if type_id < 0 or type_id >= len(program.types) {
        return prefix + ") -> unit"
    }
    let t = program.types[type_id]
    let mut param_parts: list[str] = []
    for i in 0..len(params) {
        let p_type = if i < len(t.args) - 1 { tool_format_type(program, t.args[i]) } else { "unknown" }
        param_parts.append(params[i] + ": " + p_type)
    }
    let ret_type = if len(t.args) > 0 { tool_format_type(program, t.args[len(t.args) - 1]) } else { "unit" }
    return prefix + join_strings(param_parts, ", ") + ") -> " + ret_type
}

fn tool_is_decl_modifier(tok: Token) -> bool {
    if tok.kind == "PUB" or tok.kind == "PRIV" { return true }
    if tok.kind == "IDENT" and (tok.val == "async" or tok.val == "pub" or tok.val == "priv") { return true }
    return false
}

fn tool_token_span(src: str, file: str, decl_line: int, decl_col: int, has_brace: bool, tokens: list[Token]) -> ToolSpan {
    let mut target_idx = -1
    for idx in 0..len(tokens) {
        let tok = tokens[idx]
        if tok.line == decl_line and tok.col >= decl_col {
            target_idx = idx
            break
        }
        if tok.line > decl_line {
            target_idx = idx
            break
        }
    }
    if target_idx < 0 {
        let off = diag_char_offset_at(src, decl_line, decl_col)
        let clamped = if off < 0 { 0 } else { off }
        let b = diag_utf8_byte_at(src, clamped)
        return ToolSpan { start_char: clamped, end_char: clamped, start_byte: b, end_byte: b, start_line: decl_line, end_line: decl_line }
    }
    let mut start_idx = target_idx
    while start_idx > 0 and tool_is_decl_modifier(tokens[start_idx - 1]) {
        if tokens[start_idx].line - tokens[start_idx - 1].line > 1 { break }
        start_idx = start_idx - 1
    }
    let start_tok = tokens[start_idx]
    let start_char = diag_char_offset_at(src, start_tok.line, start_tok.col)
    let mut end_line = start_tok.line
    let mut end_char = start_char
    if has_brace {
        let mut depth = 0
        let mut opened = false
        let mut end_tok = tokens[target_idx]
        for cur in target_idx..len(tokens) {
            let t = tokens[cur]
            if t.kind == "EOF" { break }
            if t.kind == "LBRACE" {
                depth = depth + 1
                opened = true
            } elif t.kind == "RBRACE" and opened {
                depth = depth - 1
                if depth == 0 {
                    end_tok = t
                    break
                }
            }
        }
        end_line = end_tok.line
        let e_off = diag_char_offset_at(src, end_tok.line, end_tok.col)
        end_char = if e_off >= 0 { e_off + len(end_tok.val) } else { start_char }
        if end_char == e_off and end_tok.kind == "RBRACE" { end_char = e_off + 1 }
    } else {
        let mut depth = 0
        let mut last_tok = tokens[target_idx]
        for cur in target_idx..len(tokens) {
            let t = tokens[cur]
            if t.kind == "EOF" { break }
            if t.kind == "LPAREN" or t.kind == "LBRACKET" or t.kind == "LBRACE" {
                depth = depth + 1
            } elif (t.kind == "RPAREN" or t.kind == "RBRACKET" or t.kind == "RBRACE") and depth > 0 {
                depth = depth - 1
            } elif depth == 0 and (t.kind == "NEWLINE" or t.kind == "SEMICOLON") {
                break
            }
            if t.kind != "NEWLINE" { last_tok = t }
        }
        end_line = last_tok.line
        let e_off = diag_char_offset_at(src, last_tok.line, last_tok.col)
        let tok_len = if last_tok.kind == "STR" { len(last_tok.val) + 2 } elif len(last_tok.val) > 0 { len(last_tok.val) } else { 1 }
        end_char = if e_off >= 0 { e_off + tok_len } else { start_char }
    }
    if end_char < start_char { end_char = start_char }
    let start_byte = diag_utf8_byte_at(src, start_char)
    let end_byte = diag_utf8_byte_at(src, end_char)
    return ToolSpan { start_char: start_char, end_char: end_char, start_byte: start_byte, end_byte: end_byte, start_line: start_tok.line, end_line: end_line }
}

fn tool_find_node_idx(graph: ToolGraph, node_id: str) -> int {
    return graph.node_indexes.get(node_id) ?? -1
}

fn tool_add_graph_node(graph: ToolGraph, node: ToolGraphNode) -> unit {
    graph.node_indexes[node.id] = len(graph.nodes)
    graph.nodes.append(node)
}

fn tool_module_label(graph: ToolGraph, file: str) -> str {
    if file == graph.entry_file { return "entry" }
    let label = tool_basename(file)
    for other in graph.mod_names {
        if other != file and other != graph.entry_file and tool_basename(other) == label { return file }
    }
    return label
}

fn tool_symbol_candidates(graph: ToolGraph, query: str) -> list[int] {
    let mut ids: list[int] = []
    let mut qualified: list[int] = []
    let mut names: list[int] = []
    let mut suffixes: list[int] = []
    for i in 0..len(graph.nodes) {
        let node = graph.nodes[i]
        if node.id == query { ids.append(i) }
        elif node.name != query and node.qualified_name == query { qualified.append(i) }
        elif node.name == query { names.append(i) }
        elif len(node.qualified_name) > len(query) {
            let end = len(node.qualified_name)
            let suffix = slice(node.qualified_name, end - len(query) - 1, end)
            if suffix == ":" + query or suffix == "." + query { suffixes.append(i) }
        }
    }
    if len(ids) > 0 { return ids }
    if len(qualified) > 0 { return qualified }
    if len(names) > 0 { return names }
    return suffixes
}

fn tool_require_symbol(graph: ToolGraph, query: str, command: str, json_mode: bool) -> int {
    let matches = tool_symbol_candidates(graph, query)
    if len(matches) == 1 { return matches[0] }
    let mut code = "W1001"
    let mut message = "Symbol '" + query + "' not found in semantic graph"
    let mut data = "{}"
    if len(matches) > 1 {
        let mut by_id: dict[str, str] = {}
        let mut ids: list[str] = []
        for index in matches {
            let node = graph.nodes[index]
            ids.append(node.id)
            let src = if node.file == graph.entry_file { graph.entry_source } else { diag_read_snippet_source(node.file) }
            let span = diag_primary_span_json(node.file, node.line, node.col, src)
            by_id[node.id] = "{\"id\":" + diag_json_quote(node.id) +
                ",\"qualified_name\":" + diag_json_quote(node.qualified_name) +
                ",\"kind\":" + diag_json_quote(node.kind) + ",\"file\":" + diag_json_quote(node.file) +
                ",\"line\":" + str(node.line) + ",\"col\":" + str(node.col) +
                ",\"signature\":" + diag_json_quote(node.signature) + ",\"span\":" + span + "}"
        }
        let mut rows: list[str] = []
        let ordered = tool_sort_strings(ids)
        for id in ordered { rows.append(by_id[id]) }
        code = "W1005"
        message = "Ambiguous symbol '" + query + "'; pass a candidate ID to --symbol: " + join_strings(ordered, ", ")
        data = "{\"kind\":\"ambiguous_symbol\",\"symbol\":" + diag_json_quote(query) +
            ",\"graph_hash\":" + diag_json_quote(graph.graph_hash) + ",\"candidates\":[" + join_strings(rows, ",") + "]}"
    }
    if json_mode {
        let diag = diag_record_json_data(code, command, "error", message, graph.entry_file, 0, 0, "", data)
        diag_write_output(diag_tool_envelope_json(command, "diagnostic_error", 1, "[" + diag + "]", "", "", "[]"))
    } else {
        eprint("[" + code + "] " + message)
    }
    exit(1)
    return -1
}

fn tool_callable_index(graph: ToolGraph, file: str, name: str) -> int {
    return graph.callable_indexes.get(file + "\n" + tool_short_name(name)) ?? -1
}

fn tool_checked_callable_index(graph: ToolGraph, file: str, owner: str, declaration: str) -> int {
    return tool_callable_index(graph, file, tool_short_name(owner) + tool_short_name(declaration))
}

fn tool_add_edge(graph: ToolGraph, from_id: str, to_id: str, kind: str, context: str, file: str, line: int) -> unit {
    for e in graph.edges {
        if e.from_id == from_id and e.to_id == to_id and e.kind == kind and e.context == context and e.line == line {
            return
        }
    }
    graph.edges.append(ToolGraphEdge { from_id: from_id, to_id: to_id, kind: kind, context: context, file: file, line: line })
}

fn tool_module_index(graph: ToolGraph, file: str) -> int {
    for i in 0..len(graph.mod_names) {
        if graph.mod_names[i] == file { return i }
    }
    return -1
}

fn tool_checked_name_file(graph: ToolGraph, raw_name: str) -> str {
    let tag = tool_module_tag(raw_name)
    if tag == "entry" { return graph.entry_file }
    let index = lsp_parse_int(slice(tag, 4, len(tag)), -1)
    return if index >= 0 and index < len(graph.mod_names) { graph.mod_names[index] } else { "" }
}

fn tool_resolve_nominal_id(graph: ToolGraph, raw_name: str) -> str {
    let short = tool_short_name(raw_name)
    let file = tool_checked_name_file(graph, raw_name)
    return graph.nominal_ids.get(file + "\n" + short) ?? ""
}

fn tool_collect_type_deps(program: CheckedProgram, graph: ToolGraph, type_id: int, from_idx: int, context: str, file: str, line: int) -> unit {
    if type_id < 0 or type_id >= len(program.types) or from_idx < 0 { return }
    let t = program.types[type_id]
    if t.kind == "interface" or t.kind == "class" or t.kind == "struct" or t.kind == "enum" {
        let target_id = tool_resolve_nominal_id(graph, t.name)
        let from_id = graph.nodes[from_idx].id
        if target_id != "" and target_id != from_id {
            let target_idx = tool_find_node_idx(graph, target_id)
            if target_idx >= 0 {
                graph.nodes[from_idx].add_tag("uses_types", target_id)
                graph.nodes[target_idx].add_tag("used_by", from_id)
                tool_add_edge(graph, from_id, target_id, "uses_type", context, file, line)
            }
        }
    }
    for arg_tid in t.args {
        tool_collect_type_deps(program, graph, arg_tid, from_idx, context, file, line)
    }
}

fn tool_runtime_effect(fn_name: str) -> str {
    if fn_name == "print" or fn_name == "eprint" { return "stdio.write" }
    if fn_name == "read_file" { return "filesystem.read" }
    if fn_name == "write_file" { return "filesystem.write" }
    if fn_name == "args" { return "arguments.read" }
    if fn_name == "env" { return "environment.read" }
    if fn_name == "unix_time" { return "clock.read" }
    if fn_name == "exit" { return "process.exit" }
    if len(fn_name) >= 5 and slice(fn_name, 0, 5) == "http_" { return "network.http" }
    return ""
}

fn tool_effect_to_cap(eff: str) -> str {
    if eff == "stdio.write" or eff == "stdio.read" { return "stdio" }
    if eff == "arguments.read" { return "arguments" }
    if eff == "environment.read" { return "environment" }
    if eff == "clock.read" { return "clock" }
    if eff == "filesystem.read" { return "filesystem.read" }
    if eff == "filesystem.write" { return "filesystem.write" }
    if eff == "network.http" { return "network" }
    if eff == "process.spawn" or eff == "process.wait" { return "processes" }
    if eff == "process.exit" { return "process-control" }
    if eff == "ffi.native" { return "native-ffi" }
    return ""
}

# tool_basename lives in 01_tool_common.wysna.

fn tool_scan_decl_nodes(graph: ToolGraph, program: CheckedProgram, src: str, file: str) -> unit {
    let is_entry = file == graph.entry_file
    let mod_label = tool_module_label(graph, file)
    let tokens = tokenize(src, file)
    let mut depth = 0
    let mut current_owner_idx = -1
    let mut current_owner_name = ""
    let mut current_owner_kind = ""
    let mut is_public = false
    let mut is_async = false
    let mut attributes: list[StaticAttribute] = []
    let mut attribute_start = -1
    let mut i = 0
    while i < len(tokens) - 1 {
        let tok = tokens[i]
        if depth == 0 and tok.kind == "AT" {
            attribute_start = i
            let metadata = SemanticContext(false)
            metadata.tokens = tokens
            metadata.pos = i
            attributes = sem_static_attributes(metadata)
            i = metadata.pos
            continue
        }
        if tok.kind == "PUB" or (tok.kind == "IDENT" and tok.val == "pub") {
            is_public = true
            i = i + 1
            continue
        }
        if tok.kind == "IDENT" and tok.val == "async" {
            is_async = true
            i = i + 1
            continue
        }
        if tok.kind == "LBRACE" {
            depth = depth + 1
            i = i + 1
            continue
        }
        if tok.kind == "RBRACE" {
            if depth > 0 { depth = depth - 1 }
            if depth == 0 {
                current_owner_idx = -1
                current_owner_name = ""
                current_owner_kind = ""
            }
            is_public = false
            is_async = false
            i = i + 1
            continue
        }
        if depth == 0 and (tok.kind == "INTERFACE" or tok.kind == "CLASS" or tok.kind == "STRUCT" or tok.kind == "ENUM") {
            let mut decl_kind = "struct"
            if tok.kind == "INTERFACE" { decl_kind = "interface" }
            elif tok.kind == "CLASS" { decl_kind = "class" }
            elif tok.kind == "ENUM" { decl_kind = "enum" }
            if i + 1 < len(tokens) and tokens[i + 1].kind == "IDENT" {
                let name = tokens[i + 1].val
                let qname = if is_entry { name } else { mod_label + "::" + name }
                let start = if attribute_start >= 0 { tokens[attribute_start] } else { tok }
                let span = tool_token_span(src, file, start.line, start.col, true, tokens)
                let vis = if is_public { "public" } else { "private" }
                let nid = decl_kind + ":" + qname
                let node = ToolGraphNode(nid, name, qname, decl_kind, mod_label, file, span.start_line, tok.col, span.end_line, span.start_byte, span.end_byte, span.start_char, span.end_char, vis, false, "", "")
                if decl_kind == "class" and len(attributes) > 0 {
                    let module_index = tool_module_index(graph, file)
                    let raw = if is_entry { name } else { module_name(module_index, name) }
                    let empty: list[StaticAttribute] = []
                    let resolved = program.class_attributes.get(raw) ?? empty
                    let mut metadata: list[StaticAttribute] = []
                    for j in 0..len(resolved) {
                        let attr = resolved[j]
                        metadata.append(StaticAttribute {
                            name: attributes[j].name, message: attr.message, arguments: attr.arguments, source: attr.source,
                            schema_file: tool_checked_name_file(graph, attr.name), schema_name: tool_short_name(attr.name),
                        })
                    }
                    node.attributes = metadata
                }
                attributes = []
                attribute_start = -1
                current_owner_idx = len(graph.nodes)
                current_owner_name = name
                current_owner_kind = decl_kind
                graph.nominal_ids[file + "\n" + name] = nid
                tool_add_graph_node(graph, node)
            }
            is_public = false
            is_async = false
            i = i + 1
            continue
        }
        if depth == 0 and (tok.kind == "FN" or tok.kind == "EXTERN") {
            let is_extern = tok.kind == "EXTERN"
            let mut name_pos = i + 1
            if is_extern {
                while name_pos < len(tokens) and tokens[name_pos].kind != "FN" { name_pos = name_pos + 1 }
                name_pos = name_pos + 1
            }
            if name_pos < len(tokens) and tokens[name_pos].kind == "IDENT" {
                let name = tokens[name_pos].val
                let qname = if is_entry { name } else { mod_label + "::" + name }
                let span = tool_token_span(src, file, tok.line, tok.col, not is_extern, tokens)
                let decl_kind = if is_extern { "extern" } else { "fn" }
                let vis = if is_public { "public" } else { "private" }
                let nid = decl_kind + ":" + qname
                let mut sig_str = (if is_async { "async fn " } else { "fn " }) + name + "()"
                for sig in program.signatures {
                    if sig.source.file == file and tool_short_name(sig.name) == name {
                        sig_str = tool_format_signature(program, name, sig.params, sig.type_id, is_async)
                        break
                    }
                }
                let node = ToolGraphNode(nid, name, qname, decl_kind, mod_label, file, span.start_line, tok.col, span.end_line, span.start_byte, span.end_byte, span.start_char, span.end_char, vis, is_async, sig_str, "")
                node.attributes = attributes
                let empty_metadata: list[StaticAttribute] = []
                attributes = empty_metadata
                attribute_start = -1
                if is_extern {
                    node.effects.append("ffi.native")
                    node.capabilities.append("native-ffi")
                }
                graph.callable_indexes[file + "\n" + name] = len(graph.nodes)
                tool_add_graph_node(graph, node)
            }
            is_public = false
            is_async = false
            if is_extern and name_pos < len(tokens) {
                i = name_pos + 1
            } else {
                i = i + 1
            }
            continue
        }
        if depth == 1 and current_owner_idx >= 0 and tok.kind == "FN" and i + 1 < len(tokens) and tokens[i + 1].kind == "IDENT" {
            let mname = tokens[i + 1].val
            let is_iface = current_owner_kind == "interface"
            let mkind = if is_iface { "interface_method" } else { "method" }
            let span = tool_token_span(src, file, tok.line, tok.col, not is_iface, tokens)
            let short_q = current_owner_name + "." + mname
            let qname = if is_entry { short_q } else { mod_label + "::" + short_q }
            let nid = "method:" + qname
            let vis = if is_public { "public" } else { "private" }
            let mut sig_str = "fn " + mname + "()"
            for sig in program.signatures {
                if sig.source.file == file and tool_short_name(sig.name) == short_q {
                    sig_str = tool_format_signature(program, mname, sig.params, sig.type_id, is_async)
                    break
                }
            }
            let mnode = ToolGraphNode(nid, mname, qname, mkind, mod_label, file, span.start_line, tok.col, span.end_line, span.start_byte, span.end_byte, span.start_char, span.end_char, vis, is_async, sig_str, graph.nodes[current_owner_idx].id)
            graph.callable_indexes[file + "\n" + short_q] = len(graph.nodes)
            tool_add_graph_node(graph, mnode)
            is_public = false
            is_async = false
            i = i + 1
            continue
        }
        if tok.kind != "NEWLINE" {
            is_public = false
            is_async = false
        }
        i = i + 1
    }
}

fn tool_dispatch_candidates(graph: ToolGraph, receiver: int, member: str, direct: int) -> list[str] {
    if receiver < 0 { return [] }
    let receiver_id = graph.nodes[receiver].id
    let cache_key = receiver_id + "\n" + member + "\n" + str(direct)
    let cached = graph.dispatch_cache.get(cache_key)
    if cached != None {
        let empty: list[str] = []
        return cached ?? empty
    }
    let mut owners: list[str] = []
    for candidate in graph.nodes {
        if candidate.kind != "class" or candidate.id == receiver_id { continue }
        let mut current_idx = tool_find_node_idx(graph, candidate.id)
        let mut method_idx = -1
        let mut compatible = false
        while current_idx >= 0 {
            let current = graph.nodes[current_idx]
            if method_idx < 0 { method_idx = tool_callable_index(graph, current.file, current.name + "." + member) }
            if current.id == receiver_id or tool_str_contains(current.implements_list, receiver_id) { compatible = true }
            current_idx = tool_find_node_idx(graph, current.super_class)
        }
        if compatible and method_idx >= 0 and method_idx != direct {
            let owner = graph.nodes[method_idx].owner
            if not tool_str_contains(owners, owner) { owners.append(owner) }
        }
    }
    let sorted = tool_sort_strings(owners)
    graph.dispatch_cache[cache_key] = sorted
    return sorted
}

fn tool_walk_subtree(program: CheckedProgram, graph: ToolGraph, caller_idx: int, node_idx: int) -> unit {
    if node_idx < 0 or node_idx >= len(program.nodes) { return }
    let node = program.nodes[node_idx]
    let caller_id = graph.nodes[caller_idx].id
    let line = node.source.line
    let file = node.source.file
    if node.type_id >= 0 and node.type_id < len(program.types) {
        let kind = program.types[node.type_id].kind
        if kind == "class" or kind == "interface" or kind == "struct" or kind == "enum" {
            tool_collect_type_deps(program, graph, node.type_id, caller_idx, "expression", file, line)
        }
    }
    if node.kind == "indirect_call" or node.kind == "virtual_call" {
        graph.nodes[caller_idx].indirect_call = true
    }
    if node.kind == "indirect_call" {
        let ind_name = if node.text != "" { tool_short_name(node.text) } else { "<indirect>" }
        graph.nodes[caller_idx].add_uncertain("indirect_call", ind_name, file, line, "indirect call through function value or closure", [])
    }
    if node.kind == "callee" and node.target >= 0 {
        let signature = program.signatures[node.target]
        let target_idx = tool_checked_callable_index(graph, signature.source.file, signature.owner, signature.declaration_name)
        if target_idx >= 0 {
            tool_add_edge(graph, caller_id, graph.nodes[target_idx].id, "references_function", signature.name, file, line)
        }
    }
    if node.kind == "new" or node.kind == "struct" or node.kind == "struct_call" {
        let t = program.types[node.type_id]
        let target_id = tool_resolve_nominal_id(graph, t.name)
        if target_id != "" {
            let target_idx = tool_find_node_idx(graph, target_id)
            if target_idx >= 0 {
                graph.nodes[caller_idx].add_tag("instantiates", target_id)
                graph.nodes[target_idx].add_tag("instantiated_by", caller_id)
                tool_add_edge(graph, caller_id, target_id, "instantiates", node.kind, file, line)
                if node.kind == "new" {
                    let target = graph.nodes[target_idx]
                    let constructor = tool_callable_index(graph, target.file, target.name + ".init")
                    if constructor >= 0 {
                        let init_id = graph.nodes[constructor].id
                        graph.nodes[caller_idx].add_tag("calls", init_id)
                        graph.nodes[constructor].add_tag("called_by", caller_id)
                        tool_add_edge(graph, caller_id, init_id, "calls", target.name + ".init", file, line)
                    }
                }
            }
        }
    } elif node.kind == "call" or node.kind == "method" or node.kind == "direct_method" or node.kind == "virtual_call" {
        let mut callee_short = tool_short_name(node.text)
        if len(node.labels) == 2 {
            let owner_short = tool_short_name(node.labels[0])
            callee_short = owner_short + "." + node.labels[1]
        }
        let mut target_idx = -1
        if node.target >= 0 and node.target < len(program.signatures) {
            let signature = program.signatures[node.target]
            target_idx = tool_checked_callable_index(graph, signature.source.file, signature.owner, signature.declaration_name)
        }
        if target_idx >= 0 {
            let target_id = graph.nodes[target_idx].id
            graph.nodes[caller_idx].add_tag("calls", target_id)
            graph.nodes[target_idx].add_tag("called_by", caller_id)
            tool_add_edge(graph, caller_id, target_id, "calls", callee_short, file, line)
            if graph.nodes[target_idx].kind == "extern" {
                graph.nodes[caller_idx].add_uncertain("extern_ffi", graph.nodes[target_idx].name, file, line, "foreign C ABI call", [])
            }
        }
        if node.kind == "virtual_call" and len(node.labels) == 2 {
            let receiver = tool_find_node_idx(graph, tool_resolve_nominal_id(graph, node.labels[0]))
            let candidates = tool_dispatch_candidates(graph, receiver, node.labels[1], target_idx)
            if receiver < 0 or graph.nodes[receiver].kind == "interface" or len(candidates) > 0 {
                graph.nodes[caller_idx].add_uncertain("virtual_dispatch", callee_short, file, line, "runtime receiver can select a different method", candidates)
            }
            if receiver >= 0 {
                tool_collect_type_deps(program, graph, program.nodes[node.children[0]].type_id, caller_idx, "call_receiver", file, line)
            }
        }
        let eff = tool_runtime_effect(callee_short)
        if eff != "" {
            graph.nodes[caller_idx].add_tag("effects", eff)
            let cap = tool_effect_to_cap(eff)
            if cap != "" { graph.nodes[caller_idx].add_tag("capabilities", cap) }
        }
    } elif node.kind == "let" {
        tool_collect_type_deps(program, graph, node.type_id, caller_idx, "let:" + node.text, file, line)
    }
    if node.kind == "closure" and node.target >= 0 and node.target < len(program.functions) {
        tool_walk_subtree(program, graph, caller_idx, program.functions[node.target].body)
    }
    for child_idx in node.children {
        tool_walk_subtree(program, graph, caller_idx, child_idx)
    }
    for arm_index in node.arms {
        let arm = program.arms[arm_index]
        tool_walk_subtree(program, graph, caller_idx, arm.guard)
        tool_walk_subtree(program, graph, caller_idx, arm.body)
    }
}

fn tool_build_graph_with_overlays(src: str, file: str, ov_paths: list[str], ov_texts: list[str]) -> ToolGraph {
    let canonical = module_canonical(file)
    let loader = ModuleLoader()
    loader.track_dependencies = true
    loader.ov_paths = ov_paths
    loader.ov_texts = ov_texts
    let program = check_program(module_finish(loader, src, canonical), canonical, true)
    for node in program.nodes {
        if node.kind == "unsupported" { report_error_at("W2013", node.source, "Compiler native-core-v1 does not support expression " + node.text) }
    }
    return tool_build_checked_graph(src, canonical, loader, program, false)
}

fn tool_build_checked_graph(src: str, canonical: str, loader: ModuleLoader, program: CheckedProgram, include_entry: bool) -> ToolGraph {
    let graph = ToolGraph(canonical, src)
    graph.mod_names = loader.paths
    graph.module_dependencies = loader.dependencies
    let mut mod_hashes: list[str] = [canonical + "=" + diag_sha256_hex(src)]
    tool_scan_decl_nodes(graph, program, src, canonical)
    for file in graph.mod_names {
        if file == canonical { continue }
        let ext_res = module_read_with_overlays(file, loader.ov_paths, loader.ov_texts)
        if ext_res[0] == "1" {
            mod_hashes.append(file + "=" + diag_sha256_hex(ext_res[1]))
            tool_scan_decl_nodes(graph, program, ext_res[1], file)
        }
    }

    # Record class inheritance, interfaces, field type dependencies, and enum variants from CheckedRecords
    for record in program.records {
        let rtype = program.types[record.type_id]
        let r_id = tool_resolve_nominal_id(graph, rtype.name)
        if r_id == "" { continue }
        let r_idx = tool_find_node_idx(graph, r_id)
        if r_idx < 0 { continue }
        if record.parent >= 0 {
            let ptype = program.types[record.parent]
            let p_id = tool_resolve_nominal_id(graph, ptype.name)
            if p_id != "" {
                graph.nodes[r_idx].super_class = p_id
                let p_idx = tool_find_node_idx(graph, p_id)
                if p_idx >= 0 { graph.nodes[p_idx].add_tag("subclasses", r_id) }
                tool_add_edge(graph, r_id, p_id, "extends", ptype.name, canonical, graph.nodes[r_idx].line)
            }
        }
        for iface_tid in record.interfaces {
            let itype = program.types[iface_tid]
            let i_id = tool_resolve_nominal_id(graph, itype.name)
            if i_id != "" {
                graph.nodes[r_idx].add_tag("implements", i_id)
                let i_idx = tool_find_node_idx(graph, i_id)
                if i_idx >= 0 { graph.nodes[i_idx].add_tag("implemented_by", r_id) }
                tool_add_edge(graph, r_id, i_id, "implements", itype.name, canonical, graph.nodes[r_idx].line)
                for m in record.methods {
                    let im_id = "method:" + graph.nodes[i_idx].qualified_name + "." + m.name
                    let cm_id = "method:" + graph.nodes[r_idx].qualified_name + "." + m.name
                    let im_idx = tool_find_node_idx(graph, im_id)
                    let cm_idx = tool_find_node_idx(graph, cm_id)
                    if im_idx >= 0 and cm_idx >= 0 {
                        graph.nodes[im_idx].add_tag("implemented_by", cm_id)
                        tool_add_edge(graph, cm_id, im_id, "implements_method", itype.name + "." + m.name, canonical, graph.nodes[cm_idx].line)
                    }
                }
            }
        }
        for f in record.fields {
            if rtype.kind == "struct" and len(rtype.args) == 0 and f.name == "role" and program.types[f.type_id].kind == "str" {
                graph.nodes[r_idx].role_schema = true
            }
            if f.owner == rtype.name {
                tool_collect_type_deps(program, graph, f.type_id, r_idx, "field:" + f.name, f.source.file, f.source.line)
            }
        }
        for v in record.variants {
            graph.nodes[r_idx].add_tag("variants", v.name)
        }
    }

    # Walk checked function bodies for calls, instantiations, signature type dependencies, and effects
    for fn_info in program.functions {
        if fn_info.closure { continue }
        let f_idx = tool_checked_callable_index(graph, fn_info.source.file, fn_info.owner, fn_info.declaration_name)
        if f_idx < 0 { continue }
        let fn_type = program.types[fn_info.type_id]
        let first_param = if graph.nodes[f_idx].owner == "" { 0 } else { 1 }
        for i in first_param..len(fn_type.args) {
            tool_collect_type_deps(program, graph, fn_type.args[i], f_idx, "signature", fn_info.source.file, graph.nodes[f_idx].line)
        }
        if fn_info.body >= 0 {
            tool_walk_subtree(program, graph, f_idx, fn_info.body)
        }
    }

    if include_entry and len(program.entry) > 0 {
        let idx = len(graph.nodes)
        let node = ToolGraphNode("fn:__entry__", "__entry__", "__entry__", "entrypoint", "entry", canonical, 1, 1, 1, 0, 0, 0, 0, "private", false, "", "")
        tool_add_graph_node(graph, node)
        for entry_node in program.entry {
            tool_walk_subtree(program, graph, idx, entry_node)
        }
    }

    # Propagate transitive effects up call edges (fixed point)
    let mut changed = true
    let mut steps = 0
    while changed and steps < len(graph.nodes) + 2 {
        changed = false
        steps = steps + 1
        for i in 0..len(graph.nodes) {
            for callee_id in graph.nodes[i].calls {
                let c_idx = tool_find_node_idx(graph, callee_id)
                if c_idx >= 0 {
                    for eff in graph.nodes[c_idx].effects {
                        if not tool_str_contains(graph.nodes[i].effects, eff) {
                            graph.nodes[i].effects.append(eff)
                            let cap = tool_effect_to_cap(eff)
                            if cap != "" { graph.nodes[i].add_tag("capabilities", cap) }
                            changed = true
                        }
                    }
                }
            }
        }
    }

    # Compute deterministic canonical graph_hash shared across engines
    graph.graph_hash = "graph:" + slice(diag_sha256_hex(join_strings(tool_sort_strings(mod_hashes), "\n")), 0, 16)
    return graph
}

fn tool_build_graph(src: str, file: str) -> ToolGraph {
    return tool_build_graph_with_overlays(src, file, [], [])
}

fn tool_edge_json(e: ToolGraphEdge) -> str {
    return "{\"from\":" + diag_json_quote(e.from_id) + ",\"to\":" + diag_json_quote(e.to_id) + ",\"kind\":" + diag_json_quote(e.kind) + ",\"context\":" + diag_json_quote(e.context) + ",\"file\":" + diag_json_quote(e.file) + ",\"line\":" + str(e.line) + "}"
}

fn tool_boundary_for_uncertain(kind: str) -> str {
    if kind == "virtual_dispatch" { return "virtual-dispatch" }
    if kind == "indirect_call" { return "indirect-call" }
    if kind == "extern_ffi" { return "c-ffi" }
    if kind == "unresolved_call" { return "unresolved-call" }
    return ""
}

fn tool_call_resolution_json(n: ToolGraphNode) -> str {
    let mut parts: list[str] = ["{\"resolved_calls\":" + tool_str_list_json(n.calls) + ",\"uncertain_calls\":["]
    for i in 0..len(n.uncertain_calls) {
        let u = n.uncertain_calls[i]
        if i > 0 { parts.append(",") }
        let candidates = if len(u.candidate_owners) == 0 { "" } else { ",\"candidate_owners\":" + tool_str_list_json(u.candidate_owners) }
        parts.append("{\"kind\":" + diag_json_quote(u.kind) + ",\"callee\":" + diag_json_quote(u.callee) + ",\"file\":" + diag_json_quote(u.file) + ",\"line\":" + str(u.line) + ",\"reason\":" + diag_json_quote(u.reason) + candidates + "}")
    }
    let complete_str = if len(n.uncertain_calls) == 0 { "true" } else { "false" }
    parts.append("],\"complete\":" + complete_str + "}")
    return join_strings(parts, "")
}

fn tool_boundaries_for_nodes_json(nodes: list[ToolGraphNode]) -> str {
    let mut tags: list[str] = []
    for n in nodes {
        for u in n.uncertain_calls {
            let tag = tool_boundary_for_uncertain(u.kind)
            if tag != "" and not tool_str_contains(tags, tag) { tags.append(tag) }
        }
        if n.indirect_call and not tool_str_contains(tags, "virtual-dispatch") and not tool_str_contains(tags, "indirect-call") {
            tags.append("indirect-call")
        }
    }
    return tool_str_list_json(tags)
}

fn tool_utf8_slice_budget(text: str, start_byte: int, has_budget: bool, max_bytes: int) -> list[str] {
    let raw = bytes(text)
    let total = len(raw)
    let mut first = if start_byte < total { start_byte } else { total }
    while first < total and raw[first] >= 128 and raw[first] < 192 { first = first + 1 }
    let mut last = if has_budget and max_bytes < total - first { first + max_bytes } else { total }
    while last < total and raw[last] >= 128 and raw[last] < 192 { last = last - 1 }
    if first == 0 and last == total { return [text, "0", str(total), str(total)] }
    if has_budget {
        let snippet = tool_utf8_bytes_to_str(slice(raw, first, last))
        return [snippet, str(first), str(last - first), str(total)]
    }
    let mut char_start = 0
    for i in 0..first {
        if raw[i] < 128 or raw[i] >= 192 { char_start = char_start + 1 }
    }
    let mut char_end = char_start
    for i in first..last {
        if raw[i] < 128 or raw[i] >= 192 { char_end = char_end + 1 }
    }
    return [slice(text, char_start, char_end), str(first), str(last - first), str(total)]
}

fn tool_node_json(n: ToolGraphNode) -> str {
    let mut p: list[str] = ["{\"id\":" + diag_json_quote(n.id)]
    if n.indirect_call { p.append(",\"indirect_call\":true") }
    if n.architecture_role != "" { p.append(",\"architecture_role\":" + diag_json_quote(n.architecture_role)) }
    p.append(",\"name\":" + diag_json_quote(n.name))
    p.append(",\"qualified_name\":" + diag_json_quote(n.qualified_name))
    p.append(",\"kind\":" + diag_json_quote(n.kind))
    p.append(",\"module\":" + diag_json_quote(n.module_name))
    p.append(",\"file\":" + diag_json_quote(n.file))
    p.append(",\"line\":" + str(n.line))
    p.append(",\"col\":" + str(n.col))
    p.append(",\"start_byte\":" + str(n.start_byte))
    p.append(",\"end_byte\":" + str(n.end_byte))
    p.append(",\"end_line\":" + str(n.end_line))
    p.append(",\"visibility\":" + diag_json_quote(n.visibility))
    p.append(",\"is_async\":" + (if n.is_async { "true" } else { "false" }))
    p.append(",\"signature\":" + diag_json_quote(n.signature))
    if n.kind == "fn" or n.kind == "class" { p.append(",\"attributes\":" + tool_attributes_json(n.attributes)) }
    p.append(",\"super_class\":" + (if n.super_class == "" { "null" } else { diag_json_quote(n.super_class) }))
    p.append(",\"implements\":" + tool_str_list_json(n.implements_list))
    p.append(",\"implemented_by\":" + tool_str_list_json(n.implemented_by))
    p.append(",\"subclasses\":" + tool_str_list_json(n.subclasses))
    p.append(",\"instantiates\":" + tool_str_list_json(n.instantiates))
    p.append(",\"instantiated_by\":" + tool_str_list_json(n.instantiated_by))
    p.append(",\"calls\":" + tool_str_list_json(n.calls))
    p.append(",\"called_by\":" + tool_str_list_json(n.called_by))
    p.append(",\"uses_types\":" + tool_str_list_json(n.uses_types))
    p.append(",\"used_by\":" + tool_str_list_json(n.used_by))
    p.append(",\"effects\":" + tool_str_list_json(n.effects))
    p.append(",\"capabilities\":" + tool_str_list_json(n.capabilities))
    p.append(",\"variants\":" + tool_str_list_json(n.variants))
    if n.kind == "fn" or n.kind == "method" or n.kind == "interface_method" or n.kind == "entrypoint" or len(n.uncertain_calls) > 0 {
        p.append(",\"call_resolution\":" + tool_call_resolution_json(n))
    }
    p.append("}")
    return join_strings(p, "")
}

fn tool_impact_ids(graph: ToolGraph, target_id: str) -> list[str] {
    let mut queue: list[str] = [target_id]
    let mut visited: list[str] = [target_id]
    let mut qhead = 0
    while qhead < len(queue) {
        let cur = queue[qhead]
        qhead = qhead + 1
        for e in graph.edges {
            if e.to_id == cur and not tool_str_contains(visited, e.from_id) {
                visited.append(e.from_id)
                queue.append(e.from_id)
            }
        }
    }
    return visited
}

fn tool_impact_json(graph: ToolGraph, target_id: str) -> str {
    let mut direct: list[str] = []
    let mut transitive: list[str] = []
    let visited = tool_impact_ids(graph, target_id)
    for e in graph.edges {
        if e.to_id == target_id and e.from_id != "" and not tool_str_contains(direct, e.from_id) { direct.append(e.from_id) }
    }
    for v in visited {
        if v != target_id { transitive.append(v) }
    }
    return "{\"target\":" + diag_json_quote(target_id) + ",\"direct_dependents\":" + tool_str_list_json(direct) + ",\"transitive_dependents\":" + tool_str_list_json(transitive) + ",\"impact_count\":" + str(len(transitive)) + "}"
}

fn tool_graph_summary_json(graph: ToolGraph) -> str {
    let mut ifaces = 0
    let mut classes = 0
    let mut structs = 0
    let mut enums = 0
    let mut fns = 0
    let mut methods = 0
    for n in graph.nodes {
        if n.kind == "interface" { ifaces = ifaces + 1 }
        elif n.kind == "class" { classes = classes + 1 }
        elif n.kind == "struct" { structs = structs + 1 }
        elif n.kind == "enum" { enums = enums + 1 }
        elif n.kind == "fn" { fns = fns + 1 }
        elif n.kind == "method" or n.kind == "interface_method" { methods = methods + 1 }
    }
    return "{\"modules\":" + str(len(graph.mod_names)) + ",\"nodes\":" + str(len(graph.nodes)) + ",\"edges\":" + str(len(graph.edges)) + ",\"interfaces\":" + str(ifaces) + ",\"classes\":" + str(classes) + ",\"structs\":" + str(structs) + ",\"enums\":" + str(enums) + ",\"functions\":" + str(fns) + ",\"methods\":" + str(methods) + "}"
}

fn tool_graph_payload_json(graph: ToolGraph, symbol: str, rel: str, idx: int) -> str {
    if symbol == "" and rel == "" {
        let mut nodes_p: list[str] = ["["]
        for i in 0..len(graph.nodes) {
            if i > 0 { nodes_p.append(",") }
            nodes_p.append(tool_node_json(graph.nodes[i]))
        }
        nodes_p.append("]")
        let mut edges_p: list[str] = ["["]
        for i in 0..len(graph.edges) {
            if i > 0 { edges_p.append(",") }
            edges_p.append(tool_edge_json(graph.edges[i]))
        }
        edges_p.append("]")
        let mut mods_p: list[str] = ["["]
        for i in 0..len(graph.mod_names) {
            if i > 0 { mods_p.append(",") }
            let mp = graph.mod_names[i]
            let is_e = mp == graph.entry_file
            let mid = tool_module_label(graph, mp)
            let mut dependencies: list[str] = []
            for dep in graph.module_dependencies {
                if dep.from_file == mp {
                    let label = tool_module_label(graph, dep.to_file)
                    if not tool_str_contains(dependencies, label) { dependencies.append(label) }
                }
            }
            mods_p.append("{\"id\":" + diag_json_quote(mid) + ",\"file\":" + diag_json_quote(mp) + ",\"is_entry\":" + (if is_e { "true" } else { "false" }) + ",\"dependencies\":" + tool_str_list_json(dependencies) + "}")
        }
        mods_p.append("]")
        let mod_json = join_strings(mods_p, "")
        let bounds = tool_boundaries_for_nodes_json(graph.nodes)
        return "{\"schema_version\":\"wysna.graph/1\",\"graph_hash\":" + diag_json_quote(graph.graph_hash) + ",\"entry_file\":" + diag_json_quote(graph.entry_file) + ",\"summary\":" + tool_graph_summary_json(graph) + ",\"modules\":" + mod_json + ",\"nodes\":" + join_strings(nodes_p, "") + ",\"edges\":" + join_strings(edges_p, "") + ",\"analysis_boundaries\":" + bounds + "}"
    }
    if symbol != "" {
        let nid = graph.nodes[idx].id
        let affected = if rel == "impact" { tool_impact_ids(graph, nid) } else { [nid] }
        let mut rel_edges: list[str] = ["["]
        let mut ecount = 0
        for e in graph.edges {
            let mut take = false
            if rel == "" { take = e.from_id == nid or e.to_id == nid }
            elif rel == "implements" { take = (e.kind == "implements" or e.kind == "implements_method") and (e.from_id == nid or e.to_id == nid) }
            elif rel == "hierarchy" { take = (e.kind == "extends" or e.kind == "implements") and (e.from_id == nid or e.to_id == nid) }
            elif rel == "usages" { take = (e.kind == "uses_type" or e.kind == "instantiates" or e.kind == "implements") and (e.to_id == nid or e.from_id == nid) }
            elif rel == "callers" { take = e.kind == "calls" and e.to_id == nid }
            elif rel == "callees" { take = e.kind == "calls" and e.from_id == nid }
            elif rel == "impact" { take = tool_str_contains(affected, e.from_id) and tool_str_contains(affected, e.to_id) }
            else { take = e.kind == rel and (e.from_id == nid or e.to_id == nid) }
            if take {
                if ecount > 0 { rel_edges.append(",") }
                ecount = ecount + 1
                rel_edges.append(tool_edge_json(e))
            }
        }
        rel_edges.append("]")
        let node_bounds = tool_boundaries_for_nodes_json([graph.nodes[idx]])
        return "{\"schema_version\":\"wysna.graph/1\",\"graph_hash\":" + diag_json_quote(graph.graph_hash) + ",\"query\":{\"symbol\":" + diag_json_quote(symbol) + ",\"relation\":" + (if rel == "" { "null" } else { diag_json_quote(rel) }) + "},\"found\":true,\"node\":" + tool_node_json(graph.nodes[idx]) + ",\"impact\":" + tool_impact_json(graph, nid) + ",\"edges\":" + join_strings(rel_edges, "") + ",\"analysis_boundaries\":" + node_bounds + "}"
    }
    let mut filt_edges: list[str] = ["["]
    let mut ecount = 0
    for e in graph.edges {
        let take = (rel == e.kind) or (rel == "hierarchy" and (e.kind == "extends" or e.kind == "implements"))
        if take {
            if ecount > 0 { filt_edges.append(",") }
            ecount = ecount + 1
            filt_edges.append(tool_edge_json(e))
        }
    }
    filt_edges.append("]")
    let all_bounds = tool_boundaries_for_nodes_json(graph.nodes)
    return "{\"schema_version\":\"wysna.graph/1\",\"graph_hash\":" + diag_json_quote(graph.graph_hash) + ",\"query\":{\"symbol\":null,\"relation\":" + diag_json_quote(rel) + "},\"edges\":" + join_strings(filt_edges, "") + ",\"summary\":" + tool_graph_summary_json(graph) + ",\"analysis_boundaries\":" + all_bounds + "}"
}

fn tool_explain_code_info(code: str) -> list[str] {
    # Returns [normalized_code, stage, title, cause, bad_example, good_example]
    if code == "W0001" { return ["W0001", "lexer/parser", "Unexpected token or invalid character", "Invalid character or unexpected delimiter token", "let x = @", "let x = 10"] }
    if code == "W0002" { return ["W0002", "lexer", "Malformed numeric literal", "Numeric literal with leading dot, double dot, or malformed base prefix", "let x = .5", "let x = 0.5"] }
    if code == "W0003" { return ["W0003", "lexer", "Unterminated string literal", "Missing closing quote on string literal or raw newline inside string", "let s = \"hello", "let s = \"hello\""] }
    if code == "W0004" { return ["W0004", "lexer", "Invalid or unterminated string escape sequence", "Unsupported backslash escape inside string literal", "let s = \"\\q\"", "let s = \"\\\\q\""] }
    if code == "W0005" { return ["W0005", "lexer", "Invalid Unicode scalar escape sequence", "Out-of-range or malformed Unicode scalar \\u{...} escape", "let s = \"\\u{FFFFFF}\"", "let s = \"\\u{1F600}\""] }
    if code == "W0006" { return ["W0006", "parser", "Invalid syntax or missing delimiter", "Unclosed block {...}, missing closing parenthesis ), or unbalanced brackets", "fn f() { let x = 1", "fn f() { let x = 1 }"] }
    if code == "W1001" { return ["W1001", "semantic", "Unknown identifier, symbol, or type", "Typo in variable/function/type name or missing import declaration", "print(countt)", "let count = 0\nprint(count)"] }
    if code == "W1002" { return ["W1002", "semantic", "Duplicate declaration", "Two declarations share the same name or use reserved __wysna_ prefix", "let x = 1\nlet x = 2", "let x = 1\nlet y = 2"] }
    if code == "W1003" { return ["W1003", "module", "Module resolution or circular import error", "Import target path cannot be resolved or introduces a dependency cycle", "import \"missing.wysna\"", "import \"std/json\""] }
    if code == "W1004" { return ["W1004", "semantic", "Invalid control-flow or lexical context", "Using break/continue outside loop, or this/super outside a class method", "fn f() { break }", "for i in 0..3 { break }"] }
    if code == "W1005" { return ["W1005", "graph", "Ambiguous symbol selector", "Multiple declarations match the selector", "wysna graph main.wysna --symbol score", "Pass a candidate ID from diagnostics to --symbol"] }
    if code == "W2001" { return ["W2001", "typecheck", "Type mismatch", "Expression, argument, or initializer type does not match annotation/expectation", "let n: int = \"42\"", "let n: int = 42"] }
    if code == "W2002" { return ["W2002", "typecheck", "Invalid assignment target", "Assigning to a non-place expression (literal or call result)", "foo() = 10", "let mut v = foo()\nv = 10"] }
    if code == "W2003" { return ["W2003", "typecheck", "Non-exhaustive match expression", "match arms do not cover every enum variant, bool value, or error alternative", "match opt { Some(v) => v }", "match opt { Some(v) => v, None => 0 }"] }
    if code == "W2004" { return ["W2004", "typecheck", "Invalid return type or missing return statement", "Function misses a return path or returns an incompatible type", "fn f(ok: bool) -> int { if ok { return 1 } }", "fn f(ok: bool) -> int { if ok { return 1 } else { return 0 } }"] }
    if code == "W2005" { return ["W2005", "typecheck", "Invalid call arity or non-callable target", "Wrong argument count or calling a non-function value", "fn add(a: int, b: int) -> int { return a + b }\nadd(1)", "add(1, 2)"] }
    if code == "W2006" { return ["W2006", "typecheck", "Invalid optional or fallible propagation", "Using ? or else err on a non-Result/non-Optional expression or mismatched error channel", "let x = 42?", "let x = fallible() else err { 0 }"] }
    if code == "W2007" { return ["W2007", "typecheck", "Missing or invalid struct initialization field", "Struct literal misses required fields or references an unknown field", "struct P { x: int, y: int }\nlet p = P { x: 1 }", "let p = P { x: 1, y: 2 }"] }
    if code == "W2010" { return ["W2010", "typecheck", "Invalid dictionary key type", "Using float, struct, or collection as dict key", "let d = {1.5: \"a\"}", "let d = {\"1.5\": \"a\"}"] }
    if code == "W2011" { return ["W2011", "typecheck", "Recursive generic instantiation cycle or infinite layout", "Recursive value struct layout without indirection or cycle exceeded", "struct Node { next: Node }", "struct Node { next: int? }"] }
    if code == "W2012" { return ["W2012", "typecheck", "Generic constraint violation", "Type argument fails declared generic interface constraint", "fn show[T: Printable](x: T) {}", "class Doc implements Printable { ... }\nshow(new Doc())"] }
    if code == "W2013" { return ["W2013", "target", "Feature unsupported by selected profile or target", "Feature outside the active compiler profile or target", "import \"std/http\"", "use native target profile"] }
    if code == "W2014" { return ["W2014", "typecheck", "Value cannot cross a worker boundary", "Worker graph contains classes, interfaces, Weak, handles or function data", "parallel_map(objects, |x:Object| => x)", "parallel_map(values, |x:int| => x + 1)"] }
    if code == "W2015" { return ["W2015", "typecheck", "Worker callback has an unverified or forbidden effect", "Callback reads uncaptured globals, reaches host effects or cannot be resolved", "parallel_map(values, |x:int| { print(x) x })", "let output = parallel_map(values, |x:int| => x + 1)"] }
    if code == "W3001" { return ["W3001", "ownership", "Mutation of immutable value binding", "Reassigning a let immutable binding", "let x = 1\nx = 2", "let mut x = 1\nx = 2"] }
    if code == "W3002" { return ["W3002", "oop", "Invalid member access or private visibility violation", "Accessing unknown field/method or private member outside its class", "u.nme", "u.name"] }
    if code == "W3003" { return ["W3003", "oop", "Invalid class inheritance or unimplemented interface contract", "Class misses required interface method or redeclares inherited field", "class A implements Greeter {}", "class A implements Greeter { fn greet() -> str { return \"hi\" } }"] }
    if code == "W3004" { return ["W3004", "oop", "Constructor safety violation", "Constructor leaves fields uninitialized or misorders super.init(...)", "class C { x: int\n fn init() {} }", "class C { x: int\n fn init() { this.x = 0 } }"] }
    if code == "W4001" { return ["W4001", "runtime", "Division or modulo by zero", "Integer or modulo division by zero at runtime", "let x = 10 / 0", "if denom != 0 { 10 / denom } else { 0 }"] }
    if code == "W4002" { return ["W4002", "runtime", "Index or key out of bounds", "List/string index out of bounds or missing dictionary key", "let xs = [1]\nlet y = xs[5]", "if len(xs) > 5 { xs[5] }"] }
    if code == "W4003" { return ["W4003", "runtime", "Runtime execution error", "Unhandled runtime error, integer overflow, or explicit failure", "exit(1)", "handle failure with Result T ! E"] }
    if code == "W4004" { return ["W4004", "runtime", "Execution quota exceeded", "Execution hit deterministic step or heap budget", "while true {}", "bound loop iterations and heap allocations"] }
    if code == "W4005" { return ["W4005", "runtime", "Contract violation", "Function requires or ensures contract evaluated to false", "fn dec(n: int) -> int requires n > 0 { return n - 1 }\ndec(0)", "dec(1)"] }
    if code == "W5001" { return ["W5001", "toolchain", "C compiler command unavailable or invalid", "Host C compiler missing or failed invocation", "CC=missing wysna build app.wysna", "ensure cc or zig is available on PATH"] }
    if code == "W5002" { return ["W5002", "toolchain", "Invalid command usage or option", "Invalid CLI flag combination or unsupported option", "wysna check --unknown-flag app.wysna", "run wysna --help"] }
    if code == "W5003" { return ["W5003", "toolchain", "Source file could not be read", "Input source file does not exist or cannot be read", "wysna check missing.wysna", "verify path exists and is UTF-8 encoded"] }
    if code == "W5004" { return ["W5004", "toolchain", "Output artifact could not be written", "Output artifact path is not writable or read-back failed", "wysna build app.wysna -o /nonexistent/dir/app", "ensure output parent directory exists"] }
    if code == "W5005" { return ["W5005", "patch", "Stale semantic graph hash or patch precondition failed", "--expect-graph-hash does not match current file graph_hash", "wysna patch file.wysna --symbol f --expect-graph-hash graph:stale --with ...", "re-query wysna graph to obtain current graph_hash"] }
    if code == "W5006" { return ["W5006", "capability", "Capability policy rejected execution", "Program exceeds declared capability gate or sandbox deny list", "wysna run --deny=network.http client.wysna", "grant explicit required capabilities or remove blocked calls"] }
    if code == "W6001" { return ["W6001", "lint", "Pure expression statement result is discarded", "Pure expression value computed as a statement and discarded", "fn f(x: int) -> int { x + 1\n return x }", "fn f(x: int) -> int { return x + 1 }"] }
    if code == "W6003" { return ["W6003", "lint", "Unreachable match arm", "Earlier unguarded patterns cover this arm", "match x { _ => 0, 1 => 1 }", "put specific patterns before covering arms"] }
    if code == "W6004" { return ["W6004", "lint", "Call to deprecated function", "Function marked @deprecated", "old()", "Follow the deprecation message to migrate the call"] }
    if code == "W6101" { return ["W6101", "architecture", "Verified dependency violates an architecture rule", "The checked source and target roles match a manifest rule", "Controller calls Repository", "Controller calls Service; Service calls Repository"] }
    if code == "W6102" { return ["W6102", "architecture", "Architecture rule could not be verified", "Inspect diagnostics[].data.boundary to identify the missing role, schema or call evidence", "Controller calls an unclassified project class", "Declare a role or use a statically resolved call"] }
    if code == "W6005" { return ["W6005", "lint", "Required result is discarded", "Function marked @must_use", "answer()", "let value = answer()"] }
    if code == "W6002" { return ["W6002", "lint", "Strong reference cycle between classes can leak under ARC", "Strong cycle between classes detected", "class A { b: B? }\nclass B { a: A? }", "class A { b: B? }\nclass B { a: Weak[A] }"] }
    if code == "W9998" { return ["W9998", "compiler", "Frontend accepted a program backend cannot lower", "Unsupported target construct", "unsupported target construct", "check docs/KNOWN_LIMITS.md"] }
    if code == "W9999" { return ["W9999", "compiler", "Internal compiler invariant violation", "Internal compiler invariant violation", "internal compiler assertion", "report minimal reproduction"] }
    return []
}

fn tool_upper_str(s: str) -> str {
    let mut out = ""
    let lower = "abcdefghijklmnopqrstuvwxyz"
    let upper = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    for i in 0..len(s) {
        let ch = s[i]
        let mut mapped = ch
        for j in 0..26 {
            if ch == lower[j] { mapped = upper[j] break }
        }
        out = out + mapped
    }
    return out
}

fn tool_is_code_token(s: str) -> bool {
    if len(s) != 5 { return false }
    let up = tool_upper_str(s)
    if up[0] != "W" { return false }
    for i in 1..5 {
        let c = ord(up[i])
        if c < 48 or c > 57 { return false }
    }
    return true
}

fn tool_handle_graph(args: list[str], json_mode: bool) -> unit {
    let mut role = ""
    let mut target = ""
    let mut frozen = false
    let mut manifest = ""
    let mut file = ""
    let mut symbol = ""
    let mut rel = ""
    let mut i = 1
    while i < len(args) {
        let a = args[i]
        if a == "--output-format=json-v1" {
            i = i + 1
        } elif a == "--output-format" and i + 1 < len(args) {
            i = i + 2
        } elif a == "--manifest" and i + 1 < len(args) {
            manifest = args[i + 1]
            i = i + 2
        } elif (a == "--symbol" or a == "-s") and i + 1 < len(args) {
            symbol = args[i + 1]
            i = i + 2
        } elif a == "--rel" and i + 1 < len(args) {
            rel = args[i + 1]
            i = i + 2
        } elif a == "--role" and i + 1 < len(args) and args[i + 1] != "" {
            role = args[i + 1]
            i = i + 2
        } elif a == "--target" and i + 1 < len(args) {
            target = args[i + 1]
            i = i + 2
        } elif a == "--frozen" {
            frozen = true
            i = i + 1
        } elif len(a) > 0 and a[0] != "-" and file == "" {
            file = a
            i = i + 1
        } else {
            report_error("<cli>", "W5002", 1, 1, "unknown option for graph: " + a)
        }
    }
    if role != "" {
        if manifest == "" or symbol != "" or rel != "" or (file != "" and target != "") {
            report_error("<cli>", "W5002", 1, 1, "--role requires --manifest and accepts one source or --target")
        }
        arch_handle_role_query(manifest, file, target, role, frozen, json_mode)
        return
    }
    if target != "" or frozen { report_error("<cli>", "W5002", 1, 1, "--target and --frozen require --role") }
    if manifest != "" {
        if file != "" or symbol == "" or rel != "impact" {
            report_error("<cli>", "W5002", 1, 1, "use --manifest PATH --symbol NAME --rel impact without a source file")
        }
        proj_handle_impact(manifest, symbol, json_mode)
        return
    }
    if file == "" { report_error("<cli>", "W5002", 1, 1, "graph requires a source file path") }
    let loaded = module_read_text_or_overlay(file)
    if loaded[0] != "1" {
        report_error(file, "W5003", 1, 1, "cannot read input file: " + file)
    }
    let src = loaded[1]
    let graph = tool_build_graph(src, file)
    let query_idx = if symbol == "" { -1 } else { tool_require_symbol(graph, symbol, "graph", json_mode) }
    let payload = tool_graph_payload_json(graph, symbol, rel, query_idx)
    if json_mode {
        diag_write_output(diag_tool_envelope_json("graph", "ok", 0, "[]", "result", payload, "[]"))
    } else {
        print("Semantic Graph (" + graph.graph_hash + ") — " + str(len(graph.nodes)) + " nodes, " + str(len(graph.edges)) + " edges")
        for index in 0..len(graph.nodes) {
            if query_idx < 0 or index == query_idx {
                let n = graph.nodes[index]
                print("  " + n.id + " (" + n.file + ":" + str(n.line) + ")")
            }
        }
    }
    exit(0)
}

fn tool_node_source_text(graph: ToolGraph, n: ToolGraphNode) -> str {
    let file_src = if n.file == graph.entry_file { graph.entry_source } else { read_file(n.file) else err { "" } }
    if file_src == "" or n.end_char <= n.start_char or n.end_char > len(file_src) { return "" }
    return slice(file_src, n.start_char, n.end_char)
}

struct ToolInspectItemResult {
    payload_json: str,
    included: list[ToolGraphNode],
    used_bytes: int,
    truncated: bool,
}

fn tool_inspect_build_item(graph: ToolGraph, n: ToolGraphNode, with_deps: bool, has_max_bytes: bool, max_bytes: int, source_offset: int) -> ToolInspectItemResult {
    let budget_max_json = if has_max_bytes { str(max_bytes) } else { "null" }
    let full_src = tool_node_source_text(graph, n)
    let sliced = tool_utf8_slice_budget(full_src, source_offset, has_max_bytes, max_bytes)
    let decl_src = sliced[0]
    let clamped_src_off = lsp_parse_int(sliced[1], 0)
    let src_used = lsp_parse_int(sliced[2], 0)
    let src_total = lsp_parse_int(sliced[3], 0)
    let next_src_off = clamped_src_off + src_used
    let mut used_bytes = src_used
    let mut omitted_rows: list[str] = []
    if next_src_off < src_total {
        omitted_rows.append("{\"kind\":\"source_slice\",\"symbol_id\":" + diag_json_quote(n.id) + ",\"file\":" + diag_json_quote(n.file) + ",\"start_byte\":" + str(n.start_byte + next_src_off) + ",\"end_byte\":" + str(n.end_byte) + ",\"omitted_bytes\":" + str(src_total - next_src_off) + ",\"ref\":{\"command\":\"inspect\",\"symbol\":" + diag_json_quote(n.id) + ",\"source_offset\":" + str(next_src_off) + "}}")
    }
    let mut included_nodes: list[ToolGraphNode] = [n]
    let mut deps_json = "[]"
    if with_deps {
        let mut dep_ids: list[str] = []
        for x in n.uses_types { if x != "" and not tool_str_contains(dep_ids, x) { dep_ids.append(x) } }
        for x in n.calls { if x != "" and not tool_str_contains(dep_ids, x) { dep_ids.append(x) } }
        for x in n.instantiates { if x != "" and not tool_str_contains(dep_ids, x) { dep_ids.append(x) } }
        for x in n.implements_list { if x != "" and not tool_str_contains(dep_ids, x) { dep_ids.append(x) } }
        if n.super_class != "" and not tool_str_contains(dep_ids, n.super_class) { dep_ids.append(n.super_class) }
        let mut deps_p: list[str] = ["["]
        let mut dcount = 0
        for did in tool_sort_strings(dep_ids) {
            if did == n.id { continue }
            let d_idx = tool_find_node_idx(graph, did)
            if d_idx >= 0 {
                let d = graph.nodes[d_idx]
                let d_src = tool_node_source_text(graph, d)
                let dep_row = "{\"id\":" + diag_json_quote(d.id) + ",\"name\":" + diag_json_quote(d.name) + ",\"kind\":" + diag_json_quote(d.kind) + ",\"signature\":" + diag_json_quote(d.signature) + ",\"file\":" + diag_json_quote(d.file) + ",\"line\":" + str(d.line) + ",\"source\":" + diag_json_quote(d_src) + "}"
                let dep_bytes = len(bytes(dep_row))
                if has_max_bytes and used_bytes + dep_bytes > max_bytes {
                    omitted_rows.append("{\"kind\":\"dependency\",\"symbol_id\":" + diag_json_quote(d.id) + ",\"name\":" + diag_json_quote(d.name) + ",\"signature\":" + diag_json_quote(d.signature) + ",\"file\":" + diag_json_quote(d.file) + ",\"line\":" + str(d.line) + ",\"estimated_bytes\":" + str(dep_bytes) + ",\"ref\":{\"command\":\"inspect\",\"symbol\":" + diag_json_quote(d.id) + "}}")
                    continue
                }
                if dcount > 0 { deps_p.append(",") }
                dcount = dcount + 1
                deps_p.append(dep_row)
                included_nodes.append(d)
                used_bytes = used_bytes + dep_bytes
            }
        }
        deps_p.append("]")
        deps_json = join_strings(deps_p, "")
    }
    let has_om = len(omitted_rows) > 0
    let trunc_sym = if has_om { "true" } else { "false" }
    let budget_json = "{\"max_bytes\":" + budget_max_json + ",\"used_bytes\":" + str(used_bytes) + ",\"source_offset\":" + str(clamped_src_off) + ",\"source_total_bytes\":" + str(src_total) + ",\"truncated\":" + trunc_sym + ",\"omitted_count\":" + str(len(omitted_rows)) + "}"
    let omitted_json = "[" + join_strings(omitted_rows, ",") + "]"
    let impact_json = tool_impact_json(graph, n.id)
    let call_res_json = tool_call_resolution_json(n)
    let body = "\"node\":" + tool_node_json(n) + ",\"source\":" + diag_json_quote(decl_src) + ",\"dependencies\":" + deps_json + ",\"impact\":" + impact_json + ",\"call_resolution\":" + call_res_json + ",\"budget\":" + budget_json + ",\"omitted\":" + omitted_json
    return ToolInspectItemResult { payload_json: body, included: included_nodes, used_bytes: used_bytes, truncated: has_om }
}

fn tool_inspect_split_csv(raw_csv: str) -> list[str] {
    let mut dst: list[str] = []
    let mut part = ""
    for i in 0..len(raw_csv) + 1 {
        if i == len(raw_csv) or raw_csv[i] == "," {
            let trimmed = lsp_trim(part)
            if trimmed != "" { dst.append(trimmed) }
            part = ""
        } else {
            part = part + raw_csv[i]
        }
    }
    return dst
}

fn tool_inspect_span_error(code: str, message: str, json_mode: bool) -> unit {
    let exit_code = if code == "W5005" { 1 } elif code == "W5004" { 3 } else { 2 }
    let status = if exit_code == 1 { "diagnostic_error" } elif exit_code == 3 { "toolchain_error" } else { "usage_error" }
    if json_mode {
        let record = diag_record_json(code, "inspect", "error", message, "", 0, 0, "")
        diag_write_output(diag_tool_envelope_json("inspect", status, exit_code, "[" + record + "]", "", "", "[]"))
    } else {
        eprint("[" + code + "] " + message)
    }
    exit(exit_code)
}

fn tool_inspect_span(file: str, span_text: str, budget: int, json_mode: bool) -> unit {
    let span = mcp_parse_json_strict(span_text)
    let source_id = lsp_json_str(span, "source_id", "")
    let digest = lsp_json_str(span, "source_sha256", "")
    if source_id == "" or len(digest) != 64 {
        tool_inspect_span_error("W5002", "Expected a diagnostic span with source_id and source_sha256", json_mode)
    }
    for idx in 0..len(digest) {
        if not proj_str_contains_substr("0123456789abcdef", digest[idx]) {
            tool_inspect_span_error("W5002", "Invalid diagnostic source hash", json_mode)
        }
    }
    let resolved = module_canonical_resolved(file)
    if resolved == "" {
        tool_inspect_span_error("W5004", "Cannot read " + file, json_mode)
    }
    if module_canonical_resolved(source_id) != resolved {
        tool_inspect_span_error("W5002", "Diagnostic span belongs to a different file", json_mode)
    }
    let src = read_file(resolved) else err {
        tool_inspect_span_error("W5004", "Cannot read UTF-8 source: " + file, json_mode)
        ""
    }
    if diag_sha256_hex(src) != digest {
        tool_inspect_span_error("W5005", "Diagnostic span is stale", json_mode)
    }
    let raw = bytes(src)
    let start = lsp_json_int(span, "start_byte", -1)
    let end = lsp_json_int(span, "end_byte", -1)
    let valid = start >= 0 and end >= start and end <= len(raw) and
        (start == len(raw) or raw[start] < 128 or raw[start] >= 192) and
        (end == len(raw) or raw[end] < 128 or raw[end] >= 192)
    if not valid {
        tool_inspect_span_error("W5002", "Diagnostic span must delimit a valid UTF-8 byte range", json_mode)
    }
    let spare = budget - (end - start)
    let prefix = if spare < 0 { 0 } elif spare < budget / 4 { spare } else { budget / 4 }
    let anchor = if prefix > start { 0 } else { start - prefix }
    let sliced = tool_utf8_slice_budget(src, anchor, true, budget)
    if json_mode {
        let context_start = lsp_parse_int(sliced[1], 0)
        let used = lsp_parse_int(sliced[2], 0)
        let target = "{\"source_id\":" + diag_json_quote(source_id) + ",\"source_sha256\":" + diag_json_quote(digest) +
            ",\"start_byte\":" + str(start) + ",\"end_byte\":" + str(end) + "}"
        let result = "{\"schema_version\":\"wysna.inspect-span/1\",\"span\":" + target +
            ",\"source\":" + diag_json_quote(sliced[0]) + ",\"context_start_byte\":" + str(context_start) +
            ",\"context_end_byte\":" + str(context_start + used) +
            ",\"budget\":{\"max_bytes\":" + str(budget) + ",\"used_bytes\":" + str(used) + "}}"
        diag_write_output(diag_tool_envelope_json("inspect", "ok", 0, "[]", "result", result, "[]"))
    } else {
        print(sliced[0])
    }
}

fn tool_handle_inspect(args: list[str], json_mode: bool) -> unit {
    let mut file = ""
    let mut span: str? = None
    let mut sym_args: list[str] = []
    let mut csv_syms: list[str] = []
    let mut has_symbols_flag = false
    let mut with_deps = false
    let mut has_max_bytes = false
    let mut max_bytes = 0
    let mut source_offset = 0
    let mut index_offset = 0
    let mut i = 1
    while i < len(args) {
        let a = args[i]
        if a == "--output-format=json-v1" {
            i = i + 1
        } elif a == "--output-format" and i + 1 < len(args) {
            i = i + 2
        } elif (a == "--symbol" or a == "-s") and i + 1 < len(args) {
            sym_args.append(args[i + 1])
            i = i + 2
        } elif a == "--span" and i + 1 < len(args) {
            span = args[i + 1]
            i = i + 2
        } elif a == "--symbols" and i + 1 < len(args) {
            has_symbols_flag = true
            for s in tool_inspect_split_csv(args[i + 1]) { csv_syms.append(s) }
            i = i + 2
        } elif len(a) > 10 and slice(a, 0, 10) == "--symbols=" {
            has_symbols_flag = true
            for s in tool_inspect_split_csv(slice(a, 10, len(a))) { csv_syms.append(s) }
            i = i + 1
        } elif a == "--with-deps" {
            with_deps = true
            i = i + 1
        } elif a == "--max-bytes" and i + 1 < len(args) {
            let parsed = lsp_parse_int(args[i + 1], -999999)
            if parsed < 1 { report_error("<cli>", "W5002", 1, 1, "--max-bytes must be a positive integer") }
            has_max_bytes = true
            max_bytes = parsed
            i = i + 2
        } elif len(a) > 12 and slice(a, 0, 12) == "--max-bytes=" {
            let parsed = lsp_parse_int(slice(a, 12, len(a)), -999999)
            if parsed < 1 { report_error("<cli>", "W5002", 1, 1, "--max-bytes must be a positive integer") }
            has_max_bytes = true
            max_bytes = parsed
            i = i + 1
        } elif a == "--source-offset" and i + 1 < len(args) {
            let parsed = lsp_parse_int(args[i + 1], -999999)
            if parsed < 0 { report_error("<cli>", "W5002", 1, 1, "--source-offset must be a non-negative integer") }
            source_offset = parsed
            i = i + 2
        } elif len(a) > 16 and slice(a, 0, 16) == "--source-offset=" {
            let parsed = lsp_parse_int(slice(a, 16, len(a)), -999999)
            if parsed < 0 { report_error("<cli>", "W5002", 1, 1, "--source-offset must be a non-negative integer") }
            source_offset = parsed
            i = i + 1
        } elif a == "--offset" and i + 1 < len(args) {
            let parsed = lsp_parse_int(args[i + 1], -999999)
            if parsed < 0 { report_error("<cli>", "W5002", 1, 1, "--offset must be a non-negative integer") }
            index_offset = parsed
            i = i + 2
        } elif len(a) > 9 and slice(a, 0, 9) == "--offset=" {
            let parsed = lsp_parse_int(slice(a, 9, len(a)), -999999)
            if parsed < 0 { report_error("<cli>", "W5002", 1, 1, "--offset must be a non-negative integer") }
            index_offset = parsed
            i = i + 1
        } elif len(a) > 0 and a[0] != "-" and file == "" {
            file = a
            i = i + 1
        } else {
            report_error("<cli>", "W5002", 1, 1, "unknown option for inspect: " + a)
        }
    }
    if span != None {
        if file == "" or has_symbols_flag or len(sym_args) > 0 or with_deps or source_offset != 0 or index_offset != 0 {
            tool_inspect_span_error("W5002", "--span requires a file and cannot be combined with symbol inspection options", json_mode)
        }
        tool_inspect_span(file, span ?? "", if has_max_bytes { max_bytes } else { 1024 }, json_mode)
        return
    }
    if has_symbols_flag and len(sym_args) > 0 {
        report_error("<cli>", "W5002", 1, 1, "inspect cannot combine --symbol and --symbols")
    }
    if has_symbols_flag and len(csv_syms) == 0 {
        report_error("<cli>", "W5002", 1, 1, "inspect --symbols must list at least one symbol")
    }
    if file == "" { report_error("<cli>", "W5002", 1, 1, "inspect requires a source file path") }
    let loaded = module_read_text_or_overlay(file)
    if loaded[0] != "1" {
        report_error(file, "W5003", 1, 1, "cannot read input file: " + file)
    }
    let src = loaded[1]
    let graph = tool_build_graph(src, file)
    let budget_max_json = if has_max_bytes { str(max_bytes) } else { "null" }
    let mut batch_syms: list[str] = []
    let mut single_symbol = ""
    if has_symbols_flag {
        batch_syms = csv_syms
    } elif len(sym_args) > 1 {
        batch_syms = sym_args
    } elif len(sym_args) == 1 {
        single_symbol = sym_args[0]
    }
    if single_symbol == "" and len(batch_syms) == 0 {
        let total_syms = len(graph.nodes)
        let clamped_off = if index_offset < total_syms { index_offset } else { total_syms }
        let mut syms: list[str] = ["["]
        let mut used_bytes = 0
        let mut next_idx = clamped_off
        let mut truncated = false
        let mut scount = 0
        for idx in clamped_off..total_syms {
            let n = graph.nodes[idx]
            let row = "{\"id\":" + diag_json_quote(n.id) + ",\"name\":" + diag_json_quote(n.name) + ",\"qualified_name\":" + diag_json_quote(n.qualified_name) + ",\"kind\":" + diag_json_quote(n.kind) + ",\"file\":" + diag_json_quote(n.file) + ",\"line\":" + str(n.line) + ",\"end_line\":" + str(n.end_line) + ",\"signature\":" + diag_json_quote(n.signature) + "}"
            let row_bytes = len(bytes(row))
            if has_max_bytes and used_bytes + row_bytes > max_bytes {
                truncated = true
                break
            }
            if scount > 0 { syms.append(",") }
            scount = scount + 1
            syms.append(row)
            used_bytes = used_bytes + row_bytes
            next_idx = idx + 1
        }
        syms.append("]")
        let remaining = total_syms - next_idx
        let omitted_json = if truncated and remaining > 0 {
            "[{\"kind\":\"symbol_index\",\"omitted_count\":" + str(remaining) + ",\"next_offset\":" + str(next_idx) + ",\"ref\":{\"command\":\"inspect\",\"offset\":" + str(next_idx) + "}}]"
        } else { "[]" }
        let trunc_str = if truncated and remaining > 0 { "true" } else { "false" }
        let om_count = if truncated and remaining > 0 { remaining } else { 0 }
        let budget_json = "{\"max_bytes\":" + budget_max_json + ",\"used_bytes\":" + str(used_bytes) + ",\"offset\":" + str(clamped_off) + ",\"total_symbols\":" + str(total_syms) + ",\"truncated\":" + trunc_str + ",\"omitted_count\":" + str(om_count) + "}"
        let bounds = tool_boundaries_for_nodes_json(graph.nodes)
        let summary_json = "{\"nodes\":" + str(len(graph.nodes)) + ",\"edges\":" + str(len(graph.edges)) + "}"
        let res_json = "{\"schema_version\":\"wysna.inspect/1\",\"file\":" + diag_json_quote(graph.entry_file) + ",\"graph_hash\":" + diag_json_quote(graph.graph_hash) + ",\"summary\":" + summary_json + ",\"symbols\":" + join_strings(syms, "") + ",\"budget\":" + budget_json + ",\"omitted\":" + omitted_json + ",\"analysis_boundaries\":" + bounds + "}"
        if json_mode {
            diag_write_output(diag_tool_envelope_json("inspect", "ok", 0, "[]", "result", res_json, "[]"))
        } else {
            print("Symbols in " + file + " (" + graph.graph_hash + "):")
            for idx in clamped_off..next_idx {
                let n = graph.nodes[idx]
                print("  [" + n.kind + "] " + n.qualified_name + " (L" + str(n.line) + "-" + str(n.end_line) + ")")
            }
        }
        exit(0)
    }
    if len(batch_syms) > 0 {
        let mut target_idxs: list[int] = []
        for req_sym in batch_syms {
            target_idxs.append(tool_require_symbol(graph, req_sym, "inspect", json_mode))
        }
        let mut item_rows: list[str] = []
        let mut batch_omitted: list[str] = []
        let mut included_nodes: list[ToolGraphNode] = []
        let mut total_used = 0
        let mut any_trunc = false
        for bi in 0..len(target_idxs) {
            let tn = graph.nodes[target_idxs[bi]]
            let mut rem_budget = 0
            if has_max_bytes {
                rem_budget = max_bytes - total_used
                if rem_budget <= 0 {
                    for ri in bi..len(target_idxs) {
                        let rn = graph.nodes[target_idxs[ri]]
                        batch_omitted.append("{\"kind\":\"symbol\",\"symbol_id\":" + diag_json_quote(rn.id) + ",\"name\":" + diag_json_quote(rn.name) + ",\"ref\":{\"command\":\"inspect\",\"symbol\":" + diag_json_quote(rn.id) + "}}")
                    }
                    any_trunc = true
                    break
                }
            }
            let item = tool_inspect_build_item(graph, tn, with_deps, has_max_bytes, rem_budget, if bi == 0 { source_offset } else { 0 })
            item_rows.append("{" + item.payload_json + "}")
            total_used = total_used + item.used_bytes
            for inc in item.included { included_nodes.append(inc) }
            if item.truncated { any_trunc = true }
            if item.truncated and has_max_bytes and total_used >= max_bytes {
                for ri in (bi + 1)..len(target_idxs) {
                    let rn = graph.nodes[target_idxs[ri]]
                    batch_omitted.append("{\"kind\":\"symbol\",\"symbol_id\":" + diag_json_quote(rn.id) + ",\"name\":" + diag_json_quote(rn.name) + ",\"ref\":{\"command\":\"inspect\",\"symbol\":" + diag_json_quote(rn.id) + "}}")
                }
                break
            }
        }
        let trunc_b = if any_trunc or len(batch_omitted) > 0 { "true" } else { "false" }
        let b_budget_json = "{\"max_bytes\":" + budget_max_json + ",\"used_bytes\":" + str(total_used) + ",\"requested_count\":" + str(len(target_idxs)) + ",\"returned_count\":" + str(len(item_rows)) + ",\"truncated\":" + trunc_b + ",\"omitted_count\":" + str(len(batch_omitted)) + "}"
        let bounds_json = tool_boundaries_for_nodes_json(included_nodes)
        let res_json = "{\"schema_version\":\"wysna.inspect/1\",\"mode\":\"batch\",\"file\":" + diag_json_quote(graph.entry_file) + ",\"graph_hash\":" + diag_json_quote(graph.graph_hash) + ",\"items\":[" + join_strings(item_rows, ",") + "],\"budget\":" + b_budget_json + ",\"omitted\":[" + join_strings(batch_omitted, ",") + "],\"analysis_boundaries\":" + bounds_json + "}"
        if json_mode {
            diag_write_output(diag_tool_envelope_json("inspect", "ok", 0, "[]", "result", res_json, "[]"))
        } else {
            print("Inspect Batch (" + str(len(item_rows)) + ") " + graph.graph_hash)
        }
        exit(0)
    }
    let n_idx = tool_require_symbol(graph, single_symbol, "inspect", json_mode)
    let n = graph.nodes[n_idx]
    let single = tool_inspect_build_item(graph, n, with_deps, has_max_bytes, max_bytes, source_offset)
    let bounds_json = tool_boundaries_for_nodes_json(single.included)
    let res_json = "{\"schema_version\":\"wysna.inspect/1\",\"file\":" + diag_json_quote(n.file) + ",\"graph_hash\":" + diag_json_quote(graph.graph_hash) + "," + single.payload_json + ",\"analysis_boundaries\":" + bounds_json + "}"
    if json_mode {
        diag_write_output(diag_tool_envelope_json("inspect", "ok", 0, "[]", "result", res_json, "[]"))
    } else {
        print(n.id + " (" + graph.graph_hash + ") lines " + str(n.line) + "-" + str(n.end_line) + ":")
        print(tool_node_source_text(graph, n))
    }
    exit(0)
}

fn tool_handle_patch(args: list[str], json_mode: bool) -> unit {
    let mut file = ""
    let mut symbol = ""
    let mut replacement = ""
    let mut has_with = false
    let mut with_file = ""
    let mut expect_hash = ""
    let mut manifest = ""
    let mut edits_file = ""
    let mut expect_plan_hash = ""
    let mut test = false
    let mut discover = false
    let mut frozen = false
    let mut apply = false
    let mut i = 1
    while i < len(args) {
        let a = args[i]
        if a == "--output-format=json-v1" {
            i = i + 1
        } elif a == "--output-format" and i + 1 < len(args) {
            i = i + 2
        } elif (a == "--symbol" or a == "-s") and i + 1 < len(args) {
            symbol = args[i + 1]
            i = i + 2
        } elif a == "--with" and i + 1 < len(args) {
            replacement = args[i + 1]
            has_with = true
            i = i + 2
        } elif a == "--with-file" and i + 1 < len(args) {
            with_file = args[i + 1]
            i = i + 2
        } elif a == "--expect-graph-hash" and i + 1 < len(args) {
            expect_hash = args[i + 1]
            i = i + 2
        } elif a == "--manifest" and i + 1 < len(args) {
            manifest = args[i + 1]
            i = i + 2
        } elif a == "--edits" and i + 1 < len(args) {
            edits_file = args[i + 1]
            i = i + 2
        } elif a == "--expect-plan-hash" and i + 1 < len(args) {
            expect_plan_hash = args[i + 1]
            i = i + 2
        } elif a == "--discover" {
            discover = true
            i = i + 1
        } elif a == "--frozen" {
            frozen = true
            i = i + 1
        } elif a == "--test" {
            test = true
            i = i + 1
        } elif a == "--apply" {
            apply = true
            i = i + 1
        } elif len(a) > 0 and a[0] != "-" and file == "" {
            file = a
            i = i + 1
        } else {
            report_error("<cli>", "W5002", 1, 1, "unknown option for patch: " + a)
        }
    }
    if edits_file != "" {
        if manifest == "" or file != "" or symbol != "" or has_with or with_file != "" or expect_hash != "" {
            report_error("<cli>", "W5002", 1, 1, "workspace patch requires --manifest and --edits without single-source options")
        }
        proj_handle_workspace_patch(manifest, edits_file, expect_plan_hash, apply, discover, frozen, test, json_mode)
        return
    }
    if file == "" or symbol == "" or manifest != "" or expect_plan_hash != "" or discover or frozen or test {
        report_error("<cli>", "W5002", 1, 1, "patch requires a file path and --symbol")
    }
    if with_file != "" {
        replacement = read_file(with_file) else err {
            report_error(with_file, "W5003", 1, 1, "cannot read --with-file: " + with_file)
            ""
        }
        has_with = true
    }
    if not has_with { report_error("<cli>", "W5002", 1, 1, "patch requires --with or --with-file") }
    let loaded = module_read_text_or_overlay(file)
    if loaded[0] != "1" {
        report_error(file, "W5003", 1, 1, "cannot read input file: " + file)
    }
    let src = loaded[1]
    let before_sha = diag_sha256_hex(src)
    let before = tool_build_graph(src, file)
    if expect_hash != "" and expect_hash != before.graph_hash {
        report_error(file, "W5005", 1, 1, "stale semantic graph hash: expected '" + expect_hash + "', current '" + before.graph_hash + "'")
    }
    let n_idx = tool_require_symbol(before, symbol, "patch", json_mode)
    let target = before.nodes[n_idx]
    if target.file != before.entry_file {
        report_error(file, "W5002", 1, 1, "symbol is declared in a different file: " + target.file)
    }
    if target.start_char >= target.end_char {
        report_error(file, "W5002", 1, 1, "patch target has no editable declaration range")
    }
    let candidate = slice(src, 0, target.start_char) + replacement + slice(src, target.end_char, len(src))
    let canonical = module_canonical(file)
    let checked_after = check_source(candidate, canonical)
    mir_verify(mir_build(checked_after))
    let after = tool_build_graph(candidate, file)
    if apply {
        tool_write_atomic_verified(file, before_sha, candidate)
    }
    let written_str = if apply { "true" } else { "false" }
    let res_json = "{\"schema_version\":\"wysna.patch/1\",\"file\":" + diag_json_quote(canonical) + ",\"symbol\":" + diag_json_quote(target.id) + ",\"written\":" + written_str + ",\"graph_hash_before\":" + diag_json_quote(before.graph_hash) + ",\"graph_hash_after\":" + diag_json_quote(after.graph_hash) + "}"
    if json_mode {
        diag_write_output(diag_tool_envelope_json("patch", "ok", 0, "[]", "result", res_json, "[]"))
    } else {
        print("Patched " + target.id + " (" + before.graph_hash + " -> " + after.graph_hash + ", written=" + written_str + ")")
    }
    exit(0)
}

fn tool_handle_explain(args: list[str], json_mode: bool) -> unit {
    let mut file = ""
    let mut code_arg = ""
    let mut fn_filter = ""
    let mut i = 1
    while i < len(args) {
        let a = args[i]
        if a == "--output-format=json-v1" {
            i = i + 1
        } elif a == "--output-format" and i + 1 < len(args) {
            i = i + 2
        } elif a == "--code" and i + 1 < len(args) {
            code_arg = args[i + 1]
            i = i + 2
        } elif a == "--function" and i + 1 < len(args) {
            fn_filter = args[i + 1]
            i = i + 2
        } elif len(a) > 0 and a[0] != "-" and file == "" {
            if code_arg == "" and tool_is_code_token(a) {
                code_arg = a
            } else {
                file = a
            }
            i = i + 1
        } else {
            report_error("<cli>", "W5002", 1, 1, "unknown option for explain: " + a)
        }
    }
    if code_arg != "" {
        if file != "" { report_error("<cli>", "W5002", 1, 1, "provide either a source file or --code, not both") }
        let up = tool_upper_str(code_arg)
        let info = tool_explain_code_info(up)
        if len(info) == 0 { report_error("<cli>", "W5002", 1, 1, "unknown diagnostic code: " + code_arg) }
        let payload = "{\"schema_version\":\"wysna.explain-code/1\",\"code\":" + diag_json_quote(info[0]) + ",\"title\":" + diag_json_quote(info[2]) + ",\"stage\":" + diag_json_quote(info[1]) + ",\"description\":" + diag_json_quote(info[2]) + ",\"common_causes\":[" + diag_json_quote(info[3]) + "],\"bad_example\":" + diag_json_quote(info[4]) + ",\"good_example\":" + diag_json_quote(info[5]) + "}"
        if json_mode {
            diag_write_output(diag_tool_envelope_json("explain", "ok", 0, "[]", "result", payload, "[]"))
        } else {
            print("[" + info[0] + "] (" + info[1] + ") " + info[2])
            print("  - " + info[3])
            print("Bad:\n  " + info[4])
            print("Good:\n  " + info[5])
        }
        exit(0)
    }
    if file == "" { report_error("<cli>", "W5002", 1, 1, "explain requires a source file path or --code Wxxxx") }
    let loaded = module_read_text_or_overlay(file)
    if loaded[0] != "1" {
        report_error(file, "W5003", 1, 1, "cannot read input file: " + file)
    }
    let src = loaded[1]
    let graph = tool_build_graph(src, file)
    let mut caps_all: list[str] = []
    let mut fn_rows: list[str] = ["["]
    let mut fcount = 0
    for n in graph.nodes {
        if n.kind == "fn" or n.kind == "method" {
            for c in n.capabilities { if c != "" and not tool_str_contains(caps_all, c) { caps_all.append(c) } }
            if fn_filter == "" or fn_filter == n.name or fn_filter == n.qualified_name {
                if fcount > 0 { fn_rows.append(",") }
                fcount = fcount + 1
                fn_rows.append("{\"identity\":" + diag_json_quote(n.id) + ",\"name\":" + diag_json_quote(n.qualified_name) + ",\"transitive_effects\":" + tool_str_list_json(n.effects) + ",\"capabilities\":" + tool_str_list_json(n.capabilities) + ",\"unknown_calls\":[]}")
            }
        }
    }
    fn_rows.append("]")
    let res_json = "{\"model\":\"conservative\",\"file\":" + diag_json_quote(graph.entry_file) + ",\"program\":{\"capabilities\":" + tool_str_list_json(caps_all) + "},\"functions\":" + join_strings(fn_rows, "") + "}"
    if json_mode {
        diag_write_output(diag_tool_envelope_json("explain", "ok", 0, "[]", "result", res_json, "[]"))
    } else {
        print("Conservative effect report (native)")
        print("Program capabilities: " + (if len(caps_all) == 0 { "none modeled" } else { join_strings(tool_sort_strings(caps_all), ", ") }))
        for n in graph.nodes {
            if (n.kind == "fn" or n.kind == "method") and (fn_filter == "" or fn_filter == n.name or fn_filter == n.qualified_name) {
                let effs = if len(n.effects) == 0 { "none modeled" } else { join_strings(tool_sort_strings(n.effects), ", ") }
                print(n.qualified_name + ": " + effs)
            }
        }
    }
    exit(0)
}

fn tool_handle_check_v1(file: str, legacy_json: bool, json_v1: bool) -> unit {
    let loaded = module_read_text_or_overlay(file)
    if loaded[0] != "1" {
        report_error(file, "W5003", 1, 1, "cannot read input file: " + file)
    }
    let src = loaded[1]
    let checked = check_source(src, file)
    let module = mir_build(checked)
    mir_verify(module)
    let warnings = lint_collect_warnings(checked, src, file)
    let warnings_json = lint_warnings_json(warnings, src)
    let fn_count = str(len(module.functions))
    if json_v1 {
        diag_write_output(diag_tool_envelope_json("check", "ok", 0, warnings_json, "", "", "[]"))
    } elif legacy_json {
        diag_write_output(("{\"schema_version\":\"wysna.cli.result/1\",\"compiler_version\":\"" + tool_compiler_version() + "\",\"command\":\"check\",\"ok\":true,\"exit_code\":0,\"diagnostics\":") + warnings_json + ",\"data\":{\"file\":" + diag_json_quote(file) + ",\"functions\":" + fn_count + "}}")
    } else {
        lint_print_warnings_stderr(warnings)
        print("[Wysna Compiler] Checked " + file + " (" + fn_count + " functions, MIR verified)")
    }
    exit(0)
}

fn tool_emit_fmt_v1(formatted: str, in_path: str, write_in_place: bool) -> unit {
    let sha = diag_sha256_hex(formatted)
    let artifact = if write_in_place {
        "{\"kind\":\"formatted_source\",\"media_type\":\"text/x-wysna\",\"path\":" + diag_json_quote(in_path) + ",\"sha256\":" + diag_json_quote(sha) + "}"
    } else {
        "{\"kind\":\"formatted_source\",\"media_type\":\"text/x-wysna\",\"content\":" + diag_json_quote(formatted) + ",\"sha256\":" + diag_json_quote(sha) + "}"
    }
    diag_write_output(diag_tool_envelope_json("fmt", "ok", 0, "[]", "", "", "[" + artifact + "]"))
    exit(0)
}

fn selfhost_trim_line(line: str) -> str {
    let n = len(line)
    let mut start = 0
    while start < n and (ord(line[start]) == 32 or ord(line[start]) == 9) {
        start = start + 1
    }
    let mut end = n
    while end > start and (ord(line[end - 1]) == 32 or ord(line[end - 1]) == 9) {
        end = end - 1
    }
    return slice(line, start, end)
}

struct FmtInlineTok {
    kind: str,
    text: str,
}

fn selfhost_fmt_is_delim_or_op(text: str) -> bool {
    return text == "(" or text == "[" or text == "{" or text == "," or text == ":" or text == ".." or text == "..=" or text == "==" or text == "!=" or text == "<" or text == "<=" or text == ">" or text == ">=" or text == "+=" or text == "-=" or text == "*=" or text == "/=" or text == "%=" or text == "??" or text == "->" or text == "=>" or text == "=" or text == "+" or text == "-" or text == "*" or text == "/" or text == "%" or text == "!" or text == "|" or text == "return" or text == "and" or text == "or" or text == "not" or text == "in" or text == "if" or text == "elif" or text == "else" or text == "while" or text == "match" or text == "requires" or text == "ensures"
}

fn selfhost_fmt_is_binary_op(kind: str, text: str) -> bool {
    if kind == "OP" {
        if text == "==" or text == "!=" or text == "<=" or text == ">=" or text == "+=" or text == "-=" or text == "*=" or text == "/=" or text == "%=" or text == "??" or text == "->" or text == "=>" or text == "=" or text == "+" or text == "-" or text == "*" or text == "/" or text == "%" or text == "<" or text == ">" or text == "|" or text == "!" {
            return true
        }
    }
    return false
}

fn selfhost_fmt_is_stmt_kw_before_paren(text: str) -> bool {
    return text == "if" or text == "elif" or text == "while" or text == "for" or text == "return" or text == "match" or text == "in" or text == "and" or text == "or" or text == "not" or text == "else" or text == "requires" or text == "ensures"
}

fn selfhost_fmt_is_dict_prefix(text: str) -> bool {
    return text == "=" or text == "(" or text == "[" or text == "," or text == ":" or text == "return" or text == "=>" or text == "??" or text == "!=" or text == "=="
}

fn selfhost_fmt_looks_like_dict_brace(tokens: list[FmtInlineTok], open_idx: int) -> bool {
    if open_idx > 0 and not selfhost_fmt_is_dict_prefix(tokens[open_idx - 1].text) {
        return false
    }
    let n = len(tokens)
    let mut i = open_idx + 1
    let mut bdepth = 1
    let mut pdepth = 0
    while i < n and bdepth > 0 {
        let t = tokens[i].text
        if t == "let" and bdepth == 1 and pdepth == 0 {
            return false
        } elif t == "{" {
            bdepth = bdepth + 1
        } elif t == "}" {
            bdepth = bdepth - 1
        } elif t == "(" or t == "[" {
            pdepth = pdepth + 1
        } elif t == ")" or t == "]" {
            if pdepth > 0 { pdepth = pdepth - 1 }
        } elif t == ":" and bdepth == 1 and pdepth == 0 {
            return true
        }
        i = i + 1
    }
    return false
}

fn selfhost_fmt_is_lambda_prefix(text: str) -> bool {
    return text == "=" or text == "(" or text == "[" or text == "{" or text == "," or text == ":" or text == "return" or text == "=>" or text == "->" or text == "??"
}

fn selfhost_fmt_skip_to_paren_after_new(tokens: list[FmtInlineTok], idx: int) -> bool {
    let n = len(tokens)
    if idx + 1 >= n { return false }
    if tokens[idx + 1].kind != "WORD" { return false }
    let target = tokens[idx + 1].text
    if target == "fn" or target == "let" or target == "if" or target == "return" or target == "class" or target == "struct" {
        return false
    }
    let mut pos = idx + 2
    if pos < n and tokens[pos].text == "[" {
        let mut bracket_depth = 1
        pos = pos + 1
        while pos < n and bracket_depth > 0 {
            if tokens[pos].text == "[" { bracket_depth = bracket_depth + 1 }
            elif tokens[pos].text == "]" { bracket_depth = bracket_depth - 1 }
            pos = pos + 1
        }
        if bracket_depth != 0 { return false }
    }
    return pos < n and tokens[pos].text == "("
}

fn selfhost_fmt_tokenize(line: str) -> list[FmtInlineTok] {
    let mut out: list[FmtInlineTok] = []
    let n = len(line)
    let mut i = 0
    while i < n {
        let c = ord(line[i])
        if c == 32 or c == 9 {
            i = i + 1
            continue
        }
        if c == 35 {
            out.append(FmtInlineTok { kind: "COMMENT", text: slice(line, i, n) })
            break
        }
        if c == 47 and i + 1 < n and ord(line[i + 1]) == 42 {
            let start = i
            i = i + 2
            let mut bdepth = 1
            while i < n and bdepth > 0 {
                if ord(line[i]) == 47 and i + 1 < n and ord(line[i + 1]) == 42 {
                    bdepth = bdepth + 1
                    i = i + 2
                } elif ord(line[i]) == 42 and i + 1 < n and ord(line[i + 1]) == 47 {
                    bdepth = bdepth - 1
                    i = i + 2
                } else {
                    i = i + 1
                }
            }
            out.append(FmtInlineTok { kind: "COMMENT", text: slice(line, start, i) })
            continue
        }
        if c == 34 and i + 2 < n and ord(line[i + 1]) == 34 and ord(line[i + 2]) == 34 {
            let start = i
            i = i + 3
            let mut esc = false
            while i < n {
                let sc = ord(line[i])
                if esc {
                    esc = false
                    i = i + 1
                } elif sc == 92 {
                    esc = true
                    i = i + 1
                } elif sc == 34 and i + 2 < n and ord(line[i + 1]) == 34 and ord(line[i + 2]) == 34 {
                    i = i + 3
                    break
                } else {
                    i = i + 1
                }
            }
            out.append(FmtInlineTok { kind: "STR", text: slice(line, start, i) })
            continue
        }
        if c == 34 or c == 39 {
            let quote = c
            let start = i
            i = i + 1
            let mut esc = false
            while i < n {
                let sc = ord(line[i])
                if esc {
                    esc = false
                    i = i + 1
                } elif sc == 92 {
                    esc = true
                    i = i + 1
                } elif sc == quote {
                    i = i + 1
                    break
                } else {
                    i = i + 1
                }
            }
            out.append(FmtInlineTok { kind: "STR", text: slice(line, start, i) })
            continue
        }
        if is_alpha(c) {
            let start = i
            i = i + 1
            while i < n and is_alnum(ord(line[i])) {
                i = i + 1
            }
            out.append(FmtInlineTok { kind: "WORD", text: slice(line, start, i) })
            continue
        }
        if is_digit(c) {
            let start = i
            i = i + 1
            while i < n {
                let nc = ord(line[i])
                if is_alnum(nc) {
                    i = i + 1
                } elif nc == 46 and i + 1 < n and is_digit(ord(line[i + 1])) {
                    i = i + 1
                } elif (nc == 43 or nc == 45) and i > start and (ord(line[i - 1]) == 101 or ord(line[i - 1]) == 69) and (i >= 2 and is_digit(ord(line[i - 2])) or (i >= 2 and ord(line[i - 2]) == 95)) {
                    i = i + 1
                } else {
                    break
                }
            }
            out.append(FmtInlineTok { kind: "NUM", text: slice(line, start, i) })
            continue
        }
        if i + 2 < n and slice(line, i, i + 3) == "..=" {
            out.append(FmtInlineTok { kind: "RANGE", text: "..=" })
            i = i + 3
            continue
        }
        if i + 1 < n {
            let two = slice(line, i, i + 2)
            if two == ".." {
                out.append(FmtInlineTok { kind: "RANGE", text: ".." })
                i = i + 2
                continue
            }
            if two == "==" or two == "!=" or two == "<=" or two == ">=" or two == "+=" or two == "-=" or two == "*=" or two == "/=" or two == "%=" or two == "??" or two == "->" or two == "=>" {
                out.append(FmtInlineTok { kind: "OP", text: two })
                i = i + 2
                continue
            }
        }
        let ch = slice(line, i, i + 1)
        i = i + 1
        if ch == "(" or ch == ")" or ch == "[" or ch == "]" or ch == "{" or ch == "}" or ch == "," or ch == ":" or ch == "." or ch == "?" {
            out.append(FmtInlineTok { kind: "PUNCT", text: ch })
        } elif ch == "+" or ch == "-" or ch == "*" or ch == "/" or ch == "%" or ch == "<" or ch == ">" or ch == "=" or ch == "!" or ch == "|" {
            out.append(FmtInlineTok { kind: "OP", text: ch })
        } else {
            out.append(FmtInlineTok { kind: "OTHER", text: ch })
        }
    }
    return out
}

fn selfhost_fmt_need_space(p: FmtInlineTok, c: FmtInlineTok, p_role: str, c_role: str) -> bool {
    if p.text == "@" { return false }
    if c.kind == "COMMENT" {
        return p.text != "(" and p.text != "[" and p.text != "{"
    }
    if p.kind == "COMMENT" {
        return c.text != "," and c.text != ")" and c.text != "]" and c.text != ":" and c.text != ";"
    }
    if p.text == "(" or p.text == "[" or p.text == "." {
        return false
    }
    if p_role == "UNARY" or p_role == "LAMBDA_OPEN" or p_role == "EMPTY_LBRACE" or p_role == "DICT_LBRACE" {
        return false
    }
    if p.kind == "RANGE" {
        return false
    }
    if c.text == ")" or c.text == "]" or c.text == "," or c.text == ":" or c.text == "." or c.text == "?" {
        return false
    }
    if c_role == "LAMBDA_CLOSE" or c_role == "EMPTY_RBRACE" or c_role == "DICT_RBRACE" {
        return false
    }
    if c.kind == "RANGE" {
        return p_role == "BLOCK_LBRACE" or p_role == "DICT_LBRACE" or p.text == "{"
    }
    if c.text == "{" {
        return p.text != "(" and p.text != "[" and p.text != "{"
    }
    if p_role == "BLOCK_LBRACE" or c_role == "BLOCK_RBRACE" {
        return true
    }
    if c.text == "(" {
        if p.text == "," or p.text == ":" or p.text == "{" or p_role == "BLOCK_LBRACE" { return true }
        if p_role == "LAMBDA_OPEN" or p_role == "LAMBDA_CLOSE" { return false }
        if selfhost_fmt_is_binary_op(p.kind, p.text) and p_role != "UNARY" { return true }
        if p.kind == "WORD" { return selfhost_fmt_is_stmt_kw_before_paren(p.text) }
        return false
    }
    if c.text == "[" {
        if p.text == "," or p.text == ":" or p.text == "{" or p_role == "BLOCK_LBRACE" { return true }
        if selfhost_fmt_is_binary_op(p.kind, p.text) and p_role != "UNARY" { return true }
        if p.kind == "WORD" { return selfhost_fmt_is_stmt_kw_before_paren(p.text) or p.text == "return" }
        return false
    }
    if p.text == "," or p.text == ":" {
        return true
    }
    if c_role == "LAMBDA_OPEN" {
        return true
    }
    if p_role == "LAMBDA_CLOSE" {
        return true
    }
    if p_role == "BINOP" or c_role == "BINOP" or c_role == "UNARY" {
        return true
    }
    if p.text == "?" or p.text == ")" or p.text == "]" or p.text == "}" {
        return true
    }
    return true
}

fn selfhost_format_inline(line: str) -> str {
    let raw_tokens = selfhost_fmt_tokenize(line)
    if len(raw_tokens) == 0 {
        return ""
    }
    let mut tokens: list[FmtInlineTok] = []
    let raw_len = len(raw_tokens)
    let mut k = 0
    while k < raw_len {
        let tok = raw_tokens[k]
        if tok.kind == "WORD" and tok.text == "new" and (k == 0 or raw_tokens[k - 1].text != ".") and selfhost_fmt_skip_to_paren_after_new(raw_tokens, k) {
            k = k + 1
            continue
        }
        tokens.append(tok)
        k = k + 1
    }

    let n = len(tokens)
    if n == 0 { return "" }

    let mut roles: list[str] = []
    let mut brace_stack: list[str] = []
    let mut in_lambda_params = false
    let mut in_error_union = false
    let mut i = 0
    while i < n {
        let tok = tokens[i]
        let mut role = tok.kind
        if tok.kind == "WORD" {
            if tok.text == "requires" or tok.text == "ensures" {
                in_error_union = false
            }
        } elif tok.kind == "COMMENT" {
            in_error_union = false
        } elif tok.text == "!" {
            in_error_union = true
            role = "BINOP"
        } elif tok.text == "=" {
            in_error_union = false
            role = "BINOP"
        } elif tok.text == "{" {
            in_error_union = false
            if i + 1 < n and tokens[i + 1].text == "}" {
                role = "EMPTY_LBRACE"
                brace_stack.append("E")
            } elif selfhost_fmt_looks_like_dict_brace(tokens, i) {
                role = "DICT_LBRACE"
                brace_stack.append("D")
            } else {
                role = "BLOCK_LBRACE"
                brace_stack.append("B")
            }
        } elif tok.text == "}" {
            in_error_union = false
            let mut bmode = "B"
            if len(brace_stack) > 0 {
                bmode = brace_stack.pop()
            }
            if bmode == "E" { role = "EMPTY_RBRACE" }
            elif bmode == "D" { role = "DICT_RBRACE" }
            else { role = "BLOCK_RBRACE" }
        } elif tok.text == "|" {
            if in_error_union {
                role = "BINOP"
            } elif in_lambda_params {
                in_lambda_params = false
                role = "LAMBDA_CLOSE"
            } elif i == 0 or selfhost_fmt_is_lambda_prefix(tokens[i - 1].text) {
                in_lambda_params = true
                role = "LAMBDA_OPEN"
            } else {
                role = "BINOP"
            }
        } elif tok.text == "-" {
            if i == 0 or selfhost_fmt_is_delim_or_op(tokens[i - 1].text) {
                role = "UNARY"
            } else {
                role = "BINOP"
            }
        } elif selfhost_fmt_is_binary_op(tok.kind, tok.text) {
            role = "BINOP"
        }
        roles.append(role)
        i = i + 1
    }

    let mut out = tokens[0].text
    let mut idx = 1
    while idx < n {
        if selfhost_fmt_need_space(tokens[idx - 1], tokens[idx], roles[idx - 1], roles[idx]) {
            out = out + " "
        }
        out = out + tokens[idx].text
        idx = idx + 1
    }
    return out
}

fn selfhost_format_body(source: str, in_path: str) -> str {
    let module = mir_build(check_source(source, in_path))
    mir_verify(module)
    let mut raw_lines: list[str] = []
    let n = len(source)
    let mut line_start = 0
    let mut pos = 0
    while pos < n {
        let code = ord(source[pos])
        if code == 13 or code == 10 {
            raw_lines.append(slice(source, line_start, pos))
            if code == 13 and pos + 1 < n and ord(source[pos + 1]) == 10 {
                pos = pos + 2
            } else {
                pos = pos + 1
            }
            line_start = pos
        } else {
            pos = pos + 1
        }
    }
    if line_start < n {
        raw_lines.append(slice(source, line_start, n))
    }

    let mut out_lines: list[str] = []
    let mut depth = 0
    let mut block_depth = 0
    let mut in_ml_str = false
    let mut prev_blank = true
    for raw in raw_lines {
        if in_ml_str {
            out_lines.append(raw)
            prev_blank = false
            let rlen = len(raw)
            let mut idx = 0
            let mut escaped = false
            let mut in_str = false
            while idx < rlen {
                let c = ord(raw[idx])
                if in_ml_str {
                    if escaped {
                        escaped = false
                        idx = idx + 1
                    } elif c == 92 {
                        escaped = true
                        idx = idx + 1
                    } elif idx + 2 < rlen and c == 34 and ord(raw[idx + 1]) == 34 and ord(raw[idx + 2]) == 34 {
                        in_ml_str = false
                        idx = idx + 3
                    } else {
                        idx = idx + 1
                    }
                } elif block_depth > 0 {
                    if c == 47 and idx + 1 < rlen and ord(raw[idx + 1]) == 42 {
                        block_depth = block_depth + 1
                        idx = idx + 2
                    } elif c == 42 and idx + 1 < rlen and ord(raw[idx + 1]) == 47 {
                        block_depth = block_depth - 1
                        idx = idx + 2
                    } else {
                        idx = idx + 1
                    }
                } elif in_str {
                    if escaped {
                        escaped = false
                    } elif c == 92 {
                        escaped = true
                    } elif c == 34 {
                        in_str = false
                    }
                    idx = idx + 1
                } else {
                    if c == 35 {
                        break
                    } elif c == 47 and idx + 1 < rlen and ord(raw[idx + 1]) == 42 {
                        block_depth = block_depth + 1
                        idx = idx + 2
                    } elif idx + 2 < rlen and c == 34 and ord(raw[idx + 1]) == 34 and ord(raw[idx + 2]) == 34 {
                        in_ml_str = true
                        escaped = false
                        idx = idx + 3
                    } elif c == 34 {
                        in_str = true
                        escaped = false
                        idx = idx + 1
                    } elif c == 123 {
                        depth = depth + 1
                        idx = idx + 1
                    } elif c == 125 {
                        if depth > 0 { depth = depth - 1 }
                        idx = idx + 1
                    } else {
                        idx = idx + 1
                    }
                }
            }
            continue
        }
        if block_depth > 0 {
            out_lines.append(raw)
            let rlen = len(raw)
            let mut idx = 0
            while idx < rlen {
                if ord(raw[idx]) == 47 and idx + 1 < rlen and ord(raw[idx + 1]) == 42 {
                    block_depth = block_depth + 1
                    idx = idx + 2
                } elif ord(raw[idx]) == 42 and idx + 1 < rlen and ord(raw[idx + 1]) == 47 {
                    block_depth = block_depth - 1
                    idx = idx + 2
                    if block_depth == 0 {
                        prev_blank = false
                        break
                    }
                } else {
                    idx = idx + 1
                }
            }
            continue
        }
        let raw_trimmed = selfhost_trim_line(raw)
        if len(raw_trimmed) == 0 {
            if not prev_blank {
                out_lines.append("")
                prev_blank = true
            }
        } else {
            let trimmed = selfhost_format_inline(raw_trimmed)
            prev_blank = false
            let tlen = len(trimmed)
            let mut leading_closes = 0
            if not (tlen >= 2 and ord(trimmed[0]) == 47 and ord(trimmed[1]) == 42) {
                while leading_closes < tlen and ord(trimmed[leading_closes]) == 125 {
                    leading_closes = leading_closes + 1
                }
            }
            let mut indent_level = depth - leading_closes
            if indent_level < 0 { indent_level = 0 }
            let mut prefix = ""
            for _step in 0..indent_level {
                prefix = prefix + "    "
            }
            out_lines.append(prefix + trimmed)

            let mut opens = 0
            let mut closes = 0
            let mut in_str = false
            let mut escaped = false
            let mut idx = 0
            while idx < tlen {
                let c = ord(trimmed[idx])
                if in_ml_str {
                    if escaped {
                        escaped = false
                        idx = idx + 1
                    } elif c == 92 {
                        escaped = true
                        idx = idx + 1
                    } elif idx + 2 < tlen and c == 34 and ord(trimmed[idx + 1]) == 34 and ord(trimmed[idx + 2]) == 34 {
                        in_ml_str = false
                        idx = idx + 3
                    } else {
                        idx = idx + 1
                    }
                } elif block_depth > 0 {
                    if c == 47 and idx + 1 < tlen and ord(trimmed[idx + 1]) == 42 {
                        block_depth = block_depth + 1
                        idx = idx + 2
                    } elif c == 42 and idx + 1 < tlen and ord(trimmed[idx + 1]) == 47 {
                        block_depth = block_depth - 1
                        idx = idx + 2
                    } else {
                        idx = idx + 1
                    }
                } elif in_str {
                    if escaped {
                        escaped = false
                    } elif c == 92 {
                        escaped = true
                    } elif c == 34 {
                        in_str = false
                    }
                    idx = idx + 1
                } else {
                    if c == 35 {
                        break
                    } elif c == 47 and idx + 1 < tlen and ord(trimmed[idx + 1]) == 42 {
                        block_depth = block_depth + 1
                        idx = idx + 2
                    } elif idx + 2 < tlen and c == 34 and ord(trimmed[idx + 1]) == 34 and ord(trimmed[idx + 2]) == 34 {
                        in_ml_str = true
                        escaped = false
                        idx = idx + 3
                    } elif c == 34 {
                        in_str = true
                        escaped = false
                        idx = idx + 1
                    } elif c == 123 {
                        opens = opens + 1
                        idx = idx + 1
                    } elif c == 125 {
                        closes = closes + 1
                        idx = idx + 1
                    } else {
                        idx = idx + 1
                    }
                }
            }
            depth = depth + opens - closes
            if depth < 0 { depth = 0 }
        }
    }
    while len(out_lines) > 0 and len(out_lines[len(out_lines) - 1]) == 0 {
        out_lines.pop()
    }
    return join_strings(out_lines, "\n")
}

# tool_buf_from_str lives in 01_tool_common.wysna.

fn tool_write_atomic_verified(path: str, expected_sha256: str, content: str) -> unit {
    let disk_text = read_file(path) else err {
        report_error(path, "W5003", 1, 1, "cannot read file before atomic write: " + path)
        ""
    }
    let current_sha = diag_sha256_hex(disk_text)
    if current_sha != expected_sha256 {
        report_error(path, "W5005", 1, 1, "source modified on disk before write: " + path)
    }
    let stamp = str(unix_time())
    let empty_buf = tool_buf_from_str("")
    let mut tmp_path = ""
    let mut fh = empty_buf
    let mut opened = false
    for attempt in 0..32 {
        let candidate = path + ".wysna_tmp_" + stamp + "_" + str(attempt)
        let c_buf = tool_buf_from_str(candidate)
        let handle = wysna_host_file_open(c_buf, 3)
        wysna_host_close(c_buf)
        if wysna_host_is_open(handle) == 1 {
            tmp_path = candidate
            fh = handle
            opened = true
            break
        }
    }
    if not opened {
        wysna_host_close(empty_buf)
        report_error(path, "W5004", 1, 1, "failed creating temporary file for atomic write: " + path)
    }
    let tmp_buf = tool_buf_from_str(tmp_path)
    let data_buf = tool_buf_from_str(content)
    let wr = wysna_host_file_write(fh, data_buf)
    let cl = wysna_host_close(fh)
    wysna_host_close(data_buf)
    if wr != 0 or cl != 0 {
        let _rm = wysna_host_fs(tmp_buf, empty_buf, 3)
        wysna_host_close(tmp_buf)
        wysna_host_close(empty_buf)
        report_error(path, "W5004", 1, 1, "failed writing temporary file for atomic update: " + path)
    }
    let dst_buf = tool_buf_from_str(path)
    let mv = wysna_host_fs(tmp_buf, dst_buf, 4)
    wysna_host_close(dst_buf)
    if mv < 0 {
        let _rm = wysna_host_fs(tmp_buf, empty_buf, 3)
        wysna_host_close(tmp_buf)
        wysna_host_close(empty_buf)
        report_error(path, "W5004", 1, 1, "failed renaming temporary file into place: " + path)
    }
    wysna_host_close(tmp_buf)
    wysna_host_close(empty_buf)
}

# tool_skills_topic_content and tool_skills_payload_json live in 01_tool_common.wysna.

fn tool_handle_skills(args: list[str], json_mode: bool) -> unit {
    let mut topic = "overview"
    let mut has_topic = false
    let mut i = 1
    while i < len(args) {
        let a = args[i]
        if a == "--output-format=json-v1" {
            i = i + 1
        } elif a == "--output-format" and i + 1 < len(args) {
            i = i + 2
        } elif len(a) > 0 and a[0] != "-" and not has_topic {
            topic = a
            has_topic = true
            i = i + 1
        } else {
            report_error("<cli>", "W5002", 1, 1, "unknown option for skills: " + a)
        }
    }
    let content = tool_skills_topic_content(topic)
    if content == "" {
        let msg = "Unknown skill topic '" + topic + "'. Available topics: " + tool_skills_available_topics()
        if json_mode {
            let diag = diag_record_json("W5002", "usage", "error", msg, "<cli>", 1, 1, "")
            diag_write_output(diag_tool_envelope_json("skills", "usage_error", 2, "[" + diag + "]", "", "", "[]"))
        } else {
            eprint("wysna skills: " + msg)
        }
        exit(2)
    }
    let payload = tool_skills_payload_json(topic)
    if json_mode {
        diag_write_output(diag_tool_envelope_json("skills", "ok", 0, "[]", "result", payload, "[]"))
    } else {
        print(content)
    }
    exit(0)
}

# tool_capabilities_payload_json lives in 01_tool_common.wysna.

fn tool_handle_capabilities(args: list[str], json_mode: bool) -> unit {
    let mut i = 1
    while i < len(args) {
        let a = args[i]
        if a == "--output-format=json-v1" {
            i = i + 1
        } elif a == "--output-format" and i + 1 < len(args) {
            i = i + 2
        } else {
            report_error("<cli>", "W5002", 1, 1, "unknown option for capabilities: " + a)
        }
    }
    let payload = tool_capabilities_payload_json()
    if json_mode {
        diag_write_output(diag_tool_envelope_json("capabilities", "ok", 0, "[]", "result", payload, "[]"))
    } else {
        print(("Wysna " + tool_compiler_version() + " capabilities: native-cli, wasi-command, browser-library"))
        print("Machine-readable tools: check, fmt, project.new, project.lock, project.check, project.test, packages.pack, packages.fetch, packages.add, packages.remove, packages.restore, api, capabilities, explain, graph, inspect, patch, skills, fix, schema, mcp, lsp")
    }
    exit(0)
}
# Native Language Server Protocol (LSP 3.17) server backed by the semantic graph and compiler frontend.
# Shared host externs, buffer helpers, and LspJson live in 01_tool_common.wysna.

fn lsp_create_workspace() -> str {
    let nonce = diag_uuid4()
    if nonce == "native" { return "" }
    let directory = lsp_tmp_dir() + "/wysna_lsp_" + nonce
    let path = lsp_buf_from_str(directory)
    let unused = lsp_buf_from_str("")
    let status = wysna_host_fs(path, unused, 2)
    wysna_host_close(path)
    wysna_host_close(unused)
    return if status == 0 { directory } else { "" }
}

fn lsp_next_tmp_path(state: LspServerState, prefix: str, ext: str) -> str {
    state.tmp_seq = state.tmp_seq + 1
    return state.tmp_dir + "/" + prefix + "_" + str(state.tmp_seq) + ext
}

fn lsp_send_message(json_body: str) -> unit {
    let body_bytes = bytes(json_body)
    let header = "Content-Length: " + str(len(body_bytes)) + "\r\n\r\n"
    let out = wysna_host_buffer_new()
    for b in bytes(header) { wysna_host_buffer_append(out, b) }
    for b in body_bytes { wysna_host_buffer_append(out, b) }
    let _w = wysna_host_stdout_write_raw(out)
    wysna_host_close(out)
}

fn lsp_read_frame_clean(state: LspServerState) -> str {
    let mut content_length = -1
    let mut got_header = false
    while true {
        let buf = wysna_host_buffer_new()
        let st = wysna_host_stdin_read_line(buf)
        if st <= 0 {
            wysna_host_close(buf)
            state.eof_reached = true
            return ""
        }
        let line_len = lsp_buf_read_line_len(buf)
        let line = lsp_buf_to_str(buf, line_len)
        wysna_host_close(buf)
        let trimmed = lsp_trim(line)
        if trimmed == "" {
            if got_header { break }
            continue
        }
        got_header = true
        let mut colon = -1
        for i in 0..len(trimmed) {
            if trimmed[i] == ":" {
                colon = i
                break
            }
        }
        if colon > 0 {
            let key = lsp_ascii_lower(lsp_trim(slice(trimmed, 0, colon)))
            if key == "content-length" {
                content_length = lsp_parse_int(slice(trimmed, colon + 1, len(trimmed)), -1)
            }
        }
    }
    if content_length <= 0 { return "" }
    let body_buf = wysna_host_buffer_new()
    let got = wysna_host_stdin_read_exact(body_buf, content_length)
    if got <= 0 {
        wysna_host_close(body_buf)
        state.eof_reached = true
        return ""
    }
    let payload = lsp_buf_to_str(body_buf, got)
    wysna_host_close(body_buf)
    return payload
}

# LspJson and lsp_parse_json live in 01_tool_common.wysna.

fn lsp_uri_decode_pct(raw: str) -> str {
    let mut parts: list[str] = []
    let n = len(raw)
    let mut i = 0
    while i < n {
        if raw[i] == "%" and i + 2 < n {
            let hi = hex_val(ord(raw[i + 1]))
            let lo = hex_val(ord(raw[i + 2]))
            if hi >= 0 and lo >= 0 {
                parts.append(chr(hi * 16 + lo))
                i = i + 3
                continue
            }
        }
        parts.append(raw[i])
        i = i + 1
    }
    return join_strings(parts, "")
}

fn lsp_uri_to_path(uri: str) -> str {
    let mut raw = uri
    if len(uri) >= 7 and slice(uri, 0, 7) == "file://" {
        let rest = slice(uri, 7, len(uri))
        if len(rest) >= 10 and slice(rest, 0, 9) == "localhost" and rest[9] == "/" {
            raw = slice(rest, 9, len(rest))
        } else {
            raw = rest
        }
        raw = lsp_uri_decode_pct(raw)
        if len(raw) >= 3 and raw[0] == "/" and is_alpha(ord(raw[1])) and raw[2] == ":" {
            raw = slice(raw, 1, len(raw))
        }
    }
    return module_canonical(raw)
}

fn lsp_path_to_uri(path: str) -> str {
    let canon = module_canonical(path)
    let mut prefix = "file://"
    if len(canon) >= 2 and is_alpha(ord(canon[0])) and canon[1] == ":" {
        prefix = "file:///"
    } elif len(canon) == 0 or canon[0] != "/" {
        prefix = "file:///"
    }
    let mut parts: list[str] = [prefix]
    for i in 0..len(canon) {
        let ch = canon[i]
        if ch == " " { parts.append("%20") }
        elif ch == "#" { parts.append("%23") }
        elif ch == "?" { parts.append("%3F") }
        elif ch == "%" { parts.append("%25") }
        else { parts.append(ch) }
    }
    return join_strings(parts, "")
}

fn lsp_utf16_offset(src: str, target_line: int, target_char: int) -> int {
    let n = len(src)
    let mut line = 0
    let mut i = 0
    while i < n and line < target_line {
        if src[i] == "\n" { line = line + 1 }
        i = i + 1
    }
    let mut u16 = 0
    while i < n and src[i] != "\n" and u16 < target_char {
        let width = if ord(src[i]) > 65535 { 2 } else { 1 }
        if u16 + width > target_char { break }
        u16 = u16 + width
        i = i + 1
    }
    return i
}

fn lsp_utf16_pos(src: str, char_off: int) -> list[int] {
    let mut limit = char_off
    let n = len(src)
    if limit < 0 { limit = 0 }
    if limit > n { limit = n }
    let mut line = 0
    let mut u16 = 0
    for i in 0..limit {
        if src[i] == "\n" {
            line = line + 1
            u16 = 0
        } else {
            u16 = u16 + (if ord(src[i]) > 65535 { 2 } else { 1 })
        }
    }
    return [line, u16]
}

fn lsp_char_offset_from_utf8_byte(src: str, target_byte: int) -> int {
    if target_byte <= 0 { return 0 }
    let mut byte_pos = 0
    let mut i = 0
    let n = len(src)
    while i < n and byte_pos < target_byte {
        let cp = ord(src[i])
        let w = if cp < 128 { 1 } elif cp < 2048 { 2 } elif cp < 65536 { 3 } else { 4 }
        byte_pos = byte_pos + w
        i = i + 1
    }
    return i
}

fn lsp_pos_json(line: int, ch: int) -> str {
    return "{\"line\":" + str(line) + ",\"character\":" + str(ch) + "}"
}

fn lsp_range_json_offsets(src: str, start_off: int, end_off: int) -> str {
    let p0 = lsp_utf16_pos(src, start_off)
    let p1 = lsp_utf16_pos(src, end_off)
    return "{\"start\":" + lsp_pos_json(p0[0], p0[1]) + ",\"end\":" + lsp_pos_json(p1[0], p1[1]) + "}"
}

fn lsp_span_range_json(src: str, line_1: int, col_1: int, width_chars: int) -> str {
    let l1 = if line_1 < 1 { 1 } else { line_1 }
    let c1 = if col_1 < 1 { 1 } else { col_1 }
    let start_off = lsp_utf16_offset(src, l1 - 1, c1 - 1)
    let w = if width_chars < 1 { 1 } else { width_chars }
    let mut end_off = start_off + w
    if end_off > len(src) { end_off = len(src) }
    return lsp_range_json_offsets(src, start_off, end_off)
}

class LspDocument {
    uri: str
    path: str
    version: int
    text: str
    tmp_path: str
    has_graph: bool
    clean_ok: bool
    graph: ToolGraph
    diagnostics: list[LspJson]
    function_sites: list[LspRenameSite]

    fn init(uri: str, path: str, version: int, text: str, tmp_path: str) {
        this.uri = uri
        this.path = path
        this.version = version
        this.text = text
        this.tmp_path = tmp_path
        this.has_graph = false
        this.clean_ok = false
        this.graph = ToolGraph(path, text)
        let diagnostics: list[LspJson] = []
        this.diagnostics = diagnostics
        let sites: list[LspRenameSite] = []
        this.function_sites = sites
    }
}

class LspServerState {
    docs: list[LspDocument]
    stopping: bool
    eof_reached: bool
    tmp_seq: int
    tmp_dir: str
    diag_tmp_path: str
    self_exe: str
    stdlib_root: str
    workspace_roots: list[str]

    fn init(tmp_dir: str) {
        let d0: list[LspDocument] = []
        this.docs = d0
        this.stopping = false
        this.eof_reached = false
        this.tmp_seq = 1
        this.tmp_dir = tmp_dir
        this.diag_tmp_path = tmp_dir + "/diagnostics.json"
        this.self_exe = lsp_self_exe_path()
        this.stdlib_root = lsp_stdlib_root_arg()
        let roots: list[str] = []
        this.workspace_roots = roots
    }
}

fn lsp_find_doc_idx(state: LspServerState, uri: str) -> int {
    for i in 0..len(state.docs) {
        if state.docs[i].uri == uri { return i }
    }
    return -1
}

fn lsp_overlay_paths(state: LspServerState) -> list[str] {
    let mut paths: list[str] = []
    for doc in state.docs { paths.append(doc.path) }
    return paths
}

fn lsp_overlay_texts(state: LspServerState) -> list[str] {
    let mut texts: list[str] = []
    for doc in state.docs { texts.append(doc.text) }
    return texts
}

fn lsp_apply_content_changes(text: str, changes: LspJson) -> str {
    if changes.kind != "array" { return text }
    let mut current = text
    for change in changes.items {
        let rep = lsp_json_str(change, "text", "")
        if lsp_json_has(change, "range") {
            let rng = lsp_json_get(change, "range")
            let st = lsp_json_get(rng, "start")
            let en = lsp_json_get(rng, "end")
            let start_off = lsp_utf16_offset(current, lsp_json_int(st, "line", 0), lsp_json_int(st, "character", 0))
            let end_off = lsp_utf16_offset(current, lsp_json_int(en, "line", 0), lsp_json_int(en, "character", 0))
            current = slice(current, 0, start_off) + rep + slice(current, end_off, len(current))
        } else {
            current = rep
        }
    }
    return current
}

fn lsp_publish_empty_diags(uri: str) -> unit {
    lsp_send_message("{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{\"uri\":" + diag_json_quote(uri) + ",\"diagnostics\":[]}}")
}

fn lsp_check_snapshot(state: LspServerState, path: str, paths: list[str], snapshots: list[str]) -> str {
    let mut argv: list[str] = []
    if state.stdlib_root != "" {
        argv.append("--stdlib-root")
        argv.append(state.stdlib_root)
    }
    argv.append("check")
    argv.append(path)
    argv.append("--output-format=json-v1")
    argv.append("--diag-out")
    argv.append(state.diag_tmp_path)
    for index in 0..len(paths) {
        argv.append("--overlay")
        argv.append(paths[index])
        argv.append(snapshots[index])
    }
    let exe_buf = lsp_buf_from_str(state.self_exe)
    let args_buf = lsp_pack_argv_buf(argv)
    let rc = wysna_host_process_run(exe_buf, args_buf, 30000)
    wysna_host_close(exe_buf)
    wysna_host_close(args_buf)

    let diag_raw = read_file(state.diag_tmp_path) else err { "" }
    lsp_remove_file(state.diag_tmp_path)
    if rc != 0 and lsp_json_str(lsp_parse_json(diag_raw), "status", "") == "ok" { return "" }
    return diag_raw
}

fn lsp_check_and_publish(state: LspServerState, doc_idx: int) -> unit {
    if doc_idx < 0 or doc_idx >= len(state.docs) { return }
    let doc = state.docs[doc_idx]
    let mut snapshots: list[str] = []
    for d in state.docs {
        write_file(d.tmp_path, d.text) else _err { return }
        snapshots.append(d.tmp_path)
    }
    let diag_raw = lsp_check_snapshot(state, doc.path, lsp_overlay_paths(state), snapshots)
    let mut diag_items: list[str] = []
    let mut diagnostics: list[LspJson] = []
    let mut parsed_ok = false
    if diag_raw != "" {
        let parsed = lsp_parse_json(diag_raw)
        if lsp_json_str(parsed, "status", "") == "ok" {
            parsed_ok = true
        }
        let d_arr = lsp_json_get(parsed, "diagnostics")
        if d_arr.kind == "array" {
            for item in d_arr.items {
                diagnostics.append(item)
                let code = lsp_json_str(item, "code", "W0001")
                let sev_str = lsp_json_str(item, "severity", "error")
                let sev = if sev_str == "warning" { 2 } elif sev_str == "info" { 3 } else { 1 }
                let msg = lsp_json_str(item, "message", "Compiler diagnostic")
                let sp = lsp_json_get(item, "primary_span")
                let mut range_json = "{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":0,\"character\":1}}"
                if sp.kind == "object" {
                    let sb = lsp_json_int(sp, "start_byte", 0)
                    let eb = lsp_json_int(sp, "end_byte", sb + 1)
                    let span_file = lsp_json_str(sp, "source_id", "")
                    let span_src = lsp_node_source_text(state, doc, span_file)
                    let start_c = lsp_char_offset_from_utf8_byte(span_src, sb)
                    let mut end_c = lsp_char_offset_from_utf8_byte(span_src, eb)
                    if end_c <= start_c { end_c = start_c + 1 }
                    if end_c > len(span_src) { end_c = len(span_src) }
                    range_json = lsp_range_json_offsets(span_src, start_c, end_c)
                }
                diag_items.append("{\"range\":" + range_json + ",\"severity\":" + str(sev) + ",\"code\":" + diag_json_quote(code) + ",\"source\":\"wysna\",\"message\":" + diag_json_quote(msg) + "}")
            }
        }
    }
    doc.diagnostics = diagnostics
    lsp_send_message("{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{\"uri\":" + diag_json_quote(doc.uri) + ",\"diagnostics\":[" + join_strings(diag_items, ",") + "]}}")

    if parsed_ok {
        let paths = lsp_overlay_paths(state)
        let texts = lsp_overlay_texts(state)
        let loader = lsp_load_source(doc.text, doc.path, paths, texts)
        let program = check_program(loader.output, doc.path, true)
        doc.graph = tool_build_checked_graph(doc.text, doc.path, loader, program, false)
        doc.function_sites = lsp_collect_function_sites(loader, program)
        doc.has_graph = true
        doc.clean_ok = true
    } else {
        doc.clean_ok = false
    }
}

fn lsp_ident_bounds_at(src: str, offset: int) -> list[int] {
    let n = len(src)
    let mut pos = offset
    if pos > 0 and (pos == n or not is_alnum(ord(src[pos]))) and is_alnum(ord(src[pos - 1])) {
        pos = pos - 1
    }
    if pos >= n or not is_alnum(ord(src[pos])) { return [-1, -1] }
    let mut lo = pos
    while lo > 0 and is_alnum(ord(src[lo - 1])) { lo = lo - 1 }
    let mut hi = pos + 1
    while hi < n and is_alnum(ord(src[hi])) { hi = hi + 1 }
    if is_digit(ord(src[lo])) { return [-1, -1] }
    return [lo, hi]
}

fn lsp_qualifier_before(src: str, ident_lo: int) -> str {
    if ident_lo < 2 or src[ident_lo - 1] != "." { return "" }
    let mut q_hi = ident_lo - 1
    let mut q_lo = q_hi
    while q_lo > 0 and is_alnum(ord(src[q_lo - 1])) { q_lo = q_lo - 1 }
    if q_lo == q_hi { return "" }
    return slice(src, q_lo, q_hi)
}

fn lsp_resolve_nodes_at(doc: LspDocument, line: int, character: int) -> list[int] {
    let mut matched: list[int] = []
    if not doc.has_graph { return matched }
    let off = lsp_utf16_offset(doc.text, line, character)
    let bounds = lsp_ident_bounds_at(doc.text, off)
    if bounds[0] < 0 { return matched }
    let word = slice(doc.text, bounds[0], bounds[1])
    let qual = lsp_qualifier_before(doc.text, bounds[0])
    if qual != "" {
        let dotted = qual + "." + word
        for i in 0..len(doc.graph.nodes) {
            let n = doc.graph.nodes[i]
            if n.qualified_name == dotted or n.name == word and (n.owner == qual or tool_basename(n.file) == qual + ".wysna") {
                matched.append(i)
            }
        }
        if len(matched) > 0 { return matched }
    }
    for i in 0..len(doc.graph.nodes) {
        let n = doc.graph.nodes[i]
        if n.name == word or n.qualified_name == word { matched.append(i) }
    }
    return matched
}

fn lsp_node_source_text(state: LspServerState, doc: LspDocument, file: str) -> str {
    if file == doc.path { return doc.text }
    for d in state.docs {
        if d.path == file { return d.text }
    }
    let res = module_read_text_or_overlay(file)
    return if res[0] == "1" { res[1] } else { doc.text }
}

fn lsp_node_location_json(state: LspServerState, doc: LspDocument, n: ToolGraphNode) -> str {
    let target_src = lsp_node_source_text(state, doc, n.file)
    let range_json = lsp_span_range_json(target_src, n.line, n.col, len(n.name))
    return "{\"uri\":" + diag_json_quote(lsp_path_to_uri(n.file)) + ",\"range\":" + range_json + "}"
}

fn lsp_handle_definition(state: LspServerState, doc: LspDocument, pos_obj: LspJson) -> str {
    let idxs = lsp_resolve_nodes_at(doc, lsp_json_int(pos_obj, "line", 0), lsp_json_int(pos_obj, "character", 0))
    if len(idxs) == 0 { return "null" }
    return lsp_node_location_json(state, doc, doc.graph.nodes[idxs[0]])
}

fn lsp_handle_implementation(state: LspServerState, doc: LspDocument, pos_obj: LspJson) -> str {
    let idxs = lsp_resolve_nodes_at(doc, lsp_json_int(pos_obj, "line", 0), lsp_json_int(pos_obj, "character", 0))
    if len(idxs) == 0 { return "[]" }
    let node = doc.graph.nodes[idxs[0]]
    let mut locs: list[str] = []
    for target_id in node.implemented_by {
        let tidx = tool_find_node_idx(doc.graph, target_id)
        if tidx >= 0 { locs.append(lsp_node_location_json(state, doc, doc.graph.nodes[tidx])) }
    }
    for sub_id in node.subclasses {
        let sidx = tool_find_node_idx(doc.graph, sub_id)
        if sidx >= 0 { locs.append(lsp_node_location_json(state, doc, doc.graph.nodes[sidx])) }
    }
    return "[" + join_strings(locs, ",") + "]"
}

fn lsp_rel_line(label: str, items: list[str]) -> str {
    if len(items) == 0 { return "" }
    return "- **" + label + ":** `" + join_strings(items, "`, `") + "`"
}

fn lsp_add_rel(lines: list[str], label: str, items: list[str]) -> list[str] {
    let entry = lsp_rel_line(label, items)
    if entry == "" { return lines }
    let mut out = lines
    out.append(entry)
    return out
}

fn lsp_handle_hover(doc: LspDocument, pos_obj: LspJson) -> str {
    let idxs = lsp_resolve_nodes_at(doc, lsp_json_int(pos_obj, "line", 0), lsp_json_int(pos_obj, "character", 0))
    if len(idxs) == 0 { return "null" }
    let n = doc.graph.nodes[idxs[0]]
    let mut lines: list[str] = ["```wysna", n.signature, "```", "", "`" + n.kind + "` in `" + tool_basename(n.file) + "`"]
    if n.super_class != "" { lines.append("- **Extends:** `" + n.super_class + "`") }
    lines = lsp_add_rel(lines, "Implements", n.implements_list)
    lines = lsp_add_rel(lines, "Implemented by", n.implemented_by)
    lines = lsp_add_rel(lines, "Subclasses", n.subclasses)
    lines = lsp_add_rel(lines, "Calls", n.calls)
    lines = lsp_add_rel(lines, "Called by", n.called_by)
    lines = lsp_add_rel(lines, "Uses types", n.uses_types)
    lines = lsp_add_rel(lines, "Effects", n.effects)
    lines = lsp_add_rel(lines, "Capabilities", n.capabilities)
    let md = join_strings(lines, "\n")
    return "{\"contents\":{\"kind\":\"markdown\",\"value\":" + diag_json_quote(md) + "}}"
}

class LspRefCollector {
    locs: list[str]
    seen: list[str]

    fn init() {
        let l0: list[str] = []
        this.locs = l0
        let s0: list[str] = []
        this.seen = s0
    }
}

fn lsp_scan_word_locs(acc: LspRefCollector, file_path: str, src: str, word: str, skip_decl_line: int) -> unit {
    let n = len(src)
    let wlen = len(word)
    let uri = lsp_path_to_uri(file_path)
    let mut i = 0
    while i < n {
        if src[i] == "#" {
            while i < n and src[i] != "\n" { i = i + 1 }
            continue
        }
        if is_alpha(ord(src[i])) or src[i] == "_" {
            let start = i
            while i < n and is_alnum(ord(src[i])) { i = i + 1 }
            if i - start == wlen and slice(src, start, i) == word {
                let pos = lsp_utf16_pos(src, start)
                if skip_decl_line > 0 and pos[0] + 1 == skip_decl_line { continue }
                let loc_key = uri + ":" + str(pos[0]) + ":" + str(pos[1])
                if not tool_str_contains(acc.seen, loc_key) {
                    acc.seen.append(loc_key)
                    acc.locs.append("{\"uri\":" + diag_json_quote(uri) + ",\"range\":" + lsp_range_json_offsets(src, start, i) + "}")
                }
            }
        } else {
            i = i + 1
        }
    }
}

fn lsp_handle_references(state: LspServerState, doc: LspDocument, pos_obj: LspJson, include_decl: bool) -> str {
    let off = lsp_utf16_offset(doc.text, lsp_json_int(pos_obj, "line", 0), lsp_json_int(pos_obj, "character", 0))
    let bounds = lsp_ident_bounds_at(doc.text, off)
    if bounds[0] < 0 { return "[]" }
    let word = slice(doc.text, bounds[0], bounds[1])
    let idxs = lsp_resolve_nodes_at(doc, lsp_json_int(pos_obj, "line", 0), lsp_json_int(pos_obj, "character", 0))
    let skip_file = if not include_decl and len(idxs) > 0 { doc.graph.nodes[idxs[0]].file } else { "" }
    let skip_line = if not include_decl and len(idxs) > 0 { doc.graph.nodes[idxs[0]].line } else { -1 }

    let acc = LspRefCollector()
    let mut scanned_files: list[str] = []
    for d in state.docs {
        scanned_files.append(d.path)
        let sk = if d.path == skip_file { skip_line } else { -1 }
        lsp_scan_word_locs(acc, d.path, d.text, word, sk)
    }
    if doc.has_graph {
        for mpath in doc.graph.mod_names {
            if not tool_str_contains(scanned_files, mpath) {
                scanned_files.append(mpath)
                let res = module_read_text_or_overlay(mpath)
                if res[0] == "1" {
                    let sk = if mpath == skip_file { skip_line } else { -1 }
                    lsp_scan_word_locs(acc, mpath, res[1], word, sk)
                }
            }
        }
    }
    return "[" + join_strings(acc.locs, ",") + "]"
}

fn lsp_completion_kind(kind: str) -> int {
    if kind == "fn" { return 3 }
    if kind == "method" { return 2 }
    if kind == "field" { return 5 }
    if kind == "struct" { return 22 }
    if kind == "class" { return 7 }
    if kind == "interface" { return 8 }
    if kind == "enum" { return 13 }
    return 6
}

fn lsp_handle_completion(doc: LspDocument, pos_obj: LspJson) -> str {
    let off = lsp_utf16_offset(doc.text, lsp_json_int(pos_obj, "line", 0), lsp_json_int(pos_obj, "character", 0))
    let mut lo = off
    while lo > 0 and is_alnum(ord(doc.text[lo - 1])) { lo = lo - 1 }
    let prefix = slice(doc.text, lo, off)
    let qual = lsp_qualifier_before(doc.text, lo)
    let mut items: list[str] = []
    let mut seen_labels: list[str] = []

    if doc.has_graph {
        for n in doc.graph.nodes {
            if qual != "" {
                let matches_owner = n.owner == qual or tool_short_name(n.owner) == qual or tool_basename(n.file) == qual + ".wysna"
                if not matches_owner { continue }
            }
            if prefix != "" and (len(n.name) < len(prefix) or slice(n.name, 0, len(prefix)) != prefix) {
                continue
            }
            if not tool_str_contains(seen_labels, n.name) {
                seen_labels.append(n.name)
                items.append("{\"label\":" + diag_json_quote(n.name) + ",\"kind\":" + str(lsp_completion_kind(n.kind)) + ",\"detail\":" + diag_json_quote(n.signature) + "}")
            }
        }
    }
    if qual == "" {
        let kws: list[str] = ["fn", "async", "struct", "class", "interface", "enum", "let", "mut", "if", "elif", "else", "for", "while", "match", "return", "await", "import", "pub", "priv", "true", "false", "None", "Some", "Ok", "Err"]
        for kw in kws {
            if prefix != "" and (len(kw) < len(prefix) or slice(kw, 0, len(prefix)) != prefix) { continue }
            if not tool_str_contains(seen_labels, kw) {
                seen_labels.append(kw)
                items.append("{\"label\":" + diag_json_quote(kw) + ",\"kind\":14}")
            }
        }
    }
    return "[" + join_strings(items, ",") + "]"
}

fn lsp_handle_formatting(doc: LspDocument) -> str {
    if not doc.clean_ok { return "[]" }
    let body = selfhost_format_body(doc.text, doc.path)
    let formatted = if len(body) > 0 { body + "\n" } else { "" }
    if formatted == doc.text { return "[]" }
    let rng = lsp_range_json_offsets(doc.text, 0, len(doc.text))
    return "[{\"range\":" + rng + ",\"newText\":" + diag_json_quote(formatted) + "}]"
}

fn lsp_semantic_tok_type(tok: Token) -> int {
    # Legend index: 0:keyword, 1:type, 2:class, 3:interface, 4:enum, 5:struct,
    # 6:function, 7:method, 8:property, 9:variable, 10:parameter, 11:string, 12:number, 13:operator
    let k = tok.kind
    if k == "STR" or k == "FSTR" { return 11 }
    if k == "INT" or k == "FLOAT" { return 12 }
    if k == "FN" or k == "LET" or k == "MUT" or k == "STRUCT" or k == "CLASS" or k == "INTERFACE" or k == "ENUM" or k == "IF" or k == "ELIF" or k == "ELSE" or k == "FOR" or k == "IN" or k == "WHILE" or k == "RETURN" or k == "MATCH" or k == "IMPORT" or k == "FROM" or k == "AS" or k == "PUB" or k == "PRIV" or k == "TRUE" or k == "FALSE" or k == "THIS" or k == "SUPER" or k == "EXTERN" or k == "AND" or k == "OR" or k == "NOT" or k == "REQUIRES" or k == "ENSURES" {
        return 0
    }
    if k == "IDENT" {
        if tok.val == "async" or tok.val == "await" { return 0 }
        if tok.val == "int" or tok.val == "float" or tok.val == "str" or tok.val == "bool" or tok.val == "unit" or tok.val == "list" or tok.val == "dict" or tok.val == "opaque" {
            return 1
        }
        if len(tok.val) > 0 and ord(tok.val[0]) >= 65 and ord(tok.val[0]) <= 90 { return 1 }
        return 9
    }
    if k == "PLUS" or k == "MINUS" or k == "STAR" or k == "SLASH" or k == "PERCENT" or k == "EQ" or k == "NEQ" or k == "LT" or k == "LTE" or k == "GT" or k == "GTE" or k == "ASSIGN" or k == "PLUS_ASSIGN" or k == "MINUS_ASSIGN" or k == "STAR_ASSIGN" or k == "ARROW" or k == "FAT_ARROW" {
        return 13
    }
    return -1
}

fn lsp_handle_semantic_tokens(doc: LspDocument) -> str {
    if not doc.clean_ok { return "{\"data\":[]}" }
    let tokens = tokenize(doc.text, doc.path)
    let mut nums: list[str] = []
    let mut prev_line = 0
    let mut prev_col = 0
    for i in 0..len(tokens) {
        let tok = tokens[i]
        let mut ttype = lsp_semantic_tok_type(tok)
        if ttype < 0 { continue }
        if ttype == 9 and i + 1 < len(tokens) and tokens[i + 1].kind == "LPAREN" {
            ttype = 6
        }
        let mut tok_len = len(tok.val)
        if tok.kind == "STR" { tok_len = tok_len + 2 }
        if tok_len <= 0 { continue }
        let line0 = if tok.line > 0 { tok.line - 1 } else { 0 }
        let off = lsp_utf16_offset(doc.text, line0, if tok.col > 0 { tok.col - 1 } else { 0 })
        let u16 = lsp_utf16_pos(doc.text, off)
        let cur_line = u16[0]
        let cur_col = u16[1]
        let d_line = cur_line - prev_line
        let d_col = if d_line == 0 { cur_col - prev_col } else { cur_col }
        nums.append(str(d_line))
        nums.append(str(d_col))
        nums.append(str(tok_len))
        nums.append(str(ttype))
        nums.append("0")
        prev_line = cur_line
        prev_col = cur_col
    }
    return "{\"data\":[" + join_strings(nums, ",") + "]}"
}

fn lsp_recheck_dependents(state: LspServerState, exclude_uri: str) -> unit {
    for i in 0..len(state.docs) {
        if state.docs[i].uri != exclude_uri {
            lsp_check_and_publish(state, i)
        }
    }
}

fn lsp_cleanup(state: LspServerState) -> unit {
    lsp_remove_file(state.diag_tmp_path)
    for d in state.docs { lsp_remove_file(d.tmp_path) }
    lsp_remove_file(state.tmp_dir)
}

fn lsp_range_offset(src: str, range_: LspJson, endpoint: str) -> int {
    let pos = lsp_json_get(range_, endpoint)
    return lsp_utf16_offset(src, lsp_json_int(pos, "line", 0), lsp_json_int(pos, "character", 0))
}

fn lsp_text_document_edit(uri: str, version: str, edits: list[str]) -> str {
    return "{\"textDocument\":{\"uri\":" + diag_json_quote(uri) + ",\"version\":" + version +
        "},\"edits\":[" + join_strings(edits, ",") + "]}"
}

fn lsp_edit_json(src: str, start: int, end: int, replacement: str) -> str {
    return "{\"range\":" + lsp_range_json_offsets(src, start, end) + ",\"newText\":" + diag_json_quote(replacement) + "}"
}

fn lsp_handle_code_actions(doc: LspDocument, params: LspJson) -> str {
    let only = lsp_json_get(lsp_json_get(params, "context"), "only")
    if only.kind == "array" and len(only.items) > 0 {
        let mut allowed = false
        for item in only.items { if item.str_val == "quickfix" or item.str_val == "" { allowed = true } }
        if not allowed { return "[]" }
    }
    if len(doc.diagnostics) == 0 { return "[]" }
    let range_ = lsp_json_get(params, "range")
    let requested_start = lsp_range_offset(doc.text, range_, "start")
    let requested_end = lsp_range_offset(doc.text, range_, "end")
    let sha = diag_sha256_hex(doc.text)
    let length = diag_utf8_byte_at(doc.text, len(doc.text))
    let mut actions: list[str] = []
    for diagnostic in doc.diagnostics {
        let span = lsp_json_get(diagnostic, "primary_span")
        if lsp_json_str(span, "source_id", "") != doc.path or lsp_json_str(span, "source_sha256", "") != sha { continue }
        let start = lsp_char_offset_from_utf8_byte(doc.text, lsp_json_int(span, "start_byte", 0))
        let end = lsp_char_offset_from_utf8_byte(doc.text, lsp_json_int(span, "end_byte", 0))
        if range_.kind == "object" and (end < requested_start or start > requested_end) { continue }
        let code = lsp_json_str(diagnostic, "code", "")
        for fix in lsp_json_get(diagnostic, "fixes").items {
            let proposed = lsp_json_get(fix, "edits").items
            let mut edits: list[str] = []
            for edit in proposed {
                let start_byte = lsp_json_int(edit, "start_byte", -1)
                let end_byte = lsp_json_int(edit, "end_byte", -1)
                if start_byte < 0 or end_byte < start_byte or end_byte > length or
                   lsp_json_str(edit, "source_id", "") != doc.path or lsp_json_str(edit, "source_sha256", "") != sha { break }
                let start_char = lsp_char_offset_from_utf8_byte(doc.text, start_byte)
                let end_char = lsp_char_offset_from_utf8_byte(doc.text, end_byte)
                if diag_utf8_byte_at(doc.text, start_char) != start_byte or diag_utf8_byte_at(doc.text, end_char) != end_byte { break }
                edits.append(lsp_edit_json(doc.text, start_char, end_char, lsp_json_str(edit, "replacement", "")))
            }
            if len(edits) == 0 or len(edits) != len(proposed) { continue }
            let title = "[" + code + "] " + lsp_json_str(fix, "description", "Repair diagnostic")
            let preferred = if lsp_json_str(fix, "applicability", "") == "machine" { "true" } else { "false" }
            actions.append("{\"title\":" + diag_json_quote(title) + ",\"kind\":\"quickfix\",\"isPreferred\":" + preferred +
                ",\"edit\":{\"documentChanges\":[" + lsp_text_document_edit(doc.uri, str(doc.version), edits) + "]}}")
        }
    }
    return "[" + join_strings(actions, ",") + "]"
}

# Inspect incomplete calls without asking the reporting lexer to accept invalid editor text.
fn lsp_call_prefix(src: str, limit: int) -> list[int] {
    let mut delimiters: list[str] = []
    let mut opens: list[int] = []
    let mut commas: list[int] = []
    let mut i = 0
    while i < limit {
        let ch = src[i]
        if ch == "#" {
            while i < limit and src[i] != "\n" { i += 1 }
        } elif ch == "\"" {
            let quote_width = if i + 2 < limit and src[i + 1] == "\"" and src[i + 2] == "\"" { 3 } else { 1 }
            i += quote_width
            while i < limit {
                if src[i] == "\\" { i += 2 }
                elif src[i] == "\"" and (quote_width == 1 or
                     (i + 2 < limit and src[i + 1] == "\"" and src[i + 2] == "\"")) {
                    i += quote_width
                    break
                } else { i += 1 }
            }
        } else {
            if ch == "(" or ch == "[" or ch == "{" {
                opens.append(i)
                delimiters.append(ch)
                commas.append(0)
            } elif (ch == ")" or ch == "]" or ch == "}") and len(opens) > 0 {
                delimiters.pop()
                opens.pop()
                commas.pop()
            } elif ch == "," and len(opens) > 0 {
                commas[len(commas) - 1] += 1
            }
            i += 1
        }
    }
    for index in 0..len(opens) {
        let last = len(opens) - 1 - index
        if delimiters[last] == "(" { return [opens[last], commas[last]] }
    }
    return [-1, 0]
}

fn lsp_signature_parameters(label: str) -> list[str] {
    let mut params: list[str] = []
    let mut depth = 0
    let mut start = -1
    for i in 0..len(label) {
        let ch = label[i]
        if start < 0 {
            if ch == "(" { start = i + 1 }
        } elif depth == 0 and (ch == "," or ch == ")") {
            let param = lsp_trim(slice(label, start, i))
            if param != "" { params.append("{\"label\":" + diag_json_quote(param) + "}") }
            if ch == ")" { break }
            start = i + 1
        } elif ch == "(" or ch == "[" { depth += 1 }
        elif ch == ")" or ch == "]" { depth -= 1 }
    }
    return params
}

fn lsp_handle_signature_help(doc: LspDocument, pos: LspJson) -> str {
    let offset = lsp_utf16_offset(doc.text, lsp_json_int(pos, "line", 0), lsp_json_int(pos, "character", 0))
    let call = lsp_call_prefix(doc.text, offset)
    if call[0] <= 0 { return "null" }
    let mut callee_end = call[0]
    while callee_end > 0 and (doc.text[callee_end - 1] == " " or doc.text[callee_end - 1] == "\t") { callee_end -= 1 }
    if callee_end > 0 and doc.text[callee_end - 1] == "]" {
        let mut depth = 1
        callee_end -= 1
        while callee_end > 0 and depth > 0 {
            callee_end -= 1
            if doc.text[callee_end] == "]" { depth += 1 }
            elif doc.text[callee_end] == "[" { depth -= 1 }
        }
    }
    let callee = lsp_ident_bounds_at(doc.text, callee_end)
    if callee[0] < 0 or callee[1] != callee_end { return "null" }
    let callee_pos = lsp_utf16_pos(doc.text, callee[0])
    let mut candidates: list[int] = []
    let spelling = slice(doc.text, callee[0], callee[1])
    for site in doc.function_sites {
        if site.source.val != spelling or not lsp_rename_token_at(doc, site.source, callee[0]) { continue }
        for index in 0..len(doc.graph.nodes) {
            let node = doc.graph.nodes[index]
            if node.name == site.declaration.val and node.file == site.declaration.file and node.line == site.declaration.line and not (index in candidates) {
                candidates.append(index)
            }
        }
    }
    if len(candidates) == 0 { candidates = lsp_resolve_nodes_at(doc, callee_pos[0], callee_pos[1]) }
    let mut signatures: list[str] = []
    let mut active = 0
    for candidate in candidates {
        let node = doc.graph.nodes[candidate]
        if node.kind != "fn" and node.kind != "method" and node.kind != "extern" { continue }
        let params = lsp_signature_parameters(node.signature)
        if len(signatures) == 0 and len(params) > 0 {
            active = if call[1] < len(params) { call[1] } else { len(params) - 1 }
        }
        signatures.append("{\"label\":" + diag_json_quote(node.signature) + ",\"parameters\":[" + join_strings(params, ",") + "]}")
    }
    if len(signatures) == 0 { return "null" }
    return "{\"signatures\":[" + join_strings(signatures, ",") + "],\"activeSignature\":0,\"activeParameter\":" + str(active) + "}"
}

struct LspRenameSite { source: Token, declaration: Token, rewrite: bool }

fn lsp_same_token(left: Token, right: Token) -> bool {
    return left.file == right.file and left.line == right.line and left.col == right.col
}

fn lsp_token_key(token: Token) -> str {
    return token.file + ":" + str(token.line) + ":" + str(token.col) + ":" + token.val
}

fn lsp_load_source(src: str, file: str, paths: list[str], texts: list[str]) -> ModuleLoader {
    let loader = ModuleLoader()
    loader.ov_paths = paths
    loader.ov_texts = texts
    loader.trace_names = true
    module_expand(loader, src, file, true)
    loader.output.append(Token { kind: "EOF", val: "", line: 1, col: 1, file: file })
    return loader
}

fn lsp_collect_function_sites(loader: ModuleLoader, program: CheckedProgram) -> list[LspRenameSite] {
    let mut declarations: dict[str, Token] = {}
    let mut sites: list[LspRenameSite] = []
    let mut depth = 0
    for i in 0..len(loader.output) - 1 {
        let token = loader.output[i]
        if depth == 0 and token.kind == "FN" and loader.output[i + 1].kind == "IDENT" {
            let name = loader.output[i + 1]
            let where_ = Token { kind: "IDENT", val: tool_short_name(name.val), file: name.file, line: name.line, col: name.col }
            declarations[name.val] = where_
            sites.append(LspRenameSite { source: where_, declaration: where_, rewrite: true })
        }
        if token.kind == "LBRACE" { depth += 1 }
        elif token.kind == "RBRACE" { depth -= 1 }
    }
    let mut translations: dict[str, ModuleNameSite] = {}
    for site in loader.name_sites {
        if site.import_site {
            let target = declarations.get(site.expanded.val) else { continue }
            sites.append(LspRenameSite { source: site.source, declaration: target, rewrite: true })
        } else {
            translations[lsp_token_key(site.expanded)] = site
        }
    }
    for node in program.nodes {
        if node.kind != "callee" or node.target < 0 { continue }
        let name = program.signatures[node.target].name
        let target = declarations.get(name) else { continue }
        let original = node.source
        let fallback = Token { kind: "IDENT", val: target.val, file: original.file, line: original.line, col: original.col }
        let translated = translations.get(lsp_token_key(original)) else {
            ModuleNameSite { source: fallback, expanded: original, import_site: false, rewrite: true }
        }
        sites.append(LspRenameSite { source: translated.source, declaration: target, rewrite: translated.rewrite })
    }
    return sites
}

fn lsp_workspace_files(directory: str) -> list[str] ! str {
    let input = lsp_buf_from_str(directory)
    let output = wysna_host_buffer_new()
    let count = wysna_host_project_entries(input, output)
    wysna_host_close(input)
    let raw = if count >= 0 { lsp_buf_to_str(output, count) } else { "" }
    wysna_host_close(output)
    if count < 0 { return Err("cannot read workspace directory") }
    let mut files: list[str] = []
    let mut i = 0
    while i < len(raw) {
        let kind = raw[i]
        i += 1
        let start = i
        while i < len(raw) and ord(raw[i]) != 0 { i += 1 }
        let name = slice(raw, start, i)
        i += 1
        if name == "" or name[0] == "." or name == "node_modules" or name == "dist" { continue }
        let path = directory + "/" + name
        if kind == "d" {
            for nested in lsp_workspace_files(path)? { files.append(nested) }
        } elif kind == "f" and proj_str_ends_with(name, ".wysna") {
            files.append(path)
        }
    }
    return Ok(files)
}

class LspRenameWorkspace {
    paths: list[str]
    texts: list[str]
    snapshots: list[str]
    versions: list[str]
    candidates: list[int]

    fn init() {
        let strings: list[str] = []
        let integers: list[int] = []
        this.paths = strings
        this.texts = strings
        this.snapshots = strings
        this.versions = strings
        this.candidates = integers
    }
}

fn lsp_stage_rename_workspace(state: LspServerState, workspace: LspRenameWorkspace, files: list[str], root: str, spelling: str) -> bool {
    for doc in state.docs {
        workspace.paths.append(doc.path)
        workspace.texts.append(doc.text)
        workspace.versions.append(str(doc.version))
    }
    for file in files {
        if tool_str_contains(workspace.paths, file) { continue }
        let source = read_file(file) else error { return false }
        if proj_str_contains_substr(source, spelling) {
            workspace.paths.append(file)
            workspace.texts.append(source)
            workspace.versions.append("null")
        }
    }
    for i in 0..len(workspace.paths) {
        let snapshot = lsp_next_tmp_path(state, "wysna_lsp_rename", ".wysna")
        workspace.snapshots.append(snapshot)
        write_file(snapshot, workspace.texts[i]) else error { return false }
        if module_is_confined_under(workspace.paths[i], root) and proj_str_contains_substr(workspace.texts[i], spelling) {
            workspace.candidates.append(i)
        }
    }
    return true
}

fn lsp_rename_token_at(doc: LspDocument, site: Token, offset: int) -> bool {
    if site.file != doc.path { return false }
    let start = diag_char_offset_at(doc.text, site.line, site.col)
    return start >= 0 and start <= offset and offset <= start + len(site.val)
}

fn lsp_snapshot_is_valid(state: LspServerState, workspace: LspRenameWorkspace, index: int) -> bool {
    let raw = lsp_check_snapshot(state, workspace.paths[index], workspace.paths, workspace.snapshots)
    return lsp_json_str(lsp_parse_json(raw), "status", "") == "ok"
}

fn lsp_workspace_rename_edits(state: LspServerState, workspace: LspRenameWorkspace, declaration: Token, new_name: str) -> str {
    let mut changes: list[str] = []
    let mut updated = workspace.texts
    for index in workspace.candidates {
        if not lsp_snapshot_is_valid(state, workspace, index) { return "null" }
        let file = workspace.paths[index]
        let text = workspace.texts[index]
        let loader = lsp_load_source(text, file, workspace.paths, workspace.texts)
        let sites = lsp_collect_function_sites(loader, check_program(loader.output, file, true))
        let mut edits: list[str] = []
        let mut patches: list[FixEdit] = []
        let mut seen: list[int] = []
        for site in sites {
            if not site.rewrite or site.source.file != file or not lsp_same_token(site.declaration, declaration) { continue }
            let start = diag_char_offset_at(text, site.source.line, site.source.col)
            let end = start + len(site.source.val)
            if start < 0 or end > len(text) or slice(text, start, end) != site.source.val { return "null" }
            if start in seen { continue }
            seen.append(start)
            edits.append(lsp_edit_json(text, start, end, new_name))
            patches.append(FixEdit("", "", "", diag_utf8_byte_at(text, start), diag_utf8_byte_at(text, end), new_name))
        }
        if len(edits) == 0 { continue }
        for token in tokenize(text, file) {
            if token.kind == "IDENT" and token.val == new_name { return "null" }
        }
        changes.append(lsp_text_document_edit(lsp_path_to_uri(file), workspace.versions[index], edits))
        updated[index] = fix_apply_non_overlapping(text, patches)
    }
    if len(changes) == 0 { return "null" }
    for index in workspace.candidates {
        if updated[index] != workspace.texts[index] {
            write_file(workspace.snapshots[index], updated[index]) else error { return "null" }
        }
    }
    for index in workspace.candidates {
        if not lsp_snapshot_is_valid(state, workspace, index) { return "null" }
    }
    return "{\"documentChanges\":[" + join_strings(changes, ",") + "]}"
}

fn lsp_handle_rename(state: LspServerState, doc: LspDocument, pos: LspJson, new_name: str) -> str {
    if not doc.clean_ok or new_name == "" or not (is_alpha(ord(new_name[0])) or new_name[0] == "_") or
       new_name == "main" or new_name == "_" or sem_builtin(new_name) { return "null" }
    if (len(new_name) >= 8 and slice(new_name, 0, 8) == "__wysna_") or
       (len(new_name) >= 7 and slice(new_name, 0, 7) == "_WYSNA_") { return "null" }
    for i in 0..len(new_name) { if not is_alnum(ord(new_name[i])) { return "null" } }
    if tokenize(new_name, doc.path)[0].kind != "IDENT" { return "null" }
    let offset = lsp_utf16_offset(doc.text, lsp_json_int(pos, "line", 0), lsp_json_int(pos, "character", 0))
    for site in doc.function_sites {
        if not lsp_rename_token_at(doc, site.source, offset) { continue }
        let declaration = site.declaration
        if declaration.val == "main" or declaration.val == new_name { return "null" }
        let mut root = ""
        for candidate in state.workspace_roots {
            if len(candidate) > len(root) and module_is_confined_under(doc.path, candidate) and
               module_is_confined_under(declaration.file, candidate) { root = candidate }
        }
        if root == "" { return "null" }
        let files = lsp_workspace_files(root) else error { return "null" }
        if not tool_str_contains(files, declaration.file) { return "null" }
        let workspace = LspRenameWorkspace()
        let staged = lsp_stage_rename_workspace(state, workspace, files, root, declaration.val)
        let result = if staged { lsp_workspace_rename_edits(state, workspace, declaration, new_name) } else { "null" }
        for snapshot in workspace.snapshots { lsp_remove_file(snapshot) }
        return result
    }
    return "null"
}

fn lsp_dispatch_message(state: LspServerState, msg: LspJson) -> bool {
    let method = lsp_json_str(msg, "method", "")
    let params = lsp_json_get(msg, "params")
    let has_id = lsp_json_has(msg, "id")
    let req_id_raw = if has_id { lsp_json_raw_literal(lsp_json_get(msg, "id")) } else { "null" }

    if method == "initialize" {
        let mut roots: list[str] = []
        for folder in lsp_json_get(params, "workspaceFolders").items {
            let path = lsp_uri_to_path(lsp_json_str(folder, "uri", ""))
            if path != "" { roots.append(module_canonical(path)) }
        }
        if len(roots) == 0 {
            let path = lsp_uri_to_path(lsp_json_str(params, "rootUri", ""))
            if path != "" { roots.append(module_canonical(path)) }
        }
        state.workspace_roots = roots
        let legend = "\"tokenTypes\":[\"keyword\",\"type\",\"class\",\"interface\",\"enum\",\"struct\",\"function\",\"method\",\"property\",\"variable\",\"parameter\",\"string\",\"number\",\"operator\",\"comment\"],\"tokenModifiers\":[]"
        let caps = "\"positionEncoding\":\"utf-16\",\"textDocumentSync\":{\"openClose\":true,\"change\":2},\"definitionProvider\":true,\"implementationProvider\":true,\"hoverProvider\":true,\"referencesProvider\":true,\"documentFormattingProvider\":true,\"completionProvider\":{\"triggerCharacters\":[\".\"]},\"codeActionProvider\":{\"codeActionKinds\":[\"quickfix\"]},\"renameProvider\":true,\"signatureHelpProvider\":{\"triggerCharacters\":[\"(\",\",\"]},\"semanticTokensProvider\":{\"legend\":{" + legend + "},\"full\":true,\"range\":false}"
        let res = "{\"capabilities\":{" + caps + ("},\"serverInfo\":{\"name\":\"wysna-native\",\"version\":\"" + tool_compiler_version() + "\"}}")
        if has_id { lsp_send_message("{\"jsonrpc\":\"2.0\",\"id\":" + req_id_raw + ",\"result\":" + res + "}") }
        return true
    }
    if method == "initialized" { return true }
    if method == "shutdown" {
        state.stopping = true
        if has_id { lsp_send_message("{\"jsonrpc\":\"2.0\",\"id\":" + req_id_raw + ",\"result\":null}") }
        return true
    }
    if method == "exit" { return false }
    if state.stopping {
        if has_id { lsp_send_message("{\"jsonrpc\":\"2.0\",\"id\":" + req_id_raw + ",\"error\":{\"code\":-32600,\"message\":\"Server is shutting down\"}}") }
        return true
    }

    if method == "textDocument/didOpen" {
        let td = lsp_json_get(params, "textDocument")
        let uri = lsp_json_str(td, "uri", "")
        let text = lsp_json_str(td, "text", "")
        let version = lsp_json_int(td, "version", 0)
        let path = lsp_uri_to_path(uri)
        let existing = lsp_find_doc_idx(state, uri)
        if existing >= 0 {
            state.docs[existing].text = text
            state.docs[existing].version = version
            lsp_check_and_publish(state, existing)
        } else {
            let tmp_p = lsp_next_tmp_path(state, "wysna_lsp_doc", ".wysna")
            let doc = LspDocument(uri, path, version, text, tmp_p)
            state.docs.append(doc)
            lsp_check_and_publish(state, len(state.docs) - 1)
        }
        lsp_recheck_dependents(state, uri)
        return true
    }
    if method == "textDocument/didChange" {
        let td = lsp_json_get(params, "textDocument")
        let uri = lsp_json_str(td, "uri", "")
        let version = lsp_json_int(td, "version", 0)
        let idx = lsp_find_doc_idx(state, uri)
        if idx >= 0 and version >= state.docs[idx].version {
            state.docs[idx].version = version
            state.docs[idx].text = lsp_apply_content_changes(state.docs[idx].text, lsp_json_get(params, "contentChanges"))
            lsp_check_and_publish(state, idx)
            lsp_recheck_dependents(state, uri)
        }
        return true
    }
    if method == "textDocument/didClose" {
        let td = lsp_json_get(params, "textDocument")
        let uri = lsp_json_str(td, "uri", "")
        let idx = lsp_find_doc_idx(state, uri)
        if idx >= 0 {
            lsp_remove_file(state.docs[idx].tmp_path)
            let mut next_docs: list[LspDocument] = []
            for j in 0..len(state.docs) {
                if j != idx { next_docs.append(state.docs[j]) }
            }
            state.docs = next_docs
        }
        lsp_publish_empty_diags(uri)
        lsp_recheck_dependents(state, uri)
        return true
    }

    let td_req = lsp_json_get(params, "textDocument")
    let req_uri = lsp_json_str(td_req, "uri", "")
    let req_pos = lsp_json_get(params, "position")
    let idx = lsp_find_doc_idx(state, req_uri)
    let mut result_json = "null"
    let mut handled = true

    if method == "textDocument/definition" {
        result_json = if idx >= 0 { lsp_handle_definition(state, state.docs[idx], req_pos) } else { "null" }
    } elif method == "textDocument/implementation" {
        result_json = if idx >= 0 { lsp_handle_implementation(state, state.docs[idx], req_pos) } else { "[]" }
    } elif method == "textDocument/hover" {
        result_json = if idx >= 0 { lsp_handle_hover(state.docs[idx], req_pos) } else { "null" }
    } elif method == "textDocument/references" {
        let ctx = lsp_json_get(params, "context")
        let inc_decl = lsp_json_bool(ctx, "includeDeclaration", true)
        result_json = if idx >= 0 { lsp_handle_references(state, state.docs[idx], req_pos, inc_decl) } else { "[]" }
    } elif method == "textDocument/completion" {
        result_json = if idx >= 0 { lsp_handle_completion(state.docs[idx], req_pos) } else { "[]" }
    } elif method == "textDocument/codeAction" {
        result_json = if idx >= 0 { lsp_handle_code_actions(state.docs[idx], params) } else { "[]" }
    } elif method == "textDocument/signatureHelp" {
        result_json = if idx >= 0 { lsp_handle_signature_help(state.docs[idx], req_pos) } else { "null" }
    } elif method == "textDocument/rename" {
        result_json = if idx >= 0 { lsp_handle_rename(state, state.docs[idx], req_pos, lsp_json_str(params, "newName", "")) } else { "null" }
    } elif method == "textDocument/formatting" {
        result_json = if idx >= 0 { lsp_handle_formatting(state.docs[idx]) } else { "[]" }
    } elif method == "textDocument/semanticTokens/full" {
        result_json = if idx >= 0 { lsp_handle_semantic_tokens(state.docs[idx]) } else { "{\"data\":[]}" }
    } else {
        handled = false
    }

    if not handled {
        if has_id { lsp_send_message("{\"jsonrpc\":\"2.0\",\"id\":" + req_id_raw + ",\"error\":{\"code\":-32601,\"message\":\"Method not found\"}}") }
        return true
    }
    if has_id { lsp_send_message("{\"jsonrpc\":\"2.0\",\"id\":" + req_id_raw + ",\"result\":" + result_json + "}") }
    return true
}

fn lsp_serve() -> unit {
    let tmp_dir = lsp_create_workspace()
    if tmp_dir == "" {
        lsp_send_message("{\"jsonrpc\":\"2.0\",\"method\":\"window/logMessage\",\"params\":{\"type\":1,\"message\":\"Could not create LSP workspace\"}}")
        exit(2)
    }
    let state = LspServerState(tmp_dir)
    while not state.eof_reached {
        let payload = lsp_read_frame_clean(state)
        if state.eof_reached { break }
        if payload == "" { continue }
        let msg = lsp_parse_json(payload)
        if not lsp_dispatch_message(state, msg) { break }
    }
    lsp_cleanup(state)
}
# Native JSON Schema (Draft 2020-12), contract constraints, and Wysna JSON codec generator.

class SchemaType {
    kind: str
    name: str
    args: list[SchemaType]

    fn init(kind: str, name: str) {
        this.kind = kind
        this.name = name
        let initial_args: list[SchemaType] = []
        this.args = initial_args
    }
}

class SchemaBound {
    has_bound: bool
    has_min: bool
    min_num: str
    excl_min: bool
    has_max: bool
    max_num: str
    excl_max: bool
    has_min_len: bool
    min_len: int
    has_max_len: bool
    max_len: int
    x_requires: list[str]
    req_tokens: list[list[Token]]

    fn init() {
        this.has_bound = false
        this.has_min = false
        this.min_num = ""
        this.excl_min = false
        this.has_max = false
        this.max_num = ""
        this.excl_max = false
        this.has_min_len = false
        this.min_len = 0
        this.has_max_len = false
        this.max_len = 0
        let reqs: list[str] = []
        this.x_requires = reqs
        let rtok_list: list[list[Token]] = []
        this.req_tokens = rtok_list
    }
}

class SchemaField {
    name: str
    t: SchemaType
    bound: SchemaBound

    fn init(name: str, t: SchemaType, bound: SchemaBound) {
        this.name = name
        this.t = t
        this.bound = bound
    }
}

class SchemaStruct {
    name: str
    file: str
    is_pub: bool
    line: int
    has_type_params: bool
    fields: list[SchemaField]

    fn init(name: str, line: int, has_type_params: bool) {
        this.name = name
        this.file = ""
        this.is_pub = false
        this.line = line
        this.has_type_params = has_type_params
        let fs: list[SchemaField] = []
        this.fields = fs
    }
}

class SchemaVariant {
    name: str
    payloads: list[SchemaType]

    fn init(name: str) {
        this.name = name
        let ps: list[SchemaType] = []
        this.payloads = ps
    }
}

class SchemaEnum {
    name: str
    file: str
    is_pub: bool
    line: int
    has_type_params: bool
    variants: list[SchemaVariant]

    fn init(name: str, line: int, has_type_params: bool) {
        this.name = name
        this.file = ""
        this.is_pub = false
        this.line = line
        this.has_type_params = has_type_params
        let vs: list[SchemaVariant] = []
        this.variants = vs
    }
}

class SchemaParam {
    name: str
    t: SchemaType
    bound: SchemaBound

    fn init(name: str, t: SchemaType) {
        this.name = name
        this.t = t
        this.bound = SchemaBound()
    }
}

class SchemaFn {
    name: str
    file: str
    line: int
    is_pub: bool
    type_params: list[str]
    params: list[SchemaParam]
    has_ret: bool
    ret: SchemaType
    req_strs: list[str]
    ens_strs: list[str]
    req_clauses: list[list[Token]]
    ens_clauses: list[list[Token]]

    fn init(name: str, line: int, is_pub: bool) {
        this.name = name
        this.file = ""
        this.line = line
        this.is_pub = is_pub
        let tp: list[str] = []
        this.type_params = tp
        let ps: list[SchemaParam] = []
        this.params = ps
        this.has_ret = false
        this.ret = SchemaType("named", "unit")
        let rs: list[str] = []
        this.req_strs = rs
        let es: list[str] = []
        this.ens_strs = es
        let rc: list[list[Token]] = []
        this.req_clauses = rc
        let ec: list[list[Token]] = []
        this.ens_clauses = ec
    }
}

class SchemaTokCursor {
    tokens: list[Token]
    pos: int

    fn init(tokens: list[Token]) {
        this.tokens = tokens
        this.pos = 0
    }
}

class SchemaDeclSet {
    structs: list[SchemaStruct]
    enums: list[SchemaEnum]
    fns: list[SchemaFn]

    fn init() {
        let s: list[SchemaStruct] = []
        let e: list[SchemaEnum] = []
        let f: list[SchemaFn] = []
        this.structs = s
        this.enums = e
        this.fns = f
    }
}

# schema_split_lines lives in 01_tool_common.wysna.

fn schema_leading_doc(lines: list[str], decl_line: int) -> list[str] {
    let mut idx = decl_line - 2
    let mut rev: list[str] = []
    while idx >= 0 and idx < len(lines) {
        let trimmed = lsp_trim(lines[idx])
        if len(trimmed) == 0 or trimmed[0] != "#" { break }
        let mut p = 0
        while p < len(trimmed) and trimmed[p] == "#" { p = p + 1 }
        rev.append(lsp_trim(slice(trimmed, p, len(trimmed))))
        idx = idx - 1
    }
    if len(rev) == 0 { return ["0", ""] }
    let mut ordered: list[str] = []
    let mut k = len(rev) - 1
    while k >= 0 {
        ordered.append(rev[k])
        k = k - 1
    }
    return ["1", join_strings(ordered, "\n")]
}

fn schema_cur_kind(c: SchemaTokCursor) -> str {
    if c.pos < 0 or c.pos >= len(c.tokens) { return "EOF" }
    return c.tokens[c.pos].kind
}

fn schema_cur_val(c: SchemaTokCursor) -> str {
    if c.pos < 0 or c.pos >= len(c.tokens) { return "" }
    return c.tokens[c.pos].val
}

fn schema_skip_newlines(c: SchemaTokCursor) -> unit {
    while schema_cur_kind(c) == "NEWLINE" { c.pos = c.pos + 1 }
}

fn schema_parse_primary_type(c: SchemaTokCursor) -> SchemaType {
    schema_skip_newlines(c)
    let k = schema_cur_kind(c)
    let v = schema_cur_val(c)
    if k == "IDENT" and (v == "none" or v == "None") {
        c.pos = c.pos + 1
        return SchemaType("named", "none")
    }
    if k == "LPAREN" {
        c.pos = c.pos + 1
        let mut items: list[SchemaType] = []
        if schema_cur_kind(c) != "RPAREN" {
            items.append(schema_parse_type(c))
            while schema_cur_kind(c) == "COMMA" {
                c.pos = c.pos + 1
                items.append(schema_parse_type(c))
            }
        }
        if schema_cur_kind(c) == "RPAREN" { c.pos = c.pos + 1 }
        if len(items) == 1 { return items[0] }
        let tup = SchemaType("tuple", "tuple")
        tup.args = items
        return tup
    }
    if k == "IDENT" and v == "fn" or k == "FN" {
        c.pos = c.pos + 1
        let fn_t = SchemaType("function", "fn")
        if schema_cur_kind(c) == "LPAREN" {
            c.pos = c.pos + 1
            while schema_cur_kind(c) != "RPAREN" and schema_cur_kind(c) != "EOF" {
                fn_t.args.append(schema_parse_type(c))
                if schema_cur_kind(c) == "COMMA" { c.pos = c.pos + 1 } else { break }
            }
            if schema_cur_kind(c) == "RPAREN" { c.pos = c.pos + 1 }
        }
        if schema_cur_kind(c) == "ARROW" {
            c.pos = c.pos + 1
            fn_t.args.append(schema_parse_type(c))
        } else {
            fn_t.args.append(SchemaType("named", "unit"))
        }
        return fn_t
    }
    if k == "IDENT" {
        let mut name = v
        c.pos = c.pos + 1
        while schema_cur_kind(c) == "DOT" and c.pos + 1 < len(c.tokens) and c.tokens[c.pos + 1].kind == "IDENT" {
            c.pos = c.pos + 1
            name = name + "." + schema_cur_val(c)
            c.pos = c.pos + 1
        }
        if schema_cur_kind(c) == "LBRACKET" {
            c.pos = c.pos + 1
            let mut args: list[SchemaType] = []
            while schema_cur_kind(c) != "RBRACKET" and schema_cur_kind(c) != "EOF" {
                args.append(schema_parse_type(c))
                if schema_cur_kind(c) == "COMMA" { c.pos = c.pos + 1 } else { break }
            }
            if schema_cur_kind(c) == "RBRACKET" { c.pos = c.pos + 1 }
            if name == "list" and len(args) == 1 {
                let lt = SchemaType("list", "list")
                lt.args = args
                return lt
            }
            if name == "dict" and len(args) == 2 {
                let dt = SchemaType("dict", "dict")
                dt.args = args
                return dt
            }
            if name == "tuple" {
                let tt = SchemaType("tuple", "tuple")
                tt.args = args
                return tt
            }
            let gt = SchemaType("generic", name)
            gt.args = args
            return gt
        }
        return SchemaType("named", name)
    }
    c.pos = c.pos + 1
    return SchemaType("named", "unknown")
}

fn schema_parse_postfix_type(c: SchemaTokCursor) -> SchemaType {
    let mut base = schema_parse_primary_type(c)
    while schema_cur_kind(c) == "QUESTION" {
        c.pos = c.pos + 1
        let opt = SchemaType("optional", "optional")
        opt.args.append(base)
        base = opt
    }
    return base
}

fn schema_parse_error_union_or_single(c: SchemaTokCursor) -> SchemaType {
    let first = schema_parse_postfix_type(c)
    if schema_cur_kind(c) != "PIPE" { return first }
    let eu = SchemaType("error_union", "error_union")
    eu.args.append(first)
    while schema_cur_kind(c) == "PIPE" {
        c.pos = c.pos + 1
        eu.args.append(schema_parse_postfix_type(c))
    }
    return eu
}

fn schema_parse_type(c: SchemaTokCursor) -> SchemaType {
    let ok_t = schema_parse_error_union_or_single(c)
    if schema_cur_kind(c) == "BANG" {
        c.pos = c.pos + 1
        let err_t = schema_parse_error_union_or_single(c)
        let res_t = SchemaType("result", "result")
        res_t.args.append(ok_t)
        res_t.args.append(err_t)
        return res_t
    }
    return ok_t
}

fn schema_type_text(t: SchemaType) -> str {
    if t.kind == "named" { return t.name }
    if t.kind == "optional" and len(t.args) == 1 { return schema_type_text(t.args[0]) + "?" }
    if t.kind == "list" and len(t.args) == 1 { return "list[" + schema_type_text(t.args[0]) + "]" }
    if t.kind == "dict" and len(t.args) == 2 { return "dict[" + schema_type_text(t.args[0]) + ", " + schema_type_text(t.args[1]) + "]" }
    if t.kind == "tuple" {
        let mut parts: list[str] = []
        for a in t.args { parts.append(schema_type_text(a)) }
        return "(" + join_strings(parts, ", ") + ")"
    }
    if t.kind == "result" and len(t.args) == 2 { return schema_type_text(t.args[0]) + " ! " + schema_type_text(t.args[1]) }
    if t.kind == "error_union" {
        let mut parts: list[str] = []
        for a in t.args { parts.append(schema_type_text(a)) }
        return join_strings(parts, " | ")
    }
    if t.kind == "generic" {
        let mut parts: list[str] = []
        for a in t.args { parts.append(schema_type_text(a)) }
        return t.name + "[" + join_strings(parts, ", ") + "]"
    }
    if t.kind == "function" and len(t.args) >= 1 {
        let mut p_parts: list[str] = []
        for i in 0..len(t.args) - 1 { p_parts.append(schema_type_text(t.args[i])) }
        return "fn(" + join_strings(p_parts, ", ") + ") -> " + schema_type_text(t.args[len(t.args) - 1])
    }
    return t.name
}

fn schema_bound_json_tail(bound: SchemaBound, base_type: str, include_x_reqs: bool) -> str {
    let mut extra: list[str] = []
    if bound.has_min {
        let k = if bound.excl_min { "\"exclusiveMinimum\":" } else { "\"minimum\":" }
        extra.append(k + bound.min_num)
    }
    if bound.has_max {
        let k = if bound.excl_max { "\"exclusiveMaximum\":" } else { "\"maximum\":" }
        extra.append(k + bound.max_num)
    }
    if bound.has_min_len {
        if base_type == "string" { extra.append("\"minLength\":" + str(bound.min_len)) }
        elif base_type == "array" { extra.append("\"minItems\":" + str(bound.min_len)) }
    }
    if bound.has_max_len {
        if base_type == "string" { extra.append("\"maxLength\":" + str(bound.max_len)) }
        elif base_type == "array" { extra.append("\"maxItems\":" + str(bound.max_len)) }
    }
    if include_x_reqs and len(bound.x_requires) > 0 {
        let mut rjson: list[str] = ["["]
        for i in 0..len(bound.x_requires) {
            if i > 0 { rjson.append(",") }
            rjson.append(diag_json_quote(bound.x_requires[i]))
        }
        rjson.append("]")
        extra.append("\"x-wysna-requires\":" + join_strings(rjson, ""))
    }
    return join_strings(extra, ",")
}

fn schema_inject_tail(base_json: str, tail: str) -> str {
    if tail == "" { return base_json }
    if len(base_json) >= 2 and base_json[len(base_json) - 1] == "}" {
        let inner = slice(base_json, 0, len(base_json) - 1)
        if inner == "{" { return "{" + tail + "}" }
        return inner + "," + tail + "}"
    }
    return base_json
}

fn schema_json_primitive_type(t: SchemaType, known_defs: list[str]) -> str {
    if t.kind == "named" {
        if t.name == "str" { return "string" }
        if t.name == "int" { return "integer" }
        if t.name == "u8" { return "integer" }
        if t.name == "float" { return "number" }
        if t.name == "bool" { return "boolean" }
        if t.name == "unit" or t.name == "none" { return "null" }
        return ""
    }
    if t.kind == "list" { return "array" }
    return ""
}

fn schema_type_to_json(t: SchemaType, known_defs: list[str]) -> str {
    if t.kind == "named" {
        if t.name == "int" { return "{\"type\":\"integer\"}" }
        if t.name == "u8" { return "{\"type\":\"integer\",\"minimum\":0,\"maximum\":255}" }
        if t.name == "float" { return "{\"type\":\"number\"}" }
        if t.name == "bool" { return "{\"type\":\"boolean\"}" }
        if t.name == "str" { return "{\"type\":\"string\"}" }
        if t.name == "unit" or t.name == "none" { return "{\"type\":\"null\"}" }
        if tool_str_contains(known_defs, t.name) { return "{\"$ref\":" + diag_json_quote("#/$defs/" + t.name) + "}" }
        return "{\"x-wysna-type\":" + diag_json_quote(t.name) + ",\"x-wysna-unrepresentable\":true}"
    }
    if t.kind == "optional" and len(t.args) == 1 {
        return "{\"anyOf\":[" + schema_type_to_json(t.args[0], known_defs) + ",{\"type\":\"null\"}]}"
    }
    if t.kind == "list" and len(t.args) == 1 {
        return "{\"type\":\"array\",\"items\":" + schema_type_to_json(t.args[0], known_defs) + "}"
    }
    if t.kind == "dict" and len(t.args) == 2 {
        let key_s = schema_type_text(t.args[0])
        let val_s = schema_type_to_json(t.args[1], known_defs)
        if key_s != "str" {
            return "{\"type\":\"object\",\"additionalProperties\":" + val_s + ",\"x-wysna-key-type\":" + diag_json_quote(key_s) + "}"
        }
        return "{\"type\":\"object\",\"additionalProperties\":" + val_s + "}"
    }
    if t.kind == "tuple" {
        let mut pitems: list[str] = ["["]
        for i in 0..len(t.args) {
            if i > 0 { pitems.append(",") }
            pitems.append(schema_type_to_json(t.args[i], known_defs))
        }
        pitems.append("]")
        let cnt = str(len(t.args))
        return "{\"type\":\"array\",\"prefixItems\":" + join_strings(pitems, "") + ",\"minItems\":" + cnt + ",\"maxItems\":" + cnt + "}"
    }
    if t.kind == "result" and len(t.args) == 2 {
        let ok_j = "{\"type\":\"object\",\"properties\":{\"ok\":" + schema_type_to_json(t.args[0], known_defs) + "},\"required\":[\"ok\"],\"additionalProperties\":false}"
        let err_j = "{\"type\":\"object\",\"properties\":{\"err\":" + schema_type_to_json(t.args[1], known_defs) + "},\"required\":[\"err\"],\"additionalProperties\":false}"
        return "{\"oneOf\":[" + ok_j + "," + err_j + "]}"
    }
    if t.kind == "error_union" {
        let mut alts: list[str] = ["["]
        for i in 0..len(t.args) {
            if i > 0 { alts.append(",") }
            alts.append(schema_type_to_json(t.args[i], known_defs))
        }
        alts.append("]")
        return "{\"oneOf\":" + join_strings(alts, "") + "}"
    }
    if t.kind == "generic" {
        if tool_str_contains(known_defs, t.name) {
            return "{\"$ref\":" + diag_json_quote("#/$defs/" + t.name) + ",\"x-wysna-type\":" + diag_json_quote(schema_type_text(t)) + "}"
        }
        return "{\"type\":\"object\",\"x-wysna-type\":" + diag_json_quote(schema_type_text(t)) + "}"
    }
    return "{\"x-wysna-type\":" + diag_json_quote(schema_type_text(t)) + "}"
}

fn schema_format_tok_slice(toks: list[Token]) -> str {
    let mut parts: list[str] = []
    let n = len(toks)
    for i in 0..n {
        let t = toks[i]
        let txt = if t.kind == "STR" { diag_json_quote(t.val) } else { t.val }
        if i == 0 {
            parts.append(txt)
            continue
        }
        let prev = toks[i - 1]
        let no_space = (t.kind == "LPAREN" or t.kind == "RPAREN" or t.kind == "LBRACKET" or t.kind == "RBRACKET" or t.kind == "COMMA" or t.kind == "DOT" or prev.kind == "LPAREN" or prev.kind == "LBRACKET" or prev.kind == "DOT")
        let unary_minus = prev.kind == "MINUS" and (i == 1 or (toks[i - 2].kind != "IDENT" and toks[i - 2].kind != "INT" and toks[i - 2].kind != "FLOAT" and toks[i - 2].kind != "RPAREN" and toks[i - 2].kind != "RBRACKET"))
        if no_space or unary_minus {
            parts.append(txt)
        } else {
            parts.append(" " + txt)
        }
    }
    return join_strings(parts, "")
}

fn schema_extract_num(toks: list[Token], lo: int, hi: int) -> list[str] {
    if lo >= hi { return ["0", "", "0"] }
    if toks[lo].kind == "MINUS" and lo + 1 == hi - 1 {
        let nxt = toks[lo + 1]
        if nxt.kind == "INT" { return ["1", "-" + nxt.val, "int"] }
        if nxt.kind == "FLOAT" { return ["1", "-" + nxt.val, "float"] }
    }
    if lo + 1 == hi {
        let t = toks[lo]
        if t.kind == "INT" { return ["1", t.val, "int"] }
        if t.kind == "FLOAT" { return ["1", t.val, "float"] }
    }
    return ["0", "", ""]
}

fn schema_extract_target(toks: list[Token], lo: int, hi: int) -> list[str] {
    if lo + 1 == hi and toks[lo].kind == "IDENT" {
        return ["value", toks[lo].val]
    }
    if lo + 3 == hi and toks[lo + 1].kind == "DOT" and toks[lo + 2].kind == "IDENT" {
        if toks[lo].kind == "THIS" or (toks[lo].kind == "IDENT" and toks[lo].val == "self") {
            return ["value", toks[lo + 2].val]
        }
    }
    if lo + 4 == hi and toks[lo].kind == "IDENT" and toks[lo].val == "len" and toks[lo + 1].kind == "LPAREN" and toks[lo + 3].kind == "RPAREN" and toks[lo + 2].kind == "IDENT" {
        return ["len", toks[lo + 2].val]
    }
    return ["", ""]
}

fn schema_flip_op(op: str) -> str {
    if op == ">" { return "<" }
    if op == ">=" { return "<=" }
    if op == "<" { return ">" }
    if op == "<=" { return ">=" }
    return op
}

fn schema_apply_cmp_bound(bound: SchemaBound, tkind: str, op: str, num_str: str, num_kind: str) -> unit {
    if tkind == "value" {
        if op == ">=" {
            bound.has_min = true
            bound.min_num = num_str
            bound.excl_min = false
            bound.has_bound = true
        } elif op == ">" {
            bound.has_min = true
            bound.min_num = num_str
            bound.excl_min = true
            bound.has_bound = true
        } elif op == "<=" {
            bound.has_max = true
            bound.max_num = num_str
            bound.excl_max = false
            bound.has_bound = true
        } elif op == "<" {
            bound.has_max = true
            bound.max_num = num_str
            bound.excl_max = true
            bound.has_bound = true
        }
    } elif tkind == "len" and num_kind == "int" {
        let val_i = lsp_parse_int(num_str, 0)
        if op == ">=" {
            bound.has_min_len = true
            bound.min_len = val_i
            bound.has_bound = true
        } elif op == ">" {
            bound.has_min_len = true
            bound.min_len = val_i + 1
            bound.has_bound = true
        } elif op == "<=" {
            bound.has_max_len = true
            bound.max_len = val_i
            bound.has_bound = true
        } elif op == "<" and val_i > 0 {
            bound.has_max_len = true
            bound.max_len = val_i - 1
            bound.has_bound = true
        }
    }
}

fn schema_apply_tokens_to_targets(toks: list[Token], lo: int, hi: int, target_names: list[str], target_bounds: list[SchemaBound]) -> unit {
    if lo >= hi { return }
    # Strip outer balanced parentheses
    if toks[lo].kind == "LPAREN" and toks[hi - 1].kind == "RPAREN" {
        let mut d = 0
        let mut wraps = true
        for k in lo..hi {
            if toks[k].kind == "LPAREN" { d = d + 1 }
            elif toks[k].kind == "RPAREN" {
                d = d - 1
                if d == 0 and k < hi - 1 {
                    wraps = false
                    break
                }
            }
        }
        if wraps {
            schema_apply_tokens_to_targets(toks, lo + 1, hi - 1, target_names, target_bounds)
            return
        }
    }
    # Split on top-level AND
    let mut depth = 0
    for k in lo..hi {
        let kind = toks[k].kind
        if kind == "LPAREN" or kind == "LBRACKET" { depth = depth + 1 }
        elif (kind == "RPAREN" or kind == "RBRACKET") and depth > 0 { depth = depth - 1 }
        elif depth == 0 and kind == "AND" {
            schema_apply_tokens_to_targets(toks, lo, k, target_names, target_bounds)
            schema_apply_tokens_to_targets(toks, k + 1, hi, target_names, target_bounds)
            return
        }
    }
    # Find top-level comparison operator
    depth = 0
    let mut cmp_idx = -1
    let mut cmp_op = ""
    for k in lo..hi {
        let kind = toks[k].kind
        if kind == "LPAREN" or kind == "LBRACKET" { depth = depth + 1 }
        elif (kind == "RPAREN" or kind == "RBRACKET") and depth > 0 { depth = depth - 1 }
        elif depth == 0 and (kind == "GT" or kind == "GTE" or kind == "LT" or kind == "LTE" or kind == "EQ") {
            cmp_idx = k
            cmp_op = toks[k].val
            break
        }
    }
    if cmp_idx < 0 { return }
    let t_left = schema_extract_target(toks, lo, cmp_idx)
    let n_right = schema_extract_num(toks, cmp_idx + 1, hi)
    let mut target_kind = t_left[0]
    let mut target_name = t_left[1]
    let mut num_str = n_right[1]
    let mut num_kind = n_right[2]
    let mut op = cmp_op
    if target_kind == "" or n_right[0] != "1" {
        let t_right = schema_extract_target(toks, cmp_idx + 1, hi)
        let n_left = schema_extract_num(toks, lo, cmp_idx)
        if t_right[0] != "" and n_left[0] == "1" {
            target_kind = t_right[0]
            target_name = t_right[1]
            num_str = n_left[1]
            num_kind = n_left[2]
            op = schema_flip_op(cmp_op)
        } else {
            return
        }
    }
    for i in 0..len(target_names) {
        if target_names[i] == target_name {
            schema_apply_cmp_bound(target_bounds[i], target_kind, op, num_str, num_kind)
        }
    }
}

fn schema_skip_brackets(c: SchemaTokCursor) -> list[str] {
    let mut names: list[str] = []
    if schema_cur_kind(c) != "LBRACKET" { return names }
    c.pos = c.pos + 1
    let mut depth = 1
    let mut cur_name = ""
    let mut take_name = true
    while c.pos < len(c.tokens) and depth > 0 {
        let k = schema_cur_kind(c)
        if k == "LBRACKET" { depth = depth + 1 }
        elif k == "RBRACKET" {
            depth = depth - 1
            if depth == 0 {
                if cur_name != "" { names.append(cur_name) }
                c.pos = c.pos + 1
                break
            }
        } elif depth == 1 and k == "COMMA" {
            if cur_name != "" { names.append(cur_name) }
            cur_name = ""
            take_name = true
        } elif depth == 1 and k == "COLON" {
            take_name = false
        } elif depth == 1 and take_name and k == "IDENT" and cur_name == "" {
            cur_name = schema_cur_val(c)
        }
        c.pos = c.pos + 1
    }
    return names
}

fn schema_skip_brace_block(c: SchemaTokCursor) -> unit {
    if schema_cur_kind(c) != "LBRACE" { return }
    c.pos = c.pos + 1
    let mut depth = 1
    while c.pos < len(c.tokens) and depth > 0 {
        let k = schema_cur_kind(c)
        if k == "LBRACE" { depth = depth + 1 }
        elif k == "RBRACE" { depth = depth - 1 }
        c.pos = c.pos + 1
    }
}

fn schema_collect_decls(tokens: list[Token], out: SchemaDeclSet) -> unit {
    let c = SchemaTokCursor(tokens)
    let mut depth = 0
    let mut is_pub = false
    let mut is_extern = false
    while schema_cur_kind(c) != "EOF" {
        let k = schema_cur_kind(c)
        let v = schema_cur_val(c)
        if depth > 0 {
            if k == "LBRACE" { depth = depth + 1 }
            elif k == "RBRACE" { depth = depth - 1 }
            c.pos = c.pos + 1
            continue
        }
        if k == "PUB" or k == "PRIV" {
            is_pub = k == "PUB"
            c.pos = c.pos + 1
            continue
        }
        if k == "IDENT" and v == "async" {
            c.pos = c.pos + 1
            continue
        }
        if k == "EXTERN" {
            is_extern = true
            c.pos = c.pos + 1
            if schema_cur_kind(c) == "STR" { c.pos = c.pos + 1 }
            continue
        }
        if k == "STRUCT" and c.pos + 1 < len(c.tokens) and c.tokens[c.pos + 1].kind == "IDENT" {
            let declaration_file = c.tokens[c.pos].file
            let line_1 = c.tokens[c.pos].line
            c.pos = c.pos + 1
            let name = schema_cur_val(c)
            c.pos = c.pos + 1
            let tps = schema_skip_brackets(c)
            let st = SchemaStruct(name, line_1, len(tps) > 0)
            st.file = declaration_file
            st.is_pub = is_pub
            schema_skip_newlines(c)
            if schema_cur_kind(c) == "LBRACE" {
                c.pos = c.pos + 1
                while schema_cur_kind(c) != "RBRACE" and schema_cur_kind(c) != "EOF" {
                    while schema_cur_kind(c) == "NEWLINE" or schema_cur_kind(c) == "COMMA" { c.pos = c.pos + 1 }
                    if schema_cur_kind(c) == "RBRACE" or schema_cur_kind(c) == "EOF" { break }
                    if schema_cur_kind(c) == "IDENT" {
                        let fname = schema_cur_val(c)
                        c.pos = c.pos + 1
                        if schema_cur_kind(c) == "COLON" {
                            c.pos = c.pos + 1
                            let ftype = schema_parse_type(c)
                            let fbound = SchemaBound()
                            while schema_cur_kind(c) == "IDENT" and schema_cur_val(c) == "requires" {
                                c.pos = c.pos + 1
                                let mut rtoks: list[Token] = []
                                let mut rdepth = 0
                                while schema_cur_kind(c) != "EOF" {
                                    let rk = schema_cur_kind(c)
                                    let rv = schema_cur_val(c)
                                    if rdepth == 0 and (rk == "COMMA" or rk == "RBRACE" or rk == "NEWLINE" or (rk == "IDENT" and rv == "requires")) {
                                        break
                                    }
                                    if rk == "LPAREN" or rk == "LBRACKET" { rdepth = rdepth + 1 }
                                    elif (rk == "RPAREN" or rk == "RBRACKET") and rdepth > 0 { rdepth = rdepth - 1 }
                                    if rk != "NEWLINE" { rtoks.append(c.tokens[c.pos]) }
                                    c.pos = c.pos + 1
                                }
                                if len(rtoks) > 0 {
                                    fbound.x_requires.append(schema_format_tok_slice(rtoks))
                                    fbound.req_tokens.append(rtoks)
                                    let tnames: list[str] = [fname]
                                    let tbounds: list[SchemaBound] = [fbound]
                                    schema_apply_tokens_to_targets(rtoks, 0, len(rtoks), tnames, tbounds)
                                }
                            }
                            st.fields.append(SchemaField(fname, ftype, fbound))
                            continue
                        }
                    }
                    c.pos = c.pos + 1
                }
                if schema_cur_kind(c) == "RBRACE" { c.pos = c.pos + 1 }
            }
            out.structs.append(st)
            is_pub = false
            is_extern = false
            continue
        }
        if k == "ENUM" and c.pos + 1 < len(c.tokens) and c.tokens[c.pos + 1].kind == "IDENT" {
            let declaration_file = c.tokens[c.pos].file
            let line_1 = c.tokens[c.pos].line
            c.pos = c.pos + 1
            let name = schema_cur_val(c)
            c.pos = c.pos + 1
            let tps = schema_skip_brackets(c)
            let en = SchemaEnum(name, line_1, len(tps) > 0)
            en.file = declaration_file
            en.is_pub = is_pub
            schema_skip_newlines(c)
            if schema_cur_kind(c) == "LBRACE" {
                c.pos = c.pos + 1
                while schema_cur_kind(c) != "RBRACE" and schema_cur_kind(c) != "EOF" {
                    while schema_cur_kind(c) == "NEWLINE" or schema_cur_kind(c) == "COMMA" { c.pos = c.pos + 1 }
                    if schema_cur_kind(c) == "RBRACE" or schema_cur_kind(c) == "EOF" { break }
                    if schema_cur_kind(c) == "IDENT" {
                        let vname = schema_cur_val(c)
                        c.pos = c.pos + 1
                        let vari = SchemaVariant(vname)
                        if schema_cur_kind(c) == "LPAREN" {
                            c.pos = c.pos + 1
                            while schema_cur_kind(c) != "RPAREN" and schema_cur_kind(c) != "EOF" {
                                vari.payloads.append(schema_parse_type(c))
                                if schema_cur_kind(c) == "COMMA" { c.pos = c.pos + 1 } else { break }
                            }
                            if schema_cur_kind(c) == "RPAREN" { c.pos = c.pos + 1 }
                        }
                        en.variants.append(vari)
                        continue
                    }
                    c.pos = c.pos + 1
                }
                if schema_cur_kind(c) == "RBRACE" { c.pos = c.pos + 1 }
            }
            out.enums.append(en)
            is_pub = false
            is_extern = false
            continue
        }
        if k == "FN" and c.pos + 1 < len(c.tokens) and c.tokens[c.pos + 1].kind == "IDENT" {
            if is_extern {
                c.pos = c.pos + 1
                while schema_cur_kind(c) != "NEWLINE" and schema_cur_kind(c) != "EOF" { c.pos = c.pos + 1 }
                is_pub = false
                is_extern = false
                continue
            }
            let declaration_file = c.tokens[c.pos].file
            let line_1 = c.tokens[c.pos].line
            c.pos = c.pos + 1
            let name = schema_cur_val(c)
            c.pos = c.pos + 1
            let f = SchemaFn(name, line_1, is_pub)
            f.file = declaration_file
            f.type_params = schema_skip_brackets(c)
            if schema_cur_kind(c) == "LPAREN" {
                c.pos = c.pos + 1
                while schema_cur_kind(c) != "RPAREN" and schema_cur_kind(c) != "EOF" {
                    if schema_cur_kind(c) == "IDENT" {
                        let pname = schema_cur_val(c)
                        c.pos = c.pos + 1
                        if schema_cur_kind(c) == "COLON" {
                            c.pos = c.pos + 1
                            let ptype = schema_parse_type(c)
                            f.params.append(SchemaParam(pname, ptype))
                        }
                    }
                    if schema_cur_kind(c) == "COMMA" { c.pos = c.pos + 1 } else { break }
                }
                if schema_cur_kind(c) == "RPAREN" { c.pos = c.pos + 1 }
            }
            if schema_cur_kind(c) == "ARROW" {
                c.pos = c.pos + 1
                f.has_ret = true
                f.ret = schema_parse_type(c)
            }
            while true {
                schema_skip_newlines(c)
                let ck = schema_cur_kind(c)
                let cv = schema_cur_val(c)
                if ck == "IDENT" and (cv == "requires" or cv == "ensures") {
                    let is_req = cv == "requires"
                    c.pos = c.pos + 1
                    let mut more = true
                    while more {
                        schema_skip_newlines(c)
                        let mut ctoks: list[Token] = []
                        let mut rdepth = 0
                        while schema_cur_kind(c) != "EOF" {
                            let rk = schema_cur_kind(c)
                            let rv = schema_cur_val(c)
                            if rdepth == 0 and (rk == "NEWLINE" or rk == "LBRACE" or rk == "COMMA" or (rk == "IDENT" and (rv == "requires" or rv == "ensures"))) {
                                break
                            }
                            if rk == "LPAREN" or rk == "LBRACKET" { rdepth = rdepth + 1 }
                            elif (rk == "RPAREN" or rk == "RBRACKET") and rdepth > 0 { rdepth = rdepth - 1 }
                            if rk != "NEWLINE" { ctoks.append(c.tokens[c.pos]) }
                            c.pos = c.pos + 1
                        }
                        if len(ctoks) > 0 {
                            let cstr = schema_format_tok_slice(ctoks)
                            if is_req {
                                f.req_strs.append(cstr)
                                f.req_clauses.append(ctoks)
                            } else {
                                f.ens_strs.append(cstr)
                                f.ens_clauses.append(ctoks)
                            }
                        }
                        more = schema_cur_kind(c) == "COMMA"
                        if more { c.pos = c.pos + 1 }
                    }
                } else {
                    break
                }
            }
            schema_skip_newlines(c)
            schema_skip_brace_block(c)
            out.fns.append(f)
            is_pub = false
            is_extern = false
            continue
        }
        if k == "LBRACE" {
            depth = depth + 1
            is_pub = false
            is_extern = false
        } elif k != "NEWLINE" {
            is_pub = false
            is_extern = false
        }
        c.pos = c.pos + 1
    }
}

fn schema_struct_def_json(st: SchemaStruct, lines: list[str], known_defs: list[str]) -> str {
    let mut props: list[str] = ["{"]
    let mut reqs: list[str] = ["["]
    let mut req_cnt = 0
    for i in 0..len(st.fields) {
        let f = st.fields[i]
        if i > 0 { props.append(",") }
        let base_j = schema_type_to_json(f.t, known_defs)
        let prim_t = schema_json_primitive_type(f.t, known_defs)
        let tail = schema_bound_json_tail(f.bound, prim_t, true)
        let final_j = schema_inject_tail(base_j, tail)
        props.append(diag_json_quote(f.name) + ":" + final_j)
        if f.t.kind != "optional" {
            if req_cnt > 0 { reqs.append(",") }
            req_cnt = req_cnt + 1
            reqs.append(diag_json_quote(f.name))
        }
    }
    props.append("}")
    reqs.append("]")
    let doc = schema_leading_doc(lines, st.line)
    let desc_part = if doc[0] == "1" { ",\"description\":" + diag_json_quote(doc[1]) } else { "" }
    return "{\"type\":\"object\",\"properties\":" + join_strings(props, "") + ",\"required\":" + join_strings(reqs, "") + ",\"additionalProperties\":false" + desc_part + "}"
}

fn schema_enum_def_json(en: SchemaEnum, lines: list[str], known_defs: list[str]) -> str {
    let doc = schema_leading_doc(lines, en.line)
    let desc_part = if doc[0] == "1" { ",\"description\":" + diag_json_quote(doc[1]) } else { "" }
    let mut all_unit = true
    for v in en.variants {
        if len(v.payloads) > 0 {
            all_unit = false
            break
        }
    }
    if all_unit {
        let mut names_j: list[str] = ["["]
        for i in 0..len(en.variants) {
            if i > 0 { names_j.append(",") }
            names_j.append(diag_json_quote(en.variants[i].name))
        }
        names_j.append("]")
        return "{\"type\":\"string\",\"enum\":" + join_strings(names_j, "") + desc_part + "}"
    }
    let mut var_objs: list[str] = ["["]
    for i in 0..len(en.variants) {
        let v = en.variants[i]
        if i > 0 { var_objs.append(",") }
        let tag_j = "\"tag\":{\"const\":" + diag_json_quote(v.name) + "}"
        if len(v.payloads) == 0 {
            var_objs.append("{\"type\":\"object\",\"properties\":{" + tag_j + "},\"required\":[\"tag\"],\"additionalProperties\":false}")
        } elif len(v.payloads) == 1 {
            let vj = schema_type_to_json(v.payloads[0], known_defs)
            var_objs.append("{\"type\":\"object\",\"properties\":{" + tag_j + ",\"value\":" + vj + "},\"required\":[\"tag\",\"value\"],\"additionalProperties\":false}")
        } else {
            let mut pitems: list[str] = ["["]
            for j in 0..len(v.payloads) {
                if j > 0 { pitems.append(",") }
                pitems.append(schema_type_to_json(v.payloads[j], known_defs))
            }
            pitems.append("]")
            let cnt = str(len(v.payloads))
            let val_s = "{\"type\":\"array\",\"prefixItems\":" + join_strings(pitems, "") + ",\"minItems\":" + cnt + ",\"maxItems\":" + cnt + "}"
            var_objs.append("{\"type\":\"object\",\"properties\":{" + tag_j + ",\"value\":" + val_s + "},\"required\":[\"tag\",\"value\"],\"additionalProperties\":false}")
        }
    }
    var_objs.append("]")
    return "{\"oneOf\":" + join_strings(var_objs, "") + desc_part + "}"
}

fn schema_is_read_only_cap(cap: str) -> bool {
    return cap == "arguments" or cap == "environment" or cap == "clock" or cap == "filesystem.read"
}

fn schema_tool_json(f: SchemaFn, spelling: SchemaFn, lines: list[str], known_defs: list[str], graph: ToolGraph) -> str {
    let mut pnames: list[str] = []
    let mut pbounds: list[SchemaBound] = []
    for p in f.params {
        pnames.append(p.name)
        pbounds.append(p.bound)
    }
    for req_toks in f.req_clauses {
        schema_apply_tokens_to_targets(req_toks, 0, len(req_toks), pnames, pbounds)
    }
    let mut props: list[str] = ["{"]
    let mut reqs: list[str] = ["["]
    let mut req_cnt = 0
    for i in 0..len(f.params) {
        let p = f.params[i]
        if i > 0 { props.append(",") }
        let base_j = schema_type_to_json(p.t, known_defs)
        let prim_t = schema_json_primitive_type(p.t, known_defs)
        let tail = schema_bound_json_tail(p.bound, prim_t, false)
        props.append(diag_json_quote(p.name) + ":" + schema_inject_tail(base_j, tail))
        if p.t.kind != "optional" {
            if req_cnt > 0 { reqs.append(",") }
            req_cnt = req_cnt + 1
            reqs.append(diag_json_quote(p.name))
        }
    }
    props.append("}")
    reqs.append("]")
    let in_schema = "{\"type\":\"object\",\"properties\":" + join_strings(props, "") + ",\"required\":" + join_strings(reqs, "") + ",\"additionalProperties\":false}"

    let mut fallible = false
    let mut out_base_t = SchemaType("named", "unit")
    let mut err_json = "null"
    if f.has_ret {
        if f.ret.kind == "result" and len(f.ret.args) == 2 {
            fallible = true
            out_base_t = f.ret.args[0]
            err_json = schema_type_to_json(f.ret.args[1], known_defs)
        } else {
            out_base_t = f.ret
        }
    }
    let out_bound = SchemaBound()
    let res_names: list[str] = ["result"]
    let res_bounds: list[SchemaBound] = [out_bound]
    for ens_toks in f.ens_clauses {
        schema_apply_tokens_to_targets(ens_toks, 0, len(ens_toks), res_names, res_bounds)
    }
    let out_base_j = schema_type_to_json(out_base_t, known_defs)
    let out_prim_t = schema_json_primitive_type(out_base_t, known_defs)
    let out_json = schema_inject_tail(out_base_j, schema_bound_json_tail(out_bound, out_prim_t, false))

    let mut sig_ps: list[str] = []
    for p in spelling.params { sig_ps.append(p.name + ": " + schema_type_text(p.t)) }
    let ret_sig = if spelling.has_ret { schema_type_text(spelling.ret) } else { "unit" }
    let gen_prefix = if len(f.type_params) > 0 { "[" + join_strings(f.type_params, ", ") + "]" } else { "" }
    let signature = "fn " + f.name + gen_prefix + "(" + join_strings(sig_ps, ", ") + ") -> " + ret_sig

    let mut effs: list[str] = []
    let mut caps: list[str] = []
    let mut complete = false
    let mut attributes: list[StaticAttribute] = []
    for n in graph.nodes {
        if n.kind == "fn" and n.file == graph.entry_file and n.name == f.name {
            attributes = n.attributes
            effs = n.effects
            caps = n.capabilities
            complete = true
            break
        }
    }
    let mut has_global_write = false
    let mut has_global_state = false
    for ef in effs {
        if ef == "global.write" {
            has_global_write = true
            has_global_state = true
        } elif ef == "global.read" {
            has_global_state = true
        }
    }
    let mut all_ro_caps = true
    for c in caps {
        if not schema_is_read_only_cap(c) {
            all_ro_caps = false
            break
        }
    }
    let pure = complete and len(caps) == 0 and not has_global_state
    let idemp = complete and not has_global_write and all_ro_caps

    let doc = schema_leading_doc(lines, f.line)
    let desc_j = if doc[0] == "1" { diag_json_quote(doc[1]) } else { "null" }

    let mut req_j: list[str] = ["["]
    for i in 0..len(f.req_strs) {
        if i > 0 { req_j.append(",") }
        req_j.append(diag_json_quote(f.req_strs[i]))
    }
    req_j.append("]")
    let mut ens_j: list[str] = ["["]
    for i in 0..len(f.ens_strs) {
        if i > 0 { ens_j.append(",") }
        ens_j.append(diag_json_quote(f.ens_strs[i]))
    }
    ens_j.append("]")

    let vis = if f.is_pub { "public" } else { "private" }
    let mut obj: list[str] = ["{"]
    obj.append("\"name\":" + diag_json_quote(f.name))
    obj.append(",\"visibility\":" + diag_json_quote(vis))
    obj.append(",\"signature\":" + diag_json_quote(signature))
    obj.append(",\"attributes\":" + tool_attributes_json(attributes))
    obj.append(",\"description\":" + desc_j)
    obj.append(",\"input_schema\":" + in_schema)
    obj.append(",\"output_schema\":" + out_json)
    obj.append(",\"error_schema\":" + err_json)
    obj.append(",\"fallible\":" + (if fallible { "true" } else { "false" }))
    let projection = if len(f.req_strs) + len(f.ens_strs) > 0 { "representable_subset" } else { "none" }
    obj.append(",\"contract_projection\":" + diag_json_quote(projection))
    obj.append(",\"requires\":" + join_strings(req_j, ""))
    obj.append(",\"ensures\":" + join_strings(ens_j, ""))
    obj.append(",\"effects\":" + tool_str_list_json(effs))
    obj.append(",\"capabilities\":" + tool_str_list_json(caps))
    obj.append(",\"complete_within_model\":" + (if complete { "true" } else { "false" }))
    obj.append(",\"pure\":" + (if pure { "true" } else { "false" }))
    obj.append(",\"idempotent\":" + (if idemp { "true" } else { "false" }))
    obj.append("}")
    return join_strings(obj, "")
}

fn schema_rewrite_req_tokens(toks: list[Token], field_names: list[str]) -> str {
    let mut out: list[Token] = []
    let n = len(toks)
    let mut i = 0
    while i < n {
        let t = toks[i]
        let is_self_prefix = t.kind == "THIS" or (t.kind == "IDENT" and t.val == "self")
        if is_self_prefix and i + 2 < n and toks[i + 1].kind == "DOT" and toks[i + 2].kind == "IDENT" and tool_str_contains(field_names, toks[i + 2].val) {
            let ft = toks[i + 2]
            out.append(Token { kind: "IDENT", val: "_f_" + ft.val, line: ft.line, col: ft.col, file: ft.file })
            i = i + 3
        } elif t.kind == "IDENT" and tool_str_contains(field_names, t.val) and (i == 0 or toks[i - 1].kind != "DOT") and (i + 1 >= n or toks[i + 1].kind != "LPAREN") {
            out.append(Token { kind: "IDENT", val: "_f_" + t.val, line: t.line, col: t.col, file: t.file })
            i = i + 1
        } else {
            out.append(t)
            i = i + 1
        }
    }
    return schema_format_tok_slice(out)
}

fn schema_encode_scalar(expr: str, t: SchemaType, known_defs: list[str]) -> str {
    if t.kind != "named" { return "" }
    if t.name == "int" { return "json.from_int(" + expr + ")" }
    if t.name == "u8" { return "json.from_int(int(" + expr + "))" }
    if t.name == "float" { return "json.from_float(" + expr + ")" }
    if t.name == "bool" { return "json.from_bool(" + expr + ")" }
    if t.name == "str" { return "json.from_str(" + expr + ")" }
    if tool_str_contains(known_defs, t.name) { return "encode_" + t.name + "(" + expr + ")" }
    return ""
}

fn schema_decode_scalar(val_expr: str, t: SchemaType, known_defs: list[str]) -> str {
    if t.kind != "named" { return "" }
    if t.name == "int" { return "json.to_int(" + val_expr + ")?" }
    if t.name == "u8" { return "(u8(json.to_int(" + val_expr + ")?) else { return Err(json.error(0, \"u8 out of range\")) })" }
    if t.name == "float" { return "json.to_float(" + val_expr + ")?" }
    if t.name == "bool" { return "json.to_bool(" + val_expr + ")?" }
    if t.name == "str" { return "json.to_str(" + val_expr + ")?" }
    if tool_str_contains(known_defs, t.name) { return "decode_" + t.name + "(" + val_expr + ")?" }
    return ""
}

fn schema_is_prim_scalar(t: SchemaType) -> bool {
    return t.kind == "named" and (t.name == "int" or t.name == "float" or t.name == "bool" or t.name == "str")
}

fn schema_generate_codecs(structs: list[SchemaStruct], enums: list[SchemaEnum], known_defs: list[str], strict: bool) -> str {
    let mut blocks: list[str] = ["import \"std/json\""]
    for en in enums {
        if en.has_type_params { continue }
        let name = en.name
        let mut all_unit = true
        let mut max_1 = true
        for v in en.variants {
            if len(v.payloads) > 0 { all_unit = false }
            if len(v.payloads) > 1 { max_1 = false }
        }
        if all_unit {
            let mut arms: list[str] = []
            let mut checks: list[str] = []
            for v in en.variants {
                arms.append("        " + name + "." + v.name + " => json.string(\"" + v.name + "\"),")
                checks.append("    if tag == \"" + v.name + "\" {\n        return " + name + "." + v.name + "\n    }")
            }
            blocks.append("pub fn encode_" + name + "(value: " + name + ") -> json.Value {\n    return match value {\n" + join_strings(arms, "\n") + "\n    }\n}")
            blocks.append("pub fn to_json_" + name + "(value: " + name + ") -> str ! json.JsonError {\n    return json.stringify(encode_" + name + "(value))\n}")
            blocks.append("pub fn decode_" + name + "(raw_val: json.Value) -> " + name + " ! json.JsonError {\n    let tag = json.to_str(raw_val)?\n" + join_strings(checks, "\n") + "\n    return Err(json.error(0, \"unknown variant for " + name + ": \" + tag))\n}")
            blocks.append("pub fn from_json_" + name + "(raw: str) -> " + name + " ! json.JsonError {\n    return decode_" + name + "(json.parse(raw)?)\n}")
        } elif max_1 {
            let mut arms: list[str] = []
            let mut checks: list[str] = []
            let mut supported = true
            for v in en.variants {
                if len(v.payloads) == 0 {
                    arms.append("        " + name + "." + v.name + " => {\n            let mut _obj: dict[str, json.Value] = {}\n            _obj[\"tag\"] = json.string(\"" + v.name + "\")\n            json.object(_obj)\n        },")
                    checks.append("    if tag == \"" + v.name + "\" {\n        return " + name + "." + v.name + "\n    }")
                } else {
                    let enc = schema_encode_scalar("_payload", v.payloads[0], known_defs)
                    let dec = schema_decode_scalar("json.get_required(raw_val, \"value\")?", v.payloads[0], known_defs)
                    if enc == "" or dec == "" {
                        supported = false
                        break
                    }
                    arms.append("        " + name + "." + v.name + "(_payload) => {\n            let mut _obj: dict[str, json.Value] = {}\n            _obj[\"tag\"] = json.string(\"" + v.name + "\")\n            _obj[\"value\"] = " + enc + "\n            json.object(_obj)\n        },")
                    checks.append("    if tag == \"" + v.name + "\" {\n        return " + name + "." + v.name + "(" + dec + ")\n    }")
                }
            }
            if supported {
                blocks.append("pub fn encode_" + name + "(value: " + name + ") -> json.Value {\n    return match value {\n" + join_strings(arms, "\n") + "\n    }\n}")
                blocks.append("pub fn to_json_" + name + "(value: " + name + ") -> str ! json.JsonError {\n    return json.stringify(encode_" + name + "(value))\n}")
                blocks.append("pub fn decode_" + name + "(raw_val: json.Value) -> " + name + " ! json.JsonError {\n    let tag = json.get_str(raw_val, \"tag\")?\n" + join_strings(checks, "\n") + "\n    return Err(json.error(0, \"unknown variant for " + name + ": \" + tag))\n}")
                blocks.append("pub fn from_json_" + name + "(raw: str) -> " + name + " ! json.JsonError {\n    return decode_" + name + "(json.parse(raw)?)\n}")
            }
        }
    }
    for st in structs {
        if st.has_type_params { continue }
        let name = st.name
        let mut enc_lines: list[str] = ["    let mut _fields: dict[str, json.Value] = {}"]
        let mut dec_lines: list[str] = []
        if strict {
            let mut names: list[str] = []
            for field in st.fields { names.append(diag_json_quote(field.name)) }
            dec_lines.append("    let allowed_fields: list[str] = [" + join_strings(names, ", ") + "]")
            dec_lines.append("    let _ = agent_members(raw_val, allowed_fields)?")
        }
        let mut ctor_fields: list[str] = []
        let mut supported = true
        for f in st.fields {
            let fn_ = f.name
            let ft = schema_type_text(f.t)
            let sc_enc = schema_encode_scalar("value." + fn_, f.t, known_defs)
            if sc_enc != "" {
                enc_lines.append("    _fields[\"" + fn_ + "\"] = " + sc_enc)
                if schema_is_prim_scalar(f.t) {
                    dec_lines.append("    let _f_" + fn_ + " = json.get_" + f.t.name + "(raw_val, \"" + fn_ + "\")?")
                } else {
                    let raw_field = "json.get_required(raw_val, \"" + fn_ + "\")?"
                    dec_lines.append("    let _f_" + fn_ + " = " + schema_decode_scalar(raw_field, f.t, known_defs))
                }
                ctor_fields.append(fn_ + ": _f_" + fn_)
                continue
            }
            if f.t.kind == "optional" and len(f.t.args) == 1 {
                let inner = f.t.args[0]
                let i_enc = schema_encode_scalar("_opt_v", inner, known_defs)
                let i_dec = schema_decode_scalar("_opt_item", inner, known_defs)
                if i_enc == "" or i_dec == "" {
                    supported = false
                    break
                }
                enc_lines.append("    _fields[\"" + fn_ + "\"] = match value." + fn_ + " {\n        Some(_opt_v) => " + i_enc + ",\n        None => json.null(),\n    }")
                if schema_is_prim_scalar(inner) {
                    dec_lines.append("    let _f_" + fn_ + " = json.get_optional_" + inner.name + "(raw_val, \"" + fn_ + "\")?")
                } else {
                    dec_lines.append("    let _raw_opt_" + fn_ + " = json.get(raw_val, \"" + fn_ + "\")\n    let _f_" + fn_ + ": " + ft + " = match _raw_opt_" + fn_ + " {\n        Some(_opt_item) => if not json.is_null(_opt_item) {\n            Some(" + i_dec + ")\n        } else {\n            None\n        },\n        None => None,\n    }")
                }
                ctor_fields.append(fn_ + ": _f_" + fn_)
                continue
            }
            if f.t.kind == "list" and len(f.t.args) == 1 {
                let elem = f.t.args[0]
                let e_enc = schema_encode_scalar("_item", elem, known_defs)
                let e_dec = schema_decode_scalar("_item", elem, known_defs)
                if e_enc == "" or e_dec == "" {
                    supported = false
                    break
                }
                enc_lines.append("    let mut _arr_" + fn_ + ": list[json.Value] = []\n    for _item in value." + fn_ + " {\n        _arr_" + fn_ + ".append(" + e_enc + ")\n    }\n    _fields[\"" + fn_ + "\"] = json.array(_arr_" + fn_ + ")")
                dec_lines.append("    let _raw_arr_" + fn_ + " = json.to_array(json.get_required(raw_val, \"" + fn_ + "\")?)?\n    let mut _f_" + fn_ + ": " + ft + " = []\n    for _item in _raw_arr_" + fn_ + " {\n        _f_" + fn_ + ".append(" + e_dec + ")\n    }")
                ctor_fields.append(fn_ + ": _f_" + fn_)
                continue
            }
            if f.t.kind == "dict" and len(f.t.args) == 2 and schema_type_text(f.t.args[0]) == "str" {
                let vt = f.t.args[1]
                let v_enc = schema_encode_scalar("_v", vt, known_defs)
                let v_dec = schema_decode_scalar("_v", vt, known_defs)
                if v_enc == "" or v_dec == "" {
                    supported = false
                    break
                }
                enc_lines.append("    let mut _map_" + fn_ + ": dict[str, json.Value] = {}\n    for (_k, _v) in dict_items(value." + fn_ + ") {\n        _map_" + fn_ + "[_k] = " + v_enc + "\n    }\n    _fields[\"" + fn_ + "\"] = json.object(_map_" + fn_ + ")")
                dec_lines.append("    let _raw_map_" + fn_ + " = json.to_object(json.get_required(raw_val, \"" + fn_ + "\")?)?\n    let mut _f_" + fn_ + ": " + ft + " = {}\n    for (_k, _v) in dict_items(_raw_map_" + fn_ + ") {\n        _f_" + fn_ + "[_k] = " + v_dec + "\n    }")
                ctor_fields.append(fn_ + ": _f_" + fn_)
                continue
            }
            supported = false
            break
        }
        if not supported { continue }
        let mut st_field_names: list[str] = []
        for f in st.fields { st_field_names.append(f.name) }
        for f in st.fields {
            for ridx in 0..len(f.bound.req_tokens) {
                let cond_src = schema_rewrite_req_tokens(f.bound.req_tokens[ridx], st_field_names)
                let raw_req = if ridx < len(f.bound.x_requires) { f.bound.x_requires[ridx] } else { cond_src }
                let msg_q = diag_json_quote(name + "." + f.name + ": failed contract '" + raw_req + "'")
                dec_lines.append("    if not (" + cond_src + ") {\n        return Err(json.error(0, " + msg_q + "))\n    }")
            }
        }
        enc_lines.append("    return json.object(_fields)")
        blocks.append("pub fn encode_" + name + "(value: " + name + ") -> json.Value {\n" + join_strings(enc_lines, "\n") + "\n}")
        blocks.append("pub fn to_json_" + name + "(value: " + name + ") -> str ! json.JsonError {\n    return json.stringify(encode_" + name + "(value))\n}")
        dec_lines.append("    return " + name + " { " + join_strings(ctor_fields, ", ") + " }")
        blocks.append("pub fn decode_" + name + "(raw_val: json.Value) -> " + name + " ! json.JsonError {\n" + join_strings(dec_lines, "\n") + "\n}")
        blocks.append("pub fn from_json_" + name + "(raw: str) -> " + name + " ! json.JsonError {\n    return decode_" + name + "(json.parse(raw)?)\n}")
    }
    return join_strings(blocks, "\n\n") + "\n"
}

fn schema_emit_usage_error(json_mode: bool, msg: str) -> unit {
    if json_mode {
        let diag = diag_record_json("W5002", "schema", "error", msg, "<cli>", 1, 1, "")
        diag_write_output(diag_tool_envelope_json("schema", "usage_error", 2, "[" + diag + "]", "", "", "[]"))
    } else {
        eprint("wysna schema: " + msg)
    }
    exit(2)
}

fn schema_definition_key(file: str, entry: str, name: str) -> str {
    if file == entry { return name }
    let parent = module_directory(entry)
    let directories = slice(parent, 0, len(parent) - 1).split("/")
    let destination = file.split("/")
    let mut shared = 0
    while shared < len(directories) and shared < len(destination) and directories[shared] == destination[shared] {
        shared = shared + 1
    }
    let mut relative: list[str] = []
    for i in shared..len(directories) { relative.append("..") }
    for i in shared..len(destination) { relative.append(destination[i]) }
    let path = if shared == 0 { file } else { join_strings(relative, "/") }
    return tool_short_name(name) + "__" + slice(diag_sha256_hex(path), 0, 16)
}

class SchemaProjection {
    keys: dict[str, str]
    needed: dict[str, bool]
    pending: list[str]
    fn init(keys: dict[str, str]) {
        this.keys = keys
        let needed: dict[str, bool] = {}
        let pending: list[str] = []
        this.needed = needed
        this.pending = pending
    }
}

fn schema_register_type(projection: SchemaProjection, name: str) {
    if name in projection.keys and not (name in projection.needed) {
        projection.needed[name] = true
        projection.pending.append(name)
    }
}

fn schema_project_type(projection: SchemaProjection, type_: SchemaType) {
    let original = type_.name
    schema_register_type(projection, original)
    type_.name = projection.keys.get(original) ?? original
    for child in type_.args { schema_project_type(projection, child) }
}

fn schema_source_lines(file: str, entry: str, lines: list[str]) -> list[str] {
    if file == entry { return lines }
    let loaded = module_read_text_or_overlay(file)
    return schema_split_lines(loaded[1])
}

struct SchemaAgentAdapter { id: str, version: int, source: str }

fn schema_agent_identity(f: SchemaFn, graph: ToolGraph) -> list[str] {
    if not f.is_pub or f.name == "main" or len(f.type_params) != 0 {
        report_error(graph.entry_file, "W2013", f.line, 1, "Agent adapter requires a public, concrete @AgentTool function")
    }
    for node in graph.nodes {
        if node.kind != "fn" or node.file != graph.entry_file or node.name != f.name { continue }
        if node.is_async or len(node.capabilities) != 0 or "global.read" in node.effects or "global.write" in node.effects {
            report_error(graph.entry_file, "W2013", f.line, 1, "Agent adapter requires a synchronous pure function")
        }
        for attribute in node.attributes {
            if attribute.name != "AgentTool" { continue }
            let mut id = ""
            let mut version = 0
            for argument in attribute.arguments {
                if argument.name == "id" and argument.kind == "str" { id = argument.value }
                if argument.name == "version" and argument.kind == "int" { version = int(argument.value) }
            }
            let mut valid = len(id) > 0 and len(id) <= 64
            if valid { valid = is_alpha(ord(id[0])) }
            for i in 0..len(id) {
                let char = id[i]
                if not is_alnum(ord(char)) and char != "_" and char != "." and char != "-" { valid = false }
            }
            if valid and version > 0 { return [id, str(version)] }
        }
    }
    report_error(graph.entry_file, "W2013", f.line, 1, "@AgentTool requires a stable id and a positive integer version")
    return []
}

fn schema_agent_import(file: str, original: str, alias: str) -> str {
    return "from " + diag_json_quote(file) + " use " + original + (if original == alias { "" } else { " as " + alias })
}

fn schema_agent_adapter(f: SchemaFn, graph: ToolGraph, records: SchemaDeclSet, projection: SchemaProjection) -> SchemaAgentAdapter {
    let identity = schema_agent_identity(f, graph)
    let mut imports = [schema_agent_import(graph.entry_file, f.name, "agent_target")]
    let mut structs: list[SchemaStruct] = []
    let mut enums: list[SchemaEnum] = []
    let mut known: list[str] = []
    for item in records.structs {
        if not item.is_pub or item.has_type_params or not (item.name in projection.needed) { continue }
        let name = projection.keys[item.name]
        imports.append(schema_agent_import(item.file, tool_short_name(item.name), name))
        let st = SchemaStruct(name, item.line, false)
        st.fields = item.fields
        structs.append(st)
        known.append(name)
    }
    for item in records.enums {
        if not item.is_pub or item.has_type_params or not (item.name in projection.needed) { continue }
        let mut unit_variants = true
        for variant in item.variants { if len(variant.payloads) != 0 { unit_variants = false } }
        if not unit_variants { continue }
        let name = projection.keys[item.name]
        imports.append(schema_agent_import(item.file, tool_short_name(item.name), name))
        let en = SchemaEnum(name, item.line, false)
        en.variants = item.variants
        enums.append(en)
        known.append(name)
    }
    let mut argument_names: list[str] = []
    let mut argument_values: list[str] = []
    let mut body: list[str] = []
    for i in 0..len(f.params) {
        let param = f.params[i]
        let key = diag_json_quote(param.name)
        let value = schema_decode_scalar("json.get_required(input, " + key + ")?", param.t, known)
        if value == "" { report_error(graph.entry_file, "W2013", f.line, 1, "Tool parameter has no supported JSON codec: " + param.name) }
        let name = "agent_arg_" + str(i)
        body.append("    let " + name + " = " + value)
        argument_names.append(key)
        argument_values.append(name)
    }
    let is_result = f.ret.kind == "result" and len(f.ret.args) == 2
    let outcome = if is_result { f.ret.args[0] } else { f.ret }
    let success = if outcome.kind == "named" and outcome.name == "unit" { "json.null()" }
        else { schema_encode_scalar("agent_value", outcome, known) }
    if success == "" { report_error(graph.entry_file, "W2013", f.line, 1, "Tool result has no supported JSON codec") }
    let call = "agent_target(" + join_strings(argument_values, ", ") + ")"
    if is_result {
        let failure = schema_encode_scalar("agent_error", f.ret.args[1], known)
        if failure == "" { report_error(graph.entry_file, "W2013", f.line, 1, "Tool error has no supported JSON codec") }
        body.append("    return Ok(match " + call + " {\n        Ok(agent_value) => agent_result(\"ok\", " + success + "),\n        Err(agent_error) => agent_result(\"error\", " + failure + "),\n    })")
    } else {
        body.append("    let agent_value = " + call)
        body.append("    return Ok(agent_result(\"ok\", " + success + "))")
    }
    let helper_source = "\nfn agent_members(raw: json.Value, keys: list[str]) -> json.Value ! json.JsonError {\n    let fields = json.to_object(raw)?\n    for key in fields.keys() {\n        if not (key in keys) { return Err(json.error(0, \"Unknown field: \" + key)) }\n    }\n    return Ok(raw)\n}\n\n"
    let result_source = "fn agent_result(status: str, value: json.Value) -> json.Value {\n    let fields: dict[str, json.Value] = {\n        \"schema_version\": json.string(\"wysna.agent-tool-result/1\"),\n        \"id\": json.string(" + diag_json_quote(identity[0]) + "),\n        \"version\": json.from_int(" + identity[1] + "),\n        \"status\": json.string(status),\n        \"value\": value,\n    }\n    return json.object(fields)\n}\n\n"
    let invoke_source = "fn agent_invoke(raw: str) -> json.Value ! json.JsonError {\n    let names: list[str] = [" + join_strings(argument_names, ", ") + "]\n    let input = agent_members(json.parse_with_limits(raw, 65536, 32, 4096)?, names)?\n" + join_strings(body, "\n") + "\n}\n\n"
    let encoding_failure = "{\"schema_version\":\"wysna.agent-tool-result/1\",\"id\":" + diag_json_quote(identity[0]) +
        ",\"version\":" + identity[1] + ",\"status\":\"encoding_error\",\"value\":\"Tool result could not be encoded as JSON\"}"
    let main_source = "let agent_arguments = args()\nlet agent_reply = if len(agent_arguments) == 2 {\n    agent_invoke(agent_arguments[1]) else error { agent_result(\"invalid_input\", json.string(error.message)) }\n} else { agent_result(\"invalid_input\", json.string(\"Supply one JSON argument\")) }\nprint(json.stringify_ordered(agent_reply) else { " + diag_json_quote(encoding_failure) + " })\n"
    let codecs = schema_generate_codecs(structs, enums, known, true)
    let source = join_strings(imports, "\n") + "\n\n" + codecs + helper_source + result_source + invoke_source + main_source
    return SchemaAgentAdapter { id: identity[0], version: int(identity[1]), source: source }
}

fn schema_write_new(path: str, source: str) {
    let target = tool_buf_from_str(path)
    let handle = wysna_host_file_open(target, 3)
    wysna_host_close(target)
    if wysna_host_is_open(handle) != 1 {
        report_error(path, "W5004", 1, 1, "cannot create agent adapter output")
    }
    let contents = tool_buf_from_str(source)
    let written = wysna_host_file_write(handle, contents)
    let closed = wysna_host_close(handle)
    wysna_host_close(contents)
    if written < 0 or closed < 0 { report_error(path, "W5004", 1, 1, "cannot write agent adapter output") }
}

fn tool_handle_schema(args: list[str], json_mode_in: bool) -> unit {
    let mut json_mode = json_mode_in
    let mut include_all = false
    let mut emit_codecs = false
    let mut emit_tool = false
    let mut fn_filter = ""
    let mut has_fn_filter = false
    let mut out_path = ""
    let mut file = ""
    let mut i = 1
    while i < len(args) {
        let a = args[i]
        if a == "--output-format=json-v1" or a == "--json" {
            json_mode = true
            i = i + 1
        } elif a == "--output-format" and i + 1 < len(args) {
            if args[i + 1] != "json-v1" { schema_emit_usage_error(json_mode, "unsupported output format: " + args[i + 1]) }
            json_mode = true
            i = i + 2
        } elif a == "--all" {
            include_all = true
            i = i + 1
        } elif a == "--emit-tool" {
            emit_tool = true
            i = i + 1
        } elif a == "--emit-codecs" {
            emit_codecs = true
            i = i + 1
        } elif a == "--function" and i + 1 < len(args) {
            fn_filter = args[i + 1]
            has_fn_filter = true
            i = i + 2
        } elif (a == "-o" or a == "--output") and i + 1 < len(args) {
            out_path = args[i + 1]
            i = i + 2
        } elif len(a) > 0 and a[0] != "-" and file == "" {
            file = a
            i = i + 1
        } else {
            schema_emit_usage_error(json_mode, "unknown or incomplete option for schema: " + a)
        }
    }
    if file == "" { schema_emit_usage_error(json_mode, "schema requires a source file path") }
    if emit_tool and (not has_fn_filter or emit_codecs) {
        schema_emit_usage_error(json_mode, "--emit-tool requires --function NAME and replaces --emit-codecs")
    }
    let loaded = module_read_text_or_overlay(file)
    if loaded[0] != "1" {
        report_error(file, "W5003", 1, 1, "cannot read input file: " + file)
    }
    let src = loaded[1]
    let canonical = module_canonical(file)
    let checked = check_source(src, canonical)
    let module = mir_build(checked)
    mir_verify(module)
    let graph = tool_build_graph(src, file)

    let tokens = tokenize(src, file)
    let lines = schema_split_lines(src)
    let decls = SchemaDeclSet()
    schema_collect_decls(tokens, decls)
    let structs = decls.structs
    let enums = decls.enums
    let fns = decls.fns

    let mut selected: list[SchemaFn] = []
    if has_fn_filter {
        for f in fns {
            if f.name == fn_filter { selected.append(f) }
        }
        if len(selected) == 0 {
            schema_emit_usage_error(json_mode, "Function '" + fn_filter + "' not found in '" + file + "'")
        }
    } elif include_all {
        for f in fns {
            if f.name != "main" or len(fns) == 1 { selected.append(f) }
        }
    } else {
        let mut pub_fns: list[SchemaFn] = []
        for f in fns {
            if f.is_pub { pub_fns.append(f) }
        }
        if len(pub_fns) > 0 {
            selected = pub_fns
        } else {
            let mut non_main: list[SchemaFn] = []
            for f in fns {
                if f.name != "main" { non_main.append(f) }
            }
            selected = if len(non_main) > 0 { non_main } else { fns }
        }
    }

    let linked = SchemaDeclSet()
    let expanded = module_tokens(src, canonical)
    schema_collect_decls(expanded, linked)
    let mut keys: dict[str, str] = {}
    let mut structs_by_name: dict[str, int] = {}
    let mut enums_by_name: dict[str, int] = {}
    let mut entry_functions: dict[str, int] = {}
    for i in 0..len(linked.structs) {
        let st = linked.structs[i]
        keys[st.name] = schema_definition_key(st.file, canonical, st.name)
        structs_by_name[st.name] = i
    }
    for i in 0..len(linked.enums) {
        let en = linked.enums[i]
        keys[en.name] = schema_definition_key(en.file, canonical, en.name)
        enums_by_name[en.name] = i
    }
    for i in 0..len(linked.fns) {
        if linked.fns[i].file == canonical { entry_functions[linked.fns[i].name] = i }
    }
    let projection = SchemaProjection(keys)
    for st in structs { schema_register_type(projection, st.name) }
    for en in enums { schema_register_type(projection, en.name) }
    let mut resolved_fns: list[SchemaFn] = []
    for spelling in selected {
        let index = entry_functions.get(spelling.name) else {
            report_error(file, "W9999", spelling.line, 1, "checked schema declaration is missing: " + spelling.name)
            -1
        }
        let f = linked.fns[index]
        for param in f.params { schema_project_type(projection, param.t) }
        schema_project_type(projection, f.ret)
        resolved_fns.append(f)
    }
    let mut cursor = 0
    while cursor < len(projection.pending) {
        let name = projection.pending[cursor]
        let st = structs_by_name.get(name) ?? -1
        if st >= 0 {
            for field in linked.structs[st].fields { schema_project_type(projection, field.t) }
        } else {
            let en = enums_by_name[name]
            for variant in linked.enums[en].variants {
                for payload in variant.payloads { schema_project_type(projection, payload) }
            }
        }
        cursor = cursor + 1
    }
    let mut known_defs: list[str] = []
    for name in projection.pending { known_defs.append(keys[name]) }
    let mut defs_parts: list[str] = []
    for name in projection.pending {
        let st = structs_by_name.get(name) ?? -1
        let prefix = diag_json_quote(keys[name]) + ":"
        if st >= 0 {
            let item = linked.structs[st]
            defs_parts.append(prefix + schema_struct_def_json(item, schema_source_lines(item.file, canonical, lines), known_defs))
        } else {
            let item = linked.enums[enums_by_name[name]]
            defs_parts.append(prefix + schema_enum_def_json(item, schema_source_lines(item.file, canonical, lines), known_defs))
        }
    }
    let mut tools_parts: list[str] = []
    for idx in 0..len(selected) {
        tools_parts.append(schema_tool_json(resolved_fns[idx], selected[idx], lines, known_defs, graph))
    }
    let definitions = "{" + join_strings(defs_parts, ",") + "}"
    let tools = "[" + join_strings(tools_parts, ",") + "]"

    let codecs_src = if emit_codecs { schema_generate_codecs(structs, enums, known_defs, false) } else { "" }
    let codecs_field = if emit_codecs { ",\"codecs_source\":" + diag_json_quote(codecs_src) } else { "" }
    let mut adapter_field = ""
    let mut adapter_source = ""
    if emit_tool {
        let adapter = schema_agent_adapter(resolved_fns[0], graph, linked, projection)
        let no_capabilities: list[str] = []
        let _initializer_guard = sandbox_enforce_and_header(module, canonical, "allow", no_capabilities)
        let candidate = mir_build(check_source(adapter.source, canonical + ".adapter.wysna"))
        let _ = sandbox_enforce_and_header(candidate, canonical, "allow", ["arguments", "stdio"])
        adapter_source = adapter.source
        adapter_field = ",\"agent_adapter\":{\"id\":" + diag_json_quote(adapter.id) +
            ",\"version\":" + str(adapter.version) + ",\"source\":" + diag_json_quote(adapter.source) + "}"
    }
    let payload_json = ("{\"schema_version\":\"wysna.schema/1\",\"compiler_version\":\"" + tool_compiler_version() + "\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"$defs\":") + definitions + ",\"tools\":" + tools + codecs_field + adapter_field + "}"

    if emit_tool and out_path != "" { schema_write_new(out_path, adapter_source) }
    elif out_path != "" {
        let out_content = if emit_codecs and not json_mode { codecs_src } else { payload_json + "\n" }
        write_file(out_path, out_content) else err {
            report_error(out_path, "W5004", 1, 1, "cannot write schema output to: " + out_path)
        }
    }
    if json_mode {
        diag_write_output(diag_tool_envelope_json("schema", "ok", 0, "[]", "result", payload_json, "[]"))
    } elif out_path == "" {
        if emit_tool { print(adapter_source) }
        elif emit_codecs { print(codecs_src) }
        else { print(payload_json) }
    }
    exit(0)
}
# Native `wysna fix`: automated mechanical diagnostic repair with byte-span overlap rejection and atomic writes.

class FixEdit {
    code: str
    description: str
    applicability: str
    start_byte: int
    end_byte: int
    replacement: str

    fn init(code: str, description: str, applicability: str, start_byte: int, end_byte: int, replacement: str) {
        this.code = code
        this.description = description
        this.applicability = applicability
        this.start_byte = start_byte
        this.end_byte = end_byte
        this.replacement = replacement
    }
}

class FixSkipped {
    code: str
    description: str
    reason: str

    fn init(code: str, description: str, reason: str) {
        this.code = code
        this.description = description
        this.reason = reason
    }
}

fn fix_run_check_subprocess(canonical_file: str, candidate_src: str, pass_idx: int) -> str {
    let exe = lsp_self_exe_path()
    let stdlib_root = lsp_stdlib_root_arg()
    let tdir = lsp_tmp_dir()
    let stamp = str(unix_time()) + "_" + str(pass_idx)
    let tmp_src = tdir + "/wysna_fix_src_" + stamp + ".wysna"
    let tmp_diag = tdir + "/wysna_fix_diag_" + stamp + ".json"
    write_file(tmp_src, candidate_src) else _err {
        return ""
    }
    let mut argv: list[str] = []
    if stdlib_root != "" {
        argv.append("--stdlib-root")
        argv.append(stdlib_root)
    }
    argv.append("check")
    argv.append(canonical_file)
    argv.append("--output-format=json-v1")
    argv.append("--diag-out")
    argv.append(tmp_diag)
    argv.append("--overlay")
    argv.append(canonical_file)
    argv.append(tmp_src)
    let exe_buf = lsp_buf_from_str(exe)
    let args_buf = lsp_pack_argv_buf(argv)
    let _rc = wysna_host_process_run(exe_buf, args_buf, 30000)
    wysna_host_close(exe_buf)
    wysna_host_close(args_buf)
    let diag_raw = read_file(tmp_diag) else err { "" }
    lsp_remove_file(tmp_src)
    lsp_remove_file(tmp_diag)
    return diag_raw
}

# fix_extract_json_* helpers live in 01_tool_common.wysna.

fn fix_line_col_from_char(src: str, target_char: int) -> list[int] {
    let mut line = 1
    let mut col = 1
    let limit = if target_char < len(src) { target_char } else { len(src) }
    for i in 0..limit {
        if src[i] == "\n" {
            line = line + 1
            col = 1
        } else {
            col = col + 1
        }
    }
    return [line, col]
}

fn fix_tok_index_at(tokens: list[Token], target_line: int, target_col: int) -> int {
    for i in 0..len(tokens) {
        let t = tokens[i]
        if t.line == target_line and t.col == target_col { return i }
    }
    let mut best = -1
    for i in 0..len(tokens) {
        let t = tokens[i]
        if t.kind == "EOF" { break }
        if t.line < target_line or (t.line == target_line and t.col <= target_col) {
            best = i
        }
    }
    return best
}

fn fix_resolve_mut_root_name(tokens: list[Token], tok_idx: int) -> str {
    if tok_idx < 0 or tok_idx >= len(tokens) { return "" }
    let t = tokens[tok_idx]
    if t.kind == "IDENT" {
        if tok_idx > 0 and tokens[tok_idx - 1].kind == "DOT" {
            let mut p = tok_idx - 2
            while p >= 0 and (tokens[p].kind == "DOT" or tokens[p].kind == "RBRACKET") {
                if tokens[p].kind == "RBRACKET" {
                    let mut bd = 1
                    p = p - 1
                    while p >= 0 and bd > 0 {
                        if tokens[p].kind == "RBRACKET" { bd = bd + 1 }
                        elif tokens[p].kind == "LBRACKET" { bd = bd - 1 }
                        p = p - 1
                    }
                } else {
                    p = p - 1
                }
            }
            if p >= 0 and tokens[p].kind == "IDENT" { return tokens[p].val }
        }
        return t.val
    }
    if (t.kind == "ASSIGN" or t.kind == "PLUS_ASSIGN" or t.kind == "MINUS_ASSIGN" or t.kind == "STAR_ASSIGN") and tok_idx > 0 {
        let mut p = tok_idx - 1
        while p >= 0 {
            if tokens[p].kind == "RBRACKET" {
                let mut bd = 1
                p = p - 1
                while p >= 0 and bd > 0 {
                    if tokens[p].kind == "RBRACKET" { bd = bd + 1 }
                    elif tokens[p].kind == "LBRACKET" { bd = bd - 1 }
                    p = p - 1
                }
            } elif tokens[p].kind == "IDENT" and p > 0 and tokens[p - 1].kind == "DOT" {
                p = p - 2
            } else {
                break
            }
        }
        if p >= 0 and tokens[p].kind == "IDENT" { return tokens[p].val }
    }
    return ""
}

fn fix_is_scalar_wrap_tok(t: Token) -> bool {
    return t.kind == "IDENT" or t.kind == "INT" or t.kind == "FLOAT" or t.kind == "TRUE" or t.kind == "FALSE"
}

fn fix_raw_token_span(src: str, tok: Token) -> list[int] {
    let off0 = diag_char_offset_at(src, tok.line, tok.col)
    if off0 < 0 or off0 >= len(src) { return [-1, -1] }
    let mut off1 = off0
    let mut saw_dot = false
    while off1 < len(src) {
        let ch = src[off1]
        let c = ord(ch)
        if is_alnum(c) {
            off1 = off1 + 1
        } elif tok.kind == "FLOAT" and ch == "." and not saw_dot and off1 + 1 < len(src) and is_digit(ord(src[off1 + 1])) {
            saw_dot = true
            off1 = off1 + 1
        } else {
            break
        }
    }
    if off1 <= off0 { return [-1, -1] }
    return [off0, off1]
}

fn fix_extract_expected_found(msg: str) -> list[str] {
    let empty: list[str] = []
    let p1 = "expected '"
    let p2 = "', found '"
    let n = len(msg)
    let l1 = len(p1)
    let l2 = len(p2)
    let mut i = 0
    while i + l1 <= n {
        if slice(msg, i, i + l1) == p1 {
            let e0 = i + l1
            let mut e1 = e0
            while e1 < n and msg[e1] != "'" { e1 = e1 + 1 }
            if e1 + l2 <= n and slice(msg, e1, e1 + l2) == p2 {
                let f0 = e1 + l2
                let mut f1 = f0
                while f1 < n and msg[f1] != "'" { f1 = f1 + 1 }
                if f1 < n and e1 > e0 and f1 > f0 {
                    return [slice(msg, e0, e1), slice(msg, f0, f1)]
                }
            }
        }
        i = i + 1
    }
    return empty
}

fn fix_propagation_requirement(expected: str, found: str) -> str {
    if found == expected + "?" { return "an optional return type" }
    let prefix = expected + " ! "
    if len(found) > len(prefix) and slice(found, 0, len(prefix)) == prefix {
        return "a result return type that accepts " + slice(found, len(prefix), len(found))
    }
    return ""
}

fn fix_mismatch_data_json(msg: str) -> str {
    let types = fix_extract_expected_found(msg)
    if len(types) != 2 { return "{}" }
    let base = "{\"kind\":\"type_mismatch\",\"expected\":" + diag_json_quote(types[0]) + ",\"found\":" + diag_json_quote(types[1])
    let requirement = fix_propagation_requirement(types[0], types[1])
    if requirement == "" { return base + "}" }
    let help = "'?' can return early and requires " + requirement + " on the enclosing function. Use 'else' for a local fallback."
    return base + ",\"unwrap_hint\":\"?\",\"help\":" + diag_json_quote(help) + "}"
}

fn fix_postfix_end_token(tokens: list[Token], start_idx: int) -> int {
    if start_idx < 0 or start_idx >= len(tokens) { return -1 }
    let first_kind = tokens[start_idx].kind
    if first_kind != "IDENT" and first_kind != "THIS" and first_kind != "SUPER" { return -1 }
    let mut end_idx = start_idx
    let mut j = start_idx + 1
    let n = len(tokens)
    while j < n {
        let tk = tokens[j].kind
        if tk == "DOT" and j + 1 < n and (tokens[j + 1].kind == "IDENT" or tokens[j + 1].kind == "INT") {
            end_idx = j + 1
            j = j + 2
        } elif tk == "LPAREN" or tk == "LBRACKET" {
            let open_k = tk
            let close_k = if tk == "LPAREN" { "RPAREN" } else { "RBRACKET" }
            let mut depth = 1
            let mut p = j + 1
            while p < n and depth > 0 {
                if tokens[p].kind == open_k { depth = depth + 1 }
                elif tokens[p].kind == close_k { depth = depth - 1 }
                p = p + 1
            }
            if depth != 0 { return -1 }
            end_idx = p - 1
            j = p
        } else {
            break
        }
    }
    if j < n and tokens[j].kind == "QUESTION" { return -1 }
    return end_idx
}

fn fix_token_end_char(src: str, tok: Token) -> int {
    if tok.kind == "RPAREN" or tok.kind == "RBRACKET" {
        let off = diag_char_offset_at(src, tok.line, tok.col)
        if off < 0 or off >= len(src) { return -1 }
        return off + 1
    }
    let span = fix_raw_token_span(src, tok)
    return span[1]
}

fn fix_plan_w2001(src: str, tokens: list[Token], start_byte: int, msg: str) -> list[FixEdit] {
    let mut out: list[FixEdit] = []
    if proj_str_contains_substr(msg, "binary operand types:") {
        let is_str_scalar = proj_str_contains_substr(msg, "expected 'str', found 'int'") or proj_str_contains_substr(msg, "expected 'str', found 'float'") or proj_str_contains_substr(msg, "expected 'str', found 'bool'")
        let is_scalar_str = proj_str_contains_substr(msg, "expected 'int', found 'str'") or proj_str_contains_substr(msg, "expected 'float', found 'str'") or proj_str_contains_substr(msg, "expected 'bool', found 'str'")
        if not is_str_scalar and not is_scalar_str { return out }
        let start_char = lsp_char_offset_from_utf8_byte(src, start_byte)
        let lc = fix_line_col_from_char(src, start_char)
        let tok_idx = fix_tok_index_at(tokens, lc[0], lc[1])
        if tok_idx < 0 or tok_idx >= len(tokens) { return out }
        let mut wrap_idx = -1
        if is_str_scalar and tok_idx >= 1 and tokens[tok_idx - 1].kind == "PLUS" and fix_is_scalar_wrap_tok(tokens[tok_idx]) {
            let nxt_kind = if tok_idx + 1 < len(tokens) { tokens[tok_idx + 1].kind } else { "EOF" }
            if nxt_kind != "LPAREN" and nxt_kind != "DOT" and nxt_kind != "LBRACKET" {
                wrap_idx = tok_idx
            }
        } elif is_scalar_str and tok_idx >= 2 and tokens[tok_idx - 1].kind == "PLUS" and fix_is_scalar_wrap_tok(tokens[tok_idx - 2]) {
            let prev_kind = if tok_idx >= 3 { tokens[tok_idx - 3].kind } else { "EOF" }
            if prev_kind != "DOT" and prev_kind != "RBRACKET" and prev_kind != "RPAREN" {
                wrap_idx = tok_idx - 2
            }
        }
        if wrap_idx < 0 { return out }
        let wtok = tokens[wrap_idx]
        let span = fix_raw_token_span(src, wtok)
        if span[0] < 0 { return out }
        let orig = slice(src, span[0], span[1])
        let b0 = diag_utf8_byte_at(src, span[0])
        let b1 = diag_utf8_byte_at(src, span[1])
        out.append(FixEdit("W2001", "wrap '" + orig + "' in str(...)", "machine", b0, b1, "str(" + orig + ")"))
        return out
    }
    let ef = fix_extract_expected_found(msg)
    if len(ef) != 2 { return out }
    let exp = ef[0]
    let fnd = ef[1]
    if fix_propagation_requirement(exp, fnd) == "" { return out }
    let start_char = lsp_char_offset_from_utf8_byte(src, start_byte)
    let lc = fix_line_col_from_char(src, start_char)
    let tok_idx = fix_tok_index_at(tokens, lc[0], lc[1])
    let end_idx = fix_postfix_end_token(tokens, tok_idx)
    if end_idx < 0 { return out }
    let c0 = diag_char_offset_at(src, tokens[tok_idx].line, tokens[tok_idx].col)
    let c1 = fix_token_end_char(src, tokens[end_idx])
    if c0 < 0 or c1 <= c0 or c1 > len(src) { return out }
    let orig = slice(src, c0, c1)
    let b0 = diag_utf8_byte_at(src, c0)
    let b1 = diag_utf8_byte_at(src, c1)
    out.append(FixEdit("W2001", "append '?' to '" + orig + "' to propagate failure by returning early", "maybe", b0, b1, orig + "?"))
    return out
}

fn fix_plan_w3001(src: str, tokens: list[Token], start_byte: int, msg: str) -> list[FixEdit] {
    let mut out: list[FixEdit] = []
    if len(msg) >= 18 and slice(msg, 0, 18) == "captured snapshots" { return out }
    let start_char = lsp_char_offset_from_utf8_byte(src, start_byte)
    let lc = fix_line_col_from_char(src, start_char)
    let tok_idx = fix_tok_index_at(tokens, lc[0], lc[1])
    let var_name = fix_resolve_mut_root_name(tokens, tok_idx)
    if var_name == "" { return out }

    let mut depth = 0
    let mut scope_stack: list[int] = []
    let mut matched_let = -1
    let mut i = 0
    while i < tok_idx and i + 1 < len(tokens) {
        let tk = tokens[i].kind
        if tk == "LBRACE" {
            depth = depth + 1
            scope_stack.append(matched_let)
        } elif tk == "RBRACE" {
            if depth > 0 {
                depth = depth - 1
                if len(scope_stack) > 0 { matched_let = scope_stack.pop() }
            }
        } elif tk == "LET" and tokens[i + 1].kind == "IDENT" and tokens[i + 1].val == var_name {
            matched_let = i
        }
        i = i + 1
    }
    if matched_let < 0 { return out }
    let let_tok = tokens[matched_let]
    let lc_off = diag_char_offset_at(src, let_tok.line, let_tok.col)
    if lc_off < 0 or lc_off + 3 > len(src) { return out }
    if slice(src, lc_off, lc_off + 3) != "let" { return out }
    let b0 = diag_utf8_byte_at(src, lc_off)
    let b1 = diag_utf8_byte_at(src, lc_off + 3)
    out.append(FixEdit("W3001", "mark binding '" + var_name + "' as mutable (`let mut`)", "machine", b0, b1, "let mut"))
    return out
}

fn fix_levenshtein(a: str, b: str) -> int {
    let la = len(a)
    let lb = len(b)
    if la == 0 { return lb }
    if lb == 0 { return la }
    let mut prev: list[int] = []
    for j in 0..lb + 1 { prev.append(j) }
    for i in 1..la + 1 {
        let mut cur: list[int] = [i]
        for j in 1..lb + 1 {
            let cost = if a[i - 1] == b[j - 1] { 0 } else { 1 }
            let del_c = prev[j] + 1
            let ins_c = cur[j - 1] + 1
            let sub_c = prev[j - 1] + cost
            let mut m = del_c
            if ins_c < m { m = ins_c }
            if sub_c < m { m = sub_c }
            cur.append(m)
        }
        prev = cur
    }
    return prev[lb]
}

fn fix_collect_visible_names(tokens: list[Token], err_idx: int, types_only: bool) -> list[str] {
    let mut names: list[str] = []
    if not types_only {
        let mut depth = 0
        let mut i = 0
        let mut cur_fn_params: list[str] = []
        let mut local_names: list[list[str]] = [[]]
        while i < err_idx and i < len(tokens) {
            let tk = tokens[i].kind
            if tk == "LBRACE" {
                depth = depth + 1
                let empty_lvl: list[str] = []
                local_names.append(empty_lvl)
                if depth == 1 and len(cur_fn_params) > 0 {
                    for p in cur_fn_params { local_names[1].append(p) }
                    cur_fn_params = []
                }
            } elif tk == "RBRACE" {
                if depth > 0 {
                    if len(local_names) > 1 { let _popped = local_names.pop() }
                    depth = depth - 1
                }
                if depth == 0 { cur_fn_params = [] }
            } elif depth == 0 and tk == "FN" and i + 1 < len(tokens) and tokens[i + 1].kind == "IDENT" {
                let fname = tokens[i + 1].val
                if not tool_str_contains(names, fname) { names.append(fname) }
                cur_fn_params = []
                let mut p = i + 2
                if p < len(tokens) and tokens[p].kind == "LBRACKET" {
                    let mut bd = 1
                    p = p + 1
                    while p < len(tokens) and bd > 0 {
                        if tokens[p].kind == "LBRACKET" { bd = bd + 1 }
                        elif tokens[p].kind == "RBRACKET" { bd = bd - 1 }
                        p = p + 1
                    }
                }
                if p < len(tokens) and tokens[p].kind == "LPAREN" {
                    p = p + 1
                    let mut pd = 1
                    while p < len(tokens) and pd > 0 {
                        if tokens[p].kind == "LPAREN" { pd = pd + 1 }
                        elif tokens[p].kind == "RPAREN" { pd = pd - 1 }
                        elif pd == 1 and tokens[p].kind == "IDENT" and p + 1 < len(tokens) and tokens[p + 1].kind == "COLON" {
                            cur_fn_params.append(tokens[p].val)
                        }
                        p = p + 1
                    }
                }
            } elif tk == "LET" and i + 1 < len(tokens) {
                let mut npos = i + 1
                if tokens[npos].kind == "MUT" { npos = npos + 1 }
                if npos < len(tokens) and tokens[npos].kind == "IDENT" {
                    local_names[len(local_names) - 1].append(tokens[npos].val)
                }
            } elif tk == "FOR" and i + 1 < len(tokens) and tokens[i + 1].kind == "IDENT" {
                local_names[len(local_names) - 1].append(tokens[i + 1].val)
            }
            i = i + 1
        }
        for lvl in local_names {
            for item in lvl {
                if not tool_str_contains(names, item) { names.append(item) }
            }
        }
    }
    for i in 0..len(tokens) - 1 {
        let tk = tokens[i].kind
        if tk == "STRUCT" or tk == "ENUM" or tk == "CLASS" or tk == "INTERFACE" or (not types_only and tk == "FN") {
            if tokens[i + 1].kind == "IDENT" {
                let v = tokens[i + 1].val
                if not tool_str_contains(names, v) { names.append(v) }
            }
        }
    }
    if types_only {
        for prim in ["int", "float", "bool", "str", "unit", "none"] {
            if not tool_str_contains(names, prim) { names.append(prim) }
        }
    }
    return names
}

fn fix_plan_w1001(src: str, tokens: list[Token], start_byte: int, end_byte: int, msg: str) -> list[FixEdit] {
    let mut out: list[FixEdit] = []
    let mut bad = ""
    let mut types_only = false
    if len(msg) > 20 and slice(msg, 0, 20) == "unknown identifier: " {
        bad = slice(msg, 20, len(msg))
    } elif len(msg) > 14 and slice(msg, 0, 14) == "unknown type: " {
        bad = slice(msg, 14, len(msg))
        types_only = true
    } else {
        return out
    }
    if bad == "" { return out }
    let start_char = lsp_char_offset_from_utf8_byte(src, start_byte)
    let end_char = lsp_char_offset_from_utf8_byte(src, end_byte)
    if start_char < 0 or end_char <= start_char or end_char > len(src) { return out }
    if slice(src, start_char, end_char) != bad { return out }
    let lc = fix_line_col_from_char(src, start_char)
    let err_idx = fix_tok_index_at(tokens, lc[0], lc[1])
    let cands = fix_collect_visible_names(tokens, err_idx, types_only)

    let mut best_name = ""
    let mut best_sim = -1
    let mut tie = false
    for cand in cands {
        if cand == bad { continue }
        let dist = fix_levenshtein(bad, cand)
        if dist <= 0 { continue }
        let mlen = if len(bad) > len(cand) { len(bad) } else { len(cand) }
        let sim = ((mlen - dist) * 1000) / mlen
        if sim > best_sim {
            best_sim = sim
            best_name = cand
            tie = false
        } elif sim == best_sim {
            tie = true
        }
    }
    if tie or best_name == "" or best_sim < 600 { return out }
    let app = if best_sim >= 800 { "machine" } else { "maybe" }
    out.append(FixEdit("W1001", "replace unknown identifier '" + bad + "' with '" + best_name + "'", app, start_byte, end_byte, best_name))
    return out
}

fn fix_plan_w3004(src: str, tokens: list[Token], start_byte: int, end_byte: int, msg: str) -> list[FixEdit] {
    let mut out: list[FixEdit] = []
    if not proj_str_contains_substr(msg, "must be named 'init', found 'fn ") { return out }
    let start_char = lsp_char_offset_from_utf8_byte(src, start_byte)
    let end_char = lsp_char_offset_from_utf8_byte(src, end_byte)
    if start_char < 0 or end_char <= start_char or end_char > len(src) { return out }
    let lc = fix_line_col_from_char(src, start_char)
    let tok_idx = fix_tok_index_at(tokens, lc[0], lc[1])
    if tok_idx < 0 or tok_idx >= len(tokens) or tokens[tok_idx].kind != "IDENT" { return out }
    let orig = slice(src, start_char, end_char)
    out.append(FixEdit("W3004", "rename constructor 'fn " + orig + "' to 'fn init'", "machine", start_byte, end_byte, "init"))
    return out
}

fn fix_is_ident_char(c: int) -> bool {
    return (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or (c >= 48 and c <= 57) or c == 95
}

fn fix_is_digit_char(c: int) -> bool {
    return c >= 48 and c <= 57
}

fn fix_is_hws_char(c: int) -> bool {
    return c == 32 or c == 9
}

fn fix_is_ws_char(c: int) -> bool {
    return c == 32 or c == 9 or c == 13 or c == 10
}

fn fix_binary_left_disallowed(w: str) -> bool {
    return w == "return" or w == "if" or w == "elif" or w == "else" or w == "while" or w == "for" or w == "match" or w == "and" or w == "or" or w == "not" or w == "in" or w == "let" or w == "mut"
}

fn fix_unary_bang_left_kw(w: str) -> bool {
    return w == "if" or w == "elif" or w == "while" or w == "return" or w == "and" or w == "or" or w == "not" or w == "in" or w == "else"
}

fn fix_pad_binary_keyword(src: str, sc: int, ec: int, kw: str) -> str {
    let n = len(src)
    let mut prefix = " "
    if sc == 0 {
        prefix = ""
    } else {
        let pb = ord(src[sc - 1])
        if pb == 32 or pb == 9 or pb == 13 or pb == 10 or pb == 40 or pb == 91 or pb == 44 {
            prefix = ""
        }
    }
    let mut suffix = " "
    if ec >= n {
        suffix = ""
    } else {
        let nb = ord(src[ec])
        if nb == 32 or nb == 9 or nb == 13 or nb == 10 or nb == 41 or nb == 93 or nb == 44 or nb == 59 {
            suffix = ""
        }
    }
    return prefix + kw + suffix
}

fn fix_plan_syntax(code: str, src: str, start_byte: int, end_byte: int, msg: str) -> list[FixEdit] {
    let mut out: list[FixEdit] = []
    let sc = lsp_char_offset_from_utf8_byte(src, start_byte)
    let ec = lsp_char_offset_from_utf8_byte(src, end_byte)
    let n = len(src)
    if sc < 0 or sc > n { return out }

    if code == "W0001" and sc + 2 <= n and slice(src, sc, sc + 2) == "&&" {
        let b0 = diag_utf8_byte_at(src, sc)
        let b1 = diag_utf8_byte_at(src, sc + 2)
        out.append(FixEdit("W0001", "replace '&&' with 'and'", "machine", b0, b1, fix_pad_binary_keyword(src, sc, sc + 2, "and")))
        return out
    }

    if code == "W0006" and (proj_str_contains_substr(msg, "expected LBRACE") or proj_str_contains_substr(msg, "expected RPAREN") or proj_str_contains_substr(msg, "Expected '{'") or proj_str_contains_substr(msg, "Expected ')'")) {
        let mut pipe_start = -1
        if sc + 2 <= n and slice(src, sc, sc + 2) == "||" {
            pipe_start = sc
        } elif sc >= 1 and sc + 1 <= n and slice(src, sc - 1, sc + 1) == "||" {
            pipe_start = sc - 1
        } else {
            let mut j = sc
            while j > 0 and fix_is_hws_char(ord(src[j - 1])) {
                j = j - 1
            }
            if j >= 2 and slice(src, j - 2, j) == "||" {
                pipe_start = j - 2
            }
        }
        if pipe_start >= 0 {
            let mut left_end = pipe_start
            while left_end > 0 and fix_is_hws_char(ord(src[left_end - 1])) {
                left_end = left_end - 1
            }
            let mut left_ok = false
            if left_end > 0 {
                let lc = ord(src[left_end - 1])
                if lc == 41 or lc == 93 or lc == 34 or lc == 39 or fix_is_digit_char(lc) {
                    left_ok = true
                } elif fix_is_ident_char(lc) {
                    let mut ws = left_end - 1
                    while ws > 0 and fix_is_ident_char(ord(src[ws - 1])) {
                        ws = ws - 1
                    }
                    let w = slice(src, ws, left_end)
                    left_ok = not fix_binary_left_disallowed(w)
                }
            }
            let mut right_start = pipe_start + 2
            while right_start < n and fix_is_hws_char(ord(src[right_start])) {
                right_start = right_start + 1
            }
            let mut right_ok = right_start < n
            if right_ok {
                let rc = ord(src[right_start])
                if rc == 13 or rc == 10 or rc == 123 or rc == 44 or rc == 41 or rc == 93 {
                    right_ok = false
                } elif right_start + 2 <= n {
                    let r2 = slice(src, right_start, right_start + 2)
                    if r2 == "=>" or r2 == "->" {
                        right_ok = false
                    }
                }
            }
            if left_ok and right_ok {
                let b0 = diag_utf8_byte_at(src, pipe_start)
                let b1 = diag_utf8_byte_at(src, pipe_start + 2)
                out.append(FixEdit("W0006", "replace '||' with 'or'", "machine", b0, b1, fix_pad_binary_keyword(src, pipe_start, pipe_start + 2, "or")))
                return out
            }
        }
    }

    let mut bang_pos = -1
    if (code == "W0001" or code == "W0006") and sc + 1 <= n and src[sc] == "!" {
        if sc + 1 >= n or src[sc + 1] != "=" {
            bang_pos = sc
        }
    } elif code == "W2004" and ec <= n and sc < ec and slice(src, sc, ec) == "return" and proj_str_contains_substr(msg, "found 'unit'") {
        let mut k = ec
        while k < n and fix_is_hws_char(ord(src[k])) {
            k = k + 1
        }
        if k < n and src[k] == "!" and (k + 1 >= n or src[k + 1] != "=") {
            bang_pos = k
        }
    }
    if bang_pos >= 0 {
        let mut left_end = bang_pos
        while left_end > 0 and fix_is_ws_char(ord(src[left_end - 1])) {
            left_end = left_end - 1
        }
        let mut prefix_ok = false
        if left_end == 0 {
            prefix_ok = true
        } else {
            let lc = ord(src[left_end - 1])
            if lc == 40 or lc == 91 or lc == 123 or lc == 44 or lc == 61 or lc == 58 or lc == 59 or lc == 60 or lc == 43 or lc == 45 or lc == 42 or lc == 47 or lc == 37 or lc == 33 {
                prefix_ok = true
            } elif left_end >= 2 and slice(src, left_end - 2, left_end) == "=>" {
                prefix_ok = true
            } elif fix_is_ident_char(lc) {
                let mut ws = left_end - 1
                while ws > 0 and fix_is_ident_char(ord(src[ws - 1])) {
                    ws = ws - 1
                }
                prefix_ok = fix_unary_bang_left_kw(slice(src, ws, left_end))
            }
        }
        if prefix_ok {
            let mut prefix = " "
            if bang_pos == 0 {
                prefix = ""
            } else {
                let pb = ord(src[bang_pos - 1])
                if fix_is_ws_char(pb) or pb == 40 or pb == 91 or pb == 123 or pb == 44 {
                    prefix = ""
                }
            }
            let next_ws = bang_pos + 1 < n and fix_is_hws_char(ord(src[bang_pos + 1]))
            let repl = prefix + (if next_ws { "not" } else { "not " })
            let b0 = diag_utf8_byte_at(src, bang_pos)
            let b1 = diag_utf8_byte_at(src, bang_pos + 1)
            out.append(FixEdit(code, "replace '!' with 'not'", "machine", b0, b1, repl))
            return out
        }
    }

    if code == "W0006" {
        let old = if msg == "Use 'pub' in place of 'public'" { "public" }
            elif msg == "Use 'priv' in place of 'private'" { "private" } else { "" }
        if old != "" and sc + len(old) <= n and slice(src, sc, sc + len(old)) == old {
            let replacement = if old == "public" { "pub" } else { "priv" }
            out.append(FixEdit(code, msg, "machine", start_byte, diag_utf8_byte_at(src, sc + len(old)), replacement))
        }
    }

    return out
}

fn fix_plan_diagnostic(code: str, src: str, tokens: list[Token], start_byte: int, end_byte: int, msg: str) -> list[FixEdit] {
    if code == "W0001" or code == "W0006" or code == "W2004" {
        return fix_plan_syntax(code, src, start_byte, end_byte, msg)
    }
    if code == "W2001" { return fix_plan_w2001(src, tokens, start_byte, msg) }
    if code == "W1001" { return fix_plan_w1001(src, tokens, start_byte, end_byte, msg) }
    if code == "W3001" { return fix_plan_w3001(src, tokens, start_byte, msg) }
    if code == "W3004" { return fix_plan_w3004(src, tokens, start_byte, end_byte, msg) }
    return []
}

fn fix_diagnostic_edits_json(code: str, msg: str, file: str, src: str, line: int, col: int) -> str {
    let is_syntax = code == "W0001" or code == "W0006" or code == "W2004"
    if not is_syntax and code != "W2001" and code != "W1001" and code != "W3001" and code != "W3004" { return "[]" }
    let start_char = diag_char_offset_at(src, line, col)
    let end_char = diag_char_span_width(src, start_char)
    if start_char < 0 or end_char <= start_char { return "[]" }
    let mut fixes: list[FixEdit] = []
    if is_syntax {
        fixes = fix_plan_syntax(code, src, diag_utf8_byte_at(src, start_char), diag_utf8_byte_at(src, end_char), msg)
    } else {
        fixes = fix_plan_diagnostic(code, src, tokenize(src, file), diag_utf8_byte_at(src, start_char), diag_utf8_byte_at(src, end_char), msg)
    }
    if len(fixes) == 0 { return "[]" }
    let source = "{\"source_id\":" + diag_json_quote(file) + ",\"source_sha256\":" + diag_json_quote(diag_sha256_hex(src))
    let mut parts: list[str] = []
    for fix in fixes {
        let edit = source + ",\"start_byte\":" + str(fix.start_byte) + ",\"end_byte\":" + str(fix.end_byte) + ",\"replacement\":" + diag_json_quote(fix.replacement) + "}"
        parts.append("{\"description\":" + diag_json_quote(fix.description) + ",\"applicability\":" + diag_json_quote(fix.applicability) + ",\"edits\":[" + edit + "]}")
    }
    return "[" + join_strings(parts, ",") + "]"
}

fn fix_apply_non_overlapping(src: str, edits: list[FixEdit]) -> str {
    # Sort descending by start_byte
    let mut sorted: list[FixEdit] = []
    for e in edits { sorted.append(e) }
    let n = len(sorted)
    for i in 1..n {
        let key = sorted[i]
        let mut j = i - 1
        while j >= 0 and sorted[j].start_byte < key.start_byte {
            sorted[j + 1] = sorted[j]
            j = j - 1
        }
        sorted[j + 1] = key
    }
    let mut cur = src
    for e in sorted {
        let sc = lsp_char_offset_from_utf8_byte(cur, e.start_byte)
        let ec = lsp_char_offset_from_utf8_byte(cur, e.end_byte)
        if sc >= 0 and ec >= sc and ec <= len(cur) {
            cur = slice(cur, 0, sc) + e.replacement + slice(cur, ec, len(cur))
        }
    }
    return cur
}

fn fix_emit_usage_error(json_mode: bool, msg: str) -> unit {
    if json_mode {
        let diag = diag_record_json("W5002", "usage", "error", msg, "<cli>", 1, 1, "")
        diag_write_output(diag_tool_envelope_json("fix", "usage_error", 2, "[" + diag + "]", "", "", "[]"))
    } else {
        eprint("wysna fix: " + msg)
    }
    exit(2)
}

fn tool_handle_fix(args: list[str], json_mode_in: bool) -> unit {
    let mut json_mode = json_mode_in
    let mut apply = false
    let mut include_maybe = false
    let mut file = ""
    let mut i = 1
    while i < len(args) {
        let a = args[i]
        if a == "--output-format=json-v1" {
            json_mode = true
            i = i + 1
        } elif a == "--output-format" and i + 1 < len(args) {
            if args[i + 1] != "json-v1" { fix_emit_usage_error(json_mode, "unsupported output format: " + args[i + 1]) }
            json_mode = true
            i = i + 2
        } elif a == "--apply" {
            apply = true
            i = i + 1
        } elif a == "--include-maybe" {
            include_maybe = true
            i = i + 1
        } elif len(a) > 0 and a[0] != "-" and file == "" {
            file = a
            i = i + 1
        } else {
            fix_emit_usage_error(json_mode, "unknown or incomplete option for fix: " + a)
        }
    }
    if file == "" { fix_emit_usage_error(json_mode, "fix requires a source file path") }
    let loaded = module_read_text_or_overlay(file)
    if loaded[0] != "1" {
        report_error(file, "W5003", 1, 1, "cannot read input file: " + file)
    }
    let orig_src = loaded[1]
    let before_sha = diag_sha256_hex(orig_src)
    let canonical = module_canonical(file)

    let mut current_src = orig_src
    let mut applied_all: list[FixEdit] = []
    let mut skipped_all: list[FixSkipped] = []
    let mut diag_before_count = 0
    let mut last_raw = fix_run_check_subprocess(canonical, current_src, 0)
    let mut pass_num = 0

    while pass_num < 64 {
        if last_raw == "" { break }
        let parsed = lsp_parse_json(last_raw)
        let d_arr = lsp_json_get(parsed, "diagnostics")
        if pass_num == 0 and d_arr.kind == "array" {
            diag_before_count = len(d_arr.items)
        }
        if lsp_json_str(parsed, "status", "") == "ok" or d_arr.kind != "array" or len(d_arr.items) == 0 {
            break
        }
        let cur_sha = diag_sha256_hex(current_src)
        let mut has_lexer_fatal = false
        let mut need_tokens = false
        for item in d_arr.items {
            let d_code = lsp_json_str(item, "code", "")
            let d_msg = lsp_json_str(item, "message", "")
            if d_code == "W0001" and proj_str_contains_substr(d_msg, "unexpected character") {
                has_lexer_fatal = true
            }
            if d_code == "W2001" or d_code == "W1001" or d_code == "W3001" or d_code == "W3004" {
                need_tokens = true
            }
        }
        let mut tokens: list[Token] = []
        if need_tokens and not has_lexer_fatal {
            tokens = tokenize(current_src, file)
        }
        let mut cands: list[FixEdit] = []
        for item in d_arr.items {
            let code = lsp_json_str(item, "code", "")
            let msg = lsp_json_str(item, "message", "")
            let sp = lsp_json_get(item, "primary_span")
            if sp.kind != "object" { continue }
            let s_sha = lsp_json_str(sp, "source_sha256", "")
            if s_sha != "" and s_sha != cur_sha { continue }
            let sb = lsp_json_int(sp, "start_byte", -1)
            let eb = lsp_json_int(sp, "end_byte", -1)
            if sb < 0 or eb <= sb { continue }
            let gen = fix_plan_diagnostic(code, current_src, tokens, sb, eb, msg)
            for g in gen {
                if g.applicability == "machine" or (include_maybe and g.applicability == "maybe") {
                    cands.append(g)
                }
            }
        }
        if len(cands) == 0 { break }
        let mut chosen_pass: list[FixEdit] = []
        let mut taken_start: list[int] = []
        let mut taken_end: list[int] = []
        for c in cands {
            let mut overlaps = false
            for t in 0..len(taken_start) {
                if c.start_byte < taken_end[t] and taken_start[t] < c.end_byte {
                    overlaps = true
                    break
                }
            }
            if overlaps {
                skipped_all.append(FixSkipped(c.code, c.description, "overlaps another edit"))
            } else {
                taken_start.append(c.start_byte)
                taken_end.append(c.end_byte)
                chosen_pass.append(c)
                applied_all.append(c)
            }
        }
        if len(chosen_pass) == 0 { break }
        let next_src = fix_apply_non_overlapping(current_src, chosen_pass)
        if next_src == current_src { break }
        current_src = next_src
        pass_num = pass_num + 1
        last_raw = fix_run_check_subprocess(canonical, current_src, pass_num)
    }

    let changed = current_src != orig_src
    let mut written = false
    if apply and changed {
        tool_write_atomic_verified(file, before_sha, current_src)
        written = true
    }

    let mut rem_diags_json = "[]"
    let mut still_failing = false
    if last_raw != "" {
        let last_parsed = lsp_parse_json(last_raw)
        let rem_arr = lsp_json_get(last_parsed, "diagnostics")
        if rem_arr.kind == "array" and len(rem_arr.items) > 0 {
            still_failing = true
            rem_diags_json = fix_extract_json_array_field(last_raw, "diagnostics")
        } elif lsp_json_str(last_parsed, "status", "") != "ok" {
            still_failing = true
            rem_diags_json = fix_extract_json_array_field(last_raw, "diagnostics")
        }
    }

    let mut app_parts: list[str] = ["["]
    for idx in 0..len(applied_all) {
        if idx > 0 { app_parts.append(",") }
        app_parts.append("{\"code\":" + diag_json_quote(applied_all[idx].code) + ",\"description\":" + diag_json_quote(applied_all[idx].description) + "}")
    }
    app_parts.append("]")

    let mut skip_parts: list[str] = ["["]
    for idx in 0..len(skipped_all) {
        if idx > 0 { skip_parts.append(",") }
        skip_parts.append("{\"code\":" + diag_json_quote(skipped_all[idx].code) + ",\"description\":" + diag_json_quote(skipped_all[idx].description) + ",\"reason\":" + diag_json_quote(skipped_all[idx].reason) + "}")
    }
    skip_parts.append("]")

    let mut res_parts: list[str] = ["{"]
    res_parts.append("\"applied\":" + join_strings(app_parts, ""))
    res_parts.append(",\"skipped\":" + join_strings(skip_parts, ""))
    res_parts.append(",\"changed\":" + (if changed { "true" } else { "false" }))
    res_parts.append(",\"written\":" + (if written { "true" } else { "false" }))
    res_parts.append(",\"remaining_diagnostics\":" + rem_diags_json)
    res_parts.append(",\"diagnostics_before\":" + str(diag_before_count))
    if not apply {
        res_parts.append(",\"fixed_source\":" + diag_json_quote(current_src))
    }
    res_parts.append("}")
    let result_json = join_strings(res_parts, "")

    if json_mode {
        let status_str = if still_failing { "diagnostic_error" } else { "ok" }
        let exit_c = if still_failing { 1 } else { 0 }
        diag_write_output(diag_tool_envelope_json("fix", status_str, exit_c, rem_diags_json, "result", result_json, "[]"))
    } else {
        let verb = if apply { "Applied" } else { "Would apply" }
        for item in applied_all {
            print(verb + ": [" + item.code + "] " + item.description)
        }
        if len(applied_all) == 0 {
            print("No machine-applicable fixes.")
        }
        if still_failing {
            eprint("Diagnostics remain; run 'wysna check'.")
        }
    }
    if still_failing { exit(1) }
    exit(0)
}
# Shared architecture manifest grammar for the full compiler and the project dev unit.

class ProjectArchitectureRule {
    id: str
    from_role: str
    relations: list[str]
    deny_roles: list[str]
    severity: str
    keys: list[str]

    fn init() {
        this.id = ""
        this.from_role = ""
        this.relations = []
        this.deny_roles = []
        this.severity = ""
        this.keys = []
    }
}

class ProjectArchitecture {
    enabled: bool
    schema_path: str
    schema_name: str
    roles: list[str]
    rules: list[ProjectArchitectureRule]
    keys: list[str]

    fn init() {
        this.enabled = false
        this.schema_path = ""
        this.schema_name = ""
        this.roles = []
        this.rules = []
        this.keys = []
    }
}

fn proj_architecture_strings(raw_value: str) -> list[str] {
    let value = lsp_trim(raw_value)
    let n = len(value)
    if n < 2 or value[0] != "[" or value[n - 1] != "]" { return [] }
    let mut items: list[str] = []
    let mut start = 1
    let mut quote = ""
    let mut escaped = false
    for i in 1..n {
        let ch = value[i]
        if quote != "" {
            if escaped { escaped = false }
            elif quote == "\"" and ch == "\\" { escaped = true }
            elif ch == quote { quote = "" }
        } elif ch == "\"" or ch == "'" { quote = ch }
        elif ch == "," or i == n - 1 {
            let field = lsp_trim(slice(value, start, i))
            if field == "" and i == n - 1 { break }
            let item = proj_parse_toml_string(field)
            if item[0] != "1" or tool_str_contains(items, item[1]) { return [] }
            items.append(item[1])
            start = i + 1
        }
    }
    if quote != "" { return [] }
    return items
}

fn proj_architecture_identifier(name: str) -> bool {
    if name == "" { return false }
    for i in 0..len(name) {
        let ch = ord(name[i])
        let letter = (ch >= 65 and ch <= 90) or (ch >= 97 and ch <= 122) or ch == 95
        if not letter and not (i > 0 and ch >= 48 and ch <= 57) { return false }
    }
    return true
}

fn proj_architecture_key(policy: ProjectArchitecture, key: str, value: str) -> bool {
    if tool_str_contains(policy.keys, key) { return false }
    policy.keys.append(key)
    if key == "roles" {
        policy.roles = proj_architecture_strings(value)
        return len(policy.roles) > 0
    }
    if key == "role_attribute" {
        let parsed = proj_parse_toml_string(value)
        if parsed[0] != "1" { return false }
        let identity = parsed[1]
        for i in 0..len(identity) - 1 {
            if slice(identity, i, i + 2) == "::" {
                let path = slice(identity, 0, i)
                let name = slice(identity, i + 2, len(identity))
                let relative = proj_safe_rel_path(path, "architecture.role_attribute")
                if relative[0] != "1" or not proj_str_ends_with(path, ".wysna") or not proj_architecture_identifier(name) { return false }
                policy.schema_path = path
                policy.schema_name = name
                return true
            }
        }
    }
    return false
}

fn proj_architecture_rule_key(rule: ProjectArchitectureRule, key: str, value: str) -> bool {
    if tool_str_contains(rule.keys, key) { return false }
    rule.keys.append(key)
    if key == "relations" {
        rule.relations = proj_architecture_strings(value)
        return len(rule.relations) > 0
    }
    if key == "deny_roles" {
        rule.deny_roles = proj_architecture_strings(value)
        return len(rule.deny_roles) > 0
    }
    let parsed = proj_parse_toml_string(value)
    if parsed[0] != "1" { return false }
    if key == "id" { rule.id = parsed[1] }
    elif key == "from_role" { rule.from_role = parsed[1] }
    elif key == "severity" { rule.severity = parsed[1] }
    else { return false }
    return true
}

fn proj_architecture_error(policy: ProjectArchitecture) -> str {
    if not policy.enabled and len(policy.rules) == 0 { return "" }
    if policy.schema_path == "" or len(policy.roles) == 0 or len(policy.rules) == 0 {
        return "architecture requires role_attribute, roles, and at least one rule"
    }
    for role in policy.roles {
        if not proj_architecture_identifier(role) { return "architecture roles must be identifiers" }
    }
    let mut ids: list[str] = []
    for rule in policy.rules {
        if not proj_valid_name(rule.id) or tool_str_contains(ids, rule.id) {
            return "architecture rule id must be a unique lowercase name"
        }
        ids.append(rule.id)
        if not tool_str_contains(policy.roles, rule.from_role) or len(rule.deny_roles) == 0 {
            return "architecture rule requires known from_role and deny_roles"
        }
        for denied in rule.deny_roles {
            if not tool_str_contains(policy.roles, denied) { return "architecture rule refers to an unknown role" }
        }
        if len(rule.relations) == 0 { return "architecture rule requires relations" }
        for relation in rule.relations {
            if relation != "calls" and relation != "uses_type" { return "architecture relations must contain only calls or uses_type" }
        }
        if rule.severity != "error" { return "architecture severity must be 'error'" }
    }
    return ""
}
# Native strict parser, validator, and runner/planner for wysna.toml manifest version 1.

class ProjectPreopen {
    path: str
    access: str
    fn init(path: str, access: str) {
        this.path = path
        this.access = access
    }
}

class ProjectTarget {
    name: str
    entry: str
    profile: str
    has_preopens: bool
    has_fuel: bool
    has_memory_limit_mb: bool
    fuel: int
    memory_limit_mb: int
    preopens: list[ProjectPreopen]

    fn init(name: str) {
        this.name = name
        this.entry = ""
        this.profile = ""
        this.has_preopens = false
        this.has_fuel = false
        this.has_memory_limit_mb = false
        this.fuel = 100000000
        this.memory_limit_mb = 128
        let ps: list[ProjectPreopen] = []
        this.preopens = ps
    }
}

class ProjectDep {
    alias: str
    rel_path: str
    abs_root: str
    source_root_abs: str
    package_id: str

    fn init(alias: str, rel_path: str, abs_root: str, source_root_abs: str, package_id: str) {
        this.alias = alias
        this.rel_path = rel_path
        this.abs_root = abs_root
        this.source_root_abs = source_root_abs
        this.package_id = package_id
    }
}

class ProjectTestCase {
    name: str
    entry: str
    timeout_ms: int
    has_name: bool
    has_entry: bool
    has_timeout_ms: bool

    fn init() {
        this.name = ""
        this.entry = ""
        this.timeout_ms = 10000
        this.has_name = false
        this.has_entry = false
        this.has_timeout_ms = false
    }
}

class ProjectManifest {
    architecture: ProjectArchitecture
    ok: bool
    err_code: str
    err_msg: str
    path: str
    root: str
    name: str
    version: str
    language_version: str
    manifest_sha256: str
    compiler_version: str
    stdlib: str
    source_root_rel: str
    source_root_abs: str
    has_manifest_version: bool
    manifest_version: int
    has_pkg_table: bool
    has_tc_table: bool
    has_src_table: bool
    targets: list[ProjectTarget]
    deps: list[ProjectDep]
    tests: list[ProjectTestCase]
    pkg_keys: list[str]
    tc_keys: list[str]
    src_keys: list[str]
    seen_target_keys: list[list[str]]
    seen_dep_aliases: list[str]
    seen_dep_keys: list[list[str]]
    active_test_keys: list[str]

    fn init(path: str, root: str) {
        this.ok = true
        this.err_code = ""
        this.err_msg = ""
        this.path = path
        this.root = root
        this.architecture = ProjectArchitecture()
        this.name = ""
        this.version = ""
        this.language_version = ""
        this.manifest_sha256 = ""
        this.compiler_version = ""
        this.stdlib = ""
        this.source_root_rel = ""
        this.source_root_abs = ""
        this.has_manifest_version = false
        this.manifest_version = 0
        this.has_pkg_table = false
        this.has_tc_table = false
        this.has_src_table = false
        let ts: list[ProjectTarget] = []
        this.targets = ts
        let ds: list[ProjectDep] = []
        this.deps = ds
        let cs: list[ProjectTestCase] = []
        this.tests = cs
        let pks: list[str] = []
        this.pkg_keys = pks
        let tks: list[str] = []
        this.tc_keys = tks
        let sks: list[str] = []
        this.src_keys = sks
        let stks: list[list[str]] = []
        this.seen_target_keys = stks
        let sdas: list[str] = []
        this.seen_dep_aliases = sdas
        let sdks: list[list[str]] = []
        this.seen_dep_keys = sdks
        let atks: list[str] = []
        this.active_test_keys = atks
    }
}

fn proj_path_exists(p: str) -> bool {
    let b1 = tool_buf_from_str(p)
    let b2 = wysna_host_buffer_new()
    let st = wysna_host_fs(b1, b2, 0)
    wysna_host_close(b1)
    wysna_host_close(b2)
    return st == 1
}

fn proj_is_readable_file(p: str) -> bool {
    let _txt = read_file(p) else _err {
        return false
    }
    return true
}

fn proj_is_dir(p: str) -> bool {
    return proj_path_exists(p) and not proj_is_readable_file(p)
}

fn proj_str_ends_with(s: str, suffix: str) -> bool {
    let ns = len(s)
    let nf = len(suffix)
    if ns < nf { return false }
    return slice(s, ns - nf, ns) == suffix
}

fn proj_str_contains_substr(hay: str, needle: str) -> bool {
    if needle == "" { return true }
    let nh = len(hay)
    let nn = len(needle)
    if nn > nh { return false }
    for i in 0..(nh - nn + 1) {
        if slice(hay, i, i + nn) == needle { return true }
    }
    return false
}

fn proj_valid_name(s: str) -> bool {
    let n = len(s)
    if n < 1 or n > 63 { return false }
    let c0 = ord(s[0])
    if c0 < 97 or c0 > 122 { return false }
    for i in 1..n {
        let c = ord(s[i])
        let ok = (c >= 97 and c <= 122) or (c >= 48 and c <= 57) or c == 45
        if not ok { return false }
    }
    return true
}

fn proj_scan_digits_end(s: str, pos: int) -> int {
    let n = len(s)
    let mut p = pos
    while p < n and is_digit(ord(s[p])) { p = p + 1 }
    return p
}

fn proj_valid_semver(s: str) -> bool {
    let n = len(s)
    if n == 0 { return false }
    let mut p = 0
    for seg in 0..3 {
        if seg > 0 {
            if p >= n or s[p] != "." { return false }
            p = p + 1
        }
        if p >= n or not is_digit(ord(s[p])) { return false }
        let start = p
        p = proj_scan_digits_end(s, p)
        if p - start > 1 and s[start] == "0" { return false }
    }
    if p < n and s[p] == "-" {
        p = p + 1
        if p >= n { return false }
        let mut cur = ""
        while p <= n {
            if p == n or s[p] == "." or s[p] == "+" {
                if cur == "" { return false }
                if len(cur) > 1 and cur[0] == "0" {
                    let mut all_dig = true
                    for k in 0..len(cur) { if not is_digit(ord(cur[k])) { all_dig = false } }
                    if all_dig { return false }
                }
                cur = ""
                if p == n or s[p] == "+" { break }
            } else {
                let c = ord(s[p])
                let ok = (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 45
                if not ok { return false }
                cur = cur + s[p]
            }
            p = p + 1
        }
    }
    if p < n and s[p] == "+" {
        p = p + 1
        if p >= n { return false }
        let mut cur = ""
        while p <= n {
            if p == n or s[p] == "." {
                if cur == "" { return false }
                cur = ""
                if p == n { break }
            } else {
                let c = ord(s[p])
                let ok = (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 45
                if not ok { return false }
                cur = cur + s[p]
            }
            p = p + 1
        }
    }
    return p == n
}

fn proj_abs_from_cwd(raw_path: str) -> str {
    if mcp_is_abs_path(raw_path) {
        return module_normalize(raw_path)
    }
    let cwd = mcp_getcwd()
    if cwd == "" { return module_normalize(raw_path) }
    if cwd == "/" { return module_normalize("/" + raw_path) }
    return module_normalize(cwd + "/" + raw_path)
}

fn proj_safe_rel_path(value: str, label: str) -> list[str] {
    if lsp_trim(value) == "" { return ["0", label + " must be a non-empty string"] }
    let n = len(value)
    if value[0] == "/" { return ["0", label + " must be a relative path using '/' separators"] }
    for i in 0..n {
        let ch = value[i]
        let code = ord(ch)
        if ch == "\\" or ch == ":" or code == 0 {
            return ["0", label + " must be a relative path using '/' separators"]
        }
    }
    let mut seg = ""
    for i in 0..(n + 1) {
        let ch = if i < n { value[i] } else { "/" }
        if ch == "/" {
            if seg == "" or seg == "." or seg == ".." {
                return ["0", label + " must not contain empty, '.' or '..' path components"]
            }
            seg = ""
        } else {
            seg = seg + ch
        }
    }
    return ["1", value]
}

fn proj_contained_existing(root_canon: str, rel: str, label: str) -> list[str] {
    let joined = if root_canon == "/" { "/" + rel } else { root_canon + "/" + rel }
    if not proj_path_exists(joined) {
        return ["0", label + " does not exist inside package root: " + rel]
    }
    let resolved = module_canonical_resolved(joined)
    if resolved == "" {
        return ["0", label + " could not be resolved: " + rel]
    }
    if not mcp_is_within_root(resolved, root_canon) {
        return ["0", label + " escapes the package root"]
    }
    return ["1", resolved]
}

fn proj_strip_toml_comment(line: str) -> str {
    let mut in_dq = false
    let mut in_sq = false
    let mut esc = false
    let n = len(line)
    for i in 0..n {
        let ch = line[i]
        if in_dq {
            if esc { esc = false }
            elif ch == "\\" { esc = true }
            elif ch == "\"" { in_dq = false }
        } elif in_sq {
            if ch == "'" { in_sq = false }
        } else {
            if ch == "\"" { in_dq = true }
            elif ch == "'" { in_sq = true }
            elif ch == "#" { return slice(line, 0, i) }
        }
    }
    return line
}

fn proj_bracket_delta(text: str) -> int {
    let mut in_dq = false
    let mut in_sq = false
    let mut esc = false
    let mut delta = 0
    for i in 0..len(text) {
        let ch = text[i]
        if in_dq {
            if esc { esc = false }
            elif ch == "\\" { esc = true }
            elif ch == "\"" { in_dq = false }
        } elif in_sq {
            if ch == "'" { in_sq = false }
        } else {
            if ch == "\"" { in_dq = true }
            elif ch == "'" { in_sq = true }
            elif ch == "[" or ch == "{" { delta = delta + 1 }
            elif ch == "]" or ch == "}" { delta = delta - 1 }
        }
    }
    return delta
}

fn proj_parse_toml_string(raw_in: str) -> list[str] {
    let s = lsp_trim(raw_in)
    let n = len(s)
    if n < 2 { return ["0", "expected string"] }
    if s[0] == "'" and s[n - 1] == "'" {
        for i in 1..(n - 1) {
            if s[i] == "'" { return ["0", "invalid literal string"] }
        }
        return ["1", slice(s, 1, n - 1)]
    }
    if s[0] != "\"" or s[n - 1] != "\"" { return ["0", "expected quoted string"] }
    let mut parts: list[str] = []
    let mut i = 1
    while i < n - 1 {
        let ch = s[i]
        if ch == "\"" { return ["0", "unexpected quote inside string"] }
        if ch == "\\" {
            i = i + 1
            if i >= n - 1 { return ["0", "unterminated string escape"] }
            let esc = s[i]
            if esc == "\"" { parts.append("\"") }
            elif esc == "\\" { parts.append("\\") }
            elif esc == "n" { parts.append("\n") }
            elif esc == "r" { parts.append("\r") }
            elif esc == "t" { parts.append("\t") }
            else { return ["0", "unsupported string escape: \\" + esc] }
        } else {
            parts.append(ch)
        }
        i = i + 1
    }
    return ["1", join_strings(parts, "")]
}

fn proj_parse_toml_int(raw_in: str) -> list[str] {
    let s = lsp_trim(raw_in)
    if s == "" or s == "true" or s == "false" { return ["0", ""] }
    let n = len(s)
    let mut pos = 0
    let mut neg = false
    if s[0] == "-" { neg = true pos = 1 }
    elif s[0] == "+" { pos = 1 }
    if pos >= n { return ["0", ""] }
    let mut clean = if neg { "-" } else { "" }
    let mut prev_under = false
    let mut digits = 0
    while pos < n {
        let ch = s[pos]
        if ch == "_" {
            if digits == 0 or prev_under or pos + 1 >= n { return ["0", ""] }
            prev_under = true
        } elif is_digit(ord(ch)) {
            clean = clean + ch
            digits = digits + 1
            prev_under = false
        } else {
            return ["0", ""]
        }
        pos = pos + 1
    }
    if digits == 0 { return ["0", ""] }
    return ["1", clean]
}

fn proj_parse_header_segs(inner: str) -> list[str] {
    let n = len(inner)
    let mut pos = 0
    let mut segs: list[str] = []
    while pos < n {
        while pos < n and (inner[pos] == " " or inner[pos] == "\t") { pos = pos + 1 }
        if pos >= n { return [] }
        if inner[pos] == "\"" or inner[pos] == "'" {
            let q = inner[pos]
            let start = pos
            pos = pos + 1
            let mut esc = false
            while pos < n {
                if q == "\"" and esc { esc = false }
                elif q == "\"" and inner[pos] == "\\" { esc = true }
                elif inner[pos] == q { pos = pos + 1 break }
                pos = pos + 1
            }
            let parsed = proj_parse_toml_string(slice(inner, start, pos))
            if parsed[0] != "1" { return [] }
            segs.append(parsed[1])
        } else {
            let start = pos
            while pos < n {
                let c = ord(inner[pos])
                let bare = (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or (c >= 48 and c <= 57) or c == 95 or c == 45
                if not bare { break }
                pos = pos + 1
            }
            if pos == start { return [] }
            segs.append(slice(inner, start, pos))
        }
        while pos < n and (inner[pos] == " " or inner[pos] == "\t") { pos = pos + 1 }
        if pos < n {
            if inner[pos] != "." { return [] }
            pos = pos + 1
        }
    }
    return segs
}

fn proj_split_kv_eq(line: str) -> list[str] {
    let mut in_dq = false
    let mut in_sq = false
    let mut esc = false
    let n = len(line)
    for i in 0..n {
        let ch = line[i]
        if in_dq {
            if esc { esc = false }
            elif ch == "\\" { esc = true }
            elif ch == "\"" { in_dq = false }
        } elif in_sq {
            if ch == "'" { in_sq = false }
        } else {
            if ch == "\"" { in_dq = true }
            elif ch == "'" { in_sq = true }
            elif ch == "=" {
                return ["1", lsp_trim(slice(line, 0, i)), lsp_trim(slice(line, i + 1, n))]
            }
        }
    }
    return ["0", "", ""]
}

fn proj_find_target_idx(m: ProjectManifest, name: str) -> int {
    for i in 0..len(m.targets) {
        if m.targets[i].name == name { return i }
    }
    return -1
}

fn proj_resolve_target_name(m: ProjectManifest, target_arg: str) -> str {
    if target_arg != "" { return target_arg }
    if proj_find_target_idx(m, "app") >= 0 or len(m.targets) != 1 { return "app" }
    return m.targets[0].name
}

fn proj_fail(m: ProjectManifest, code: str, msg: str) -> ProjectManifest {
    m.ok = false
    m.err_code = code
    m.err_msg = msg
    return m
}

fn proj_parse_inline_preopens(raw_val: str, root_canon: str, target_label: str) -> list[str] {
    let s = lsp_trim(raw_val)
    let n = len(s)
    if n < 2 or s[0] != "[" or s[n - 1] != "]" {
        return ["0", target_label + ".preopens must be an array of tables"]
    }
    let body = lsp_trim(slice(s, 1, n - 1))
    if body == "" { return ["1"] }
    let mut items: list[str] = []
    let mut cur = ""
    let mut in_dq = false
    let mut in_sq = false
    let mut esc = false
    let mut depth = 0
    for i in 0..len(body) {
        let ch = body[i]
        if in_dq {
            if esc { esc = false }
            elif ch == "\\" { esc = true }
            elif ch == "\"" { in_dq = false }
            cur = cur + ch
        } elif in_sq {
            if ch == "'" { in_sq = false }
            cur = cur + ch
        } else {
            if ch == "\"" { in_dq = true cur = cur + ch }
            elif ch == "'" { in_sq = true cur = cur + ch }
            elif ch == "{" or ch == "[" { depth = depth + 1 cur = cur + ch }
            elif ch == "}" or ch == "]" { depth = depth - 1 cur = cur + ch }
            elif ch == "," and depth == 0 {
                let t = lsp_trim(cur)
                if t != "" { items.append(t) }
                cur = ""
            } else {
                cur = cur + ch
            }
        }
    }
    let last = lsp_trim(cur)
    if last != "" { items.append(last) }
    let mut out: list[str] = ["1"]
    let mut seen_paths: list[str] = []
    for idx in 0..len(items) {
        let item = items[idx]
        let li = len(item)
        let label = target_label + ".preopens[" + str(idx) + "]"
        if li < 2 or item[0] != "{" or item[li - 1] != "}" {
            return ["0", label + " must be an inline table"]
        }
        let inner = lsp_trim(slice(item, 1, li - 1))
        let mut parts: list[str] = []
        let mut pc = ""
        let mut pq = false
        let mut psq = false
        let mut pe = false
        for j in 0..len(inner) {
            let c = inner[j]
            if pq {
                if pe { pe = false }
                elif c == "\\" { pe = true }
                elif c == "\"" { pq = false }
                pc = pc + c
            } elif psq {
                if c == "'" { psq = false }
                pc = pc + c
            } else {
                if c == "\"" { pq = true pc = pc + c }
                elif c == "'" { psq = true pc = pc + c }
                elif c == "," { parts.append(lsp_trim(pc)) pc = "" }
                else { pc = pc + c }
            }
        }
        if lsp_trim(pc) != "" { parts.append(lsp_trim(pc)) }
        let mut ppath = ""
        let mut pacc = ""
        for kv_str in parts {
            let kv = proj_split_kv_eq(kv_str)
            if kv[0] != "1" { return ["0", "invalid entry in " + label] }
            let k = kv[1]
            let vr = proj_parse_toml_string(kv[2])
            if vr[0] != "1" { return ["0", label + "." + k + " must be a string"] }
            if k == "path" { ppath = vr[1] }
            elif k == "access" { pacc = vr[1] }
            else { return ["0", "unknown key in " + label + ": " + k] }
        }
        let rel = proj_safe_rel_path(ppath, label + ".path")
        if rel[0] != "1" { return ["0", rel[1]] }
        if pacc != "read-only" and pacc != "read-write" {
            return ["0", label + ".access must be 'read-only' or 'read-write'"]
        }
        if tool_str_contains(seen_paths, ppath) {
            return ["0", label + ".path duplicates another preopen"]
        }
        seen_paths.append(ppath)
        let cont = proj_contained_existing(root_canon, ppath, label + ".path")
        if cont[0] != "1" { return ["0", cont[1]] }
        if not proj_is_dir(cont[1]) {
            return ["0", label + ".path must name an existing directory"]
        }
        out.append(ppath)
        out.append(pacc)
    }
    return out
}

fn proj_parse_manifest_at(abs_manifest_path: str, visit_stack: list[str]) -> ProjectManifest {
    let norm_m = module_normalize(abs_manifest_path)
    let raw = read_file(norm_m) else err {
        let fail_m = ProjectManifest(norm_m, module_directory(norm_m))
        return proj_fail(fail_m, "W5004", "cannot read manifest '" + norm_m + "': " + err.message)
    }
    let canon_m = module_canonical_resolved(norm_m)
    let resolved_m = if canon_m != "" { canon_m } else { norm_m }
    let dir_with_slash = module_directory(resolved_m)
    let root_raw = if len(dir_with_slash) > 1 and proj_str_ends_with(dir_with_slash, "/") {
        slice(dir_with_slash, 0, len(dir_with_slash) - 1)
    } else { dir_with_slash }
    let canon_root = module_canonical_resolved(root_raw)
    let root = if canon_root != "" { canon_root } else { root_raw }

    for active in visit_stack {
        if active == root {
            let fail_m = ProjectManifest(resolved_m, root)
            return proj_fail(fail_m, "W5002", "dependency cycle detected at: " + root)
        }
    }

    let m = ProjectManifest(resolved_m, root)
    m.manifest_sha256 = diag_sha256_hex(raw)
    let raw_lines = schema_split_lines(raw)
    let mut logical_lines: list[str] = []
    let mut buf = ""
    let mut balance = 0
    for rline in raw_lines {
        let stripped = lsp_trim(proj_strip_toml_comment(rline))
        if buf == "" and stripped == "" { continue }
        if buf == "" { buf = stripped } else { buf = buf + " " + stripped }
        balance = balance + proj_bracket_delta(stripped)
        if balance <= 0 {
            logical_lines.append(buf)
            buf = ""
            balance = 0
        }
    }
    if buf != "" {
        return proj_fail(m, "W5002", "unclosed TOML bracket/brace in '" + resolved_m + "'")
    }

    let mut cur_sec = ""
    let mut cur_sub = ""
    let mut cur_target_idx = -1
    let mut cur_test_idx = -1

    for line in logical_lines {
        let nl = len(line)
        if nl >= 4 and slice(line, 0, 2) == "[[" and slice(line, nl - 2, nl) == "]]" {
            let hdr = proj_parse_header_segs(lsp_trim(slice(line, 2, nl - 2)))
            if len(hdr) == 2 and hdr[0] == "architecture" and hdr[1] == "rules" {
                cur_sec = "architecture.rules"
                m.architecture.rules.append(ProjectArchitectureRule())
                continue
            }
            if len(hdr) == 1 and hdr[0] == "tests" {
                cur_sec = "tests"
                cur_sub = ""
                cur_target_idx = -1
                cur_test_idx = len(m.tests)
                m.tests.append(ProjectTestCase())
                let fresh: list[str] = []
                m.active_test_keys = fresh
                continue
            }
            return proj_fail(m, "W5002", "unknown or unsupported array table in manifest: " + line)
        }
        if nl >= 2 and line[0] == "[" and line[nl - 1] == "]" {
            let hdr = proj_parse_header_segs(lsp_trim(slice(line, 1, nl - 1)))
            if len(hdr) == 1 {
                let s = hdr[0]
                if s == "architecture" {
                    if m.architecture.enabled { return proj_fail(m, "W5002", "duplicate [architecture] table") }
                    m.architecture.enabled = true
                    cur_sec = "architecture"
                    continue
                }
                if s == "package" {
                    if m.has_pkg_table { return proj_fail(m, "W5002", "duplicate [package] table") }
                    m.has_pkg_table = true
                    cur_sec = "package"
                    continue
                }
                if s == "toolchain" {
                    if m.has_tc_table { return proj_fail(m, "W5002", "duplicate [toolchain] table") }
                    m.has_tc_table = true
                    cur_sec = "toolchain"
                    continue
                }
                if s == "sources" {
                    if m.has_src_table { return proj_fail(m, "W5002", "duplicate [sources] table") }
                    m.has_src_table = true
                    cur_sec = "sources"
                    continue
                }
                return proj_fail(m, "W5002", "unknown key in manifest: " + s)
            }
            if len(hdr) == 2 and hdr[0] == "targets" {
                let tname = hdr[1]
                if not proj_valid_name(tname) { return proj_fail(m, "W5002", "invalid target name '" + tname + "'") }
                if proj_find_target_idx(m, tname) >= 0 { return proj_fail(m, "W5002", "duplicate target '" + tname + "'") }
                cur_sec = "targets"
                cur_sub = tname
                cur_target_idx = len(m.targets)
                m.targets.append(ProjectTarget(tname))
                let tks: list[str] = []
                m.seen_target_keys.append(tks)
                continue
            }
            if len(hdr) == 2 and hdr[0] == "dependencies" {
                let alias = hdr[1]
                if not proj_valid_name(alias) { return proj_fail(m, "W5002", "invalid dependency alias '" + alias + "'") }
                if tool_str_contains(m.seen_dep_aliases, alias) { return proj_fail(m, "W5002", "duplicate dependency '" + alias + "'") }
                cur_sec = "dependencies"
                cur_sub = alias
                m.seen_dep_aliases.append(alias)
                let dks: list[str] = []
                m.seen_dep_keys.append(dks)
                continue
            }
            return proj_fail(m, "W5002", "unknown or invalid table in manifest: " + line)
        }

        let kv = proj_split_kv_eq(line)
        if kv[0] != "1" { return proj_fail(m, "W5002", "cannot read manifest '" + resolved_m + "': expected key = value at '" + line + "'") }
        let key = kv[1]
        let val = kv[2]

        if cur_sec == "" {
            if key == "manifest_version" {
                let iv = proj_parse_toml_int(val)
                if iv[0] != "1" or lsp_parse_int(iv[1], -1) != 1 {
                    return proj_fail(m, "W5002", "manifest_version must be exactly 1")
                }
                m.has_manifest_version = true
                m.manifest_version = 1
                continue
            }
            return proj_fail(m, "W5002", "unknown key in manifest: " + key)
        }
        if cur_sec == "package" {
            if tool_str_contains(m.pkg_keys, key) { return proj_fail(m, "W5002", "duplicate key in package: " + key) }
            m.pkg_keys.append(key)
            let sv = proj_parse_toml_string(val)
            if key == "name" {
                if sv[0] != "1" or lsp_trim(sv[1]) == "" { return proj_fail(m, "W5002", "package.name must be a non-empty string") }
                m.name = sv[1]
            } elif key == "version" {
                if sv[0] != "1" or lsp_trim(sv[1]) == "" { return proj_fail(m, "W5002", "package.version must be a non-empty string") }
                m.version = sv[1]
            } elif key == "language" {
                if sv[0] != "1" or lsp_trim(sv[1]) == "" { return proj_fail(m, "W5002", "package.language must be a non-empty string") }
                m.language_version = sv[1]
            } else {
                return proj_fail(m, "W5002", "unknown key in package: " + key)
            }
            continue
        }
        if cur_sec == "toolchain" {
            if tool_str_contains(m.tc_keys, key) { return proj_fail(m, "W5002", "duplicate key in toolchain: " + key) }
            m.tc_keys.append(key)
            let sv = proj_parse_toml_string(val)
            if key == "compiler" {
                if sv[0] != "1" or lsp_trim(sv[1]) == "" { return proj_fail(m, "W5002", "toolchain.compiler must be a non-empty string") }
                m.compiler_version = sv[1]
            } elif key == "stdlib" {
                if sv[0] != "1" or lsp_trim(sv[1]) == "" { return proj_fail(m, "W5002", "toolchain.stdlib must be a non-empty string") }
                m.stdlib = sv[1]
            } else {
                return proj_fail(m, "W5002", "unknown key in toolchain: " + key)
            }
            continue
        }
        if cur_sec == "sources" {
            if tool_str_contains(m.src_keys, key) { return proj_fail(m, "W5002", "duplicate key in sources: " + key) }
            m.src_keys.append(key)
            let sv = proj_parse_toml_string(val)
            if key == "root" {
                if sv[0] != "1" or lsp_trim(sv[1]) == "" { return proj_fail(m, "W5002", "sources.root must be a non-empty string") }
                m.source_root_rel = sv[1]
            } else {
                return proj_fail(m, "W5002", "unknown key in sources: " + key)
            }
            continue
        }
        if cur_sec == "targets" {
            let label = "targets." + cur_sub
            if tool_str_contains(m.seen_target_keys[cur_target_idx], key) {
                return proj_fail(m, "W5002", "duplicate key in " + label + ": " + key)
            }
            m.seen_target_keys[cur_target_idx].append(key)
            let t = m.targets[cur_target_idx]
            if key == "entry" {
                let sv = proj_parse_toml_string(val)
                if sv[0] != "1" { return proj_fail(m, "W5002", label + ".entry must be a non-empty string") }
                t.entry = sv[1]
            } elif key == "profile" {
                let sv = proj_parse_toml_string(val)
                if sv[0] != "1" { return proj_fail(m, "W5002", label + ".profile must be a non-empty string") }
                t.profile = sv[1]
            } elif key == "preopens" {
                let pr = proj_parse_inline_preopens(val, root, label)
                if pr[0] != "1" { return proj_fail(m, "W5002", pr[1]) }
                t.has_preopens = true
                let mut k = 1
                while k + 1 < len(pr) {
                    t.preopens.append(ProjectPreopen(pr[k], pr[k + 1]))
                    k = k + 2
                }
            } elif key == "fuel" {
                let iv = proj_parse_toml_int(val)
                if iv[0] != "1" { return proj_fail(m, "W5002", label + ".fuel must be between 1000 and 10000000000") }
                let fv = lsp_parse_int(iv[1], -1)
                if fv < 1000 or fv > 10000000000 { return proj_fail(m, "W5002", label + ".fuel must be between 1000 and 10000000000") }
                t.has_fuel = true
                t.fuel = fv
            } elif key == "memory_limit_mb" {
                let iv = proj_parse_toml_int(val)
                if iv[0] != "1" { return proj_fail(m, "W5002", label + ".memory_limit_mb must be between 8 and 1024") }
                let mv = lsp_parse_int(iv[1], -1)
                if mv < 8 or mv > 1024 { return proj_fail(m, "W5002", label + ".memory_limit_mb must be between 8 and 1024") }
                t.has_memory_limit_mb = true
                t.memory_limit_mb = mv
            } else {
                return proj_fail(m, "W5002", "unknown key in " + label + ": " + key)
            }
            continue
        }
        if cur_sec == "dependencies" {
            let dep_idx = len(m.seen_dep_aliases) - 1
            let label = "dependencies." + cur_sub
            if tool_str_contains(m.seen_dep_keys[dep_idx], key) {
                return proj_fail(m, "W5002", "duplicate key in " + label + ": " + key)
            }
            m.seen_dep_keys[dep_idx].append(key)
            if key != "path" { return proj_fail(m, "W5002", "unknown key in " + label + ": " + key) }
            let sv = proj_parse_toml_string(val)
            if sv[0] != "1" { return proj_fail(m, "W5002", label + ".path must be a non-empty string") }
            let rel = proj_safe_rel_path(sv[1], label + ".path")
            if rel[0] != "1" { return proj_fail(m, "W5002", rel[1]) }
            let cont = proj_contained_existing(root, rel[1], label + ".path")
            if cont[0] != "1" { return proj_fail(m, "W5002", cont[1]) }
            if not proj_is_dir(cont[1]) { return proj_fail(m, "W5002", label + ".path must name a directory") }
            let mut next_stack: list[str] = []
            for s_item in visit_stack { next_stack.append(s_item) }
            next_stack.append(root)
            let dep_manifest = proj_parse_manifest_at(cont[1] + "/wysna.toml", next_stack)
            if not dep_manifest.ok { return proj_fail(m, dep_manifest.err_code, dep_manifest.err_msg) }
            let pkg_id = dep_manifest.name + "@" + dep_manifest.version
            m.deps.append(ProjectDep(cur_sub, rel[1], cont[1], dep_manifest.source_root_abs, pkg_id))
            continue
        }
        if cur_sec == "architecture" {
            if not proj_architecture_key(m.architecture, key, val) {
                return proj_fail(m, "W5002", "invalid or duplicate architecture key: " + key)
            }
            continue
        }
        if cur_sec == "architecture.rules" {
            let rule = m.architecture.rules[len(m.architecture.rules) - 1]
            if not proj_architecture_rule_key(rule, key, val) {
                return proj_fail(m, "W5002", "invalid or duplicate architecture rule key: " + key)
            }
            continue
        }
        if cur_sec == "tests" {
            let label = "tests[" + str(cur_test_idx) + "]"
            if tool_str_contains(m.active_test_keys, key) {
                return proj_fail(m, "W5002", "duplicate key in " + label + ": " + key)
            }
            m.active_test_keys.append(key)
            let tc = m.tests[cur_test_idx]
            if key == "name" {
                let sv = proj_parse_toml_string(val)
                if sv[0] != "1" or lsp_trim(sv[1]) == "" { return proj_fail(m, "W5002", label + ".name must be a non-empty string") }
                tc.name = sv[1]
                tc.has_name = true
            } elif key == "entry" {
                let sv = proj_parse_toml_string(val)
                if sv[0] != "1" { return proj_fail(m, "W5002", label + ".entry must be a non-empty string") }
                tc.entry = sv[1]
                tc.has_entry = true
            } elif key == "timeout_ms" {
                let iv = proj_parse_toml_int(val)
                if iv[0] != "1" { return proj_fail(m, "W5002", label + ".timeout_ms must be between 1 and 600000") }
                let tv = lsp_parse_int(iv[1], -1)
                if tv < 1 or tv > 600000 { return proj_fail(m, "W5002", label + ".timeout_ms must be between 1 and 600000") }
                tc.timeout_ms = tv
                tc.has_timeout_ms = true
            } else {
                return proj_fail(m, "W5002", "unknown key in " + label + ": " + key)
            }
            continue
        }
    }

    let architecture_error = proj_architecture_error(m.architecture)
    if architecture_error != "" { return proj_fail(m, "W5002", architecture_error) }
    if len(m.deps) != len(m.seen_dep_aliases) {
        return proj_fail(m, "W5002", "each dependency table requires path")
    }
    if not m.has_manifest_version or m.manifest_version != 1 { return proj_fail(m, "W5002", "manifest_version must be exactly 1") }
    if not m.has_pkg_table { return proj_fail(m, "W5002", "package must be a table") }
    if not proj_valid_name(m.name) {
        return proj_fail(m, "W5002", "package.name must start with a lowercase letter and contain only lowercase letters, digits, or hyphens")
    }
    if not proj_valid_semver(m.version) {
        return proj_fail(m, "W5002", "package.version must be an exact semantic version")
    }
    if m.language_version != (tool_language_version()) {
        return proj_fail(m, "W5002", ("package.language must be exactly '" + tool_language_version() + "' for this compiler"))
    }
    if not m.has_tc_table { return proj_fail(m, "W5002", "toolchain must be a table") }
    if m.compiler_version != (tool_compiler_version()) {
        return proj_fail(m, "W5002", ("toolchain.compiler must exactly match this compiler (" + tool_compiler_version() + ")"))
    }
    if m.stdlib != "bundled" {
        return proj_fail(m, "W5002", "toolchain.stdlib must be 'bundled'")
    }
    if not m.has_src_table { return proj_fail(m, "W5002", "sources must be a table") }
    let src_rel = proj_safe_rel_path(m.source_root_rel, "sources.root")
    if src_rel[0] != "1" { return proj_fail(m, "W5002", src_rel[1]) }
    let src_cont = proj_contained_existing(root, src_rel[1], "sources.root")
    if src_cont[0] != "1" { return proj_fail(m, "W5002", src_cont[1]) }
    if not proj_is_dir(src_cont[1]) { return proj_fail(m, "W5002", "sources.root must name an existing directory") }
    m.source_root_abs = src_cont[1]

    if len(m.targets) == 0 {
        return proj_fail(m, "W5002", "targets must contain at least one named target")
    }
    for t in m.targets {
        let label = "targets." + t.name
        let er = proj_safe_rel_path(t.entry, label + ".entry")
        if er[0] != "1" { return proj_fail(m, "W5002", er[1]) }
        if t.profile != "native-cli" and t.profile != "wasi-command" and t.profile != "browser-library" {
            return proj_fail(m, "W5002", label + ".profile must be 'native-cli', 'wasi-command', or 'browser-library' in manifest version 1")
        }
        if t.profile == "native-cli" and (t.has_preopens or t.has_fuel or t.has_memory_limit_mb) {
            return proj_fail(m, "W5002", label + " resource settings require a WASM target profile")
        }
        if t.profile == "browser-library" and (t.has_preopens or t.has_fuel) {
            return proj_fail(m, "W5002", label + " preopens and fuel require profile = 'wasi-command'")
        }
        let ec = proj_contained_existing(root, er[1], label + ".entry")
        if ec[0] != "1" { return proj_fail(m, "W5002", ec[1]) }
        if not proj_is_readable_file(ec[1]) or not proj_str_ends_with(ec[1], ".wysna") {
            return proj_fail(m, "W5002", label + ".entry must name an existing .wysna source file")
        }
    }

    let mut seen_t_names: list[str] = []
    for idx in 0..len(m.tests) {
        let tc = m.tests[idx]
        let label = "tests[" + str(idx) + "]"
        if not tc.has_name or not proj_valid_name(tc.name) or tool_str_contains(seen_t_names, tc.name) {
            return proj_fail(m, "W5002", label + ".name must be unique and use lowercase letters, digits, or hyphens")
        }
        seen_t_names.append(tc.name)
        let te = proj_safe_rel_path(tc.entry, label + ".entry")
        if te[0] != "1" { return proj_fail(m, "W5002", te[1]) }
        let tc_cont = proj_contained_existing(root, te[1], label + ".entry")
        if tc_cont[0] != "1" { return proj_fail(m, "W5002", tc_cont[1]) }
        if not proj_is_readable_file(tc_cont[1]) or not proj_str_ends_with(tc_cont[1], ".wysna") {
            return proj_fail(m, "W5002", label + ".entry must name an existing .wysna source file")
        }
    }
    return m
}

fn proj_find_manifest_path(explicit: str) -> list[str] {
    if explicit != "" {
        let abs = proj_abs_from_cwd(explicit)
        let cand = if proj_is_dir(abs) { module_normalize(abs + "/wysna.toml") } else { abs }
        if not proj_is_readable_file(cand) {
            return ["0", "manifest not found: '" + cand + "'"]
        }
        return ["1", cand]
    }
    let cwd = module_canonical(mcp_getcwd())
    let mut cur = cwd
    while cur != "" {
        let cand = if cur == "/" { "/wysna.toml" } else { cur + "/wysna.toml" }
        if proj_is_readable_file(cand) { return ["1", cand] }
        let mut slash = -1
        for i in 0..len(cur) { if cur[i] == "/" { slash = i } }
        if slash < 0 { break }
        if slash == 0 {
            if cur == "/" { break }
            cur = "/"
        } else {
            cur = slice(cur, 0, slash)
        }
    }
    return ["0", "no wysna.toml found from the current directory to its parents"]
}

fn proj_load_manifest(explicit: str) -> ProjectManifest {
    let found = proj_find_manifest_path(explicit)
    if found[0] != "1" {
        let fail_m = ProjectManifest("", "")
        return proj_fail(fail_m, "W5002", found[1])
    }
    return proj_parse_manifest_at(found[1], [])
}

fn proj_emit_error_and_exit(subcmd: str, json_mode: bool, code: str, msg: str) -> unit {
    let cmd_name = if subcmd != "" { "project." + subcmd } else { "project" }
    let exit_c = if code == "W5004" { 3 } elif code == "W5002" or code == "W5005" { 2 } else { 1 }
    let status = if exit_c == 3 { "toolchain_error" } elif exit_c == 2 { "usage_error" } else { "diagnostic_error" }
    if json_mode {
        let diag = diag_record_json(code, if exit_c == 2 { "usage" } else { "filesystem" }, "error", msg, "<project>", 1, 1, "")
        diag_write_output(diag_tool_envelope_json(cmd_name, status, exit_c, "[" + diag + "]", "", "", "[]"))
    } else {
        eprint("[" + code + "] wysna project: " + msg)
    }
    exit(exit_c)
}

fn proj_target_meta_json(profile: str) -> str {
    let triple = if profile == "wasi-command" { "\"wasm32-wasip1\"" } elif profile == "browser-library" { "\"wasm32-unknown-emscripten\"" } else { "null" }
    return "{\"profile\":" + diag_json_quote(profile) + ",\"triple\":" + triple + "}"
}

fn proj_check_envelope_json(command: str, status: str, exit_code: int, diagnostics_json: str, target_json: str, artifacts_json: str) -> str {
    let mut parts: list[str] = ["{\"schema_version\":\"wysna.tool-result/1\""]
    parts.append(",\"command\":" + diag_json_quote(command))
    parts.append(",\"status\":" + diag_json_quote(status))
    parts.append(",\"invocation_id\":\"native\"")
    parts.append(",\"tool_exit_code\":" + str(exit_code))
    parts.append(",\"process_exit_code\":" + str(exit_code))
    parts.append(",\"execution\":null")
    parts.append((",\"toolchain\":{\"compiler\":\"" + tool_compiler_version() + "\"}"))
    parts.append(",\"target\":" + target_json)
    parts.append(",\"diagnostics\":" + diagnostics_json)
    parts.append(",\"artifacts\":" + artifacts_json)
    parts.append(",\"telemetry\":null}")
    return join_strings(parts, "")
}

fn proj_resolve_entry_override(m: ProjectManifest, raw_override: str) -> list[str] {
    let rel = proj_safe_rel_path(raw_override, "--entry")
    if rel[0] != "1" { return ["0", rel[1]] }
    let cont = proj_contained_existing(m.root, rel[1], "--entry")
    if cont[0] != "1" { return ["0", cont[1]] }
    if not proj_is_readable_file(cont[1]) or not proj_str_ends_with(cont[1], ".wysna") {
        return ["0", "project entry is not an existing .wysna file: '" + raw_override + "'"]
    }
    return ["1", cont[1]]
}

fn proj_is_protected_build_dest(m: ProjectManifest, dest_abs: str) -> bool {
    let norm = module_canonical(dest_abs)
    if norm == module_canonical(m.path) or norm == module_canonical(m.root + "/wysna.lock") { return true }
    for d in m.deps {
        if norm == module_canonical(d.abs_root + "/wysna.toml") { return true }
    }
    if proj_str_ends_with(norm, ".wysna") { return true }
    return false
}

fn proj_scaffold_fs(path: str, operation: int) -> int {
    let value = tool_buf_from_str(path)
    let unused = wysna_host_buffer_new()
    let status = wysna_host_fs(value, unused, operation)
    wysna_host_close(value)
    wysna_host_close(unused)
    return status
}

fn proj_scaffold_write(path: str, content: str) -> list[bool] {
    let path_buffer = tool_buf_from_str(path)
    let handle = wysna_host_file_open(path_buffer, 3)
    wysna_host_close(path_buffer)
    if wysna_host_is_open(handle) != 1 { return [false, false] }
    let contents = tool_buf_from_str(content)
    let written = wysna_host_file_write(handle, contents)
    let closed = wysna_host_close(handle)
    wysna_host_close(contents)
    return [true, written == 0 and closed == 0]
}

fn proj_scaffold(args: list[str], json_mode_in: bool) -> unit {
    let mut json_mode = json_mode_in
    let mut name = ""
    let mut i = 1
    while i < len(args) {
        let arg = args[i]
        if arg == "--output-format=json-v1" {
            json_mode = true
        } elif arg == "--output-format" and i + 1 < len(args) and args[i + 1] == "json-v1" {
            json_mode = true
            i = i + 1
        } elif arg == "--help" or arg == "-h" {
            print("Usage: wysna project new NAME [--output-format=json-v1]")
            return
        } elif name == "" and proj_valid_name(arg) {
            name = arg
        } else {
            proj_emit_error_and_exit("new", json_mode, "W5002", "expected one lowercase project name and optional --output-format=json-v1")
        }
        i = i + 1
    }
    if name == "" {
        proj_emit_error_and_exit("new", json_mode, "W5002", "expected a project name")
    }

    let root = proj_abs_from_cwd(name)
    if proj_scaffold_fs(root, 2) != 0 {
        let err_code = wysna_host_last_error()
        if err_code == 17 or err_code == 183 or proj_path_exists(root) {
            proj_emit_error_and_exit("new", json_mode, "W5002", "project destination already exists: '" + root + "'")
        }
        proj_emit_error_and_exit("new", json_mode, "W5004", "cannot create project directory '" + root + "'")
    }
    let dirs = [root + "/src", root + "/tests"]
    let paths = [root + "/src/main.wysna", root + "/tests/example.wysna", root + "/wysna.toml"]
    let manifest = "manifest_version = 1\n\n[package]\nname = \"" + name + ("\"\nversion = \"0.1.0\"\nlanguage = \"" + tool_language_version() + "\"\n\n") +
        ("[toolchain]\ncompiler = \"" + tool_compiler_version() + "\"\nstdlib = \"bundled\"\n\n[sources]\nroot = \"src\"\n\n") +
        "[targets.app]\nentry = \"src/main.wysna\"\nprofile = \"native-cli\"\n\n" +
        "[[tests]]\nname = \"example\"\nentry = \"tests/example.wysna\"\ntimeout_ms = 10000\n"
    let contents = [
        "fn main() -> unit {\n    print(\"Hello, Wysna!\")\n}\n",
        "import \"std/test\"\n\nfn main() -> unit {\n    test.expect_equal_int(1 + 1, 2, \"addition\")\n}\n",
        manifest,
    ]
    let mut created_dirs: list[str] = [root]
    let mut failed = ""
    for dir in dirs {
        if proj_scaffold_fs(dir, 2) != 0 { failed = dir break }
        created_dirs.append(dir)
    }
    let mut created_files: list[str] = []
    if failed == "" {
        for j in 0..len(paths) {
            let result = proj_scaffold_write(paths[j], contents[j])
            if result[0] { created_files.append(paths[j]) }
            if not result[1] { failed = paths[j] break }
        }
    }
    if failed != "" {
        for file in created_files {
            let _removed = proj_scaffold_fs(file, 3)
        }
        while len(created_dirs) > 0 {
            let dir = created_dirs.pop()
            let _removed = proj_scaffold_fs(dir, 3)
        }
        proj_emit_error_and_exit("new", json_mode, "W5004", "cannot initialize project path '" + failed + "'")
    }
    if json_mode {
        let mut artifacts: list[str] = []
        for idx in 0..len(paths) {
            let path = paths[idx]
            let content = contents[idx]
            artifacts.append("{\"kind\":\"project-source\",\"media_type\":\"text/plain\",\"path\":" + diag_json_quote(path) +
                ",\"size_bytes\":" + str(len(bytes(content))) + ",\"sha256\":" + diag_json_quote(diag_sha256_hex(content)) + "}")
        }
        diag_write_output(proj_check_envelope_json("project.new", "ok", 0, "[]", "null", "[" + join_strings(artifacts, ",") + "]"))
    } else {
        print("[OK] Created project: " + root)
    }
}

fn proj_write_lock(m: ProjectManifest, json_mode: bool) -> unit {
    let path = m.root + "/wysna.lock"
    let use_time = str(unix_time())
    let content = proj_lock_json(m, "lock", json_mode)
    let mut temp_path = ""
    for i in 0..32 {
        let candidate = m.root + "/.wysna-lock-" + use_time + "-" + str(i) + ".tmp"
        let write = proj_scaffold_write(candidate, content)
        if not write[0] { continue }
        if not write[1] {
            let _removed = proj_scaffold_fs(candidate, 3)
            break
        }
        temp_path = candidate
        break
    }
    if temp_path == "" {
        proj_emit_error_and_exit("lock", json_mode, "W5004", "cannot write temporary lock beside '" + path + "'")
    }
    let staging = tool_buf_from_str(temp_path)
    let to = tool_buf_from_str(path)
    let status = wysna_host_fs(staging, to, 4)
    wysna_host_close(staging)
    wysna_host_close(to)
    if status != 0 {
        let _removed = proj_scaffold_fs(temp_path, 3)
        proj_emit_error_and_exit("lock", json_mode, "W5004", "cannot publish '" + path + "'")
    }
    if json_mode {
        let artifact = "[{\"kind\":\"lockfile\",\"media_type\":\"application/json\",\"path\":" + diag_json_quote(path) + "}]"
        diag_write_output(proj_check_envelope_json("project.lock", "ok", 0, "[]", "null", artifact))
    } else {
        print("[OK] Wrote " + path)
    }
}

fn proj_verify_lock(m: ProjectManifest, subcmd: str, json_mode: bool) -> unit {
    let path = m.root + "/wysna.lock"
    let raw = read_file(path) else err {
        proj_emit_error_and_exit(subcmd, json_mode, "W5002", "cannot read wysna.lock; run 'wysna project lock'")
        ""
    }
    let expected = mcp_parse_json_strict(proj_lock_json(m, subcmd, json_mode))
    if not proj_lock_matches(expected, mcp_parse_json_strict(raw)) {
        proj_emit_error_and_exit(subcmd, json_mode, "W5002", "wysna.lock is stale or invalid; update it with 'wysna project lock'")
    }
}

fn tool_handle_project(args: list[str], json_mode_in: bool) -> unit {
    let mut plan_out = ""
    let mut cleaned: list[str] = []
    let mut idx = 1
    while idx < len(args) {
        if args[idx] == "--resolve-plan" and idx + 1 < len(args) {
            plan_out = args[idx + 1]
            idx = idx + 2
        } else {
            cleaned.append(args[idx])
            idx = idx + 1
        }
    }

    if len(cleaned) == 0 or cleaned[0] == "--help" or cleaned[0] == "-h" {
        if json_mode_in {
            proj_emit_error_and_exit("", true, "W5002", "Usage: wysna project <new|lock|check|build|run|test> [options]")
        }
        print("Usage: wysna project <new|lock|check|build|run|test> [options]")
        print("Use --manifest PATH to select a project root explicitly.")
        if len(cleaned) == 0 { exit(2) }
        exit(0)
    }

    let subcmd = cleaned[0]
    if subcmd == "new" { proj_scaffold(cleaned, json_mode_in) return }
    if subcmd != "lock" and subcmd != "check" and subcmd != "build" and subcmd != "run" and subcmd != "test" {
        proj_emit_error_and_exit("", json_mode_in, "W5002", "unknown project command '" + subcmd + "'")
    }

    let mut manifest_arg = ""
    let mut target_arg = ""
    let mut entry_arg = ""
    let mut filter_arg = ""
    let mut output_arg = ""
    let mut has_filter = false
    let mut list_only = false
    let mut discover = false
    let mut case_id = ""
    let mut expected_plan = ""
    let mut report_json = ""
    let mut report_junit = ""
    let mut frozen = false
    let mut json_mode = json_mode_in

    let mut i = 1
    while i < len(cleaned) {
        let a = cleaned[i]
        if a == "--" {
            if subcmd != "run" {
                proj_emit_error_and_exit(subcmd, json_mode, "W5002", "arguments after -- are supported only by 'wysna project run'")
            }
            break
        } elif a == "--frozen" or a == "--offline" {
            if a == "--frozen" { frozen = true }
            i = i + 1
        } elif a == "--output-format=json-v1" {
            if subcmd != "lock" and subcmd != "check" and subcmd != "build" and subcmd != "test" {
                proj_emit_error_and_exit(subcmd, true, "W5002", "--output-format=json-v1 is supported only by project lock, check, build and test")
            }
            json_mode = true
            i = i + 1
        } elif a == "--output-format" and i + 1 < len(cleaned) {
            if subcmd != "lock" and subcmd != "check" and subcmd != "build" and subcmd != "test" {
                proj_emit_error_and_exit(subcmd, true, "W5002", "--output-format=json-v1 is supported only by project lock, check, build and test")
            }
            if cleaned[i + 1] != "json-v1" {
                proj_emit_error_and_exit(subcmd, json_mode, "W5002", "unsupported output format: " + cleaned[i + 1])
            }
            json_mode = true
            i = i + 2
        } elif a == "--manifest" and i + 1 < len(cleaned) {
            manifest_arg = cleaned[i + 1]
            i = i + 2
        } elif a == "--target" and i + 1 < len(cleaned) {
            if subcmd != "check" and subcmd != "build" and subcmd != "run" {
                proj_emit_error_and_exit(subcmd, json_mode, "W5002", "--target is supported only by project check, build, and run")
            }
            target_arg = cleaned[i + 1]
            i = i + 2
        } elif a == "--entry" and i + 1 < len(cleaned) {
            if subcmd != "run" {
                proj_emit_error_and_exit(subcmd, json_mode, "W5002", "--entry is supported only by 'wysna project run'")
            }
            entry_arg = cleaned[i + 1]
            i = i + 2
        } elif a == "--list" or a == "--discover" {
            if subcmd != "test" { proj_emit_error_and_exit(subcmd, json_mode, "W5002", "test selection options are supported only by project test") }
            if a == "--list" { list_only = true } else { discover = true }
            i = i + 1
        } elif (a == "--case" or a == "--expect-plan-hash" or a == "--report-json" or a == "--report-junit") and i + 1 < len(cleaned) {
            if subcmd != "test" { proj_emit_error_and_exit(subcmd, json_mode, "W5002", "test selection and report options are supported only by project test") }
            if a == "--case" { case_id = cleaned[i + 1] }
            elif a == "--expect-plan-hash" { expected_plan = cleaned[i + 1] }
            elif a == "--report-json" { report_json = cleaned[i + 1] }
            else { report_junit = cleaned[i + 1] }
            i = i + 2
        } elif a == "--filter" and i + 1 < len(cleaned) {
            if subcmd != "test" {
                proj_emit_error_and_exit(subcmd, json_mode, "W5002", "--filter is supported only by 'wysna project test'")
            }
            filter_arg = cleaned[i + 1]
            has_filter = true
            i = i + 2
        } elif (a == "-o" or a == "--output") and i + 1 < len(cleaned) {
            if subcmd != "build" {
                proj_emit_error_and_exit(subcmd, json_mode, "W5002", "-o is supported only by 'wysna project build'")
            }
            output_arg = cleaned[i + 1]
            i = i + 2
        } else {
            proj_emit_error_and_exit(subcmd, json_mode, "W5002", "unknown or incomplete option for project " + subcmd + ": " + a)
        }
    }

    let m = proj_load_manifest(manifest_arg)
    if not m.ok {
        proj_emit_error_and_exit(subcmd, json_mode, m.err_code, m.err_msg)
    }
    if subcmd == "lock" and (frozen or target_arg != "") {
        proj_emit_error_and_exit(subcmd, json_mode, "W5002", "project lock does not accept --frozen or --target")
    }
    if subcmd == "lock" {
        proj_write_lock(m, json_mode)
        return
    }
    if frozen { proj_verify_lock(m, subcmd, json_mode) }

    let mut dep_aliases: list[str] = []
    let mut dep_roots: list[str] = []
    for d in m.deps {
        dep_aliases.append(d.alias)
        dep_roots.append(d.source_root_abs)
    }

    if subcmd == "check" {
        proj_execute_check(m, target_arg, dep_aliases, dep_roots, json_mode)
    }

    let test_plan = if subcmd == "test" { proj_test_plan(m, discover, filter_arg, has_filter, case_id, json_mode) }
        else { proj_empty_test_plan() }
    if subcmd == "test" {
        if expected_plan != "" and expected_plan != test_plan.hash {
            proj_emit_error_and_exit("test", json_mode, "W5005", "test plan is stale; list tests again before executing")
        }
        report_json = proj_test_report_path(m, report_json, json_mode)
        report_junit = proj_test_report_path(m, report_junit, json_mode)
        if report_json != "" and report_json == report_junit { proj_emit_error_and_exit("test", json_mode, "W5002", "JSON and JUnit reports require different paths") }
        if list_only and report_junit != "" { proj_emit_error_and_exit("test", json_mode, "W5002", "--report-junit requires test execution, not --list") }
        if list_only and plan_out == "" {
            if report_json != "" { write_file(report_json, test_plan.json + "\n") else err { proj_emit_error_and_exit("test", json_mode, "W5004", err.message) } }
            let rc = if len(test_plan.cases) == 0 { 2 } else { 0 }
            if json_mode { diag_write_output(diag_tool_envelope_json("project.test", if rc == 0 { "ok" } else { "usage_error" }, rc, "[]", "result", test_plan.json, "[]")) }
            else { for tc in test_plan.cases { print("test:" + tc.name, tc.entry) } }
            exit(rc)
        }
    }
    if plan_out == "" {
        proj_emit_error_and_exit(subcmd, json_mode, "W5002", "project " + subcmd + " requires the wysna native SDK driver")
    }

    let mut lines: list[str] = []
    lines.append("KIND=" + subcmd)
    lines.append("NAME=" + proj_plan_encode(m.name))
    lines.append("ROOT=" + proj_plan_encode(m.root))
    lines.append("SRC_ROOT=" + proj_plan_encode(m.source_root_abs))
    for d in m.deps {
        lines.append("DEP=" + proj_plan_encode(d.alias) + "\t" + proj_plan_encode(d.source_root_abs))
    }

    if subcmd == "build" or subcmd == "run" {
        let tname = proj_resolve_target_name(m, target_arg)
        let tidx = proj_find_target_idx(m, tname)
        if tidx < 0 {
            proj_emit_error_and_exit(subcmd, json_mode, "W5002", "unknown target '" + tname + "'")
        }
        let target = m.targets[tidx]
        if target.profile != "native-cli" {
            proj_emit_error_and_exit(subcmd, json_mode, "W5002", "native SDK only supports profile = 'native-cli' (target '" + target.name + "' uses '" + target.profile + "')")
        }
        let mut entry_abs = m.root + "/" + target.entry
        if entry_arg != "" {
            let ov = proj_resolve_entry_override(m, entry_arg)
            if ov[0] != "1" {
                proj_emit_error_and_exit(subcmd, json_mode, "W5002", ov[1])
            }
            entry_abs = ov[1]
        }
        lines.append("TARGET=" + target.name)
        lines.append("ENTRY=" + proj_plan_encode(entry_abs))
        if subcmd == "build" {
            let dest = if output_arg != "" { proj_abs_from_cwd(output_arg) } else { module_normalize(m.root + "/build/" + target.name) }
            if proj_is_protected_build_dest(m, dest) {
                proj_emit_error_and_exit("build", json_mode, "W5002", "build output must not overwrite a source, manifest, or lockfile")
            }
            lines.append("OUTPUT=" + proj_plan_encode(dest))
        }
    } else {
        lines.append("MANIFEST=" + proj_plan_encode(m.path))
        lines.append("MANIFEST_SHA=" + m.manifest_sha256)
        lines.append("LOCK_SHA=" + test_plan.lock_sha)
        lines.append("WORKSPACE_REVISION=" + test_plan.revision)
        lines.append("PLAN_HASH=" + test_plan.hash)
        lines.append("PLAN_JSON=" + proj_plan_encode(test_plan.json))
        lines.append("LIST_ONLY=" + if list_only { "1" } else { "0" })
        lines.append("REPORT_JSON=" + proj_plan_encode(report_json))
        lines.append("REPORT_JUNIT=" + proj_plan_encode(report_junit))
        for idx in 0..len(test_plan.cases) {
            let tc = test_plan.cases[idx]
            lines.append("TEST=" + proj_plan_encode(tc.name) + "\t" + str(tc.timeout_ms) + "\t" + proj_plan_encode(m.root + "/" + tc.entry) + "\t" + test_plan.hashes[idx])
        }
    }

    write_file(plan_out, join_strings(lines, "\n") + "\n") else err {
        proj_emit_error_and_exit(subcmd, json_mode, "W5004", "cannot write project execution plan: " + err.message)
    }
    exit(0)
}
# proj_handle_impact lives in 09_project_impact.wysna.
# Evaluate checked project architecture metadata before returning or publishing edits.

struct ArchitectureIssue {
    code: str, message: str, file: str, line: int, col: int, data: str, related: str,
}

struct ArchitectureEvaluation {
    report: str, issues: list[ArchitectureIssue],
}

fn arch_under(file: str, root: str) -> bool {
    let prefix = if proj_str_ends_with(root, "/") { root } else { root + "/" }
    return len(file) > len(prefix) and slice(file, 0, len(prefix)) == prefix
}

fn arch_class_in_scope(n: ToolGraphNode, m: ProjectManifest) -> bool {
    return n.kind == "class" and arch_under(n.file, m.source_root_abs)
}

fn arch_roles(m: ProjectManifest, graph: ToolGraph) -> dict[str, str] {
    let schema_file = module_canonical(m.root + "/" + m.architecture.schema_path)
    let mut roles: dict[str, str] = {}
    for n in graph.nodes {
        if not arch_class_in_scope(n, m) { continue }
        for attribute in n.attributes {
            if attribute.schema_file != schema_file or attribute.schema_name != m.architecture.schema_name { continue }
            let mut role = ""
            for argument in attribute.arguments {
                if argument.name == "role" and argument.kind == "str" { role = argument.value }
            }
            roles[n.id] = role
        }
    }
    return roles
}

fn arch_owner_id(n: ToolGraphNode) -> str {
    return if n.owner == "" { n.id } else { n.owner }
}

fn arch_symbol(m: ProjectManifest, graph: ToolGraph, n: ToolGraphNode) -> str {
    let file = if arch_under(n.file, m.root) { slice(n.file, len(m.root) + 1, len(n.file)) } else { n.file }
    let owner = tool_find_node_idx(graph, n.owner)
    let name = if owner >= 0 { graph.nodes[owner].name + "." + n.name } else { n.name }
    return file + "::" + name
}

fn arch_source(loader: ModuleLoader, file: str) -> str {
    let loaded = module_read_with_overlays(file, loader.ov_paths, loader.ov_texts)
    return if loaded[0] == "1" { loaded[1] } else { "" }
}

fn arch_issue(m: ProjectManifest, graph: ToolGraph, loader: ModuleLoader, rule: ProjectArchitectureRule, revision: str, from_symbol: str, relation: str, site: Token, target_index: int, to_role: str, boundary: str) -> ArchitectureIssue {
    let violation = boundary == ""
    let status = if violation { "violation" } else { "incomplete" }
    let code = if violation { "W6101" } else { "W6102" }
    let mut to_symbol = ""
    let mut related: list[str] = []
    if target_index >= 0 {
        let target = graph.nodes[target_index]
        to_symbol = arch_symbol(m, graph, target)
        let span = diag_primary_span_json(target.file, target.line, target.col, arch_source(loader, target.file))
        let owner_index = tool_find_node_idx(graph, arch_owner_id(target))
        if boundary == "unclassified_target" and owner_index >= 0 {
            let owner = graph.nodes[owner_index]
            let owner_span = diag_primary_span_json(owner.file, owner.line, owner.col, arch_source(loader, owner.file))
            related.append("{\"message\":\"Class requiring an architecture role\",\"line\":" + str(owner.line) +
                ",\"col\":" + str(owner.col) + ",\"span\":" + owner_span + "}")
        }
        if boundary != "unclassified_target" or owner_index != target_index {
            related.append("{\"message\":\"Target declaration\",\"line\":" + str(target.line) +
                ",\"col\":" + str(target.col) + ",\"span\":" + span + "}")
        }
    }
    let message = "Architecture rule '" + rule.id + "'" + (if violation {
        " forbids " + relation + " from " + from_symbol + " to " + to_symbol
    } else {
        " cannot verify " + relation + " from " + from_symbol + ": " + boundary
    })
    let fields = [
        "\"kind\":" + diag_json_quote("architecture_" + status),
        "\"status\":" + diag_json_quote(status),
        "\"rule_id\":" + diag_json_quote(rule.id),
        "\"relation\":" + diag_json_quote(relation),
        "\"from_symbol\":" + diag_json_quote(from_symbol),
        "\"from_role\":" + diag_json_quote(rule.from_role),
        "\"to_symbol\":" + (if to_symbol == "" { "null" } else { diag_json_quote(to_symbol) }),
        "\"to_role\":" + (if to_role == "" { "null" } else { diag_json_quote(to_role) }),
        "\"boundary\":" + (if boundary == "" { "null" } else { diag_json_quote(boundary) }),
        "\"graph_hash\":" + diag_json_quote(graph.graph_hash),
        "\"revision\":" + diag_json_quote(revision),
    ]
    let src = arch_source(loader, site.file)
    let mut col = site.col
    let start = diag_char_offset_at(src, site.line, col)
    if start >= 0 {
        let mut i = start
        while i < len(src) and (src[i] == " " or src[i] == "\t") {
            col = col + 1
            i = i + 1
        }
    }
    return ArchitectureIssue {
        code: code, message: message, file: site.file, line: site.line, col: col,
        data: "{" + join_strings(fields, ",") + "}", related: "[" + join_strings(related, ",") + "]",
    }
}

fn arch_site(file: str, line: int, col: int) -> Token {
    return Token { kind: "IDENT", val: "", file: file, line: line, col: col }
}

fn arch_rule_issue(m: ProjectManifest, graph: ToolGraph, loader: ModuleLoader, roles: dict[str, str], rule: ProjectArchitectureRule, revision: str, schema_valid: bool) -> ArchitectureIssue? {
    let mut incomplete: ArchitectureIssue? = None
    if not schema_valid {
        incomplete = arch_issue(m, graph, loader, rule, revision, "wysna.toml::" + m.architecture.schema_name, rule.relations[0], arch_site(m.path, 1, 1), -1, "", "missing_role_schema")
    }
    for n in graph.nodes {
        let role = roles.get(n.id) ?? ""
        if roles.get(n.id) != None and not tool_str_contains(m.architecture.roles, role) {
            incomplete = arch_issue(m, graph, loader, rule, revision, arch_symbol(m, graph, n), rule.relations[0], arch_site(n.file, n.line, 1), -1, "", "unknown_role")
            break
        }
    }
    for relation in ["calls", "uses_type"] {
        if not tool_str_contains(rule.relations, relation) { continue }
        for edge in graph.edges {
            if edge.kind != relation { continue }
            let source_index = tool_find_node_idx(graph, edge.from_id)
            let target_index = tool_find_node_idx(graph, edge.to_id)
            if source_index < 0 or target_index < 0 { continue }
            let origin = graph.nodes[source_index]
            if (roles.get(arch_owner_id(origin)) ?? "") != rule.from_role { continue }
            let target_owner = arch_owner_id(graph.nodes[target_index])
            if target_owner == arch_owner_id(origin) { continue }
            let to_role = roles.get(target_owner) ?? ""
            let site = arch_site(edge.file, edge.line, 1)
            if tool_str_contains(rule.deny_roles, to_role) {
                return arch_issue(m, graph, loader, rule, revision, arch_symbol(m, graph, origin), relation, site, target_index, to_role, "")
            }
            let target_class = tool_find_node_idx(graph, target_owner)
            if incomplete == None and to_role == "" and target_class >= 0 and arch_class_in_scope(graph.nodes[target_class], m) {
                incomplete = arch_issue(m, graph, loader, rule, revision, arch_symbol(m, graph, origin), relation, site, target_index, "", "unclassified_target")
            }
        }
    }
    if incomplete == None and tool_str_contains(rule.relations, "calls") {
        for origin in graph.nodes {
            if (roles.get(arch_owner_id(origin)) ?? "") != rule.from_role { continue }
            for boundary in origin.uncertain_calls {
                if boundary.kind == "extern_ffi" { continue }
                let mut relevant = len(boundary.candidate_owners) == 0
                for candidate in boundary.candidate_owners {
                    let role = roles.get(candidate) ?? ""
                    let index = tool_find_node_idx(graph, candidate)
                    if tool_str_contains(rule.deny_roles, role) or (role == "" and index >= 0 and arch_class_in_scope(graph.nodes[index], m)) {
                        relevant = true
                    }
                }
                if not relevant { continue }
                return arch_issue(m, graph, loader, rule, revision, arch_symbol(m, graph, origin), "calls", arch_site(boundary.file, boundary.line, 1), -1, "", boundary.kind)
            }
        }
    }
    return incomplete
}

fn arch_evaluate(m: ProjectManifest, graph: ToolGraph, loader: ModuleLoader) -> ArchitectureEvaluation {
    let roles = arch_roles(m, graph)
    let schema_file = module_canonical(m.root + "/" + m.architecture.schema_path)
    let schema_id = graph.nominal_ids.get(schema_file + "\n" + m.architecture.schema_name) ?? ""
    let schema_idx = tool_find_node_idx(graph, schema_id)
    let schema_valid = schema_idx >= 0 and graph.nodes[schema_idx].role_schema
    let revision = diag_sha256_hex(m.manifest_sha256 + ":" + graph.graph_hash)
    let mut rules: list[str] = []
    let mut issues: list[ArchitectureIssue] = []
    let mut status = "verified"
    for rule in m.architecture.rules {
        let mut rule_status = "verified"
        match arch_rule_issue(m, graph, loader, roles, rule, revision, schema_valid) {
            Some(issue) => {
                issues.append(issue)
                rule_status = if issue.code == "W6101" { "violation" } else { "incomplete" }
                if status == "verified" or rule_status == "violation" { status = rule_status }
            },
            None => {},
        }
        rules.append("{\"id\":" + diag_json_quote(rule.id) + ",\"status\":" + diag_json_quote(rule_status) + "}")
    }
    let report = "{\"schema_version\":\"wysna.architecture/1\",\"graph_hash\":" + diag_json_quote(graph.graph_hash) + ",\"revision\":" + diag_json_quote(revision) + ",\"status\":" + diag_json_quote(status) + ",\"rules\":[" + join_strings(rules, ",") + "]}"
    return ArchitectureEvaluation { report: report, issues: issues }
}

fn arch_report_diagnostics(evaluation: ArchitectureEvaluation, loader: ModuleLoader, json_mode: bool) -> str {
    let mut records: list[str] = []
    for issue in evaluation.issues {
        let src = arch_source(loader, issue.file)
        if json_mode {
            records.append(diag_record_json_full(issue.code, "architecture", "error", issue.message, issue.file, issue.line, issue.col, src, issue.data, issue.related))
        } else {
            eprint("[" + issue.code + "] " + issue.file + ":" + str(issue.line) + ":" + str(issue.col) + " - " + issue.message)
            let excerpt = diag_render_source_excerpt(src, issue.line, issue.col)
            if excerpt != "" { eprint(excerpt) }
        }
    }
    return "[" + join_strings(records, ",") + "]"
}

fn arch_handle_role_query(manifest: str, source: str, requested_target: str, role: str, frozen: bool, json_mode: bool) -> unit {
    let m = proj_load_manifest(manifest)
    if not m.ok { report_error(manifest, m.err_code, 1, 1, m.err_msg) }
    if not tool_str_contains(m.architecture.roles, role) {
        report_error(manifest, "W5002", 1, 1, "unknown architecture role '" + role + "'")
    }
    if frozen { proj_verify_lock(m, "graph", json_mode) }
    let mut entry = ""
    if source != "" {
        let file = module_canonical(source)
        if not arch_under(file, m.source_root_abs) {
            report_error(file, "W5002", 1, 1, "source must belong to the project source root")
        }
        entry = slice(file, len(m.root) + 1, len(file))
    } else {
        let target = proj_find_target_idx(m, proj_resolve_target_name(m, requested_target))
        if target < 0 { report_error(manifest, "W5002", 1, 1, "unknown project target") }
        entry = m.targets[target].entry
    }
    let mut aliases: list[str] = []
    let mut roots: list[str] = []
    for dep in m.deps {
        aliases.append(dep.alias)
        roots.append(dep.source_root_abs)
    }
    let graph = proj_impact_graph(m, entry, aliases, roots)
    let roles = arch_roles(m, graph)
    let mut rows: list[str] = []
    for node in graph.nodes {
        if (roles.get(node.id) ?? "") != role { continue }
        node.architecture_role = role
        if json_mode { rows.append(tool_node_json(node)) }
        else { print(node.qualified_name + " (" + node.file + ":" + str(node.line) + ")") }
    }
    if json_mode {
        let result = "{\"schema_version\":\"wysna.graph/1\",\"mode\":\"role\",\"entry_file\":" + diag_json_quote(graph.entry_file) + ",\"graph_hash\":" + diag_json_quote(graph.graph_hash) + ",\"role\":" + diag_json_quote(role) + ",\"nodes\":[" + join_strings(rows, ",") + "]}"
        diag_write_output(diag_tool_envelope_json("graph", "ok", 0, "[]", "result", result, "[]"))
    }
    exit(0)
}
# In-process project check adapter used by the full self-hosted compiler bundle.

fn proj_execute_check(m: ProjectManifest, target_arg: str, dep_aliases: list[str], dep_roots: list[str], json_mode: bool) -> unit {
    let tname = proj_resolve_target_name(m, target_arg)
    let tidx = proj_find_target_idx(m, tname)
    if tidx < 0 {
        proj_emit_error_and_exit("check", json_mode, "W5002", "unknown target '" + tname + "'")
    }
    let target = m.targets[tidx]
    let entry_path = m.root + "/" + target.entry
    let src = read_file(entry_path) else err {
        proj_emit_error_and_exit("check", json_mode, "W5004", "cannot read project entry '" + entry_path + "': " + err.message)
        ""
    }
    let loader = ModuleLoader()
    loader.track_dependencies = m.architecture.enabled
    loader.project_sources_root = m.source_root_abs
    loader.dep_aliases = dep_aliases
    loader.dep_roots = dep_roots
    module_expand(loader, src, entry_path, true)
    loader.output.append(Token { kind: "EOF", val: "", line: 1, col: 1, file: module_normalize(entry_path) })
    let checked = check_program(loader.output, module_canonical(entry_path), true)
    for node in checked.nodes {
        if node.kind == "unsupported" {
            report_error_at("W2013", node.source, "Compiler native-core-v1 does not support expression " + node.text)
        }
    }
    if m.architecture.enabled {
        let graph = tool_build_checked_graph(src, module_canonical(entry_path), loader, checked, false)
        let evaluation = arch_evaluate(m, graph, loader)
        let diagnostics = arch_report_diagnostics(evaluation, loader, json_mode)
        let failed = len(evaluation.issues) > 0
        if json_mode {
            let envelope = proj_check_envelope_json("project.check", if failed { "diagnostic_error" } else { "ok" }, if failed { 1 } else { 0 }, diagnostics, proj_target_meta_json(target.profile), "[]")
            diag_write_output(slice(envelope, 0, len(envelope) - 1) + ",\"result\":{\"architecture\":" + evaluation.report + "}}")
            exit(if failed { 1 } else { 0 })
        }
        if failed { exit(1) }
    }
    let mod_count = str(len(loader.paths))
    if json_mode {
        diag_write_output(proj_check_envelope_json("project.check", "ok", 0, "[]", proj_target_meta_json(target.profile), "[]"))
    } else {
        print("[OK] Project check passed: " + m.name + " (" + mod_count + " modules)")
    }
    exit(0)
}

extern "C" fn wysna_host_project_entries(path: opaque, output: opaque) -> int
extern "C" fn wysna_host_project_path_key(path: opaque, output: opaque) -> int
extern "C" fn wysna_host_project_file_sha256(path: opaque, output: opaque) -> int

class ProjectLockState {
    command: str
    json_mode: bool
    root: str
    ids: dict[str, str]
    packages: dict[str, str]

    fn init(command: str, json_mode: bool, root: str) {
        this.command = command
        this.json_mode = json_mode
        this.root = root
        let ids: dict[str, str] = {}
        let packages: dict[str, str] = {}
        this.ids = ids
        this.packages = packages
    }

    fn fail(code: str, message: str) -> unit {
        proj_emit_error_and_exit(this.command, this.json_mode, code, message)
    }
}

fn proj_lock_host_text(state: ProjectLockState, path: str, operation: str) -> str {
    let input = tool_buf_from_str(path)
    let output = wysna_host_buffer_new()
    let count = if operation == "entries" { wysna_host_project_entries(input, output) }
        elif operation == "path-key" { wysna_host_project_path_key(input, output) }
        else { wysna_host_project_file_sha256(input, output) }
    wysna_host_close(input)
    if count < 0 {
        wysna_host_close(output)
        state.fail("W5004", "cannot " + operation + " '" + path + "'")
        return ""
    }
    let mut result = ""
    if operation == "hash" {
        let mut digits: list[str] = []
        for i in 0..32 {
            let value = wysna_host_buffer_get(output, i)
            digits.append(diag_hex_digit((value / 16) % 16) + diag_hex_digit(value % 16))
        }
        result = join_strings(digits, "")
    } else {
        result = lsp_buf_to_str(output, count)
    }
    wysna_host_close(output)
    return result
}

fn proj_lock_paths(state: ProjectLockState, root: str, relative: str, source_only: bool) -> list[str] {
    return proj_snapshot_paths(state, root, relative, source_only, not source_only)
}

fn proj_snapshot_paths(state: ProjectLockState, root: str, relative: str, source_only: bool, skip_generated: bool) -> list[str] {
    let directory = if relative == "" { root } else { root + "/" + relative }
    let entries = proj_lock_host_text(state, directory, "entries")
    let ignored: list[str] = [".git", ".wysna_cache", "__pycache__", ".pytest_cache", "build", "dist"]
    let mut result: list[str] = []
    let mut i = 0
    while i < len(entries) {
        let kind = entries[i]
        i = i + 1
        let start = i
        while i < len(entries) and ord(entries[i]) != 0 { i = i + 1 }
        let name = slice(entries, start, i)
        i = i + 1
        let path = if relative == "" { name } else { relative + "/" + name }
        if skip_generated and relative == "" and tool_str_contains(ignored, name) { continue }

        if kind == "d" {
            for nested in proj_snapshot_paths(state, root, path, source_only, skip_generated) { result.append(nested) }
        } elif source_only or (name != "wysna.lock" and name != "wysna.lock.tmp") {
            if kind == "l" {
                state.fail("W5002", "project input '" + root + "/" + path + "' is a symlink")
            }
            let workspace_manifest = source_only and skip_generated and name == "wysna.toml"
            if kind == "f" and (not source_only or workspace_manifest or proj_str_ends_with(path, ".wysna")) {
                result.append(path)
            }
        }
    }
    return result
}

fn proj_lock_verify_collisions(state: ProjectLockState, paths: list[str]) -> unit {
    let mut components: dict[str, str] = {}
    for path in paths {
        for i in 0..len(path) + 1 {
            if i == len(path) or path[i] == "/" {
                let component = slice(path, 0, i)
                let key = proj_lock_host_text(state, component, "path-key")
                let existing = components.get(key) else { "" }
                if existing != "" and existing != component {
                    state.fail("W5002", "project inputs collide on portable filesystems: '" + existing + "' and '" + component + "'")
                }
                components[key] = component
            }
        }
    }
}

fn proj_lock_aliases(state: ProjectLockState, m: ProjectManifest) -> str {
    let mut rows: list[str] = []
    for dep in m.deps {
        let id = proj_lock_visit(state, dep.abs_root)
        rows.append("{\"alias\":" + diag_json_quote(dep.alias) + ",\"package_id\":" + diag_json_quote(id) + "}")
    }
    return "[" + join_strings(tool_sort_strings(rows), ",") + "]"
}

fn proj_lock_visit(state: ProjectLockState, directory: str) -> str {
    let known = state.ids.get(directory) else { "" }
    if known != "" { return known }

    let m = proj_parse_manifest_at(directory + "/wysna.toml", [])
    if not m.ok { state.fail(m.err_code, m.err_msg) }
    let aliases = proj_lock_aliases(state, m)
    proj_lock_verify_collisions(state, proj_lock_paths(state, m.source_root_abs, "", true))
    let paths = tool_sort_strings(proj_lock_paths(state, m.root, "", false))
    proj_lock_verify_collisions(state, paths)
    let mut inputs: list[str] = []
    for path in paths {
        let sha = proj_lock_host_text(state, m.root + "/" + path, "hash")
        if path == "wysna.toml" and sha != m.manifest_sha256 {
            state.fail("W5004", "dependency manifest changed while reading '" + m.path + "'")
        }
        inputs.append("{\"path\":" + diag_json_quote(path) + ",\"sha256\":" + diag_json_quote(sha) + "}")
    }
    let inputs_json = "[" + join_strings(inputs, ",") + "]"
    let hash = diag_sha256_hex(inputs_json)
    let manifest_hash = diag_json_quote(m.manifest_sha256)
    let name = diag_json_quote(m.name)
    let version = diag_json_quote(m.version)
    let content_hash = diag_json_quote(hash)
    let identity = "{\"content_sha256\":" + content_hash + ",\"manifest_sha256\":" + manifest_hash + ",\"name\":" + name + ",\"version\":" + version + "}"
    let id = m.name + "@" + m.version + "+" + slice(diag_sha256_hex(identity), 0, 16)
    let relative = slice(m.root, len(state.root) + 1, len(m.root))
    let row = "{\"content_sha256\":" + content_hash + ",\"dependencies\":" + aliases + ",\"inputs\":" + inputs_json +
        ",\"manifest_sha256\":" + manifest_hash + ",\"name\":" + name + ",\"package_id\":" + diag_json_quote(id) +
        ",\"path\":" + diag_json_quote(relative) + ",\"version\":" + version + "}"
    let key = m.name + chr(0) + m.version + chr(0) + id + chr(0) + relative
    state.ids[directory] = id
    state.packages[key] = row
    return id
}

fn proj_lock_json(m: ProjectManifest, command: str, json_mode: bool) -> str {
    let state = ProjectLockState(command, json_mode, m.root)
    proj_lock_verify_collisions(state, proj_lock_paths(state, m.source_root_abs, "", true))
    let aliases = proj_lock_aliases(state, m)
    let mut dependencies: list[str] = []
    for key in tool_sort_strings(state.packages.keys()) {
        let row = state.packages.get(key) else { "" }
        dependencies.append(row)
    }
    return "{\n" +
        "  \"aliases\": " + aliases + ",\n" +
        "  \"compiler_version\": " + diag_json_quote(m.compiler_version) + ",\n" +
        "  \"dependencies\": [" + join_strings(dependencies, ",") + "],\n" +
        "  \"language_version\": " + diag_json_quote(m.language_version) + ",\n" +
        "  \"lock_version\": 1,\n" +
        "  \"root\": {\n" +
        "    \"manifest_sha256\": " + diag_json_quote(m.manifest_sha256) + ",\n" +
        "    \"name\": " + diag_json_quote(m.name) + ",\n" +
        "    \"version\": " + diag_json_quote(m.version) + "\n" +
        "  },\n" +
        "  \"stdlib\": " + diag_json_quote(m.stdlib) + "\n}\n"
}

fn proj_lock_matches(expected: LspJson, actual: LspJson) -> bool {
    if expected.kind != actual.kind { return false }
    if expected.kind == "str" or expected.kind == "int" {
        return expected.str_val == actual.str_val
    }
    if expected.kind == "object" {
        if len(expected.keys) != len(actual.keys) { return false }
        for key in expected.keys {
            if not proj_lock_matches(lsp_json_get(expected, key), lsp_json_get(actual, key)) { return false }
        }
        return true
    }
    if expected.kind == "array" {
        if len(expected.items) != len(actual.items) { return false }
        for i in 0..len(expected.items) {
            if not proj_lock_matches(expected.items[i], actual.items[i]) { return false }
        }
        return true
    }
    return false
}
# Deterministic agent-facing test selection and execution-plan snapshots.

class ProjectTestPlan {
    cases: list[ProjectTestCase]
    hashes: list[str]
    lock_sha: str
    revision: str
    hash: str
    json: str
    fn init(cases: list[ProjectTestCase], hashes: list[str], lock_sha: str, revision: str, hash: str, json: str) {
        this.cases = cases
        this.hashes = hashes
        this.lock_sha = lock_sha
        this.revision = revision
        this.hash = hash
        this.json = json
    }
}

fn proj_empty_test_plan() -> ProjectTestPlan {
    let cases: list[ProjectTestCase] = []
    let hashes: list[str] = []
    return ProjectTestPlan(cases, hashes, "", "", "", "")
}

fn proj_plan_encode(value: str) -> str {
    let mut parts: list[str] = []
    for index in 0..len(value) {
        let ch = value[index]
        if ch == "%" { parts.append("%25") }
        elif ch == "\t" { parts.append("%09") }
        elif ch == "\n" { parts.append("%0A") }
        elif ch == "\r" { parts.append("%0D") }
        else { parts.append(ch) }
    }
    return join_strings(parts, "")
}

fn proj_test_exists(state: ProjectLockState, path: str) -> bool {
    let first = tool_buf_from_str(path)
    let second = tool_buf_from_str("")
    let found = wysna_host_fs(first, second, 0)
    wysna_host_close(first)
    wysna_host_close(second)
    if found < 0 { state.fail("W5004", "cannot inspect test input '" + path + "'") }
    return found == 1
}

fn proj_workspace_sha256(state: ProjectLockState, root: str) -> str {
    let workspace_paths = tool_sort_strings(proj_snapshot_paths(state, root, "", true, true))
    proj_lock_verify_collisions(state, workspace_paths)
    let mut source_rows: list[str] = []
    for path in workspace_paths {
        let sha = proj_lock_host_text(state, root + "/" + path, "hash")
        source_rows.append("[" + diag_json_quote(path) + "," + diag_json_quote(sha) + "]")
    }
    return diag_sha256_hex("[" + join_strings(source_rows, ",") + "]")
}

fn proj_sdk_fingerprint(state: ProjectLockState) -> str {
    let engine = env("WYSNA_SELFHOST_COMPILER") else { args()[0] }
    let mut sdk_rows: list[str] = [proj_lock_host_text(state, engine, "hash")]
    let stdlib_root = lsp_stdlib_root_arg()
    if stdlib_root != "" {
        for path in tool_sort_strings(proj_lock_paths(state, stdlib_root, "", true)) {
            sdk_rows.append(diag_json_quote(path) + ":" + proj_lock_host_text(state, stdlib_root + "/" + path, "hash"))
        }
    }
    return diag_sha256_hex(join_strings(sdk_rows, "\n"))
}

fn proj_workspace_revision_parts(manifest_sha: str, lock_sha: str, sdk_sha: str, workspace_sha: str) -> list[str] {
    let revision = "\"manifest_sha256\":" + diag_json_quote(manifest_sha) + ",\"lock_sha256\":" +
        (if lock_sha == "" { "null" } else { diag_json_quote(lock_sha) }) + ",\"toolchain\":\"" + tool_compiler_version() +
        "\",\"sdk_fingerprint\":" + diag_json_quote(sdk_sha) + ",\"workspace_sha256\":" + diag_json_quote(workspace_sha)
    return [revision, diag_sha256_hex("{" + revision + "}")]
}

fn proj_test_plan(m: ProjectManifest, discover: bool, filter: str, has_filter: bool, case_id: str, json_mode: bool) -> ProjectTestPlan {
    let state = ProjectLockState("test", json_mode, m.root)
    let mut candidates: list[ProjectTestCase] = []
    let mut seen: list[str] = []
    for tc in m.tests { candidates.append(tc); seen.append(tc.entry) }
    if discover and proj_test_exists(state, m.root + "/tests") {
        if module_canonical_resolved(m.root + "/tests") != m.root + "/tests" {
            state.fail("W5002", "test discovery does not follow symlinks")
        }
        let paths = tool_sort_strings(proj_lock_paths(state, m.root + "/tests", "", true))
        proj_lock_verify_collisions(state, paths)
        for path in paths {
            let entry = "tests/" + path
            let filename = tool_basename(path)
            if not tool_str_contains(seen, entry) and ((len(filename) >= 5 and slice(filename, 0, 5) == "test_") or proj_str_ends_with(path, "_test.wysna")) {
                let tc = ProjectTestCase()
                tc.name = "auto:" + entry
                tc.entry = entry
                candidates.append(tc)
            }
        }
    }
    let mut selected: list[ProjectTestCase] = []
    for tc in candidates {
        if (not has_filter or proj_str_contains_substr(tc.name, filter)) and (case_id == "" or case_id == "test:" + tc.name) {
            selected.append(tc)
        }
    }
    if len(selected) == 0 and case_id != "" { state.fail("W5002", "test case '" + case_id + "' matched no cases") }
    if len(selected) == 0 and has_filter { state.fail("W5002", "test filter '" + filter + "' matched no cases") }
    if len(selected) > 4096 { state.fail("W5002", "test selection exceeds 4096 cases") }
    let lock_path = m.root + "/wysna.lock"
    let lock_sha = if proj_test_exists(state, lock_path) { proj_lock_host_text(state, lock_path, "hash") } else { "" }
    let mut rows: list[str] = []
    let mut hashes: list[str] = []
    for tc in selected {
        let sha = proj_lock_host_text(state, m.root + "/" + tc.entry, "hash")
        hashes.append(sha)
        rows.append("{\"id\":" + diag_json_quote("test:" + tc.name) + ",\"name\":" + diag_json_quote(tc.name) +
            ",\"entry\":" + diag_json_quote(tc.entry) + ",\"entry_sha256\":" + diag_json_quote(sha) + ",\"timeout_ms\":" + str(tc.timeout_ms) + "}")
    }
    let workspace_sha = proj_workspace_sha256(state, m.root)
    let sdk_sha = proj_sdk_fingerprint(state)
    let rev_parts = proj_workspace_revision_parts(m.manifest_sha256, lock_sha, sdk_sha, workspace_sha)
    let revision = rev_parts[0]
    let revision_sha = rev_parts[1]
    let snapshot = revision + ",\"workspace_revision\":" + diag_json_quote(revision_sha) + ",\"cases\":[" + join_strings(rows, ",") + "]"
    let hash = diag_sha256_hex("{" + snapshot + "}")
    let payload = "{\"schema_version\":\"wysna.project-test-plan/1\",\"project\":" + diag_json_quote(m.name) + "," + snapshot +
        ",\"selected\":" + str(len(selected)) + ",\"plan_hash\":" + diag_json_quote(hash) + "}"
    return ProjectTestPlan(selected, hashes, lock_sha, revision_sha, hash, payload)
}

fn proj_test_report_path(m: ProjectManifest, value: str, json_mode: bool) -> str {
    if value == "" { return "" }
    let path = proj_abs_from_cwd(value)
    if proj_is_protected_build_dest(m, path) {
        proj_emit_error_and_exit("test", json_mode, "W5002", "test report path must not overwrite a source, manifest, or lockfile")
    }
    return path
}
# Checked multi-file workspace patch planning, atomic commit, and rollback for native SDK.

fn wpatch_valid_rel_wysna(name: str) -> bool {
    if name == "" or name[0] == "/" or name[len(name) - 1] == "/" { return false }
    if len(name) <= 6 or not proj_str_ends_with(name, ".wysna") { return false }
    for i in 0..len(name) {
        if name[i] == "\\" { return false }
    }
    let mut seg = ""
    for i in 0..len(name) + 1 {
        if i == len(name) or name[i] == "/" {
            if seg == "" or seg == "." or seg == ".." { return false }
            seg = ""
        } else {
            seg = seg + name[i]
        }
    }
    return true
}

fn wpatch_unified_diff_kind(rel_path: str, action: str, old_text: str, new_text: str) -> str {
    if action == "modify" and old_text == new_text { return "" }
    let empty_lines: list[str] = []
    let old_lines = if action == "create" { empty_lines } else { schema_split_lines(old_text) }
    let new_lines = if action == "delete" { empty_lines } else { schema_split_lines(new_text) }
    let mut prefix = 0
    while prefix < len(old_lines) and prefix < len(new_lines) and old_lines[prefix] == new_lines[prefix] {
        prefix = prefix + 1
    }
    let mut old_end = len(old_lines)
    let mut new_end = len(new_lines)
    while old_end > prefix and new_end > prefix and old_lines[old_end - 1] == new_lines[new_end - 1] {
        old_end = old_end - 1
        new_end = new_end - 1
    }
    let old_count = old_end - prefix
    let new_count = new_end - prefix
    let old_start = if old_count == 0 { prefix } else { prefix + 1 }
    let new_start = if new_count == 0 { prefix } else { prefix + 1 }
    let from_h = if action == "create" { "--- /dev/null\n" } else { "--- a/" + rel_path + "\n" }
    let to_h = if action == "delete" { "+++ /dev/null\n" } else { "+++ b/" + rel_path + "\n" }
    let mut parts: list[str] = [
        from_h,
        to_h,
        "@@ -" + str(old_start) + "," + str(old_count) + " +" + str(new_start) + "," + str(new_count) + " @@\n",
    ]
    for i in prefix..old_end { parts.append("-" + old_lines[i] + "\n") }
    for i in prefix..new_end { parts.append("+" + new_lines[i] + "\n") }
    return join_strings(parts, "")
}

fn wpatch_no_symlink_ancestors(root: str, rel: str) -> bool {
    let mut cur = root
    let mut seg = ""
    for i in 0..len(rel) + 1 {
        if i == len(rel) or rel[i] == "/" {
            if seg != "" {
                cur = cur + "/" + seg
                if proj_path_exists(cur) and module_canonical_resolved(cur) != cur {
                    return false
                }
                seg = ""
            }
        } else {
            seg = seg + rel[i]
        }
    }
    return true
}

fn wpatch_ensure_parents(root: str, rel: str) -> bool {
    let mut cur = root
    let mut seg = ""
    for i in 0..len(rel) {
        if rel[i] == "/" {
            if seg != "" {
                cur = cur + "/" + seg
                if not proj_is_dir(cur) {
                    if proj_path_exists(cur) { return false }
                    if proj_scaffold_fs(cur, 2) != 0 { return false }
                }
                seg = ""
            }
        } else {
            seg = seg + rel[i]
        }
    }
    return true
}

fn wpatch_find_nth_match(hay: str, needle: str) -> list[int] {
    if needle == "" or len(needle) > len(hay) { return [0, -1] }
    let mut count = 0
    let mut first_idx = -1
    let limit = len(hay) - len(needle) + 1
    let mut i = 0
    while i < limit {
        if slice(hay, i, i + len(needle)) == needle {
            count = count + 1
            if first_idx < 0 { first_idx = i }
            i = i + len(needle)
        } else {
            i = i + 1
        }
    }
    return [count, first_idx]
}

fn wpatch_apply_hunks(rel: str, before_src: str, hunks_val: LspJson, json_mode: bool) -> str {
    if hunks_val.kind != "array" or len(hunks_val.items) == 0 {
        proj_emit_error_and_exit("patch", json_mode, "W5002", "Workspace edit 'hunks' must be a non-empty array: " + rel)
    }
    let mut cur = before_src
    for h_idx in 0..len(hunks_val.items) {
        let h = hunks_val.items[h_idx]
        if h.kind != "object" or len(h.keys) != 2 or not lsp_json_has(h, "old_text") or not lsp_json_has(h, "new_text") {
            proj_emit_error_and_exit("patch", json_mode, "W5002", "Hunk requires old_text and new_text: " + rel)
        }
        let ov = lsp_json_get(h, "old_text")
        let nv = lsp_json_get(h, "new_text")
        if ov.kind != "str" or nv.kind != "str" or ov.str_val == "" {
            proj_emit_error_and_exit("patch", json_mode, "W5002", "Hunk requires non-empty old_text and string new_text: " + rel)
        }
        let hit = wpatch_find_nth_match(cur, ov.str_val)
        if hit[0] != 1 {
            proj_emit_error_and_exit("patch", json_mode, "W5002", "Hunk matched " + str(hit[0]) + " times in '" + rel + "' (expected 1)")
        }
        let pos = hit[1]
        cur = slice(cur, 0, pos) + nv.str_val + slice(cur, pos + len(ov.str_val), len(cur))
    }
    return cur
}

fn wpatch_apply_symbol_edit(abs_p: str, before_src: str, sym_name: str, replacement: str, json_mode: bool) -> str {
    if sym_name == "" {
        proj_emit_error_and_exit("patch", json_mode, "W5002", "Workspace symbol edit requires non-empty symbol")
    }
    let graph = tool_build_graph(before_src, abs_p)
    let n_idx = tool_require_symbol(graph, sym_name, "patch", json_mode)
    let n = graph.nodes[n_idx]
    if module_canonical(n.file) != module_canonical(abs_p) {
        proj_emit_error_and_exit("patch", json_mode, "W5002", "Target symbol belongs to another file: " + sym_name)
    }
    let orig_bytes = bytes(before_src)
    if n.start_byte < 0 or n.end_byte < n.start_byte or n.end_byte > len(orig_bytes) {
        proj_emit_error_and_exit("patch", json_mode, "W5004", "Invalid symbol byte range for patch: " + sym_name)
    }
    let mut prefix_b: list[int] = []
    for i in 0..n.start_byte { prefix_b.append(orig_bytes[i]) }
    let mut suffix_b: list[int] = []
    for i in n.end_byte..len(orig_bytes) { suffix_b.append(orig_bytes[i]) }
    return tool_utf8_bytes_to_str(prefix_b) + replacement + tool_utf8_bytes_to_str(suffix_b)
}

fn wpatch_live_revision(state: ProjectLockState, m: ProjectManifest, sdk_sha: str) -> str {
    let lock_path = m.root + "/wysna.lock"
    let lock_sha = if proj_test_exists(state, lock_path) { proj_lock_host_text(state, lock_path, "hash") } else { "" }
    let ws_sha = proj_workspace_sha256(state, m.root)
    let live_manifest_sha = proj_lock_host_text(state, m.path, "hash")
    let parts = proj_workspace_revision_parts(live_manifest_sha, lock_sha, sdk_sha, ws_sha)
    return parts[1]
}

fn wpatch_remove(path: str) -> bool {
    let first = tool_buf_from_str(path)
    let second = tool_buf_from_str("")
    let result = wysna_host_fs(first, second, 3)
    wysna_host_close(first)
    wysna_host_close(second)
    return result == 0
}

fn wpatch_unlink_all(paths: list[str]) -> unit {
    for path in paths {
        if path != "" { let _removed = wpatch_remove(path) }
    }
}

fn wpatch_matches(path: str, expected_sha: str) -> bool {
    if module_canonical_resolved(path) != path { return false }
    let text = read_file(path) else err { return false }
    return diag_sha256_hex(text) == expected_sha
}

fn wpatch_stage_temp_file(target_abs: str, stamp: str, idx: int, content: str, mode_from: str) -> str {
    let empty_buf = tool_buf_from_str("")
    let mut tmp_path = ""
    let mut fh = empty_buf
    let mut opened = false
    for attempt in 0..32 {
        let candidate = target_abs + ".wysna_tmp_" + stamp + "_" + str(idx) + "_" + str(attempt)
        let c_buf = tool_buf_from_str(candidate)
        let handle = wysna_host_file_open(c_buf, if mode_from == "" { 3 } else { 4 })
        wysna_host_close(c_buf)
        if wysna_host_is_open(handle) == 1 {
            tmp_path = candidate
            fh = handle
            opened = true
            break
        }
    }
    wysna_host_close(empty_buf)
    if not opened { return "" }
    let data_buf = tool_buf_from_str(content)
    let wr = wysna_host_file_write(fh, data_buf)
    let cl = wysna_host_close(fh)
    wysna_host_close(data_buf)
    if wr != 0 or cl != 0 {
        wpatch_unlink_all([tmp_path])
        return ""
    }
    if mode_from != "" {
        let original = tool_buf_from_str(mode_from)
        let staged = tool_buf_from_str(tmp_path)
        let matched = wysna_host_fs(original, staged, 7)
        wysna_host_close(original)
        wysna_host_close(staged)
        if matched != 0 { wpatch_unlink_all([tmp_path]); return "" }
    }
    return tmp_path
}

fn wpatch_rename_file(src_path: str, dst_path: str) -> bool {
    let s_buf = tool_buf_from_str(src_path)
    let d_buf = tool_buf_from_str(dst_path)
    let mv = wysna_host_fs(s_buf, d_buf, 4)
    wysna_host_close(s_buf)
    wysna_host_close(d_buf)
    return mv >= 0
}

extern "C" fn wysna_host_monotonic_ms() -> int

fn wpatch_test_paths(state: ProjectLockState, root: str) -> list[str] {
    let mut paths = proj_snapshot_paths(state, root, "", false, true)
    if proj_test_exists(state, root + "/wysna.lock") { paths.append("wysna.lock") }
    return tool_sort_strings(paths)
}

fn wpatch_test_inputs_sha(state: ProjectLockState, root: str, paths: list[str]) -> str {
    let mut rows: list[str] = []
    for path in paths {
        let absolute = root + "/" + path
        if module_canonical_resolved(absolute) != absolute {
            state.fail("W5005", "Workspace test input changed during staging: " + path)
        }
        let digest = proj_lock_host_text(state, absolute, "hash")
        rows.append("[" + diag_json_quote(path) + "," + diag_json_quote(digest) + "]")
    }
    return diag_sha256_hex("[" + join_strings(rows, ",") + "]")
}

fn wpatch_copy_test_input(source: str, destination: str) -> bool {
    if module_canonical_resolved(source) != source { return false }
    let source_buf = tool_buf_from_str(source)
    let destination_buf = tool_buf_from_str(destination)
    let input = wysna_host_file_open(source_buf, 0)
    let output = wysna_host_file_open(destination_buf, 3)
    wysna_host_close(source_buf)
    wysna_host_close(destination_buf)
    let chunk = wysna_host_buffer_new()
    let mut ok = wysna_host_is_open(input) == 1 and wysna_host_is_open(output) == 1
    while ok {
        let count = wysna_host_file_read(input, chunk, 1048576)
        if count == 0 { break }
        ok = count > 0 and wysna_host_file_write(output, chunk) == 0
    }
    wysna_host_close(chunk)
    let closed_input = wysna_host_close(input)
    let closed_output = wysna_host_close(output)
    return ok and closed_input == 0 and closed_output == 0
}

struct PatchTestVerification { code: int, evidence: str, timings: str }

fn wpatch_verify_candidate_tests(state: ProjectLockState, m: ProjectManifest, paths: list[str], inputs_sha: str,
                                  edit_rels: list[str], edit_actions: list[str], edit_after: list[str],
                                  sdk_sha: str, revision: str, plan_hash: str, discover: bool, frozen: bool,
                                  expected_count: int) -> PatchTestVerification {
    let staging_started = wysna_host_monotonic_ms()
    let driver = env("WYSNA_SDK_DRIVER") else { "" }
    let stage_env = env("WYSNA_PATCH_TEST_STAGE") else { "" }
    let staging = if stage_env == "" { "" } else { module_canonical_resolved(stage_env) }
    if driver == "" or staging == "" {
        state.fail("W5002", "Tested patches require the wysna native SDK driver")
    }
    let candidate = staging + "/candidate"
    if proj_path_exists(candidate) or not wpatch_ensure_parents(staging, "candidate/file") {
        state.fail("W5004", "Cannot create a private patch test workspace")
    }
    for path in paths {
        if not wpatch_ensure_parents(candidate, path) or not wpatch_copy_test_input(m.root + "/" + path, candidate + "/" + path) {
            state.fail("W5004", "Cannot stage workspace test input: " + path)
        }
    }
    if wpatch_test_inputs_sha(state, candidate, paths) != inputs_sha {
        state.fail("W5005", "Workspace test snapshot changed during staging")
    }
    for index in 0..len(edit_rels) {
        let relative = edit_rels[index]
        let path = candidate + "/" + relative
        if edit_actions[index] != "create" and not wpatch_remove(path) {
            state.fail("W5004", "Cannot remove staged source: " + relative)
        }
        if edit_actions[index] != "delete" and
           (not wpatch_ensure_parents(candidate, relative) or not proj_scaffold_write(path, edit_after[index])[1]) {
            state.fail("W5004", "Cannot stage candidate source: " + relative)
        }
    }
    let candidate_manifest = candidate + "/" + tool_basename(m.path)
    let staged_manifest = proj_load_manifest(candidate_manifest)
    if not staged_manifest.ok { state.fail(staged_manifest.err_code, staged_manifest.err_msg) }
    if wpatch_live_revision(state, staged_manifest, sdk_sha) != revision {
        state.fail("W5005", "Staged workspace differs from the checked patch")
    }

    let report_path = staging + "/test-result.json"
    let mut argv: list[str] = ["project", "test", "--manifest", candidate_manifest, "--output-format=json-v1", "--diag-out", report_path]
    if discover { argv.append("--discover") }
    if frozen { argv.append("--frozen") }
    let exe_buf = lsp_buf_from_str(driver)
    let args_buf = lsp_pack_argv_buf(argv)
    let test_started = wysna_host_monotonic_ms()
    let rc = wysna_host_process_run(exe_buf, args_buf, 600000)
    let test_ms = wysna_host_monotonic_ms() - test_started
    wysna_host_close(exe_buf)
    wysna_host_close(args_buf)
    let raw = read_file(report_path) else err { "" }
    let envelope = mcp_parse_json_strict(raw)
    let report = lsp_json_get(envelope, "result")
    let status = lsp_json_str(report, "status", "")
    let case_reports = lsp_json_get(report, "cases")
    if lsp_json_str(report, "workspace_revision", "") != revision or case_reports.kind != "array" or
       lsp_json_int(report, "selected", -1) != expected_count {
        state.fail("W5001", "Project tests did not return a report for the checked candidate")
    }
    if not ((rc == 0 and status == "passed" and len(case_reports.items) == expected_count and expected_count > 0) or
            (rc == 1 and status == "failed") or (rc == 2 and status == "empty") or (rc == 130 and status == "cancelled")) {
        state.fail("W5001", "Project test runner did not complete verification")
    }
    if wpatch_live_revision(state, staged_manifest, sdk_sha) != revision {
        state.fail("W5005", "Tests changed the staged source revision")
    }

    let mut rows: list[str] = []
    let mut timings: list[str] = []
    let fields: list[str] = ["id", "status", "failure_kind", "exit_code", "duration_ms", "stdout_sha256", "stderr_sha256"]
    for record in case_reports.items {
        timings.append("{\"id\":" + diag_json_quote(lsp_json_str(record, "id", "")) +
            ",\"compile_ms\":" + str(lsp_json_int(record, "compile_ms", 0)) +
            ",\"run_ms\":" + str(lsp_json_int(record, "run_ms", 0)) + "}")
        let mut parts: list[str] = []
        for field in fields {
            parts.append(diag_json_quote(field) + ":" + mcp_serialize_json_val(lsp_json_get(record, field)))
        }
        if lsp_json_str(record, "status", "") != "passed" {
            let stderr = lsp_json_str(record, "stderr", "")
            let excerpt = if len(stderr) > 2048 { slice(stderr, 0, 2048) } else { stderr }
            parts.append("\"stderr\":" + diag_json_quote(excerpt))
        }
        rows.append("{" + join_strings(parts, ",") + "}")
    }
    let evidence = "{\"plan_hash\":" + diag_json_quote(plan_hash) + ",\"workspace_revision\":" + diag_json_quote(revision) +
        ",\"test_plan_hash\":" + diag_json_quote(lsp_json_str(report, "plan_hash", "")) +
        ",\"status\":" + diag_json_quote(status) + ",\"cases\":[" + join_strings(rows, ",") + "]}"
    let timing_json = "{\"staging\":" + str(test_started - staging_started) + ",\"test_runner\":" + str(test_ms) +
        ",\"cases\":[" + join_strings(timings, ",") + "]}"
    return PatchTestVerification { code: rc, evidence: evidence, timings: timing_json }
}

fn proj_handle_workspace_patch(manifest_arg: str, edits_file: str, expected_hash: str, apply: bool, discover: bool, frozen: bool, test: bool, json_mode: bool) -> unit {
    if apply and expected_hash == "" {
        proj_emit_error_and_exit("patch", json_mode, "W5002", "Applying workspace edits requires --expect-plan-hash from a successful preview")
    }
    let m = proj_load_manifest(manifest_arg)
    if not m.ok {
        proj_emit_error_and_exit("patch", json_mode, m.err_code, m.err_msg)
    }
    if frozen { proj_verify_lock(m, "patch", json_mode) }

    let state = ProjectLockState("patch", json_mode, m.root)
    let snap_paths = tool_sort_strings(proj_snapshot_paths(state, m.root, "", true, true))
    proj_lock_verify_collisions(state, snap_paths)
    let mut snap_hashes: list[str] = []
    for p in snap_paths {
        snap_hashes.append(proj_lock_host_text(state, m.root + "/" + p, "hash"))
    }
    let sdk_sha = proj_sdk_fingerprint(state)
    let test_plan = proj_test_plan(m, discover, "", false, "", json_mode)
    let live_start = wpatch_live_revision(state, m, sdk_sha)
    if test_plan.revision != live_start {
        proj_emit_error_and_exit("patch", json_mode, "W5005", "Workspace changed during edit planning")
    }

    let raw_edits = read_file(edits_file) else err {
        proj_emit_error_and_exit("patch", json_mode, "W5003", "cannot read --edits file: " + edits_file)
        ""
    }
    let parsed_edits = mcp_parse_json_strict(raw_edits)
    if parsed_edits.kind != "array" or len(parsed_edits.items) == 0 {
        proj_emit_error_and_exit("patch", json_mode, "W5002", "Workspace edits must be a nonempty array")
    }

    let mut protected_rels: list[str] = []
    for t in m.targets {
        if not tool_str_contains(protected_rels, t.entry) { protected_rels.append(t.entry) }
    }
    for tc in test_plan.cases {
        if not tool_str_contains(protected_rels, tc.entry) { protected_rels.append(tc.entry) }
    }

    let mut seen_rel: list[str] = []
    let mut edit_actions: list[str] = []
    let mut edit_rels: list[str] = []
    let mut edit_abs: list[str] = []
    let mut edit_canon: list[str] = []
    let mut edit_before: list[str] = []
    let mut edit_after: list[str] = []
    let mut edit_before_sha: list[str] = []
    let mut edit_after_sha: list[str] = []

    for item in parsed_edits.items {
        if item.kind != "object" or not lsp_json_has(item, "path") {
            proj_emit_error_and_exit("patch", json_mode, "W5002", "Each workspace edit requires path")
        }
        let pv = lsp_json_get(item, "path")
        if pv.kind != "str" {
            proj_emit_error_and_exit("patch", json_mode, "W5002", "Workspace edit path must be a string")
        }
        let rel = pv.str_val
        if not wpatch_valid_rel_wysna(rel) or tool_str_contains(seen_rel, rel) {
            proj_emit_error_and_exit("patch", json_mode, "W5002", "Workspace edit must use a unique relative .wysna path: " + rel)
        }
        seen_rel.append(rel)
        let abs_p = m.root + "/" + rel

        let has_create = lsp_json_has(item, "create")
        let has_delete = lsp_json_has(item, "delete")
        let has_src = lsp_json_has(item, "source")
        let has_sym = lsp_json_has(item, "symbol")
        let has_rep = lsp_json_has(item, "replacement")
        let has_hunks = lsp_json_has(item, "hunks")

        let mut snap_idx = -1
        for k in 0..len(snap_paths) {
            if snap_paths[k] == rel { snap_idx = k break }
        }

        if len(item.keys) == 3 and has_create and has_src {
            let cv = lsp_json_get(item, "create")
            let sv = lsp_json_get(item, "source")
            if cv.kind != "bool" or not cv.bool_val or sv.kind != "str" {
                proj_emit_error_and_exit("patch", json_mode, "W5002", "Create workspace edit requires create=true and string source")
            }
            if snap_idx >= 0 or proj_path_exists(abs_p) or not wpatch_no_symlink_ancestors(m.root, rel) {
                proj_emit_error_and_exit("patch", json_mode, "W5002", "Cannot create existing or symlinked workspace path: " + rel)
            }
            edit_actions.append("create")
            edit_rels.append(rel)
            edit_abs.append(abs_p)
            edit_canon.append(module_normalize(abs_p))
            edit_before.append("")
            edit_after.append(sv.str_val)
            edit_before_sha.append("")
            edit_after_sha.append(diag_sha256_hex(sv.str_val))
            continue
        }

        if len(item.keys) == 2 and has_delete {
            let dv = lsp_json_get(item, "delete")
            if dv.kind != "bool" or not dv.bool_val {
                proj_emit_error_and_exit("patch", json_mode, "W5002", "Delete workspace edit requires delete=true")
            }
            if snap_idx < 0 or module_canonical_resolved(abs_p) != abs_p {
                proj_emit_error_and_exit("patch", json_mode, "W5002", "Delete workspace edit must reference one existing project source: " + rel)
            }
            if tool_str_contains(protected_rels, rel) {
                proj_emit_error_and_exit("patch", json_mode, "W5002", "Cannot delete protected manifest entry: " + rel)
            }
            let before_src = read_file(abs_p) else err {
                proj_emit_error_and_exit("patch", json_mode, "W5003", "cannot read workspace source: " + abs_p)
                ""
            }
            let b_sha = diag_sha256_hex(before_src)
            if b_sha != snap_hashes[snap_idx] {
                proj_emit_error_and_exit("patch", json_mode, "W5005", "Source changed during workspace planning: " + rel)
            }
            edit_actions.append("delete")
            edit_rels.append(rel)
            edit_abs.append(abs_p)
            edit_canon.append(module_canonical(abs_p))
            edit_before.append(before_src)
            edit_after.append("__WYSNA_OVERLAY_DELETED__")
            edit_before_sha.append(b_sha)
            edit_after_sha.append("")
            continue
        }

        if snap_idx < 0 or module_canonical_resolved(abs_p) != abs_p {
            proj_emit_error_and_exit("patch", json_mode, "W5002", "Workspace edit must identify one existing project source: " + rel)
        }
        let before_src = read_file(abs_p) else err {
            proj_emit_error_and_exit("patch", json_mode, "W5003", "cannot read workspace source: " + abs_p)
            ""
        }
        let b_sha = diag_sha256_hex(before_src)
        if b_sha != snap_hashes[snap_idx] {
            proj_emit_error_and_exit("patch", json_mode, "W5005", "Source changed during workspace planning: " + rel)
        }

        let mut after_src = ""
        if len(item.keys) == 2 and has_src {
            let sv = lsp_json_get(item, "source")
            if sv.kind != "str" {
                proj_emit_error_and_exit("patch", json_mode, "W5002", "Workspace edit path and source must be strings")
            }
            after_src = sv.str_val
        } elif len(item.keys) == 3 and has_sym and has_rep {
            let sym_v = lsp_json_get(item, "symbol")
            let rep_v = lsp_json_get(item, "replacement")
            if sym_v.kind != "str" or rep_v.kind != "str" {
                proj_emit_error_and_exit("patch", json_mode, "W5002", "Workspace symbol edit requires string symbol and replacement")
            }
            after_src = wpatch_apply_symbol_edit(abs_p, before_src, sym_v.str_val, rep_v.str_val, json_mode)
        } elif len(item.keys) == 2 and has_hunks {
            after_src = wpatch_apply_hunks(rel, before_src, lsp_json_get(item, "hunks"), json_mode)
        } else {
            proj_emit_error_and_exit("patch", json_mode, "W5002", "Unsupported workspace edit fields for: " + rel)
        }

        if before_src != after_src {
            edit_actions.append("modify")
            edit_rels.append(rel)
            edit_abs.append(abs_p)
            edit_canon.append(module_canonical(abs_p))
            edit_before.append(before_src)
            edit_after.append(after_src)
            edit_before_sha.append(b_sha)
            edit_after_sha.append(diag_sha256_hex(after_src))
        }
    }
    if len(edit_rels) == 0 {
        proj_emit_error_and_exit("patch", json_mode, "W5002", "Workspace edit contains no changes")
    }

    let mut entries: list[str] = []
    for t in m.targets {
        if not tool_str_contains(entries, t.entry) { entries.append(t.entry) }
    }
    for ek in 0..len(edit_rels) {
        if edit_actions[ek] != "delete" and not tool_str_contains(entries, edit_rels[ek]) {
            entries.append(edit_rels[ek])
        }
    }
    let mut patch_cases = test_plan.cases
    if test and discover {
        for ek in 0..len(edit_rels) {
            let path = edit_rels[ek]
            let filename = tool_basename(path)
            if edit_actions[ek] == "create" and (len(path) > 6 and slice(path, 0, 6) == "tests/") and
               ((len(filename) >= 5 and slice(filename, 0, 5) == "test_") or proj_str_ends_with(filename, "_test.wysna")) {
                let tc = ProjectTestCase()
                tc.name = "auto:" + path
                tc.entry = path
                patch_cases.append(tc)
            }
        }
    }
    for tc in patch_cases {
        if not tool_str_contains(entries, tc.entry) { entries.append(tc.entry) }
    }
    let sorted_entries = tool_sort_strings(entries)

    let mut dep_aliases: list[str] = []
    let mut dep_roots: list[str] = []
    for d in m.deps {
        dep_aliases.append(d.alias)
        dep_roots.append(d.source_root_abs)
    }

    let mut entry_inputs: list[list[str]] = []
    for entry in sorted_entries {
        let entry_abs = m.root + "/" + entry
        let mut entry_canon = module_canonical(entry_abs)
        if entry_canon == "" { entry_canon = module_normalize(entry_abs) }
        let mut entry_src = ""
        let mut edited_hit = -1
        for k in 0..len(edit_canon) {
            if edit_canon[k] == entry_canon { edited_hit = k break }
        }
        if edited_hit >= 0 {
            entry_src = edit_after[edited_hit]
        } else {
            entry_src = read_file(entry_abs) else err {
                proj_emit_error_and_exit("patch", json_mode, "W5003", "cannot read workspace entry: " + entry_abs)
                ""
            }
        }
        let loader = ModuleLoader()
        let mut enforce_architecture = false
        if m.architecture.enabled {
            for target in m.targets {
                if target.entry == entry { enforce_architecture = true }
            }
        }
        loader.track_dependencies = enforce_architecture
        loader.project_sources_root = m.source_root_abs
        loader.dep_aliases = dep_aliases
        loader.dep_roots = dep_roots
        loader.ov_paths = edit_canon
        loader.ov_texts = edit_after
        module_expand(loader, entry_src, entry_canon, true)
        loader.output.append(Token { kind: "EOF", val: "", line: 1, col: 1, file: module_normalize(entry_canon) })
        let checked = check_program(loader.output, entry_canon, true)
        for node in checked.nodes {
            if node.kind == "unsupported" {
                report_error_at("W2013", node.source, "Compiler native-core-v1 does not support expression " + node.text)
            }
        }
        if enforce_architecture {
            let graph = tool_build_checked_graph(entry_src, entry_canon, loader, checked, false)
            let evaluation = arch_evaluate(m, graph, loader)
            if len(evaluation.issues) > 0 {
                let diagnostics = arch_report_diagnostics(evaluation, loader, json_mode)
                if json_mode { diag_write_output(diag_tool_envelope_json("patch", "diagnostic_error", 1, diagnostics, "", "", "[]")) }
                exit(1)
            }
        }
        mir_verify(mir_build(checked))
        entry_inputs.append(loader.paths)
    }

    let sorted_edit_rels = tool_sort_strings(edit_rels)
    let mut changes_rows: list[str] = []
    for srel in sorted_edit_rels {
        let mut eidx = 0
        for k in 0..len(edit_rels) {
            if edit_rels[k] == srel { eidx = k break }
        }
        let act = edit_actions[eidx]
        let diff = wpatch_unified_diff_kind(srel, act, edit_before[eidx], edit_after[eidx])
        let b_json = if act == "create" { "null" } else { diag_json_quote(edit_before_sha[eidx]) }
        let a_json = if act == "delete" { "null" } else { diag_json_quote(edit_after_sha[eidx]) }
        changes_rows.append("{\"path\":" + diag_json_quote(srel) + ",\"action\":" + diag_json_quote(act) +
            ",\"before_sha256\":" + b_json + ",\"after_sha256\":" + a_json + ",\"diff\":" + diag_json_quote(diff) + "}")
    }

    let mut next_paths: list[str] = []
    let mut next_hashes: list[str] = []
    for k in 0..len(snap_paths) {
        let p = snap_paths[k]
        let mut f_sha = snap_hashes[k]
        let mut deleted = false
        for ek in 0..len(edit_rels) {
            if edit_rels[ek] == p {
                if edit_actions[ek] == "delete" { deleted = true }
                else { f_sha = edit_after_sha[ek] }
                break
            }
        }
        if not deleted {
            next_paths.append(p)
            next_hashes.append(f_sha)
        }
    }
    for ek in 0..len(edit_rels) {
        if edit_actions[ek] == "create" {
            next_paths.append(edit_rels[ek])
            next_hashes.append(edit_after_sha[ek])
        }
    }
    let sorted_after_paths = tool_sort_strings(next_paths)
    let mut after_ws_rows: list[str] = []
    for p in sorted_after_paths {
        for nk in 0..len(next_paths) {
            if next_paths[nk] == p {
                after_ws_rows.append("[" + diag_json_quote(p) + "," + diag_json_quote(next_hashes[nk]) + "]")
                break
            }
        }
    }
    let after_ws_sha = diag_sha256_hex("[" + join_strings(after_ws_rows, ",") + "]")
    let after_rev_parts = proj_workspace_revision_parts(m.manifest_sha256, test_plan.lock_sha, sdk_sha, after_ws_sha)
    let after_rev = after_rev_parts[1]

    let mut impact_rows: list[str] = []
    let mut selected_ids: list[str] = []
    for tc in patch_cases {
        let tid = "test:" + tc.name
        selected_ids.append(diag_json_quote(tid))
        let mut entry_pos = -1
        for k in 0..len(sorted_entries) {
            if sorted_entries[k] == tc.entry { entry_pos = k break }
        }
        let mut causes: list[str] = []
        if entry_pos >= 0 {
            let paths_for_case = entry_inputs[entry_pos]
            for srel in sorted_edit_rels {
                let mut eidx = 0
                for k in 0..len(edit_rels) {
                    if edit_rels[k] == srel { eidx = k break }
                }
                if tool_str_contains(paths_for_case, edit_canon[eidx]) {
                    causes.append(srel)
                }
            }
        }
        let imp_status = if len(causes) > 0 { "affected" } else { "uncertain" }
        let mut cause_q: list[str] = []
        for c in causes { cause_q.append(diag_json_quote(c)) }
        impact_rows.append("{\"id\":" + diag_json_quote(tid) + ",\"entry\":" + diag_json_quote(tc.entry) +
            ",\"impact_status\":" + diag_json_quote(imp_status) + ",\"sources\":[" + join_strings(cause_q, ",") + "]}")
    }

    let mut checked_q: list[str] = []
    for e in sorted_entries { checked_q.append(diag_json_quote(e)) }
    let test_paths: list[str] = if test { wpatch_test_paths(state, m.root) } else { [] }
    let test_inputs_sha = if test { wpatch_test_inputs_sha(state, m.root, test_paths) } else { "" }
    let payload_body = "{\"schema_version\":\"wysna.workspace-patch/1\"" +
        ",\"workspace_revision_before\":" + diag_json_quote(test_plan.revision) +
        ",\"workspace_revision_after\":" + diag_json_quote(after_rev) +
        ",\"changes\":[" + join_strings(changes_rows, ",") + "]" +
        ",\"checked\":[" + join_strings(checked_q, ",") + "]" +
        ",\"tests\":[" + join_strings(impact_rows, ",") + "]" +
        ",\"selected_test_ids\":[" + join_strings(selected_ids, ",") + "]" +
        (if test { ",\"test_inputs_sha256\":" + diag_json_quote(test_inputs_sha) } else { "" }) + "}"
    let plan_hash = diag_sha256_hex(payload_body)

    let live_mid = wpatch_live_revision(state, m, sdk_sha)
    if live_mid != test_plan.revision {
        proj_emit_error_and_exit("patch", json_mode, "W5005", "Workspace changed during edit planning")
    }
    if expected_hash != "" and plan_hash != expected_hash {
        proj_emit_error_and_exit("patch", json_mode, "W5005", "Workspace edit plan is stale")
    }

    let mut test_code = 0
    let mut evidence = ""
    if test {
        let verification = wpatch_verify_candidate_tests(state, m, test_paths, test_inputs_sha,
            edit_rels, edit_actions, edit_after, sdk_sha, after_rev, plan_hash, discover, frozen, len(patch_cases))
        test_code = verification.code
        evidence = ",\"test_verification\":" + verification.evidence + ",\"test_timing_ms\":" + verification.timings
        if wpatch_live_revision(state, m, sdk_sha) != test_plan.revision or
           wpatch_test_inputs_sha(state, m.root, wpatch_test_paths(state, m.root)) != test_inputs_sha {
            state.fail("W5005", "Workspace test inputs changed during verification")
        }
    }

    if apply and test_code == 0 {
        let stamp = str(unix_time())
        let mut tmp_paths: list[str] = []
        let mut backups: list[str] = []
        for k in 0..len(edit_abs) {
            let act = edit_actions[k]
            let path = edit_abs[k]
            let backup = if act == "create" { "" }
                else { wpatch_stage_temp_file(path, stamp + "_backup", k, edit_before[k], path) }
            backups.append(backup)
            if act != "create" and backup == "" {
                wpatch_unlink_all(tmp_paths)
                wpatch_unlink_all(backups)
                proj_emit_error_and_exit("patch", json_mode, "W5004", "failed staging workspace backup: " + edit_rels[k])
            }
            if act == "create" and not wpatch_ensure_parents(m.root, edit_rels[k]) {
                wpatch_unlink_all(tmp_paths)
                wpatch_unlink_all(backups)
                proj_emit_error_and_exit("patch", json_mode, "W5004", "failed creating parent directory: " + edit_rels[k])
            }
            let staged = if act == "delete" { "" } else { wpatch_stage_temp_file(path, stamp, k, edit_after[k], if act == "modify" { path } else { "" }) }
            tmp_paths.append(staged)
            if act != "delete" and staged == "" {
                wpatch_unlink_all(tmp_paths)
                wpatch_unlink_all(backups)
                proj_emit_error_and_exit("patch", json_mode, "W5004", "failed staging workspace operation: " + edit_rels[k])
            }
        }
        let live_commit = wpatch_live_revision(state, m, sdk_sha)
        if live_commit != test_plan.revision {
            wpatch_unlink_all(tmp_paths)
            wpatch_unlink_all(backups)
            proj_emit_error_and_exit("patch", json_mode, "W5005", "Workspace changed during edit planning")
        }
        let mut published = 0
        let mut failure_code = ""
        for k in 0..len(edit_abs) {
            let act = edit_actions[k]
            let path = edit_abs[k]
            let current_matches = if act == "create" {
                not proj_path_exists(path) and wpatch_no_symlink_ancestors(m.root, edit_rels[k])
            } else { wpatch_matches(path, edit_before_sha[k]) }
            if not current_matches {
                failure_code = "W5005"
                break
            }
            let committed = if act == "delete" { wpatch_remove(path) }
                else { wpatch_rename_file(tmp_paths[k], path) }
            if not committed {
                failure_code = "W5004"
                break
            }
            published = published + 1
        }
        wpatch_unlink_all(tmp_paths)
        if failure_code != "" {
            let mut failed_restores: list[str] = []
            let mut index = published - 1
            while index >= 0 {
                let act = edit_actions[index]
                let path = edit_abs[index]
                let current_matches = if act == "delete" {
                    not proj_path_exists(path) and wpatch_no_symlink_ancestors(m.root, edit_rels[index])
                } else { wpatch_matches(path, edit_after_sha[index]) }
                let restored = current_matches and (if act == "create" { wpatch_remove(path) }
                    else { wpatch_rename_file(backups[index], path) })
                if not restored {
                    let backup = backups[index]
                    let info = if backup == "" { "" } else { " (backup " + backup + ")" }
                    failed_restores.append(path + info)
                    backups[index] = ""
                }
                index = index - 1
            }
            wpatch_unlink_all(backups)
            if len(failed_restores) > 0 {
                proj_emit_error_and_exit("patch", json_mode, "W5004",
                    "Workspace publication failed; could not restore " + join_strings(failed_restores, ", "))
            }
            let message = if failure_code == "W5005" { "Source changed before workspace apply: " }
                else { "failed committing workspace operation: " }
            proj_emit_error_and_exit("patch", json_mode, failure_code, message + edit_rels[published])
        }
        wpatch_unlink_all(backups)
    }

    let written_str = if apply and test_code == 0 { "true" } else { "false" }
    let full_result = slice(payload_body, 0, len(payload_body) - 1) +
        ",\"plan_hash\":" + diag_json_quote(plan_hash) + ",\"written\":" + written_str + evidence + "}"
    if json_mode {
        let status = if test_code == 0 { "ok" } elif test_code == 2 { "usage_error" } else { "runtime_error" }
        diag_write_output(diag_tool_envelope_json("patch", status, test_code, "[]", "result", full_result, "[]"))
    } else {
        print(full_result)
    }
    exit(test_code)
}
# Manifest-level impact analysis (consumed by `wysna graph --manifest ... --rel impact`).

struct ProjectImpactEntry {
    name: str, kind: str, entry: str, profile: str, graph: ToolGraph,
}

fn proj_impact_graph(m: ProjectManifest, entry: str, aliases: list[str], roots: list[str]) -> ToolGraph {
    let file = module_canonical(m.root + "/" + entry)
    let source = read_file(file) else err {
        report_error(file, "W5004", 1, 1, "cannot read project entry: " + err.message)
        ""
    }
    let loader = ModuleLoader()
    loader.track_dependencies = true
    loader.project_sources_root = m.source_root_abs
    loader.dep_aliases = aliases
    loader.dep_roots = roots
    let expanded = module_finish(loader, source, file)
    let checked = check_program(expanded, file, true)
    for node in checked.nodes {
        if node.kind == "unsupported" {
            report_error_at("W2013", node.source, "Compiler native-core-v1 does not support expression " + node.text)
        }
    }
    return tool_build_checked_graph(source, file, loader, checked, true)
}

fn proj_impact_matches(a: ToolGraphNode, b: ToolGraphNode) -> bool {
    return a.file == b.file and a.kind == b.kind and a.line == b.line and a.col == b.col and a.name == b.name
}

fn proj_impact_entry_json(item: ProjectImpactEntry, target: ToolGraphNode, root: str, output_json: bool) -> str {
    let graph = item.graph
    let mut ids: list[str] = []
    let mut next_edges: list[ToolGraphEdge] = []
    for n in graph.nodes {
        if proj_impact_matches(n, target) {
            ids.append(n.id)
            next_edges.append(ToolGraphEdge { from_id: "", to_id: "", kind: "", context: "", file: "", line: 0 })
            break
        }
    }
    let mut index = 0
    while index < len(ids) {
        for e in graph.edges {
            if e.to_id == ids[index] and not tool_str_contains(ids, e.from_id) {
                ids.append(e.from_id)
                next_edges.append(e)
            }
        }
        index = index + 1
    }

    let mut paths: list[str] = []
    let mut labels: list[str] = []
    let mut entry_ids: list[str] = []
    let mut boundaries: list[str] = []
    if item.profile == "browser-library" { boundaries.append("javascript") }
    for n in graph.nodes {
        if n.kind == "extern" and mcp_is_within_root(n.file, root) and not tool_str_contains(boundaries, "c-ffi") {
            boundaries.append("c-ffi")
        }
        if n.file != graph.entry_file { continue }
        let is_root = if item.profile == "browser-library" { n.kind == "fn" and n.visibility == "public" }
            else { n.kind == "entrypoint" or (n.kind == "fn" and n.name == "main") }
        if not is_root { continue }
        entry_ids.append(n.id)
        let mut route: list[str] = []
        let mut description = n.id
        let mut cursor = -1
        for i in 0..len(ids) {
            if ids[i] == n.id { cursor = i break }
        }
        if cursor < 0 { continue }
        while cursor > 0 {
            let edge = next_edges[cursor]
            route.append("{\"from\":" + diag_json_quote(edge.from_id) + ",\"to\":" + diag_json_quote(edge.to_id) + ",\"kind\":" + diag_json_quote(edge.kind) + "}")
            description = description + " --" + edge.kind + "--> " + edge.to_id
            for j in 0..cursor {
                if ids[j] == edge.to_id { cursor = j break }
            }
        }
        paths.append("{\"entry_symbol\":" + diag_json_quote(n.id) + ",\"chain\":[" + join_strings(route, ",") + "]}")
        labels.append(description)
    }
    let mut visited = entry_ids
    let mut head = 0
    while head < len(visited) {
        let id = visited[head]
        head = head + 1
        let idx = tool_find_node_idx(graph, id)
        if idx >= 0 and graph.nodes[idx].indirect_call {
            boundaries.append("indirect-call")
            break
        }
        for edge in graph.edges {
            if edge.from_id == id and not tool_str_contains(visited, edge.to_id) {
                visited.append(edge.to_id)
            }
        }
    }
    let affected = len(paths) > 0
    let impact_status = if affected { "affected" } elif len(boundaries) > 0 { "uncertain" } else { "no-static-path" }
    if not output_json {
        print(item.kind + " " + item.name + " (" + item.entry + "): " + (if impact_status == "no-static-path" { "no static path" } else { impact_status }))
        for label in labels { print("  " + label) }
        if len(boundaries) > 0 { print("  External boundaries: " + join_strings(boundaries, ", ")) }
    }
    return "{\"kind\":" + diag_json_quote(item.kind) + ",\"name\":" + diag_json_quote(item.name) +
        ",\"entry\":" + diag_json_quote(item.entry) + ",\"profile\":" + diag_json_quote(item.profile) +
        ",\"affected\":" + (if affected { "true" } else { "false" }) +
        ",\"impact_status\":" + diag_json_quote(impact_status) +
        ",\"paths\":[" + join_strings(paths, ",") + "],\"unanalyzed_boundaries\":" + tool_str_list_json(boundaries) + "}"
}

fn proj_handle_impact(manifest: str, symbol: str, json_mode: bool) -> unit {
    let m = proj_load_manifest(manifest)
    if not m.ok { report_error(manifest, m.err_code, 1, 1, m.err_msg) }
    let mut aliases: list[str] = []
    let mut roots: list[str] = []
    for dep in m.deps {
        aliases.append(dep.alias)
        roots.append(dep.source_root_abs)
    }
    let mut entries: list[ProjectImpactEntry] = []
    for target in m.targets {
        let graph = proj_impact_graph(m, target.entry, aliases, roots)
        entries.append(ProjectImpactEntry { name: target.name, kind: "target", entry: target.entry, profile: target.profile, graph: graph })
    }
    for test in m.tests {
        let graph = proj_impact_graph(m, test.entry, aliases, roots)
        entries.append(ProjectImpactEntry { name: test.name, kind: "test", entry: test.entry, profile: "native-cli", graph: graph })
    }
    let mut candidates: list[ToolGraphNode] = []
    let mut match_rank = 0
    for item in entries {
        for n in item.graph.nodes {
            if n.kind == "entrypoint" { continue }
            let rank = if n.id == symbol { 3 } elif n.qualified_name == symbol { 2 } elif n.name == symbol { 1 } else { 0 }
            if rank == 0 or rank < match_rank { continue }
            if rank > match_rank {
                candidates = []
                match_rank = rank
            }
            let mut seen = false
            for candidate in candidates {
                if proj_impact_matches(candidate, n) { seen = true break }
            }
            if not seen { candidates.append(n) }
        }
    }
    if len(candidates) != 1 {
        let msg = if len(candidates) == 0 { "symbol not found in declared targets or tests: " } else { "ambiguous project symbol: " }
        report_error(manifest, "W5002", 1, 1, msg + symbol)
    }
    let selected = candidates[0]
    let mut results: list[str] = []
    for item in entries {
        results.append(proj_impact_entry_json(item, selected, m.root, json_mode))
    }
    if json_mode {
        let payload = "{\"schema_version\":\"wysna.project-impact/1\",\"symbol\":{\"id\":" + diag_json_quote(selected.id) +
            ",\"name\":" + diag_json_quote(selected.name) + ",\"file\":" + diag_json_quote(selected.file) + ",\"line\":" + str(selected.line) +
            "},\"entries\":[" + join_strings(results, ",") + "]}"
        diag_write_output(diag_tool_envelope_json("graph", "ok", 0, "[]", "result", payload, "[]"))
    }
}
# PKG-A01: Native-only pinned offline USTAR v1 package archiving, verified cache, and restoration.

struct PkgEntry {
    path: str
    offset: int
    size: int
}

fn pkg_fail(subcmd: str, json_mode: bool, code: str, msg: str) -> unit {
    let cmd_name = if subcmd != "" { "packages." + subcmd } else { "packages" }
    let exit_c = if code == "W5004" { 3 } elif code == "W5002" or code == "W5005" { 2 } else { 1 }
    let status = if exit_c == 3 { "toolchain_error" } elif exit_c == 2 { "usage_error" } else { "diagnostic_error" }
    let stage = if code == "W5004" { "filesystem" } elif code == "W5005" { "package" } else { "usage" }
    if json_mode {
        let diag = diag_record_json(code, stage, "error", msg, "<packages>", 1, 1, "")
        diag_write_output(diag_tool_envelope_json(cmd_name, status, exit_c, "[" + diag + "]", "", "", "[]"))
    } else {
        eprint("[" + code + "] wysna packages: " + msg)
    }
    exit(exit_c)
}

fn pkg_is_hex64(s: str) -> bool {
    if len(s) != 64 { return false }
    for i in 0..64 {
        let c = ord(s[i])
        if not ((c >= 48 and c <= 57) or (c >= 97 and c <= 102)) { return false }
    }
    return true
}

fn pkg_is_valid_alias(s: str) -> bool {
    let n = len(s)
    if n == 0 or n > 63 { return false }
    let c0 = ord(s[0])
    if c0 < 97 or c0 > 122 { return false }
    for i in 1..n {
        let c = ord(s[i])
        if not ((c >= 97 and c <= 122) or (c >= 48 and c <= 57) or c == 45) { return false }
    }
    return true
}

fn pkg_is_reserved_name(part: str) -> bool {
    let mut base = part
    for i in 0..len(part) {
        if part[i] == "." { base = slice(part, 0, i) break }
    }
    let low = lsp_ascii_lower(base)
    if low == "con" or low == "prn" or low == "aux" or low == "nul" { return true }
    if len(low) == 4 {
        let pref = slice(low, 0, 3)
        let d = ord(low[3])
        if (pref == "com" or pref == "lpt") and d >= 49 and d <= 57 { return true }
    }
    return false
}

fn pkg_safe_path(value: str, subcmd: str, json_mode: bool) -> str {
    let raw_bytes = bytes(value)
    if len(value) == 0 or len(raw_bytes) > 255 {
        pkg_fail(subcmd, json_mode, "W5002", "invalid package path or path longer than 255 UTF-8 bytes")
    }
    for i in 0..len(value) {
        let ch = value[i]
        let c = ord(ch)
        if c < 32 or c == 127 or ch == "<" or ch == ">" or ch == ":" or ch == "\"" or ch == "\\" or ch == "|" or ch == "?" or ch == "*" {
            pkg_fail(subcmd, json_mode, "W5002", "package paths must use portable characters and / separators")
        }
    }
    let n = len(value)
    let mut start = 0
    for i in 0..(n + 1) {
        if i == n or value[i] == "/" {
            let part = slice(value, start, i)
            if part == "" or part == "." or part == ".." {
                pkg_fail(subcmd, json_mode, "W5002", "package paths must not contain empty, dot, or trailing dot/space components")
            }
            let last_ch = part[len(part) - 1]
            if last_ch == " " or last_ch == "." {
                pkg_fail(subcmd, json_mode, "W5002", "package paths must not contain empty, dot, or trailing dot/space components")
            }
            if len(bytes(part)) > 100 or pkg_is_reserved_name(part) {
                pkg_fail(subcmd, json_mode, "W5002", "package path component is reserved or exceeds 100 UTF-8 bytes")
            }
            start = i + 1
        }
    }
    return value
}

fn pkg_path_key(path: str, subcmd: str, json_mode: bool) -> str {
    let inp = tool_buf_from_str(path)
    let out = wysna_host_buffer_new()
    let sz = wysna_host_project_path_key(inp, out)
    wysna_host_close(inp)
    if sz < 0 {
        wysna_host_close(out)
        pkg_fail(subcmd, json_mode, "W5002", "invalid UTF-8 package path: " + path)
    }
    let res = lsp_buf_to_str(out, sz)
    wysna_host_close(out)
    return res
}

fn pkg_validate_inventory(paths: list[str], subcmd: str, json_mode: bool) -> unit {
    if len(paths) == 0 or len(paths) > 4096 or not tool_str_contains(paths, "wysna.toml") {
        pkg_fail(subcmd, json_mode, "W5002", "a package requires wysna.toml and at most 4096 files")
    }
    let mut files_map: dict[str, bool] = {}
    for p in paths {
        let seen = files_map.get(p) else { false }
        if seen { pkg_fail(subcmd, json_mode, "W5002", "duplicate package path") }
        files_map[p] = true
    }
    let mut components: dict[str, str] = {}
    for p in paths {
        pkg_safe_path(p, subcmd, json_mode)
        let n = len(p)
        for i in 0..(n + 1) {
            if i == n or p[i] == "/" {
                let comp = slice(p, 0, i)
                let key = pkg_path_key(comp, subcmd, json_mode)
                let existing = components.get(key) else { "" }
                if existing != "" and existing != comp {
                    pkg_fail(subcmd, json_mode, "W5002", "package paths collide on portable filesystems")
                }
                components[key] = comp
                if i < n {
                    let is_file = files_map.get(comp) else { false }
                    if is_file { pkg_fail(subcmd, json_mode, "W5002", "a package path is both a file and a directory") }
                }
            }
        }
    }
}

fn pkg_cache_dir(explicit: str) -> str {
    if explicit != "" { return proj_abs_from_cwd(explicit) }
    let conf = env("WYSNA_PACKAGE_CACHE_HOME") ?? ""
    if conf != "" { return proj_abs_from_cwd(conf) }
    let xdg = env("XDG_CACHE_HOME") ?? ""
    if xdg != "" { return module_normalize(xdg + "/wysna/packages-v1") }
    let home = env("HOME") ?? ""
    if home != "" { return module_normalize(home + "/.cache/wysna/packages-v1") }
    let local_app = env("LOCALAPPDATA") ?? ""
    if local_app != "" { return module_normalize(local_app + "/Wysna/packages-v1") }
    return proj_abs_from_cwd(".wysna_cache/packages-v1")
}

fn pkg_dirname(path: str) -> str {
    let norm = module_normalize(path)
    let mut last = -1
    for i in 0..len(norm) { if norm[i] == "/" { last = i } }
    if last < 0 { return "" }
    if last == 0 { return "/" }
    return slice(norm, 0, last)
}

fn pkg_mkdir_p(dir_path: str) -> bool {
    let norm = module_normalize(dir_path)
    if norm == "" or norm == "/" { return true }
    if len(norm) == 2 and norm[1] == ":" { return true }
    if proj_is_dir(norm) { return true }
    let parent = pkg_dirname(norm)
    if parent != norm and parent != "" {
        if not pkg_mkdir_p(parent) { return false }
    }
    let st = proj_scaffold_fs(norm, 2)
    return st == 0 or proj_is_dir(norm)
}

fn pkg_buf_sha256_hex(buf: opaque) -> str {
    let out = wysna_host_buffer_new()
    let st = wysna_host_crypto_sha256(buf, out)
    let mut parts: list[str] = []
    if st == 0 {
        for i in 0..32 {
            let v = wysna_host_buffer_get(out, i)
            parts.append(diag_hex_digit((v / 16) % 16) + diag_hex_digit(v % 16))
        }
    }
    wysna_host_close(out)
    return join_strings(parts, "")
}

fn pkg_buf_slice_sha256_hex(buf: opaque, off: int, size: int) -> str {
    let sub = wysna_host_buffer_new()
    for i in 0..size { wysna_host_buffer_append(sub, wysna_host_buffer_get(buf, off + i)) }
    let hex = pkg_buf_sha256_hex(sub)
    wysna_host_close(sub)
    return hex
}

fn pkg_read_file_buf(path: str, max_bytes: int, subcmd: str, json_mode: bool, too_big_code: str, too_big_msg: str) -> opaque {
    let p_buf = tool_buf_from_str(path)
    let fh = wysna_host_file_open(p_buf, 0)
    wysna_host_close(p_buf)
    if wysna_host_is_open(fh) != 1 {
        pkg_fail(subcmd, json_mode, "W5004", "cannot read file: " + path)
    }
    let out = wysna_host_buffer_new()
    let chunk = wysna_host_buffer_new()
    let mut total = 0
    while true {
        let got = wysna_host_file_read(fh, chunk, 1048576)
        if got < 0 {
            wysna_host_close(chunk) wysna_host_close(out) wysna_host_close(fh)
            pkg_fail(subcmd, json_mode, "W5004", "failed reading file: " + path)
        }
        if got == 0 { break }
        total = total + got
        if total > max_bytes {
            wysna_host_close(chunk) wysna_host_close(out) wysna_host_close(fh)
            pkg_fail(subcmd, json_mode, too_big_code, too_big_msg)
        }
        for i in 0..got { wysna_host_buffer_append(out, wysna_host_buffer_get(chunk, i)) }
    }
    wysna_host_close(chunk)
    wysna_host_close(fh)
    return out
}

fn pkg_write_buf_atomic(dest: str, buf: opaque, subcmd: str, json_mode: bool) -> unit {
    let parent = pkg_dirname(dest)
    if parent != "" and not pkg_mkdir_p(parent) {
        pkg_fail(subcmd, json_mode, "W5004", "cannot create directory: " + parent)
    }
    let tmp = parent + "/.wysna-package-" + diag_uuid4() + ".tmp"
    let p_buf = tool_buf_from_str(tmp)
    let fh = wysna_host_file_open(p_buf, 3)
    wysna_host_close(p_buf)
    if wysna_host_is_open(fh) != 1 {
        pkg_fail(subcmd, json_mode, "W5004", "cannot create temporary file: " + tmp)
    }
    let wrote = wysna_host_file_write(fh, buf)
    wysna_host_close(fh)
    if wrote < 0 {
        lsp_remove_file(tmp)
        pkg_fail(subcmd, json_mode, "W5004", "cannot write temporary file: " + tmp)
    }
    let f1 = tool_buf_from_str(tmp)
    let f2 = tool_buf_from_str(dest)
    let st = wysna_host_fs(f1, f2, 4)
    wysna_host_close(f1)
    wysna_host_close(f2)
    if st != 0 {
        lsp_remove_file(tmp)
        pkg_fail(subcmd, json_mode, "W5004", "cannot replace target file: " + dest)
    }
}

fn pkg_entry_kind(parent: str, child: str) -> str {
    let p_buf = tool_buf_from_str(parent)
    let out = wysna_host_buffer_new()
    let sz = wysna_host_project_entries(p_buf, out)
    wysna_host_close(p_buf)
    if sz <= 0 { wysna_host_close(out) return "" }
    let entries = lsp_buf_to_str(out, sz)
    wysna_host_close(out)
    let mut i = 0
    while i < len(entries) {
        let kind = entries[i]
        i = i + 1
        let start = i
        while i < len(entries) and ord(entries[i]) != 0 { i = i + 1 }
        let name = slice(entries, start, i)
        i = i + 1
        if name == child { return kind }
    }
    return ""
}

fn pkg_remove_tree(path: str) -> unit {
    let p_buf = tool_buf_from_str(path)
    let out = wysna_host_buffer_new()
    let sz = wysna_host_project_entries(p_buf, out)
    wysna_host_close(p_buf)
    if sz > 0 {
        let entries = lsp_buf_to_str(out, sz)
        let mut i = 0
        while i < len(entries) {
            let kind = entries[i]
            i = i + 1
            let start = i
            while i < len(entries) and ord(entries[i]) != 0 { i = i + 1 }
            let name = slice(entries, start, i)
            i = i + 1
            let full = path + "/" + name
            if kind == "d" { pkg_remove_tree(full) } else { lsp_remove_file(full) }
        }
    }
    wysna_host_close(out)
    lsp_remove_file(path)
}

# ---- Canonical USTAR v1 encoder & strict validator ----

fn pkg_write_octal(hdr: list[int], off: int, digits: int, val: int) -> list[int] {
    let mut out = hdr
    let mut v = val
    let mut pos = off + digits - 1
    while pos >= off {
        out[pos] = 48 + (v % 8)
        v = v / 8
        pos = pos - 1
    }
    return out
}

fn pkg_make_ustar_header(rel_path: str, size: int) -> list[int] {
    let mut hdr: list[int] = []
    for _i in 0..512 { hdr.append(0) }
    let raw = bytes(rel_path)
    let mut name_b: list[int] = raw
    let mut pref_b: list[int] = []
    if len(raw) > 100 {
        let mut split = -1
        for i in 0..len(raw) {
            if raw[i] == 47 and i <= 155 and (len(raw) - i - 1) <= 100 { split = i }
        }
        if split >= 0 {
            let mut nb: list[int] = []
            let mut pb: list[int] = []
            for i in 0..split { pb.append(raw[i]) }
            for i in (split + 1)..len(raw) { nb.append(raw[i]) }
            pref_b = pb
            name_b = nb
        }
    }
    for i in 0..len(name_b) { hdr[i] = name_b[i] }
    # mode 0000644\0, uid 0000000\0, gid 0000000\0, size 11 octal\0, mtime 00000000000\0
    hdr = pkg_write_octal(hdr, 100, 7, 420)
    hdr = pkg_write_octal(hdr, 108, 7, 0)
    hdr = pkg_write_octal(hdr, 116, 7, 0)
    hdr = pkg_write_octal(hdr, 124, 11, size)
    hdr = pkg_write_octal(hdr, 136, 11, 0)
    for i in 148..156 { hdr[i] = 32 }
    hdr[156] = 48
    let magic = bytes("ustar")
    for i in 0..5 { hdr[257 + i] = magic[i] }
    hdr[263] = 48
    hdr[264] = 48
    for i in 0..len(pref_b) { hdr[345 + i] = pref_b[i] }
    let mut chksum = 0
    for b in hdr { chksum = chksum + b }
    hdr = pkg_write_octal(hdr, 148, 6, chksum)
    hdr[154] = 0
    hdr[155] = 32
    return hdr
}

fn pkg_parse_octal(buf: opaque, off: int, width: int) -> int {
    let mut i = off
    let end = off + width
    while i < end and (wysna_host_buffer_get(buf, i) == 32 or wysna_host_buffer_get(buf, i) == 0) { i = i + 1 }
    if i == end { return 0 }
    let mut val = 0
    while i < end {
        let b = wysna_host_buffer_get(buf, i)
        if b == 0 or b == 32 { break }
        if b < 48 or b > 55 { return -1 }
        val = val * 8 + (b - 48)
        i = i + 1
    }
    return val
}

fn pkg_decode_utf8_field(buf: opaque, off: int, cap: int, subcmd: str, json_mode: bool) -> str {
    let mut n = 0
    while n < cap and wysna_host_buffer_get(buf, off + n) != 0 { n = n + 1 }
    if n == 0 { return "" }
    let sub = wysna_host_buffer_new()
    for i in 0..n { wysna_host_buffer_append(sub, wysna_host_buffer_get(buf, off + i)) }
    let res = lsp_buf_to_str(sub, n)
    wysna_host_close(sub)
    if len(bytes(res)) != n {
        pkg_fail(subcmd, json_mode, "W5002", "invalid UTF-8 in package archive header")
    }
    return res
}

fn pkg_inspect_archive(raw_buf: opaque, subcmd: str, json_mode: bool) -> list[PkgEntry] {
    let total_len = wysna_host_buffer_size(raw_buf)
    if total_len <= 0 or total_len > 41943040 or (total_len % 512) != 0 {
        pkg_fail(subcmd, json_mode, "W5002", "invalid package archive size (maximum 40 MiB)")
    }
    let mut entries: list[PkgEntry] = []
    let mut names: list[str] = []
    let mut total_payload = 0
    let mut off = 0
    while off < total_len {
        let mut all_zero = true
        for k in 0..512 {
            if wysna_host_buffer_get(raw_buf, off + k) != 0 { all_zero = false break }
        }
        if all_zero {
            for rest in off..total_len {
                if wysna_host_buffer_get(raw_buf, rest) != 0 {
                    pkg_fail(subcmd, json_mode, "W5002", "package archive is not canonical USTAR v1")
                }
            }
            break
        }
        let tf = wysna_host_buffer_get(raw_buf, off + 156)
        if tf != 48 and tf != 0 {
            pkg_fail(subcmd, json_mode, "W5002", "packages contain only regular USTAR files")
        }
        let stored_sum = pkg_parse_octal(raw_buf, off + 148, 8)
        let mut calc_sum = 0
        for k in 0..512 {
            calc_sum = calc_sum + (if k >= 148 and k < 156 { 32 } else { wysna_host_buffer_get(raw_buf, off + k) })
        }
        if stored_sum < 0 or stored_sum != calc_sum {
            pkg_fail(subcmd, json_mode, "W5002", "invalid package archive checksum")
        }
        let size = pkg_parse_octal(raw_buf, off + 124, 12)
        if size < 0 or size > 8388608 {
            pkg_fail(subcmd, json_mode, "W5002", "package file exceeds 8 MiB")
        }
        total_payload = total_payload + size
        if total_payload > 33554432 or len(entries) >= 4096 {
            pkg_fail(subcmd, json_mode, "W5002", "package exceeds 32 MiB or 4096 files")
        }
        let name_part = pkg_decode_utf8_field(raw_buf, off, 100, subcmd, json_mode)
        let pref_part = pkg_decode_utf8_field(raw_buf, off + 345, 155, subcmd, json_mode)
        let full_name = if pref_part != "" { pref_part + "/" + name_part } else { name_part }
        pkg_safe_path(full_name, subcmd, json_mode)
        let data_off = off + 512
        let padded = if (size % 512) == 0 { size } else { size + (512 - (size % 512)) }
        if data_off + padded > total_len {
            pkg_fail(subcmd, json_mode, "W5002", "truncated package content")
        }
        # Verify exact canonical USTAR v1 header + zero padding
        let canon_hdr = pkg_make_ustar_header(full_name, size)
        for k in 0..512 {
            if wysna_host_buffer_get(raw_buf, off + k) != canon_hdr[k] {
                pkg_fail(subcmd, json_mode, "W5002", "package archive is not canonical USTAR v1")
            }
        }
        for k in size..padded {
            if wysna_host_buffer_get(raw_buf, data_off + k) != 0 {
                pkg_fail(subcmd, json_mode, "W5002", "package archive is not canonical USTAR v1")
            }
        }
        if len(names) > 0 and tool_str_gt(names[len(names) - 1], full_name) {
            pkg_fail(subcmd, json_mode, "W5002", "package archive is not canonical USTAR v1")
        }
        names.append(full_name)
        entries.append(PkgEntry { path: full_name, offset: data_off, size: size })
        off = data_off + padded
    }
    pkg_validate_inventory(names, subcmd, json_mode)
    let eof_end = off + 1024
    let expected_total = if (eof_end % 10240) == 0 { eof_end } else { eof_end + (10240 - (eof_end % 10240)) }
    if total_len != expected_total {
        pkg_fail(subcmd, json_mode, "W5002", "package archive is not canonical USTAR v1")
    }
    return entries
}

fn pkg_walk_dir_files(dir: str, rel: str, subcmd: str, json_mode: bool) -> list[str] {
    let cur = if rel == "" { dir } else { dir + "/" + rel }
    let p_buf = tool_buf_from_str(cur)
    let out = wysna_host_buffer_new()
    let sz = wysna_host_project_entries(p_buf, out)
    wysna_host_close(p_buf)
    if sz < 0 {
        wysna_host_close(out)
        pkg_fail(subcmd, json_mode, "W5005", "managed dependency differs from its pin; preserve it outside vendor before retrying")
    }
    let entries = if sz > 0 { lsp_buf_to_str(out, sz) } else { "" }
    wysna_host_close(out)
    let mut files: list[str] = []
    let mut i = 0
    while i < len(entries) {
        let kind = entries[i]
        i = i + 1
        let start = i
        while i < len(entries) and ord(entries[i]) != 0 { i = i + 1 }
        let name = slice(entries, start, i)
        i = i + 1
        let child_rel = if rel == "" { name } else { rel + "/" + name }
        if kind == "l" or kind == "o" {
            pkg_fail(subcmd, json_mode, "W5005", "managed dependency differs from its pin; preserve it outside vendor before retrying")
        } elif kind == "d" {
            for nested in pkg_walk_dir_files(dir, child_rel, subcmd, json_mode) { files.append(nested) }
        } elif kind == "f" {
            files.append(child_rel)
        }
    }
    return files
}

fn pkg_materialize(root: str, digest: str, raw_buf: opaque, entries: list[PkgEntry], subcmd: str, json_mode: bool) -> bool {
    let vendor = root + "/vendor"
    if pkg_entry_kind(root, "vendor") == "l" {
        pkg_fail(subcmd, json_mode, "W5002", "package vendor directory must not be a symlink")
    }
    if not pkg_mkdir_p(vendor) {
        pkg_fail(subcmd, json_mode, "W5004", "cannot create package vendor directory")
    }
    let dest = vendor + "/" + digest
    let existing_kind = pkg_entry_kind(vendor, digest)
    if existing_kind != "" {
        if existing_kind != "d" {
            pkg_fail(subcmd, json_mode, "W5005", "managed dependency destination is not a regular directory")
        }
        let actual = tool_sort_strings(pkg_walk_dir_files(dest, "", subcmd, json_mode))
        if len(actual) != len(entries) {
            pkg_fail(subcmd, json_mode, "W5005", "managed dependency differs from its pin; preserve it outside vendor before retrying")
        }
        for idx in 0..len(entries) {
            if actual[idx] != entries[idx].path {
                pkg_fail(subcmd, json_mode, "W5005", "managed dependency differs from its pin; preserve it outside vendor before retrying")
            }
            let disk_buf = pkg_read_file_buf(dest + "/" + actual[idx], 8388608, subcmd, json_mode, "W5005", "managed dependency differs from its pin; preserve it outside vendor before retrying")
            let dsz = wysna_host_buffer_size(disk_buf)
            let mut same = dsz == entries[idx].size
            if same {
                for b in 0..dsz {
                    if wysna_host_buffer_get(disk_buf, b) != wysna_host_buffer_get(raw_buf, entries[idx].offset + b) {
                        same = false
                        break
                    }
                }
            }
            wysna_host_close(disk_buf)
            if not same {
                pkg_fail(subcmd, json_mode, "W5005", "managed dependency differs from its pin; preserve it outside vendor before retrying")
            }
        }
        return false
    }
    let outer = vendor + "/.wysna-package-" + diag_uuid4()
    let stage = outer + "/content"
    if not pkg_mkdir_p(stage) {
        pkg_fail(subcmd, json_mode, "W5004", "cannot create package staging directory")
    }
    for entry in entries {
        let target = stage + "/" + entry.path
        let parent = pkg_dirname(target)
        if not pkg_mkdir_p(parent) {
            pkg_remove_tree(outer)
            pkg_fail(subcmd, json_mode, "W5004", "cannot create directory in staging")
        }
        let fbuf = wysna_host_buffer_new()
        for k in 0..entry.size { wysna_host_buffer_append(fbuf, wysna_host_buffer_get(raw_buf, entry.offset + k)) }
        let p_buf = tool_buf_from_str(target)
        let fh = wysna_host_file_open(p_buf, 3)
        wysna_host_close(p_buf)
        if wysna_host_is_open(fh) != 1 {
            wysna_host_close(fbuf)
            pkg_remove_tree(outer)
            pkg_fail(subcmd, json_mode, "W5004", "cannot write staged package file")
        }
        let wrote = wysna_host_file_write(fh, fbuf)
        wysna_host_close(fh)
        wysna_host_close(fbuf)
        if wrote < 0 {
            pkg_remove_tree(outer)
            pkg_fail(subcmd, json_mode, "W5004", "failed writing staged package file")
        }
    }
    let staged_m = proj_parse_manifest_at(stage + "/wysna.toml", [])
    if not staged_m.ok {
        pkg_remove_tree(outer)
        pkg_fail(subcmd, json_mode, "W5002", "invalid package manifest: " + staged_m.err_msg)
    }
    if pkg_entry_kind(vendor, digest) != "" {
        pkg_remove_tree(outer)
        pkg_fail(subcmd, json_mode, "W5005", "managed dependency destination changed during acquisition")
    }
    let f1 = tool_buf_from_str(stage)
    let f2 = tool_buf_from_str(dest)
    let st = wysna_host_fs(f1, f2, 4)
    wysna_host_close(f1)
    wysna_host_close(f2)
    pkg_remove_tree(outer)
    if st != 0 {
        pkg_fail(subcmd, json_mode, "W5004", "cannot publish materialized package directory")
    }
    return true
}

fn pkg_is_file(path: str) -> bool {
    return proj_scaffold_fs(path, 6) == 1
}

fn pkg_acquire_archive(digest: str, archive_path: str, cache_arg: str, subcmd: str, json_mode: bool) -> opaque {
    if not pkg_is_hex64(digest) {
        pkg_fail(subcmd, json_mode, "W5002", "package --sha256 requires 64 lowercase hexadecimal digits")
    }
    let cache_dir = pkg_cache_dir(cache_arg)
    let cached = cache_dir + "/" + digest + ".tar"
    let source = if archive_path != "" { proj_abs_from_cwd(archive_path) } else { cached }
    if not pkg_is_file(source) {
        pkg_fail(subcmd, json_mode, "W5004", "pinned package is unavailable; supply --archive or populate --cache: " + source)
    }
    let raw_buf = pkg_read_file_buf(source, 41943040, subcmd, json_mode, "W5002", "package archive exceeds 40 MiB")
    let actual_sha = pkg_buf_sha256_hex(raw_buf)
    if actual_sha != digest {
        wysna_host_close(raw_buf)
        pkg_fail(subcmd, json_mode, "W5005", "package SHA-256 does not match the requested pin")
    }
    let _entries = pkg_inspect_archive(raw_buf, subcmd, json_mode)
    if module_normalize(source) != module_normalize(cached) {
        if proj_path_exists(cached) {
            if not pkg_is_file(cached) {
                wysna_host_close(raw_buf)
                pkg_fail(subcmd, json_mode, "W5005", "package cache entry is corrupt; remove it before retrying")
            }
            let c_buf = pkg_read_file_buf(cached, 41943040, subcmd, json_mode, "W5005", "package cache entry is corrupt; remove it before retrying")
            let c_sha = pkg_buf_sha256_hex(c_buf)
            wysna_host_close(c_buf)
            if c_sha != digest {
                wysna_host_close(raw_buf)
                pkg_fail(subcmd, json_mode, "W5005", "package cache entry is corrupt; remove it before retrying")
            }
        } else {
            pkg_write_buf_atomic(cached, raw_buf, subcmd, json_mode)
        }
    }
    return raw_buf
}

fn pkg_update_dependency(manifest_path: str, alias: str, relative: str, is_add: bool, expected_sha: str, subcmd: str, json_mode: bool) -> bool {
    if not pkg_is_valid_alias(alias) {
        pkg_fail(subcmd, json_mode, "W5002", "dependency alias requires lowercase letters, digits and hyphens")
    }
    let orig_buf = pkg_read_file_buf(manifest_path, 8388608, subcmd, json_mode, "W5002", "manifest exceeds 8 MiB")
    let orig_sha = pkg_buf_sha256_hex(orig_buf)
    wysna_host_close(orig_buf)
    if expected_sha != "" and orig_sha != expected_sha {
        pkg_fail(subcmd, json_mode, "W5005", "manifest precondition failed; read the current manifest before retrying")
    }
    let text = read_file(manifest_path) else err {
        pkg_fail(subcmd, json_mode, "W5004", "cannot read manifest: " + err.message)
        ""
    }
    let m = proj_parse_manifest_at(manifest_path, [])
    if not m.ok { pkg_fail(subcmd, json_mode, m.err_code, m.err_msg) }
    let mut existing_root = ""
    for dep in m.deps {
        if dep.alias == alias { existing_root = dep.abs_root }
    }
    let section = "[dependencies." + alias + "]"
    let mut updated = ""
    if is_add {
        if existing_root != "" {
            if module_normalize(existing_root) == module_normalize(m.root + "/" + relative) { return false }
            pkg_fail(subcmd, json_mode, "W5005", "dependency alias already exists with another path")
        }
        let mut trimmed_end = len(text)
        while trimmed_end > 0 and (text[trimmed_end - 1] == "\n" or text[trimmed_end - 1] == "\r" or text[trimmed_end - 1] == " " or text[trimmed_end - 1] == "\t") {
            trimmed_end = trimmed_end - 1
        }
        updated = slice(text, 0, trimmed_end) + "\n\n" + section + "\npath = " + diag_json_quote(relative) + "\n"
    } else {
        if existing_root == "" { pkg_fail(subcmd, json_mode, "W5002", "unknown dependency alias: " + alias) }
        let lines = schema_split_lines(text)
        let mut starts: list[int] = []
        for idx in 0..len(lines) {
            if lsp_trim(proj_strip_toml_comment(lines[idx])) == section { starts.append(idx) }
        }
        if len(starts) != 1 {
            pkg_fail(subcmd, json_mode, "W5002", "remove requires an explicit [dependencies.ALIAS] table; edit other TOML forms explicitly")
        }
        let start = starts[0]
        let mut end_idx = len(lines)
        for idx in (start + 1)..len(lines) {
            let t = lsp_trim(lines[idx])
            if len(t) > 0 and t[0] == "[" { end_idx = idx break }
        }
        let mut kept: list[str] = []
        for idx in 0..start { kept.append(lines[idx]) }
        for idx in end_idx..len(lines) { kept.append(lines[idx]) }
        updated = join_strings(kept, "\n")
        if len(updated) > 0 and updated[len(updated) - 1] != "\n" { updated = updated + "\n" }
    }
    let tmp = m.root + "/.wysna-manifest-" + diag_uuid4() + ".toml"
    let ubuf = tool_buf_from_str(updated)
    let tp = tool_buf_from_str(tmp)
    let fh = wysna_host_file_open(tp, 3)
    wysna_host_close(tp)
    if wysna_host_is_open(fh) != 1 {
        wysna_host_close(ubuf)
        pkg_fail(subcmd, json_mode, "W5004", "cannot stage updated manifest")
    }
    let w_st = wysna_host_file_write(fh, ubuf)
    wysna_host_close(fh)
    wysna_host_close(ubuf)
    if w_st < 0 { lsp_remove_file(tmp) pkg_fail(subcmd, json_mode, "W5004", "cannot write staged manifest") }
    let check_m = proj_parse_manifest_at(tmp, [])
    if not check_m.ok { lsp_remove_file(tmp) pkg_fail(subcmd, json_mode, check_m.err_code, check_m.err_msg) }
    let now_buf = pkg_read_file_buf(manifest_path, 8388608, subcmd, json_mode, "W5004", "cannot re-read manifest")
    let now_sha = pkg_buf_sha256_hex(now_buf)
    wysna_host_close(now_buf)
    if now_sha != orig_sha {
        lsp_remove_file(tmp)
        pkg_fail(subcmd, json_mode, "W5005", "manifest changed during dependency update")
    }
    let f1 = tool_buf_from_str(tmp)
    let f2 = tool_buf_from_str(manifest_path)
    let r_st = wysna_host_fs(f1, f2, 4)
    wysna_host_close(f1)
    wysna_host_close(f2)
    if r_st != 0 { lsp_remove_file(tmp) pkg_fail(subcmd, json_mode, "W5004", "cannot replace manifest") }
    return true
}

fn pkg_cmd_pack(args: list[str], json_mode: bool) -> unit {
    let mut manifest_arg = ""
    let mut output_arg = ""
    let mut i = 2
    while i < len(args) {
        let a = args[i]
        if a == "--output-format=json-v1" { i = i + 1 }
        elif a == "--output-format" and i + 1 < len(args) { i = i + 2 }
        elif a == "--manifest" and i + 1 < len(args) { manifest_arg = args[i + 1] i = i + 2 }
        elif (a == "-o" or a == "--output") and i + 1 < len(args) { output_arg = args[i + 1] i = i + 2 }
        else { pkg_fail("pack", json_mode, "W5002", "unknown option for packages pack: " + a) }
    }
    if output_arg == "" { pkg_fail("pack", json_mode, "W5002", "packages pack requires -o OUTPUT") }
    let m = proj_load_manifest(manifest_arg)
    if not m.ok { pkg_fail("pack", json_mode, m.err_code, m.err_msg) }
    let state = ProjectLockState("pack", json_mode, m.root)
    let paths = tool_sort_strings(proj_lock_paths(state, m.root, "", false))
    pkg_validate_inventory(paths, "pack", json_mode)
    let out_buf = wysna_host_buffer_new()
    let mut total_payload = 0
    for rel in paths {
        let full = m.root + "/" + rel
        let expected_sha = proj_lock_host_text(state, full, "hash")
        let fbuf = pkg_read_file_buf(full, 8388608, "pack", json_mode, "W5005", "package input changed or exceeds 8 MiB: " + rel)
        let fsize = wysna_host_buffer_size(fbuf)
        if pkg_buf_sha256_hex(fbuf) != expected_sha {
            wysna_host_close(fbuf) wysna_host_close(out_buf)
            pkg_fail("pack", json_mode, "W5005", "package input changed or exceeds 8 MiB: " + rel)
        }
        total_payload = total_payload + fsize
        if total_payload > 33554432 {
            wysna_host_close(fbuf) wysna_host_close(out_buf)
            pkg_fail("pack", json_mode, "W5002", "package inputs exceed 32 MiB")
        }
        let hdr = pkg_make_ustar_header(rel, fsize)
        for b in hdr { wysna_host_buffer_append(out_buf, b) }
        for k in 0..fsize { wysna_host_buffer_append(out_buf, wysna_host_buffer_get(fbuf, k)) }
        wysna_host_close(fbuf)
        let pad = (512 - (fsize % 512)) % 512
        for _p in 0..pad { wysna_host_buffer_append(out_buf, 0) }
    }
    for _z in 0..1024 { wysna_host_buffer_append(out_buf, 0) }
    let cur_sz = wysna_host_buffer_size(out_buf)
    let rem = (10240 - (cur_sz % 10240)) % 10240
    for _r in 0..rem { wysna_host_buffer_append(out_buf, 0) }
    let archive_sha = pkg_buf_sha256_hex(out_buf)
    let archive_sz = wysna_host_buffer_size(out_buf)
    let dest = proj_abs_from_cwd(output_arg)
    pkg_write_buf_atomic(dest, out_buf, "pack", json_mode)
    wysna_host_close(out_buf)
    if json_mode {
        let res = "{\"schema_version\":\"wysna.package-pack/1\",\"archive_sha256\":" + diag_json_quote(archive_sha) + ",\"path\":" + diag_json_quote(dest) + ",\"size_bytes\":" + str(archive_sz) + ",\"files\":" + str(len(paths)) + "}"
        let art = "[{\"kind\":\"package_archive\",\"media_type\":\"application/x-tar\",\"path\":" + diag_json_quote(dest) + ",\"size_bytes\":" + str(archive_sz) + ",\"sha256\":" + diag_json_quote(archive_sha) + "}]"
        diag_write_output(diag_tool_envelope_json("packages.pack", "ok", 0, "[]", "result", res, art))
    } else {
        print("[OK] Packed " + str(len(paths)) + " files -> " + dest + " (" + archive_sha + ")")
    }
    exit(0)
}

fn pkg_cmd_fetch(args: list[str], json_mode: bool) -> unit {
    let mut digest = ""
    let mut archive = ""
    let mut cache_arg = ""
    let mut manifest_arg = ""
    let mut root_arg = ""
    let mut i = 2
    while i < len(args) {
        let a = args[i]
        if a == "--output-format=json-v1" { i = i + 1 }
        elif a == "--output-format" and i + 1 < len(args) { i = i + 2 }
        elif a == "--sha256" and i + 1 < len(args) { digest = args[i + 1] i = i + 2 }
        elif a == "--archive" and i + 1 < len(args) { archive = args[i + 1] i = i + 2 }
        elif a == "--cache" and i + 1 < len(args) { cache_arg = args[i + 1] i = i + 2 }
        elif a == "--manifest" and i + 1 < len(args) { manifest_arg = args[i + 1] i = i + 2 }
        elif a == "--root" and i + 1 < len(args) { root_arg = args[i + 1] i = i + 2 }
        else { pkg_fail("fetch", json_mode, "W5002", "unknown option for packages fetch: " + a) }
    }
    if digest == "" { pkg_fail("fetch", json_mode, "W5002", "packages fetch requires --sha256 DIGEST") }
    let mut root = ""
    if root_arg != "" {
        root = proj_abs_from_cwd(root_arg)
    } else {
        let m = proj_load_manifest(manifest_arg)
        if not m.ok { pkg_fail("fetch", json_mode, m.err_code, m.err_msg) }
        root = m.root
    }
    let raw_buf = pkg_acquire_archive(digest, archive, cache_arg, "fetch", json_mode)
    let entries = pkg_inspect_archive(raw_buf, "fetch", json_mode)
    let created = pkg_materialize(root, digest, raw_buf, entries, "fetch", json_mode)
    wysna_host_close(raw_buf)
    let cached = pkg_cache_dir(cache_arg) + "/" + digest + ".tar"
    let dest = root + "/vendor/" + digest
    if json_mode {
        let res = "{\"schema_version\":\"wysna.package-fetch/1\",\"archive_sha256\":" + diag_json_quote(digest) + ",\"cache\":" + diag_json_quote(cached) + ",\"path\":" + diag_json_quote(dest) + ",\"created\":" + (if created { "true" } else { "false" }) + ",\"files\":" + str(len(entries)) + "}"
        diag_write_output(diag_tool_envelope_json("packages.fetch", "ok", 0, "[]", "result", res, "[]"))
    } else {
        print("[OK] Fetched " + digest + " -> " + dest)
    }
    exit(0)
}

fn pkg_cmd_add_or_remove(args: list[str], is_add: bool, json_mode: bool) -> unit {
    let sub = if is_add { "add" } else { "remove" }
    let mut alias = ""
    let mut digest = ""
    let mut archive = ""
    let mut cache_arg = ""
    let mut rel_path = ""
    let mut manifest_arg = ""
    let mut expect_sha = ""
    let mut i = 2
    while i < len(args) {
        let a = args[i]
        if a == "--output-format=json-v1" { i = i + 1 }
        elif a == "--output-format" and i + 1 < len(args) { i = i + 2 }
        elif a == "--manifest" and i + 1 < len(args) { manifest_arg = args[i + 1] i = i + 2 }
        elif a == "--expect-manifest-sha256" and i + 1 < len(args) { expect_sha = args[i + 1] i = i + 2 }
        elif is_add and a == "--sha256" and i + 1 < len(args) { digest = args[i + 1] i = i + 2 }
        elif is_add and a == "--archive" and i + 1 < len(args) { archive = args[i + 1] i = i + 2 }
        elif is_add and a == "--cache" and i + 1 < len(args) { cache_arg = args[i + 1] i = i + 2 }
        elif is_add and a == "--path" and i + 1 < len(args) { rel_path = args[i + 1] i = i + 2 }
        elif len(a) > 0 and a[0] != "-" and alias == "" { alias = a i = i + 1 }
        else { pkg_fail(sub, json_mode, "W5002", "unknown option for packages " + sub + ": " + a) }
    }
    if alias == "" { pkg_fail(sub, json_mode, "W5002", "packages " + sub + " requires ALIAS") }
    let found = proj_find_manifest_path(manifest_arg)
    if found[0] != "1" { pkg_fail(sub, json_mode, "W5002", found[1]) }
    let manifest_path = found[1]
    if is_add {
        if expect_sha != "" {
            let pre_buf = pkg_read_file_buf(manifest_path, 8388608, sub, json_mode, "W5002", "manifest exceeds 8 MiB")
            let pre_sha = pkg_buf_sha256_hex(pre_buf)
            wysna_host_close(pre_buf)
            if pre_sha != expect_sha {
                pkg_fail(sub, json_mode, "W5005", "manifest precondition failed; read the current manifest before retrying")
            }
        }
        if digest != "" {
            let m = proj_parse_manifest_at(manifest_path, [])
            if not m.ok { pkg_fail(sub, json_mode, m.err_code, m.err_msg) }
            let raw_buf = pkg_acquire_archive(digest, archive, cache_arg, sub, json_mode)
            let entries = pkg_inspect_archive(raw_buf, sub, json_mode)
            let _created = pkg_materialize(m.root, digest, raw_buf, entries, sub, json_mode)
            wysna_host_close(raw_buf)
            rel_path = "vendor/" + digest
        }
        if rel_path == "" { pkg_fail(sub, json_mode, "W5002", "packages add requires --sha256 DIGEST or --path RELATIVE") }
    }
    let changed = pkg_update_dependency(manifest_path, alias, rel_path, is_add, expect_sha, sub, json_mode)
    if json_mode {
        let res = "{\"schema_version\":\"wysna.package-" + sub + "/1\",\"alias\":" + diag_json_quote(alias) + ",\"changed\":" + (if changed { "true" } else { "false" }) + (if is_add { ",\"path\":" + diag_json_quote(rel_path) } else { "" }) + "}"
        diag_write_output(diag_tool_envelope_json("packages." + sub, "ok", 0, "[]", "result", res, "[]"))
    } else {
        print("[OK] Updated dependencies in " + manifest_path + " (" + sub + " " + alias + ")")
    }
    exit(0)
}

fn pkg_cmd_restore(args: list[str], json_mode: bool) -> unit {
    let mut manifest_arg = ""
    let mut cache_arg = ""
    let mut i = 2
    while i < len(args) {
        let a = args[i]
        if a == "--output-format=json-v1" { i = i + 1 }
        elif a == "--output-format" and i + 1 < len(args) { i = i + 2 }
        elif a == "--manifest" and i + 1 < len(args) { manifest_arg = args[i + 1] i = i + 2 }
        elif a == "--cache" and i + 1 < len(args) { cache_arg = args[i + 1] i = i + 2 }
        else { pkg_fail("restore", json_mode, "W5002", "unknown option for packages restore: " + a) }
    }
    let found = proj_find_manifest_path(manifest_arg)
    if found[0] != "1" { pkg_fail("restore", json_mode, "W5002", found[1]) }
    let manifest_path = found[1]
    let root = pkg_dirname(manifest_path)
    let lock_path = root + "/wysna.lock"
    if not proj_is_readable_file(lock_path) {
        pkg_fail("restore", json_mode, "W5004", "lockfile not found: " + lock_path)
    }
    let lock_text = read_file(lock_path) else err {
        pkg_fail("restore", json_mode, "W5004", "cannot read lockfile: " + err.message)
        ""
    }
    let lock = lsp_parse_json(lock_text)
    if lock.kind != "object" or lsp_json_int(lock, "lock_version", 0) != 1 {
        pkg_fail("restore", json_mode, "W5005", "lock does not match the current manifest; update it explicitly")
    }
    let mbuf = pkg_read_file_buf(manifest_path, 8388608, "restore", json_mode, "W5004", "cannot read manifest")
    let msha = pkg_buf_sha256_hex(mbuf)
    wysna_host_close(mbuf)
    let root_obj = lsp_json_get(lock, "root")
    if lsp_json_str(root_obj, "manifest_sha256", "") != msha {
        pkg_fail("restore", json_mode, "W5005", "lock does not match the current manifest; update it explicitly")
    }
    let deps_arr = lsp_json_get(lock, "dependencies")
    let aliases_arr = lsp_json_get(lock, "aliases")
    if deps_arr.kind != "array" or aliases_arr.kind != "array" {
        pkg_fail("restore", json_mode, "W5002", "invalid lockfile for package restoration")
    }
    let mut restored_json: list[str] = []
    for al in aliases_arr.items {
        let pid = lsp_json_str(al, "package_id", "")
        let mut found_dep = LspJson("null")
        for d in deps_arr.items {
            if lsp_json_str(d, "package_id", "") == pid { found_dep = d break }
        }
        if found_dep.kind != "object" {
            pkg_fail("restore", json_mode, "W5002", "invalid lockfile for package restoration")
        }
        let dpath = lsp_json_str(found_dep, "path", "")
        if len(dpath) == 71 and slice(dpath, 0, 7) == "vendor/" and pkg_is_hex64(slice(dpath, 7, 71)) {
            let digest = slice(dpath, 7, 71)
            let raw_buf = pkg_acquire_archive(digest, "", cache_arg, "restore", json_mode)
            let entries = pkg_inspect_archive(raw_buf, "restore", json_mode)
            let inputs_arr = lsp_json_get(found_dep, "inputs")
            if inputs_arr.kind != "array" or len(inputs_arr.items) != len(entries) {
                wysna_host_close(raw_buf)
                pkg_fail("restore", json_mode, "W5005", "package pin differs from locked input hashes")
            }
            for idx in 0..len(entries) {
                let row = inputs_arr.items[idx]
                let ep = lsp_json_str(row, "path", "")
                let es = lsp_json_str(row, "sha256", "")
                if ep != entries[idx].path or pkg_buf_slice_sha256_hex(raw_buf, entries[idx].offset, entries[idx].size) != es {
                    wysna_host_close(raw_buf)
                    pkg_fail("restore", json_mode, "W5005", "package pin differs from locked input hashes")
                }
            }
            let created = pkg_materialize(root, digest, raw_buf, entries, "restore", json_mode)
            wysna_host_close(raw_buf)
            let cached = pkg_cache_dir(cache_arg) + "/" + digest + ".tar"
            let dest = root + "/vendor/" + digest
            restored_json.append("{\"archive_sha256\":" + diag_json_quote(digest) + ",\"path\":" + diag_json_quote(dest) + ",\"cache\":" + diag_json_quote(cached) + ",\"created\":" + (if created { "true" } else { "false" }) + "}")
        } else {
            let safe_rel = pkg_safe_path(dpath, "restore", json_mode)
            if not proj_is_dir(root + "/" + safe_rel) {
                pkg_fail("restore", json_mode, "W5002", "local dependency cannot be restored from the package cache: " + dpath)
            }
        }
    }
    let verified = proj_parse_manifest_at(manifest_path, [])
    if not verified.ok { pkg_fail("restore", json_mode, verified.err_code, verified.err_msg) }
    proj_verify_lock(verified, "restore", json_mode)
    if json_mode {
        let res = "{\"schema_version\":\"wysna.package-restore/1\",\"packages\":[" + join_strings(restored_json, ",") + "]}"
        diag_write_output(diag_tool_envelope_json("packages.restore", "ok", 0, "[]", "result", res, "[]"))
    } else {
        print("[OK] Restored " + str(len(restored_json)) + " pinned package(s)")
    }
    exit(0)
}

fn tool_handle_packages(args: list[str], json_mode: bool) -> unit {
    if len(args) < 2 {
        pkg_fail("", json_mode, "W5002", "Usage: wysna packages <pack|fetch|add|remove|restore> [options]")
    }
    let sub = args[1]
    if sub == "pack" { pkg_cmd_pack(args, json_mode) return }
    if sub == "fetch" { pkg_cmd_fetch(args, json_mode) return }
    if sub == "add" { pkg_cmd_add_or_remove(args, true, json_mode) return }
    if sub == "remove" { pkg_cmd_add_or_remove(args, false, json_mode) return }
    if sub == "restore" { pkg_cmd_restore(args, json_mode) return }
    pkg_fail("", json_mode, "W5002", "unknown packages subcommand '" + sub + "'; expected pack, fetch, add, remove, or restore")
}
# Native standard-library and project API index generator (wysna.api-index/1).

class ApiParam {
    name: str
    type_text: str
    fn init(name: str, type_text: str) {
        this.name = name
        this.type_text = type_text
    }
}

class ApiField {
    name: str
    type_text: str
    fn init(name: str, type_text: str) {
        this.name = name
        this.type_text = type_text
    }
}

class ApiVariant {
    name: str
    payloads: list[str]
    fn init(name: str) {
        this.name = name
        let ps: list[str] = []
        this.payloads = ps
    }
}

class ApiSymbol {
    attributes: list[StaticAttribute]
    identity: str
    name: str
    kind: str
    signature: str
    type_parameters: list[str]
    parameters: list[ApiParam]
    return_type: str
    has_error_channel: bool
    error_channel: str
    fields: list[ApiField]
    variants: list[ApiVariant]
    methods: list[ApiSymbol]
    has_doc: bool
    documentation: str
    module_id: str
    package_id: str

    fn init(identity: str, name: str, kind: str, signature: str, module_id: str, package_id: str) {
        this.identity = identity
        let metadata: list[StaticAttribute] = []
        this.attributes = metadata
        this.name = name
        this.kind = kind
        this.signature = signature
        let tps: list[str] = []
        this.type_parameters = tps
        let ps: list[ApiParam] = []
        this.parameters = ps
        this.return_type = "unit"
        this.has_error_channel = false
        this.error_channel = ""
        let fs: list[ApiField] = []
        this.fields = fs
        let vs: list[ApiVariant] = []
        this.variants = vs
        let ms: list[ApiSymbol] = []
        this.methods = ms
        this.has_doc = false
        this.documentation = ""
        this.module_id = module_id
        this.package_id = package_id
    }
}

class ApiModuleRecord {
    identity: str
    symbols: list[ApiSymbol]
    imports: list[str]

    fn init(identity: str) {
        this.identity = identity
        let ss: list[ApiSymbol] = []
        this.symbols = ss
        let imps: list[str] = []
        this.imports = imps
    }
}

class ApiIndexCollector {
    stdlib_root: str
    visited: list[str]
    modules: list[ApiModuleRecord]

    fn init(stdlib_root: str) {
        this.stdlib_root = stdlib_root
        let vs: list[str] = []
        this.visited = vs
        let ms: list[ApiModuleRecord] = []
        this.modules = ms
    }
}

fn api_find_stdlib_root() -> str {
    let explicit = lsp_stdlib_root_arg()
    if explicit != "" {
        let c = module_canonical_resolved(explicit)
        return if c != "" { c } else { module_normalize(explicit) }
    }
    let arguments = args()
    if len(arguments) > 0 {
        let mut directory = module_directory(module_normalize(arguments[0]))
        while directory != "" {
            let probe = module_normalize(directory + "stdlib/json.wysna")
            if proj_is_readable_file(probe) {
                let c = module_canonical_resolved(module_normalize(directory + "stdlib"))
                if c != "" { return c }
                return module_normalize(directory + "stdlib")
            }
            let trim_d = if len(directory) > 1 and proj_str_ends_with(directory, "/") {
                slice(directory, 0, len(directory) - 1)
            } else { directory }
            let parent = module_directory(trim_d)
            if parent == directory { break }
            directory = parent
        }
    }
    let cwd = mcp_getcwd()
    let local_std = if cwd != "" { module_normalize(cwd + "/stdlib") } else { "stdlib" }
    let c = module_canonical_resolved(local_std)
    return if c != "" { c } else { local_std }
}

fn api_resolve_stdlib_module(stdlib_root: str, relative_in: str) -> list[str] {
    if lsp_trim(relative_in) == "" {
        return ["0", "invalid standard-library module path: '" + relative_in + "'"]
    }
    let norm_rel = if len(relative_in) >= 4 and slice(relative_in, 0, 4) == "std/" {
        slice(relative_in, 4, len(relative_in))
    } else {
        relative_in
    }
    if not module_safe_pkg_rel(norm_rel) {
        return ["0", "invalid standard-library module path: '" + relative_in + "'"]
    }
    let with_ext = if proj_str_ends_with(norm_rel, ".wysna") { norm_rel } else { norm_rel + ".wysna" }
    let cand = if stdlib_root == "/" { "/" + with_ext } else { stdlib_root + "/" + with_ext }
    if not proj_is_readable_file(cand) or not module_is_confined_under(cand, stdlib_root) {
        return ["0", "standard-library module not found: '" + relative_in + "'"]
    }
    let canon = module_canonical_resolved(cand)
    return ["1", if canon != "" { canon } else { cand }]
}

fn api_availability_json(module_id: str) -> str {
    let mut interp = "supported"
    let mut nat = "supported"
    let mut selfhost = "supported"
    let mut wasm = "supported"
    if module_id == "std/http" or (len(module_id) >= 9 and slice(module_id, 0, 9) == "std/http/") {
        interp = "requires-pycurl-extra"
        nat = "requires-libcurl"
        selfhost = "requires-libcurl"
        wasm = "unavailable"
    } elif module_id == "std/process" or (len(module_id) >= 12 and slice(module_id, 0, 12) == "std/process/") {
        wasm = "unavailable"
    } elif module_id == "std/fs" or module_id == "std/files" {
        wasm = "requires-declared-preopens"
    }
    return "{\"interpreter\":" + diag_json_quote(interp) + ",\"native\":" + diag_json_quote(nat) + ",\"selfhost\":" + diag_json_quote(selfhost) + ",\"wasm\":" + diag_json_quote(wasm) + "}"
}

fn api_set_doc(sym: ApiSymbol, lines: list[str], decl_line: int) -> unit {
    let doc = schema_leading_doc(lines, decl_line)
    if doc[0] == "1" {
        sym.has_doc = true
        sym.documentation = doc[1]
    }
}

fn api_skip_generics_names(c: SchemaTokCursor) -> list[str] {
    let mut names: list[str] = []
    if schema_cur_kind(c) != "LBRACKET" { return names }
    c.pos = c.pos + 1
    let mut depth = 1
    let mut take_next = true
    while depth > 0 and schema_cur_kind(c) != "EOF" {
        let k = schema_cur_kind(c)
        if k == "LBRACKET" {
            depth = depth + 1
        } elif k == "RBRACKET" {
            depth = depth - 1
            if depth == 0 { c.pos = c.pos + 1 break }
        } elif depth == 1 and k == "COMMA" {
            take_next = true
        } elif depth == 1 and take_next and k == "IDENT" {
            names.append(schema_cur_val(c))
            take_next = false
        }
        c.pos = c.pos + 1
    }
    return names
}

fn api_skip_contract_clauses(c: SchemaTokCursor, stop_at_newline: bool) -> unit {
    while schema_cur_kind(c) != "EOF" {
        let k = schema_cur_kind(c)
        if k == "LBRACE" or k == "RBRACE" { break }
        if stop_at_newline and k == "NEWLINE" { break }
        c.pos = c.pos + 1
    }
}

fn api_parse_fn_symbol(c: SchemaTokCursor, lines: list[str], owner_prefix: str, kind: str, module_id: str, package_id: str, has_body_block: bool) -> ApiSymbol {
    let decl_line = c.tokens[c.pos].line
    c.pos = c.pos + 1
    let name = schema_cur_val(c)
    c.pos = c.pos + 1
    let tps = api_skip_generics_names(c)
    let mut params: list[ApiParam] = []
    schema_skip_newlines(c)
    if schema_cur_kind(c) == "LPAREN" {
        c.pos = c.pos + 1
        while schema_cur_kind(c) != "RPAREN" and schema_cur_kind(c) != "EOF" {
            schema_skip_newlines(c)
            if schema_cur_kind(c) == "RPAREN" { break }
            if schema_cur_kind(c) == "IDENT" or schema_cur_kind(c) == "THIS" {
                let pname = schema_cur_val(c)
                c.pos = c.pos + 1
                schema_skip_newlines(c)
                let mut ptype_text = "inferred"
                if schema_cur_kind(c) == "COLON" {
                    c.pos = c.pos + 1
                    ptype_text = schema_type_text(schema_parse_type(c))
                }
                params.append(ApiParam(pname, ptype_text))
                schema_skip_newlines(c)
                if schema_cur_kind(c) == "COMMA" { c.pos = c.pos + 1 } else { break }
            } else {
                c.pos = c.pos + 1
            }
        }
        if schema_cur_kind(c) == "RPAREN" { c.pos = c.pos + 1 }
    }

    let mut ret_text = if kind == "method" and name == "init" { "unit" } else { "inferred" }
    let mut has_err = false
    let mut err_text = ""
    if schema_cur_kind(c) == "ARROW" {
        c.pos = c.pos + 1
        let ret_t = schema_parse_type(c)
        ret_text = schema_type_text(ret_t)
        if ret_t.kind == "result" and len(ret_t.args) == 2 {
            has_err = true
            err_text = schema_type_text(ret_t.args[1])
        }
    }

    if has_body_block {
        api_skip_contract_clauses(c, false)
        if schema_cur_kind(c) == "LBRACE" { schema_skip_brace_block(c) }
    } else {
        api_skip_contract_clauses(c, true)
    }

    let gen_str = if len(tps) > 0 { "[" + join_strings(tps, ", ") + "]" } else { "" }
    let mut sig_params: list[str] = []
    for p in params { sig_params.append(p.name + ": " + p.type_text) }
    let signature = "fn " + name + gen_str + "(" + join_strings(sig_params, ", ") + ") -> " + ret_text
    let identity = owner_prefix + "#" + kind + "/" + name
    let sym = ApiSymbol(identity, name, kind, signature, module_id, package_id)
    sym.type_parameters = tps
    sym.parameters = params
    sym.return_type = ret_text
    sym.has_error_channel = has_err
    sym.error_channel = err_text
    api_set_doc(sym, lines, decl_line)
    return sym
}

fn api_extract_module(src: str, file_path: str, module_id: str, package_id: str) -> ApiModuleRecord {
    let rec = ApiModuleRecord(module_id)
    let tokens = tokenize(src, file_path)
    let lines = schema_split_lines(src)
    let c = SchemaTokCursor(tokens)
    let mut depth = 0
    let mut is_pub = false
    let mut is_extern = false
    let mut attributes: list[StaticAttribute] = []
    while schema_cur_kind(c) != "EOF" {
        let k = schema_cur_kind(c)
        let v = schema_cur_val(c)
        if depth == 0 and k == "AT" {
            let metadata = SemanticContext(false)
            metadata.tokens = tokens
            metadata.pos = c.pos
            attributes = sem_static_attributes(metadata)
            c.pos = metadata.pos
            continue
        }
        if depth > 0 {
            if k == "LBRACE" { depth = depth + 1 }
            elif k == "RBRACE" { depth = depth - 1 }
            c.pos = c.pos + 1
            continue
        }
        if k == "IMPORT" and c.pos + 1 < len(c.tokens) and c.tokens[c.pos + 1].kind == "STR" {
            rec.imports.append(c.tokens[c.pos + 1].val)
            c.pos = c.pos + 2
            if schema_cur_kind(c) == "AS" and c.pos + 1 < len(c.tokens) { c.pos = c.pos + 2 }
            is_pub = false
            is_extern = false
            continue
        }
        let api_from = module_parse_from_header(c.tokens, c.pos)
        if api_from.found {
            rec.imports.append(api_from.requested)
            c.pos = api_from.use_pos + 1
            if schema_cur_kind(c) == "LBRACE" {
                schema_skip_brace_block(c)
            } else {
                if schema_cur_kind(c) == "IDENT" { c.pos = c.pos + 1 }
                if schema_cur_kind(c) == "DOT" and c.pos + 1 < len(c.tokens) and c.tokens[c.pos + 1].kind == "IDENT" {
                    c.pos = c.pos + 2
                }
                if schema_cur_kind(c) == "AS" and c.pos + 1 < len(c.tokens) {
                    c.pos = c.pos + 2
                }
            }
            is_pub = false
            is_extern = false
            continue
        }
        if k == "PUB" or k == "PRIV" {
            is_pub = k == "PUB"
            c.pos = c.pos + 1
            continue
        }
        if k == "IDENT" and v == "async" {
            c.pos = c.pos + 1
            continue
        }
        if k == "EXTERN" {
            is_extern = true
            c.pos = c.pos + 1
            if schema_cur_kind(c) == "STR" { c.pos = c.pos + 1 }
            continue
        }
        if k == "STRUCT" and c.pos + 1 < len(c.tokens) and c.tokens[c.pos + 1].kind == "IDENT" {
            let line_1 = c.tokens[c.pos].line
            c.pos = c.pos + 1
            let name = schema_cur_val(c)
            c.pos = c.pos + 1
            let _tps = api_skip_generics_names(c)
            schema_skip_newlines(c)
            let sym = ApiSymbol(module_id + "#struct/" + name, name, "struct", "struct " + name, module_id, package_id)
            api_set_doc(sym, lines, line_1)
            if schema_cur_kind(c) == "LBRACE" {
                c.pos = c.pos + 1
                while schema_cur_kind(c) != "RBRACE" and schema_cur_kind(c) != "EOF" {
                    while schema_cur_kind(c) == "NEWLINE" or schema_cur_kind(c) == "COMMA" { c.pos = c.pos + 1 }
                    if schema_cur_kind(c) == "RBRACE" or schema_cur_kind(c) == "EOF" { break }
                    if schema_cur_kind(c) == "IDENT" {
                        let fname = schema_cur_val(c)
                        c.pos = c.pos + 1
                        if schema_cur_kind(c) == "COLON" {
                            c.pos = c.pos + 1
                            let ftype = schema_type_text(schema_parse_type(c))
                            sym.fields.append(ApiField(fname, ftype))
                            while schema_cur_kind(c) != "NEWLINE" and schema_cur_kind(c) != "COMMA" and schema_cur_kind(c) != "RBRACE" and schema_cur_kind(c) != "EOF" {
                                c.pos = c.pos + 1
                            }
                            continue
                        }
                    }
                    c.pos = c.pos + 1
                }
                if schema_cur_kind(c) == "RBRACE" { c.pos = c.pos + 1 }
            }
            if is_pub { rec.symbols.append(sym) }
            is_pub = false
            is_extern = false
            continue
        }
        if k == "ENUM" and c.pos + 1 < len(c.tokens) and c.tokens[c.pos + 1].kind == "IDENT" {
            let line_1 = c.tokens[c.pos].line
            c.pos = c.pos + 1
            let name = schema_cur_val(c)
            c.pos = c.pos + 1
            let _tps = api_skip_generics_names(c)
            schema_skip_newlines(c)
            let sym = ApiSymbol(module_id + "#enum/" + name, name, "enum", "enum " + name, module_id, package_id)
            api_set_doc(sym, lines, line_1)
            if schema_cur_kind(c) == "LBRACE" {
                c.pos = c.pos + 1
                while schema_cur_kind(c) != "RBRACE" and schema_cur_kind(c) != "EOF" {
                    while schema_cur_kind(c) == "NEWLINE" or schema_cur_kind(c) == "COMMA" { c.pos = c.pos + 1 }
                    if schema_cur_kind(c) == "RBRACE" or schema_cur_kind(c) == "EOF" { break }
                    if schema_cur_kind(c) == "IDENT" {
                        let vname = schema_cur_val(c)
                        c.pos = c.pos + 1
                        let vari = ApiVariant(vname)
                        if schema_cur_kind(c) == "LPAREN" {
                            c.pos = c.pos + 1
                            while schema_cur_kind(c) != "RPAREN" and schema_cur_kind(c) != "EOF" {
                                vari.payloads.append(schema_type_text(schema_parse_type(c)))
                                if schema_cur_kind(c) == "COMMA" { c.pos = c.pos + 1 } else { break }
                            }
                            if schema_cur_kind(c) == "RPAREN" { c.pos = c.pos + 1 }
                        }
                        sym.variants.append(vari)
                        continue
                    }
                    c.pos = c.pos + 1
                }
                if schema_cur_kind(c) == "RBRACE" { c.pos = c.pos + 1 }
            }
            if is_pub { rec.symbols.append(sym) }
            is_pub = false
            is_extern = false
            continue
        }
        if k == "INTERFACE" and c.pos + 1 < len(c.tokens) and c.tokens[c.pos + 1].kind == "IDENT" {
            let line_1 = c.tokens[c.pos].line
            c.pos = c.pos + 1
            let name = schema_cur_val(c)
            c.pos = c.pos + 1
            let _tps = api_skip_generics_names(c)
            while schema_cur_kind(c) != "LBRACE" and schema_cur_kind(c) != "EOF" { c.pos = c.pos + 1 }
            let owner = module_id + "#interface/" + name
            let sym = ApiSymbol(owner, name, "interface", "interface " + name, module_id, package_id)
            api_set_doc(sym, lines, line_1)
            if schema_cur_kind(c) == "LBRACE" {
                c.pos = c.pos + 1
                while schema_cur_kind(c) != "RBRACE" and schema_cur_kind(c) != "EOF" {
                    let mk = schema_cur_kind(c)
                    if mk == "FN" and c.pos + 1 < len(c.tokens) and c.tokens[c.pos + 1].kind == "IDENT" {
                        let m = api_parse_fn_symbol(c, lines, owner, "method", module_id, package_id, false)
                        sym.methods.append(m)
                        continue
                    }
                    if mk == "LBRACE" { schema_skip_brace_block(c) continue }
                    c.pos = c.pos + 1
                }
                if schema_cur_kind(c) == "RBRACE" { c.pos = c.pos + 1 }
            }
            if is_pub { rec.symbols.append(sym) }
            is_pub = false
            is_extern = false
            continue
        }
        if k == "CLASS" and c.pos + 1 < len(c.tokens) and c.tokens[c.pos + 1].kind == "IDENT" {
            let line_1 = c.tokens[c.pos].line
            c.pos = c.pos + 1
            let name = schema_cur_val(c)
            c.pos = c.pos + 1
            let _tps = api_skip_generics_names(c)
            while schema_cur_kind(c) != "LBRACE" and schema_cur_kind(c) != "EOF" { c.pos = c.pos + 1 }
            let owner = module_id + "#class/" + name
            let sym = ApiSymbol(owner, name, "class", "class " + name, module_id, package_id)
            sym.attributes = attributes
            attributes = []
            api_set_doc(sym, lines, line_1)
            if schema_cur_kind(c) == "LBRACE" {
                c.pos = c.pos + 1
                let mut member_public = true
                while schema_cur_kind(c) != "RBRACE" and schema_cur_kind(c) != "EOF" {
                    let mk = schema_cur_kind(c)
                    let mv = schema_cur_val(c)
                    if mk == "NEWLINE" { c.pos = c.pos + 1 continue }
                    if mk == "PUB" { member_public = true c.pos = c.pos + 1 continue }
                    if mk == "PRIV" { member_public = false c.pos = c.pos + 1 continue }
                    if mk == "IDENT" and mv == "async" { c.pos = c.pos + 1 continue }
                    if mk == "FN" and c.pos + 1 < len(c.tokens) and c.tokens[c.pos + 1].kind == "IDENT" {
                        let m = api_parse_fn_symbol(c, lines, owner, "method", module_id, package_id, true)
                        if member_public { sym.methods.append(m) }
                        member_public = true
                        continue
                    }
                    if mk == "LBRACE" {
                        schema_skip_brace_block(c)
                        member_public = true
                        continue
                    }
                    if mk == "IDENT" {
                        while schema_cur_kind(c) != "NEWLINE" and schema_cur_kind(c) != "RBRACE" and schema_cur_kind(c) != "EOF" {
                            if schema_cur_kind(c) == "LBRACE" { schema_skip_brace_block(c) }
                            else { c.pos = c.pos + 1 }
                        }
                        member_public = true
                        continue
                    }
                    c.pos = c.pos + 1
                }
                if schema_cur_kind(c) == "RBRACE" { c.pos = c.pos + 1 }
            }
            if is_pub { rec.symbols.append(sym) }
            is_pub = false
            is_extern = false
            continue
        }
        if k == "FN" and c.pos + 1 < len(c.tokens) and c.tokens[c.pos + 1].kind == "IDENT" {
            if is_extern or not is_pub {
                c.pos = c.pos + 1
                api_skip_contract_clauses(c, true)
                if schema_cur_kind(c) == "LBRACE" { schema_skip_brace_block(c) }
            } else {
                let fn_sym = api_parse_fn_symbol(c, lines, module_id, "function", module_id, package_id, true)
                fn_sym.attributes = attributes
                rec.symbols.append(fn_sym)
            }
            let empty_metadata: list[StaticAttribute] = []
            attributes = empty_metadata
            is_pub = false
            is_extern = false
            continue
        }
        if k == "LBRACE" { depth = depth + 1 }
        if k != "NEWLINE" {
            is_pub = false
            is_extern = false
        }
        c.pos = c.pos + 1
    }
    return rec
}

fn api_symbol_gt(a: ApiSymbol, b: ApiSymbol) -> bool {
    if a.kind != b.kind { return tool_str_gt(a.kind, b.kind) }
    return tool_str_gt(a.name, b.name)
}

fn api_sort_symbols(xs: list[ApiSymbol]) -> list[ApiSymbol] {
    let mut out: list[ApiSymbol] = []
    for item in xs { out.append(item) }
    let n = len(out)
    for i in 0..n {
        for j in (i + 1)..n {
            if api_symbol_gt(out[i], out[j]) {
                let tmp = out[i]
                out[i] = out[j]
                out[j] = tmp
            }
        }
    }
    return out
}

fn api_sort_modules(xs: list[ApiModuleRecord]) -> list[ApiModuleRecord] {
    let mut out: list[ApiModuleRecord] = []
    for item in xs { out.append(item) }
    let n = len(out)
    for i in 0..n {
        for j in (i + 1)..n {
            if tool_str_gt(out[i].identity, out[j].identity) {
                let tmp = out[i]
                out[i] = out[j]
                out[j] = tmp
            }
        }
    }
    return out
}

fn api_str_list_json(xs: list[str]) -> str {
    let mut parts: list[str] = ["["]
    for i in 0..len(xs) {
        if i > 0 { parts.append(",") }
        parts.append(diag_json_quote(xs[i]))
    }
    parts.append("]")
    return join_strings(parts, "")
}

fn api_symbol_json(s: ApiSymbol) -> str {
    let doc_json = if s.has_doc { diag_json_quote(s.documentation) } else { "null" }
    let avail = api_availability_json(s.module_id)
    let mut parts: list[str] = ["{"]
    parts.append("\"identity\":" + diag_json_quote(s.identity))
    parts.append(",\"name\":" + diag_json_quote(s.name))
    parts.append(",\"kind\":" + diag_json_quote(s.kind))
    parts.append(",\"visibility\":\"public\"")
    parts.append(",\"signature\":" + diag_json_quote(s.signature))
    if s.kind == "function" or s.kind == "method" or s.kind == "class" {
        parts.append(",\"attributes\":" + tool_attributes_json(s.attributes))
    }
    if s.kind == "function" or s.kind == "method" {
        parts.append(",\"type_parameters\":" + api_str_list_json(s.type_parameters))
        let mut p_parts: list[str] = ["["]
        for i in 0..len(s.parameters) {
            if i > 0 { p_parts.append(",") }
            p_parts.append("{\"name\":" + diag_json_quote(s.parameters[i].name) + ",\"type\":" + diag_json_quote(s.parameters[i].type_text) + "}")
        }
        p_parts.append("]")
        parts.append(",\"parameters\":" + join_strings(p_parts, ""))
        parts.append(",\"return_type\":" + diag_json_quote(s.return_type))
        parts.append(",\"error_channel\":" + (if s.has_error_channel { diag_json_quote(s.error_channel) } else { "null" }))
    } elif s.kind == "struct" {
        let mut f_parts: list[str] = ["["]
        for i in 0..len(s.fields) {
            if i > 0 { f_parts.append(",") }
            f_parts.append("{\"name\":" + diag_json_quote(s.fields[i].name) + ",\"type\":" + diag_json_quote(s.fields[i].type_text) + "}")
        }
        f_parts.append("]")
        parts.append(",\"fields\":" + join_strings(f_parts, ""))
    } elif s.kind == "enum" {
        let mut v_parts: list[str] = ["["]
        for i in 0..len(s.variants) {
            if i > 0 { v_parts.append(",") }
            v_parts.append("{\"name\":" + diag_json_quote(s.variants[i].name) + ",\"payload\":" + api_str_list_json(s.variants[i].payloads) + "}")
        }
        v_parts.append("]")
        parts.append(",\"variants\":" + join_strings(v_parts, ""))
    } elif s.kind == "interface" or s.kind == "class" {
        let mut m_parts: list[str] = ["["]
        for i in 0..len(s.methods) {
            if i > 0 { m_parts.append(",") }
            m_parts.append(api_symbol_json(s.methods[i]))
        }
        m_parts.append("]")
        parts.append(",\"methods\":" + join_strings(m_parts, ""))
    }
    parts.append(",\"effects\":\"unknown\"")
    parts.append(",\"documentation\":" + doc_json)
    parts.append(",\"ownership\":\"unknown\"")
    parts.append(",\"availability\":" + avail)
    parts.append(",\"package\":" + diag_json_quote(s.package_id))
    parts.append("}")
    return join_strings(parts, "")
}

fn api_module_json(rec: ApiModuleRecord) -> str {
    let sorted_syms = api_sort_symbols(rec.symbols)
    let mut parts: list[str] = ["{\"identity\":" + diag_json_quote(rec.identity) + ",\"symbols\":["]
    for i in 0..len(sorted_syms) {
        if i > 0 { parts.append(",") }
        parts.append(api_symbol_json(sorted_syms[i]))
    }
    parts.append("]}")
    return join_strings(parts, "")
}

fn api_collect_stdlib_file(acc: ApiIndexCollector, resolved_path: str, module_id: str, recurse: bool) -> unit {
    let canon = module_canonical(resolved_path)
    if tool_str_contains(acc.visited, canon) { return }
    acc.visited.append(canon)
    let src = read_file(canon) else err { return }
    let rec = api_extract_module(src, canon, module_id, ("wysna-stdlib@" + tool_compiler_version()))
    acc.modules.append(rec)
    if not recurse { return }
    for imp in rec.imports {
        if len(imp) >= 4 and slice(imp, 0, 4) == "std/" {
            let sub = api_resolve_stdlib_module(acc.stdlib_root, imp)
            if sub[0] == "1" {
                let rel = slice(imp, 4, len(imp))
                let clean_rel = if proj_str_ends_with(rel, ".wysna") { slice(rel, 0, len(rel) - 6) } else { rel }
                api_collect_stdlib_file(acc, sub[1], "std/" + clean_rel, true)
            }
        }
    }
}

fn api_strip_ext_rel(abs_file: str, abs_root: str) -> str {
    let prefix = if abs_root == "/" { "/" } else { abs_root + "/" }
    let rel = if len(abs_file) > len(prefix) and slice(abs_file, 0, len(prefix)) == prefix {
        slice(abs_file, len(prefix), len(abs_file))
    } else {
        tool_basename(abs_file)
    }
    if proj_str_ends_with(rel, ".wysna") { return slice(rel, 0, len(rel) - 6) }
    return rel
}

fn api_emit_error_and_exit(code: str, msg: str) -> unit {
    let diag = diag_record_json(code, if code == "W5002" { "usage" } else { "filesystem" }, "error", msg, "<api>", 1, 1, "")
    let exit_c = if code == "W5002" { 2 } else { 1 }
    let status = if code == "W5002" { "usage_error" } else { "diagnostic_error" }
    diag_write_output(diag_tool_envelope_json("api", status, exit_c, "[" + diag + "]", "", "", "[]"))
    exit(exit_c)
}

fn tool_handle_api(args: list[str], _json_mode: bool) -> unit {
    let mut mod_arg = ""
    let mut has_mod = false
    let mut include_deps = false
    let mut manifest_arg = ""
    let mut i = 1
    while i < len(args) {
        let a = args[i]
        if a == "--output-format=json-v1" {
            i = i + 1
        } elif a == "--output-format" and i + 1 < len(args) {
            if args[i + 1] != "json-v1" { api_emit_error_and_exit("W5002", "unsupported output format: " + args[i + 1]) }
            i = i + 2
        } elif a == "--with-deps" or a == "--include-deps" {
            include_deps = true
            i = i + 1
        } elif a == "--manifest" and i + 1 < len(args) {
            manifest_arg = args[i + 1]
            i = i + 2
        } elif len(a) > 0 and a[0] != "-" and not has_mod {
            mod_arg = a
            has_mod = true
            i = i + 1
        } else {
            api_emit_error_and_exit("W5002", "unknown or invalid option for api: " + a)
        }
    }

    let stdlib_root = api_find_stdlib_root()

    if manifest_arg != "" {
        if has_mod {
            api_emit_error_and_exit("W5002", "a project API index includes its resolved module graph; omit the module name")
        }
        let m = proj_load_manifest(manifest_arg)
        if not m.ok {
            api_emit_error_and_exit(m.err_code, m.err_msg)
        }
        let mut tidx = proj_find_target_idx(m, "app")
        if tidx < 0 and len(m.targets) == 1 {
            tidx = 0
        }
        if tidx < 0 {
            api_emit_error_and_exit("W5002", "project API index requires a target named 'app'")
        }
        let entry_path = m.root + "/" + m.targets[tidx].entry
        let src = read_file(entry_path) else err {
            api_emit_error_and_exit("W5004", "cannot read project entry: " + err.message)
            ""
        }
        let mut dep_aliases: list[str] = []
        let mut dep_roots: list[str] = []
        for d in m.deps {
            dep_aliases.append(d.alias)
            dep_roots.append(d.source_root_abs)
        }
        let loader = ModuleLoader()
        loader.project_sources_root = m.source_root_abs
        loader.dep_aliases = dep_aliases
        loader.dep_roots = dep_roots
        module_expand(loader, src, entry_path, true)
        loader.output.append(Token { kind: "EOF", val: "", line: 1, col: 1, file: module_canonical(entry_path) })
        let _checked = check_program(loader.output, module_canonical(entry_path), true)

        let mut mods: list[ApiModuleRecord] = []
        for mod_path in loader.paths {
            let msrc = read_file(mod_path) else err { "" }
            let mut mid = ""
            let mut owner = ""
            if module_is_confined_under(mod_path, stdlib_root) {
                let srel = api_strip_ext_rel(mod_path, stdlib_root)
                mid = "std/" + srel
                owner = ("wysna-stdlib@" + tool_compiler_version())
            } else {
                let mut found_owner = m.name + "@" + m.version
                let mut found_src_root = m.source_root_abs
                for d in m.deps {
                    if module_is_confined_under(mod_path, d.abs_root) {
                        found_owner = d.package_id
                        found_src_root = d.source_root_abs
                    }
                }
                let prel = api_strip_ext_rel(mod_path, found_src_root)
                mid = found_owner + "/" + prel
                owner = found_owner
            }
            mods.append(api_extract_module(msrc, mod_path, mid, owner))
        }
        let sorted_mods = api_sort_modules(mods)
        let mut mparts: list[str] = ["["]
        for k in 0..len(sorted_mods) {
            if k > 0 { mparts.append(",") }
            mparts.append(api_module_json(sorted_mods[k]))
        }
        mparts.append("]")
        let proj_obj = "{\"name\":" + diag_json_quote(m.name) + ",\"version\":" + diag_json_quote(m.version) + "}"
        let payload = ("{\"schema_version\":\"wysna.api-index/1\",\"compiler_version\":\"" + tool_compiler_version() + "\",\"stdlib_version\":\"" + tool_compiler_version() + "\",\"project\":") + proj_obj + ",\"modules\":" + join_strings(mparts, "") + "}"
        diag_write_output(diag_tool_envelope_json("api", "ok", 0, "[]", "result", payload, "[]"))
        exit(0)
    }

    let acc = ApiIndexCollector(stdlib_root)
    if has_mod {
        let resolved = api_resolve_stdlib_module(stdlib_root, mod_arg)
        if resolved[0] != "1" {
            api_emit_error_and_exit("W5002", resolved[1])
        }
        let rel = if len(mod_arg) >= 4 and slice(mod_arg, 0, 4) == "std/" { slice(mod_arg, 4, len(mod_arg)) } else { mod_arg }
        let clean_rel = if proj_str_ends_with(rel, ".wysna") { slice(rel, 0, len(rel) - 6) } else { rel }
        api_collect_stdlib_file(acc, resolved[1], "std/" + clean_rel, include_deps)
    } else {
        let known: list[str] = ["algorithms", "async", "buffer", "bytes", "crypto", "csv", "environment", "files", "fs", "http", "io", "json", "parse", "path", "process", "resources", "result", "test", "text", "time"]
        for name in known {
            let resolved = api_resolve_stdlib_module(stdlib_root, name)
            if resolved[0] == "1" {
                api_collect_stdlib_file(acc, resolved[1], "std/" + name, true)
            }
        }
    }

    let sorted_mods = api_sort_modules(acc.modules)
    let mut mparts: list[str] = ["["]
    for k in 0..len(sorted_mods) {
        if k > 0 { mparts.append(",") }
        mparts.append(api_module_json(sorted_mods[k]))
    }
    mparts.append("]")
    let payload = ("{\"schema_version\":\"wysna.api-index/1\",\"compiler_version\":\"" + tool_compiler_version() + "\",\"stdlib_version\":\"" + tool_compiler_version() + "\",\"modules\":") + join_strings(mparts, "") + "}"
    diag_write_output(diag_tool_envelope_json("api", "ok", 0, "[]", "result", payload, "[]"))
    exit(0)
}
# Native Model Context Protocol (MCP) server over newline-delimited stdio JSON-RPC 2.0.

class McpServerState {
    root: str
    inline_path: str
    self_exe: str
    stdlib_root: str
    tmp_dir: str
    tmp_nonce: str
    allow_exec: bool
    sdk_driver: str
    seq: int

    fn init(root: str, self_exe: str, stdlib_root: str, tmp_dir: str, allow_exec: bool, sdk_driver: str) {
        this.root = root
        let sep = if root == "/" { "" } else { "/" }
        this.inline_path = root + sep + "__mcp_inline__.wysna"
        this.self_exe = self_exe
        this.stdlib_root = stdlib_root
        this.tmp_dir = tmp_dir
        this.tmp_nonce = diag_uuid4()
        if this.tmp_nonce == "native" {
            eprint("wysna mcp: cannot allocate an isolated session")
            exit(2)
        }
        this.allow_exec = allow_exec
        this.sdk_driver = sdk_driver
        this.seq = 0
    }
}

# mcp_getcwd, mcp_is_abs_path, mcp_is_within_root live in 01_tool_common.wysna.

fn mcp_resolve_with_ancestors(joined: str) -> str {
    let direct = module_canonical_resolved(joined)
    if direct != "" { return direct }
    let norm = module_normalize(joined)
    if norm == "" { return "" }
    let mut cur = norm
    let mut tail_segs: list[str] = []
    while cur != "" {
        let can = module_canonical_resolved(cur)
        if can != "" {
            let mut out = can
            let mut k = len(tail_segs) - 1
            while k >= 0 {
                if out == "/" { out = "/" + tail_segs[k] }
                else { out = out + "/" + tail_segs[k] }
                k = k - 1
            }
            return out
        }
        let mut sep = -1
        for i in 0..len(cur) {
            if cur[i] == "/" { sep = i }
        }
        if sep < 0 { break }
        if sep == 0 {
            if len(cur) > 1 { tail_segs.append(slice(cur, 1, len(cur))) }
            let can_root = module_canonical_resolved("/")
            if can_root != "" {
                let mut out = can_root
                let mut k = len(tail_segs) - 1
                while k >= 0 {
                    if out == "/" { out = "/" + tail_segs[k] }
                    else { out = out + "/" + tail_segs[k] }
                    k = k - 1
                }
                return out
            }
            break
        }
        tail_segs.append(slice(cur, sep + 1, len(cur)))
        cur = slice(cur, 0, sep)
    }
    return norm
}

fn mcp_confine_path(root: str, raw_path: str) -> list[str] {
    if lsp_trim(raw_path) == "" { return ["0", "path must be non-empty"] }
    let joined = if mcp_is_abs_path(raw_path) { raw_path } else {
        if root == "/" { "/" + raw_path } else { root + "/" + raw_path }
    }
    let resolved = mcp_resolve_with_ancestors(joined)
    if not mcp_is_within_root(resolved, root) {
        return ["0", "path is outside the server root: " + raw_path]
    }
    return ["1", resolved]
}

# Strict JSON parser (mcp_parse_json_strict) lives in 01_tool_common.wysna.

fn mcp_write_line(json_body: str) -> unit {
    let out = lsp_buf_from_str(json_body + "\n")
    let _w = wysna_host_stdout_write_raw(out)
    wysna_host_close(out)
}

fn mcp_rpc_result(id_raw: str, result_json: str) -> str {
    return "{\"jsonrpc\":\"2.0\",\"id\":" + id_raw + ",\"result\":" + result_json + "}"
}

fn mcp_rpc_error(id_raw: str, code: int, message: str) -> str {
    return "{\"jsonrpc\":\"2.0\",\"id\":" + id_raw + ",\"error\":{\"code\":" + str(code) + ",\"message\":" + diag_json_quote(message) + "}}"
}

fn mcp_tool_err(msg: str) -> list[str] {
    return ["1", "{\"error\":" + diag_json_quote(msg) + "}"]
}

fn mcp_next_tmp(state: McpServerState, prefix: str, ext: str) -> str {
    state.seq = state.seq + 1
    return state.tmp_dir + "/" + prefix + "_" + state.tmp_nonce + "_" + str(state.seq) + ext
}

fn mcp_run_subcommand(state: McpServerState, tool_argv: list[str]) -> list[str] {
    let diag_tmp = mcp_next_tmp(state, "wysna_mcp_diag", ".json")
    let mut argv: list[str] = []
    if state.stdlib_root != "" {
        argv.append("--stdlib-root")
        argv.append(state.stdlib_root)
    }
    for item in tool_argv { argv.append(item) }
    argv.append("--diag-out")
    argv.append(diag_tmp)
    let exe_buf = lsp_buf_from_str(state.self_exe)
    let args_buf = lsp_pack_argv_buf(argv)
    let rc = wysna_host_process_run(exe_buf, args_buf, 30000)
    wysna_host_close(exe_buf)
    wysna_host_close(args_buf)
    let raw = read_file(diag_tmp) else err { "" }
    lsp_remove_file(diag_tmp)
    return [str(rc), raw]
}

fn mcp_run_sdk_subcommand(state: McpServerState, tool_argv: list[str]) -> list[str] {
    let output = mcp_next_tmp(state, "wysna_mcp_sdk", ".json")
    let mut argv = tool_argv
    argv.append("--diag-out")
    argv.append(output)
    let exe_buf = lsp_buf_from_str(state.sdk_driver)
    let args_buf = lsp_pack_argv_buf(argv)
    let rc = wysna_host_process_run(exe_buf, args_buf, 300000)
    wysna_host_close(exe_buf)
    wysna_host_close(args_buf)
    let raw = read_file(output) else err { "" }
    lsp_remove_file(output)
    return [str(rc), raw]
}

fn mcp_resolve_source(state: McpServerState, arguments: LspJson) -> list[str] {
    let has_path = lsp_json_has(arguments, "path") and lsp_json_get(arguments, "path").kind != "null"
    let has_source = lsp_json_has(arguments, "source") and lsp_json_get(arguments, "source").kind != "null"
    if has_path == has_source {
        return ["0", "provide exactly one of 'path' or 'source'", "", "", ""]
    }
    if has_path {
        let pv = lsp_json_get(arguments, "path")
        if pv.kind != "str" { return ["0", "'path' must be a string", "", "", ""] }
        let confined = mcp_confine_path(state.root, pv.str_val)
        if confined[0] != "1" { return ["0", confined[1], "", "", ""] }
        let resolved = confined[1]
        let txt = read_file(resolved) else err {
            return ["0", "cannot read file: " + resolved, "", "", ""]
        }
        return ["1", resolved, txt, "", ""]
    }
    let sv = lsp_json_get(arguments, "source")
    if sv.kind != "str" { return ["0", "'source' must be a string", "", "", ""] }
    let tmp_ov = mcp_next_tmp(state, "wysna_mcp_ov", ".wysna")
    write_file(tmp_ov, sv.str_val) else _err {
        return ["0", "failed writing temporary MCP overlay", "", "", ""]
    }
    return ["1", state.inline_path, sv.str_val, state.inline_path, tmp_ov]
}

fn mcp_cleanup_source(resolved_src: list[str]) -> unit {
    if len(resolved_src) >= 5 and resolved_src[4] != "" {
        lsp_remove_file(resolved_src[4])
    }
}

fn mcp_with_overlay_flags(base_argv: list[str], resolved_src: list[str]) -> list[str] {
    let mut out: list[str] = []
    for item in base_argv { out.append(item) }
    if len(resolved_src) >= 5 and resolved_src[4] != "" {
        out.append("--overlay")
        out.append(resolved_src[3])
        out.append(resolved_src[4])
    }
    return out
}

fn mcp_exec_simple_source_tool(state: McpServerState, cmd: str, arguments: LspJson, extra_flags: list[str]) -> list[str] {
    let rs = mcp_resolve_source(state, arguments)
    if rs[0] != "1" { return mcp_tool_err(rs[1]) }
    let mut argv: list[str] = [cmd, rs[1], "--output-format=json-v1"]
    for fl in extra_flags { argv.append(fl) }
    argv = mcp_with_overlay_flags(argv, rs)
    let sub = mcp_run_subcommand(state, argv)
    mcp_cleanup_source(rs)
    if sub[1] == "" { return mcp_tool_err("tool produced no JSON (exit " + sub[0] + ")") }
    return ["0", sub[1]]
}

fn mcp_tool_fmt(state: McpServerState, arguments: LspJson) -> list[str] {
    let rs = mcp_resolve_source(state, arguments)
    if rs[0] != "1" { return mcp_tool_err(rs[1]) }
    let target = rs[1]
    let orig_src = rs[2]
    let argv = mcp_with_overlay_flags(["fmt", target, "--output-format=json-v1"], rs)
    let sub = mcp_run_subcommand(state, argv)
    mcp_cleanup_source(rs)
    if sub[1] == "" { return mcp_tool_err("tool produced no JSON (exit " + sub[0] + ")") }
    let parsed = lsp_parse_json(sub[1])
    if lsp_json_str(parsed, "status", "") != "ok" {
        return ["0", sub[1]]
    }
    let arts = lsp_json_get(parsed, "artifacts")
    let mut formatted = orig_src
    if arts.kind == "array" and len(arts.items) > 0 {
        formatted = lsp_json_str(arts.items[0], "content", orig_src)
    }
    let changed = formatted != orig_src
    let res_obj = "{\"path\":" + diag_json_quote(target) + ",\"changed\":" + (if changed { "true" } else { "false" }) + ",\"written\":false,\"formatted_source\":" + diag_json_quote(formatted) + "}"
    return ["0", diag_tool_envelope_json("fmt", "ok", 0, "[]", "result", res_obj, "[]")]
}

fn mcp_tool_schema(state: McpServerState, arguments: LspJson) -> list[str] {
    let mut extra: list[str] = []
    if lsp_json_bool(arguments, "all", false) { extra.append("--all") }
    let fn_v = lsp_json_get(arguments, "function")
    if fn_v.kind == "str" and fn_v.str_val != "" {
        extra.append("--function")
        extra.append(fn_v.str_val)
    }
    if lsp_json_bool(arguments, "emit_codecs", false) { extra.append("--emit-codecs") }
    let res = mcp_exec_simple_source_tool(state, "schema", arguments, extra)
    if res[0] != "0" { return res }
    let parsed = lsp_parse_json(res[1])
    if lsp_json_str(parsed, "status", "") == "usage_error" {
        let ds = lsp_json_get(parsed, "diagnostics")
        let mut msg = "schema usage error"
        if ds.kind == "array" and len(ds.items) > 0 {
            msg = lsp_json_str(ds.items[0], "message", msg)
        }
        return mcp_tool_err(msg)
    }
    return res
}

fn mcp_tool_graph(state: McpServerState, arguments: LspJson) -> list[str] {
    if lsp_json_has(arguments, "role") {
        let manifest = lsp_json_get(arguments, "manifest")
        let role = lsp_json_str(arguments, "role", "")
        let target = lsp_json_get(arguments, "target")
        if manifest.kind != "str" or role == "" or (lsp_json_has(arguments, "target") and (target.kind != "str" or target.str_val == "")) or lsp_json_has(arguments, "path") or lsp_json_has(arguments, "source") or lsp_json_has(arguments, "symbol") or lsp_json_has(arguments, "relation") {
            return mcp_tool_err("provide manifest, role and optionally target for a role query")
        }
        let confined = mcp_confine_path(state.root, manifest.str_val)
        if confined[0] != "1" { return mcp_tool_err(confined[1]) }
        let mut argv: list[str] = ["graph", "--manifest", confined[1], "--role", role, "--output-format=json-v1"]
        if target.kind == "str" { argv.append("--target") argv.append(target.str_val) }
        let result = mcp_run_subcommand(state, argv)
        if result[1] == "" { return mcp_tool_err("tool produced no JSON (exit " + result[0] + ")") }
        return ["0", result[1]]
    }
    if lsp_json_has(arguments, "manifest") {
        let manifest = lsp_json_get(arguments, "manifest")
        let symbol = lsp_json_str(arguments, "symbol", "")
        if manifest.kind != "str" or symbol == "" or lsp_json_str(arguments, "relation", "") != "impact" or lsp_json_has(arguments, "path") or lsp_json_has(arguments, "source") {
            return mcp_tool_err("provide manifest, symbol and relation=impact for a project query")
        }
        let confined = mcp_confine_path(state.root, manifest.str_val)
        if confined[0] != "1" { return mcp_tool_err(confined[1]) }
        let result = mcp_run_subcommand(state, ["graph", "--manifest", confined[1], "--symbol", symbol, "--rel", "impact", "--output-format=json-v1"])
        if result[1] == "" { return mcp_tool_err("tool produced no JSON (exit " + result[0] + ")") }
        return ["0", result[1]]
    }

    let rs = mcp_resolve_source(state, arguments)
    if rs[0] != "1" { return mcp_tool_err(rs[1]) }
    let target = rs[1]
    let mut argv: list[str] = ["graph", target, "--output-format=json-v1"]
    let sym_v = lsp_json_get(arguments, "symbol")
    let sym = if sym_v.kind == "str" { sym_v.str_val } else { "" }
    if sym != "" {
        argv.append("--symbol")
        argv.append(sym)
    }
    let rel_v = lsp_json_get(arguments, "relation")
    if rel_v.kind == "str" and rel_v.str_val != "" {
        argv.append("--rel")
        argv.append(rel_v.str_val)
    }
    argv = mcp_with_overlay_flags(argv, rs)
    let sub = mcp_run_subcommand(state, argv)
    mcp_cleanup_source(rs)
    if sub[1] == "" { return mcp_tool_err("tool produced no JSON (exit " + sub[0] + ")") }
    return ["0", sub[1]]
}

fn mcp_tool_inspect(state: McpServerState, arguments: LspJson) -> list[str] {
    let mut extra: list[str] = []
    let sym_v = lsp_json_get(arguments, "symbol")
    if sym_v.kind == "str" and sym_v.str_val != "" {
        extra.append("--symbol")
        extra.append(sym_v.str_val)
    }
    if lsp_json_has(arguments, "symbols") and lsp_json_get(arguments, "symbols").kind != "null" {
        let syms_v = lsp_json_get(arguments, "symbols")
        if syms_v.kind != "array" or len(syms_v.items) == 0 {
            return mcp_tool_err("'symbols' must be a non-empty array of strings")
        }
        if sym_v.kind == "str" and sym_v.str_val != "" {
            return mcp_tool_err("provide either 'symbol' or 'symbols', not both")
        }
        for si in 0..len(syms_v.items) {
            let item = syms_v.items[si]
            if item.kind != "str" or lsp_trim(item.str_val) == "" {
                return mcp_tool_err("'symbols' entries must be non-empty strings")
            }
            extra.append("--symbol")
            extra.append(item.str_val)
        }
    }
    if lsp_json_bool(arguments, "with_deps", false) { extra.append("--with-deps") }
    if lsp_json_has(arguments, "max_bytes") and lsp_json_get(arguments, "max_bytes").kind != "null" {
        let mb = lsp_json_get(arguments, "max_bytes")
        if mb.kind != "int" or mb.int_val < 1 { return mcp_tool_err("'max_bytes' must be a positive integer") }
        extra.append("--max-bytes")
        extra.append(str(mb.int_val))
    }
    if lsp_json_has(arguments, "source_offset") and lsp_json_get(arguments, "source_offset").kind != "null" {
        let so = lsp_json_get(arguments, "source_offset")
        if so.kind != "int" or so.int_val < 0 { return mcp_tool_err("'source_offset' must be a non-negative integer") }
        extra.append("--source-offset")
        extra.append(str(so.int_val))
    }
    if lsp_json_has(arguments, "offset") and lsp_json_get(arguments, "offset").kind != "null" {
        let off = lsp_json_get(arguments, "offset")
        if off.kind != "int" or off.int_val < 0 { return mcp_tool_err("'offset' must be a non-negative integer") }
        extra.append("--offset")
        extra.append(str(off.int_val))
    }
    let span = lsp_json_get(arguments, "span")
    if span.kind != "null" {
        if span.kind != "object" or lsp_json_get(arguments, "path").kind != "str" or
           lsp_json_get(arguments, "source").kind != "null" {
            return mcp_tool_err("'span' requires a file path and a diagnostic span object")
        }
        extra.append("--span")
        extra.append(mcp_serialize_json_val(span))
    }
    return mcp_exec_simple_source_tool(state, "inspect", arguments, extra)
}

fn mcp_tool_project_check(state: McpServerState, arguments: LspJson) -> list[str] {
    let man_v = lsp_json_get(arguments, "manifest")
    if man_v.kind != "str" or lsp_trim(man_v.str_val) == "" {
        return mcp_tool_err("'wysna_project_check' requires 'manifest'")
    }
    let confined = mcp_confine_path(state.root, man_v.str_val)
    if confined[0] != "1" { return mcp_tool_err(confined[1]) }
    let mut argv: list[str] = ["project", "check", "--manifest", confined[1], "--output-format=json-v1"]
    let tgt_v = lsp_json_get(arguments, "target")
    if tgt_v.kind == "str" and lsp_trim(tgt_v.str_val) != "" {
        argv.append("--target")
        argv.append(tgt_v.str_val)
    }
    if lsp_json_bool(arguments, "frozen", false) { argv.append("--frozen") }
    let sub = mcp_run_subcommand(state, argv)
    if sub[1] == "" { return mcp_tool_err("project check produced no JSON (exit " + sub[0] + ")") }
    return ["0", sub[1]]
}

fn mcp_tool_project_test(state: McpServerState, arguments: LspJson) -> list[str] {
    let man_v = lsp_json_get(arguments, "manifest")
    if man_v.kind != "str" or lsp_trim(man_v.str_val) == "" {
        return mcp_tool_err("'wysna_project_test' requires 'manifest'")
    }
    let confined = mcp_confine_path(state.root, man_v.str_val)
    if confined[0] != "1" { return mcp_tool_err(confined[1]) }
    let list_only = lsp_json_bool(arguments, "list", false)
    if not list_only and not state.allow_exec {
        let d_json = diag_record_json("W5002", "usage", "error", "wysna_project_test execution requires starting MCP server with --allow-exec (pass list=true for static test discovery)", "<mcp>", 1, 1, "")
        return ["0", diag_tool_envelope_json("project.test", "usage_error", 2, "[" + d_json + "]", "", "", "[]")]
    }
    let mut base_argv: list[str] = ["project", "test", "--manifest", confined[1], "--output-format=json-v1"]
    if list_only { base_argv.append("--list") }
    if lsp_json_bool(arguments, "discover", false) { base_argv.append("--discover") }
    if lsp_json_bool(arguments, "frozen", false) { base_argv.append("--frozen") }
    let filt_v = lsp_json_get(arguments, "filter")
    if filt_v.kind == "str" and lsp_trim(filt_v.str_val) != "" {
        base_argv.append("--filter")
        base_argv.append(filt_v.str_val)
    }
    let case_v = lsp_json_get(arguments, "case")
    if case_v.kind == "str" and lsp_trim(case_v.str_val) != "" {
        base_argv.append("--case")
        base_argv.append(case_v.str_val)
    }
    let plan_v = lsp_json_get(arguments, "expect_plan_hash")
    if plan_v.kind == "str" and lsp_trim(plan_v.str_val) != "" {
        base_argv.append("--expect-plan-hash")
        base_argv.append(plan_v.str_val)
    }
    if list_only {
        let sub = mcp_run_subcommand(state, base_argv)
        if sub[1] == "" { return mcp_tool_err("project test --list produced no JSON (exit " + sub[0] + ")") }
        return ["0", sub[1]]
    }
    if state.sdk_driver == "" {
        let d_json = diag_record_json("W5002", "usage", "error", "project test requires the wysna native SDK driver", "<mcp>", 1, 1, "")
        return ["0", diag_tool_envelope_json("project.test", "usage_error", 2, "[" + d_json + "]", "", "", "[]")]
    }
    let sub = mcp_run_sdk_subcommand(state, base_argv)
    if sub[1] == "" { return mcp_tool_err("project test produced no JSON report (exit " + sub[0] + ")") }
    return ["0", sub[1]]
}

fn mcp_serialize_json_val(v: LspJson) -> str {
    if v.kind == "null" { return "null" }
    if v.kind == "bool" { return if v.bool_val { "true" } else { "false" } }
    if v.kind == "int" { return str(v.int_val) }
    if v.kind == "str" { return diag_json_quote(v.str_val) }
    if v.kind == "array" {
        let mut parts: list[str] = ["["]
        for i in 0..len(v.items) {
            if i > 0 { parts.append(",") }
            parts.append(mcp_serialize_json_val(v.items[i]))
        }
        parts.append("]")
        return join_strings(parts, "")
    }
    if v.kind == "object" {
        let mut parts: list[str] = ["{"]
        for i in 0..len(v.keys) {
            if i > 0 { parts.append(",") }
            parts.append(diag_json_quote(v.keys[i]) + ":" + mcp_serialize_json_val(v.vals[i]))
        }
        parts.append("}")
        return join_strings(parts, "")
    }
    return "null"
}

fn mcp_tool_patch(state: McpServerState, arguments: LspJson) -> list[str] {
    if lsp_json_has(arguments, "test") and lsp_json_get(arguments, "test").kind != "bool" {
        return mcp_tool_err("'test' must be a boolean")
    }
    let test = lsp_json_bool(arguments, "test", false)
    if test and (not state.allow_exec or state.sdk_driver == "") {
        let msg = if not state.allow_exec { "Tested patches require starting the MCP server with --allow-exec" }
            else { "Tested patches require the wysna native SDK driver" }
        let diagnostic = diag_record_json("W5002", "usage", "error", msg, "<mcp>", 1, 1, "")
        return ["0", diag_tool_envelope_json("patch", "usage_error", 2, "[" + diagnostic + "]", "", "", "[]")]
    }
    if lsp_json_has(arguments, "edits") or lsp_json_has(arguments, "manifest") {
        let man_v = lsp_json_get(arguments, "manifest")
        let edits_v = lsp_json_get(arguments, "edits")
        if man_v.kind != "str" or man_v.str_val == "" or edits_v.kind != "array" {
            return mcp_tool_err("workspace 'wysna_patch' requires 'manifest' and 'edits'")
        }
        if (lsp_json_has(arguments, "path") and lsp_json_get(arguments, "path").kind != "null") or
           (lsp_json_has(arguments, "symbol") and lsp_json_get(arguments, "symbol").kind != "null") or
           (lsp_json_has(arguments, "replacement") and lsp_json_get(arguments, "replacement").kind != "null") or
           (lsp_json_has(arguments, "expect_graph_hash") and lsp_json_get(arguments, "expect_graph_hash").kind != "null") {
            return mcp_tool_err("workspace 'wysna_patch' cannot combine single-symbol options with 'manifest'/'edits'")
        }
        let confined = mcp_confine_path(state.root, man_v.str_val)
        if confined[0] != "1" { return mcp_tool_err(confined[1]) }
        let tmp_edits = mcp_next_tmp(state, "wysna_mcp_edits", ".json")
        write_file(tmp_edits, mcp_serialize_json_val(edits_v)) else _err {
            return mcp_tool_err("failed writing workspace edits temp file")
        }
        let mut argv: list[str] = ["patch", "--manifest", confined[1], "--edits", tmp_edits, "--output-format=json-v1"]
        let plan_v = lsp_json_get(arguments, "expect_plan_hash")
        if plan_v.kind == "str" and plan_v.str_val != "" {
            argv.append("--expect-plan-hash")
            argv.append(plan_v.str_val)
        }
        if lsp_json_bool(arguments, "discover", false) { argv.append("--discover") }
        if lsp_json_bool(arguments, "frozen", false) { argv.append("--frozen") }
        if lsp_json_bool(arguments, "apply", false) { argv.append("--apply") }
        if test { argv.append("--test") }
        let sub = if test { mcp_run_sdk_subcommand(state, argv) } else { mcp_run_subcommand(state, argv) }
        lsp_remove_file(tmp_edits)
        if sub[1] == "" { return mcp_tool_err("tool produced no JSON (exit " + sub[0] + ")") }
        return ["0", sub[1]]
    }

    if test { return mcp_tool_err("'test' requires workspace 'manifest' and 'edits'") }
    let path_v = lsp_json_get(arguments, "path")
    let sym_v = lsp_json_get(arguments, "symbol")
    let rep_v = lsp_json_get(arguments, "replacement")
    if path_v.kind != "str" or path_v.str_val == "" or sym_v.kind != "str" or sym_v.str_val == "" or rep_v.kind != "str" or rep_v.str_val == "" {
        return mcp_tool_err("'wysna_patch' requires 'path', 'symbol', and 'replacement'")
    }
    let confined = mcp_confine_path(state.root, path_v.str_val)
    if confined[0] != "1" { return mcp_tool_err(confined[1]) }
    let resolved = confined[1]
    let _chk = read_file(resolved) else err {
        return mcp_tool_err("cannot read file: " + resolved)
    }
    let tmp_rep = mcp_next_tmp(state, "wysna_mcp_rep", ".wysna")
    write_file(tmp_rep, rep_v.str_val) else _err {
        return mcp_tool_err("failed writing patch replacement temp file")
    }
    let mut argv: list[str] = ["patch", resolved, "--symbol", sym_v.str_val, "--with-file", tmp_rep, "--output-format=json-v1"]
    let hash_v = lsp_json_get(arguments, "expect_graph_hash")
    if hash_v.kind == "str" and hash_v.str_val != "" {
        argv.append("--expect-graph-hash")
        argv.append(hash_v.str_val)
    }
    if lsp_json_bool(arguments, "apply", false) { argv.append("--apply") }
    let sub = mcp_run_subcommand(state, argv)
    lsp_remove_file(tmp_rep)
    if sub[1] == "" { return mcp_tool_err("tool produced no JSON (exit " + sub[0] + ")") }
    return ["0", sub[1]]
}

fn mcp_tool_fix(state: McpServerState, arguments: LspJson) -> list[str] {
    let apply = lsp_json_bool(arguments, "apply", false)
    let has_path = lsp_json_has(arguments, "path") and lsp_json_get(arguments, "path").kind != "null"
    if apply and not has_path {
        return mcp_tool_err("'apply' requires 'path'")
    }
    let rs = mcp_resolve_source(state, arguments)
    if rs[0] != "1" { return mcp_tool_err(rs[1]) }
    let mut argv: list[str] = ["fix", rs[1], "--output-format=json-v1"]
    if apply { argv.append("--apply") }
    if lsp_json_bool(arguments, "include_maybe", false) { argv.append("--include-maybe") }
    argv = mcp_with_overlay_flags(argv, rs)
    let sub = mcp_run_subcommand(state, argv)
    mcp_cleanup_source(rs)
    if sub[1] == "" { return mcp_tool_err("tool produced no JSON (exit " + sub[0] + ")") }
    let res_obj = fix_extract_json_object_field(sub[1], "result")
    if res_obj != "" { return ["0", res_obj] }
    return ["0", sub[1]]
}

fn mcp_tool_skills(arguments: LspJson) -> list[str] {
    let tv = lsp_json_get(arguments, "topic")
    let topic = if tv.kind == "str" and tv.str_val != "" { tv.str_val } else { "overview" }
    let payload = tool_skills_payload_json(topic)
    if payload == "" {
        return mcp_tool_err("Unknown skill topic '" + topic + "'. Available topics: agent-loop, contracts, graph, overview, patch, stdlib, syntax")
    }
    return ["0", diag_tool_envelope_json("skills", "ok", 0, "[]", "result", payload, "[]")]
}

fn mcp_tool_api(state: McpServerState, arguments: LspJson) -> list[str] {
    let mod_v = lsp_json_get(arguments, "module")
    let man_v = lsp_json_get(arguments, "manifest")
    let has_mod = lsp_json_has(arguments, "module") and mod_v.kind != "null"
    let has_man = lsp_json_has(arguments, "manifest") and man_v.kind != "null"
    if has_mod and mod_v.kind != "str" { return mcp_tool_err("'module' must be a string") }
    if has_man and man_v.kind != "str" { return mcp_tool_err("'manifest' must be a string") }
    let mut argv: list[str] = ["api", "--output-format=json-v1"]
    if has_mod and lsp_trim(mod_v.str_val) != "" {
        argv.append(mod_v.str_val)
    }
    if has_man and lsp_trim(man_v.str_val) != "" {
        let confined = mcp_confine_path(state.root, man_v.str_val)
        if confined[0] != "1" { return mcp_tool_err(confined[1]) }
        argv.append("--manifest")
        argv.append(confined[1])
    }
    let sub = mcp_run_subcommand(state, argv)
    if sub[1] == "" { return mcp_tool_err("tool produced no JSON (exit " + sub[0] + ")") }
    return ["0", sub[1]]
}

fn mcp_tools_list_json() -> str {
    let src_or_path = "\"path\":{\"type\":\"string\",\"description\":\"Path to a .wysna file inside the server root.\"},\"source\":{\"type\":\"string\",\"description\":\"Inline Wysna source text (alternative to path).\"}"
    let mut ts: list[str] = []
    ts.append("{\"name\":\"wysna_check\",\"description\":\"Type-check Wysna code. Returns every independent error with byte spans, expected/found facts and candidate fixes (wysna.tool-result/1).\",\"inputSchema\":{\"type\":\"object\",\"properties\":{" + src_or_path + "}}}")
    ts.append("{\"name\":\"wysna_fix\",\"description\":\"Compute (and optionally apply) machine-applicable fixes for diagnostics. Returns the corrected source and the diagnostics that remain.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{" + src_or_path + ",\"apply\":{\"type\":\"boolean\",\"description\":\"Write the fix to 'path' (default false).\"},\"include_maybe\":{\"type\":\"boolean\",\"description\":\"Also use heuristic 'maybe' fixes.\"}}}}")
    ts.append("{\"name\":\"wysna_fmt\",\"description\":\"Return the canonical formatting of Wysna code.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{" + src_or_path + "}}}")
    ts.append("{\"name\":\"wysna_explain\",\"description\":\"Static effect and capability report for a program.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{" + src_or_path + "}}}")
    ts.append("{\"name\":\"wysna_schema\",\"description\":\"Emit JSON Schema (Draft 2020-12) for structs/enums and LLM tool definitions with static effect/idempotency metadata for functions.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{" + src_or_path + ",\"all\":{\"type\":\"boolean\",\"description\":\"Include private top-level functions.\"},\"function\":{\"type\":\"string\",\"description\":\"Emit tool schema for a single function.\"},\"emit_codecs\":{\"type\":\"boolean\",\"description\":\"Generate Wysna JSON encoder/decoder functions.\"}}}}")
    ts.append("{\"name\":\"wysna_api\",\"description\":\"Discover standard-library modules and public symbols.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"module\":{\"type\":\"string\",\"description\":\"Optional module such as std/json.\"},\"manifest\":{\"type\":\"string\",\"description\":\"Optional path to a wysna.toml manifest inside the server root.\"}}}}")
    ts.append("{\"name\":\"wysna_capabilities\",\"description\":\"Installed commands, targets and their capability contracts.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{}}}")
    ts.append("{\"name\":\"wysna_graph\",\"description\":\"Compile-time semantic relationship graph (interfaces, classes, usages, calls, blast radius).\",\"inputSchema\":{\"type\":\"object\",\"properties\":{" + src_or_path + ",\"manifest\":{\"type\":\"string\",\"description\":\"Project manifest for an impact or architecture role query.\"},\"role\":{\"type\":\"string\",\"description\":\"Configured architecture role.\"},\"target\":{\"type\":\"string\",\"description\":\"Optional project target for the role query.\"},\"symbol\":{\"type\":\"string\",\"description\":\"Optional symbol name or node ID filter.\"},\"relation\":{\"type\":\"string\",\"description\":\"Optional relation filter: implements|hierarchy|usages|callers|callees|impact.\"}}}}")
    ts.append("{\"name\":\"wysna_inspect\",\"description\":\"Surgical, token-efficient symbol source slice (single or batch), contract, effects, call resolution, and dependency signatures.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{" + src_or_path + ",\"symbol\":{\"type\":\"string\",\"description\":\"Symbol name to extract (omit for compact index).\"},\"span\":{\"type\":\"object\",\"description\":\"Read bounded context at a diagnostic span. Requires path and the original source hash.\",\"required\":[\"source_id\",\"source_sha256\",\"start_byte\",\"end_byte\"],\"properties\":{\"source_id\":{\"type\":\"string\"},\"source_sha256\":{\"type\":\"string\"},\"start_byte\":{\"type\":\"integer\",\"minimum\":0},\"end_byte\":{\"type\":\"integer\",\"minimum\":0}}},\"symbols\":{\"type\":\"array\",\"items\":{\"type\":\"string\"},\"description\":\"Batch list of symbols to extract under one shared max_bytes budget.\"},\"with_deps\":{\"type\":\"boolean\",\"description\":\"Include signatures of referenced types and callees.\"},\"max_bytes\":{\"type\":\"integer\",\"minimum\":1,\"description\":\"Maximum UTF-8 byte budget for returned source/context.\"},\"source_offset\":{\"type\":\"integer\",\"minimum\":0,\"description\":\"UTF-8 byte offset within target symbol source.\"},\"offset\":{\"type\":\"integer\",\"minimum\":0,\"description\":\"Starting index offset when listing symbols.\"}}}}")
    ts.append("{\"name\":\"wysna_patch\",\"description\":\"Checked declaration-level or multi-file workspace patch (source, symbol, hunks, create, delete) guarded by graph/plan hash and in-memory typecheck.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\",\"description\":\"Path to a .wysna file inside the server root (single-symbol mode).\"},\"symbol\":{\"type\":\"string\",\"description\":\"Target declaration name or Class.method (single-symbol mode).\"},\"replacement\":{\"type\":\"string\",\"description\":\"Replacement declaration Wysna code (single-symbol mode).\"},\"expect_graph_hash\":{\"type\":\"string\",\"description\":\"Optional optimistic lock graph hash (single-symbol mode).\"},\"manifest\":{\"type\":\"string\",\"description\":\"Path to wysna.toml inside server root (workspace mode).\"},\"edits\":{\"type\":\"array\",\"description\":\"Array of workspace edit objects ({path, source|symbol+replacement|hunks|create+source|delete}) to check and apply together.\"},\"expect_plan_hash\":{\"type\":\"string\",\"description\":\"Plan hash from preview (required with apply=true in workspace mode).\"},\"discover\":{\"type\":\"boolean\",\"description\":\"Discover tests under tests/ (workspace mode).\"},\"frozen\":{\"type\":\"boolean\",\"description\":\"Verify wysna.lock before planning/applying (workspace mode).\"},\"test\":{\"type\":\"boolean\",\"description\":\"Run tests on the staged workspace. Requires --allow-exec.\"},\"apply\":{\"type\":\"boolean\",\"description\":\"Write verified patch to disk (default false).\"}}}}")
    ts.append("{\"name\":\"wysna_project_check\",\"description\":\"Static project-wide typecheck across wysna.toml targets and lockfile verification.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"manifest\":{\"type\":\"string\",\"description\":\"Path to wysna.toml inside server root.\"},\"target\":{\"type\":\"string\",\"description\":\"Optional target name from wysna.toml.\"},\"frozen\":{\"type\":\"boolean\",\"description\":\"Verify wysna.lock before checking.\"}},\"required\":[\"manifest\"]}}")
    ts.append("{\"name\":\"wysna_project_test\",\"description\":\"List test plans deterministically (list=true) or execute project tests when MCP server was started with --allow-exec.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"manifest\":{\"type\":\"string\",\"description\":\"Path to wysna.toml inside server root.\"},\"list\":{\"type\":\"boolean\",\"description\":\"Return static test plan and plan_hash without executing code.\"},\"discover\":{\"type\":\"boolean\",\"description\":\"Discover test files under tests/.\"},\"frozen\":{\"type\":\"boolean\",\"description\":\"Verify wysna.lock before listing or running tests.\"},\"filter\":{\"type\":\"string\",\"description\":\"Substring filter on test ID/name.\"},\"case\":{\"type\":\"string\",\"description\":\"Run only the specified test case ID.\"},\"expect_plan_hash\":{\"type\":\"string\",\"description\":\"Verify test selection against a previously listed plan_hash.\"}},\"required\":[\"manifest\"]}}")
    ts.append("{\"name\":\"wysna_skills\",\"description\":\"Version-matched concise coding and workflow guides embedded in Wysna.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"topic\":{\"type\":\"string\",\"description\":\"overview, agent-loop, syntax, graph, patch, contracts, stdlib.\"}}}}")
    return "{\"tools\":[" + join_strings(ts, ",") + "]}"
}

fn mcp_handle_tool_call(state: McpServerState, id_raw: str, params: LspJson) -> str {
    let name = lsp_json_str(params, "name", "")
    let known = name == "wysna_check" or name == "wysna_fix" or name == "wysna_fmt" or name == "wysna_explain" or name == "wysna_schema" or name == "wysna_api" or name == "wysna_capabilities" or name == "wysna_graph" or name == "wysna_inspect" or name == "wysna_patch" or name == "wysna_project_check" or name == "wysna_project_test" or name == "wysna_skills"
    if not known {
        return mcp_rpc_error(id_raw, -32602, "unknown tool: " + name)
    }
    let mut arguments = LspJson("object")
    if lsp_json_has(params, "arguments") {
        let raw_args = lsp_json_get(params, "arguments")
        if raw_args.kind != "null" {
            if raw_args.kind != "object" {
                return mcp_rpc_error(id_raw, -32602, "arguments must be an object")
            }
            arguments = raw_args
        }
    }
    let mut res: list[str] = ["1", "{}"]
    if name == "wysna_check" {
        res = mcp_exec_simple_source_tool(state, "check", arguments, [])
    } elif name == "wysna_fmt" {
        res = mcp_tool_fmt(state, arguments)
    } elif name == "wysna_explain" {
        res = mcp_exec_simple_source_tool(state, "explain", arguments, [])
    } elif name == "wysna_schema" {
        res = mcp_tool_schema(state, arguments)
    } elif name == "wysna_api" {
        res = mcp_tool_api(state, arguments)
    } elif name == "wysna_capabilities" {
        res = ["0", diag_tool_envelope_json("capabilities", "ok", 0, "[]", "result", tool_capabilities_payload_json(), "[]")]
    } elif name == "wysna_graph" {
        res = mcp_tool_graph(state, arguments)
    } elif name == "wysna_inspect" {
        res = mcp_tool_inspect(state, arguments)
    } elif name == "wysna_patch" {
        res = mcp_tool_patch(state, arguments)
    } elif name == "wysna_project_check" {
        res = mcp_tool_project_check(state, arguments)
    } elif name == "wysna_project_test" {
        res = mcp_tool_project_test(state, arguments)
    } elif name == "wysna_fix" {
        res = mcp_tool_fix(state, arguments)
    } elif name == "wysna_skills" {
        res = mcp_tool_skills(arguments)
    }
    let failed_flag = if res[0] == "1" { "true" } else { "false" }
    let call_res = "{\"content\":[{\"type\":\"text\",\"text\":" + diag_json_quote(res[1]) + "}],\"isError\":" + failed_flag + "}"
    return mcp_rpc_result(id_raw, call_res)
}

fn mcp_handle_message(state: McpServerState, msg: LspJson) -> str {
    if msg.kind != "object" or lsp_json_str(msg, "jsonrpc", "") != "2.0" {
        return mcp_rpc_error("null", -32600, "invalid request")
    }
    let has_id = lsp_json_has(msg, "id")
    let id_val = lsp_json_get(msg, "id")
    if not has_id or id_val.kind == "null" {
        return ""
    }
    let id_raw = lsp_json_raw_literal(id_val)
    let method = lsp_json_str(msg, "method", "")
    let params = lsp_json_get(msg, "params")
    if method == "initialize" {
        let pv = lsp_json_str(params, "protocolVersion", "2025-06-18")
        return mcp_rpc_result(id_raw, "{\"protocolVersion\":" + diag_json_quote(pv) + (",\"capabilities\":{\"tools\":{}},\"serverInfo\":{\"name\":\"wysna\",\"version\":\"" + tool_compiler_version() + "\"}}"))
    }
    if method == "ping" {
        return mcp_rpc_result(id_raw, "{}")
    }
    if method == "tools/list" {
        return mcp_rpc_result(id_raw, mcp_tools_list_json())
    }
    if method == "tools/call" {
        return mcp_handle_tool_call(state, id_raw, params)
    }
    return mcp_rpc_error(id_raw, -32601, "method not found: " + method)
}

fn mcp_serve(args: list[str]) -> unit {
    let mut root_arg = ""
    let mut allow_exec = false
    let mut i = 1
    while i < len(args) {
        let a = args[i]
        if a == "--root" and i + 1 < len(args) and root_arg == "" {
            root_arg = args[i + 1]
            i = i + 2
        } elif a == "--allow-exec" {
            allow_exec = true
            i = i + 1
        } else {
            eprint("usage: wysna mcp [--root <dir>] [--allow-exec]")
            exit(2)
        }
    }
    let raw_root = if root_arg != "" { root_arg } else { mcp_getcwd() }
    let root = module_canonical_resolved(raw_root)
    if root == "" {
        eprint("wysna mcp: invalid root directory: " + raw_root)
        exit(2)
    }
    let driver_opt = env("WYSNA_SDK_DRIVER")
    let sdk_driver = match driver_opt { Some(d) => d, None => "" }
    let state = McpServerState(root, lsp_compiler_exe_path(), lsp_stdlib_root_arg(), lsp_tmp_dir(), allow_exec, sdk_driver)
    while true {
        let buf = wysna_host_buffer_new()
        let st = wysna_host_stdin_read_line(buf)
        if st <= 0 {
            wysna_host_close(buf)
            break
        }
        let line_len = lsp_buf_read_line_len(buf)
        let line = lsp_trim(lsp_buf_to_str(buf, line_len))
        wysna_host_close(buf)
        if line == "" { continue }
        let msg = mcp_parse_json_strict(line)
        if msg.kind == "error" {
            mcp_write_line(mcp_rpc_error("null", -32700, "parse error"))
            continue
        }
        let resp = mcp_handle_message(state, msg)
        if resp != "" { mcp_write_line(resp) }
    }
    exit(0)
}
fn selfhost_json_quote(s: str) -> str {
    let mut out = "\""
    let n = len(s)
    for i in 0..n {
        let ch = s[i]
        let code = ord(ch)
        if code == 34 { out = out + "\\\"" }
        elif code == 92 { out = out + "\\\\" }
        elif code == 10 { out = out + "\\n" }
        elif code == 13 { out = out + "\\r" }
        elif code == 9 { out = out + "\\t" }
        else { out = out + ch }
    }
    return out + "\""
}

fn run_compiler() -> unit ! IoError {
    let raw_cli = args()
    let clean = diag_clean_cli_args()
    if len(clean) == 0 {
        eprint("[W5002] Usage: Wysna Compiler INPUT OUTPUT")
        exit(2)
    }
    let json_v1 = diag_cli_json_mode() == "json-v1"
    let cmd = clean[0]
    if cmd == "--version" or cmd == "-v" {
        if len(clean) != 1 { eprint("[W5002] Usage: Wysna Compiler --version") exit(2) }
        print(("wysna " + tool_compiler_version()))
        return
    }
    if cmd == "graph" {
        tool_handle_graph(clean, json_v1)
        return
    }
    if cmd == "inspect" {
        tool_handle_inspect(clean, json_v1)
        return
    }
    if cmd == "patch" {
        tool_handle_patch(clean, json_v1)
        return
    }
    if cmd == "explain" {
        tool_handle_explain(clean, json_v1)
        return
    }
    if cmd == "skills" {
        tool_handle_skills(clean, json_v1)
        return
    }
    if cmd == "capabilities" {
        tool_handle_capabilities(clean, json_v1)
        return
    }
    if cmd == "api" {
        tool_handle_api(clean, json_v1)
        return
    }
    if cmd == "project" {
        tool_handle_project(clean, json_v1)
        return
    }
    if cmd == "packages" {
        tool_handle_packages(clean, json_v1)
        return
    }
    if cmd == "schema" {
        tool_handle_schema(clean, json_v1)
        return
    }
    if cmd == "fix" {
        tool_handle_fix(clean, json_v1)
        return
    }
    if cmd == "mcp" {
        mcp_serve(clean)
        return
    }
    if cmd == "lsp" {
        lsp_serve()
        return
    }
    if cmd == "check" {
        let mut target = ""
        let mut legacy = false
        let mut i = 1
        while i < len(clean) {
            let a = clean[i]
            if a == "--output-format=json-v1" { i = i + 1 }
            elif a == "--output-format" and i + 1 < len(clean) { i = i + 2 }
            elif a == "--json" { legacy = true i = i + 1 }
            elif len(a) > 0 and a[0] != "-" and target == "" { target = a i = i + 1 }
            else { report_error("<cli>", "W5002", 1, 1, "unknown option for check: " + a) }
        }
        if target == "" { report_error("<cli>", "W5002", 1, 1, "check requires a source file path") }
        tool_handle_check_v1(target, legacy, json_v1)
        return
    }
    if cmd == "fmt" {
        let mut target = ""
        let mut write_in_place = false
        let mut i = 1
        while i < len(clean) {
            let a = clean[i]
            if a == "--output-format=json-v1" { i = i + 1 }
            elif a == "--output-format" and i + 1 < len(clean) { i = i + 2 }
            elif a == "--write" or a == "-w" { write_in_place = true i = i + 1 }
            elif len(a) > 0 and a[0] != "-" and target == "" { target = a i = i + 1 }
            else { report_error("<cli>", "W5002", 1, 1, "unknown option for fmt: " + a) }
        }
        if target == "" { report_error("<cli>", "W5002", 1, 1, "fmt requires a source file path") }
        let loaded = module_read_text_or_overlay(target)
        if loaded[0] != "1" {
            report_error(target, "W5003", 1, 1, "cannot read input file: " + target)
        }
        let source = loaded[1]
        let body = selfhost_format_body(source, target)
        let formatted = if len(body) > 0 { body + "\n" } else { "" }
        if write_in_place { write_file(target, formatted)? }
        if json_v1 {
            tool_emit_fmt_v1(formatted, target, write_in_place)
        } elif write_in_place {
            print("Formatted", target)
        } else {
            print(body)
        }
        return
    }
    let mut cli: list[str] = [raw_cli[0]]
    for item in clean { cli.append(item) }
    if len(cli) > 1 and (cli[1] == "--check" or cli[1] == "--check-json") {
        let mut in_path = ""
        let mut i = 2
        while i < len(cli) {
            let a = cli[i]
            if a == "--output-format=json-v1" { i = i + 1 }
            elif a == "--output-format" and i + 1 < len(cli) { i = i + 2 }
            elif len(a) > 0 and a[0] != "-" and in_path == "" { in_path = a i = i + 1 }
            else {
                eprint("[W5002] Usage: Wysna Compiler --check INPUT")
                exit(2)
            }
        }
        if in_path == "" {
            eprint("[W5002] Usage: Wysna Compiler --check INPUT")
            exit(2)
        }
        tool_handle_check_v1(in_path, cli[1] == "--check-json", json_v1)
        return
    }
    if len(cli) > 1 and (cli[1] == "--fmt" or cli[1] == "--fmt-write") {
        let mut in_path = ""
        let mut i = 2
        while i < len(cli) {
            let a = cli[i]
            if a == "--output-format=json-v1" { i = i + 1 }
            elif a == "--output-format" and i + 1 < len(cli) { i = i + 2 }
            elif len(a) > 0 and a[0] != "-" and in_path == "" { in_path = a i = i + 1 }
            else {
                eprint("[W5002] Usage: Wysna Compiler --fmt INPUT")
                exit(2)
            }
        }
        if in_path == "" {
            eprint("[W5002] Usage: Wysna Compiler --fmt INPUT")
            exit(2)
        }
        let source = read_file(in_path)?
        let body = selfhost_format_body(source, in_path)
        let formatted = if len(body) > 0 { body + "\n" } else { "" }
        if cli[1] == "--fmt-write" {
            write_file(in_path, formatted)?
            if json_v1 { tool_emit_fmt_v1(formatted, in_path, true) }
            else { print("Formatted", in_path) }
        } else {
            if json_v1 { tool_emit_fmt_v1(formatted, in_path, false) }
            else { print(body) }
        }
        return
    }
    if len(cli) > 1 and (cli[1] == "--emit-mir" or cli[1] == "--emit-c-mir" or cli[1] == "--check-mir") {
        let mode_flag = cli[1]
        let mut sandbox_on = false
        let mut allow_raw = ""
        let mut deny_raw = ""
        let mut has_allow = false
        let mut has_deny = false
        let mut positional: list[str] = []
        let mut ci = 2
        while ci < len(cli) {
            let arg = cli[ci]
            if arg == "--sandbox" { sandbox_on = true ci = ci + 1 }
            elif arg == "--allow" and ci + 1 < len(cli) {
                if has_allow { eprint("[W5002] Duplicate --allow option") exit(2) }
                has_allow = true allow_raw = cli[ci + 1] ci = ci + 2
            } elif len(arg) > 8 and slice(arg, 0, 8) == "--allow=" {
                if has_allow { eprint("[W5002] Duplicate --allow option") exit(2) }
                has_allow = true allow_raw = slice(arg, 8, len(arg)) ci = ci + 1
            } elif arg == "--deny" and ci + 1 < len(cli) {
                if has_deny { eprint("[W5002] Duplicate --deny option") exit(2) }
                has_deny = true deny_raw = cli[ci + 1] ci = ci + 2
            } elif len(arg) > 7 and slice(arg, 0, 7) == "--deny=" {
                if has_deny { eprint("[W5002] Duplicate --deny option") exit(2) }
                has_deny = true deny_raw = slice(arg, 7, len(arg)) ci = ci + 1
            } elif arg == "--output-format=json-v1" { ci = ci + 1 }
            elif arg == "--output-format" and ci + 1 < len(cli) { ci = ci + 2 }
            else { positional.append(arg) ci = ci + 1 }
        }
        if has_allow and has_deny { report_error("<cli>", "W5002", 1, 1, "cannot combine --allow and --deny") }
        if (sandbox_on or has_allow or has_deny) and mode_flag != "--emit-c-mir" {
            report_error("<cli>", "W5002", 1, 1, "--sandbox/--allow/--deny is supported only with --emit-c-mir")
        }
        if (len(positional) != 1 and len(positional) != 2) or (mode_flag == "--check-mir" and len(positional) != 1) {
            eprint("[W5002] Usage: Wysna Compiler --emit-mir INPUT")
            exit(2)
        }
        let in_file = positional[0]
        let source = read_file(in_file)?
        let checked = check_source(source, in_file)
        let module = if mode_flag == "--check-mir" { mir_build(checked) } else { mir_build_optimized(checked) }
        if mode_flag == "--check-mir" {
            mir_verify(module)
            let warnings = lint_collect_warnings(checked, source, in_file)
            lint_print_warnings_stderr(warnings)
        } else {
            let mut prefix = ""
            if sandbox_on or has_allow or has_deny {
                let s_mode = if has_deny { "deny" } else { "allow" }
                let s_caps = if has_deny { sandbox_parse_cap_list(deny_raw) } elif has_allow { sandbox_parse_cap_list(allow_raw) } else { sandbox_default_capabilities() }
                prefix = sandbox_enforce_and_header(module, in_file, s_mode, s_caps)
            }
            let output = if mode_flag == "--emit-mir" { mir_module_json(module) } else { prefix + mir_emit_c(module) }
            if len(positional) == 2 {
                if module_normalize(in_file) == module_normalize(positional[1]) { eprint("[W5002] Output must differ from input") exit(2) }
                write_file(positional[1], output)?
            } else { print(output) }
        }
        return
    }
    if len(cli) != 3 { eprint("[W5002] Usage: Wysna Compiler INPUT OUTPUT") exit(2) }
    let in_path = cli[1]
    let out_path = cli[2]
    if module_normalize(in_path) == module_normalize(out_path) { eprint("[W5002] Output must differ from input") exit(2) }
    let src = read_file(in_path)?
    let checked = check_source(src, in_path)
    let c_code = compile_source(checked)
    write_file(out_path, c_code)?
    print("[Wysna Compiler] Compiled", in_path, "->", out_path)
}

let res = run_compiler() else err {
    eprint("[W4003] Wysna Compiler I/O error:", err.message)
    exit(1)
}
