struct Token {
    kind: str,
    val: str,
    line: int,
    col: int,
    file: str,
}

# Standalone semantic parsing. Types are interned structures, never fixture names.
struct SemType { kind: str, name: str, args: list[int] }
struct SemGenericType { name: str, kind: str, params: list[str], constraints: list[str] }
struct SemVar { name: str, type_id: int, mutable: bool, depth: int, binding: int, source: Token }
struct AttributeArgument { name: str, kind: str, value: str }
struct StaticAttribute { name: str, message: str, arguments: list[AttributeArgument], source: Token, schema_file: str, schema_name: str }
struct SemFunction { source: Token, declaration_name: str, attributes: list[StaticAttribute], abi_params: list[str], abi_return: str, name: str, params: list[str], type_params: list[str], constraints: list[str], type_id: int, body: int, end: int, owner: str, visible: bool, contract_start: int, is_async: bool }
struct SemField { source: Token, owner: str, name: str, type_id: int, visible: bool, requires: list[Token] }
struct SemInterfaceRef { name: str, args: list[int] }
struct SemClass { name: str, parent: str, parent_args: list[int], interfaces: list[SemInterfaceRef] }
struct SemValue { type_id: int, root: str, writable: int, terminates: bool, node: int }
struct SemFlow { type_id: int, terminates: bool, node: int }


struct SemPattern { name: str, children: list[int], type_id: int, binding: int, source: Token }
struct SemConstructor { name: str, payloads: list[int] }

struct SemObligation { function: str, kind: str, types: list[int], source: Token }
struct SemSpecialization { template: int, arguments: list[int], function: int, ancestry: list[int] }

# Each inference operation owns its substitutions, including nested initializers.
class SemUnification { names: list[str], types: list[int] }
# Deterministic diagnostics, UTF-8 byte-span calculation, and SHA-256 helpers shared by all compiler stages.
extern "C" fn wysna_host_buffer_new() -> opaque
extern "C" fn wysna_host_buffer_append(handle: opaque, value: int) -> int
extern "C" fn wysna_host_buffer_get(handle: opaque, index: int) -> int
extern "C" fn wysna_host_crypto_sha256(input_handle: opaque, output_handle: opaque) -> int
extern "C" fn wysna_host_crypto_random_bytes(output_handle: opaque, count: int) -> int
extern "C" fn wysna_host_close(handle: opaque) -> int

fn diag_uuid4() -> str {
    let buf = wysna_host_buffer_new()
    let st = wysna_host_crypto_random_bytes(buf, 16)
    if st != 0 {
        wysna_host_close(buf)
        return "native"
    }
    let mut parts: list[str] = []
    for i in 0..16 {
        let mut b = wysna_host_buffer_get(buf, i)
        if b < 0 { b = 0 }
        if i == 6 { b = (b % 16) + 64 }
        elif i == 8 { b = (b % 64) + 128 }
        parts.append(diag_hex_digit((b / 16) % 16) + diag_hex_digit(b % 16))
        if i == 3 or i == 5 or i == 7 or i == 9 { parts.append("-") }
    }
    wysna_host_close(buf)
    return join_strings(parts, "")
}

fn diag_hex_digit(n: int) -> str {
    let digits = "0123456789abcdef"
    if n < 0 or n >= 16 { return "0" }
    return digits[n]
}

fn diag_sha256_hex(text: str) -> str {
    let input = wysna_host_buffer_new()
    let output = wysna_host_buffer_new()
    for b in bytes(text) {
        wysna_host_buffer_append(input, b)
    }
    let status = wysna_host_crypto_sha256(input, output)
    let mut parts: list[str] = []
    if status == 0 {
        for i in 0..32 {
            let v = wysna_host_buffer_get(output, i)
            let hi = (v / 16) % 16
            let lo = v % 16
            parts.append(diag_hex_digit(hi) + diag_hex_digit(lo))
        }
    }
    wysna_host_close(input)
    wysna_host_close(output)
    return join_strings(parts, "")
}

fn diag_json_quote(s: str) -> str {
    let mut parts: list[str] = ["\""]
    let n = len(s)
    for i in 0..n {
        let ch = s[i]
        let code = ord(ch)
        if code == 34 {
            parts.append("\\\"")
        } elif code == 92 {
            parts.append("\\\\")
        } elif code == 8 {
            parts.append("\\b")
        } elif code == 12 {
            parts.append("\\f")
        } elif code == 10 {
            parts.append("\\n")
        } elif code == 13 {
            parts.append("\\r")
        } elif code == 9 {
            parts.append("\\t")
        } elif code >= 0 and code < 32 {
            parts.append("\\u00" + diag_hex_digit(code / 16) + diag_hex_digit(code % 16))
        } else {
            parts.append(ch)
        }
    }
    parts.append("\"")
    return join_strings(parts, "")
}

fn diag_stage_for_code(code: str) -> str {
    if code == "W0001" or code == "W0002" or code == "W0003" or code == "W0004" or code == "W0005" {
        return "lexer"
    }
    if code == "W0006" { return "syntax" }
    if len(code) >= 2 and code[0] == "W" and code[1] == "1" { return "semantic" }
    if len(code) >= 2 and code[0] == "W" and (code[1] == "2" or code[1] == "3") { return "type" }
    if len(code) >= 2 and code[0] == "W" and code[1] == "4" { return "runtime" }
    if code == "W5005" { return "patch" }
    if code == "W5006" { return "capability-policy" }
    if len(code) >= 2 and code[0] == "W" and code[1] == "5" { return "toolchain" }
    if len(code) >= 2 and code[0] == "W" and code[1] == "6" { return "lint" }
    return "internal"
}

fn diag_char_offset_at(src: str, target_line: int, target_col: int) -> int {
    if target_line < 1 or target_col < 1 { return -1 }
    let n = len(src)
    let mut line = 1
    let mut i = 0
    while line < target_line and i < n {
        let code = ord(src[i])
        if code == 13 {
            if i + 1 < n and ord(src[i + 1]) == 10 { i = i + 2 } else { i = i + 1 }
            line = line + 1
        } elif code == 10 {
            i = i + 1
            line = line + 1
        } else {
            i = i + 1
        }
    }
    if line < target_line { return -1 }
    let mut line_end = i
    while line_end < n {
        let c = ord(src[line_end])
        if c == 10 or c == 13 { break }
        line_end = line_end + 1
    }
    let col_pos = i + target_col - 1
    return if col_pos <= line_end { col_pos } else { line_end }
}

fn diag_utf8_byte_at(src: str, char_pos: int) -> int {
    if char_pos <= 0 { return 0 }
    let clamped = if char_pos > len(src) { len(src) } else { char_pos }
    return len(bytes(slice(src, 0, clamped)))
}

fn diag_char_span_width(src: str, start_char: int) -> int {
    let n = len(src)
    if start_char < 0 or start_char >= n { return start_char }
    let c = ord(src[start_char])
    if c == 10 or c == 13 { return start_char }
    let mut end_c = start_char + 1
    let is_word = (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or (c >= 48 and c <= 57) or c == 95
    if is_word {
        while end_c < n {
            let ch = ord(src[end_c])
            if (ch >= 65 and ch <= 90) or (ch >= 97 and ch <= 122) or (ch >= 48 and ch <= 57) or ch == 95 {
                end_c = end_c + 1
            } else {
                break
            }
        }
    } elif c == 34 {
        while end_c < n {
            let ch = ord(src[end_c])
            if ch == 10 or ch == 13 { break }
            if ch == 92 and end_c + 1 < n {
                end_c = end_c + 2
                continue
            }
            end_c = end_c + 1
            if ch == 34 { break }
        }
    }
    return end_c
}

fn diag_primary_span_json(file: str, line: int, col: int, src: str) -> str {
    if file == "" or src == "" or line < 1 or col < 1 { return "null" }
    let start_char = diag_char_offset_at(src, line, col)
    if start_char < 0 { return "null" }
    let end_char = diag_char_span_width(src, start_char)
    let start_byte = diag_utf8_byte_at(src, start_char)
    let end_byte = diag_utf8_byte_at(src, end_char)
    let sha = diag_sha256_hex(src)
    return "{\"source_id\":" + diag_json_quote(file) + ",\"source_sha256\":" + diag_json_quote(sha) + ",\"start_byte\":" + str(start_byte) + ",\"end_byte\":" + str(end_byte) + "}"
}

fn diag_related_record_json(message: str, file: str, line: int, col: int) -> str {
    let src = if file != "" and file != "<stdin>" and file != "<unknown>" and file != "<cli>" {
        diag_read_snippet_source(file)
    } else { "" }
    let span_json = diag_primary_span_json(file, line, col, src)
    return "{\"message\":" + diag_json_quote(message) + ",\"line\":" + str(line) + ",\"col\":" + str(col) + ",\"span\":" + span_json + "}"
}

fn diag_record_json(code: str, stage: str, severity: str, msg: str, file: str, line: int, col: int, src: str) -> str {
    let data_json = if stage == "type" { fix_mismatch_data_json(msg) } else { "{}" }
    return diag_record_json_full(code, stage, severity, msg, file, line, col, src, data_json, "[]")
}

fn diag_record_json_data(code: str, stage: str, severity: str, msg: str, file: str, line: int, col: int, src: str, data_json: str) -> str {
    return diag_record_json_full(code, stage, severity, msg, file, line, col, src, data_json, "[]")
}

fn diag_record_json_full(code: str, stage: str, severity: str, msg: str, file: str, line: int, col: int, src: str, data_json: str, related_json: str) -> str {
    let span_json = diag_primary_span_json(file, line, col, src)
    let fixes_json = if span_json != "null" { fix_diagnostic_edits_json(code, msg, file, src, line, col) } else { "[]" }
    return "{\"code\":" + diag_json_quote(code) + ",\"severity\":" + diag_json_quote(severity) + ",\"stage\":" + diag_json_quote(stage) + ",\"message\":" + diag_json_quote(msg) + ",\"primary_span\":" + span_json + ",\"related\":" + related_json + ",\"data\":" + data_json + ",\"fixes\":" + fixes_json + "}"
}

fn diag_tool_envelope_json(command: str, status: str, exit_code: int, diagnostics_json: str, result_key: str, result_json: str, artifacts_json: str) -> str {
    let mut parts: list[str] = ["{\"schema_version\":\"wysna.tool-result/1\""]
    parts.append(",\"command\":" + diag_json_quote(command))
    parts.append(",\"status\":" + diag_json_quote(status))
    parts.append(",\"invocation_id\":" + diag_json_quote(diag_uuid4()))
    parts.append(",\"tool_exit_code\":" + str(exit_code))
    parts.append(",\"process_exit_code\":" + str(exit_code))
    parts.append(",\"execution\":null")
    parts.append((",\"toolchain\":{\"compiler\":\"" + tool_compiler_version() + "\"}"))
    parts.append(",\"target\":{\"profile\":\"native-cli\",\"triple\":null}")
    parts.append(",\"diagnostics\":" + diagnostics_json)
    parts.append(",\"artifacts\":" + artifacts_json)
    parts.append(",\"telemetry\":null")
    if result_key != "" {
        parts.append("," + diag_json_quote(result_key) + ":" + result_json)
    }
    parts.append("}")
    return join_strings(parts, "")
}

fn diag_clean_cli_args() -> list[str] {
    let raw = args()
    let mut clean: list[str] = []
    let mut i = 1
    while i < len(raw) {
        if raw[i] == "--diag-array" { i = i + 1 }
        elif (raw[i] == "--stdlib-root" or raw[i] == "--diag-out" or raw[i] == "--project-sources-root") and i + 1 < len(raw) {
            i = i + 2
        } elif (raw[i] == "--overlay" or raw[i] == "--project-dep") and i + 2 < len(raw) {
            i = i + 3
        } else {
            clean.append(raw[i])
            i = i + 1
        }
    }
    return clean
}

fn diag_out_path() -> str {
    let raw = args()
    let mut i = 1
    while i < len(raw) {
        if raw[i] == "--diag-out" and i + 1 < len(raw) { return raw[i + 1] }
        i = i + 1
    }
    return ""
}

fn diag_write_output(payload: str) -> unit {
    let out = diag_out_path()
    if out != "" {
        write_file(out, payload) else err {
            print(payload)
            return
        }
        return
    }
    print(payload)
}

fn diag_read_snippet_source(file: str) -> str {
    let raw = args()
    let mut i = 1
    while i < len(raw) {
        if raw[i] == "--overlay" and i + 2 < len(raw) {
            if raw[i + 1] == file {
                return read_file(raw[i + 2]) else error { "" }
            }
            i = i + 3
        } else {
            i = i + 1
        }
    }
    return read_file(file) else error { "" }
}

fn diag_cli_json_mode() -> str {
    for value in args() { if value == "--diag-array" { return "array" } }
    let clean = diag_clean_cli_args()
    if len(clean) > 0 and clean[0] == "api" { return "json-v1" }
    for i in 0..len(clean) {
        if clean[i] == "--check-json" { return "check-json" }
        if clean[i] == "--output-format=json-v1" { return "json-v1" }
        if clean[i] == "--output-format" and i + 1 < len(clean) and clean[i + 1] == "json-v1" { return "json-v1" }
        if len(clean) > 0 and clean[0] == "schema" and clean[i] == "--json" { return "json-v1" }
    }
    return ""
}

fn diag_cli_command() -> str {
    let clean = diag_clean_cli_args()
    if len(clean) == 0 { return "check" }
    let first = clean[0]
    if first == "check" or first == "--check" or first == "--check-json" { return "check" }
    if first == "fmt" or first == "--fmt" or first == "--fmt-write" { return "fmt" }
    if first == "api" { return "api" }
    if first == "project" {
        if len(clean) > 1 {
            if clean[1] == "check" or clean[1] == "build" or clean[1] == "run" or clean[1] == "test" {
                return "project." + clean[1]
            }
        }
        return "project"
    }
    if first == "graph" or first == "inspect" or first == "patch" or first == "explain" or first == "lsp" or first == "schema" or first == "fix" or first == "skills" or first == "capabilities" or first == "mcp" { return first }
    if first == "--emit-c-mir" or first == "--emit-mir" or first == "--check-mir" { return "build" }
    return "check"
}

fn diag_render_source_excerpt(src: str, target_line: int, target_col: int) -> str {
    if src == "" or target_line < 1 or target_col < 1 { return "" }
    let n = len(src)
    let mut cur = 1
    let mut i = 0
    while cur < target_line and i < n {
        let code = ord(src[i])
        if code == 13 {
            if i + 1 < n and ord(src[i + 1]) == 10 { i = i + 2 } else { i = i + 1 }
            cur = cur + 1
        } elif code == 10 {
            i = i + 1
            cur = cur + 1
        } else {
            i = i + 1
        }
    }
    if cur != target_line { return "" }
    let mut end_i = i
    while end_i < n {
        let c = ord(src[end_i])
        if c == 10 or c == 13 { break }
        end_i = end_i + 1
    }
    let text = slice(src, i, end_i)
    let line_label = str(target_line)
    let mut pad_parts: list[str] = []
    for _k in 0..len(line_label) { pad_parts.append(" ") }
    let mut caret_parts: list[str] = []
    let mut spaces = target_col - 1
    if spaces < 0 { spaces = 0 }
    if spaces > len(text) { spaces = len(text) }
    for _s in 0..spaces { caret_parts.append(" ") }
    let start_char = i + spaces
    let end_char = diag_char_span_width(src, start_char)
    let mut width = end_char - start_char
    if width < 1 { width = 1 }
    for _c in 0..width { caret_parts.append("^") }
    return line_label + " | " + text + "\n" + join_strings(pad_parts, "") + " | " + join_strings(caret_parts, "")
}

struct CollectedDiag {
    file: str,
    code: str,
    line: int,
    col: int,
    msg: str,
    data: str,
    related_json: str,
}

fn diag_emit_and_exit(file: str, code: str, line: int, col: int, msg: str) -> unit {
    diag_emit_and_exit_full(file, code, line, col, msg, "", "[]")
}

fn diag_emit_and_exit_data(file: str, code: str, line: int, col: int, msg: str, data: str) -> unit {
    diag_emit_and_exit_full(file, code, line, col, msg, data, "[]")
}

fn diag_emit_and_exit_full(file: str, code: str, line: int, col: int, msg: str, data: str, related_json: str) -> unit {
    diag_emit_all_and_exit([CollectedDiag {
        file: file,
        code: code,
        line: line,
        col: col,
        msg: msg,
        data: data,
        related_json: related_json,
    }])
}

fn diag_has(h: str, needle: str) -> bool {
    let m = len(needle)
    for i in 0..(len(h) - m + 1) { if slice(h, i, i + m) == needle { return true } }
    return m == 0
}
fn diag_help_field(d: str) -> str {
    for i in 0..(len(d) - 8) { if slice(d, i, i + 8) == "\"help\":\"" {
        let mut k = i + 8
        let mut out: list[str] = []
        while k < len(d) and ord(d[k]) != 34 {
            if ord(d[k]) == 92 and k + 1 < len(d) { out.append(d[k + 1]) k = k + 2 } else { out.append(d[k]) k = k + 1 }
        }
        return join_strings(out, "")
    } }
    return ""
}
fn diag_human_help(code: str, msg: str, data_json: str) -> str {
    let h = diag_help_field(data_json)
    if h != "" { return h }
    if code == "W1001" { if diag_has(msg, "ambiguous enum") { return "Qualify the enum variant with its enum name, e.g. MyEnum.Variant." } elif diag_has(msg, "unknown module") { return "Check the module path ('std/...' for stdlib or verify the local path)." } elif diag_has(msg, "unknown identifier") { return "Declare the binding with 'let'/'let mut', define the function, or import it." } }
    if code == "W2001" { if diag_has(msg, "'int'") and diag_has(msg, "'float'") { return "Convert explicitly using int(...) or float(...) before mixing int and float." } elif diag_has(msg, "expected 'str'") { return "Convert the value to a string with str(...)." } elif diag_has(msg, "binary operand types") { return "Operands must have matching types; convert explicitly with int(...), float(...), or str(...)." } }
    if (code == "W2003" or code == "W3001") and diag_has(msg, "immutable") { return "Declare the variable as 'let mut ...' if it needs to be reassigned." }
    if code == "W3002" and diag_has(msg, "unknown member") { return "Verify the field or method name on the receiver type, or run 'wysna inspect'." }
    if (code == "W2004" or code == "W2006") and diag_has(msg, "propagation operand") { return "The '?' operator requires Result[T, E] or Option[T] in a compatible function." }
    if code == "W1002" or code == "W1003" { return "Check for missing delimiters ('}', ')', ']') or unexpected tokens nearby." } elif code == "W2002" { return "Check the function signature for expected argument count." } elif code == "W2005" { return "Handle every variant or add a fallback '_' arm." } elif code == "W2007" { return "Provide every required struct field in the literal." } elif code == "W2009" { return "Add an explicit type annotation so the compiler can resolve the type." }
    return ""
}

fn diag_emit_all_and_exit(diags: list[CollectedDiag]) -> unit {
    if len(diags) == 0 { exit(1) }
    let mode = diag_cli_json_mode()
    if mode == "" {
        for d in diags {
            let mut src = ""
            if d.file != "" and d.file != "<stdin>" and d.file != "<unknown>" and d.file != "<cli>" {
                src = diag_read_snippet_source(d.file)
            }
            eprint("[" + d.code + "] " + d.file + ":" + str(d.line) + ":" + str(d.col) + " - " + d.msg)
            let excerpt = diag_render_source_excerpt(src, d.line, d.col)
            if excerpt != "" { eprint(excerpt) }
            let help_text = diag_human_help(d.code, d.msg, d.data)
            if help_text != "" { eprint("  help: " + help_text) }
        }
        exit(1)
    }
    let mut records: list[str] = []
    for d in diags {
        let mut src = ""
        if d.file != "" and d.file != "<stdin>" and d.file != "<unknown>" and d.file != "<cli>" {
            src = diag_read_snippet_source(d.file)
        }
        let stage = diag_stage_for_code(d.code)
        let eff_data = if d.data == "" {
            if stage == "type" { fix_mismatch_data_json(d.msg) } else { "{}" }
        } else { d.data }
        let rel = if d.related_json == "" { "[]" } else { d.related_json }
        records.append(diag_record_json_full(d.code, stage, "error", d.msg, d.file, d.line, d.col, src, eff_data, rel))
    }
    let joined = "[" + join_strings(records, ",") + "]"
    if mode == "array" {
        diag_write_output(joined)
        exit(1)
    }
    if mode == "check-json" {
        diag_write_output(("{\"schema_version\":\"wysna.cli.result/1\",\"compiler_version\":\"" + tool_compiler_version() + "\",\"command\":\"check\",\"ok\":false,\"exit_code\":1,\"diagnostics\":") + joined + ",\"data\":null}")
        exit(1)
    }
    let cmd = diag_cli_command()
    let first_code = diags[0].code
    let status = if first_code == "W5002" { "usage_error" } elif first_code == "W5003" or first_code == "W5004" { "toolchain_error" } else { "diagnostic_error" }
    diag_write_output(diag_tool_envelope_json(cmd, status, 1, joined, "", "", "[]"))
    exit(1)
}
# Shared path canonicalization, character predicates, and error entrypoints used across compiler and tooling units.
extern "C" fn wysna_host_fs_canonical(path: opaque, output: opaque) -> int

fn report_error(file: str, code: str, line: int, col: int, msg: str) -> unit {
    diag_emit_and_exit(file, code, line, col, msg)
}

fn report_error_at(code: str, token: Token, msg: str) -> unit {
    report_error(token.file, code, token.line, token.col, msg)
}

fn report_error_at_data(code: str, token: Token, msg: str, data: str) -> unit {
    diag_emit_and_exit_data(token.file, code, token.line, token.col, msg, data)
}

fn report_error_at_full(code: str, token: Token, msg: str, data: str, related: str) -> unit {
    diag_emit_and_exit_full(token.file, code, token.line, token.col, msg, data, related)
}

fn report_error_at_location(code: str, file: str, line: int, col: int, msg: str) -> unit {
    report_error(file, code, line, col, msg)
}

fn is_alpha(c: int) -> bool {
    return c >= 65 and c <= 90 or c >= 97 and c <= 122 or c == 95
}

fn is_digit(c: int) -> bool {
    return c >= 48 and c <= 57
}

fn is_alnum(c: int) -> bool {
    return is_alpha(c) or is_digit(c)
}

fn is_space(c: int) -> bool {
    return c == 32 or c == 9 or c == 10 or c == 13
}

fn hex_val(c: int) -> int {
    if c >= 48 and c <= 57 {
        return c - 48
    }
    if c >= 65 and c <= 70 {
        return c - 55
    }
    if c >= 97 and c <= 102 {
        return c - 87
    }
    return 0
}

fn module_normalize(path: str) -> str {
    let mut parts: list[str] = []
    let mut part = ""
    for i in 0..len(path) + 1 {
        let mut ch = "/"
        if i < len(path) { ch = path[i] }
        if ch == "\\" { ch = "/" }
        if ch == "/" {
            if part == ".." and len(parts) > 0 { parts.pop() }
            elif part != "" and part != "." { parts.append(part) }
            part = ""
        } else { part = part + ch }
    }
    let mut result = ""
    if len(path) > 0 and (path[0] == "/" or path[0] == "\\") { result = "/" }
    if len(path) > 1 and (path[0] == "/" or path[0] == "\\") and (path[1] == "/" or path[1] == "\\") { result = "//" }
    for i in 0..len(parts) {
        if i > 0 { result = result + "/" }
        result = result + parts[i]
    }
    return result
}

fn module_directory(path: str) -> str {
    let mut boundary = -1
    for i in 0..len(path) { if path[i] == "/" { boundary = i } }
    if boundary < 0 { return "" }
    return slice(path, 0, boundary + 1)
}

fn module_canonical_resolved(path: str) -> str {
    let input = wysna_host_buffer_new()
    let output = wysna_host_buffer_new()
    for byte in bytes(path) { wysna_host_buffer_append(input, byte) }
    let size = wysna_host_fs_canonical(input, output)
    let mut parts: list[str] = []
    let mut index = 0
    if size >= 0 {
        while index < size {
            let first = wysna_host_buffer_get(output, index)
            let width = if first < 128 { 1 } elif first < 224 { 2 } elif first < 240 { 3 } else { 4 }
            let mut codepoint = if width == 1 { first } elif width == 2 { first % 32 } elif width == 3 { first % 16 } else { first % 8 }
            for offset in 1..width { codepoint = codepoint * 64 + wysna_host_buffer_get(output, index + offset) % 64 }
            parts.append(chr(codepoint))
            index = index + width
        }
    }
    wysna_host_close(input)
    wysna_host_close(output)
    if size < 0 { return "" }
    return module_normalize(join_strings(parts, ""))
}

fn module_canonical(path: str) -> str {
    let resolved = module_canonical_resolved(path)
    return if resolved == "" { module_normalize(path) } else { resolved }
}
# Shared host/buffer/string/JSON helpers for independent native tooling units (project, packages, mcp, lsp, schema, fix).

extern "C" fn wysna_host_fs(first: opaque, second: opaque, operation: int) -> int
extern "C" fn wysna_host_getcwd(output: opaque) -> int
extern "C" fn wysna_host_file_open(path: opaque, mode: int) -> opaque
extern "C" fn wysna_host_file_read(file: opaque, data: opaque, count: int) -> int
extern "C" fn wysna_host_file_write(file: opaque, data: opaque) -> int
extern "C" fn wysna_host_buffer_size(handle: opaque) -> int
extern "C" fn wysna_host_is_open(file: opaque) -> int
extern "C" fn wysna_host_stdin_read_line(output: opaque) -> int
extern "C" fn wysna_host_stdin_read_exact(output: opaque, count: int) -> int
extern "C" fn wysna_host_stdout_write_raw(input: opaque) -> int
extern "C" fn wysna_host_self_executable(output: opaque) -> int
extern "C" fn wysna_host_process_run(executable: opaque, arguments: opaque, timeout_ms: int) -> int
extern "C" fn wysna_host_last_error() -> int

fn tool_buf_from_str(text: str) -> opaque {
    let buf = wysna_host_buffer_new()
    for b in bytes(text) { wysna_host_buffer_append(buf, b) }
    return buf
}

fn tool_str_contains(xs: list[str], value: str) -> bool {
    for item in xs {
        if item == value { return true }
    }
    return false
}

fn tool_str_gt(a: str, b: str) -> bool {
    let la = len(a)
    let lb = len(b)
    let limit = if la < lb { la } else { lb }
    for i in 0..limit {
        let ca = ord(a[i])
        let cb = ord(b[i])
        if ca > cb { return true }
        if ca < cb { return false }
    }
    return la > lb
}

fn tool_sort_strings(xs: list[str]) -> list[str] {
    let mut out: list[str] = []
    for x in xs {
        if not tool_str_contains(out, x) { out.append(x) }
    }
    let n = len(out)
    for i in 1..n {
        let key = out[i]
        let mut j = i - 1
        while j >= 0 and tool_str_gt(out[j], key) {
            out[j + 1] = out[j]
            j = j - 1
        }
        out[j + 1] = key
    }
    return out
}

fn tool_str_list_json(xs: list[str]) -> str {
    let sorted = tool_sort_strings(xs)
    let mut parts: list[str] = ["["]
    for i in 0..len(sorted) {
        if i > 0 { parts.append(",") }
        parts.append(diag_json_quote(sorted[i]))
    }
    parts.append("]")
    return join_strings(parts, "")
}

fn tool_basename(path: str) -> str {
    let mut last_sep = -1
    for i in 0..len(path) {
        if path[i] == "/" or path[i] == "\\" { last_sep = i }
    }
    let name = if last_sep >= 0 { slice(path, last_sep + 1, len(path)) } else { path }
    if len(name) > 6 and slice(name, len(name) - 6, len(name)) == ".wysna" {
        return slice(name, 0, len(name) - 6)
    }
    return name
}

fn schema_split_lines(src: str) -> list[str] {
    let mut lines: list[str] = []
    let mut start = 0
    let n = len(src)
    for i in 0..n {
        if src[i] == "\n" {
            let mut end_idx = i
            if end_idx > start and src[end_idx - 1] == "\r" { end_idx = end_idx - 1 }
            lines.append(slice(src, start, end_idx))
            start = i + 1
        }
    }
    let mut tail_end = n
    if tail_end > start and src[tail_end - 1] == "\r" { tail_end = tail_end - 1 }
    lines.append(slice(src, start, tail_end))
    return lines
}

fn lsp_buf_from_str(text: str) -> opaque {
    let buf = wysna_host_buffer_new()
    for b in bytes(text) { wysna_host_buffer_append(buf, b) }
    return buf
}

fn tool_utf8_bytes_to_str(bs: list[int]) -> str {
    let mut parts: list[str] = []
    let mut i = 0
    while i < len(bs) {
        let first = bs[i]
        let width = if first < 128 { 1 } elif first < 224 { 2 } elif first < 240 { 3 } else { 4 }
        let mut cp = if width == 1 { first } elif width == 2 { first % 32 } elif width == 3 { first % 16 } else { first % 8 }
        for off in 1..width {
            if i + off < len(bs) { cp = cp * 64 + (bs[i + off] % 64) }
        }
        parts.append(chr(cp))
        i = i + width
    }
    return join_strings(parts, "")
}

fn lsp_buf_to_str(buf: opaque, count: int) -> str {
    let mut parts: list[str] = []
    let mut i = 0
    while i < count {
        let first = wysna_host_buffer_get(buf, i)
        if first < 0 { break }
        let width = if first < 128 { 1 } elif first < 224 { 2 } elif first < 240 { 3 } else { 4 }
        if i + width > count { break }
        let mut cp = if width == 1 { first } elif width == 2 { first % 32 } elif width == 3 { first % 16 } else { first % 8 }
        for offset in 1..width {
            cp = cp * 64 + (wysna_host_buffer_get(buf, i + offset) % 64)
        }
        parts.append(chr(cp))
        i = i + width
    }
    return join_strings(parts, "")
}

fn lsp_pack_argv_buf(arguments: list[str]) -> opaque {
    let buf = wysna_host_buffer_new()
    for arg in arguments {
        let raw = bytes(arg)
        let n = len(raw)
        let b0 = (n / 16777216) % 256
        let b1 = (n / 65536) % 256
        let b2 = (n / 256) % 256
        let b3 = n % 256
        wysna_host_buffer_append(buf, b0)
        wysna_host_buffer_append(buf, b1)
        wysna_host_buffer_append(buf, b2)
        wysna_host_buffer_append(buf, b3)
        for ch in raw { wysna_host_buffer_append(buf, ch) }
    }
    return buf
}

fn lsp_remove_file(path: str) -> unit {
    if path == "" { return }
    let first = lsp_buf_from_str(path)
    let second = lsp_buf_from_str("")
    let _st = wysna_host_fs(first, second, 3)
    wysna_host_close(first)
    wysna_host_close(second)
}

fn lsp_self_exe_path() -> str {
    let buf = wysna_host_buffer_new()
    let sz = wysna_host_self_executable(buf)
    let path = if sz > 0 { lsp_buf_to_str(buf, sz) } else { "" }
    wysna_host_close(buf)
    if path != "" { return path }
    let a = args()
    if len(a) > 0 { return a[0] }
    return ""
}

fn lsp_compiler_exe_path() -> str {
    let configured = env("WYSNA_SELFHOST_COMPILER") ?? ""
    if configured != "" { return configured }
    return lsp_self_exe_path()
}

fn lsp_stdlib_root_arg() -> str {
    let raw = args()
    let mut i = 1
    while i < len(raw) {
        if raw[i] == "--stdlib-root" and i + 1 < len(raw) { return raw[i + 1] }
        i = i + 1
    }
    return ""
}

fn lsp_tmp_dir() -> str {
    let t1 = env("TMPDIR") ?? ""
    if t1 != "" {
        let n1 = len(t1)
        return if n1 > 1 and t1[n1 - 1] == "/" { slice(t1, 0, n1 - 1) } else { t1 }
    }
    let t2 = env("TEMP") ?? ""
    if t2 != "" { return t2 }
    return "/tmp"
}

fn lsp_ascii_lower(s: str) -> str {
    let mut parts: list[str] = []
    for i in 0..len(s) {
        let ch = s[i]
        let c = ord(ch)
        if c >= 65 and c <= 90 { parts.append(chr(c + 32)) } else { parts.append(ch) }
    }
    return join_strings(parts, "")
}

fn lsp_trim(s: str) -> str {
    let mut lo = 0
    let mut hi = len(s)
    while lo < hi and (s[lo] == " " or s[lo] == "\t" or s[lo] == "\r" or s[lo] == "\n") { lo = lo + 1 }
    while hi > lo and (s[hi - 1] == " " or s[hi - 1] == "\t" or s[hi - 1] == "\r" or s[hi - 1] == "\n") { hi = hi - 1 }
    return slice(s, lo, hi)
}

fn lsp_parse_int(s: str, default_val: int) -> int {
    let t = lsp_trim(s)
    if t == "" { return default_val }
    let mut sign = 1
    let mut idx = 0
    if t[0] == "-" {
        sign = -1
        idx = 1
    } elif t[0] == "+" {
        idx = 1
    }
    if idx >= len(t) { return default_val }
    let mut acc = 0
    while idx < len(t) {
        let c = ord(t[idx])
        if c < 48 or c > 57 { return default_val }
        acc = acc * 10 + (c - 48)
        idx = idx + 1
    }
    return acc * sign
}

fn lsp_buf_read_line_len(buf: opaque) -> int {
    let mut n = 0
    while wysna_host_buffer_get(buf, n) >= 0 { n = n + 1 }
    return n
}

class LspJson {
    kind: str
    str_val: str
    int_val: int
    bool_val: bool
    keys: list[str]
    vals: list[LspJson]
    items: list[LspJson]

    fn init(kind: str) {
        this.kind = kind
        this.str_val = ""
        this.int_val = 0
        this.bool_val = false
        let ks: list[str] = []
        this.keys = ks
        let vs: list[LspJson] = []
        this.vals = vs
        let its: list[LspJson] = []
        this.items = its
    }
}

fn lsp_json_null() -> LspJson {
    return LspJson("null")
}

fn lsp_json_has(obj: LspJson, key: str) -> bool {
    if obj.kind != "object" { return false }
    for k in obj.keys {
        if k == key { return true }
    }
    return false
}

fn lsp_json_get(obj: LspJson, key: str) -> LspJson {
    if obj.kind != "object" { return lsp_json_null() }
    for i in 0..len(obj.keys) {
        if obj.keys[i] == key { return obj.vals[i] }
    }
    return lsp_json_null()
}

fn lsp_json_str(obj: LspJson, key: str, def_val: str) -> str {
    let v = lsp_json_get(obj, key)
    if v.kind == "str" { return v.str_val }
    return def_val
}

fn lsp_json_int(obj: LspJson, key: str, def_val: int) -> int {
    let v = lsp_json_get(obj, key)
    if v.kind == "int" { return v.int_val }
    return def_val
}

fn lsp_json_bool(obj: LspJson, key: str, def_val: bool) -> bool {
    let v = lsp_json_get(obj, key)
    if v.kind == "bool" { return v.bool_val }
    return def_val
}

fn lsp_json_raw_literal(v: LspJson) -> str {
    if v.kind == "int" { return str(v.int_val) }
    if v.kind == "str" { return diag_json_quote(v.str_val) }
    if v.kind == "bool" { return if v.bool_val { "true" } else { "false" } }
    return "null"
}

class LspJsonCursor {
    src: str
    pos: int

    fn init(src: str) {
        this.src = src
        this.pos = 0
    }
}

fn lsp_jc_skip_ws(c: LspJsonCursor) -> unit {
    let n = len(c.src)
    while c.pos < n {
        let ch = c.src[c.pos]
        if ch == " " or ch == "\t" or ch == "\r" or ch == "\n" {
            c.pos = c.pos + 1
        } else {
            return
        }
    }
}

fn lsp_jc_hex4(c: LspJsonCursor) -> int {
    if c.pos + 4 > len(c.src) { return -1 }
    let mut acc = 0
    for k in 0..4 {
        let d = hex_val(ord(c.src[c.pos + k]))
        if d < 0 { return -1 }
        acc = acc * 16 + d
    }
    c.pos = c.pos + 4
    return acc
}

fn lsp_jc_parse_str(c: LspJsonCursor) -> str {
    let n = len(c.src)
    if c.pos >= n or c.src[c.pos] != "\"" { return "" }
    c.pos = c.pos + 1
    let mut parts: list[str] = []
    while c.pos < n {
        let ch = c.src[c.pos]
        c.pos = c.pos + 1
        if ch == "\"" { return join_strings(parts, "") }
        if ch == "\\" and c.pos < n {
            let esc = c.src[c.pos]
            c.pos = c.pos + 1
            if esc == "\"" { parts.append("\"") }
            elif esc == "\\" { parts.append("\\") }
            elif esc == "/" { parts.append("/") }
            elif esc == "b" { parts.append(chr(8)) }
            elif esc == "f" { parts.append(chr(12)) }
            elif esc == "n" { parts.append("\n") }
            elif esc == "r" { parts.append("\r") }
            elif esc == "t" { parts.append("\t") }
            elif esc == "u" {
                let code = lsp_jc_hex4(c)
                if code >= 55296 and code <= 56319 and c.pos + 2 <= n and c.src[c.pos] == "\\" and c.src[c.pos + 1] == "u" {
                    c.pos = c.pos + 2
                    let low = lsp_jc_hex4(c)
                    if low >= 56320 and low <= 57343 {
                        let cp = 65536 + ((code - 55296) * 1024) + (low - 56320)
                        parts.append(chr(cp))
                    } else {
                        parts.append(chr(code))
                    }
                } elif code >= 0 {
                    parts.append(chr(code))
                }
            } else {
                parts.append(esc)
            }
        } else {
            parts.append(ch)
        }
    }
    return join_strings(parts, "")
}

fn lsp_jc_parse_val(c: LspJsonCursor) -> LspJson {
    lsp_jc_skip_ws(c)
    let n = len(c.src)
    if c.pos >= n { return lsp_json_null() }
    let ch = c.src[c.pos]
    if ch == "\"" {
        let out = LspJson("str")
        out.str_val = lsp_jc_parse_str(c)
        return out
    }
    if ch == "{" {
        c.pos = c.pos + 1
        let obj = LspJson("object")
        lsp_jc_skip_ws(c)
        if c.pos < n and c.src[c.pos] == "}" {
            c.pos = c.pos + 1
            return obj
        }
        while c.pos < n {
            lsp_jc_skip_ws(c)
            let k = lsp_jc_parse_str(c)
            lsp_jc_skip_ws(c)
            if c.pos < n and c.src[c.pos] == ":" { c.pos = c.pos + 1 }
            let v = lsp_jc_parse_val(c)
            obj.keys.append(k)
            obj.vals.append(v)
            lsp_jc_skip_ws(c)
            if c.pos < n and c.src[c.pos] == "," {
                c.pos = c.pos + 1
                continue
            }
            if c.pos < n and c.src[c.pos] == "}" { c.pos = c.pos + 1 }
            break
        }
        return obj
    }
    if ch == "[" {
        c.pos = c.pos + 1
        let arr = LspJson("array")
        lsp_jc_skip_ws(c)
        if c.pos < n and c.src[c.pos] == "]" {
            c.pos = c.pos + 1
            return arr
        }
        while c.pos < n {
            let item = lsp_jc_parse_val(c)
            arr.items.append(item)
            lsp_jc_skip_ws(c)
            if c.pos < n and c.src[c.pos] == "," {
                c.pos = c.pos + 1
                continue
            }
            if c.pos < n and c.src[c.pos] == "]" { c.pos = c.pos + 1 }
            break
        }
        return arr
    }
    if ch == "t" and c.pos + 4 <= n and slice(c.src, c.pos, c.pos + 4) == "true" {
        c.pos = c.pos + 4
        let out = LspJson("bool")
        out.bool_val = true
        return out
    }
    if ch == "f" and c.pos + 5 <= n and slice(c.src, c.pos, c.pos + 5) == "false" {
        c.pos = c.pos + 5
        let out = LspJson("bool")
        out.bool_val = false
        return out
    }
    if ch == "n" and c.pos + 4 <= n and slice(c.src, c.pos, c.pos + 4) == "null" {
        c.pos = c.pos + 4
        return lsp_json_null()
    }
    let start = c.pos
    if c.pos < n and c.src[c.pos] == "-" { c.pos = c.pos + 1 }
    while c.pos < n and is_digit(ord(c.src[c.pos])) { c.pos = c.pos + 1 }
    let int_part = slice(c.src, start, c.pos)
    while c.pos < n {
        let nc = c.src[c.pos]
        if nc == "." or nc == "e" or nc == "E" or nc == "+" or nc == "-" or is_digit(ord(nc)) {
            c.pos = c.pos + 1
        } else {
            break
        }
    }
    let num = LspJson("int")
    num.int_val = lsp_parse_int(int_part, 0)
    return num
}

fn lsp_parse_json(src: str) -> LspJson {
    let cursor = LspJsonCursor(src)
    return lsp_jc_parse_val(cursor)
}

fn mcp_getcwd() -> str {
    let buf = wysna_host_buffer_new()
    let sz = wysna_host_getcwd(buf)
    let raw = if sz > 0 { lsp_buf_to_str(buf, sz) } else { "" }
    wysna_host_close(buf)
    return raw
}

fn mcp_is_abs_path(p: str) -> bool {
    if len(p) == 0 { return false }
    if p[0] == "/" or p[0] == "\\" { return true }
    if len(p) >= 2 and p[1] == ":" { return true }
    return false
}

fn mcp_norm_cmp_prefix(p: str, is_win_drive: bool) -> str {
    if is_win_drive { return lsp_ascii_lower(p) }
    return p
}

fn mcp_is_within_root(cand: str, root: str) -> bool {
    if cand == "" or root == "" { return false }
    let win_drive = len(cand) >= 2 and cand[1] == ":" and len(root) >= 2 and root[1] == ":"
    let c_cmp = mcp_norm_cmp_prefix(cand, win_drive)
    let r_cmp = mcp_norm_cmp_prefix(root, win_drive)
    if c_cmp == r_cmp { return true }
    if r_cmp == "/" { return len(c_cmp) > 0 and c_cmp[0] == "/" }
    if len(c_cmp) > len(r_cmp) and slice(c_cmp, 0, len(r_cmp)) == r_cmp and c_cmp[len(r_cmp)] == "/" {
        return true
    }
    return false
}

fn mcp_json_error() -> LspJson {
    return LspJson("error")
}

fn mcp_hex_digit(code: int) -> int {
    if code >= 48 and code <= 57 { return code - 48 }
    if code >= 65 and code <= 70 { return code - 55 }
    if code >= 97 and code <= 102 { return code - 87 }
    return -1
}

fn mcp_strict_hex4(c: LspJsonCursor) -> int {
    if c.pos + 4 > len(c.src) { return -1 }
    let mut acc = 0
    for k in 0..4 {
        let d = mcp_hex_digit(ord(c.src[c.pos + k]))
        if d < 0 { return -1 }
        acc = acc * 16 + d
    }
    c.pos = c.pos + 4
    return acc
}

fn mcp_strict_parse_str_wrap(c: LspJsonCursor) -> list[str] {
    let n = len(c.src)
    if c.pos >= n or c.src[c.pos] != "\"" { return ["0", ""] }
    c.pos = c.pos + 1
    let mut parts: list[str] = []
    while c.pos < n {
        let ch = c.src[c.pos]
        let code = ord(ch)
        if code < 32 { return ["0", ""] }
        c.pos = c.pos + 1
        if ch == "\"" { return ["1", join_strings(parts, "")] }
        if ch == "\\" {
            if c.pos >= n { return ["0", ""] }
            let esc = c.src[c.pos]
            c.pos = c.pos + 1
            if esc == "\"" { parts.append("\"") }
            elif esc == "\\" { parts.append("\\") }
            elif esc == "/" { parts.append("/") }
            elif esc == "b" { parts.append(chr(8)) }
            elif esc == "f" { parts.append(chr(12)) }
            elif esc == "n" { parts.append("\n") }
            elif esc == "r" { parts.append("\r") }
            elif esc == "t" { parts.append("\t") }
            elif esc == "u" {
                let cp_hi = mcp_strict_hex4(c)
                if cp_hi < 0 { return ["0", ""] }
                if cp_hi >= 55296 and cp_hi <= 56319 and c.pos + 2 <= n and c.src[c.pos] == "\\" and c.src[c.pos + 1] == "u" {
                    c.pos = c.pos + 2
                    let cp_lo = mcp_strict_hex4(c)
                    if cp_lo < 56320 or cp_lo > 57343 { return ["0", ""] }
                    parts.append(chr(65536 + ((cp_hi - 55296) * 1024) + (cp_lo - 56320)))
                } else {
                    parts.append(chr(cp_hi))
                }
            } else {
                return ["0", ""]
            }
        } else {
            parts.append(ch)
        }
    }
    return ["0", ""]
}

fn mcp_strict_parse_val(c: LspJsonCursor) -> LspJson {
    lsp_jc_skip_ws(c)
    let n = len(c.src)
    if c.pos >= n { return mcp_json_error() }
    let ch = c.src[c.pos]
    if ch == "\"" {
        let sres = mcp_strict_parse_str_wrap(c)
        if sres[0] != "1" { return mcp_json_error() }
        let out = LspJson("str")
        out.str_val = sres[1]
        return out
    }
    if ch == "{" {
        c.pos = c.pos + 1
        let obj = LspJson("object")
        lsp_jc_skip_ws(c)
        if c.pos < n and c.src[c.pos] == "}" {
            c.pos = c.pos + 1
            return obj
        }
        while true {
            lsp_jc_skip_ws(c)
            if c.pos >= n or c.src[c.pos] != "\"" { return mcp_json_error() }
            let kres = mcp_strict_parse_str_wrap(c)
            if kres[0] != "1" { return mcp_json_error() }
            lsp_jc_skip_ws(c)
            if c.pos >= n or c.src[c.pos] != ":" { return mcp_json_error() }
            c.pos = c.pos + 1
            let val = mcp_strict_parse_val(c)
            if val.kind == "error" { return mcp_json_error() }
            obj.keys.append(kres[1])
            obj.vals.append(val)
            lsp_jc_skip_ws(c)
            if c.pos >= n { return mcp_json_error() }
            if c.src[c.pos] == "," {
                c.pos = c.pos + 1
                continue
            }
            if c.src[c.pos] == "}" {
                c.pos = c.pos + 1
                return obj
            }
            return mcp_json_error()
        }
        return mcp_json_error()
    }
    if ch == "[" {
        c.pos = c.pos + 1
        let arr = LspJson("array")
        lsp_jc_skip_ws(c)
        if c.pos < n and c.src[c.pos] == "]" {
            c.pos = c.pos + 1
            return arr
        }
        while true {
            let item = mcp_strict_parse_val(c)
            if item.kind == "error" { return mcp_json_error() }
            arr.items.append(item)
            lsp_jc_skip_ws(c)
            if c.pos >= n { return mcp_json_error() }
            if c.src[c.pos] == "," {
                c.pos = c.pos + 1
                continue
            }
            if c.src[c.pos] == "]" {
                c.pos = c.pos + 1
                return arr
            }
            return mcp_json_error()
        }
        return mcp_json_error()
    }
    if ch == "t" and c.pos + 4 <= n and slice(c.src, c.pos, c.pos + 4) == "true" {
        c.pos = c.pos + 4
        let out = LspJson("bool")
        out.bool_val = true
        return out
    }
    if ch == "f" and c.pos + 5 <= n and slice(c.src, c.pos, c.pos + 5) == "false" {
        c.pos = c.pos + 5
        let out = LspJson("bool")
        out.bool_val = false
        return out
    }
    if ch == "n" and c.pos + 4 <= n and slice(c.src, c.pos, c.pos + 4) == "null" {
        c.pos = c.pos + 4
        return lsp_json_null()
    }
    let start = c.pos
    if c.src[c.pos] == "-" { c.pos = c.pos + 1 }
    if c.pos >= n or not is_digit(ord(c.src[c.pos])) { return mcp_json_error() }
    let int_start = c.pos
    while c.pos < n and is_digit(ord(c.src[c.pos])) { c.pos = c.pos + 1 }
    let int_str = slice(c.src, start, c.pos)
    if c.pos < n and c.src[c.pos] == "." {
        c.pos = c.pos + 1
        if c.pos >= n or not is_digit(ord(c.src[c.pos])) { return mcp_json_error() }
        while c.pos < n and is_digit(ord(c.src[c.pos])) { c.pos = c.pos + 1 }
    }
    if c.pos < n and (c.src[c.pos] == "e" or c.src[c.pos] == "E") {
        c.pos = c.pos + 1
        if c.pos < n and (c.src[c.pos] == "+" or c.src[c.pos] == "-") { c.pos = c.pos + 1 }
        if c.pos >= n or not is_digit(ord(c.src[c.pos])) { return mcp_json_error() }
        while c.pos < n and is_digit(ord(c.src[c.pos])) { c.pos = c.pos + 1 }
    }
    if int_start == c.pos { return mcp_json_error() }
    let num = LspJson("int")
    num.int_val = lsp_parse_int(int_str, 0)
    num.str_val = slice(c.src, int_start, c.pos)
    return num
}

fn mcp_parse_json_strict(src: str) -> LspJson {
    let cursor = LspJsonCursor(src)
    let val = mcp_strict_parse_val(cursor)
    if val.kind == "error" { return val }
    lsp_jc_skip_ws(cursor)
    if cursor.pos != len(cursor.src) { return mcp_json_error() }
    return val
}

fn fix_extract_json_delimited_field(raw: str, field_key: str, open_ch: str, close_ch: str, fallback: str) -> str {
    let needle = "\"" + field_key + "\""
    let n = len(raw)
    let klen = len(needle)
    let mut i = 0
    let mut in_str = false
    let mut depth = 0
    while i < n {
        let ch = raw[i]
        if in_str {
            if ch == "\\" and i + 1 < n {
                i = i + 2
                continue
            }
            if ch == "\"" { in_str = false }
            i = i + 1
        } else {
            if ch == "\"" {
                if depth == 1 and i + klen <= n and slice(raw, i, i + klen) == needle {
                    let mut p = i + klen
                    while p < n and (raw[p] == " " or raw[p] == "\t" or raw[p] == "\r" or raw[p] == "\n") { p = p + 1 }
                    if p < n and raw[p] == ":" {
                        p = p + 1
                        while p < n and (raw[p] == " " or raw[p] == "\t" or raw[p] == "\r" or raw[p] == "\n") { p = p + 1 }
                        if p < n and raw[p] == open_ch {
                            let start = p
                            let mut bdepth = 0
                            let mut instr2 = false
                            while p < n {
                                let c2 = raw[p]
                                if instr2 {
                                    if c2 == "\\" and p + 1 < n { p = p + 2 continue }
                                    if c2 == "\"" { instr2 = false }
                                    p = p + 1
                                } else {
                                    if c2 == "\"" { instr2 = true }
                                    elif c2 == open_ch { bdepth = bdepth + 1 }
                                    elif c2 == close_ch {
                                        bdepth = bdepth - 1
                                        if bdepth == 0 { return slice(raw, start, p + 1) }
                                    }
                                    p = p + 1
                                }
                            }
                        }
                    }
                }
                in_str = true
            } elif ch == "{" or ch == "[" {
                depth = depth + 1
            } elif ch == "}" or ch == "]" {
                if depth > 0 { depth = depth - 1 }
            }
            i = i + 1
        }
    }
    return fallback
}

fn fix_extract_json_array_field(raw: str, field_key: str) -> str {
    return fix_extract_json_delimited_field(raw, field_key, "[", "]", "[]")
}

fn fix_extract_json_object_field(raw: str, field_key: str) -> str {
    return fix_extract_json_delimited_field(raw, field_key, "{", "}", "")
}

fn tool_short_name(raw: str) -> str {
    let prefix = "__wysna_module_"
    if len(raw) > len(prefix) and slice(raw, 0, len(prefix)) == prefix {
        for i in len(prefix)..len(raw) - 1 {
            if slice(raw, i, i + 2) == "__" {
                return slice(raw, i + 2, len(raw))
            }
        }
    }
    return raw
}
# Generated by tools/generate_agent_contract.py; edit src/common/agent_contract.json.
fn tool_compiler_version() -> str { return "1.1.0" }
fn tool_language_version() -> str { return "1.1" }
fn tool_skills_available_topics() -> str { return "agent-loop, contracts, graph, overview, patch, project-tests, stdlib, syntax, workers" }
fn tool_skills_topic_content(topic: str) -> str {
    if topic == "agent-loop" { return "# Agent Coding Loop (Token-Efficient, Hash-Guarded)\n1. Discover relationships: `wysna graph <file.wysna> --output-format=json-v1`\n2. Inspect symbols within a byte budget: `wysna inspect <file.wysna> --symbols a,b --with-deps --max-bytes 2048 --output-format=json-v1` (follow `omitted[].ref` for truncated context)\n3. Submit checked single-symbol or multi-file edits (`source`, `symbol`, `hunks`, `create`, `delete`): `wysna patch --manifest wysna.toml --edits changes.json --expect-plan-hash <hash> --apply`\n4. Auto-repair mechanical diagnostics: `wysna fix --apply --output-format=json-v1 <file.wysna>`\n5. Decode any Wxxxx error: `wysna explain --code W2001 --output-format=json-v1`\n6. Verify via project check & tests (`wysna_project_check`, `wysna_project_test` in MCP or `wysna project test`)" }
    if topic == "contracts" { return "# Contracts, Schemas, Quotas & Trace Replay\n- Pre/postconditions: `fn f(x: int) -> int requires x > 0 ensures result >= 0 { ... }` (runtime `[W4005]`).\n- Tool Schema export: `wysna schema --emit-codecs --output-format=json-v1 <file.wysna>`.\n- Invoke a typed `@AgentTool(id: \"ops.lookup\", version: 1)`: `wysna schema <file.wysna> --function NAME --emit-tool -o adapter.wysna`.\n- Deterministic quotas: `--max-steps=<N>`, `--max-heap-mb=<N>` (fail-stop `[W4004]`).\n- Offline effect cassettes: `--record-trace <path>`, `--replay-trace <path>`.\n- Solo los errores recuperables usan `T ! E`; W4001–W4005 son traps, sin recuperación mediante `else err`.\n- JSON Schema exporta solo restricciones representables; los contratos generales requieren validación ejecutable.\n- Cuotas y replay cubren el runtime y efectos instrumentados; FFI y binarios nativos necesitan aislamiento del sistema operativo." }
    if topic == "graph" { return "# Semantic Relationship Graph (`wysna graph`)\n- `wysna graph <file> --output-format=json-v1`: full nodes, edges, `graph_hash`, `call_resolution`, and `analysis_boundaries`.\n- `--symbol <name> --rel implements`: find all classes implementing an interface (or vice-versa).\n- `--symbol <name> --rel usages`: find every class, function, field, and param using the type.\n- `--symbol <name> --rel callers|callees`: traverse the resolved call graph and inspect `uncertain_calls` (`indirect_call`, `virtual_dispatch`, `extern_ffi`).\n- `--symbol <name> --rel impact`: compute transitive blast radius before refactoring.\n- `wysna graph --manifest wysna.toml --role Controller --output-format=json-v1`: list typed architecture roles in the selected target." }
    if topic == "overview" { return "# Wysna v1.1.0 — Agent-First Native Language & Toolchain\n- Default workflow uses checked static inspection before execution.\n- Memory model: Atomic ARC + Copy-on-Write (`Weak[C]` breaks strong cycles); workers require closed callbacks and privately owned value graphs; classes and opaque handles cannot cross worker boundaries.\n- Error channel: Recoverable typed values `T ! E`; runtime traps terminate execution. Unwrap with `?` or `else err { fallback }`.\n- Core agent loop: `wysna skills` -> `wysna graph` -> `wysna inspect` -> `wysna patch` -> `wysna fix` -> `wysna check`.\n- Topics available: overview, agent-loop, syntax, graph, patch, project-tests, contracts, stdlib." }
    if topic == "patch" { return "# Checked Semantic Patching (`wysna patch`)\n- Dry-run check in memory (default): validates syntax, types, interface contracts, and configured project architecture rules before disk writes.\n- Optimistic locking: pass `--expect-graph-hash graph:...`; stale hashes fail with `[W5005]`.\n- Target classes, interfaces, structs, enums, functions, or `ClassName.method`.\n- Coordinated workspace edits (Seed & Native SDK): preview with `wysna patch --manifest wysna.toml --edits changes.json --output-format=json-v1`. Apply using `--apply --expect-plan-hash HASH`.\n- Para probar el candidato aislado, agrega `--test --output-format=json-v1`. Lee `result.test_verification` y `result.tests`. Aplica con `--test --apply --expect-plan-hash HASH`; las pruebas se ejecutan de nuevo antes de escribir. En MCP usa `test: true` con el servidor iniciado mediante `--allow-exec`." }
    if topic == "project-tests" { return "# Agent Project Testing & Offline Packages\n1. Discover without executing: `wysna project test --discover --list --frozen --output-format=json-v1`.\n2. Target exact IDs from `result.cases`: `--case test:example`; `--filter` keeps substring selection.\n3. Execute with `--expect-plan-hash <result.plan_hash> --output-format=json-v1 --report-json tests.json --report-junit tests.xml`.\n4. Read `result.cases[].failure_kind`, `diagnostics`, and stdout/stderr hashes rather than parsing terminal text.\n5. `W5005` signals a stale plan: re-list first. An empty suite exits with 2; cancellation exits with 130.\n6. `std/test` provides generic equality, float tolerances, optionals, and `fixture_directory()` (cleaned up after each case).\nThe plan hash covers manifest, lock, version, and selected entries (not every transitive import). The `native-core-v1` SDK runs these commands without Python.\n7. Dependencies: `wysna packages pack --manifest dependency/wysna.toml -o dependency.tar`; fetch via `packages fetch --manifest wysna.toml --archive dependency.tar --sha256 <pin> --cache <cache>`, add via `packages add alias --path vendor/<pin>`, and run `project lock`.\n8. Restore via `packages restore --cache <cache>` and verify via `project test --frozen`; all operations support `--output-format=json-v1` with no lifecycle hooks or remote registry.\n" }
    if topic == "stdlib" { return "# Standard Library (18 Modules)\n- Data & Text: `std/math`, `std/text`, `std/bytes`, `std/regex`, `std/collections`, `std/json`, `std/csv` (`parse`, `parse_records`, `stringify`), `std/parse`.\n- Systems & I/O: `std/fs`, `std/files`, `std/buffer`, `std/env`, `std/path`, `std/process`, `std/time`.\n- Network, Concurrency & Security: `std/http`, `std/async`, `std/algorithms` (`parallel_map`), `std/crypto`." }
    if topic == "syntax" { return "# Wysna Canonical Syntax Quick Reference\n- Bindings: `let x = 1` (immutable), `let mut y = 2` (mutable).\n- Functions: `fn add(a: int, b: int) -> int { return a + b }` (`pub` and `priv` at module scope and inside classes).\n- Control flow & logic: `if c { ... } elif d { ... } else { ... }` (`else if` also accepted); boolean operators are `and`, `or`, `not` (never `&&`, `||`, `!`).\n- Cooperative Async: `async fn fetch_id() -> int { ... }`, `let v = await task`.\n- Optionals & Errors: `T?`, `T ! E`, unwrap `?`, recover `expr else err { fallback }`.\n- OOP & Contracts: `interface Drawable { fn draw() -> str }`, `class Rect implements Drawable { pub fn draw() -> str { ... } }`.\n- Lambdas: `|n: int| => n * n` (capture outer variables by immutable snapshot by design; return updated values for mutable state; classes cannot cross worker boundaries).\n- Canonical forms: `Class(...)`, `None`, `_ =>`, parenthesized tuple patterns.\n- Match patterns: alternatives `1 | 2`, Int64 ranges `0..=10`, nested `Point { x, .. }`; W6003 reports unreachable arms.\n- Static attributes on top-level functions: `@deprecated(\"message\")` (W6004), `@must_use` (W6005); custom typed metadata: `struct ReviewTag { name: str }`, `@ReviewTag(name: \"lookup\")`; literal str/bool/int fields, no macros or evaluation.\n- Ranges & Loops: `for i in 0..10 { ... }`, inclusive `0..=10`.\n- Non-exhaustive match W2003 includes data.uncovered_pattern_families for checked repairs." }
    if topic == "workers" { return "# Workers con propiedad aislada\n- `std/algorithms.parallel_map`, `parallel_filter`, `parallel_batch` y el mapper de `parallel_reduce`, además de `std/async.spawn` y `run_group`, exigen callbacks comprobables.\n- Usa funciones nombradas o lambdas y alias inmutables. Solo escalares, strings y compuestos de valores transferibles; W2014 rechaza clases, interfaces, Weak, handles y datos función.\n- W2015 rechaza globals no capturados, efectos transitivos, FFI, scheduler, callbacks sin resolver y workers anidados. Captura valores explícitamente o pásalos como parámetros.\n- Entradas, capturas y resultados se copian como grafos privados. CoW dentro de cada worker; profundidad máxima de snapshot 256.\n- `parallel_reduce` mapea en paralelo y combina mediante fold izquierdo secuencial. El orden de resultados no promete orden de efectos.\n- `run_group` acota trabajo de CPU y devuelve resultados por índice. Usa `group_cancelled()` en callbacks largos. I/O cooperativo permanece en el scheduler." }
    return ""
}
