import "std/environment" as environ
import "std/http" as http
import "std/io" as io
import "std/json" as json
import "std/parse" as parse
import "std/text" as text

struct AlertRecord {
    id: int requires id > 0,
    service: str,
    latency_ms: int requires latency_ms >= 0,
}

fn parse_csv_records(raw: str, threshold_ms: int) -> list[AlertRecord] ! str {
    let lines = text.lines(text.trim(raw))
    if len(lines) <= 1 {
        return Err("CSV input must contain header and at least one data row")
    }
    let mut alerts: list[AlertRecord] = []
    for idx in 1..len(lines) {
        let line = text.trim(lines[idx])
        if line.is_empty() {
            continue
        }
        let cols = text.split(line, ",")
        if len(cols) != 3 {
            return Err(f"Invalid column count at row {idx}: expected 3, got {len(cols)}")
        }
        let id = parse.parse_int(cols[0]) else err {
            return Err(f"Invalid id at row {idx}: {err.message}")
        }
        let service = text.trim(cols[1])
        let latency = parse.parse_int(cols[2]) else err {
            return Err(f"Invalid latency at row {idx}: {err.message}")
        }
        if latency >= threshold_ms {
            alerts.append(AlertRecord {
                id: id,
                service: service,
                latency_ms: latency,
            })
        }
    }
    return alerts
}

fn fetch_remote_policy(endpoint: str) -> str ! str {
    let resp = http.get(endpoint) else err {
        return Err(f"HTTP request failed with code {err.code}")
    }
    if resp.status != 200 {
        let _ = resp.body.close()
        return Err(f"Unexpected HTTP status {resp.status}")
    }
    let doc = http.response_json(resp) else err {
        let _ = resp.body.close()
        return Err("Failed to parse HTTP response JSON")
    }
    let _ = resp.body.close()
    let region = json.get_str(doc, "region") else err {
        return Err(f"Missing region in policy response: {err.message}")
    }
    return region
}

fn build_report_json(alerts: list[AlertRecord], region: str) -> str ! str {
    let mut items: list[json.Value] = []
    let mut total_latency = 0
    for item in alerts {
        total_latency += item.latency_ms
        items.append(json.object({
            "id": json.from_int(item.id),
            "service": json.from_str(item.service),
            "latency_ms": json.from_int(item.latency_ms),
        }))
    }
    let root = json.object({
        "region": json.from_str(region),
        "alert_count": json.from_int(len(alerts)),
        "total_alert_latency_ms": json.from_int(total_latency),
        "alerts": json.array(items),
    })
    let serialized = json.stringify(root) else err {
        return Err(f"JSON serialization error: {err.message}")
    }
    return serialized
}

fn run_cli() -> int ! str {
    let argv = environ.arguments()
    let input_path = if len(argv) > 1 { argv[1] } else { "docs/evolution/evidence/prog_a_input.csv" }
    let output_path = if len(argv) > 2 { argv[2] } else { "docs/evolution/evidence/prog_a_output.json" }
    let endpoint = environ.get("WYSNA_POLICY_URL") ?? "http://127.0.0.1:18923/policy"

    let csv_text = io.read_text(input_path) else err {
        return Err(f"Cannot read {input_path}: {err.message}")
    }
    let alerts = parse_csv_records(csv_text, 100)?
    let region = fetch_remote_policy(endpoint)?
    let report = build_report_json(alerts, region)?
    io.write_text(output_path, report + "\n") else err {
        return Err(f"Cannot write {output_path}: {err.message}")
    }
    print(f"Wrote {len(alerts)} alerts for region {region} to {output_path}")
    return 0
}

fn main() -> int {
    let code = run_cli() else err {
        eprint(f"[ERROR] {err}")
        return 1
    }
    return code
}

main()
