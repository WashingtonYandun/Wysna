import "std/json" as json

pub fn compute_discount_cents(subtotal_cents: int, tier_code: int) -> int
    requires subtotal_cents >= 0, tier_code >= 0
    ensures result >= 0 and result <= subtotal_cents
{
    if tier_code == 2 {
        return (subtotal_cents * 20) / 100
    } elif tier_code == 1 {
        return (subtotal_cents * 10) / 100
    }
    return 0
}

pub fn evaluate_cart_json(raw_json: str) -> str {
    let doc = json.parse(raw_json) else err {
        return f"{{\"ok\":false,\"error\":\"{err.message}\"}}"
    }
    let customer = json.get_str(doc, "customer") else err {
        return f"{{\"ok\":false,\"error\":\"{err.message}\"}}"
    }
    let subtotal = json.get_int(doc, "subtotal_cents") else err {
        return f"{{\"ok\":false,\"error\":\"{err.message}\"}}"
    }
    let tier = json.get_int(doc, "tier_code") else err {
        return f"{{\"ok\":false,\"error\":\"{err.message}\"}}"
    }
    if subtotal < 0 or tier < 0 {
        return "{\"ok\":false,\"error\":\"subtotal_cents and tier_code must be non-negative\"}"
    }
    let discount = compute_discount_cents(subtotal, tier)
    let final_cents = subtotal - discount
    let out = json.object({
        "ok": json.from_bool(true),
        "customer": json.from_str(customer),
        "subtotal_cents": json.from_int(subtotal),
        "discount_cents": json.from_int(discount),
        "final_cents": json.from_int(final_cents),
    })
    return json.stringify(out) else _ {
        "{\"ok\":false,\"error\":\"serialization_failed\"}"
    }
}
