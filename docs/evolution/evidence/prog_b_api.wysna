import "std/environment" as environ
import "std/fs" as fs
import "std/io" as io
import "std/json" as json

struct Item {
    id: int requires id > 0,
    title: str,
    amount_cents: int requires amount_cents >= 0,
}

fn respond(status: int, payload: json.Value) -> str {
    let envelope = json.object({
        "status": json.from_int(status),
        "body": payload,
    })
    return json.stringify(envelope) else _ {
        "{\"status\":500,\"body\":{\"error\":\"envelope_failed\"}}"
    }
}

fn error_response(status: int, code: str, message: str) -> str {
    return respond(status, json.object({
        "error": json.from_str(code),
        "message": json.from_str(message),
    }))
}

fn load_store(db_path: str) -> list[json.Value] ! str {
    let exists = fs.exists(db_path) else err {
        return Err(f"Filesystem check failed: {err.operation}")
    }
    let empty: list[json.Value] = []
    if not exists {
        return empty
    }
    let raw = io.read_text(db_path) else err {
        return Err(f"Failed to read database: {err.message}")
    }
    if text_is_blank(raw) {
        return empty
    }
    let parsed = json.parse(raw) else err {
        return Err(f"Corrupt database JSON: {err.message}")
    }
    let arr = json.to_array(parsed) else err {
        return Err(f"Database root must be array: {err.message}")
    }
    return arr
}

fn text_is_blank(s: str) -> bool {
    return len(s) == 0
}

fn handle_post_item(db_path: str, req_body: str) -> str {
    let payload = json.parse(req_body) else err {
        return error_response(400, "invalid_json", err.message)
    }
    let id = json.get_int(payload, "id") else err {
        return error_response(400, "invalid_id", err.message)
    }
    let title = json.get_str(payload, "title") else err {
        return error_response(400, "invalid_title", err.message)
    }
    let amount = json.get_int(payload, "amount_cents") else err {
        return error_response(400, "invalid_amount", err.message)
    }
    if id <= 0 or len(title) == 0 or amount < 0 {
        return error_response(422, "validation_failed", "id > 0, non-empty title, and amount_cents >= 0 required")
    }
    let item = Item { id: id, title: title, amount_cents: amount }
    let mut current = load_store(db_path) else err {
        return error_response(500, "storage_read_error", err)
    }
    for existing in current {
        let existing_id = json.get_int(existing, "id") else _ { -1 }
        if existing_id == item.id {
            return error_response(409, "duplicate_id", f"Item {item.id} already exists")
        }
    }
    let record = json.object({
        "id": json.from_int(item.id),
        "title": json.from_str(item.title),
        "amount_cents": json.from_int(item.amount_cents),
    })
    current.append(record)
    let serialized = json.stringify(json.array(current)) else err {
        return error_response(500, "storage_encode_error", err.message)
    }
    io.write_text(db_path, serialized) else err {
        return error_response(500, "storage_write_error", err.message)
    }
    return respond(201, record)
}

fn dispatch(req_path: str, db_path: str) -> str {
    let raw_req = io.read_text(req_path) else err {
        return error_response(400, "request_read_error", err.message)
    }
    let req = json.parse(raw_req) else err {
        return error_response(400, "request_json_error", err.message)
    }
    let method = json.get_str(req, "method") else _ { "GET" }
    let path = json.get_str(req, "path") else _ { "/" }
    let body = json.get_optional_str(req, "body") else _ { none }

    if method == "GET" and path == "/health" {
        return respond(200, json.object({"ok": json.from_bool(true)}))
    }
    if method == "GET" and path == "/items" {
        let items = load_store(db_path) else err {
            return error_response(500, "storage_read_error", err)
        }
        return respond(200, json.object({
            "count": json.from_int(len(items)),
            "items": json.array(items),
        }))
    }
    if method == "POST" and path == "/items" {
        return handle_post_item(db_path, body ?? "")
    }
    return error_response(404, "not_found", f"No route for {method} {path}")
}

let argv = environ.arguments()
let req_file = if len(argv) > 1 { argv[1] } else { "" }
let db_file = environ.get("WYSNA_SERVICE_DATABASE") ?? ".wysna_cache/prog_b_store.json"
print(dispatch(req_file, db_file))
