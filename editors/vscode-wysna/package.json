{
  "name": "wysna-lang",
  "displayName": "Wysna Programming Language",
  "description": "Syntax highlighting, LSP integration, and project impact tooling for the Wysna 1.0 general-purpose programming language",
  "version": "1.0.0",
  "publisher": "washingtonyandun",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "activationEvents": ["onCommand:wysna.projectImpact"],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Project impact runs the Wysna executable in trusted workspaces only."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "wysna.projectImpact",
        "title": "Wysna: Show Project Impact",
        "enablement": "editorLangId == wysna"
      }
    ],
    "configuration": {
      "title": "Wysna",
      "properties": {
        "wysna.executablePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Path to the Wysna executable. Leave empty to use PATH."
        }
      }
    },
    "languages": [
      {
        "id": "wysna",
        "aliases": ["Wysna", "wysna"],
        "extensions": [".wysna"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "wysna",
        "scopeName": "source.wysna",
        "path": "./syntaxes/wysna.tmLanguage.json"
      }
    ]
  }
}
